{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/listen-only-cuts-the-turn-its-agent-is-taking",
  "title": "listen_only on the agent whose turn runs cuts that turn, as a Cancel does: what it would have said is dropped, and the agent only listens",
  "rules": [
    "§19.7.5 rule 12"
  ],
  "notes": "Python: test_strategy_discussion.py test_listen_only_cuts_the_turn_its_agent_is_taking. _room.py cut: the owner's steer reaches the running loop.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "a-thinking",
              "text": "too late"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "a-thinking"
    },
    {
      "call": "listen_only",
      "room_id": "r1",
      "channel_ids": [
        "a"
      ]
    },
    {
      "open": "a-thinking"
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "listening": [
            "a"
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a go"
          }
        }
      ]
    },
    "deliveries": {
      "r1": {
        "ops": []
      }
    },
    "models": {
      "b": []
    }
  }
}
