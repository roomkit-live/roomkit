{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-silent-turn-counts-against-max-turns",
  "title": "A silent turn is one of the turns max_turns allows: two given, the second ends the discussion before the third agent's turn",
  "rules": [
    "§19.7.5 rule 13",
    "§19.7.5 rule 15"
  ],
  "requirements": [
    "RK-19.7.5-114"
  ],
  "notes": "max_turns is 2. The person names a, b and c; a stays silent, b answers, and the discussion is over before c's turn.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "(silent)"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b here"
            }
          ]
        }
      },
      {
        "id": "c",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "c here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b",
            "c"
          ],
          "max_turns": 2
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a @b @c report"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "over": true,
          "queue": []
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a @b @c report"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "status": "blocked",
          "blocked_by": "discussion_silent"
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b here"
          }
        }
      ]
    },
    "models": {
      "c": []
    }
  }
}
