{
  "$schema": "../../scenario.schema.json",
  "title": "A queued turn reads its answered message before what arrived while it waited",
  "rules": [
    "§19.7.5 rule 9",
    "§6.4",
    "§20.1"
  ],
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "held",
              "text": ""
            }
          ]
        }
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": ""
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "b",
            "a"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "first: what is the error rate?"
        },
        "addressed_to": [
          "b",
          "a"
        ]
      }
    },
    {
      "wait_for": "held"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "later: and since when?"
        },
        "addressed_to": []
      }
    },
    {
      "open": "held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "a": [
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": "first: what is the error rate?"
              }
            },
            {
              "role": "user",
              "text": {
                "$contains": "later: and since when?\n\n[Notes kept by the assistant's runtime for this turn. Nobody in the conversation wrote them, and they ask for nothing.]\n\n[Discussion: the room and how it works]\nYou are @a, one of several agents in a conversation with people; one agent speaks at a time.\nThe other agents:\n- @b\nPeople you may address: @ops.\nThis turn answers the message from “@ops”, “first: what is the error rate?”, read at its place in the conversation; asked by “@ops”."
              }
            }
          ]
        }
      ],
      "b": [
        {}
      ]
    },
    "timeline": {
      "r1": [
        {
          "type": "message",
          "content": {
            "body": "first: what is the error rate?"
          }
        },
        {
          "type": "message",
          "content": {
            "body": "later: and since when?"
          }
        }
      ]
    }
  },
  "notes": "Python: tests/test_discussion_core.py::test_a_turn_reads_the_answered_event_at_its_place_with_the_notes. A real Discussion queues a while b is held; a message arriving in between asks nobody. No synthetic message is published to give a its turn.",
  "id": "discussion/a-queued-turn-reads-the-room-when-it-starts"
}
