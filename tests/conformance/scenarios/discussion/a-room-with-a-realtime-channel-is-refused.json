{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-room-with-a-realtime-channel-is-refused",
  "title": "An install in a room binding a realtime channel is refused",
  "rules": [
    "§19.7.5 rule 1"
  ],
  "requirements": [
    "RK-19.7.5-020"
  ],
  "notes": "The room binds a channel of the realtime_voice type, a scripted transport of that type: the install reads the type the channel declares, as a-room-with-a-voice-channel-is-refused reads a voice one. Python: core/mixins/discussion.py discussion_binding_refusal.",
  "setup": {
    "channels": [
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "live",
        "type": "realtime_voice",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "live"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d",
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": null
      }
    },
    {
      "call": "room_strategy",
      "room_id": "r1",
      "expect": {
        "result": null
      }
    }
  ],
  "expect": {
    "rooms": {
      "r1": {
        "metadata": {
          "_discussion": {
            "$absent": true
          }
        }
      }
    },
    "bindings": {
      "r1": {
        "live": {
          "category": "transport"
        },
        "a": {
          "$absent": true
        }
      }
    }
  }
}
