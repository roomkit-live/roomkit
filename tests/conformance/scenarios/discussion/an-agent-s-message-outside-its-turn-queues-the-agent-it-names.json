{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-agent-s-message-outside-its-turn-queues-the-agent-it-names",
  "title": "A message an agent sends outside any turn of its own, naming another, gives that one its turn",
  "rules": [
    "§19.7.5 rule 5",
    "§19.7.5 rule 8"
  ],
  "notes": "Python: core/mixins/discussion.py, _queue_named. The queue fills between the driver's peek and its plan: done, not asked of an empty queue, is asked on the next look, which sees the turn (lot 8c review, B1).",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a here"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "b",
      "content": {
        "type": "text",
        "body": "@a over to you"
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "@a over to you"
          },
          "addressed_to": [
            "a"
          ]
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a here"
          }
        }
      ]
    }
  }
}
