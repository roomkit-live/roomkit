{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-agent-s-memory-learns-every-message-it-may-see",
  "title": "Each agent's memory is handed every message the room delivers to it as it commits, as in a room with no discussion: never its own, and the message a turn answers once",
  "rules": [
    "§19.7.5 rule 3"
  ],
  "notes": "Python: test_discussion_edges.py test_an_agents_memory_learns_every_message_it_may_see; test_discussion_memory_handoff.py, what Rust has of it (no turn backend, speak policy or declaration-only agent). _room.py _hand_to_memories, through the turn backend's committed_event.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "sre: spike at 14:05"
            }
          ]
        },
        "memory": {}
      },
      {
        "id": "dev",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "dev: release 4.2"
            }
          ]
        },
        "memory": {}
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "sre",
            "dev"
          ],
          "addressed_only": true
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@dev what was deployed?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "the customer is Acme"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@sre metrics?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "ingested": {
      "r1": {
        "sre": [
          {
            "source": {
              "channel_id": "ops"
            },
            "content": {
              "body": "@dev what was deployed?"
            }
          },
          {
            "source": {
              "channel_id": "dev"
            },
            "content": {
              "body": "dev: release 4.2"
            }
          },
          {
            "source": {
              "channel_id": "ops"
            },
            "content": {
              "body": "the customer is Acme"
            }
          },
          {
            "source": {
              "channel_id": "ops"
            },
            "content": {
              "body": "@sre metrics?"
            }
          }
        ],
        "dev": [
          {
            "source": {
              "channel_id": "ops"
            },
            "content": {
              "body": "@dev what was deployed?"
            }
          },
          {
            "source": {
              "channel_id": "ops"
            },
            "content": {
              "body": "the customer is Acme"
            }
          },
          {
            "source": {
              "channel_id": "ops"
            },
            "content": {
              "body": "@sre metrics?"
            }
          },
          {
            "source": {
              "channel_id": "sre"
            },
            "content": {
              "body": "sre: spike at 14:05"
            }
          }
        ]
      }
    }
  }
}
