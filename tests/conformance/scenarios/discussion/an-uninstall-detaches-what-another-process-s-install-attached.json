{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-uninstall-detaches-what-another-process-s-install-attached",
  "title": "An uninstall in a process that installed the discussion detaches the agents another process's install attached too, as the room stores them with the discussion",
  "rules": [
    "§19.7.5 rule 16",
    "§19.7"
  ],
  "notes": "Python: core/mixins/strategies.py uninstall_strategy, the record's attached agents joined with the stored ones; p2's install adds c.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "c",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "kept",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      },
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b",
            "c"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "kept"
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d",
      "kit": "p2"
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "expect": {
        "result": true
      }
    }
  ],
  "expect": {
    "bindings": {
      "r1": {
        "ops": {
          "channel_id": "ops"
        },
        "a": null,
        "b": null,
        "c": null
      }
    }
  }
}
