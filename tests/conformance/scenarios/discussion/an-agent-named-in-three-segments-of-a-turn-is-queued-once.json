{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-agent-named-in-three-segments-of-a-turn-is-queued-once",
  "title": "An agent named in each of three segments one turn commits takes one turn",
  "rules": [
    "§19.7.5 rule 5"
  ],
  "requirements": [
    "RK-19.7.5-054"
  ],
  "notes": "Agent a writes a segment naming b before each of its two tool rounds and a last one after them: three committed messages, each addressed to b; b's model is asked once.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Looks a fact up.",
            "parameters": {
              "type": "object",
              "properties": {}
            },
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "@b first",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": "@b second",
              "calls": [
                {
                  "id": "c2",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": "@b third"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a go"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "@b first"
          },
          "type": "message",
          "addressed_to": [
            "b"
          ]
        },
        {
          "type": "tool_call_start"
        },
        {
          "type": "tool_call_end"
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "@b second"
          },
          "type": "message",
          "addressed_to": [
            "b"
          ]
        },
        {
          "type": "tool_call_start"
        },
        {
          "type": "tool_call_end"
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "@b third"
          },
          "type": "message",
          "addressed_to": [
            "b"
          ]
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b here"
          }
        }
      ]
    },
    "models": {
      "b": [
        {}
      ]
    }
  }
}
