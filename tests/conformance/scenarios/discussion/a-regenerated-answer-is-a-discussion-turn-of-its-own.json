{
  "$schema": "../../scenario.schema.json",
  "rules": [
    "§19.7.5 rule 7"
  ],
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "watch",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "first answer"
            },
            {
              "text": "second answer"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "watch"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a hello"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "regenerate_response",
      "room_id": "r1",
      "expect": {
        "result": {
          "event": {
            "id": "r1#0"
          },
          "blocked": false,
          "reason": null,
          "error": null,
          "response_events": []
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "queue": [],
          "speaking": null
        }
      }
    }
  ],
  "expect": {
    "models": {
      "a": [
        {},
        {}
      ],
      "b": []
    },
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a hello"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "first answer"
          },
          "responds_to": "r1#0"
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "second answer"
          },
          "responds_to": "r1#0"
        }
      ]
    },
    "deliveries": {
      "r1": {
        "watch": [
          {
            "source": {
              "channel_id": "ops"
            },
            "content": {
              "body": "@a hello"
            }
          },
          {
            "source": {
              "channel_id": "a"
            },
            "content": {
              "body": "first answer"
            }
          },
          {
            "source": {
              "channel_id": "a"
            },
            "content": {
              "body": "second answer"
            }
          }
        ]
      }
    }
  },
  "id": "discussion/a-regenerated-answer-is-a-discussion-turn-of-its-own",
  "title": "Regeneration keeps the original trigger and answer, queues only the agent that answered and never re-delivers the trigger",
  "notes": "Python: tests/orchestration/test_strategy_discussion.py::test_a_regenerated_answer_is_a_turn_of_its_own; core/mixins/regenerate.py::_regenerate_in_discussion returns the trigger without response events."
}
