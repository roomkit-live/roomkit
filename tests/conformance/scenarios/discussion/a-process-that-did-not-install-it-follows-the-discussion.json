{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-process-that-did-not-install-it-follows-the-discussion",
  "title": "A process that did not install the discussion its room stores follows it: it asks no agent at broadcast and queues the message, which the installing process gives the turns of",
  "rules": [
    "§19.7.5 rule 16",
    "§19.7.5 rule 8"
  ],
  "notes": "Python: test_discussion_processes.py test_a_process_that_did_not_install_it_follows_the_discussion. p2 installed nothing: the message it takes asks nobody there, and every agent answers once, from the process that installed the discussion. Its speak queue is the one it last read: it knows the room holds a discussion.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a here"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b here"
            }
          ]
        }
      },
      {
        "id": "c",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "c here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b",
            "c"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "checkout is failing, what happened?"
        }
      },
      "kit": "p2",
      "expect": {
        "result": {
          "blocked": false,
          "error": null,
          "response_events": []
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "kit": "p2",
      "expect": {
        "result": {
          "$present": true
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "checkout is failing, what happened?"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a here"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b here"
          }
        },
        {
          "source": {
            "channel_id": "c"
          },
          "content": {
            "body": "c here"
          }
        }
      ]
    }
  }
}
