{
  "$schema": "../../scenario.schema.json",
  "rules": [
    "§19.7.5 rule 7"
  ],
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "watch",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "watch"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ],
          "addressed_only": true
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "hello"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "regenerate_response",
      "room_id": "r1",
      "expect": {
        "result": null
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "a": [],
      "b": []
    },
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "hello"
          }
        }
      ]
    }
  },
  "id": "discussion/discussion-regeneration-falls-back-to-addressed-only",
  "title": "Discussion regeneration without an answer uses addressed-only",
  "notes": "Python: core/mixins/regenerate.py::_regenerate_in_discussion and orchestration/strategies/discussion/_room.py::asked_by. The initial event crosses the inbound pipeline; any prior answer is removed before regeneration."
}
