{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/the-recent-conversation-withholds-what-a-delete-removed",
  "title": "The conversation a policy reads keeps a deleted message in its place with its text withheld",
  "rules": [
    "§19.7.5 rule 18",
    "§7.5",
    "§10.3"
  ],
  "notes": "Python: tests/orchestration/test_discussion_dispatch.py test_the_recent_conversation_withholds_what_a_delete_removed, the delete its sender's own in place of a moderation hook's system delete: either keeps the message in place, its text withheld. RFC §7.5 rule 8, §10.3.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "investigator",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "investigator here"
            }
          ]
        }
      },
      {
        "id": "dev",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "dev here"
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "sre here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "investigator",
            "dev",
            "sre"
          ],
          "dispatch": {
            "decisions": [
              []
            ]
          },
          "everyone": [
            "sre"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@investigator the code is 4417"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "delete",
          "target_event_id": "r1#0",
          "delete_type": "sender"
        },
        "event_type": "delete"
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "type": "delete"
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "so?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "dispatch_turns": {
      "d": [
        {
          "event": {
            "source": {
              "channel_id": "ops"
            },
            "content": {
              "body": "so?"
            }
          },
          "recent": [
            {
              "id": "r1#0",
              "content": {
                "type": "text",
                "body": ""
              }
            },
            {
              "source": {
                "channel_id": "investigator"
              },
              "content": {
                "body": "investigator here"
              }
            }
          ]
        }
      ]
    }
  }
}
