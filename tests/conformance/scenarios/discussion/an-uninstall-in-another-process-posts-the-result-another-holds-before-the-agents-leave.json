        }
      }
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "kit": "p2",
      "expect": {
        "result": true
      }
    },
    {
      "open": "sre-speaking"
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": null
      }
    }
  ],
  "expect": {
    "deliveries": {
      "r1": {
        "ops": [
          {
            "type": "tool_call_start",
            "source": {
              "channel_id": "comms"
            }
          },
          {
            "type": "tool_call_end",
            "source": {
