{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-agent-waiting-on-a-person-can-still-be-named-by-another",
  "title": "An agent that asked a person and waits for the answer still takes the turn another agent's message gives it",
  "rules": [
    "§19.7.5 rule 10",
    "§19.7.5 rule 8"
  ],
  "requirements": [
    "RK-19.7.5-193"
  ],
  "notes": "a asks the person; before they answer, b's answer names a, and a takes a turn.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "@ops which region?"
            },
            {
              "text": "a: thanks b, rolling back"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "@a it is eu-west"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ],
          "people": [
            "ops"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a @b deploy failed"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a @b deploy failed"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "@ops which region?"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "@a it is eu-west"
          },
          "addressed_to": [
            "a"
          ]
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a: thanks b, rolling back"
          }
        }
      ]
    },
    "models": {
      "a": [
        {},
        {}
      ]
    }
  }
}
