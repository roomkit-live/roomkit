{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-speak-policy-and-listen-only-each-silence-the-agent",
  "title": "An agent with a speak policy is silenced by the policy's silence, and by the discussion's listen_only though its policy would let it speak",
  "rules": [
    "§19.7.5 rule 12",
    "§19.7.5 rule 13",
    "§6.4"
  ],
  "requirements": [
    "RK-19.7.5-104"
  ],
  "notes": "The person names b, whose policy decides silent: b says nothing. b is then set to listen only, and a's answer names b: b keeps its place in the queue and takes no turn, so its policy, which would now decide speak, is not asked.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "@b over to you"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "speak_policy": {
          "decisions": [
            {
              "decision": {
                "mode": "silent",
                "reason": "listening",
                "final": true
              }
            },
            {
              "decision": {
                "mode": "speak"
              }
            }
          ]
        },
        "model": {
          "rounds": [
            {
              "text": "b should not be heard"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@b status?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "listen_only",
      "room_id": "r1",
      "channel_ids": [
        "b"
      ]
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a check the logs"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "queue": [
            "b"
          ],
          "listening": [
            "b"
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@b status?"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a check the logs"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "@b over to you"
          },
          "addressed_to": [
            "b"
          ]
        }
      ]
    },
    "speak_turns": {
      "b": [
        {
          "event": {
            "content": {
              "body": "@b status?"
            }
          }
        }
      ]
    },
    "models": {
      "b": []
    }
  }
}
