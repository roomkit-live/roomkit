{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/talking-again-ends-a-wait-that-was-for-it",
  "title": "The wait for an agent that only listens ends once it talks again, and its queued turn runs",
  "rules": [
    "§19.7.5 rule 12"
  ],
  "notes": "Python: test_discussion_edges.py test_talking_again_ends_a_wait_that_was_for_it.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "@b look"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b looked"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "listen_only",
      "room_id": "r1",
      "channel_ids": [
        "b"
      ]
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "waiting": true,
          "queue": [
            "b"
          ]
        }
      }
    },
    {
      "call": "talk_again",
      "room_id": "r1",
      "channel_ids": [
        "b"
      ]
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "waiting": false,
          "queue": [],
          "listening": []
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a go"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "@b look"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b looked"
          }
        }
      ]
    }
  }
}
