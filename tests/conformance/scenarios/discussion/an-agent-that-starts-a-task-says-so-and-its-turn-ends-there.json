{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-agent-that-starts-a-task-says-so-and-its-turn-ends-there",
  "title": "An agent that starts a background task is told to say in one sentence that the work is under way and to end its turn: its turn ends with that sentence, and the next agent's turn comes while the work runs",
  "rules": [
    "§19.7.5 rule 19",
    "§23.4"
  ],
  "requirements": [
    "RK-19.7.5-203"
  ],
  "notes": "Python: tasks/background.py background_tool_server (its answer; its words are pinned whole by tasks/an-agent-starts-its-work-in-the-background). comms is named before sre: it starts the task and says it is on it, and its model is asked no more in that turn; sre answers while the worker holds, then the result is posted. Not observed: that a model says it once, in one sentence; a scripted model says what it is scripted to.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "comms",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "work_in_background",
                  "arguments": {
                    "task": "go through the tickets"
                  }
                }
              ]
            },
            {
              "text": "On it."
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "sre here"
            }
          ]
        }
      },
      {
        "id": "helper",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "working",
              "text": "Findings."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "comms",
            "sre"
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "sre-answered",
        "trigger": "after_broadcast",
        "execution": "async",
        "reactions": [
          {
            "when": {
              "text": "sre here"
            },
            "gate": "sre-answered"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "setup_background",
      "agent_id": "comms",
      "worker": "helper",
      "hand_back": "post"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@comms please go through the tickets, and @sre check the logs"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "sre-answered"
    },
    {
      "open": "sre-answered"
    },
    {
      "open": "working"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@comms please go through the tickets, and @sre check the logs"
          }
        },
        {
          "type": "tool_call_start",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "type": "tool_call_end",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "source": {
            "channel_id": "comms"
          },
          "content": {
            "body": "On it."
          }
        },
        {
          "source": {
            "channel_id": "sre"
          },
          "content": {
            "body": "sre here"
          }
        },
        {
          "source": {
            "channel_id": "comms"
          },
          "content": {
            "body": {
              "$contains": [
                "Result of the task",
                "go through the tickets",
                "Findings."
              ]
            }
          }
        }
      ]
    },
    "models": {
      "comms": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$contains": [
                  "one short sentence",
                  "end your turn"
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
