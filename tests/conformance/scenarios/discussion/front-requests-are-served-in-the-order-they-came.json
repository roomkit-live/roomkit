{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/front-requests-are-served-in-the-order-they-came",
  "title": "Two instructions that each put an agent at the front of the queue are served in the order they came",
  "rules": [
    "§19.7.5 rule 7"
  ],
  "requirements": [
    "RK-19.7.5-063"
  ],
  "notes": "While a's turn holds, an instruction for b comes, then one for c: the queue reads b, c, and the turns run a, b, c.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a done",
              "gate": "a-held"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b done"
            }
          ]
        }
      },
      {
        "id": "c",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "c done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b",
            "c"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "a-held"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "b: summarise"
        },
        "event_type": "instruction",
        "addressed_to": [
          "b"
        ]
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "c: summarise"
        },
        "event_type": "instruction",
        "addressed_to": [
          "c"
        ]
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": "a",
          "queue": [
            "b",
            "c"
          ]
        }
      }
    },
    {
      "open": "a-held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a go"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a done"
          }
        },
        {
          "type": "instruction_read",
          "source": {
            "channel_id": "b"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b done"
          }
        },
        {
          "type": "instruction_read",
          "source": {
            "channel_id": "c"
          }
        },
        {
          "source": {
            "channel_id": "c"
          },
          "content": {
            "body": "c done"
          }
        }
      ]
    }
  }
}
