{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-policy-past-its-bound-asks-every-candidate",
  "title": "A policy that does not decide within dispatch_timeout asks every candidate, reported as the fallback after the bound",
  "rules": [
    "§19.7.5 rule 18"
  ],
  "notes": "Python: tests/orchestration/test_discussion_dispatch.py test_a_policy_past_its_bound_asks_every_candidate.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "investigator",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "investigator here"
            }
          ]
        }
      },
      {
        "id": "dev",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "dev here"
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "sre here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "investigator",
            "dev",
            "sre"
          ],
          "dispatch": {
            "decisions": [
              [
                "sre"
              ]
            ],
            "delay_ms": 30000
          },
          "dispatch_timeout_ms": 50
        }
      }
    ],
    "hooks": [
      {
        "name": "decisions",
        "trigger": "on_dispatch_decision",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "anyone?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "anyone?"
          }
        },
        {
          "source": {
            "channel_id": "investigator"
          },
          "content": {
            "body": "investigator here"
          }
        },
        {
          "source": {
            "channel_id": "dev"
          },
          "content": {
            "body": "dev here"
          }
        },
        {
          "source": {
            "channel_id": "sre"
          },
          "content": {
            "body": "sre here"
          }
        }
      ]
    },
    "hooks": {
      "decisions": [
        {
          "trigger": "on_dispatch_decision",
          "room_id": "r1",
          "dispatch_decision": {
            "decision": {
              "reason": "fallback"
            },
            "duration_ms": 50
          }
        }
      ]
    }
  }
}
