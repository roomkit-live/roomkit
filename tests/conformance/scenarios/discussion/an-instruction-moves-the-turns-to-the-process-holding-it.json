{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-instruction-moves-the-turns-to-the-process-holding-it",
  "title": "An instruction taken by a process that installed the discussion and does not hold the lease is answered: the process holding the lease hands it the turns, and it gives the instruction's turn",
  "rules": [
    "§19.7.5 rule 16",
    "§19.7.5 rule 7"
  ],
  "notes": "Python: test_discussion_processes.py test_an_instruction_moves_the_turns_to_the_process_holding_it; _driver.py _hand_over. The run's kit installs first and holds the lease once its driver looked; p2 installs the same configuration. The instruction p2 takes keeps its text in p2: the run's kit, reaching its turn, grants p2 the lease, and p2 gives c the turn.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a here"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "c",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "c: the summary"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b",
            "c"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "idle": true
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d",
      "kit": "p2"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "kit": "p2",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "summarise"
        },
        "event_type": "instruction",
        "addressed_to": [
          "c"
        ]
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "kit": "p2",
      "expect": {
        "result": {
          "speaking": null,
          "queue": []
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a hello"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a here"
          }
        },
        {
          "type": "instruction_read",
          "source": {
            "channel_id": "c"
          },
          "visibility": "c",
          "content": {
            "body": "summarise"
          }
        },
        {
          "source": {
            "channel_id": "c"
          },
          "content": {
            "body": "c: the summary"
          }
        }
      ]
    },
    "models": {
      "b": []
    }
  }
}
