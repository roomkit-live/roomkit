{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-process-changing-its-discussion-s-agents-keeps-the-queue-and-lets-the-agent-it-drops-go",
  "title": "A process installing a discussion over the one it installed keeps the stored queue but for the agent it drops, which leaves the queue and is detached; it gives the turns from then on, and the other process that installed the old agents is not current",
  "rules": [
    "§19.7.5 rule 1",
    "§19.7.5 rule 16",
    "§19.7"
  ],
  "notes": "Python: test_discussion_processes.py test_changing_the_agents_keeps_the_queue_and_lets_the_removed_agent_go (_two_processes_then_a_change), core/mixins/discussion.py _replace_discussion and _room.py take_over: the agents an install attached that the new configuration lets go are detached, not refused; the queue keeps b listening and drops c. The second install over the first is not refused as a strategy already held.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a here"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "c",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b",
            "c"
          ]
        }
      },
      {
        "id": "kept",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d",
      "kit": "p2"
    },
    {
      "call": "listen_only",
      "kit": "p2",
      "room_id": "r1",
      "channel_ids": [
        "b",
        "c"
      ]
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a hello"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "kept"
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "queue": [],
          "listening": [
            "b"
          ]
        }
      }
    },
    {
      "call": "speak_queue",
      "kit": "p2",
      "room_id": "r1",
      "expect": {
        "result": {
          "listening": [
            "b"
          ]
        }
      }
    },
    {
      "call": "room_strategy_is_current",
      "room_id": "r1",
      "kind": "Discussion",
      "expect": {
        "result": true
      }
    },
    {
      "call": "room_strategy_is_current",
      "room_id": "r1",
      "kind": "Discussion",
      "expect": {
        "result": false
      },
      "kit": "p2"
    },
    {
      "call": "room_strategy",
      "room_id": "r1",
      "expect": {
        "result": "kept"
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a hello"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a here"
          }
        }
      ]
    },
    "bindings": {
      "r1": {
        "ops": {
          "channel_id": "ops"
        },
        "a": {
          "channel_id": "a"
        },
        "b": {
          "channel_id": "b"
        },
        "c": null
      }
    }
  }
}
