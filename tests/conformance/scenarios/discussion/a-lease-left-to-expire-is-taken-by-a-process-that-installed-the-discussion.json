{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-lease-left-to-expire-is-taken-by-a-process-that-installed-the-discussion",
  "title": "A lease its holder left to expire is taken by a process that installed the discussion, and the holder's running turn has ended; one still held elsewhere is not taken",
  "rules": [
    "§19.7.5 rule 16",
    "§19.7.5 rule 6"
  ],
  "requirements": [
    "RK-19.7.5-136"
  ],
  "notes": "Python: _shared.py take, held_elsewhere (one read of grace past the end), test_discussion_processes.py test_a_process_that_stopped_hands_the_room_over_once_its_lease_expires; Rust lease.rs take_lease. r1 stores the lease of a process gone (gone, expired in 1970) and its running turn, a's: the kit installs the discussion, takes the lease and gives b its turn. r2's lease is held elsewhere until 2100: b is queued and waits. Not observed: the holder renewing its lease while it holds it (a renewal is due once a third of the 15 s has passed).",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a too late"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "store_metadata": {
          "_discussion": {
            "agents": [
              "a",
              "b"
            ],
            "max_depth": 5
          },
          "_speak_queue": {
            "speaking": "a",
            "lease_holder": "gone",
            "lease_expires": 1.0
          }
        },
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      },
      {
        "id": "r2",
        "store_metadata": {
          "_discussion": {
            "agents": [
              "a",
              "b"
            ],
            "max_depth": 5
          },
          "_speak_queue": {
            "lease_holder": "elsewhere",
            "lease_expires": 4102444800.0
          }
        },
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "install_strategy",
      "room_id": "r2",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@b status?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r2",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@b status?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "queue": []
        }
      }
    },
    {
      "call": "speak_queue",
      "room_id": "r2",
      "expect": {
        "result": {
          "speaking": null,
          "queue": [
            "b"
          ]
        }
      }
    },
    {
      "call": "store.get_room",
      "room_id": "r1",
      "expect": {
        "result": {
          "metadata": {
            "_speak_queue": {
              "speaking": null,
              "lease_holder": {
                "$lacks": "gone"
              }
            }
          }
        }
      }
    },
    {
      "call": "store.get_room",
      "room_id": "r2",
      "expect": {
        "result": {
          "metadata": {
            "_speak_queue": {
              "lease_holder": "elsewhere"
            }
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@b status?"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b here"
          }
        }
      ],
      "r2": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@b status?"
          }
        }
      ]
    },
    "models": {
      "a": []
    }
  }
}
