{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-person-s-message-ends-the-wait-even-asking-no-one",
  "title": "The room waiting for a person: an instruction is given meanwhile, what it asks of another waits, and the person's message ends the wait though it asks no one",
  "rules": [
    "§19.7.5 rule 10"
  ],
  "notes": "Python: test_discussion_edges.py test_a_persons_message_ends_the_wait_even_asking_no_one. The agent keeps its own copy of each instruction its turn read, an instruction_read row visible to it alone, before what the turn wrote (RFC §10.1.1, HITL 25b07f2a, RMK-1407).",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "@ops may I?"
            },
            {
              "text": "@b please look"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b looked"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ],
          "people": [
            "ops"
          ],
          "addressed_only": true
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "waiting": true
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "ask b"
        },
        "event_type": "instruction",
        "addressed_to": [
          "a"
        ]
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "queue": [
            "b"
          ],
          "waiting": true
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "just a note for the team"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "queue": []
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a go"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "@ops may I?"
          }
        },
        {
          "type": "instruction_read",
          "source": {
            "channel_id": "a"
          },
          "visibility": "a",
          "content": {
            "body": "ask b"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "@b please look"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "just a note for the team"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b looked"
          }
        }
      ]
    }
  }
}
