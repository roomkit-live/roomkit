{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-instruction-past-the-depth-limit-is-dropped-and-reported",
  "title": "An instruction whose turn would reach the discussion depth limit is dropped once, names its target in the queue hook and leaves no turn waiting or stored",
  "rules": [
    "§19.7.5 rule 11",
    "§19.7.5 rule 17"
  ],
  "notes": "Python: tests/orchestration/test_discussion_edges.py::test_an_instruction_past_the_depth_limit_is_dropped_and_reported.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a done"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ],
          "max_depth": 3
        }
      }
    ],
    "hooks": [
      {
        "name": "follow",
        "trigger": "on_speak_queue",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "hand back"
        },
        "event_type": "instruction",
        "addressed_to": [
          "a"
        ],
        "chain_depth": 2
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "queue": [],
          "waiting": false
        }
      }
    }
  ],
  "expect": {
    "models": {
      "a": [],
      "b": []
    },
    "timeline": {
      "r1": []
    },
    "deliveries": {
      "r1": {
        "ops": []
      }
    },
    "hooks": {
      "follow": [
        {
          "speak_queue": {
            "change": "queued",
            "channel_ids": [
              "a"
            ],
            "event_id": {
              "$as": "instruction"
            }
          }
        },
        {
          "speak_queue": {
            "change": "instruction_dropped",
            "channel_ids": [
              "a"
            ],
            "event_id": {
              "$as": "instruction"
            }
          }
        }
      ]
    }
  }
}
