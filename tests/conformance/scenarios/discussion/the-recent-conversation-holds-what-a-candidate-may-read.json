{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/the-recent-conversation-holds-what-a-candidate-may-read",
  "title": "The conversation a policy reads holds the room's earlier messages a candidate may read, an agent's labelled by its handle, not the message decided",
  "rules": [
    "§19.7.5 rule 18"
  ],
  "notes": "Python: tests/orchestration/test_discussion_dispatch.py test_the_recent_conversation_holds_what_a_candidate_may_read.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "investigator",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "investigator here"
            }
          ]
        }
      },
      {
        "id": "dev",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "dev here"
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "sre here"
            }
          ]
        }
      },
      {
        "id": "side",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "investigator",
            "dev",
            "sre"
          ],
          "dispatch": {
            "decisions": [
              []
            ]
          },
          "everyone": [
            "sre"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "attach_channel",
      "room_id": "r1",
      "channel_id": "side",
      "visibility": "dev"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@investigator first look"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "side",
        "sender_id": "someone",
        "content": {
          "type": "text",
          "body": "only dev may read this"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "so?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "dispatch_turns": {
      "d": [
        {
          "event": {
            "source": {
              "channel_id": "ops"
            },
            "content": {
              "body": "so?"
            }
          },
          "recent": [
            {
              "source": {
                "channel_id": "ops"
              },
              "content": {
                "body": "@investigator first look"
              }
            },
            {
              "source": {
                "channel_id": "investigator"
              },
              "content": {
                "body": "investigator here"
              }
            }
          ],
          "speakers": [
            [
              "r1#0",
              "@ops"
            ],
            [
              "r1#1",
              "@investigator"
            ],
            [
              "r1#3",
              "@ops"
            ]
          ]
        }
      ]
    }
  }
}
