{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-install-another-process-replaced-is-not-current",
  "title": "room_strategy_is_current is false in a process whose installed discussion another process replaced with another configuration, true in that other process",
  "rules": [
    "§19.7.5 rule 16"
  ],
  "notes": "Python: test_discussion_processes.py test_a_process_whose_install_another_replaced_is_current_again_once_it_installs, its first half, the replacement adding c to the run's kit's a and b (test_a_quiet_follower_routes_host_calls_by_a_new_configuration's order); a replacement that lets an agent go comes with the replacement of a discussion (RMK-1233).",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "c",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "kept",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      },
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b",
            "c"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "kept"
    },
    {
      "call": "install_strategy",
      "kit": "p2",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "room_strategy_is_current",
      "kit": "p2",
      "room_id": "r1",
      "kind": "Discussion",
      "expect": {
        "result": true
      }
    },
    {
      "call": "room_strategy_is_current",
      "room_id": "r1",
      "kind": "Discussion",
      "expect": {
        "result": false
      }
    },
    {
      "call": "room_strategy",
      "room_id": "r1",
      "expect": {
        "result": "kept"
      }
    }
  ],
  "expect": {}
}
