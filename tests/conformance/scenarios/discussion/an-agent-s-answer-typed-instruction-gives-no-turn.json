{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-agent-s-answer-typed-instruction-gives-no-turn",
  "title": "An agent response typed as an instruction does not give the addressed agent a turn in the application name",
  "rules": [
    "§19.7.5 rule 7",
    "§8.5"
  ],
  "notes": "Python: tests/orchestration/test_discussion_edges.py::test_an_agent_s_answer_typed_instruction_gives_no_turn.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "respond": [
              {
                "type": "instruction",
                "addressed_to": [
                  "b"
                ],
                "content": {
                  "type": "text",
                  "body": "Summarise the incident for the customer."
                }
              }
            ]
          }
        ]
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a go"
        },
        "event_type": "message",
        "addressed_to": [
          "a"
        ],
        "chain_depth": 0
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "queue": [],
          "waiting": false
        }
      }
    }
  ],
  "expect": {
    "models": {
      "b": []
    },
    "turns": {
      "r1": {
        "a": [
          {
            "content": {
              "type": "text",
              "body": "@a go"
            }
          }
        ]
      }
    }
  }
}
