{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/with-addressed-only-an-answer-naming-nobody-clears-no-ask",
  "title": "With addressed_only, a person's message naming nobody leaves an agent's question waiting; one naming the agent clears it",
  "rules": [
    "§19.7.5 rule 8",
    "§19.7.5 rule 10"
  ],
  "requirements": [
    "RK-19.7.5-088"
  ],
  "notes": "Agent a asks the person. Their answer naming nobody asks no agent and clears nothing; their next, naming a, gives a its turn and clears what it asked.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "@ops which region?"
            },
            {
              "text": "a: rolling back eu-west"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ],
          "people": [
            "ops"
          ],
          "addressed_only": true
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a deploy failed"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "asked": [
            [
              "a",
              "@ops"
            ]
          ]
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "eu-west"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "asked": [
            [
              "a",
              "@ops"
            ]
          ]
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a eu-west"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "asked": []
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a deploy failed"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "@ops which region?"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "eu-west"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a eu-west"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a: rolling back eu-west"
          }
        }
      ]
    },
    "models": {
      "a": [
        {},
        {}
      ],
      "b": []
    }
  }
}
