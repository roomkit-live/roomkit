{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/the-kind-asked-about-is-the-kind-installed",
  "title": "room_strategy_is_current reads the discussion installed while it is, and false once it is uninstalled",
  "rules": [
    "§19.7.5 rule 16"
  ],
  "notes": "Python: test_discussion_processes.py test_the_kind_asked_about_is_the_kind_installed. Its host's own subclass of Discussion has no form in a scenario.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "room_strategy_is_current",
      "room_id": "r1",
      "kind": "Discussion",
      "expect": {
        "result": true
      }
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "room_strategy_is_current",
      "room_id": "r1",
      "kind": "Discussion",
      "expect": {
        "result": false
      }
    }
  ],
  "expect": {}
}
