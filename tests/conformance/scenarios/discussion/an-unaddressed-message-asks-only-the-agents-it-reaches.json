{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-unaddressed-message-asks-only-the-agents-it-reaches",
  "title": "A person's message naming nobody asks only the agents of everyone it reaches: one its visibility leaves out and one whose access cannot read it take no turn",
  "rules": [
    "§19.7.5 rule 8",
    "§7.5"
  ],
  "requirements": [
    "RK-19.7.5-071"
  ],
  "notes": "The ops binding lets its messages reach a and b only, so c does not see them; b's binding is set write_only after the install, so b cannot read them. While a answers, the queue holds neither: the message queued a alone.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a here",
              "gate": "a-held"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b here"
            }
          ]
        }
      },
      {
        "id": "c",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "c here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops",
            "visibility": "a,b"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b",
            "c"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "set_access",
      "room_id": "r1",
      "channel_id": "b",
      "access": "write_only"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "anyone around?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "a-held"
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": "a",
          "queue": []
        }
      }
    },
    {
      "open": "a-held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "anyone around?"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a here"
          }
        }
      ]
    },
    "models": {
      "a": [
        {}
      ],
      "b": [],
      "c": []
    }
  }
}
