{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-room-of-another-organization-is-not-asked-about",
  "title": "room_strategy_is_current reads a room in the organization it names, and finds no room of another",
  "rules": [
    "§19.7.5 rule 16",
    "§17.2"
  ],
  "notes": "Python: test_discussion_processes.py test_a_room_of_another_organization_is_not_asked_about.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ],
        "organization_id": "org-a"
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d",
      "organization_id": "org-a"
    },
    {
      "call": "room_strategy_is_current",
      "room_id": "r1",
      "kind": "Discussion",
      "organization_id": "org-a",
      "expect": {
        "result": true
      }
    },
    {
      "call": "room_strategy_is_current",
      "room_id": "r1",
      "kind": "Discussion",
      "organization_id": "org-b",
      "expect": {
        "error": "room_not_found"
      }
    }
  ],
  "expect": {}
}
