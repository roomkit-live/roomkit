{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/undecided-a-message-after-a-question-goes-to-the-agent-that-asked",
  "title": "A policy that fails leaves a message after an agent's question to that agent, as with no policy, reported as the fallback",
  "rules": [
    "§19.7.5 rule 18"
  ],
  "notes": "Python: tests/orchestration/test_discussion_dispatch.py test_undecided_a_message_after_a_question_goes_to_the_agent_that_asked.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "investigator",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "@ops which region?"
            },
            {
              "text": "on it"
            }
          ]
        }
      },
      {
        "id": "dev",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "dev here"
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "sre here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "investigator",
            "dev",
            "sre"
          ],
          "dispatch": {
            "error": "down"
          },
          "people": [
            "ops"
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "decisions",
        "trigger": "on_dispatch_decision",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@investigator checkout fails"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "eu-west"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@investigator checkout fails"
          }
        },
        {
          "source": {
            "channel_id": "investigator"
          },
          "content": {
            "body": "@ops which region?"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "eu-west"
          }
        },
        {
          "source": {
            "channel_id": "investigator"
          },
          "content": {
            "body": "on it"
          }
        }
      ]
    },
    "hooks": {
      "decisions": [
        {
          "trigger": "on_dispatch_decision",
          "room_id": "r1",
          "dispatch_decision": {
            "decision": {
              "agents": [
                "investigator"
              ],
              "reason": "fallback"
            }
          }
        }
      ]
    }
  }
}
