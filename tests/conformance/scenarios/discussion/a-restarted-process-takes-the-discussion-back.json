{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-restarted-process-takes-the-discussion-back",
  "title": "Once the process that installed it stopped, the discussion stays stored: another process follows it and gives no turn, until its host installs the discussion there",
  "rules": [
    "§19.7.5 rule 16",
    "§19.7.5 rule 1"
  ],
  "notes": "Python: test_discussion_processes.py test_a_restarted_process_takes_the_discussion_back. The run's kit closes; p2 queues a's turn and gives none until its install.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "close"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a are you there?"
        }
      },
      "kit": "p2",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "kit": "p2",
      "expect": {
        "result": {
          "speaking": null,
          "queue": [
            "a"
          ]
        }
      }
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d",
      "kit": "p2"
    },
    {
      "idle": true
    },
    {
      "call": "room_strategy",
      "room_id": "r1",
      "kit": "p2",
      "expect": {
        "result": "d"
      }
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "kit": "p2",
      "expect": {
        "result": {
          "speaking": null,
          "queue": []
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a are you there?"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a here"
          }
        }
      ]
    }
  }
}
