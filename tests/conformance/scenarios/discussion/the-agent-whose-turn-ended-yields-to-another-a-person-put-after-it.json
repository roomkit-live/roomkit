{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/the-agent-whose-turn-ended-yields-to-another-a-person-put-after-it",
  "title": "The agent whose turn just ended does not take the next one while another queued agent can, even when a person's message put it first",
  "rules": [
    "§19.7.5 rule 7",
    "§19.7.5 rule 8"
  ],
  "requirements": [
    "RK-19.7.5-058"
  ],
  "notes": "While a's turn holds, the person names a then b, which puts them at the front in that order: the queue reads a, b. Once a's turn ends, b takes the next turn, then a.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a first",
              "gate": "a-held"
            },
            {
              "text": "a again"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "a-held"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a @b check the logs and the metrics"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": "a",
          "queue": [
            "a",
            "b"
          ]
        }
      }
    },
    {
      "open": "a-held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a go"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a @b check the logs and the metrics"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a first"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b here"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a again"
          }
        }
      ]
    }
  }
}
