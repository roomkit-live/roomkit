{
  "$schema": "../../scenario.schema.json",
  "title": "A regenerated turn replays its own tool round when nobody spoke after its input",
  "rules": [
    "§19.7.5 rule 9",
    "§6.4",
    "§20.1"
  ],
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": ""
            },
            {
              "text": ""
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look up the error rate",
            "parameters": {
              "type": "object",
              "properties": {}
            },
            "returns": "4% since Monday"
          }
        ],
        "max_empty_retries": 0
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "first: what is the error rate?"
        },
        "addressed_to": [
          "a"
        ]
      }
    },
    {
      "idle": true
    },
    {
      "call": "regenerate_response",
      "room_id": "r1"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "a": [
        {},
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": "first: what is the error rate?"
              }
            },
            {
              "role": "assistant",
              "round": [
                {
                  "call": "c1",
                  "arguments": {}
                }
              ]
            },
            {
              "role": "tool"
            },
            {
              "role": "user",
              "text": {
                "$contains": "This turn answers again the message from “@ops”, “first: what is the error rate?”"
              }
            }
          ],
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "4% since Monday",
              "is_error": false
            }
          ]
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "type": "message",
          "content": {
            "body": "first: what is the error rate?"
          }
        },
        {
          "type": "tool_call_start",
          "source": {
            "channel_id": "a"
          }
        },
        {
          "type": "tool_call_end",
          "source": {
            "channel_id": "a"
          },
          "content": {
            "result": "4% since Monday"
          }
        }
      ]
    }
  },
  "notes": "Python: tests/test_discussion_core.py::test_a_turn_replays_a_round_when_its_answered_event_is_all_the_history. The first turn calls a tool but publishes no answer. regenerate_response gives the same input a new Discussion turn with its own saved call and result.",
  "id": "discussion/a-turn-replays-its-round-with-no-later-message"
}
