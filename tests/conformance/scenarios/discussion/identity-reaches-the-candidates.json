{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/identity-reaches-the-candidates",
  "title": "Each candidate a policy reads carries the identity its agent was given",
  "rules": [
    "§19.7.5 rule 18"
  ],
  "notes": "Python: tests/orchestration/test_discussion_dispatch.py test_identity_reaches_the_candidates.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "sre here"
            }
          ]
        },
        "agent": {
          "name": "Sam",
          "description": "runs the platform"
        }
      },
      {
        "id": "dev",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "dev here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "sre",
            "dev"
          ],
          "dispatch": {
            "decisions": [
              []
            ]
          }
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "dispatch_turns": {
      "d": [
        {
          "candidates": [
            {
              "channel_id": "sre",
              "name": "Sam",
              "role": null,
              "description": "runs the platform"
            },
            {
              "channel_id": "dev",
              "name": null,
              "role": null,
              "description": null
            }
          ]
        }
      ]
    }
  }
}
