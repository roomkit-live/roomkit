{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-instruction-to-several-agents-gives-each-its-turn",
  "title": "An instruction gives each addressed agent its own turn, in address order, and each keeps only its own instruction copy before its answer",
  "rules": [
    "§19.7.5 rule 7",
    "§10.1.1"
  ],
  "notes": "Python: tests/orchestration/test_discussion_edges.py::test_an_instruction_to_several_agents_gives_each_its_turn.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a done"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "summarise"
        },
        "event_type": "instruction",
        "addressed_to": [
          "a",
          "b"
        ],
        "chain_depth": 0
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "queue": [],
          "waiting": false
        }
      }
    }
  ],
  "expect": {
    "models": {
      "a": [
        {}
      ],
      "b": [
        {}
      ]
    },
    "timeline": {
