{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/uninstalling-cuts-the-turn-under-way",
  "title": "An uninstall cuts the turn under way: what its agent would have said is dropped, and the room goes back to its policy",
  "rules": [
    "§19.7.5 rule 1"
  ],
  "notes": "Python: test_discussion_processes.py test_uninstalling_while_a_turn_runs_cuts_it_and_records_nothing, its one-process case; _driver.py stop, _abandon(turn, 'discussion_stopped').",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "a-thinking",
              "text": "too late"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "a-thinking"
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "expect": {
        "result": true
      }
    },
    {
      "open": "a-thinking"
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": null
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a go"
          }
        }
      ]
    },
    "deliveries": {
      "r1": {
        "ops": []
      }
    }
  }
}
