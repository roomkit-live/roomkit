{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-process-that-stops-while-it-decides-leaves-the-message-for-the-next-holder",
  "title": "A process that stops while its dispatch policy decides leaves the message waiting in the stored queue, and the next process holding the lease decides it",
  "rules": [
    "§19.7.5 rule 18",
    "§19.7.5 rule 16"
  ],
  "requirements": [
    "RK-19.7.5-163"
  ],
  "notes": "Python: test_discussion_dispatch.py test_closing_while_deciding_leaves_the_message_waiting; _dispatching.py, the message left in dispatching until a decision is applied. The run's kit closes while its policy holds the decision at its gate; p2 installs the discussion, takes the lease and asks the policy again once the gate opens: sre, its pick, answers.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "investigator",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "investigator here"
            }
          ]
        }
      },
      {
        "id": "dev",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "dev here"
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "sre here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "investigator",
            "dev",
            "sre"
          ],
          "dispatch": {
            "decisions": [
              [
                "sre"
              ]
            ],
            "gate": "deciding"
          }
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "anyone?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "deciding"
    },
    {
      "call": "close"
    },
    {
      "call": "store.get_room",
      "room_id": "r1",
      "expect": {
        "result": {
          "metadata": {
            "_speak_queue": {
              "entries": [],
              "dispatching": [
                {
                  "event_id": {
                    "$present": true
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d",
      "kit": "p2"
    },
    {
      "open": "deciding"
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "kit": "p2",
      "expect": {
        "result": {
          "speaking": null,
          "queue": []
        }
      }
    }
  ],
  "expect": {
    "dispatch_turns": {
      "d": [
        {
          "event": {
            "content": {
              "body": "anyone?"
            }
          }
        },
        {
          "event": {
            "content": {
              "body": "anyone?"
            }
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "anyone?"
          }
        },
        {
          "source": {
            "channel_id": "sre"
          },
          "content": {
            "body": "sre here"
          }
        }
      ]
    }
  }
}
