{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-person-named-like-a-handle-is-addressed-by-no-name",
  "title": "A person whose name reads like a handle is no name an agent can ask: its @ records no ask, and the notes name them by no @",
  "rules": [
    "§19.7.5 rule 10"
  ],
  "notes": "Python: tests/orchestration/test_discussion_edges.py test_a_person_named_like_a_handle_is_addressed_by_no_name (HITL 9247da98 point 3).",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport",
        "sender_is_participant": true
      },
      {
        "id": "alice",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "noted"
            },
            {
              "text": "@аlice can you confirm?"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ],
        "participants": [
          {
            "id": "m",
            "channel_id": "ops",
            "display_name": "аlice"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "alice"
          ],
          "addressed_only": true
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "m",
        "content": {
          "type": "text",
          "body": "@alice hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "m",
        "content": {
          "type": "text",
          "body": "@alice please check the deploy"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "asked": []
        }
      }
    }
  ],
  "expect": {
    "models": {
      "alice": [
        "$any",
        {
          "messages": [
            "$any",
            "$any",
            {
              "role": "user",
              "text": {
                "$lacks": "@аlice"
              }
            }
          ]
        }
      ]
    }
  }
}
