{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-agent-named-by-an-id-takes-the-name-its-channel-gives",
  "title": "An agent named by an id that is no handle is addressed by the name of the channel the kit holds under it, once the discussion is installed",
  "rules": [
    "§19.7.5 rule 4"
  ],
  "notes": "Python: tests/orchestration/test_discussion_handles.py, strategy.py Discussion.install, _names(agents, kit).",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent:3f2a",
        "type": "ai",
        "agent": {
          "name": "Jev"
        },
        "model": {
          "rounds": [
            {
              "text": "Jev here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "agent:3f2a"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@jev hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@jev hello"
          },
          "addressed_to": [
            "agent:3f2a"
          ]
        },
        {
          "source": {
            "channel_id": "agent:3f2a"
          },
          "content": {
            "body": "Jev here"
          }
        }
      ]
    }
  }
}
