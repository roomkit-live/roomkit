{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-room-with-another-intelligence-channel-is-refused",
  "title": "An install in a room binding another intelligence channel is refused, the room holding no discussion",
  "rules": [
    "§19.7.5 rule 1"
  ],
  "notes": "Python: test_strategy_discussion.py test_a_room_with_another_intelligence_channel_is_refused.",
  "setup": {
    "channels": [
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "other",
        "type": "ai",
        "category": "intelligence"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "other",
            "category": "intelligence"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d",
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": null
      }
    }
  ],
  "expect": {
    "rooms": {
      "r1": {
        "metadata": {
          "_discussion": {
            "$absent": true
          }
        }
      }
    }
  }
}
