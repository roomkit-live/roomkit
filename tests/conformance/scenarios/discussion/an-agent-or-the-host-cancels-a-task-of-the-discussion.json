{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-agent-or-the-host-cancels-a-task-of-the-discussion",
  "title": "A task of the discussion is stopped by its agent's cancel_task or by the host's cancel_task(task_id): each ends cancelled",
  "rules": [
    "§19.7.5 rule 19",
    "§23.4",
    "§23.3"
  ],
  "requirements": [
    "RK-19.7.5-205"
  ],
  "notes": "Python: core/mixins/delegation.py cancel_task, _cancel_task_for; tests/tasks/test_cancel_task.py. The host starts two tasks for comms, both held in their worker. Asked, comms cancels the first with its cancel_task (setup_task_tools); the host cancels the second. Both end cancelled; comms, which asked for the first, is told of the second's cancellation in a turn of its own.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "comms",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "cancel_task",
                  "arguments": {
                    "task_id": "$t1"
                  }
                }
              ]
            },
            {
              "text": "Cancelled the first."
            },
            {
              "text": "The second was cancelled too."
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "helper",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "w1",
              "text": "one"
            },
            {
              "gate": "w2",
              "text": "two"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "comms",
            "sre"
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "completed",
        "trigger": "on_task_completed",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "setup_background",
      "agent_id": "comms",
      "worker": "helper",
      "hand_back": "relay"
    },
    {
      "call": "setup_task_tools",
      "agent_id": "comms"
    },
    {
      "call": "start_task",
      "room_id": "r1",
      "agent_id": "comms",
      "task": "count the tickets",
      "as": "t1"
    },
    {
      "call": "start_task",
      "room_id": "r1",
      "agent_id": "comms",
      "task": "count the alerts",
      "as": "t2"
    },
    {
      "wait_for": "w1"
    },
    {
      "wait_for": "w2"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@comms cancel the ticket count"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "task.wait",
      "task_id": "$t1",
      "expect": {
        "result": {
          "status": "cancelled",
          "output": null
        }
      }
    },
    {
      "call": "cancel_task",
      "task_id": "$t2",
      "expect": {
        "result": true
      }
    },
    {
      "call": "task.wait",
      "task_id": "$t2",
      "expect": {
        "result": {
          "status": "cancelled",
          "output": null
        }
      }
    },
    {
      "open": "w1"
    },
    {
      "open": "w2"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "completed": [
        {
          "trigger": "on_task_completed",
          "room_id": "r1",
          "event": {
            "metadata": {
              "task_status": "cancelled"
            }
          }
        },
        {
          "trigger": "on_task_completed",
          "room_id": "r1",
          "event": {
            "metadata": {
              "task_status": "cancelled"
            }
          }
        }
      ]
    },
    "models": {
      "comms": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$contains": "cancelled"
              }
            }
          ]
        },
        {}
      ]
    }
  }
}
