{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-discussion-written-through-the-kit-is-dropped",
  "title": "A discussion named to create_room or update_room_metadata is dropped, the rest written: the room holds none and its agent answers",
  "rules": [
    "§5.1 The implementation's metadata keys",
    "§19.7.5 rule 16"
  ],
  "notes": "Python: tests/test_framework.py (a key only the framework writes), tests/orchestration/test_discussion_handles.py test_a_discussion_handed_to_the_kit_holds_no_room. The strategy writes these keys through the store, which stays open (HITL 9247da98).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "a1",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "repeat": true,
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "from a1"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "create_room",
      "room": {
        "id": "room-1",
        "metadata": {
          "crm": "c_1",
          "_discussion": {
            "agents": [
              "a1"
            ],
            "handles": {
              "sms": "a1"
            },
            "max_depth": 5
          },
          "_speak_queue": {
            "over": true
          }
        }
      },
      "expect": {
        "result": {
          "metadata": {
            "crm": "c_1",
            "_discussion": {
              "$absent": true
            },
            "_speak_queue": {
              "$absent": true
            }
          }
        }
      }
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "sms"
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "a1",
      "category": "intelligence"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "first"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "update_room_metadata",
      "room_id": "room-1",
      "metadata": {
        "stage": "new",
        "_discussion": {
          "agents": [
            "a1"
          ],
          "handles": {
            "sms": "a1"
          },
          "max_depth": 5
        },
        "_speak_queue": {
          "over": true
        }
      },
      "expect": {
        "result": {
          "metadata": {
            "crm": "c_1",
            "stage": "new",
            "_discussion": {
              "$absent": true
            },
            "_speak_queue": {
              "$absent": true
            }
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "second"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "first"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "from a1"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "second"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "from a1"
          }
        }
      ]
    }
  }
}
