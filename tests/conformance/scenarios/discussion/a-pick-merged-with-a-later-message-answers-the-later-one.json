{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-pick-merged-with-a-later-message-answers-the-later-one",
  "title": "A pick merged with a later message naming the same agent is one turn, answering the later message",
  "rules": [
    "§19.7.5 rule 18"
  ],
  "notes": "Python: tests/orchestration/test_discussion_dispatch.py test_a_pick_merged_with_a_later_message_answers_the_later_one.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "investigator",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "investigator here"
            }
          ]
        }
      },
      {
        "id": "dev",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "dev here"
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "sre here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "investigator",
            "dev",
            "sre"
          ],
          "dispatch": {
            "decisions": [
              [
                "sre"
              ]
            ],
            "gate": "deciding"
          }
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "the error rate is climbing"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "deciding"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@sre check the deploy"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "open": "deciding"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "the error rate is climbing"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@sre check the deploy"
          }
        },
        {
          "source": {
            "channel_id": "sre"
          },
          "content": {
            "body": "sre here"
          },
          "responds_to": "r1#1"
        }
      ]
    }
  }
}
