{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-result-a-closing-process-did-not-post-is-posted-by-the-next-uninstall-after-later-messages",
  "title": "A result a closing process did not post stays kept: neither the process that installs the discussion again nor the turns it gives post it, and the next uninstall posts it after the room's later messages",
  "rules": [
    "§19.7.5 rule 19",
    "§19.7.5 rule 16"
  ],
  "requirements": [
    "RK-19.7.5-187"
  ],
  "notes": "Python: test_discussion_background.py test_a_result_a_closing_kit_did_not_post_is_posted_by_the_next_uninstall; _posts.py post (a closing kit posts nothing), keep. The run's kit holds comms's result, queued behind sre's turn, and closes. p2 installs the discussion and gives sre a turn, then a person's message addressed to no one is committed: the result is posted neither at the reinstall nor at the end of that turn, but by p2's uninstall, after the room's later messages. Not observed: a result whose post failed.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "comms",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "work_in_background",
                  "arguments": {
                    "task": "go through the tickets"
                  }
                }
              ]
            },
            {
              "text": "On it."
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "sre-speaking",
              "text": "sre too late"
            },
            {
              "text": "sre again"
            }
          ]
        }
      },
      {
        "id": "helper",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "working",
              "text": "Findings."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "comms",
            "sre"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ],
    "hooks": [
      {
        "name": "follow",
        "trigger": "on_speak_queue",
        "execution": "async",
        "reactions": [
          {},
          {},
          {},
          {},
          {},
          {
            "gate": "post-queued"
          }
        ]
      },
      {
        "name": "said",
        "trigger": "after_broadcast",
        "execution": "async",
        "reactions": [
          {
            "when": {
              "text": "On it."
            },
            "gate": "said"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "setup_background",
      "agent_id": "comms",
      "worker": "helper",
      "hand_back": "post"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@comms please go through the tickets"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "said"
    },
    {
      "open": "said"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@sre quick one"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "sre-speaking"
    },
    {
      "open": "working"
    },
    {
      "wait_for": "post-queued"
    },
    {
      "open": "post-queued"
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": "sre",
          "queue": [
            "comms"
          ]
        }
      }
    },
    {
      "call": "close"
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d",
      "kit": "p2"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@sre again?"
        }
      },
      "kit": "p2",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "Noted, thanks."
        },
        "addressed_to": []
      },
      "kit": "p2",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "kit": "p2",
      "expect": {
        "result": true
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@comms please go through the tickets"
          }
        },
        {
          "type": "tool_call_start",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "type": "tool_call_end",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "source": {
            "channel_id": "comms"
          },
          "content": {
            "body": "On it."
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@sre quick one"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@sre again?"
          }
        },
        {
          "source": {
            "channel_id": "sre"
          },
          "content": {
            "body": "sre again"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "Noted, thanks."
          }
        },
        {
          "source": {
            "channel_id": "comms"
          },
          "content": {
            "body": {
              "$contains": [
                "Result of the task",
                "go through the tickets",
                "Findings."
              ]
            }
          }
        }
      ]
    }
  }
}
