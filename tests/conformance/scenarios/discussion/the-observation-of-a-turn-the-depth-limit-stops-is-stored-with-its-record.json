{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/the-observation-of-a-turn-the-depth-limit-stops-is-stored-with-its-record",
  "title": "The observation of a discussion's turn the depth limit stops is stored with its record, before the turn given after it is answered, not once that turn's cascade ends",
  "rules": [
    "§8.3",
    "§19.7.5 rule 11"
  ],
  "requirements": [
    "RK-8.3-022",
    "RK-8.3-023",
    "RK-8.3-024",
    "RK-8.3-027",
    "RK-8.3-049"
  ],
  "notes": "One process; the discussion's max_depth is 3. While `a` takes its turn, held at `a-held`, `hello` asks `b` at chain depth 2, and `@c look` asks `c`. Once `a` answers, the next pick stops `b`'s turn, whose answer would reach the limit, and gives `c` its turn. `b`'s record and its observation are stored before `c`'s answer is committed. `c`'s answer is held at `c-out` in its delivery to `ops`: the observation is already stored, though `c`'s turn's cascade is not over. Python: orchestration/strategies/discussion/_driver.py `_planned_turn` and `_record_depth_stop`, under the room's lock the turn was planned under.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport",
        "deliver": [
          {
            "when": {
              "text": "c here"
            },
            "gate": "c-out"
          }
        ]
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "a-held",
              "text": "a here"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "c",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "c here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b",
            "c"
          ],
          "max_depth": 3
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "a-held"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "hello"
        },
        "addressed_to": [
          "b"
        ],
        "chain_depth": 2
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@c look"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": "a",
          "queue": [
            "b",
            "c"
          ]
        }
      }
    },
    {
      "open": "a-held"
    },
    {
      "wait_for": "c-out"
    },
    {
      "call": "list_observations",
      "room_id": "r1",
      "expect": {
        "result": [
          {
            "category": "event_chain_depth_exceeded",
            "channel_id": "b",
            "metadata": {
              "chain_depth": 3,
              "max_chain_depth": 3
            }
          }
        ]
      }
    },
    {
      "open": "c-out"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "a": [
        {}
      ],
      "b": [],
      "c": [
        {}
      ]
    },
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a go"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "hello"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@c look"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a here"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "status": "blocked",
          "blocked_by": "event_chain_depth_limit"
        },
        {
          "source": {
            "channel_id": "c"
          },
          "content": {
            "body": "c here"
          }
        }
      ]
    },
    "observations": {
      "r1": [
        {
          "category": "event_chain_depth_exceeded",
          "channel_id": "b"
        }
      ]
    }
  }
}
