{
  "$schema": "../../scenario.schema.json",
  "rules": [
    "§19.7.5 rule 7"
  ],
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "watch",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "@ops could you confirm?"
            },
            {
              "text": "regenerated"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "watch"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ],
          "people": [
            "ops"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a hello"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "waiting": true,
          "speaking": null
        }
      }
    },
    {
      "call": "listen_only",
      "room_id": "r1",
      "channel_ids": [
        "a"
      ]
    },
    {
      "call": "regenerate_response",
      "room_id": "r1",
      "expect": {
        "result": {
          "event": {
            "id": "r1#0"
          },
          "blocked": false,
          "reason": null,
          "error": null,
          "response_events": []
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "waiting": true,
          "listening": [
            "a"
          ],
          "speaking": null,
          "queue": []
        }
      }
    }
  ],
  "expect": {
    "models": {
      "a": [
        {},
        {}
      ],
      "b": []
    },
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a hello"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "@ops could you confirm?"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "regenerated"
          },
          "responds_to": "r1#0"
        }
      ]
    }
  },
  "id": "discussion/a-regenerated-turn-runs-while-waiting-and-listening",
  "title": "Regeneration gives the last speaker its own turn while the discussion waits and the agent only listens",
  "notes": "Python: tests/test_discussion_queue.py::test_while_it_waits_for_a_person_only_a_turn_of_its_own_is_given; discussion/_queue.py::_may_take and own_turn, exercised through regenerate_response (RFC rule 7)."
}
