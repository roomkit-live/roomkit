{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-message-s-turn-asks-the-speak-policy-and-an-instruction-s-does-not",
  "title": "A turn a message asked for is submitted to the agent's speak policy, whose silence runs no generation and ends the turn; an instruction's turn is not submitted",
  "rules": [
    "§19.7.5 rule 13",
    "§6.4"
  ],
  "requirements": [
    "RK-19.7.5-108",
    "RK-19.7.5-109"
  ],
  "notes": "The person names b then a: b's policy decides silent, b's model is not asked, and a's turn follows. An instruction for b then gives b a turn its policy is not asked about.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a here"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "speak_policy": {
          "decisions": [
            {
              "decision": {
                "mode": "silent",
                "reason": "nothing to add"
              }
            }
          ]
        },
        "model": {
          "rounds": [
            {
              "text": "b: summary"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@b @a status?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "b: summarise"
        },
        "event_type": "instruction",
        "addressed_to": [
          "b"
        ]
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@b @a status?"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a here"
          }
        },
        {
          "type": "instruction_read",
          "source": {
            "channel_id": "b"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b: summary"
          }
        }
      ]
    },
    "speak_turns": {
      "b": [
        {
          "event": {
            "content": {
              "body": "@b @a status?"
            }
          }
        }
      ]
    },
    "models": {
      "a": [
        {}
      ],
      "b": [
        {
          "messages": [
            "$any",
            "$any",
            {
              "text": {
                "$contains": "b: summarise"
              }
            }
          ]
        }
      ]
    }
  }
}
