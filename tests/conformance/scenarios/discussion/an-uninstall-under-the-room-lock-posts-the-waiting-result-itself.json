{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-uninstall-under-the-room-lock-posts-the-waiting-result-itself",
  "title": "A host that uninstalls a discussion while it holds the room lock has the result waiting to be posted posted by the uninstall itself, before its agents leave",
  "rules": [
    "§19.7.5 rule 19",
    "§13.5"
  ],
  "requirements": [
    "RK-19.7.5-182",
    "RK-19.7.5-185"
  ],
  "notes": "Python: test_discussion_background.py test_a_result_queued_when_the_strategy_is_uninstalled_is_posted_before_its_agent_leaves[under_the_lock]; _posts.py post_all in the uninstall's own task. comms's result is queued behind sre's turn; the host takes the room lock and uninstalls under it: the call returns, the result posted as comms's message, then comms and sre detached, sre's turn cut. For RK-19.7.5-182, the result queued when the discussion is uninstalled is posted. Not observed: a post turn's commit already waiting for the lock the host holds (test_a_result_being_posted_when_the_strategy_is_uninstalled_is_posted_once_first), which no step stages; for RK-19.7.5-182, the wait for the floor.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "comms",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "work_in_background",
                  "arguments": {
                    "task": "go through the tickets"
                  }
                }
              ]
            },
            {
              "text": "On it."
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "sre-speaking",
              "text": "sre too late"
            }
          ]
        }
      },
      {
        "id": "helper",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "working",
              "text": "Findings."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "comms",
            "sre"
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "follow",
        "trigger": "on_speak_queue",
        "execution": "async",
        "reactions": [
          {},
          {},
          {},
          {},
          {},
          {
            "gate": "post-queued"
          }
        ]
      },
      {
        "name": "said",
        "trigger": "after_broadcast",
        "execution": "async",
        "reactions": [
          {
            "when": {
              "text": "On it."
            },
            "gate": "said"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "setup_background",
      "agent_id": "comms",
      "worker": "helper",
      "hand_back": "post"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@comms please go through the tickets"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "said"
    },
    {
      "open": "said"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@sre quick one"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "sre-speaking"
    },
    {
      "open": "working"
    },
    {
      "wait_for": "post-queued"
    },
    {
      "open": "post-queued"
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": "sre",
          "queue": [
            "comms"
          ]
        }
      }
    },
    {
      "under_lock": "r1",
      "do": [
        {
          "call": "uninstall_strategy",
          "room_id": "r1",
          "expect": {
            "result": true
          }
        }
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@comms please go through the tickets"
          }
        },
        {
          "type": "tool_call_start",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "type": "tool_call_end",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "source": {
            "channel_id": "comms"
          },
          "content": {
            "body": "On it."
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@sre quick one"
          }
        },
        {
          "source": {
            "channel_id": "comms"
          },
          "content": {
            "body": {
              "$contains": [
                "Result of the task",
                "go through the tickets",
                "Findings."
              ]
            }
          }
        }
      ]
    },
    "bindings": {
      "r1": {
        "ops": {
          "channel_id": "ops"
        },
        "comms": null,
        "sre": null
      }
    }
  }
}
