{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-turn-with-no-text-leaves-no-row",
  "title": "A turn that ends with no text stores no row and delivers nothing",
  "rules": [
    "§19.7.5 rule 13"
  ],
  "requirements": [
    "RK-19.7.5-113"
  ],
  "notes": "The person names a then b; a's model answers no text.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": ""
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a @b report"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a @b report"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b here"
          }
        }
      ]
    },
    "deliveries": {
      "r1": {
        "ops": [
          {
            "source": {
              "channel_id": "b"
            },
            "content": {
              "body": "b here"
            }
          }
        ]
      }
    },
    "models": {
      "a": [
        {}
      ],
      "b": [
        {}
      ]
    }
  }
}
