{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/uninstalling-in-one-process-ends-the-discussion-in-the-others",
  "title": "A discussion uninstalled in one process is left by another that followed it: no name is read there any more, and the room answers by its policy",
  "rules": [
    "§19.7.5 rule 16",
    "§19.7.5 rule 1"
  ],
  "notes": "Python: test_discussion_processes.py test_uninstalling_in_one_process_ends_the_discussion_in_the_others. a is bound by the host, so the uninstall leaves it bound.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a here"
            },
            {
              "text": "a again"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "a",
            "category": "intelligence"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a hello"
        }
      },
      "kit": "p2",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a plain room again?"
        }
      },
      "kit": "p2",
      "expect": {
        "result": {
          "blocked": false,
          "error": null,
          "response_events": [
            {
              "source": {
                "channel_id": "a"
              },
              "content": {
                "body": "a again"
              }
            }
          ]
        }
      }
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "kit": "p2",
      "expect": {
        "result": null
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a hello"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a here"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a plain room again?"
          },
          "addressed_to": null
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a again"
          }
        }
      ]
    }
  }
}
