{
  "$schema": "../../scenario.schema.json",
  "rules": [
    "§19.7.5 rule 7",
    "§19.7.5 rule 16"
  ],
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "watch",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "first answer"
            },
            {
              "text": "a regenerated"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "watch"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "fresh"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a hello"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "regenerate_response",
      "room_id": "r1",
      "kit": "fresh",
      "expect": {
        "result": {
          "event": {
            "id": "r1#0"
          },
          "blocked": false,
          "reason": null,
          "error": null,
          "response_events": []
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "a": [
        {},
        {}
      ],
      "b": []
    },
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a hello"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "first answer"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a regenerated"
          },
          "responds_to": "r1#0"
        }
      ]
    }
  },
  "id": "discussion/a-fresh-kit-queues-regeneration-in-the-stored-discussion",
  "title": "A kit first reading an active stored Discussion queues its regeneration for the owning kit to give",
  "notes": "Python: core/mixins/regenerate.py::regenerate_response follows the stored Discussion before regenerating; RFC rules 7 and 16. Local shared store, not an external process/service proof."
}
