{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-question-asked-while-tasks-run-is-answered-in-its-turn",
  "title": "Tasks run in parallel with the discussion's turns and with one another: a question asked while two tasks run is answered in its turn, and each result comes back in a turn of its own",
  "rules": [
    "§19.7.5 rule 19",
    "§23.4"
  ],
  "requirements": [
    "RK-19.7.5-176"
  ],
  "notes": "Python: tests/orchestration/test_discussion_background.py test_a_question_asked_while_a_task_runs_is_answered_in_its_turn. comms starts two tasks in one round; both workers reach their gates together, then sre is asked and answers while both are held (an after_broadcast observer holds on its answer). The gates open: each relayed result is a turn of comms's own. Which worker run takes which gate, and which result comes back first, is not asserted.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "comms",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "work_in_background",
                  "arguments": {
                    "task": "go through the tickets"
                  }
                },
                {
                  "id": "c2",
                  "name": "work_in_background",
                  "arguments": {
                    "task": "go through the alerts"
                  }
                }
              ]
            },
            {
              "text": "On it."
            },
            {
              "text": "First result shared."
            },
            {
              "text": "Second result shared."
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "6 percent."
            }
          ]
        }
      },
      {
        "id": "helper",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "first-task",
              "text": "Findings: one."
            },
            {
              "gate": "second-task",
              "text": "Findings: two."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "comms",
            "sre"
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "sre-answered",
        "trigger": "after_broadcast",
        "execution": "async",
        "reactions": [
          {
            "when": {
              "text": "6 percent."
            },
            "gate": "sre-answered"
          }
        ]
      },
      {
        "name": "said",
        "trigger": "after_broadcast",
        "execution": "async",
        "reactions": [
          {
            "when": {
              "text": "On it."
            },
            "gate": "said"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "setup_background",
      "agent_id": "comms",
      "worker": "helper",
      "hand_back": "relay"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@comms please go through the tickets and the alerts"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "first-task"
    },
    {
      "wait_for": "second-task"
    },
    {
      "wait_for": "said"
    },
    {
      "open": "said"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@sre quick one: the error rate?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "sre-answered"
    },
    {
      "open": "sre-answered"
    },
    {
      "open": "first-task"
    },
    {
      "open": "second-task"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@comms please go through the tickets and the alerts"
          }
        },
        {
          "type": "tool_call_start",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "type": "tool_call_start",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "type": "tool_call_end",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "type": "tool_call_end",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "source": {
            "channel_id": "comms"
          },
          "content": {
            "body": "On it."
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@sre quick one: the error rate?"
          }
        },
        {
          "source": {
            "channel_id": "sre"
          },
          "content": {
            "body": "6 percent."
          }
        },
        {
          "type": "instruction_read",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "source": {
            "channel_id": "comms"
          },
          "content": {
            "body": "First result shared."
          }
        },
        {
          "type": "instruction_read",
          "source": {
            "channel_id": "comms"
          }
        },
        {
          "source": {
            "channel_id": "comms"
          },
          "content": {
            "body": "Second result shared."
          }
        }
      ]
    }
  }
}
