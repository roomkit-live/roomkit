        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "comms",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "work_in_background",
                  "arguments": {
                    "task": "go through the tickets"
                  }
