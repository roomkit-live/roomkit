{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-instruction-to-an-agent-of-a-discussion-is-not-delivered",
  "title": "An instruction to an agent of a discussion goes to the discussion: nothing is delivered and nothing asked at broadcast",
  "rules": [
    "§19.7.5 rule 7",
    "§10.1.1"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "a1",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "from a1"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "a2",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "from a2"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "store.create_room",
      "room": {
        "id": "room-1",
        "metadata": {
          "_discussion": {
            "agents": [
              "a1",
              "a2"
            ],
            "max_depth": 5
          }
        }
      }
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "sms"
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "a1",
      "category": "intelligence"
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "a2",
      "category": "intelligence"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Introduce yourself"
        },
        "event_type": "instruction",
        "addressed_to": [
          "a1"
        ]
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    }
  ],
  "expect": {
    "turns": {
      "room-1": {
        "a1": [],
        "a2": []
      }
    }
  }
}
