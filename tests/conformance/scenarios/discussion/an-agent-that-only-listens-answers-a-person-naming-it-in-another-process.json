{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-agent-that-only-listens-answers-a-person-naming-it-in-another-process",
  "title": "An agent set to only listen in one process takes the one turn a person's message naming it gives in another: the process giving it does not cut it, and it keeps listening",
  "rules": [
    "§19.7.5 rule 16",
    "§19.7.5 rule 12"
  ],
  "notes": "Python: test_discussion_processes.py test_an_agent_that_only_listens_answers_a_person_naming_it_in_another_process.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b: metrics are flat"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "listen_only",
      "room_id": "r1",
      "channel_ids": [
        "b"
      ]
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@b what do the metrics say?"
        }
      },
      "kit": "p2",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "listening": [
            "b"
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@b what do the metrics say?"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b: metrics are flat"
          }
        }
      ]
    }
  }
}
