{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-room-holding-a-discussion-refuses-what-it-cannot-share",
  "title": "A room a discussion holds refuses an attach of another intelligence channel, and of a voice channel",
  "rules": [
    "§19.7.5 rule 1"
  ],
  "notes": "Python: core/mixins/discussion.py _refuse_discussion_binding.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "other",
        "type": "ai",
        "category": "intelligence"
      },
      {
        "id": "phone",
        "type": "voice",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "attach_channel",
      "room_id": "r1",
      "channel_id": "other",
      "category": "intelligence",
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "attach_channel",
      "room_id": "r1",
      "channel_id": "phone",
      "expect": {
        "error": "invalid_argument"
      }
    }
  ]
}
