{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-hook-s-injected-instruction-gives-no-turn",
  "title": "A hook-injected instruction is dropped: only the agent the original message names is queued and answers",
  "rules": [
    "§19.7.5 rule 8",
    "§9.4 Injected events"
  ],
  "notes": "Python: tests/orchestration/test_discussion_edges.py::test_a_hook_s_injected_instruction_gives_no_turn.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a done"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "direct",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "@b go"
            },
            "result": {
              "action": "allow",
              "injected_events": [
                {
                  "event": {
                    "type": "instruction",
                    "addressed_to": [
                      "a"
                    ],
                    "content": {
                      "type": "text",
                      "body": "Summarise the incident."
                    }
                  },
                  "target_channel_ids": [
                    "a"
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "name": "follow",
        "trigger": "on_speak_queue",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@b go"
        },
        "event_type": "message",
        "addressed_to": [
          "b"
        ],
        "chain_depth": 0
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "queue": [],
          "waiting": false
        }
      }
    }
  ],
  "expect": {
    "models": {
      "a": [],
      "b": [
        {}
      ]
    },
    "timeline": {
      "r1": [
        {
          "type": "message",
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "type": "text",
            "body": "@b go"
          }
        },
        {
          "type": "message",
          "source": {
            "channel_id": "b"
          },
          "content": {
            "type": "text",
            "body": "b done"
          }
        }
      ]
    },
    "deliveries": {
      "r1": {
        "ops": [
          {
            "type": "message",
            "source": {
              "channel_id": "b"
            },
            "content": {
              "type": "text",
              "body": "b done"
            }
          }
        ]
      }
    },
    "hooks": {
      "follow": [
        {
          "speak_queue": {
            "change": "queued",
            "channel_ids": [
              "b"
            ]
          }
        },
        {
          "speak_queue": {
            "change": "turn_given",
            "channel_ids": [
              "b"
            ]
          }
        },
        {
          "speak_queue": {
            "change": "turn_ended",
            "channel_ids": [
              "b"
            ]
          }
        }
      ]
    }
  }
}
