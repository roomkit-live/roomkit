{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-process-whose-install-another-replaced-is-current-again-once-it-installs",
  "title": "A process whose installed discussion another process replaced gives no turn, its message queued for whoever gives them; once its host installs the discussion again it is current and gives the turn",
  "rules": [
    "§19.7.5 rule 16",
    "§19.7.5 rule 1"
  ],
  "notes": "Python: test_discussion_processes.py test_a_process_whose_install_another_replaced_is_current_again_once_it_installs. p2 installs without c and stops (its close gives the lease up); the run's kit routes and queues @a but gives no turn. Its install of a, b and c again takes the discussion back, binds c again, and gives the queued turn.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a here"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": []
        }
      },
      {
        "id": "c",
        "type": "ai",
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b",
            "c"
          ]
        }
      },
      {
        "id": "kept",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "kept",
      "kit": "p2"
    },
    {
      "call": "room_strategy_is_current",
      "room_id": "r1",
      "kind": "Discussion",
      "expect": {
        "result": true
      },
      "kit": "p2"
    },
    {
      "call": "room_strategy_is_current",
      "room_id": "r1",
      "kind": "Discussion",
      "expect": {
        "result": false
      }
    },
    {
      "call": "close",
      "kit": "p2"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a are you there?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null,
          "response_events": []
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "queue": [
            "a"
          ]
        }
      }
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "room_strategy_is_current",
      "room_id": "r1",
      "kind": "Discussion",
      "expect": {
        "result": true
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a are you there?"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a here"
          }
        }
      ]
    },
    "bindings": {
      "r1": {
        "ops": {
          "channel_id": "ops"
        },
        "a": {
          "channel_id": "a"
        },
        "b": {
          "channel_id": "b"
        },
        "c": {
          "channel_id": "c"
        }
      }
    }
  }
}
