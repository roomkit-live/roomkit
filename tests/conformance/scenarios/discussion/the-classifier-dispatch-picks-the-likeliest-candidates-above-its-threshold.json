{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/the-classifier-dispatch-picks-the-likeliest-candidates-above-its-threshold",
  "title": "The classifier dispatch policy gives the message to the candidates whose probability reaches its threshold, 0.5 by default, likeliest first, two at most by default; with none reaching it, no agent takes it; each probability is reported under its channel id",
  "rules": [
    "§19.7.5 rule 18",
    "§6.8"
  ],
  "requirements": [
    "RK-19.7.5-172",
    "RK-19.7.5-173"
  ],
  "notes": "The discussion's dispatch policy is the implementation's classifier dispatch over its mock classifier, at its default threshold and number of agents. Three candidates reach the threshold on the first message: the two likeliest take it, the likeliest answering first. No candidate reaches it on the thanks: no agent takes it. The questions' names are the implementation's. Python: orchestration/strategies/discussion/dispatch/classifier.py.",
  "requires_features": [
    "classifier_dispatch"
  ],
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "investigator",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "investigator here"
            }
          ]
        }
      },
      {
        "id": "dev",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "dev here"
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "sre here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "investigator",
            "dev",
            "sre"
          ],
          "dispatch": {
            "classifier": {
              "calls": [
                {
                  "answers": {
                    "agent_0": 0.6,
                    "agent_1": 0.9,
                    "agent_2": 0.7
                  }
                },
                {
                  "answers": {
                    "agent_0": 0.2,
                    "agent_1": 0.4,
                    "agent_2": 0.1
                  }
                }
              ]
            }
          }
        }
      }
    ],
    "hooks": [
      {
        "name": "dispatched",
        "trigger": "on_dispatch_decision",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "the checkout is slow"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "thanks, all"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "classifier_calls": {
      "d/dispatch": [
        {
          "$present": true
        },
        {
          "$present": true
        }
      ]
    },
    "hooks": {
      "dispatched": [
        {
          "dispatch_decision": {
            "decision": {
              "agents": [
                "dev",
                "sre"
              ],
              "judgments": {
                "investigator": 0.6,
                "dev": 0.9,
                "sre": 0.7
              }
            }
          }
        },
        {
          "dispatch_decision": {
            "decision": {
              "agents": [],
              "judgments": {
                "investigator": 0.2,
                "dev": 0.4,
                "sre": 0.1
              }
            }
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "the checkout is slow"
          }
        },
        {
          "source": {
            "channel_id": "dev"
          },
          "content": {
            "body": "dev here"
          }
        },
        {
          "source": {
            "channel_id": "sre"
          },
          "content": {
            "body": "sre here"
          }
        },
        {
          "content": {
            "body": "thanks, all"
          }
        }
      ]
    }
  }
}
