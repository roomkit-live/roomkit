{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/listen-only-on-a-turn-given-but-not-started-cuts-it",
  "title": "listen_only on an agent whose turn was given and has not started cuts it before it runs: the agent says nothing",
  "rules": [
    "§19.7.5 rule 12",
    "§10.2"
  ],
  "requirements": [
    "RK-19.7.5-017",
    "RK-19.7.5-100",
    "RK-19.7.5-106",
    "RK-19.7.5-138",
    "RK-19.7.5-145"
  ],
  "notes": "The transport holds the room's delivery lane while the strategy gives agent a its turn. The queue identifies the speaking agent before the transport calls listen_only from the preceding delivery. The agent's model receives no call.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "observer",
        "type": "websocket",
        "category": "transport",
        "deliver": [
          {
            "when": {
              "text": "@a go"
            },
            "gate": "hold-delivery",
            "do": [
              {
                "call": "listen_only",
                "room_id": "r1",
                "channel_ids": [
                  "a"
                ],
                "as": "held",
                "expect": {
                  "result": null
                }
              }
            ]
          }
        ]
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a should not be heard"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "observer"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "given",
        "trigger": "on_speak_queue",
        "execution": "async",
        "reactions": [
          {},
          {
            "gate": "turn-given"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a go"
        }
      },
      "background": true,
      "as": "inbound"
    },
    {
      "wait_for": "hold-delivery"
    },
    {
      "wait_for": "turn-given"
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": "a",
          "listening": []
        }
      }
    },
    {
      "open": "hold-delivery"
    },
    {
      "open": "turn-given"
    },
    {
      "await": "inbound",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "listening": [
            "a"
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a go"
          }
        }
      ]
    },
    "deliveries": {
      "r1": {
        "ops": []
      }
    },
    "models": {
      "a": []
    }
  }
}
