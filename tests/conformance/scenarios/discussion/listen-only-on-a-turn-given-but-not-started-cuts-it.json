{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/listen-only-on-a-turn-given-but-not-started-cuts-it",
  "title": "listen_only on an agent whose turn was given and has not started cuts it before it runs: the agent says nothing",
  "rules": [
    "§19.7.5 rule 12"
  ],
  "notes": "Python: test_discussion_edges.py test_listen_only_on_a_turn_given_but_not_started_cuts_it. The hook's second call is the turn given; a Cancel reaches no loop yet, so the turn is abandoned (_driver.py cut).",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a should not be heard"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "hold",
        "trigger": "on_speak_queue",
        "execution": "async",
        "reactions": [
          {},
          {
            "do": [
              {
                "call": "listen_only",
                "room_id": "r1",
                "channel_ids": [
                  "a"
                ],
                "as": "held"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "listening": [
            "a"
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a go"
          }
        }
      ]
    },
    "deliveries": {
      "r1": {
        "ops": []
      }
    }
  }
}
