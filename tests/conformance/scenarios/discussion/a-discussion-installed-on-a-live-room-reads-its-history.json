{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-discussion-installed-on-a-live-room-reads-its-history",
  "title": "A discussion installed on a room in use: its agents' turns read what the room said before",
  "rules": [
    "§19.7",
    "§19.7.5 rule 1"
  ],
  "notes": "Python: tests/orchestration/test_strategy_install.py test_a_discussion_installed_on_a_live_room_reads_its_history.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "noted"
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "the metrics spike at 14:05"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "a",
            "category": "intelligence"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "sre"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "checkout is failing"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@sre what do the metrics say?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "sre": [
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": "checkout is failing"
              }
            },
            {
              "role": "user",
              "text": {
                "$contains": "noted"
              }
            },
            {
              "role": "user",
              "text": {
                "$contains": "what do the metrics say?"
              }
            }
          ]
        }
      ]
    },
    "bindings": {
      "r1": {
        "sre": {
          "category": "intelligence"
        }
      }
    }
  }
}
