{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-instruction-a-follower-takes-is-dropped",
  "title": "An instruction a process that only follows the discussion takes is no turn of anyone's: that process would hold its text and gives no turn, so nothing is queued and nobody answers",
  "rules": [
    "§19.7.5 rule 16"
  ],
  "notes": "Python: _room.py queue_instruction, a process that gives no turn tells the instruction dropped; test_discussion_processes.py test_an_instruction_or_a_result_reaching_a_process_that_gives_no_turn_is_not_kept reaches it by a replaced configuration.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a should not answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a"
          ]
        }
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "kit": "p2",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "summarise"
        },
        "event_type": "instruction",
        "addressed_to": [
          "a"
        ]
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": null,
          "queue": []
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": []
    }
  }
}
