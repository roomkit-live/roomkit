{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/an-agent-naming-another-queues-it-once-its-turn-has-ended",
  "title": "An agent's @b gives b one turn, named twice or not, once the agent's own turn has ended; the row keeps the address",
  "rules": [
    "§19.7.5 rule 5",
    "§19.7.5 rule 6"
  ],
  "notes": "Python: test_strategy_discussion.py test_an_agent_naming_another_queues_it_once_its_turn_has_ended.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "@b can you check the logs? @b they are in /var/log"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "logs are clean"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a please investigate"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a please investigate"
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "@b can you check the logs? @b they are in /var/log"
          },
          "addressed_to": [
            "b"
          ],
          "chain_depth": 1
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "logs are clean"
          },
          "chain_depth": 2
        }
      ]
    }
  }
}
