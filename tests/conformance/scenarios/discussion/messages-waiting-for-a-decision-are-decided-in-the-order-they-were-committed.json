{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/messages-waiting-for-a-decision-are-decided-in-the-order-they-were-committed",
  "title": "Messages waiting for the dispatch policy are decided in the order they were committed, one after the other",
  "rules": [
    "§19.7.5 rule 18"
  ],
  "requirements": [
    "RK-19.7.5-161"
  ],
  "notes": "Python: _queue.py SpeakQueueState.dispatching (in the order committed), _driver.py _planned_turn, _waiting_decision. The policy holds its first decision at its gate while two more messages are committed; once opened it is handed the three in order, each decision putting its agent at its message's place.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "investigator",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "investigator here"
            }
          ]
        }
      },
      {
        "id": "dev",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "dev here"
            }
          ]
        }
      },
      {
        "id": "sre",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "sre here"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "investigator",
            "dev",
            "sre"
          ],
          "dispatch": {
            "decisions": [
              [
                "dev"
              ],
              [
                "sre"
              ],
              [
                "investigator"
              ]
            ],
            "gate": "deciding"
          }
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "first: the error rate"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "deciding"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "second: the latency"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "third: the alerts"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "open": "deciding"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "dispatch_turns": {
      "d": [
        {
          "event": {
            "content": {
              "body": "first: the error rate"
            }
          }
        },
        {
          "event": {
            "content": {
              "body": "second: the latency"
            }
          }
        },
        {
          "event": {
            "content": {
              "body": "third: the alerts"
            }
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "first: the error rate"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "second: the latency"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "third: the alerts"
          }
        },
        {
          "source": {
            "channel_id": "dev"
          },
          "content": {
            "body": "dev here"
          }
        },
        {
          "source": {
            "channel_id": "sre"
          },
          "content": {
            "body": "sre here"
          }
        },
        {
          "source": {
            "channel_id": "investigator"
          },
          "content": {
            "body": "investigator here"
          }
        }
      ]
    }
  }
}
