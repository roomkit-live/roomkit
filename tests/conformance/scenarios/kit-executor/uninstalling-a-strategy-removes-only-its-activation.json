{
  "$schema": "../../scenario.schema.json",
  "id": "kit-executor/uninstalling-a-strategy-removes-only-its-activation",
  "title": "Uninstalling a strategy disables its names without removing definitions or another room’s activation",
  "rules": [
    "§9.1",
    "§10.6.6",
    "§17.2",
    "§19.7"
  ],
  "notes": "Python: tests/test_turn_hooks.py::test_uninstalling_a_strategy_takes_back_its_room_hook_on_the_executor. A definition shared with another room survives uninstall.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "call-1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ]
            },
            {
              "text": "answer-1"
            },
            {
              "calls": [
                {
                  "id": "call-2",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ]
            },
            {
              "text": "answer-2"
            },
            {
              "calls": [
                {
                  "id": "call-3",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ]
            },
            {
              "text": "answer-3"
            }
          ]
        },
        "tools": [
          {
            "name": "lookup_order",
            "description": "Find an order by its number",
            "parameters": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "string"
                }
              }
            },
            "returns": "{\"order\": \"1\", \"status\": \"ready\"}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "audit-strategy",
        "agents": [],
        "install": {
          "do": [
            {
              "call": "enable_room_hook",
              "room_id": "$room",
              "name": "audit"
            }
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "kit_executor.room_hook",
      "hook": {
        "name": "audit",
        "trigger": "before_tool_use"
      }
    },
    {
      "call": "enable_room_hook",
      "room_id": "room-2",
      "name": "audit"
    },
    {
      "call": "install_strategy",
      "room_id": "room-1",
      "strategy": "audit-strategy"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "uninstall_strategy",
      "room_id": "room-1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "disable_room_hook",
      "room_id": "room-1",
      "name": "audit",
      "expect": {
        "result": false
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "audit": [
        {
          "room_id": "room-1",
          "tool_call": {
            "tool_call_id": "call-1"
          }
        },
        {
          "room_id": "room-2",
          "tool_call": {
            "tool_call_id": "call-3"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {},
        {},
        {},
        {},
        {},
        {}
      ]
    }
  }
}
