{
  "$schema": "../../scenario.schema.json",
  "id": "kit-executor/named-hooks-are-opt-in-per-room",
  "title": "A named hook needs activation; an executor global hook observes every room",
  "rules": [
    "§9.1",
    "§10.6.6",
    "§17.2"
  ],
  "notes": "Python: tests/test_turn_hooks.py::test_a_hook_on_the_kits_executor_fires_for_an_ai_turn and test_a_room_hook_on_the_executor_fires_in_its_room_only; tests/test_turns_wiring.py. Repeated enabling is idempotent.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "call-1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ]
            },
            {
              "text": "answer-1"
            },
            {
              "calls": [
                {
                  "id": "call-2",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ]
            },
            {
              "text": "answer-2"
            },
            {
              "calls": [
                {
                  "id": "call-3",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ]
            },
            {
              "text": "answer-3"
            },
            {
              "calls": [
                {
                  "id": "call-4",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ]
            },
            {
              "text": "answer-4"
            }
          ]
        },
        "tools": [
          {
            "name": "lookup_order",
            "description": "Find an order by its number",
            "parameters": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "string"
                }
              }
            },
            "returns": "{\"order\": \"1\", \"status\": \"ready\"}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "kit_executor.hook",
      "hook": {
        "name": "global",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    },
    {
      "call": "kit_executor.room_hook",
      "hook": {
        "name": "audit",
        "trigger": "before_tool_use"
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "enable_room_hook",
      "room_id": "room-1",
      "name": "audit"
    },
    {
      "call": "enable_room_hook",
      "room_id": "room-1",
      "name": "audit"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "disable_room_hook",
      "room_id": "room-1",
      "name": "audit",
      "expect": {
        "result": true
      }
    },
    {
      "call": "disable_room_hook",
      "room_id": "room-1",
      "name": "audit",
      "expect": {
        "result": false
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "audit": [
        {
          "trigger": "before_tool_use",
          "room_id": "room-1",
          "tool_call": {
            "tool_call_id": "call-2"
          }
        }
      ],
      "global": [
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "tool_call_id": "call-1"
          }
        },
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "tool_call_id": "call-2"
          }
        },
        {
          "trigger": "on_tool_call",
          "room_id": "room-2",
          "tool_call": {
            "tool_call_id": "call-3"
          }
        },
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "tool_call_id": "call-4"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {}
      ]
    }
  }
}
