{
  "$schema": "../../scenario.schema.json",
  "id": "kit-executor/a-channel-declared-while-a-kit-turn-hook-could-fire-for-it-is-refused",
  "title": "A channel's declaration is refused while a hook on a turn trigger registered on the kit could fire for it, a room hook included; once the room hook is removed, or when the hook's filter leaves the channel out, the declaration is kept",
  "rules": [
    "§9.1",
    "§10.6.6",
    "§10.6.2"
  ],
  "requirements": [
    "RK-10.6.6-009"
  ],
  "notes": "Python: tests/test_turn_hooks.py::test_a_kit_turn_hook_a_declared_channel_could_fire_is_refused_in_either_order (the hook first), ::test_a_kit_turn_hook_whose_filter_leaves_the_declared_channel_out_is_kept and ::test_a_kit_room_turn_hook_is_refused_while_any_channel_is_declared (the room hook first). The hooks stand before any channel is declared. A room hook has no channel filter: while it stands, billing's declaration is refused. The global hook kept is filtered to helper and support: it leaves billing out, not support, whose declaration is refused and leaves support unregistered. The kept hook fires for helper's call, on the kit's own executor.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "helper",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "Found."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "helper",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "add_room_hook",
      "room_id": "r1",
      "hook": {
        "name": "room_gate",
        "trigger": "before_tool_use"
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "billing",
        "type": "ai",
        "category": "intelligence",
        "declared": true
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "remove_room_hook",
      "room_id": "r1",
      "name": "room_gate",
      "expect": {
        "result": true
      }
    },
    {
      "call": "register_hook",
      "hook": {
        "name": "kept",
        "trigger": "on_tool_call",
        "execution": "async",
        "channel_ids": [
          "helper",
          "support"
        ]
      },
      "expect": {
        "result": null
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "billing",
        "type": "ai",
        "category": "intelligence",
        "declared": true
      },
      "expect": {
        "result": null
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "support",
        "type": "ai",
        "category": "intelligence",
        "declared": true
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "attach_channel",
      "room_id": "r1",
      "channel_id": "support",
      "category": "intelligence",
      "expect": {
        "error": "channel_not_registered"
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look it up."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "room_gate": [],
      "kept": [
        {
          "trigger": "on_tool_call",
          "room_id": "r1",
          "tool_call": {
            "name": "lookup",
            "tool_call_id": "c1",
            "result": "found",
            "is_error": false
          }
        }
      ]
    },
    "models": {
      "helper": [
        {},
        {}
      ]
    }
  }
}
