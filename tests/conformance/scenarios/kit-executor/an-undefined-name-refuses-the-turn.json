{
  "$schema": "../../scenario.schema.json",
  "id": "kit-executor/an-undefined-name-refuses-the-turn",
  "title": "An enabled name without a definition prevents execution; defining it admits the next turn",
  "rules": [
    "§9.1",
    "§10.6.6",
    "§17.2"
  ],
  "notes": "Python: tests/test_turns_backend.py::test_an_event_no_executor_takes_names_the_room_hooks_it_needs. A refused turn does not consume model rounds.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "call-1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ]
            },
            {
              "text": "answer-1"
            },
            {
              "calls": [
                {
                  "id": "call-2",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ]
            },
            {
              "text": "answer-2"
            }
          ]
        },
        "tools": [
          {
            "name": "lookup_order",
            "description": "Find an order by its number",
            "parameters": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "string"
                }
              }
            },
            "returns": "{\"order\": \"1\", \"status\": \"ready\"}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "enable_room_hook",
      "room_id": "room-1",
      "name": "audit"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "error": {
            "$contains": "audit"
          }
        }
      }
    },
    {
      "call": "kit_executor.room_hook",
      "hook": {
        "name": "audit",
        "trigger": "before_tool_use"
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "kit_executor.remove_room_hook",
      "name": "audit",
      "expect": {
        "result": true
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "error": {
            "$contains": "audit"
          }
        }
      }
    },
    {
      "call": "disable_room_hook",
      "room_id": "room-1",
      "name": "audit",
      "expect": {
        "result": true
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "audit": [
        {
          "trigger": "before_tool_use",
          "room_id": "room-1",
          "tool_call": {
            "tool_call_id": "call-1"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {},
        {},
        {},
        {}
      ]
    }
  }
}
