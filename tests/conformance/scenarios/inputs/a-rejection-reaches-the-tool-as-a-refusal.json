{
  "$schema": "../../scenario.schema.json",
  "id": "inputs/a-rejection-reaches-the-tool-as-a-refusal",
  "title": "The kit's reject_input rejects a turn's request: the model reads the refusal and why, the door says true, and the request takes no answer after",
  "rules": [
    "§10.6.5",
    "§9.3"
  ],
  "notes": "Python: tests/test_turns_inputs.py::test_a_rejection_reaches_the_tool_as_a_refusal. A request a human rejected is a refusal (§9.3), the model reading why.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "ask_user",
                  "arguments": {
                    "question": "Color?"
                  }
                }
              ]
            },
            {
              "text": "Thanks."
            }
          ]
        },
        "human_input": {
          "tool_names": [
            "ask_user"
          ],
          "timeout_ms": 5000,
          "tools": [
            {
              "name": "ask_user",
              "description": "Ask the user.",
              "parameters": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "asked",
        "trigger": "on_user_input_required",
        "reactions": [
          {
            "do": [
              {
                "call": "reject_input",
                "request_id": "$request",
                "reason": "Not now",
                "expect": {
                  "result": true
                }
              }
            ]
          }
        ]
      },
      {
        "name": "calls",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "ops",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "answer_input",
      "request_id": "$p1",
      "value": "Red",
      "expect": {
        "result": false
      }
    },
    {
      "call": "reject_input",
      "request_id": "$p1",
      "reason": "late",
      "expect": {
        "result": false
      }
    }
  ],
  "expect": {
    "hooks": {
      "asked": [
        {
          "trigger": "on_user_input_required",
          "room_id": "room-1",
          "request": {
            "pending_id": "$p1",
            "tool_name": "ask_user",
            "arguments": {
              "question": "Color?"
            },
            "room_id": "room-1",
            "tool_call_id": "c1",
            "channel_id": "agent",
            "channel_type": "ai"
          }
        }
      ],
      "calls": [
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "name": "ask_user",
            "tool_call_id": "c1",
            "arguments": {
              "question": "Color?"
            },
            "result": "{\"error\": \"Human input rejected: Not now\"}",
            "is_error": true,
            "refused": true
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"error\": \"Human input rejected: Not now\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
