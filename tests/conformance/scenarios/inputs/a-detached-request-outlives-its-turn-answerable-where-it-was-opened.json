{
  "$schema": "../../scenario.schema.json",
  "id": "inputs/a-detached-request-outlives-its-turn-answerable-where-it-was-opened",
  "title": "A detached human-input request a turn opened outlives the turn: the owner's record goes with the turn, while the request stays open on the handler that opened it and is answered there",
  "rules": [
    "§10.6.5",
    "§9.3"
  ],
  "requirements": [
    "RK-10.6.5-064"
  ],
  "notes": "The turn opens a request no one waits on (create_detached) and is held after it, while the owner shows the request. Once the turn ended, the kit no longer shows nor takes it, and its handler, its creator's, still takes the answer and gives it to a reader. Python: tests/test_turns_inputs.py test_a_detached_request_a_turn_raised_outlives_the_turn.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "do": [
              {
                "call": "human_input.create_detached",
                "channel_id": "agent",
                "room_id": "room-1",
                "tool_name": "approve",
                "arguments": {
                  "change": "deploy"
                },
                "expect": {
                  "result": "$p1"
                }
              }
            ],
            "after_do_gate": "turn-ends"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "ops",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "turn-ends"
    },
    {
      "call": "await_input_request",
      "request_id": "$p1",
      "expect": {
        "result": true
      }
    },
    {
      "open": "turn-ends"
    },
    {
      "await": "turn",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "input_request",
      "request_id": "$p1",
      "expect": {
        "result": null
      }
    },
    {
      "call": "answer_input",
      "request_id": "$p1",
      "value": "From the kit",
      "expect": {
        "result": false
      }
    },
    {
      "call": "human_input.resolve",
      "channel_id": "agent",
      "request_id": "$p1",
      "value": "Ship it",
      "expect": {
        "result": true
      }
    },
    {
      "call": "human_input.wait",
      "channel_id": "agent",
      "request_id": "$p1",
      "timeout_ms": 1000,
      "expect": {
        "result": "Ship it"
      }
    }
  ]
}
