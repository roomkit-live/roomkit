{
  "$schema": "../../scenario.schema.json",
  "id": "inputs/a-request-still-open-when-its-turn-ends-is-withdrawn",
  "title": "A human-input request a turn opened and still open when the turn ends is withdrawn on both sides: its waiter reads it released, and neither the kit nor its handler takes an answer",
  "rules": [
    "§10.6.5",
    "§9.3"
  ],
  "requirements": [
    "RK-10.6.5-064"
  ],
  "notes": "The turn opens the request and is held after it, while the owner shows the request, which belongs to the turn; a task the turn started then waits on it. Once the turn ends, the request is withdrawn: the waiter reads it given up, the owner's record is gone, and the handler no longer takes an answer. Whether the waiter waits before the turn ends or after, it reads the same outcome: a settled request's outcome stays readable (§9.3). The detached case is inputs/a-detached-request-outlives-its-turn-answerable-where-it-was-opened. Python: tests/test_turns_inputs.py test_a_request_still_open_when_its_turn_ends_is_withdrawn.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "spawn": {
              "gate": "created",
              "do": [
                {
                  "call": "human_input.wait",
                  "channel_id": "agent",
                  "request_id": "$p1",
                  "timeout_ms": 5000,
                  "expect": {
                    "error": "input_released"
                  }
                }
              ]
            },
            "do": [
              {
                "call": "human_input.create",
                "channel_id": "agent",
                "room_id": "room-1",
                "tool_name": "approve",
                "arguments": {
                  "change": "deploy"
                },
                "expect": {
                  "result": "$p1"
                }
              }
            ],
            "after_do_gate": "turn-ends"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "ops",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "turn-ends"
    },
    {
      "call": "await_input_request",
      "request_id": "$p1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "input_request",
      "request_id": "$p1",
      "expect": {
        "result": {
          "pending_id": "$p1",
          "tool_name": "approve",
          "arguments": {
            "change": "deploy"
          },
          "room_id": "room-1",
          "channel_id": "agent"
        }
      }
    },
    {
      "open": "created"
    },
    {
      "open": "turn-ends"
    },
    {
      "await": "turn",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "input_request",
      "request_id": "$p1",
      "expect": {
        "result": null
      }
    },
    {
      "call": "answer_input",
      "request_id": "$p1",
      "value": "Too late",
      "expect": {
        "result": false
      }
    },
    {
      "call": "human_input.resolve",
      "channel_id": "agent",
      "request_id": "$p1",
      "value": "Too late",
      "expect": {
        "result": false
      }
    }
  ]
}
