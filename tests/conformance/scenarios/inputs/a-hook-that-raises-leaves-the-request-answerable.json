{
  "$schema": "../../scenario.schema.json",
  "id": "inputs/a-hook-that-raises-leaves-the-request-answerable",
  "title": "An ON_USER_INPUT_REQUIRED hook that raises leaves the request open: the next hook answers it, the tool reads the answer, and user_input_required says the request was allowed",
  "rules": [
    "§10.6.5",
    "§9.3"
  ],
  "notes": "Python: tests/test_human_input.py::test_callback_error_leaves_the_request_answerable; core/hooks.py run_sync_hooks (a hook that raises is logged, the next ones run). The raising hook comes first: the answer is given after it raised.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "ask_user",
                  "arguments": {
                    "question": "Color?"
                  }
                }
              ]
            },
            {
              "text": "Thanks."
            }
          ]
        },
        "human_input": {
          "tool_names": [
            "ask_user"
          ],
          "timeout_ms": 5000,
          "tools": [
            {
              "name": "ask_user",
              "description": "Ask the user.",
              "parameters": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "boom",
        "trigger": "on_user_input_required",
        "reactions": [
          {
            "fail": "The notifier broke."
          }
        ]
      },
      {
        "name": "asked",
        "trigger": "on_user_input_required",
        "reactions": [
          {
            "do": [
              {
                "call": "answer_input",
                "request_id": "$request",
                "value": "Blue",
                "expect": {
                  "result": true
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "ops",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "boom": [
        {
          "trigger": "on_user_input_required",
          "room_id": "room-1",
          "request": {
            "pending_id": "$p1",
            "tool_name": "ask_user",
            "arguments": {
              "question": "Color?"
            },
            "room_id": "room-1",
            "tool_call_id": "c1",
            "channel_id": "agent",
            "channel_type": "ai"
          }
        }
      ],
      "asked": [
        {
          "trigger": "on_user_input_required",
          "room_id": "room-1",
          "request": {
            "pending_id": "$p1",
            "tool_name": "ask_user",
            "arguments": {
              "question": "Color?"
            },
            "room_id": "room-1",
            "tool_call_id": "c1",
            "channel_id": "agent",
            "channel_type": "ai"
          }
        }
      ]
    },
    "hook_order": [
      "boom",
      "asked"
    ],
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "Blue",
              "is_error": false
            }
          ]
        }
      ]
    },
    "framework_events": {
      "room-1": [
        {
          "$unordered": [
            {
              "event": "event_processed",
              "event_id": "room-1#0"
            },
            {
              "event": "user_input_required",
              "room_id": "room-1",
              "channel_id": "agent",
              "pending_id": "$p1",
              "tool_name": "ask_user",
              "tool_call_id": "c1",
              "allowed": true,
              "reason": null
            }
          ]
        }
      ]
    }
  }
}
