{
  "$schema": "../../scenario.schema.json",
  "id": "inputs/a-request-names-the-author-of-the-turn",
  "title": "A turn's human-input request names the participant whose message woke the turn, and no one for a sender the room reached through other channels only",
  "rules": [
    "§10.6.5",
    "§9.3",
    "§5.5"
  ],
  "notes": "Python: tools/human_input.py HumanInputToolHandler (actor_id=current_tool_actor_id()); channels/ai.py _make_tool_loop_context (actor_id: None when People.names_another(event)); tools/context.py current_tool_actor_id. The id names the turn without authenticating it (RFC §5.5).",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "mail",
        "type": "email",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "ask_user",
                  "arguments": {
                    "question": "Color?"
                  }
                }
              ]
            },
            {
              "text": "Thanks."
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "ask_user",
                  "arguments": {
                    "question": "Size?"
                  }
                }
              ]
            },
            {
              "text": "Thanks again."
            }
          ]
        },
        "human_input": {
          "tool_names": [
            "ask_user"
          ],
          "timeout_ms": 5000,
          "tools": [
            {
              "name": "ask_user",
              "description": "Ask the user.",
              "parameters": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "mail"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "participants": [
          {
            "id": "alice",
            "channel_id": "mail",
            "connected_via": [
              "mail"
            ]
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "asked",
        "trigger": "on_user_input_required",
        "reactions": [
          {
            "repeat": true,
            "do": [
              {
                "call": "answer_input",
                "request_id": "$request",
                "value": "Blue",
                "expect": {
                  "result": true
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "ops-1",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hi again"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "asked": [
        {
          "trigger": "on_user_input_required",
          "room_id": "room-1",
          "request": {
            "pending_id": "$p1",
            "tool_name": "ask_user",
            "arguments": {
              "question": "Color?"
            },
            "room_id": "room-1",
            "tool_call_id": "c1",
            "channel_id": "agent",
            "actor_id": "ops-1"
          }
        },
        {
          "trigger": "on_user_input_required",
          "room_id": "room-1",
          "request": {
            "pending_id": "$p2",
            "tool_name": "ask_user",
            "arguments": {
              "question": "Size?"
            },
            "room_id": "room-1",
            "tool_call_id": "c2",
            "channel_id": "agent",
            "actor_id": null
          }
        }
      ]
    }
  }
}
