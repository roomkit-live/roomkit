{
  "$schema": "../../scenario.schema.json",
  "id": "inputs/a-request-is-answerable-while-its-notification-runs",
  "title": "A request is answerable from its creation: while its ON_USER_INPUT_REQUIRED hook is still held, the kit's answer is taken and the tool reads it",
  "rules": [
    "§10.6.5",
    "§9.3"
  ],
  "notes": "Python: tests/test_human_input.py::test_notification_does_not_gate_the_answer; RFC §9.3: the notification MUST NOT gate whether an answer can be recorded. The hook is held at a gate once it recorded its call; the answer comes from a step meanwhile. The model reaches its next generation with the answer before the notification is released.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "ask_user",
                  "arguments": {
                    "question": "Color?"
                  }
                }
              ]
            },
            {
              "text": "Thanks.",
              "gate": "answered"
            }
          ]
        },
        "human_input": {
          "tool_names": [
            "ask_user"
          ],
          "timeout_ms": 5000,
          "tools": [
            {
              "name": "ask_user",
              "description": "Ask the user.",
              "parameters": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "asked",
        "trigger": "on_user_input_required",
        "reactions": [
          {
            "gate": "notified"
          }
        ]
      },
      {
        "name": "calls",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "ops",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "notified"
    },
    {
      "call": "answer_input",
      "request_id": "$p1",
      "value": "Blue",
      "expect": {
        "result": true
      }
    },
    {
      "wait_for": "answered"
    },
    {
      "open": "notified"
    },
    {
      "open": "answered"
    },
    {
      "await": "turn"
    }
  ],
  "expect": {
    "hooks": {
      "asked": [
        {
          "trigger": "on_user_input_required",
          "room_id": "room-1",
          "request": {
            "pending_id": "$p1",
            "tool_name": "ask_user",
            "arguments": {
              "question": "Color?"
            },
            "room_id": "room-1",
            "tool_call_id": "c1",
            "channel_id": "agent",
            "channel_type": "ai"
          }
        }
      ],
      "calls": [
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "name": "ask_user",
            "tool_call_id": "c1",
            "arguments": {
              "question": "Color?"
            },
            "result": "Blue",
            "is_error": false,
            "refused": false
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "Blue",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
