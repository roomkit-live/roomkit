{
  "$schema": "../../scenario.schema.json",
  "id": "inputs/a-request-opened-after-its-turn-ended-is-the-handler-s-alone",
  "title": "A human-input request that work a turn began opens once the turn ended is its handler's alone: the kit never shows nor takes it, and the handler is answered",
  "rules": [
    "§10.6.5",
    "§9.3"
  ],
  "requirements": [
    "RK-10.6.5-065"
  ],
  "notes": "The turn leaves the request to work it began, which opens it once the turn is over. No turn holds it, so it is not withdrawn: the handler takes the answer and gives it to its reader, while the kit never shows it. The kit's answer_input is not asked: the owner holds an answer for an id it does not know for input_hold_timeout (RK-10.6.5-061), past the runner's bound for a call. Python: tests/test_turns_inputs.py test_a_request_asked_after_its_turn_ended_is_the_handlers_alone.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "after_turn": [
              {
                "call": "human_input.create",
                "channel_id": "agent",
                "room_id": "room-1",
                "tool_name": "approve",
                "arguments": {
                  "change": "deploy"
                },
                "expect": {
                  "result": "$p1"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "ops",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "input_request",
      "request_id": "$p1",
      "expect": {
        "result": null
      }
    },
    {
      "call": "human_input.resolve",
      "channel_id": "agent",
      "request_id": "$p1",
      "value": "Yes",
      "expect": {
        "result": true
      }
    },
    {
      "call": "human_input.wait",
      "channel_id": "agent",
      "request_id": "$p1",
      "timeout_ms": 1000,
      "expect": {
        "result": "Yes"
      }
    }
  ]
}
