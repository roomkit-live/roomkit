{
  "$schema": "../../scenario.schema.json",
  "id": "inputs/a-request-whose-call-is-cut-is-withdrawn",
  "title": "A human-input request whose waiting call is cut by its turn's cancellation is withdrawn: the kit no longer shows it, and a late answer or rejection is not taken",
  "rules": [
    "§9.3",
    "§10.1",
    "§10.6.5"
  ],
  "requirements": [
    "RK-9.3-113"
  ],
  "notes": "The observer of ON_USER_INPUT_REQUIRED holds at 'asked' with the request open; cancelling the delivery cuts the turn and the waiting call. Its timeout, 60 s, is past the runner's 10 s budget for a call: a request only its timeout ended would fail the run. Python: tests/test_refused_or_failed_reading.py::test_a_request_whose_call_is_cut_is_withdrawn; inputs/the-kit-answers-a-turn-s-request answers the same request in time.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "ask_user",
                  "arguments": {
                    "question": "Color?"
                  }
                }
              ]
            },
            {
              "text": "Thanks."
            }
          ]
        },
        "human_input": {
          "tool_names": [
            "ask_user"
          ],
          "timeout_ms": 60000,
          "tools": [
            {
              "name": "ask_user",
              "description": "Ask the user.",
              "parameters": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "asked",
        "trigger": "on_user_input_required",
        "execution": "async",
        "reactions": [
          {
            "gate": "asked"
          }
        ]
      },
      {
        "name": "calls",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "ops",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      },
      "defer_delivery": true,
      "as": "turn"
    },
    {
      "wait_for": "asked"
    },
    {
      "call": "await_input_request",
      "request_id": "$p1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "input_request",
      "request_id": "$p1",
      "expect": {
        "result": {
          "pending_id": "$p1",
          "tool_call_id": "c1"
        }
      }
    },
    {
      "call": "delivery.cancel",
      "of": "turn",
      "reason": "stop"
    },
    {
      "open": "asked"
    },
    {
      "idle": true
    },
    {
      "call": "input_request",
      "request_id": "$p1",
      "expect": {
        "result": null
      }
    },
    {
      "call": "answer_input",
      "request_id": "$p1",
      "value": "Red",
      "expect": {
        "result": false
      }
    },
    {
      "call": "reject_input",
      "request_id": "$p1",
      "reason": "late",
      "expect": {
        "result": false
      }
    }
  ],
  "expect": {
    "hooks": {
      "asked": [
        {
          "trigger": "on_user_input_required",
          "room_id": "room-1",
          "request": {
            "pending_id": "$p1",
            "tool_name": "ask_user",
            "tool_call_id": "c1"
          }
        }
      ],
      "calls": [
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "name": "ask_user",
            "tool_call_id": "c1",
            "cancelled": true
          }
        }
      ]
    },
    "models": {
      "agent": [
        {}
      ]
    }
  }
}
