{
  "$schema": "../../scenario.schema.json",
  "id": "planning/counts-and-cleaned-extras-non-streaming",
  "title": "Counts and cleaned extras non streaming",
  "rules": [
    "§6.4",
    "§9.2",
    "§9.3",
    "§10.6.3"
  ],
  "requirements": [
    "RK-9.2-098"
  ],
  "notes": "Python: tests/test_task_planner.py; tests/test_turn_notes.py; tests/test_tool_policy_exemptions.py. Real plan_tasks calls, model requests, tool reports, plan hooks and CUSTOM events are observed independently.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "enable_planning": true,
        "system_prompt": "Be brief.",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "p1",
                  "name": "plan_tasks",
                  "arguments": {
                    "tasks": [
                      {
                        "title": "First",
                        "status": "pending",
                        "ignored": {
                          "secret": "not retained"
                        }
                      },
                      {
                        "title": "Next",
                        "status": "in_progress",
                        "ignored": {
                          "secret": "not retained"
                        }
                      },
                      {
                        "title": "Done",
                        "status": "completed",
                        "ignored": {
                          "secret": "not retained"
                        }
                      },
                      {
                        "title": "Wait",
                        "status": "blocked",
                        "ignored": {
                          "secret": "not retained"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "plans",
        "trigger": "on_plan_updated",
        "execution": "async"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Plan it."
        }
      },
      "expect": {
        "result": {
          "error": null,
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "plans": [
        {
          "plan": {
            "room_id": "r",
            "channel_id": "agent",
            "tasks": [
              {
                "title": "First",
                "status": "pending",
                "ignored": {
                  "$absent": true
                }
              },
              {
                "title": "Next",
                "status": "in_progress",
                "ignored": {
                  "$absent": true
                }
              },
              {
                "title": "Done",
                "status": "completed",
                "ignored": {
                  "$absent": true
                }
              },
              {
                "title": "Wait",
                "status": "blocked",
                "ignored": {
                  "$absent": true
                }
              }
            ],
            "timestamp": "$any"
          }
        }
      ],
      "audit": [
        {
          "tool_call": {
            "name": "plan_tasks",
            "tool_call_id": "p1",
            "result": "{\"status\": \"ok\", \"task_count\": 4, \"pending\": 1, \"in_progress\": 1, \"completed\": 1, \"blocked\": 1}",
            "is_error": false,
            "refused": false,
            "cancelled": false
          }
        }
      ]
    },
    "custom_events": {
      "r": [
        {
          "room_id": "r",
          "channel_id": "agent",
          "data": {
            "type": "plan_updated",
            "tasks": [
              {
                "title": "First",
                "status": "pending",
                "ignored": {
                  "$absent": true
                }
              },
              {
                "title": "Next",
                "status": "in_progress",
                "ignored": {
                  "$absent": true
                }
              },
              {
                "title": "Done",
                "status": "completed",
                "ignored": {
                  "$absent": true
                }
              },
              {
                "title": "Wait",
                "status": "blocked",
                "ignored": {
                  "$absent": true
                }
              }
            ]
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "tools": {
            "plan_tasks": {
              "$present": true
            }
          },
          "tool_definitions": {
            "plan_tasks": {
              "description": "Create or update a structured task plan. Use this to break down complex work into steps and track progress.",
              "parameters": {
                "type": "object",
                "required": [
                  "tasks"
                ],
                "additionalProperties": false,
                "properties": {
                  "tasks": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": [
                        "title",
                        "status"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "title": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "pending",
                            "in_progress",
                            "completed",
                            "blocked"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "tool_results": [
            {
              "name": "plan_tasks",
              "content": "{\"status\": \"ok\", \"task_count\": 4, \"pending\": 1, \"in_progress\": 1, \"completed\": 1, \"blocked\": 1}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
