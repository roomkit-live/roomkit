{
  "$schema": "../../scenario.schema.json",
  "id": "regenerate/the-target-is-the-newest-message-a-transport-wrote",
  "title": "The target is the newest message a transport wrote, never a system event the host wrote on that transport after it, and a regeneration answers that message",
  "rules": [
    "§13.6"
  ],
  "notes": "Python: tests/test_integration/test_regenerate.py TestRegenerateTarget::test_target_is_the_event_regenerate_response_replays (thirty turns there, two here: the selection, not the window, is under test).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "ok"
            },
            {
              "text": "ok"
            },
            {
              "text": "ok again"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "What is the weather? (0)"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "What is the weather? (1)"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "sms",
      "content": {
        "type": "text",
        "body": "reconnected 0"
      },
      "event_type": "system"
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "sms",
      "content": {
        "type": "text",
        "body": "reconnected 1"
      },
      "event_type": "system"
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "sms",
      "content": {
        "type": "text",
        "body": "reconnected 2"
      },
      "event_type": "system"
    },
    {
      "idle": true
    },
    {
      "call": "regenerate_target",
      "room_id": "room-1",
      "expect": {
        "result": {
          "id": "room-1#2",
          "content": {
            "body": "What is the weather? (1)"
          }
        }
      }
    },
    {
      "call": "regenerate_response",
      "room_id": "room-1",
      "expect": {
        "result": {
          "event": {
            "id": "room-1#2"
          },
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "What is the weather? (0)"
            },
            {
              "role": "assistant",
              "text": "ok"
            },
            {
              "role": "assistant",
              "text": "ok"
            },
            {
              "role": "user",
              "text": "What is the weather? (1)"
            }
          ]
        }
      ]
    }
  }
}
