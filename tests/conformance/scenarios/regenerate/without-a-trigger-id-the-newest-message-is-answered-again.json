{
  "$schema": "../../scenario.schema.json",
  "id": "regenerate/without-a-trigger-id-the-newest-message-is-answered-again",
  "title": "A regeneration naming no trigger answers the newest message again, whichever it is",
  "rules": [
    "§13.6"
  ],
  "notes": "Python: tests/test_integration/test_regenerate.py TestRegenerateTriggerId::test_without_a_trigger_id_the_selection_is_whatever_it_is.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "First answer"
            },
            {
              "text": "Saturday answer"
            },
            {
              "text": "Saturday again"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "What is the weather?"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "And on Saturdays?"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "regenerate_response",
      "room_id": "room-1",
      "expect": {
        "result": {
          "event": {
            "id": "room-1#2",
            "content": {
              "body": "And on Saturdays?"
            }
          },
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {},
        {},
        {},
        {},
        {
          "content": {
            "body": "Saturday again"
          }
        }
      ]
    }
  }
}
