{
  "$schema": "../../scenario.schema.json",
  "id": "regenerate/a-blocked-message-is-never-the-trigger",
  "title": "A message a hook blocked is stored, never answered, and never a regeneration's trigger: the accepted message before it is",
  "rules": [
    "§13.6",
    "§10.1 step 10"
  ],
  "notes": "Python: tests/test_integration/test_regenerate.py TestRegenerateTarget::test_a_blocked_message_is_never_the_trigger.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "First answer"
            },
            {
              "text": "Second answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "spam",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "SPAM"
            },
            "result": {
              "action": "block",
              "reason": "spam"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "What is the weather?"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "SPAM"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "regenerate_target",
      "room_id": "room-1",
      "expect": {
        "result": {
          "id": "room-1#0"
        }
      }
    },
    {
      "call": "regenerate_response",
      "room_id": "room-1",
      "expect": {
        "result": {
          "event": {
            "id": "room-1#0"
          },
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "What is the weather?"
          }
        },
        {
          "content": {
            "body": "First answer"
          }
        },
        {
          "content": {
            "body": "SPAM"
          },
          "status": "blocked"
        },
        {
          "content": {
            "body": "Second answer"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {},
        {
          "messages": [
            {
              "role": "assistant",
              "text": "First answer"
            },
            {
              "role": "user",
              "text": "What is the weather?"
            }
          ]
        }
      ]
    }
  }
}
