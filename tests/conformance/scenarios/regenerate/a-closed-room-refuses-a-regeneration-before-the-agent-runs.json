{
  "$schema": "../../scenario.schema.json",
  "id": "regenerate/a-closed-room-refuses-a-regeneration-before-the-agent-runs",
  "title": "A closed room refuses a regeneration room_closed before the agent runs, a named trigger before it is compared, and its target raises room_closed",
  "rules": [
    "§13.6",
    "§5.1",
    "§8.2"
  ],
  "notes": "Python: tests/test_integration/test_regenerate.py TestRegenerateStatusGuard::test_a_closed_room_is_refused_before_the_agent_runs, TestRegenerateTriggerId::test_a_closed_room_is_refused_before_the_trigger_is_compared and TestRegenerateTarget::test_target_raises_on_a_room_that_refuses_writes. The room_refused_event names the message the regeneration would have answered.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "First answer"
            },
            {
              "text": "Second answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "What is the weather?"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "close_room",
      "room_id": "room-1"
    },
    {
      "call": "regenerate_response",
      "room_id": "room-1",
      "expect": {
        "result": {
          "blocked": true,
          "reason": "room_closed",
          "event": null,
          "response_events": []
        }
      }
    },
    {
      "call": "regenerate_response",
      "room_id": "room-1",
      "trigger_id": "not-the-trigger",
      "expect": {
        "result": {
          "blocked": true,
          "reason": "room_closed"
        }
      }
    },
    {
      "call": "regenerate_target",
      "room_id": "room-1",
      "expect": {
        "error": "room_closed"
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "What is the weather?"
          }
        },
        {
          "content": {
            "body": "First answer"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "What is the weather?"
            }
          ]
        }
      ]
    },
    "framework_events": {
      "room-1": [
        "event_processed",
        "room_closed",
        {
          "event": "room_refused_event",
          "event_id": "room-1#0",
          "status": "closed",
          "operation": "regenerate",
          "event_type": "message"
        },
        {
          "event": "room_refused_event",
          "event_id": "room-1#0",
          "status": "closed",
          "operation": "regenerate",
          "event_type": "message"
        }
      ]
    }
  }
}
