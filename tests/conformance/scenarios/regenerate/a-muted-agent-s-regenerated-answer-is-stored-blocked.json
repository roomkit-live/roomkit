{
  "$schema": "../../scenario.schema.json",
  "id": "regenerate/a-muted-agent-s-regenerated-answer-is-stored-blocked",
  "title": "An agent that answers at once, muted since its first answer, has its regenerated answer stored BLOCKED source_muted and announced",
  "rules": [
    "§13.6",
    "§7.5 rule 2",
    "§8.2"
  ],
  "notes": "Python: tests/test_integration/test_regenerate.py TestRegenerateBlocked::test_a_muted_agents_regenerated_answer_is_stored_blocked (a BufferedAgent, here a scripted channel that responds).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "First answer"
                }
              }
            ]
          },
          {
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Second answer"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Weather?"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "mute",
      "room_id": "room-1",
      "channel_id": "agent"
    },
    {
      "call": "regenerate_response",
      "room_id": "room-1",
      "expect": {
        "result": {
          "event": {
            "id": "room-1#0"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "Weather?"
          }
        },
        {
          "content": {
            "body": "First answer"
          }
        },
        {
          "content": {
            "body": "Second answer"
          },
          "status": "blocked",
          "blocked_by": "source_muted"
        }
      ]
    },
    "framework_events": {
      "room-1": [
        "event_processed",
        {
          "event": "event_blocked",
          "event_id": "room-1#2"
        }
      ]
    }
  }
}
