{
  "$schema": "../../scenario.schema.json",
  "id": "permissions/reserved-channel-ids-are-refused",
  "title": "Visibility keywords, commas, empty ids and surrounding whitespace are refused as channel ids",
  "rules": [
    "§7.3",
    "§7.3 Grammar"
  ],
  "steps": [
    {
      "call": "register_channel",
      "channel": {
        "id": "all",
        "type": "websocket",
        "category": "transport"
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "none",
        "type": "websocket",
        "category": "transport"
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "internal",
        "type": "websocket",
        "category": "transport"
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "transport",
        "type": "websocket",
        "category": "transport"
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "intelligence",
        "type": "websocket",
        "category": "transport"
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "sms,ws",
        "type": "websocket",
        "category": "transport"
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": " ws",
        "type": "websocket",
        "category": "transport"
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "ws ",
        "type": "websocket",
        "category": "transport"
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "\tws",
        "type": "websocket",
        "category": "transport"
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "ws\n",
        "type": "websocket",
        "category": "transport"
      },
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "",
        "type": "websocket",
        "category": "transport"
      },
      "expect": {
        "error": "invalid_argument"
      }
    }
  ],
  "expect": {
    "framework_events": {
      "*": []
    }
  }
}
