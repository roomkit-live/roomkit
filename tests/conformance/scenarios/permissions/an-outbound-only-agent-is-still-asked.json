{
  "$schema": "../../scenario.schema.json",
  "id": "permissions/an-outbound-only-agent-is-still-asked",
  "title": "An agent bound OUTBOUND is still asked: direction filters the transports delivered to, never an agent",
  "rules": [
    "§4.2",
    "§10.2 step 3d"
  ],
  "notes": "Python: tests/test_visibility_rules.py::TestDirection::test_direction_does_not_filter_an_agent. A binding's direction says whether a transport is delivered to (§10.2 step 3d); an intelligence channel is asked whatever its binding's direction.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "direction": "outbound",
        "on_event": [
          {
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Answer"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ai",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "type": "text",
              "body": "hello"
            }
          }
        ]
      }
    }
  }
}
