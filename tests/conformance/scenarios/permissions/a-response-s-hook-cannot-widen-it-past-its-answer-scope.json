{
  "$schema": "../../scenario.schema.json",
  "id": "permissions/a-response-s-hook-cannot-widen-it-past-its-answer-scope",
  "title": "A hook writing `all` on an agent's answer cannot widen it past the answer scope its trigger names, buffered or streamed",
  "rules": [
    "§7.3 An event's visibility",
    "§9.4",
    "§5.12"
  ],
  "notes": "Python: tests/test_visibility_rules.py::TestAHookOnAnAnswerScope::test_a_response_s_hook_cannot_widen_it_past_the_scope, buffered (room-1) and streamed (room-2). The message scopes its answers to `ws`; the hook's `all` would reach sms too.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "live",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "bot",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "AI reply"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "deltas": [
                "ans",
                "wer"
              ]
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "bot",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "live"
          },
          {
            "channel_id": "ai",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "widen",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "source_channel_id": "bot"
            },
            "result": {
              "action": "modify",
              "event": {
                "visibility": "all"
              }
            }
          },
          {
            "when": {
              "source_channel_id": "ai"
            },
            "result": {
              "action": "modify",
              "event": {
                "visibility": "all"
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "hello"
        },
        "response_visibility": "ws"
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "hello"
        },
        "response_visibility": "live"
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "hello"
          }
        },
        {
          "source": {
            "channel_id": "bot"
          },
          "content": {
            "body": "AI reply"
          },
          "visibility": "ws"
        }
      ],
      "room-2": [
        {
          "content": {
            "body": "hello"
          }
        },
        {
          "source": {
            "channel_id": "ai"
          },
          "content": {
            "body": "answer"
          },
          "visibility": "live"
        }
      ]
    },
    "streamed": {
      "room-2": {
        "live": [
          {
            "text": "ans"
          },
          {
            "text": "wer"
          },
          {
            "row": {
              "id": "room-2#1",
              "content": {
                "body": "answer"
              }
            }
          }
        ]
      }
    },
    "deliveries": {
      "room-1": {
        "sms": [],
        "ws": [
          {
            "index": 0
          },
          {
            "index": 1,
            "content": {
              "body": "AI reply"
            }
          }
        ]
      },
      "room-2": {
        "sms": [],
        "live": [
          {
            "index": 0
          }
        ]
      }
    }
  }
}
