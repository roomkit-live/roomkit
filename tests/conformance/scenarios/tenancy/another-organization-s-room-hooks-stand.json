{
  "$schema": "../../scenario.schema.json",
  "id": "tenancy/another-organization-s-room-hooks-stand",
  "title": "Acting for one organization, a room hook is neither added to nor removed from another's room; the room's own organization, or none, does both",
  "rules": [
    "§17.2",
    "§9.1"
  ],
  "notes": "A call naming an organization reads the room with it first: another organization's room is not found, and nothing is registered or removed. A call naming none reads no room.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-g",
        "organization_id": "globex",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "add_room_hook",
      "room_id": "room-g",
      "hook": {
        "name": "globex-audit",
        "trigger": "after_broadcast",
        "execution": "async"
      }
    },
    {
      "call": "add_room_hook",
      "room_id": "room-g",
      "hook": {
        "name": "acme-audit",
        "trigger": "after_broadcast",
        "execution": "async"
      },
      "organization_id": "acme",
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "call": "remove_room_hook",
      "room_id": "room-g",
      "name": "globex-audit",
      "organization_id": "acme",
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-g",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "First"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "add_room_hook",
      "room_id": "room-g",
      "hook": {
        "name": "own-audit",
        "trigger": "after_broadcast",
        "execution": "async"
      },
      "organization_id": "globex"
    },
    {
      "call": "remove_room_hook",
      "room_id": "room-g",
      "name": "globex-audit",
      "organization_id": "globex",
      "expect": {
        "result": true
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-g",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Second"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "globex-audit": [
        {
          "trigger": "after_broadcast",
          "room_id": "room-g",
          "event": {
            "content": {
              "type": "text",
              "body": "First"
            }
          }
        }
      ],
      "acme-audit": [],
      "own-audit": [
        {
          "trigger": "after_broadcast",
          "room_id": "room-g",
          "event": {
            "content": {
              "type": "text",
              "body": "Second"
            }
          }
        }
      ]
    }
  }
}
