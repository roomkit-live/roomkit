{
  "$schema": "../../scenario.schema.json",
  "id": "tenancy/a-deleted-room-s-hook-does-not-run-in-the-room-another-process-creates-again",
  "title": "A room hook ends with its room in every process: once the room is deleted, the hook does not run in the room another process creates under its id for another organization",
  "rules": [
    "§17.2",
    "§9.1"
  ],
  "requirements": [
    "RK-17.2-008",
    "RK-17.2-010",
    "RK-9.1-012",
    "RK-9.1-013"
  ],
  "notes": "acme adds a hook to its room on the run's kit, which runs it on acme's message; the store deletes the room; another process creates a room under the same id for globex and attaches its channels; a message arrives in it through the run's kit. acme's hook was the deleted room's and reads nothing of globex's.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "create_room",
      "room": {
        "id": "shared-id",
        "organization_id": "acme"
      }
    },
    {
      "call": "attach_channel",
      "room_id": "shared-id",
      "channel_id": "sms",
      "organization_id": "acme"
    },
    {
      "call": "attach_channel",
      "room_id": "shared-id",
      "channel_id": "ws",
      "organization_id": "acme"
    },
    {
      "call": "add_room_hook",
      "room_id": "shared-id",
      "hook": {
        "name": "acme_audit",
        "trigger": "after_broadcast",
        "execution": "async"
      },
      "organization_id": "acme"
    },
    {
      "call": "process_inbound",
      "room_id": "shared-id",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000001",
        "content": {
          "type": "text",
          "body": "acme note"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "store.delete_room",
      "room_id": "shared-id"
    },
    {
      "call": "create_room",
      "kit": "p2",
      "room": {
        "id": "shared-id",
        "organization_id": "globex"
      }
    },
    {
      "call": "attach_channel",
      "kit": "p2",
      "room_id": "shared-id",
      "channel_id": "sms",
      "organization_id": "globex"
    },
    {
      "call": "attach_channel",
      "kit": "p2",
      "room_id": "shared-id",
      "channel_id": "ws",
      "organization_id": "globex"
    },
    {
      "call": "process_inbound",
      "room_id": "shared-id",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "globex secret"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "acme_audit": [
        {
          "trigger": "after_broadcast",
          "room_id": "shared-id",
          "event": {
            "content": {
              "type": "text",
              "body": "acme note"
            }
          }
        }
      ]
    }
  }
}
