{
  "$schema": "../../scenario.schema.json",
  "id": "tenancy/a-deleted-room-s-lifecycle-hook-does-not-run-in-the-room-another-process-creates-again",
  "title": "A room's ASYNC hook on a lifecycle trigger ends with its room in every process: once the room is deleted, it does not run in the room another process creates under its id",
  "rules": [
    "§17.2",
    "§9.1"
  ],
  "requirements": [
    "RK-9.1-012",
    "RK-9.1-013"
  ],
  "notes": "acme adds an ASYNC ON_CHANNEL_ATTACHED hook to its room on the run's kit, which runs it on acme's attach; the store deletes the room; another process creates a room under the same id for globex; globex attaches a channel through the run's kit. The trigger's hooks start apart from the attach (RFC §9.3), and acme's hook, the deleted room's, does not run on globex's attach.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "processes": [
      {
        "id": "p2"
      }
    ]
  },
  "steps": [
    {
      "call": "create_room",
      "room": {
        "id": "shared-id",
        "organization_id": "acme"
      }
    },
    {
      "call": "add_room_hook",
      "room_id": "shared-id",
      "hook": {
        "name": "acme_attach",
        "trigger": "on_channel_attached",
        "execution": "async"
      },
      "organization_id": "acme"
    },
    {
      "call": "attach_channel",
      "room_id": "shared-id",
      "channel_id": "sms",
      "organization_id": "acme"
    },
    {
      "idle": true
    },
    {
      "call": "store.delete_room",
      "room_id": "shared-id"
    },
    {
      "call": "create_room",
      "kit": "p2",
      "room": {
        "id": "shared-id",
        "organization_id": "globex"
      }
    },
    {
      "call": "attach_channel",
      "room_id": "shared-id",
      "channel_id": "ws",
      "organization_id": "globex"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "acme_attach": [
        {
          "trigger": "on_channel_attached",
          "room_id": "shared-id"
        }
      ]
    }
  }
}
