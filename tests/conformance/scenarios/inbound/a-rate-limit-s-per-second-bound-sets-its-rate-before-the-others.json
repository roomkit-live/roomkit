{
  "$schema": "../../scenario.schema.json",
  "id": "inbound/a-rate-limit-s-per-second-bound-sets-its-rate-before-the-others",
  "title": "A rate limit's rate is its per-second bound when it sets one, whatever its per-minute and per-hour bounds allow: a message every twenty seconds admits one, the next refused",
  "rules": [
    "§13.3",
    "§10.1 step 1"
  ],
  "requirements": [
    "RK-13.3-003",
    "RK-13.3-005"
  ],
  "notes": "At 0.05 a second, the bucket holds one message and refills in twenty seconds: the second, sent at once, is refused. Were the per-minute bound the rate, ten a second, the bucket would hold ten. The kit's inbound limit refuses the message, a binding's would queue it.",
  "setup": {
    "kit": {
      "inbound_rate_limit": {
        "max_per_second": 0.05,
        "max_per_minute": 600,
        "max_per_hour": 36000
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "m0"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "over"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "rate_limited",
          "event": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "m0"
          }
        }
      ]
    }
  }
}
