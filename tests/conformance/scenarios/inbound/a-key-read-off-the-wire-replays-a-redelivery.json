{
  "$schema": "../../scenario.schema.json",
  "id": "inbound/a-key-read-off-the-wire-replays-a-redelivery",
  "title": "A key the channel's parse reads off its wire dedupes a redelivery the caller sent with no key",
  "rules": [
    "§10.1 step 4",
    "§10.1 step 7",
    "§13.4"
  ],
  "notes": "The provider redelivers a webhook; the caller passes it on with no key, and the channel reads the provider's message id off the payload as the event's key. The second delivery returns the first's result, reprocessing nothing.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "parse": [
          {
            "repeat": true,
            "parsed": {
              "idempotency_key": "SM-wire-1"
            }
          }
        ]
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "id": "room-1#0"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "expect": {
        "result": {
          "event": {
            "id": "room-1#0"
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "Hello"
          },
          "idempotency_key": "SM-wire-1"
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "id": "room-1#0"
          }
        ]
      }
    }
  }
}
