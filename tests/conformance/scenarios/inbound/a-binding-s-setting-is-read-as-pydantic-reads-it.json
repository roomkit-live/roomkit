              "temperature": 1,
              "max_tokens": 64.0
            }
          }
        ]
      },
      {
        "id": "room-3",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "main",
            "category": "intelligence",
            "metadata": {
              "temperature": true,
              "max_tokens": false
            }
          }
        ]
      },
      {
        "id": "room-4",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "main",
            "category": "intelligence",
            "metadata": {
              "temperature": " 1e-1 ",
              "max_tokens": " 1_000.00 "
            }
          }
        ]
      }
    ]
  },
  "steps": [
