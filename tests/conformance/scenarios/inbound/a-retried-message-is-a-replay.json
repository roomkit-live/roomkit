{
  "$schema": "../../scenario.schema.json",
  "id": "inbound/a-retried-message-is-a-replay",
  "title": "A message whose key its channel already holds in the room returns the first result, reprocessing nothing",
  "rules": [
    "§13.4",
    "§10.1 step 7"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "email",
        "type": "email",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "email"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "check",
        "trigger": "before_broadcast"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hello"
        },
        "idempotency_key": "sms-1"
      },
      "expect": {
        "result": {
          "event": {
            "id": "room-1#0"
          },
          "duplicate": false,
          "blocked": false,
          "reason": null
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hello again"
        },
        "idempotency_key": "sms-1"
      },
      "expect": {
        "result": {
          "event": {
            "id": "room-1#0",
            "content": {
              "type": "text",
              "body": "Hello"
            }
          },
          "duplicate": true,
          "blocked": false,
          "reason": null
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "email",
        "sender_id": "a@example.com",
        "content": {
          "type": "text",
          "body": "Same key, other channel"
        },
        "idempotency_key": "sms-1"
      },
      "expect": {
        "result": {
          "event": {
            "id": "room-1#1"
          },
          "duplicate": false,
          "blocked": false,
          "reason": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "Hello"
          },
          "idempotency_key": "sms-1"
        },
        {
          "content": {
            "type": "text",
            "body": "Same key, other channel"
          },
          "idempotency_key": "sms-1"
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "id": "room-1#0"
          },
          {
            "id": "room-1#1"
          }
        ]
      }
    },
    "hooks": {
      "check": [
        {
          "event": {
            "content": {
              "type": "text",
              "body": "Hello"
            }
          }
        },
        {
          "event": {
            "content": {
              "type": "text",
              "body": "Same key, other channel"
            }
          }
        }
      ]
    },
    "rooms": {
      "room-1": {
        "event_count": 2,
        "latest_index": 1
      }
    }
  }
}
