{
  "$schema": "../../scenario.schema.json",
  "id": "identity/an-instruction-the-host-delivers-is-not-challenged",
  "title": "An instruction the host sends with deliver(instruction=True) is not challenged by the identity hooks: the agent it addresses is asked",
  "rules": [
    "§10.1 step 5",
    "§10.4",
    "§11.6"
  ],
  "requirements": [
    "RK-11.6-001",
    "RK-21.4-020",
    "RK-22.1-045"
  ],
  "notes": "The door for a host's own instruction in a kit that challenges unknown senders: deliver(instruction=True) is the framework's own message, which the identity step leaves alone. An instruction sent through process_inbound() under the sender system is a caller's message and is resolved (identity/a-caller-s-message-under-the-framework-s-name-is-still-resolved). Python: core/mixins/inbound_identity.py _resolve_identity, models/delivery.py framework_message.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "repeat": true,
            "result": {
              "status": "unknown"
            }
          }
        ]
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "actor",
            "description": "The turn's actor.",
            "returns_actor": true
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "actor",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "Seen."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "identity_hooks": [
      {
        "name": "challenge",
        "trigger": "on_identity_unknown",
        "reactions": [
          {
            "repeat": true,
            "result": {
              "status": "challenge_sent",
              "message": "Identify yourself",
              "inject": {
                "event": {
                  "content": {
                    "type": "text",
                    "body": "Who are you?"
                  }
                },
                "target_channel_ids": [
                  "ws"
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "deliver",
      "room_id": "room-1",
      "content": "Send the report.",
      "addressed_to": [
        "agent"
      ],
      "instruction": true,
      "expect": {
        "result": {
          "status": "sent"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "\"system\""
            }
          ]
        }
      ]
    },
    "resolver": [],
    "participants": {
      "room-1": []
    },
    "hooks": {
      "challenge": []
    }
  }
}
