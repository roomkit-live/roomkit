{
  "$schema": "../../scenario.schema.json",
  "id": "identity/the-resolver-runs-for-the-configured-channel-types",
  "title": "With identity channel types configured, a message of another type is not resolved, and its sender joins no roster",
  "rules": [
    "§10.1 step 5",
    "§11.4"
  ],
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": []
      },
      "identity_channel_types": [
        "sms"
      ]
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "identity_hooks": [
      {
        "name": "pends",
        "trigger": "on_identity_unknown",
        "reactions": [
          {
            "repeat": true,
            "result": {
              "status": "pending"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "by sms"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "source": {
              "participant_id": "pending-915e25f899c26f82"
            }
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ws-user",
        "content": {
          "type": "text",
          "body": "by websocket"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "source": {
              "participant_id": "ws-user"
            }
          }
        }
      }
    }
  ],
  "expect": {
    "resolver": [
      {
        "room_id": "room-1",
        "channel_id": "sms",
        "sender_id": "+15551234567"
      }
    ],
    "hooks": {
      "pends": [
        {
          "trigger": "on_identity_unknown"
        }
      ]
    },
    "participants": {
      "room-1": [
        {
          "id": "pending-915e25f899c26f82",
          "identification": "pending"
        }
      ]
    }
  }
}
