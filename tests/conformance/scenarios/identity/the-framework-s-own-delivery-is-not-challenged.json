{
  "$schema": "../../scenario.schema.json",
  "id": "identity/the-framework-s-own-delivery-is-not-challenged",
  "title": "A deliver() is not challenged by an ON_IDENTITY_UNKNOWN hook that challenges unknown senders: it is delivered and the agent it addresses answers",
  "rules": [
    "§10.1 step 5",
    "§10.4",
    "§11.6"
  ],
  "requirements": [
    "RK-11.6-006",
    "RK-11.6-007",
    "RK-11.6-014",
    "RK-21.4-020",
    "RK-22.1-028"
  ],
  "notes": "The kit's resolver knows no one and a hook challenges every unknown sender, which blocks their message (identity/a-challenge-runs-the-before-broadcast-hooks). The host's own deliver() is no sender's message: the resolver is not asked, no hook fires, and the agent is asked. Before RMK-1874 the delivery was blocked with identity_challenge_sent and the agent never ran. The delivery is known by where it comes from, not by its sender id (identity/a-caller-s-message-under-the-framework-s-name-is-still-resolved). Python: core/mixins/inbound_identity.py _resolve_identity, models/delivery.py framework_message.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "repeat": true,
            "result": {
              "status": "unknown"
            }
          }
        ]
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "actor",
            "description": "The turn's actor.",
            "returns_actor": true
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "actor",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "Seen."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "identity_hooks": [
      {
        "name": "challenge",
        "trigger": "on_identity_unknown",
        "reactions": [
          {
            "repeat": true,
            "result": {
              "status": "challenge_sent",
              "message": "Identify yourself",
              "inject": {
                "event": {
                  "content": {
                    "type": "text",
                    "body": "Who are you?"
                  }
                },
                "target_channel_ids": [
                  "ws"
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "deliver",
      "room_id": "room-1",
      "content": "Send the report.",
      "addressed_to": [
        "agent"
      ],
      "expect": {
        "result": {
          "status": "sent"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "\"system\""
            }
          ]
        }
      ]
    },
    "resolver": [],
    "participants": {
      "room-1": []
    },
    "hooks": {
      "challenge": []
    }
  }
}
