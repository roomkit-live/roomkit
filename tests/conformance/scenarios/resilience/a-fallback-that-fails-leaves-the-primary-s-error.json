{
  "$schema": "../../scenario.schema.json",
  "id": "resilience/a-fallback-that-fails-leaves-the-primary-s-error",
  "title": "A fallback provider that fails before it handed anything leaves the primary's last refusal as the turn's error",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_ai_retry.py::TestFallbackProvider::test_fallback_failure_raises_original_error: the fallback's error is the cause (raise ... from), which the turn does not report.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "refuses": {
                "status": 503,
                "message": "the primary is overloaded",
                "retryable": true
              }
            },
            {
              "refuses": {
                "status": 503,
                "message": "the primary is overloaded",
                "retryable": true
              }
            }
          ]
        },
        "retry_policy": {
          "max_retries": 1,
          "base_delay_ms": 1
        },
        "fallback_model": {
          "rounds": [
            {
              "refuses": {
                "status": 500,
                "message": "the fallback is down",
                "retryable": false
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "the primary is overloaded"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "Hello?"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        }
      ],
      "agent/fallback": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        }
      ]
    }
  }
}
