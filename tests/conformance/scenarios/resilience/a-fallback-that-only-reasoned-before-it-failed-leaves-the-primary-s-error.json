{
  "$schema": "../../scenario.schema.json",
  "id": "resilience/a-fallback-that-only-reasoned-before-it-failed-leaves-the-primary-s-error",
  "title": "A fallback that streamed reasoning alone before it failed handed nothing: the turn fails with the primary's error, as for a fallback that failed at once",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: channels/_ai_resilience.py _generate_stream_with_retry, _fallback_stream (reasoning alone is not handed: it arms no `emitted`), channels/_ai_stream_round.py (a retry boundary drops the abandoned attempt's reasoning); tests/test_channels/test_ai_retry.py. RMK-1542 (HITL ea119829).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "retry_policy": {
          "max_retries": 0,
          "base_delay_ms": 1
        },
        "fallback_model": {
          "rounds": [
            {
              "thinking": [
                "Fallback thinks."
              ],
              "refuses": {
                "status": 500,
                "message": "fallback down",
                "retryable": true
              }
            }
          ]
        },
        "model": {
          "rounds": [
            {
              "refuses": {
                "status": 503,
                "message": "busy",
                "retryable": true
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        }
      },
      "expect": {
        "result": {
          "error": "busy"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {}
      ],
      "agent/fallback": [
        {}
      ]
    }
  }
}
