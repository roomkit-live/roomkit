{
  "$schema": "../../scenario.schema.json",
  "id": "resilience/a-refusal-that-survives-compaction-keeps-its-retries",
  "title": "A context overflow is compacted and replayed once; a replay refused again as worth another try is then tried again on the compacted context",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_ai_streaming_compaction.py::test_a_refusal_that_survives_compaction_falls_through_to_retry. One retry: the compacted replay spends none, so the refusal after it still has its retry.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a1"
            },
            {
              "text": "a2"
            },
            {
              "refuses": {
                "status": 400,
                "message": "prompt is too long: 210000 tokens > 200000 maximum",
                "retryable": true
              }
            },
            {
              "refuses": {
                "status": 400,
                "message": "prompt is too long: 210000 tokens > 200000 maximum",
                "retryable": true
              }
            },
            {
              "text": "Done"
            }
          ]
        },
        "retry_policy": {
          "max_retries": 1,
          "base_delay_ms": 1
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "q1"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "q2"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "q3"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "q1"
          }
        },
        {
          "index": 1,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "a1"
          }
        },
        {
          "index": 2,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "q2"
          }
        },
        {
          "index": 3,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "a2"
          }
        },
        {
          "index": 4,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "q3"
          }
        },
        {
          "index": 5,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Done"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {},
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "q1"
            },
            {
              "role": "assistant",
              "text": "a1"
            },
            {
              "role": "user",
              "text": "q2"
            },
            {
              "role": "assistant",
              "text": "a2"
            },
            {
              "role": "user",
              "text": "q3"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": "[Context compacted"
              }
            },
            {
              "role": "assistant",
              "text": "a2"
            },
            {
              "role": "user",
              "text": "q3"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": "[Context compacted"
              }
            },
            {
              "role": "assistant",
              "text": "a2"
            },
            {
              "role": "user",
              "text": "q3"
            }
          ]
        }
      ]
    }
  }
}
