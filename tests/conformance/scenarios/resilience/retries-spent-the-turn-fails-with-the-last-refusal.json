{
  "$schema": "../../scenario.schema.json",
  "id": "resilience/retries-spent-the-turn-fails-with-the-last-refusal",
  "title": "Once its retries are spent and no fallback provider is set, the turn fails with the last refusal",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_ai_retry.py::TestRetry::test_all_retries_exhausted_raises.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "refuses": {
                "status": 529,
                "message": "overloaded (1)",
                "retryable": true
              }
            },
            {
              "refuses": {
                "status": 529,
                "message": "overloaded (2)",
                "retryable": true
              }
            },
            {
              "refuses": {
                "status": 529,
                "message": "overloaded (3)",
                "retryable": true
              }
            }
          ]
        },
        "retry_policy": {
          "max_retries": 2,
          "base_delay_ms": 1
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "overloaded (3)"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "Hello?"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        }
      ]
    }
  }
}
