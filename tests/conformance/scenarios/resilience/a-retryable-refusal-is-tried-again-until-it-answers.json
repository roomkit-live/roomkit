{
  "$schema": "../../scenario.schema.json",
  "id": "resilience/a-retryable-refusal-is-tried-again-until-it-answers",
  "title": "A generation its provider refuses as worth another try, before it handed anything, is tried again under the agent's retry policy until it answers",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_ai_retry.py::TestRetry::test_retries_on_retryable_error and TestStreamRetry::test_stream_retries_on_retryable_error.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "refuses": {
                "status": 429,
                "message": "rate limited",
                "retryable": true
              }
            },
            {
              "refuses": {
                "status": 429,
                "message": "rate limited",
                "retryable": true
              }
            },
            {
              "text": "recovered"
            }
          ]
        },
        "retry_policy": {
          "max_retries": 3,
          "base_delay_ms": 1
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello?"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "Hello?"
          }
        },
        {
          "index": 1,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "recovered"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        }
      ]
    }
  }
}
