{
  "$schema": "../../scenario.schema.json",
  "id": "resilience/the-fallback-answers-once-the-retries-are-spent",
  "title": "Once the retries are spent on refusals worth another try, the fallback provider is asked the same request, once, and its answer is the agent's",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_ai_retry.py::TestFallbackProvider::test_fallback_triggers_after_retry_exhaustion, TestStreamRetry::test_stream_fallback_on_exhaustion; tests/test_channels/test_ai_streaming_compaction.py::test_a_turn_without_tools_retries_and_falls_back.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "refuses": {
                "status": 529,
                "message": "overloaded",
                "retryable": true
              }
            },
            {
              "refuses": {
                "status": 529,
                "message": "overloaded",
                "retryable": true
              }
            }
          ]
        },
        "retry_policy": {
          "max_retries": 1,
          "base_delay_ms": 1
        },
        "fallback_model": {
          "rounds": [
            {
              "text": "fallback response"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello?"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "Hello?"
          }
        },
        {
          "index": 1,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "fallback response"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        }
      ],
      "agent/fallback": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        }
      ]
    }
  }
}
