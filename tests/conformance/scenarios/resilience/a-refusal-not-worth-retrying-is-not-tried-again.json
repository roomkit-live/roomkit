{
  "$schema": "../../scenario.schema.json",
  "id": "resilience/a-refusal-not-worth-retrying-is-not-tried-again",
  "title": "A refusal its provider says is not worth another try fails the turn at once: no retry, and the fallback provider is not asked",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_ai_retry.py::TestRetry::test_non_retryable_error_raises_immediately and TestFallbackProvider::test_no_fallback_on_non_retryable_error.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "refuses": {
                "status": 401,
                "message": "invalid api key",
                "retryable": false
              }
            },
            {
              "text": "never"
            }
          ]
        },
        "retry_policy": {
          "max_retries": 3,
          "base_delay_ms": 1
        },
        "fallback_model": {
          "rounds": [
            {
              "text": "fallback"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "invalid api key"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "Hello?"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Hello?"
            }
          ]
        }
      ],
      "agent/fallback": []
    }
  }
}
