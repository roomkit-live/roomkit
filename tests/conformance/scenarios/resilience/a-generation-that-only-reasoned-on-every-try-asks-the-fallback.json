{
  "$schema": "../../scenario.schema.json",
  "id": "resilience/a-generation-that-only-reasoned-on-every-try-asks-the-fallback",
  "title": "A generation whose every try streamed reasoning alone before a refusal worth another try spends its retries, then the fallback answers the turn",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: channels/_ai_resilience.py _generate_stream_with_retry, _fallback_stream (reasoning alone is not handed: it arms no `emitted`), channels/_ai_stream_round.py (a retry boundary drops the abandoned attempt's reasoning); tests/test_channels/test_ai_retry.py. RMK-1542 (HITL ea119829).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "retry_policy": {
          "max_retries": 1,
          "base_delay_ms": 1
        },
        "fallback_model": {
          "rounds": [
            {
              "text": "The fallback's."
            }
          ]
        },
        "model": {
          "rounds": [
            {
              "thinking": [
                "One."
              ],
              "refuses": {
                "status": 503,
                "message": "busy",
                "retryable": true
              }
            },
            {
              "thinking": [
                "Two."
              ],
              "refuses": {
                "status": 503,
                "message": "busy",
                "retryable": true
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        }
      },
      "expect": {
        "result": {
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {}
      ],
      "agent/fallback": [
        {}
      ]
    },
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message"
        },
        {
          "index": 1,
          "type": "message",
          "content": {
            "body": "The fallback's."
          }
        }
      ]
    }
  }
}
