{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-session-s-recording-starts-and-stops-with-its-hooks",
  "title": "A recorder starts with the session, firing ON_RECORDING_STARTED, and stops when it ends, firing ON_RECORDING_STOPPED with its result",
  "rules": [
    "§12.3.7",
    "§12.3.14",
    "§9.2"
  ],
  "requirements": [
    "RK-12.3.7-022",
    "RK-12.3.7-023",
    "RK-12.3.14-007",
    "RK-12.3.14-009"
  ],
  "notes": "The scripted recorder's stop returns a RecordingResult under its handle's id; the stop hook carries that id.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "started",
        "trigger": "on_recording_started",
        "execution": "async"
      },
      {
        "name": "stopped",
        "trigger": "on_recording_stopped",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "session_ids": {
        "alice": "s-alice"
      },
      "recorder": {}
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "stages": [
        "recorder"
      ],
      "calls": [
        "start",
        "stop"
      ],
      "expect": {
        "result": {
          "stages": [
            {
              "stage": "recorder",
              "call": "start",
              "stream": "s-alice"
            }
          ]
        }
      }
    },
    {
      "call": "voice.leave",
      "channel_id": "phone",
      "participant_id": "alice"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "stages": [
        "recorder"
      ],
      "calls": [
        "start",
        "stop"
      ],
      "expect": {
        "result": {
          "stages": [
            {
              "stage": "recorder",
              "call": "start",
              "stream": "s-alice"
            },
            {
              "stage": "recorder",
              "call": "stop",
              "stream": "s-alice"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "started": [
        {
          "voice": {
            "participant_id": "alice",
            "id": {
              "$as": "recording"
            }
          }
        }
      ],
      "stopped": [
        {
          "voice": {
            "participant_id": "alice",
            "id": {
              "$as": "recording"
            }
          }
        }
      ]
    }
  }
}
