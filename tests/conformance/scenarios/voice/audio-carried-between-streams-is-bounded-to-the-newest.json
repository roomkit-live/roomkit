{
  "$schema": "../../scenario.schema.json",
  "id": "voice/audio-carried-between-streams-is-bounded-to-the-newest",
  "title": "A reconnect that takes long hands the next stream only the newest audio: a second of speech before thirty of silence is dropped",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-068",
    "RK-12.2-069"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "one"
              }
            ],
            "then": "end",
            "gate": "reconnect"
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "reconnect"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ],
      "repeat": 10
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ],
      "repeat": 300
    },
    {
      "open": "reconnect"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "stt_streams": [
            {
              "language": null
            },
            {
              "sound_ms": 0,
              "silence_ms": {
                "$present": true
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "one"
          }
        }
      ]
    }
  }
}
