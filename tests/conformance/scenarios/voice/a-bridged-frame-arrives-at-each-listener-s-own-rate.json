{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-bridged-frame-arrives-at-each-listener-s-own-rate",
  "title": "A frame bridged to sessions of other sample rates reaches each at the output rate its session registered",
  "rules": [
    "§12.7.4"
  ],
  "requirements": [
    "RK-12.7.4-002",
    "RK-12.7.4-003",
    "RK-12.7.8-009"
  ],
  "notes": "Alice's session registers at 16 kHz; Bob's takes 16 kHz in and 8 kHz out, Carol's 8 kHz in and 32 kHz out. The pipeline declares no transport format, so the frame reaches each transport at the output rate the bridge converted it to; the converted samples are the resampler's. No session's rate changes after it registers.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob",
        "carol"
      ],
      "bridge": true,
      "sample_rates": {
        "alice": {
          "input_sample_rate": 16000
        },
        "bob": {
          "input_sample_rate": 16000,
          "output_sample_rate": 8000
        },
        "carol": {
          "input_sample_rate": 8000,
          "output_sample_rate": 32000
        }
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "6APoA+gD6APoA+gD6APoAw=="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "chunks": {
            "alice": [],
            "bob": [
              {
                "data": "$any",
                "sample_rate": 8000,
                "channels": 1
              }
            ],
            "carol": [
              {
                "data": "$any",
                "sample_rate": 32000,
                "channels": 1
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {}
}
