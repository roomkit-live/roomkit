{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-transport-barge-in-cancels-active-playback",
  "title": "A transport barge-in cuts off active speech and reports its cancellation",
  "rules": [
    "§9.2"
  ],
  "requirements": [
    "RK-12.2-040",
    "RK-9.2-040",
    "RK-9.2-041"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gate": "playing"
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Still speaking",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.barge_in",
      "channel_id": "phone",
      "participant_id": "alice"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice",
            "interrupted_text": "Still speaking"
          }
        }
      ],
      "stopped": [
        {
          "voice": {
            "participant_id": "alice",
            "reason": "barge_in",
            "text": "Still speaking"
          }
        }
      ]
    }
  }
}
