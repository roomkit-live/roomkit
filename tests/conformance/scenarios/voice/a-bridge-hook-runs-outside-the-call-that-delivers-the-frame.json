{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-bridge-hook-runs-outside-the-call-that-delivers-the-frame",
  "title": "A bridge hook holding a frame does not hold the call that delivered it, and the frame is forwarded once allowed",
  "rules": [
    "§12.7.6"
  ],
  "requirements": [
    "RK-12.7.6-012"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "filter",
        "trigger": "before_bridge_audio",
        "execution": "sync",
        "reactions": [
          {
            "gate": "first-frame"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ],
      "bridge": true
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ],
      "background": true,
      "as": "first"
    },
    {
      "wait_for": "first-frame"
    },
    {
      "await": "first"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AwQ="
      ]
    },
    {
      "open": "first-frame"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "bob": {
              "$unordered": [
                "AQI=",
                "AwQ="
              ]
            }
          }
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "filter": [
        {
          "voice": {
            "participant_id": "alice"
          }
        },
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
