{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-bridged-listener-hears-the-speaker-and-the-synthesized-reply",
  "title": "Speech synthesized to a bridged participant and the frames bridged to it while it plays both reach its transport",
  "rules": [
    "§12.7.1",
    "§12.7.3"
  ],
  "requirements": [
    "RK-12.7.1-002",
    "RK-12.7.3-014",
    "RK-12.7.3-016"
  ],
  "notes": "The default forward strategy: the reply's audio and the bridged frames both reach the listener's transport; one mixed stream under the mix strategy is not shown.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ],
      "bridge": true,
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "hello there"
      ],
      "playback_gate": "playing"
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "bob",
      "text": "One moment.",
      "background": true,
      "as": "saying"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AwQ="
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "saying"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "alice": [],
            "bob": {
              "$unordered": [
                "$any",
                "AQI=",
                "AwQ="
              ]
            }
          },
          "synthesized": [
            "One moment."
          ]
        }
      }
    }
  ],
  "expect": {}
}
