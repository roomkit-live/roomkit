{
  "$schema": "../../scenario.schema.json",
  "id": "voice/one-voice-channel-bridges-each-of-its-rooms-apart",
  "title": "A voice channel attached to two rooms bridges each room's frames to the sessions of that room alone",
  "rules": [
    "§12.7.2"
  ],
  "requirements": [
    "RK-12.7.2-010"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      },
      {
        "id": "r2"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ],
      "bridge": true
    },
    {
      "call": "attach_channel",
      "room_id": "r2",
      "channel_id": "phone"
    },
    {
      "call": "voice.join",
      "channel_id": "phone",
      "participant_id": "carol",
      "room_id": "r2"
    },
    {
      "call": "voice.join",
      "channel_id": "phone",
      "participant_id": "dave",
      "room_id": "r2"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "carol",
      "frames": [
        "AwQ="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "alice": [],
            "bob": [
              "AQI="
            ],
            "carol": [],
            "dave": [
              "AwQ="
            ]
          }
        }
      }
    }
  ],
  "expect": {}
}
