{
  "$schema": "../../scenario.schema.json",
  "id": "voice/without-a-vad-the-recognizer-or-a-flush-ends-the-speech",
  "title": "Without a VAD a streaming recognizer ends each utterance, and in batch mode a flush does",
  "rules": [
    "§12.3.8"
  ],
  "requirements": [
    "RK-12.3.8-005"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      },
      {
        "id": "r2"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "hello"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.open",
      "channel_id": "batch",
      "room_id": "r2",
      "participants": [
        "alice"
      ],
      "stt": {
        "streams": [
          {
            "at_end": [
              {
                "text": "goodbye"
              }
            ]
          }
        ]
      },
      "batch_mode": true
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "batch",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.flush_stt",
      "channel_id": "batch",
      "participant_id": "alice",
      "route": true,
      "expect": {
        "result": {
          "text": "goodbye"
        }
      }
    },
    {
      "call": "voice.settle",
      "channel_id": "batch"
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "hello"
          }
        }
      ],
      "r2": [
        {
          "content": {
            "body": "goodbye"
          }
        }
      ]
    }
  }
}
