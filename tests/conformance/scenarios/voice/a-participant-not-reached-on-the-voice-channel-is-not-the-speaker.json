{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-participant-not-reached-on-the-voice-channel-is-not-the-speaker",
  "title": "A participant a hook names who is not on the voice channel does not take the message",
  "rules": [
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2.3-033"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ],
        "participants": [
          {
            "id": "carol",
            "channel_id": "sms"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "tx",
        "trigger": "on_transcription",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "participant_id": "carol"
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "hello",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "hello"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "hello"
          },
          "source": {
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
