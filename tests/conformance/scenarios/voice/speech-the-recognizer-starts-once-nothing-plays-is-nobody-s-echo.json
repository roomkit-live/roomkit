{
  "$schema": "../../scenario.schema.json",
  "id": "voice/speech-the-recognizer-starts-once-nothing-plays-is-nobody-s-echo",
  "title": "A speech start the recognizer signals once nothing plays ends the echo verdict: the final that follows is a turn, even in the reply's words",
  "rules": [
    "§12.3.13",
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-056",
    "RK-12.3.13-031"
  ],
  "notes": "voice/an-echo-verdict-outlives-the-reply-until-its-final is the same run without the speech start.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gate": "playing",
      "aec": {},
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "Your table",
                "final": false
              },
              {
                "text": "",
                "final": false,
                "speech_start": true
              },
              {
                "text": "your table for two"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table for two is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "",
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": []
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "your table for two"
          }
        }
      ]
    }
  }
}
