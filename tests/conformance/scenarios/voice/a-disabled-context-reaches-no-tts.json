{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-disabled-context-reaches-no-tts",
  "title": "With TTSContextConfig.enabled false the channel keeps no context, and a TTS at TEXT is called with none",
  "rules": [
    "§12.2.2",
    "§12.2"
  ],
  "requirements": [
    "RK-12.2.2-012"
  ],
  "notes": "The defaults of TTSContextConfig (20 turns, 120 s of audio) are not shown.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "session_ids": {
        "alice": "s-alice"
      },
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "Book a table"
      ],
      "tts": {
        "context_level": "text",
        "word_ms": 20
      },
      "tts_context": {
        "enabled": false
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "First reply."
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Second reply."
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "tts_contexts": [
            null,
            null
          ]
        }
      }
    }
  ]
}
