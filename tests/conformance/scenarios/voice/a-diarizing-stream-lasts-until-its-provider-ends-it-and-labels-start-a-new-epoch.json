{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-diarizing-stream-lasts-until-its-provider-ends-it-and-labels-start-a-new-epoch",
  "title": "One diarizing stream carries several turns; the next one's labels are a new epoch",
  "rules": [
    "§12.2",
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2-063",
    "RK-12.2.3-021",
    "RK-12.2.3-024",
    "RK-12.2.3-025",
    "RK-12.2.3-035",
    "RK-12.2.3-039",
    "RK-12.2.3-040"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "change",
        "trigger": "on_speaker_change",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "one",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "one"
                  }
                ]
              },
              {
                "text": "two",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "two"
                  }
                ]
              },
              {
                "text": "three",
                "segments": [
                  {
                    "speaker": "B",
                    "text": "three"
                  }
                ]
              },
              {
                "text": "four",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "four"
                  }
                ]
              }
            ],
            "then": "end"
          },
          {
            "results": [
              {
                "text": "five",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "five"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "stt_streams": [
            {
              "language": null
            },
            {
              "language": null
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "change": [
        {
          "voice": {
            "speaker_id": "A",
            "speaker_epoch": 0,
            "is_new_speaker": true
          }
        },
        {
          "voice": {
            "speaker_id": "B",
            "speaker_epoch": 0,
            "is_new_speaker": true
          }
        },
        {
          "voice": {
            "speaker_id": "A",
            "speaker_epoch": 0,
            "is_new_speaker": false
          }
        },
        {
          "voice": {
            "speaker_id": "A",
            "speaker_epoch": 1,
            "is_new_speaker": true
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "one"
          },
          "metadata": {
            "speaker_label": "A",
            "speaker_epoch": 0,
            "sender_name": "Speaker A"
          }
        },
        {
          "content": {
            "body": "two"
          },
          "metadata": {
            "speaker_label": "A",
            "speaker_epoch": 0,
            "sender_name": "Speaker A"
          }
        },
        {
          "content": {
            "body": "three"
          },
          "metadata": {
            "speaker_label": "B",
            "speaker_epoch": 0,
            "sender_name": "Speaker B"
          }
        },
        {
          "content": {
            "body": "four"
          },
          "metadata": {
            "speaker_label": "A",
            "speaker_epoch": 0,
            "sender_name": "Speaker A"
          }
        },
        {
          "content": {
            "body": "five"
          },
          "metadata": {
            "speaker_label": "A",
            "speaker_epoch": 1,
            "sender_name": "Speaker A#1"
          }
        }
      ]
    }
  }
}
