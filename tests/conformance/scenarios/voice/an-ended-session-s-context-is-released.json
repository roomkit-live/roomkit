{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-ended-session-s-context-is-released",
  "title": "When a session leaves, the channel releases its TTS context under the session's id",
  "rules": [
    "§12.2.2",
    "§12.2"
  ],
  "requirements": [
    "RK-12.2.2-028"
  ],
  "notes": "What the provider then drops is the provider's own contract, outside roomkit's conformance.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "session_ids": {
        "alice": "s-alice"
      },
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "Book a table"
      ],
      "tts": {
        "context_level": "text",
        "word_ms": 20
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "First reply."
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "released_contexts": []
        }
      }
    },
    {
      "call": "voice.leave",
      "channel_id": "phone",
      "participant_id": "alice"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "released_contexts": [
            "s-alice"
          ]
        }
      }
    }
  ]
}
