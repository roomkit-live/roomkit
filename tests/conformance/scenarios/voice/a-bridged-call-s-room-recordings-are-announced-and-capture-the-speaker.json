{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-bridged-call-s-room-recordings-are-announced-and-capture-the-speaker",
  "title": "Room recordings of a bridged call announce their start and end and capture the bridged speaker's frames",
  "rules": [
    "§12.7.6",
    "§12.11"
  ],
  "requirements": [
    "RK-12.7.6-010"
  ],
  "notes": "Room recordings only: a recorder in the voice pipeline needs a step that makes a pipeline stage visible.",
  "requires_features": [
    "voice",
    "recording"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "started",
        "trigger": "on_recording_started",
        "execution": "async"
      },
      {
        "name": "stopped",
        "trigger": "on_recording_stopped",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "recording.start",
      "room_id": "r1",
      "recorder": "first"
    },
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ],
      "bridge": true
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "recording.start",
      "room_id": "r1",
      "recorder": "second"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AwQ="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "alice": [],
            "bob": [
              "AQI=",
              "AwQ="
            ]
          }
        }
      }
    },
    {
      "call": "recording.stop",
      "room_id": "r1"
    },
    {
      "call": "recording.read",
      "recorder": "first",
      "expect": {
        "result": [
          "AQI=",
          "AwQ="
        ]
      }
    },
    {
      "call": "recording.read",
      "recorder": "second",
      "expect": {
        "result": [
          "AwQ="
        ]
      }
    }
  ],
  "expect": {
    "hooks": {
      "started": [
        {
          "recording": {
            "recording_id": "first",
            "room_id": "r1"
          }
        },
        {
          "recording": {
            "recording_id": "second",
            "room_id": "r1"
          }
        }
      ],
      "stopped": {
        "$unordered": [
          {
            "recording": {
              "recording_id": "first",
              "room_id": "r1"
            }
          },
          {
            "recording": {
              "recording_id": "second",
              "room_id": "r1"
            }
          }
        ]
      }
    }
  }
}
