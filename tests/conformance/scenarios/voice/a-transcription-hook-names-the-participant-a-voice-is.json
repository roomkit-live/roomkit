{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-transcription-hook-names-the-participant-a-voice-is",
  "title": "A transcription hook's participant makes the message theirs; a name only when it gave one",
  "rules": [
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2.3-030",
    "RK-12.2.3-031"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "tx",
        "trigger": "on_transcription",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "participant_id": "bob"
              }
            }
          },
          {
            "result": {
              "action": "modify",
              "event": {
                "participant_id": "bob",
                "sender_name": "Bobby"
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "one two three",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "one"
                  },
                  {
                    "speaker": "B",
                    "text": "two"
                  },
                  {
                    "speaker": "C",
                    "text": "three"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "call": "add_member",
      "room_id": "r1",
      "channel_id": "phone",
      "participant_id": "bob"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "one"
          },
          "source": {
            "participant_id": "bob"
          },
          "metadata": {
            "speaker_label": "A",
            "sender_name": {
              "$absent": true
            }
          }
        },
        {
          "content": {
            "body": "two"
          },
          "source": {
            "participant_id": "bob"
          },
          "metadata": {
            "speaker_label": "B",
            "sender_name": "Bobby"
          }
        },
        {
          "content": {
            "body": "three"
          },
          "source": {
            "participant_id": "alice"
          },
          "metadata": {
            "speaker_label": "C",
            "sender_name": "Speaker C"
          }
        }
      ]
    }
  }
}
