          "confidence": 0.9,
          "is_new_speaker": false
        },
        {
          "speaker_id": "A",
          "confidence": 0.9,
          "is_new_speaker": false
        },
        {
          "speaker_id": null,
          "confidence": 0.9,
          "is_new_speaker": false
        },
        {
          "speaker_id": "A",
          "confidence": 0.9,
          "is_new_speaker": false
        }
      ]
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI=",
        "AQI=",
        "AQI=",
        "AQI="
