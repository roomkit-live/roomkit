      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "vad": [
        null,
        null,
        null,
        null,
        null
      ],
      "speakers": [
        {
          "speaker_id": "A",
          "confidence": 0.9,
          "is_new_speaker": false
        },
        {
