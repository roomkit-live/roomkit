{
  "$schema": "../../scenario.schema.json",
  "id": "voice/the-detector-is-told-a-partial-from-the-final-and-never-asked-at-an-empty-onset",
  "title": "Under SEMANTIC the detector is given a partial with is_final false and the final with is_final true, and is never consulted at the speech onset",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-017",
    "RK-12.3.13-043"
  ],
  "notes": "The channel hands the held speech to the recognizer 200 ms at a time: it gives the partial on the first 200 ms and holds its final at a gate until the next came, so the partial was judged before the speech ends; the final follows the speech's end. A second look at the same words, which a pending verdict brings, reads as one context.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cutting"
          }
        ]
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      },
      {
        "name": "ack",
        "trigger": "on_backchannel",
        "execution": "async",
        "reactions": [
          {
            "gate": "acknowledged"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "playing"
      ],
      "vad": [
        {
          "type": "speech_start"
        },
        null,
        {
          "type": "speech_end"
        }
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "Ou",
                "final": false
              },
              {
                "text": "Ouais",
                "gate": "judged"
              }
            ]
          }
        ]
      },
      "backchannel_decisions": [
        {
          "transcript": "Ou",
          "is_backchannel": false,
          "pending": true
        },
        {
          "transcript": "Ouais",
          "is_backchannel": true
        }
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "",
        ""
      ]
    },
    {
      "wait_for": "judged"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "open": "judged"
    },
    {
      "wait_for": "acknowledged"
    },
    {
      "open": "acknowledged"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "backchannel_contexts": [
            {
              "transcript": "Ou",
              "is_final": false
            },
            {
              "transcript": "Ouais",
              "is_final": true
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "cut": [],
      "stopped": [],
      "ack": [
        {
          "voice": {
            "text": "Ouais"
          }
        }
      ]
    },
    "timeline": {
      "r1": []
    }
  }
}
