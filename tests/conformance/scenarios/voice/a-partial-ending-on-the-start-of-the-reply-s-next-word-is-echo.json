{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-partial-ending-on-the-start-of-the-reply-s-next-word-is-echo",
  "title": "A partial whose last word starts the reply's next word, after a whole word, is still echo",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-028"
  ],
  "notes": "backchannels selects SEMANTIC, whose verdict waits for the words; under IMMEDIATE a VAD's speech start cuts before any word can tell the echo (RK-12.3.13-009).",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "partial",
        "trigger": "on_partial_transcription",
        "execution": "async"
      },
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gate": "playing",
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "partials": [
        "Your ta"
      ],
      "transcripts": [
        "Your table"
      ],
      "backchannels": [
        false,
        false,
        false
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "partial": [],
      "cut": [],
      "stopped": []
    },
    "timeline": {
      "r1": []
    }
  }
}
