{
  "$schema": "../../scenario.schema.json",
  "id": "voice/past-echo-guard-ms-of-played-audio-the-reply-s-own-words-cut-it",
  "title": "Once the session has played echo_guard_ms of audio, words of the reply being played cut it and are the turn",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-037"
  ],
  "notes": "The first reply plays whole, two words of 20 ms each: 40 ms played, past the 30 ms guard.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cutting"
          }
        ]
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        null,
        "playing"
      ],
      "interruption": {
        "echo_guard_ms": 30
      },
      "tts": {
        "word_ms": 20
      },
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "partials": [
        "Your table"
      ],
      "transcripts": [
        "your table for two"
      ],
      "backchannels": [
        false,
        false,
        false
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Hello there."
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table for two is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "wait_for": "cutting"
    },
    {
      "open": "cutting"
    },
    {
      "wait_for": "cut"
    },
    {
      "open": "cut"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    },
    "timeline": {
      "r1": {
        "$unordered": [
          {
            "metadata": {
              "interrupted": true
            }
          },
          {
            "content": {
              "body": "your table for two"
            }
          }
        ]
      }
    }
  }
}
