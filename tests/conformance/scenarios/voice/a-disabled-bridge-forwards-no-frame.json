{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-disabled-bridge-forwards-no-frame",
  "title": "A bridge configured with enabled false forwards no participant's frame to the other",
  "rules": [
    "§12.7.2"
  ],
  "requirements": [
    "RK-12.7.2-006"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ],
      "bridge": {
        "enabled": false
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "bob",
      "frames": [
        "AwQ="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "alice": [],
            "bob": []
          }
        }
      }
    }
  ],
  "expect": {}
}
