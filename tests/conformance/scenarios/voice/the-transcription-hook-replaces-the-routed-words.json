{
  "$schema": "../../scenario.schema.json",
  "id": "voice/the-transcription-hook-replaces-the-routed-words",
  "title": "A transcription hook changes the words that reach the room",
  "rules": [
    "§9.2"
  ],
  "requirements": [
    "RK-12.2-019",
    "RK-12.2-020",
    "RK-9.2-037"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "redact",
        "trigger": "on_transcription",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "text": "omitted"
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "private number"
      ]
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "hooks": {
      "redact": [
        {
          "voice": {
            "participant_id": "alice",
            "text": "private number"
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "omitted"
          }
        }
      ]
    }
  }
}
