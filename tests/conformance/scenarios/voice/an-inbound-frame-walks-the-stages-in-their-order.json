{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-inbound-frame-walks-the-stages-in-their-order",
  "title": "An inbound frame reaches the recorder and the DTMF detector as the transport sent it, then the AEC, the AGC, the denoiser, the VAD and the diarization, each handed the one before's output",
  "rules": [
    "§12.2",
    "§12.3",
    "§12.3.4",
    "§12.3.5",
    "§12.3.6",
    "§12.3.14"
  ],
  "requirements": [
    "RK-12.2-017",
    "RK-12.3.4-018",
    "RK-12.3.5-005",
    "RK-12.3.5-006",
    "RK-12.3.6-006",
    "RK-12.3.14-016"
  ],
  "notes": "No contract, so no resampler: the frame the transport sent is what the recorder and the DTMF detector receive. The resampler's place is in voice/a-contract-hands-every-inbound-stage-the-internal-format. The recorder and the DTMF detector are each read against the main chain: their order between themselves is left open.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "session_ids": {
        "alice": "s-alice"
      },
      "aec": {
        "output": "AwQ="
      },
      "agc": {
        "output": "BQY="
      },
      "denoiser": {
        "output": "Bwg="
      },
      "recorder": {},
      "tones": [],
      "speakers": [],
      "vad": [
        null
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "stages": [
        "recorder",
        "aec",
        "agc",
        "denoiser",
        "vad",
        "diarization"
      ],
      "calls": [
        "tap_inbound",
        "process"
      ],
      "expect": {
        "result": {
          "stages": [
            {
              "stage": "recorder",
              "call": "tap_inbound",
              "stream": "s-alice",
              "frame": {
                "data": "AQI="
              }
            },
            {
              "stage": "aec",
              "call": "process",
              "stream": "s-alice",
              "frame": {
                "data": "AQI="
              }
            },
            {
              "stage": "agc",
              "call": "process",
              "stream": "s-alice",
              "frame": {
                "data": "AwQ="
              }
            },
            {
              "stage": "denoiser",
              "call": "process",
              "stream": "s-alice",
              "frame": {
                "data": "BQY="
              }
            },
            {
              "stage": "vad",
              "call": "process",
              "stream": "s-alice",
              "frame": {
                "data": "Bwg="
              }
            },
            {
              "stage": "diarization",
              "call": "process",
              "stream": "s-alice",
              "frame": {
                "data": "Bwg="
              }
            }
          ]
        }
      }
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "stages": [
        "dtmf",
        "aec"
      ],
      "calls": [
        "process"
      ],
      "expect": {
        "result": {
          "stages": [
            {
              "stage": "dtmf",
              "call": "process",
              "stream": "s-alice",
              "frame": {
                "data": "AQI="
              }
            },
            {
              "stage": "aec",
              "call": "process",
              "stream": "s-alice",
              "frame": {
                "data": "AQI="
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {}
}
