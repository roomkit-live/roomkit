{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-plain-recognizer-gets-a-stream-per-turn",
  "title": "In continuous mode a recognizer that neither diarizes nor keeps its stream gets one per turn",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-062"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "first turn"
              }
            ]
          },
          {
            "results": [
              {
                "text": "second turn"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "stt_streams": [
            {
              "language": null
            },
            {
              "language": null
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "first turn"
          }
        },
        {
          "content": {
            "body": "second turn"
          }
        }
      ]
    }
  }
}
