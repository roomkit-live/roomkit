{
  "$schema": "../../scenario.schema.json",
  "id": "voice/blocked-speech-before-the-reply-is-heard-releases-it",
  "title": "Speech resumed before the reply is heard, then blocked by a transcription hook, releases the reply",
  "rules": [
    "§12.3.12",
    "§9.2"
  ],
  "requirements": [
    "RK-12.3.12-019"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "channels": [
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Your table by the window is ready now.",
              "gate": "thinking"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "filter",
        "trigger": "on_transcription",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "allow"
            }
          },
          {
            "gate": "judging",
            "result": {
              "action": "block"
            }
          }
        ]
      },
      {
        "name": "speaking",
        "trigger": "before_tts",
        "execution": "sync",
        "reactions": [
          {
            "gate": "synthesizing"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        },
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "Book a table",
        "um"
      ]
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI="
      ]
    },
    {
      "wait_for": "thinking"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI="
      ]
    },
    {
      "wait_for": "judging"
    },
    {
      "open": "thinking"
    },
    {
      "wait_for": "synthesizing"
    },
    {
      "open": "synthesizing"
    },
    {
      "open": "judging"
    },
    {
      "idle": true
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "synthesized": [
            "Your table by the window is ready now."
          ],
          "audio": {
            "alice": [
              "$any"
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "filter": [
        {
          "voice": {
            "participant_id": "alice",
            "text": "Book a table"
          }
        },
        {
          "voice": {
            "participant_id": "alice",
            "text": "um"
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "type": "text",
            "body": "Book a table"
          }
        },
        {
          "content": {
            "body": "Your table by the window is ready now."
          },
          "metadata": {
            "cancelled": {
              "$absent": true
            }
          }
        }
      ]
    }
  }
}
