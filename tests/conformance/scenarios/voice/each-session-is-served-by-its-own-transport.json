{
  "$schema": "../../scenario.schema.json",
  "id": "voice/each-session-is-served-by-its-own-transport",
  "title": "On a channel with an added transport, each session gets its bridged audio, its reply, its transcription and its hang-up through the one transport that serves it",
  "rules": [
    "§12.7.3"
  ],
  "requirements": [
    "RK-12.7.3-021",
    "RK-12.7.3-022",
    "RK-12.7.3-023",
    "RK-12.7.3-024",
    "RK-12.7.3-025"
  ],
  "notes": "Alice joins on the primary transport, the caller's session is made by the added one and pushed with no transport named, and Bob joins naming the added one. Only Bob's join makes its session on the added transport, which is then started listening there. Not shown: a digit sent to a session (voice.send_dtmf), and a join naming a transport that does not hold its session (Bob's is made there, so asking would find it too).",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "bridge": true
    },
    {
      "call": "voice.add_backend",
      "channel_id": "phone",
      "backend": "line",
      "session_ids": {
        "caller": "line-1",
        "bob": "line-2"
      }
    },
    {
      "call": "voice.connect",
      "channel_id": "phone",
      "participant_id": "caller",
      "backend": "line"
    },
    {
      "call": "voice.join",
      "channel_id": "phone",
      "participant_id": "caller",
      "push": true
    },
    {
      "call": "voice.join",
      "channel_id": "phone",
      "participant_id": "bob",
      "backend": "line"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.stream",
      "channel_id": "phone",
      "chunks": [
        "Hello all."
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.leave",
      "channel_id": "phone",
      "participant_id": "caller"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "transports": {
            "primary": {
              "$unordered": [
                {
                  "call": "connect",
                  "participant_id": "alice"
                },
                {
                  "call": "start_listening",
                  "participant_id": "alice"
                },
                {
                  "call": "send_audio",
                  "participant_id": "alice"
                },
                {
                  "call": "send_transcription",
                  "participant_id": "alice"
                }
              ]
            },
            "line": {
              "$unordered": [
                {
                  "call": "connect",
                  "participant_id": "caller"
                },
                {
                  "call": "connect",
                  "participant_id": "bob"
                },
                {
                  "call": "start_listening",
                  "participant_id": "bob"
                },
                {
                  "call": "send_audio_sync",
                  "participant_id": "caller"
                },
                {
                  "call": "send_audio_sync",
                  "participant_id": "bob"
                },
                {
                  "call": "send_audio",
                  "participant_id": "caller"
                },
                {
                  "call": "send_audio",
                  "participant_id": "bob"
                },
                {
                  "call": "send_transcription",
                  "participant_id": "caller"
                },
                {
                  "call": "send_transcription",
                  "participant_id": "bob"
                },
                {
                  "call": "disconnect",
                  "participant_id": "caller"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "expect": {}
}
