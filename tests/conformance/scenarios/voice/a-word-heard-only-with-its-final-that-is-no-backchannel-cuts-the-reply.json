{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-word-heard-only-with-its-final-that-is-no-backchannel-cuts-the-reply",
  "title": "A short word whose words come only with the final, and that is no acknowledgement, cuts and is the turn",
  "rules": [
    "§12.3.13",
    "§12.6"
  ],
  "requirements": [
    "RK-12.3.13-024",
    "RK-12.3.13-025",
    "RK-12.6-019"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "ack",
        "trigger": "on_backchannel",
        "execution": "async"
      },
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "streams": [
          {
            "at_end": [
              {
                "text": "stop"
              }
            ]
          }
        ]
      },
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "backchannels": [
        false
      ],
      "playback_gate": "playing"
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "The kitchen lamp or the living room lamp?",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "hooks": {
      "ack": [],
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    },
    "timeline": {
      "r1": {
        "$unordered": [
          {
            "content": {
              "body": "stop"
            }
          },
          {
            "metadata": {
              "interrupted": true
            }
          }
        ]
      }
    }
  }
}
