{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-meeting-bridged-into-one-stream-reads-its-first-speaker-s-turn-under-their-name",
  "title": "A meeting bridged into one audio stream, its people written on the roster and a voice matched to its person, reads that person's first turn labelled",
  "rules": [
    "§6.4",
    "§12.2.3"
  ],
  "requirements": [
    "RK-6.4-368"
  ],
  "notes": "One voice session carries a meeting (the stream's owner, mic). The integration writes the people present on the room's roster, a member each on the voice channel (Alice, Bob), and its ON_TRANSCRIPTION hook matches the voice the recognizer heard to Alice. The agent's first turn reads her words labelled with her name, not as an anonymous user's. Cited in part: the roster a conference keeps is conference/an-agent-reads-the-first-turn-of-a-conference-participant-under-their-name.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "channels": [
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Yes, we hear you."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "tx",
        "trigger": "on_transcription",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "participant_id": "alice"
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "mic"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "Can everyone hear me?",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "Can everyone hear me?"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "call": "add_member",
      "room_id": "r1",
      "channel_id": "phone",
      "participant_id": "alice",
      "display_name": "Alice"
    },
    {
      "call": "add_member",
      "room_id": "r1",
      "channel_id": "phone",
      "participant_id": "bob",
      "display_name": "Bob"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "mic",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$starts_with": "Alice: \"Can everyone hear me?\""
              }
            }
          ]
        }
      ]
    }
  }
}
