{
  "$schema": "../../scenario.schema.json",
  "id": "voice/without-a-bridge-no-frame-reaches-another-participant",
  "title": "A voice channel with no bridge transcribes a participant's speech and forwards none of its frames",
  "rules": [
    "§12.7.3"
  ],
  "requirements": [
    "RK-12.7.3-015"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "transcribed",
        "trigger": "on_transcription",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ],
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "hello there"
      ]
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AwQ="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "alice": [],
            "bob": []
          }
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "transcribed": [
        {
          "voice": {
            "participant_id": "alice",
            "text": "hello there"
          }
        }
      ]
    }
  }
}
