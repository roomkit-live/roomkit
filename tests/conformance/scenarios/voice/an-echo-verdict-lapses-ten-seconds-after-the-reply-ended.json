{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-echo-verdict-lapses-ten-seconds-after-the-reply-ended",
  "title": "Words taken for the reply's echo lose that verdict 10 s after the reply ended: the utterance's final, in the reply's words, is a turn",
  "rules": [
    "§12.3.13",
    "§12.2"
  ],
  "requirements": [
    "RK-12.3.13-031"
  ],
  "notes": "As voice/an-echo-verdict-outlives-the-reply-until-its-final, the final coming 10.1 s of the virtual clock after the playback ended: the verdict no longer holds, nothing plays, and the final is the user's turn.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "virtual_clock": true,
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gate": "playing",
      "aec": {},
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "Your table",
                "final": false
              },
              {
                "text": "your table for two"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table for two is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "clock.advance",
      "ms": 10100
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": []
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "your table for two"
          }
        }
      ]
    }
  }
}
