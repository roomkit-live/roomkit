{
  "$schema": "../../scenario.schema.json",
  "id": "voice/confirmed-speech-shorter-than-min-speech-ms-leaves-the-reply-playing",
  "title": "Under CONFIRMED, speech that ends before min_speech_ms cuts nothing",
  "rules": [
    "§12.3.13",
    "§12.6"
  ],
  "requirements": [
    "RK-12.3.13-010"
  ],
  "notes": "The speech ends at once; the reply is still playing when the strategy looks again, 50 ms after the onset (settle), and finds the speech did not sustain.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "playing"
      ],
      "interruption": {
        "strategy": "confirmed",
        "min_speech_ms": 50
      },
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "um"
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [],
      "stopped": []
    }
  }
}
