{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-final-after-a-pending-partial-that-is-no-backchannel-cuts-and-is-the-turn",
  "title": "When the last partial was left pending, the final is classified whole: one that is no backchannel cuts the reply and is the user's turn",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-057"
  ],
  "notes": "Only the branch where the final is no backchannel is shown, not a final that is one being discarded; \"past any minimum duration\" is not exercised (the speech is already past the default minimum).",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cutting"
          }
        ]
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      },
      {
        "name": "ack",
        "trigger": "on_backchannel",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "playing"
      ],
      "vad": [
        {
          "type": "speech_start"
        },
        null,
        {
          "type": "speech_end"
        }
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "No",
                "final": false
              },
              {
                "text": "No.",
                "gate": "judged"
              }
            ]
          }
        ]
      },
      "backchannel_decisions": [
        {
          "transcript": "No",
          "is_backchannel": false,
          "pending": true
        },
        {
          "transcript": "No.",
          "is_backchannel": false
        }
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "",
        ""
      ]
    },
    {
      "wait_for": "judged"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "open": "judged"
    },
    {
      "wait_for": "cutting"
    },
    {
      "open": "cutting"
    },
    {
      "wait_for": "cut"
    },
    {
      "open": "cut"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "backchannel_contexts": [
            {
              "transcript": "No",
              "is_final": false
            },
            {
              "transcript": "No.",
              "is_final": true
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ],
      "ack": []
    },
    "timeline": {
      "r1": {
        "$unordered": [
          {
            "metadata": {
              "interrupted": true
            }
          },
          {
            "content": {
              "body": "No."
            }
          }
        ]
      }
    }
  }
}
