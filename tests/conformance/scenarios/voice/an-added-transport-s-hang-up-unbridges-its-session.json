{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-added-transport-s-hang-up-unbridges-its-session",
  "title": "Once an added transport reports its client gone, that session is no longer bridged",
  "rules": [
    "§12.7.3"
  ],
  "requirements": [
    "RK-12.7.3-019"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "bridge": true
    },
    {
      "call": "voice.add_backend",
      "channel_id": "phone",
      "backend": "line",
      "session_ids": {
        "caller": "line-1"
      }
    },
    {
      "call": "voice.connect",
      "channel_id": "phone",
      "participant_id": "caller",
      "backend": "line"
    },
    {
      "call": "voice.join",
      "channel_id": "phone",
      "participant_id": "caller",
      "push": true
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.client_disconnected",
      "channel_id": "phone",
      "participant_id": "caller"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AwQ="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "alice": [],
            "caller": [
              "AQI="
            ]
          }
        }
      }
    }
  ],
  "expect": {}
}
