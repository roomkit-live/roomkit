{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-echo-verdict-ends-with-the-stream-that-heard-its-words",
  "title": "Words taken for the reply's echo lose that verdict when the recognizer's stream ends: the next stream's final, in the reply's words, is a turn",
  "rules": [
    "§12.3.13",
    "§12.2"
  ],
  "requirements": [
    "RK-12.3.13-031"
  ],
  "notes": "As voice/an-echo-verdict-outlives-the-reply-until-its-final, but the stream that heard the echo ends once the reply ended, with no final: its utterance ended with it. The next stream's final comes at once, well within the 10 s, nothing playing: it is the user's turn.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gate": "playing",
      "aec": {},
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "Your table",
                "final": false
              }
            ],
            "gate": "heard",
            "then": "end"
          },
          {
            "results": [
              {
                "text": "your table for two"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table for two is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "wait_for": "heard"
    },
    {
      "open": "heard"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": []
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "your table for two"
          }
        }
      ]
    }
  }
}
