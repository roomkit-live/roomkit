{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-pending-verdict-leaves-the-reply-playing-until-the-next-words",
  "title": "A pending verdict on a partial neither cuts nor fires ON_BACKCHANNEL: the next partial is judged",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-044"
  ],
  "notes": "Each partial comes on its own frame; the reply plays on through the pending verdict, past which the second partial is judged.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cutting"
          }
        ]
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      },
      {
        "name": "ack",
        "trigger": "on_backchannel",
        "execution": "async",
        "reactions": [
          {
            "gate": "acknowledged"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "playing"
      ],
      "vad": [
        {
          "type": "speech_start"
        },
        null,
        {
          "type": "speech_end"
        }
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "D",
                "final": false
              },
              {
                "text": "D'accord",
                "final": false
              }
            ]
          }
        ]
      },
      "backchannel_decisions": [
        {
          "transcript": "D",
          "is_backchannel": false,
          "pending": true
        },
        {
          "transcript": "D'accord",
          "is_backchannel": true
        }
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "",
        ""
      ]
    },
    {
      "wait_for": "acknowledged"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "backchannel_contexts": [
            {
              "transcript": "D",
              "is_final": false
            },
            {
              "transcript": "D'accord",
              "is_final": false
            }
          ]
        }
      }
    },
    {
      "open": "acknowledged"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "hooks": {
      "cut": [],
      "stopped": [],
      "ack": [
        {
          "voice": {
            "text": "D'accord"
          }
        }
      ]
    }
  }
}
