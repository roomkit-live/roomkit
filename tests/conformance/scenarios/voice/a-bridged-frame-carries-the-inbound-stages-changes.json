{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-bridged-frame-carries-the-inbound-stages-changes",
  "title": "A frame bridged from one caller to the other is the inbound pipeline's output: what the AEC, the AGC and the denoiser returned in turn",
  "rules": [
    "§12.7.1"
  ],
  "requirements": [
    "RK-12.7.1-006"
  ],
  "notes": "No contract, so no resampler in the bridged chain.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ],
      "bridge": true,
      "aec": {
        "output": "AwQ="
      },
      "agc": {
        "output": "BQY="
      },
      "denoiser": {
        "output": "Bwg="
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "alice": [],
            "bob": [
              "Bwg="
            ]
          }
        }
      }
    }
  ],
  "expect": {}
}
