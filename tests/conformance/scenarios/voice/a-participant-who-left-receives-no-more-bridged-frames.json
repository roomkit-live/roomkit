{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-participant-who-left-receives-no-more-bridged-frames",
  "title": "Once a bridged participant leaves, the frames fed after its leave reach only the participants still there",
  "rules": [
    "§12.7.3"
  ],
  "requirements": [
    "RK-12.7.3-010"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob",
        "carol"
      ],
      "bridge": true
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.leave",
      "channel_id": "phone",
      "participant_id": "carol"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AwQ="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "bob": [
              "AQI=",
              "AwQ="
            ],
            "carol": [
              "AQI="
            ]
          }
        }
      }
    }
  ],
  "expect": {}
}
