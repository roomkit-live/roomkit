{
  "$schema": "../../scenario.schema.json",
  "id": "voice/vad-reports-its-measured-level",
  "title": "VAD reports the level and speech classification it measured",
  "rules": [
    "§9.2"
  ],
  "requirements": [
    "RK-12.3.14-017",
    "RK-12.3.8-001",
    "RK-12.3.8-007",
    "RK-12.3.8-008",
    "RK-12.5-012",
    "RK-9.2-044"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "observer",
        "trigger": "on_vad_audio_level",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "vad": [
        {
          "type": "audio_level",
          "level_db": -14,
          "confidence": 0.9
        }
      ]
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "hooks": {
      "observer": [
        {
          "voice": {
            "participant_id": "alice",
            "level_db": -14,
            "is_speech": true
          }
        }
      ]
    }
  }
}
