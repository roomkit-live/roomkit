{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-recognizer-s-speech-start-fires-the-speech-start-hooks",
  "title": "A transcription result that signals a speech start the recognizer detected fires the speech-start hooks, with no VAD",
  "rules": [
    "§12.2",
    "§9.2"
  ],
  "requirements": [
    "RK-12.2-056"
  ],
  "notes": "Without a VAD the channel runs in continuous mode: only the recognizer's signal can tell it the speech began. The other members of the interface are read by the recognition scenarios (stt).",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "began",
        "trigger": "on_speech_start",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "",
                "final": false,
                "speech_start": true
              },
              {
                "text": "Hello there"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "",
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "began": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "Hello there"
          }
        }
      ]
    }
  }
}
