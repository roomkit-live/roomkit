{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-redacted-transcript-reaches-the-context-without-its-audio",
  "title": "The user turn holds the transcript as an ON_TRANSCRIPTION hook left it, and none of its audio once the hook changed it",
  "rules": [
    "§12.2.2",
    "§12.2",
    "§9.2"
  ],
  "requirements": [
    "RK-12.2.2-017",
    "RK-12.2.2-018",
    "RK-17.6-022"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "redact",
        "trigger": "on_transcription",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "text": "Book a [redacted]"
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "session_ids": {
        "alice": "s-alice"
      },
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "Book a table"
      ],
      "tts": {
        "context_level": "audio",
        "word_ms": 1
      },
      "tts_context": {
        "include_audio": true
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "First reply."
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "tts_contexts": [
            {
              "turns": [
                {
                  "role": "user",
                  "text": "Book a [redacted]",
                  "audio": null
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
