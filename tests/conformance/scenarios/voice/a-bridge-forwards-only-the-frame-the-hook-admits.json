{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-bridge-forwards-only-the-frame-the-hook-admits",
  "title": "A bridged participant receives only the frame admitted by the bridge hook",
  "rules": [
    "§9.2"
  ],
  "requirements": [
    "RK-9.2-059"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "filter",
        "trigger": "before_bridge_audio",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "block",
              "reason": "private"
            }
          },
          {
            "result": {
              "action": "allow"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ],
      "bridge": true
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AwQ="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "bob": [
              "AwQ="
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "filter": [
        {
          "voice": {
            "participant_id": "alice"
          }
        },
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
