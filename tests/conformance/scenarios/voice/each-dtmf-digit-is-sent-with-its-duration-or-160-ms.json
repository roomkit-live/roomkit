{
  "$schema": "../../scenario.schema.json",
  "id": "voice/each-dtmf-digit-is-sent-with-its-duration-or-160-ms",
  "title": "Digits across the DTMF set reach the transport, with the duration given or 160 ms",
  "rules": [
    "§12.3.6"
  ],
  "requirements": [
    "RK-12.3.6-010",
    "RK-12.3.6-011"
  ],
  "notes": "The transport declares dtmf_signaling. The bounds of the duration range, 1 and 10000 ms, are sent.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "capabilities": [
        "interruption",
        "barge_in",
        "dtmf_signaling"
      ]
    },
    {
      "call": "voice.send_dtmf",
      "channel_id": "phone",
      "participant_id": "alice",
      "digit": "1"
    },
    {
      "call": "voice.send_dtmf",
      "channel_id": "phone",
      "participant_id": "alice",
      "digit": "*",
      "duration_ms": 80
    },
    {
      "call": "voice.send_dtmf",
      "channel_id": "phone",
      "participant_id": "alice",
      "digit": "0",
      "duration_ms": 100
    },
    {
      "call": "voice.send_dtmf",
      "channel_id": "phone",
      "participant_id": "alice",
      "digit": "9",
      "duration_ms": 100
    },
    {
      "call": "voice.send_dtmf",
      "channel_id": "phone",
      "participant_id": "alice",
      "digit": "#",
      "duration_ms": 100
    },
    {
      "call": "voice.send_dtmf",
      "channel_id": "phone",
      "participant_id": "alice",
      "digit": "A",
      "duration_ms": 100
    },
    {
      "call": "voice.send_dtmf",
      "channel_id": "phone",
      "participant_id": "alice",
      "digit": "D",
      "duration_ms": 100
    },
    {
      "call": "voice.send_dtmf",
      "channel_id": "phone",
      "participant_id": "alice",
      "digit": "5",
      "duration_ms": 1
    },
    {
      "call": "voice.send_dtmf",
      "channel_id": "phone",
      "participant_id": "alice",
      "digit": "7",
      "duration_ms": 10000
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "dtmf_sent": {
            "alice": [
              {
                "digit": "1",
                "duration_ms": 160
              },
              {
                "digit": "*",
                "duration_ms": 80
              },
              {
                "digit": "0",
                "duration_ms": 100
              },
              {
                "digit": "9",
                "duration_ms": 100
              },
              {
                "digit": "#",
                "duration_ms": 100
              },
              {
                "digit": "A",
                "duration_ms": 100
              },
              {
                "digit": "D",
                "duration_ms": 100
              },
              {
                "digit": "5",
                "duration_ms": 1
              },
              {
                "digit": "7",
                "duration_ms": 10000
              }
            ]
          }
        }
      }
    }
  ]
}
