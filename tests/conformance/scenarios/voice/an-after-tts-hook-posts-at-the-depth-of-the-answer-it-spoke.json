{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-after-tts-hook-posts-at-the-depth-of-the-answer-it-spoke",
  "title": "An AFTER_TTS hook's body posts at least as deep as the answer the voice agent spoke",
  "rules": [
    "§8.3",
    "§12.2"
  ],
  "requirements": [
    "RK-8.3-046"
  ],
  "notes": "The question and the note reach the agent alone (visibility intelligence), so that the voice channel speaks the agent's answers only. The hook sends its note once, naming no depth, once the answer was spoken; the agent answers it, and that answer is spoken too. A SYNC AFTER_TTS hook is not shown.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "channels": [
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Your table is ready."
            },
            {
              "text": "Noted."
            }
          ]
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "spoken",
        "trigger": "after_tts",
        "execution": "async",
        "reactions": [
          {
            "do": [
              {
                "call": "send_event",
                "room_id": "r1",
                "channel_id": "src",
                "content": {
                  "type": "text",
                  "body": "spoken note"
                },
                "visibility": "intelligence"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ]
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "src",
      "participant_id": "bob",
      "content": {
        "type": "text",
        "body": "question"
      },
      "visibility": "intelligence",
      "chain_depth": 1
    },
    {
      "idle": true
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "question"
          },
          "chain_depth": 1
        },
        {
          "content": {
            "body": "Your table is ready."
          },
          "chain_depth": 2
        },
        {
          "content": {
            "body": "spoken note"
          },
          "chain_depth": 2
        },
        {
          "content": {
            "body": "Noted."
          },
          "chain_depth": 3
        }
      ]
    }
  }
}
