{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-echo-verdict-that-lapses-with-its-utterance-open-takes-its-words-with-it",
  "title": "An echo verdict that lapses 10 s after the playback ended, its utterance still open, takes the utterance's words with it: they decide nothing on the next reply",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-033"
  ],
  "notes": "Continuous mode, the pipeline's canceller ending the playback as soon as it was sent. The utterance's partial is the first reply's echo, and its stream never closes it. 10.5 s after that playback ended, a run of loud audio over the next reply finds no words: it waits transcript_wait_ms, as a run without words does, then cuts on its duration. Words left over would have cut it at once: they are no echo of the next reply. The timeline holds the reply the run cut, no turn of the user's.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "virtual_clock": true,
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "first",
        "second"
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "Your table",
                "final": false
              }
            ]
          }
        ]
      },
      "interruption": {
        "transcript_wait_ms": 1000
      },
      "aec": {}
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table for two is ready.",
      "background": true,
      "as": "ready"
    },
    {
      "wait_for": "first"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "open": "first"
    },
    {
      "await": "ready"
    },
    {
      "call": "clock.advance",
      "ms": 10500
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Anything else?",
      "background": true,
      "as": "else"
    },
    {
      "wait_for": "second"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ],
      "repeat": 5
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "cancel_audio": {
            "alice": 0
          }
        }
      }
    },
    {
      "call": "clock.advance",
      "ms": 1100
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "cancel_audio": {
            "alice": 1
          }
        }
      }
    },
    {
      "open": "second"
    },
    {
      "await": "else"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "Anything else?"
          }
        }
      ]
    }
  }
}
