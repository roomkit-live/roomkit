{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-new-voice-s-first-words-cut-the-reply-and-its-echo-final-does-not-undo-it",
  "title": "A new voice's first words cut the reply; its final, the reply's echo, is no turn and the cut stands",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-039",
    "RK-12.3.13-055"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "ack",
        "trigger": "on_backchannel",
        "execution": "async"
      },
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "the kitten",
                "final": false,
                "speech_start": true
              },
              {
                "text": "the kitten lamp or the living room lamp",
                "segments": [
                  {
                    "speaker": "B",
                    "text": "the kitten lamp or the living room lamp"
                  }
                ]
              }
            ]
          }
        ]
      },
      "playback_gate": "playing"
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "The kitchen lamp or the living room lamp?",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ],
      "ack": []
    },
    "timeline": {
      "r1": [
        {
          "metadata": {
            "interrupted": true
          }
        }
      ]
    }
  }
}
