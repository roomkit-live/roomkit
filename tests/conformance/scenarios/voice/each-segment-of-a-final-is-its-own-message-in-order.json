{
  "$schema": "../../scenario.schema.json",
  "id": "voice/each-segment-of-a-final-is-its-own-message-in-order",
  "title": "A diarizing final's segments end one utterance and reach the room as a message each",
  "rules": [
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2.3-026",
    "RK-12.2.3-027",
    "RK-12.2.3-030",
    "RK-12.2.3-034",
    "RK-12.2.3-040"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "end",
        "trigger": "on_speech_end",
        "execution": "async"
      },
      {
        "name": "tx",
        "trigger": "on_transcription",
        "execution": "sync"
      },
      {
        "name": "change",
        "trigger": "on_speaker_change",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "hello there",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "hello"
                  },
                  {
                    "speaker": "B",
                    "text": "there"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "hooks": {
      "end": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ],
      "tx": [
        {
          "voice": {
            "text": "hello",
            "speaker": "A",
            "speaker_epoch": 0,
            "sender_name": "Speaker A"
          }
        },
        {
          "voice": {
            "text": "there",
            "speaker": "B",
            "speaker_epoch": 0,
            "sender_name": "Speaker B"
          }
        }
      ],
      "change": [
        {
          "voice": {
            "speaker_id": "A",
            "speaker_epoch": 0,
            "is_new_speaker": true,
            "confidence": null,
            "source": "stt"
          }
        },
        {
          "voice": {
            "speaker_id": "B",
            "speaker_epoch": 0,
            "is_new_speaker": true,
            "confidence": null,
            "source": "stt"
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "hello"
          },
          "source": {
            "participant_id": "alice"
          },
          "metadata": {
            "speaker_label": "A",
            "speaker_epoch": 0,
            "sender_name": "Speaker A"
          }
        },
        {
          "content": {
            "body": "there"
          },
          "source": {
            "participant_id": "alice"
          },
          "metadata": {
            "speaker_label": "B",
            "speaker_epoch": 0,
            "sender_name": "Speaker B"
          }
        }
      ]
    }
  }
}
