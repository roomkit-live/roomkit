{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-lone-partial-word-starting-the-reply-s-first-word-cuts",
  "title": "A lone partial word that only starts the reply's first word is no echo and cuts the reply",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-028"
  ],
  "notes": "backchannels selects SEMANTIC, whose verdict waits for the words; under IMMEDIATE a VAD's speech start cuts before any word can tell the echo (RK-12.3.13-009).",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "partial",
        "trigger": "on_partial_transcription",
        "execution": "async"
      },
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gate": "playing",
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "partials": [
        "No"
      ],
      "transcripts": [
        "No"
      ],
      "backchannels": [
        false,
        false,
        false
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Not now, please hold.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "partial": [
        {
          "voice": {
            "participant_id": "alice",
            "text": "No"
          }
        }
      ],
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ],
      "stopped": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    },
    "timeline": {
      "r1": {
        "$unordered": [
          {
            "source": {
              "channel_id": "phone",
              "participant_id": {
                "$absent": true
              }
            },
            "metadata": {
              "interrupted": true,
              "played_ms": {
                "$present": true
              }
            }
          },
          {
            "content": {
              "type": "text",
              "body": "No"
            }
          }
        ]
      }
    }
  }
}
