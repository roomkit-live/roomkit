{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-bridge-hook-s-replaced-frame-is-the-one-forwarded",
  "title": "A frame a BEFORE_BRIDGE_AUDIO hook returns modified is forwarded in place of the one fed",
  "rules": [
    "§12.7.6"
  ],
  "requirements": [
    "RK-12.7.6-007"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "gain",
        "trigger": "before_bridge_audio",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "frame": {
                  "data": "BQY="
                }
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ],
      "bridge": true
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "alice": [],
            "bob": [
              "BQY="
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "gain": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
