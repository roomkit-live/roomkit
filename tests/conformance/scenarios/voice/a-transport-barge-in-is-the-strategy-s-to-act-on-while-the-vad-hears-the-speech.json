{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-transport-barge-in-is-the-strategy-s-to-act-on-while-the-vad-hears-the-speech",
  "title": "A transport barge-in during playback is judged by the strategy, here CONFIRMED, which cuts once it is confirmed, while the VAD processes the same audio",
  "rules": [
    "§12.6",
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.6-016"
  ],
  "notes": "The VAD hears no speech during playback (its first decision is null), so the cut is the transport's barge-in, acted on by CONFIRMED once its second look comes; the speech edges and the transcript then come from the VAD's processing, once the cut is done (ON_TTS_CANCELLED). The VAD hearing the same audio while the barge-in is still being judged (\"meanwhile\") is not shown: a speech start arriving while the confirmed barge-in runs its ON_BARGE_IN hooks loses the cut in Python (RMK-2124).",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "confirmed"
          }
        ]
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      },
      {
        "name": "began",
        "trigger": "on_speech_start",
        "execution": "async"
      },
      {
        "name": "ended",
        "trigger": "on_speech_end",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "playing"
      ],
      "interruption": {
        "strategy": "confirmed",
        "min_speech_ms": 1
      },
      "vad": [
        null,
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "Hold on"
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.barge_in",
      "channel_id": "phone",
      "participant_id": "alice"
    },
    {
      "wait_for": "confirmed"
    },
    {
      "open": "confirmed"
    },
    {
      "wait_for": "cut"
    },
    {
      "open": "cut"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI=",
        "AQI="
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ],
      "began": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ],
      "ended": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    },
    "hook_order": [
      "cut",
      "began",
      "ended"
    ],
    "timeline": {
      "r1": {
        "$unordered": [
          {
            "metadata": {
              "interrupted": true
            }
          },
          {
            "content": {
              "body": "Hold on"
            }
          }
        ]
      }
    }
  }
}
