{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-audio-tts-without-include-audio-receives-the-text-only",
  "title": "Without include_audio, a TTS at AUDIO receives the context at TEXT level, every audio null",
  "rules": [
    "§12.2.2",
    "§12.2"
  ],
  "requirements": [
    "RK-12.2.2-013",
    "RK-17.6-020"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "session_ids": {
        "alice": "s-alice"
      },
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "Book a table"
      ],
      "tts": {
        "context_level": "audio",
        "word_ms": 20
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "First reply."
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Second reply."
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "tts_contexts": [
            {
              "turns": [
                {
                  "role": "user",
                  "participant_id": "alice",
                  "text": "Book a table",
                  "audio": null
                }
              ]
            },
            {
              "turns": [
                {
                  "role": "user",
                  "participant_id": "alice",
                  "text": "Book a table",
                  "audio": null
                },
                {
                  "role": "assistant",
                  "text": "First reply.",
                  "audio": null
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
