{
  "$schema": "../../scenario.schema.json",
  "id": "voice/speech-held-for-the-detector-s-verdict-reaches-no-room-before-it",
  "title": "Speech held while the detector waits for its words reaches no room and fires no ON_TRANSCRIPTION before the verdict",
  "rules": [
    "§12.3.13",
    "§9.2"
  ],
  "requirements": [
    "RK-12.3.13-056"
  ],
  "notes": "The recognizer holds the speech's words at a gate until the speech has ended: the speech waits, held, for the verdict on those words, the detector consulted on them alone, and only then is it a turn.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cutting"
          }
        ]
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      },
      {
        "name": "heard",
        "trigger": "on_transcription",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "playing"
      ],
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "Stop please",
                "gate": "words"
              }
            ]
          }
        ]
      },
      "backchannel_decisions": [
        {
          "is_backchannel": false
        }
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "wait_for": "words"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "open": "words"
    },
    {
      "wait_for": "cutting"
    },
    {
      "open": "cutting"
    },
    {
      "wait_for": "cut"
    },
    {
      "open": "cut"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "backchannel_contexts": [
            {
              "transcript": "Stop please"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ],
      "heard": [
        {
          "voice": {
            "text": "Stop please"
          }
        }
      ]
    },
    "hook_order": [
      "cut",
      "heard"
    ]
  }
}
