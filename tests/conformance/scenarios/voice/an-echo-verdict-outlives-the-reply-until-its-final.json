{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-echo-verdict-outlives-the-reply-until-its-final",
  "title": "Words taken for the reply's echo while it played keep that verdict once it has ended: the utterance's final, still the reply's words, is no turn",
  "rules": [
    "§12.3.13",
    "§12.2"
  ],
  "requirements": [
    "RK-12.3.13-031"
  ],
  "notes": "The pipeline's canceller ends the playback as soon as it was sent; the final comes on the same stream once nothing plays, well within the 10 s the verdict may outlive the playback; that bound itself is not reached.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gate": "playing",
      "aec": {},
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "Your table",
                "final": false
              },
              {
                "text": "your table for two"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table for two is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": []
    },
    "timeline": {
      "r1": []
    }
  }
}
