{
  "$schema": "../../scenario.schema.json",
  "id": "voice/no-session-served-fires-no-after-tts",
  "title": "When every session's synthesis fails, each is reported as tts_error and AFTER_TTS does not fire",
  "rules": [
    "§12.2",
    "§8.2",
    "§9.2"
  ],
  "requirements": [
    "RK-12.2-025"
  ],
  "notes": "That the sessions play in parallel, and that each error is reported once its playback is released, are not shown.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "channels": [
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "spoken",
        "trigger": "after_tts",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ],
      "session_ids": {
        "alice": "s-alice",
        "bob": "s-bob"
      },
      "tts": {
        "fails": "the voice is unavailable"
      }
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "src",
      "content": {
        "type": "text",
        "body": "Your table is ready."
      }
    },
    {
      "idle": true
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "audio": {
            "alice": [],
            "bob": []
          }
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "spoken": []
    },
    "voice_events": {
      "r1": [
        {
          "$unordered": [
            {
              "event": "tts_error",
              "data": {
                "error": "the voice is unavailable",
                "session_id": "s-alice"
              }
            },
            {
              "event": "tts_error",
              "data": {
                "error": "the voice is unavailable",
                "session_id": "s-bob"
              }
            }
          ]
        }
      ]
    }
  }
}
