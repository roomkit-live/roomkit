{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-paused-session-s-speech-is-still-transcribed",
  "title": "A voice channel goes on as in ACTIVE with a session the integrator holds PAUSED: the participant's speech is still recognized and reaches the room",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-053"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "still on hold"
      ]
    },
    {
      "call": "voice.set_state",
      "channel_id": "phone",
      "participant_id": "alice",
      "state": "paused"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "still on hold"
          },
          "source": {
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
