{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-change-of-speaker-ends-the-pending-turn",
  "title": "A turn judged incomplete is not joined with the next speaker's words",
  "rules": [
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2.3-029"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "so the lamp please",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "so the"
                  },
                  {
                    "speaker": "B",
                    "text": "lamp please"
                  }
                ]
              }
            ]
          }
        ]
      },
      "turns": [
        false,
        false
      ],
      "turn_incomplete_wait_ms": 50
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "so the"
          },
          "metadata": {
            "speaker_label": "A"
          }
        },
        {
          "content": {
            "body": "lamp please"
          },
          "metadata": {
            "speaker_label": "B"
          }
        }
      ]
    }
  }
}
