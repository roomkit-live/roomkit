{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-reply-still-produced-holds-back-no-kept-stream-final",
  "title": "A kept stream's next final reaches the room while the reply to the previous one is held",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-064"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "channels": [
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "one"
            },
            "gate": "reply",
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "noted"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "agent"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_broadcast",
        "execution": "sync",
        "reactions": [
          {
            "when": {
              "text": "two"
            },
            "gate": "two-in"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "keeps_stream_across_turns": true,
        "streams": [
          {
            "results": [
              {
                "text": "one"
              },
              {
                "text": "two"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "reply"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "two-in"
    },
    {
      "open": "two-in"
    },
    {
      "open": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "one"
          }
        },
        {
          "content": {
            "body": "two"
          }
        },
        {
          "content": {
            "body": "noted"
          }
        }
      ]
    }
  }
}
