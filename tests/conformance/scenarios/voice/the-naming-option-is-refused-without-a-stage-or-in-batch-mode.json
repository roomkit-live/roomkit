{
  "$schema": "../../scenario.schema.json",
  "id": "voice/the-naming-option-is-refused-without-a-stage-or-in-batch-mode",
  "title": "Naming speakers from the diarization stage is refused without a stage, and in batch mode",
  "rules": [
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2.3-043"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "hi"
      ],
      "pipeline_speakers": true,
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "voice.open",
      "channel_id": "batch",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {},
      "batch_mode": true,
      "pipeline_speakers": true,
      "speakers": [
        {
          "speaker_id": "A",
          "confidence": 0.9,
          "is_new_speaker": false
        }
      ],
      "expect": {
        "error": "invalid_argument"
      }
    }
  ],
  "expect": {}
}
