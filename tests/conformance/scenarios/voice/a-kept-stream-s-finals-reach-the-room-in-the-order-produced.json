{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-kept-stream-s-finals-reach-the-room-in-the-order-produced",
  "title": "A kept stream's second final waits for the first one's held transcription hook",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-064"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "tx",
        "trigger": "on_transcription",
        "execution": "sync",
        "reactions": [
          {
            "gate": "held"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "keeps_stream_across_turns": true,
        "streams": [
          {
            "results": [
              {
                "text": "one"
              },
              {
                "text": "two"
              }
            ],
            "then": "end",
            "gate": "given"
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "held"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "given"
    },
    {
      "open": "held"
    },
    {
      "open": "given"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "one"
          }
        },
        {
          "content": {
            "body": "two"
          }
        }
      ]
    }
  }
}
