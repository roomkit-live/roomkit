{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-language-chosen-mid-session-ends-a-diarizing-stream",
  "title": "A language chosen during a diarizing stream ends it, and the next stream opens with it",
  "rules": [
    "§12.2",
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2-061",
    "RK-12.2-063",
    "RK-12.2.3-021"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "supports_language_override": true,
        "streams": [
          {
            "results": [
              {
                "text": "one",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "one"
                  }
                ]
              }
            ]
          },
          {
            "results": [
              {
                "text": "zwei",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "zwei"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.set_stt_language",
      "channel_id": "phone",
      "participant_id": "alice",
      "language": "de"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "stt_streams": [
            {
              "language": null
            },
            {
              "language": "de"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "one"
          }
        },
        {
          "content": {
            "body": "zwei"
          }
        }
      ]
    }
  }
}
