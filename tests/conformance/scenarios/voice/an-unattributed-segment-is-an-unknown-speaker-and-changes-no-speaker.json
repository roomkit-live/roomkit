{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-unattributed-segment-is-an-unknown-speaker-and-changes-no-speaker",
  "title": "A segment nobody was attributed carries no label, reads as an unknown speaker and fires no change",
  "rules": [
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2.3-036",
    "RK-12.2.3-038"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "change",
        "trigger": "on_speaker_change",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "one two three",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "one"
                  },
                  {
                    "speaker": null,
                    "text": "two"
                  },
                  {
                    "speaker": "A",
                    "text": "three"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "hooks": {
      "change": [
        {
          "voice": {
            "speaker_id": "A",
            "source": "stt"
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "one"
          },
          "metadata": {
            "speaker_label": "A"
          }
        },
        {
          "content": {
            "body": "two"
          },
          "source": {
            "participant_id": "alice"
          },
          "metadata": {
            "speaker_label": {
              "$absent": true
            },
            "sender_name": "Unknown speaker"
          }
        },
        {
          "content": {
            "body": "three"
          },
          "metadata": {
            "speaker_label": "A"
          }
        }
      ]
    }
  }
}
