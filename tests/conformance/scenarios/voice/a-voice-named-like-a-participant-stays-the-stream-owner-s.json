{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-voice-named-like-a-participant-stays-the-stream-owner-s",
  "title": "A voice a hook names like a participant, without matching it, stays the stream owner's",
  "rules": [
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2.3-032"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "tx",
        "trigger": "on_transcription",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "sender_name": "bob"
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "hello",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "hello"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "call": "add_member",
      "room_id": "r1",
      "channel_id": "phone",
      "participant_id": "bob"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "hello"
          },
          "source": {
            "participant_id": "alice"
          },
          "metadata": {
            "speaker_label": "A",
            "sender_name": "bob"
          }
        }
      ]
    }
  }
}
