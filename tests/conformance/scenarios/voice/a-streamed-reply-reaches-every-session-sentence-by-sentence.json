{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-streamed-reply-reaches-every-session-sentence-by-sentence",
  "title": "A streamed reply to a channel with two sessions gives each session every sentence",
  "rules": [
    "§12.2 step 12s"
  ],
  "requirements": [
    "RK-12.2-030"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ]
    },
    {
      "call": "voice.stream",
      "channel_id": "phone",
      "chunks": [
        "Your table by the window is ready now. ",
        "Please follow the host to your seats."
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "synthesized": {
            "$unordered": [
              "Your table by the window is ready now.",
              "Your table by the window is ready now.",
              "Please follow the host to your seats.",
              "Please follow the host to your seats."
            ]
          }
        }
      }
    }
  ]
}
