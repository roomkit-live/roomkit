{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-transcription-hook-can-pin-the-language-a-stream-reported",
  "title": "A transcription hook pins the session to the language its stream reported",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-066"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "pin",
        "trigger": "on_transcription",
        "execution": "sync",
        "reactions": [
          {
            "do": [
              {
                "call": "voice.set_stt_language",
                "channel_id": "phone",
                "participant_id": "alice",
                "language": "es"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_language_override": true,
        "streams": [
          {
            "results": [
              {
                "text": "hola",
                "language": "es"
              }
            ]
          },
          {
            "results": [
              {
                "text": "gracias"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "stt_streams": [
            {
              "language": null
            },
            {
              "language": "es"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "pin": [
        {
          "voice": {
            "text": "hola",
            "language": "es"
          }
        },
        {
          "voice": {
            "text": "gracias"
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "hola"
          }
        },
        {
          "content": {
            "body": "gracias"
          }
        }
      ]
    }
  }
}
