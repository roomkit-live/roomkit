{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-kept-stream-carries-turn-after-turn-until-the-provider-ends-it",
  "title": "A stream kept across turns gives each turn's final until its provider ends it",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-063"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "keeps_stream_across_turns": true,
        "streams": [
          {
            "results": [
              {
                "text": "one"
              },
              {
                "text": "two"
              }
            ],
            "then": "end"
          },
          {
            "results": [
              {
                "text": "three"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "stt_streams": [
            {
              "language": null
            },
            {
              "language": null
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "one"
          }
        },
        {
          "content": {
            "body": "two"
          }
        },
        {
          "content": {
            "body": "three"
          }
        }
      ]
    }
  }
}
