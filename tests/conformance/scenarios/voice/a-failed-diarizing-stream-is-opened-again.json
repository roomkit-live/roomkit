{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-failed-diarizing-stream-is-opened-again",
  "title": "A diarizing stream that fails is replaced by a new one, whose labels start a new epoch",
  "rules": [
    "§12.2",
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2-063",
    "RK-12.2.3-021"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "one",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "one"
                  }
                ]
              },
              {
                "text": "two",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "two"
                  }
                ]
              }
            ],
            "then": "fail"
          },
          {
            "results": [
              {
                "text": "three",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "three"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "stt_streams": [
            {
              "language": null
            },
            {
              "language": null
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "one"
          },
          "metadata": {
            "speaker_label": "A",
            "speaker_epoch": 0
          }
        },
        {
          "content": {
            "body": "two"
          },
          "metadata": {
            "speaker_label": "A",
            "speaker_epoch": 0
          }
        },
        {
          "content": {
            "body": "three"
          },
          "metadata": {
            "speaker_label": "A",
            "speaker_epoch": 1
          }
        }
      ]
    }
  }
}
