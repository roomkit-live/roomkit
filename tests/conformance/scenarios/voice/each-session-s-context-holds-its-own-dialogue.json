{
  "$schema": "../../scenario.schema.json",
  "id": "voice/each-session-s-context-holds-its-own-dialogue",
  "title": "A context holds the dialogue of its session only: what one participant said and heard never reaches another session's",
  "rules": [
    "§12.2.2",
    "§12.2"
  ],
  "requirements": [
    "RK-12.2.2-015"
  ],
  "notes": "Sessions of one channel are shown apart; another channel of the room is not shown.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice",
        "bob"
      ],
      "session_ids": {
        "alice": "s-alice",
        "bob": "s-bob"
      },
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "Book a table"
      ],
      "tts": {
        "context_level": "text",
        "word_ms": 20
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "For alice."
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "bob",
      "text": "For bob."
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "bob",
      "text": "Again for bob."
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "tts_contexts": [
            {
              "context_id": "s-alice",
              "turns": [
                {
                  "role": "user",
                  "participant_id": "alice",
                  "text": "Book a table"
                }
              ]
            },
            {
              "context_id": "s-bob",
              "turns": []
            },
            {
              "context_id": "s-bob",
              "turns": [
                {
                  "role": "assistant",
                  "text": "For bob."
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
