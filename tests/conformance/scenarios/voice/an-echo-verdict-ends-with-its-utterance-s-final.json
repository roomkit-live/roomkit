{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-echo-verdict-ends-with-its-utterance-s-final",
  "title": "An echo verdict ends with its utterance's final: on a stream kept across turns, the next utterance, in the reply's words, is a turn",
  "rules": [
    "§12.3.13",
    "§12.2"
  ],
  "requirements": [
    "RK-12.3.13-031"
  ],
  "notes": "As voice/an-echo-verdict-outlives-the-reply-until-its-final, on a stream kept across turns: the echo's final, once the reply ended, is no turn, and ends the verdict. The next final on the same stream, the same words, nothing playing and well within the 10 s, is the user's turn.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gate": "playing",
      "aec": {},
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "Your table",
                "final": false
              },
              {
                "text": "your table for two"
              },
              {
                "text": "your table for two"
              }
            ]
          }
        ],
        "keeps_stream_across_turns": true
      }
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table for two is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": []
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "your table for two"
          }
        }
      ]
    }
  }
}
