{
  "$schema": "../../scenario.schema.json",
  "id": "voice/synthesis-reports-the-text-after-it-is-spoken",
  "title": "A completed synthesis reports the text it spoke",
  "rules": [
    "§9.2"
  ],
  "requirements": [
    "RK-9.2-039"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "spoken",
        "trigger": "after_tts",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Hello there"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "synthesized": [
            "Hello there"
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "spoken": [
        {
          "voice": {
            "text": "Hello there"
          }
        }
      ]
    }
  }
}
