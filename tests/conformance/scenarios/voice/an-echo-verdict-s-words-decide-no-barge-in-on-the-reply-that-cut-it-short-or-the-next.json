{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-echo-verdict-s-words-decide-no-barge-in-on-the-reply-that-cut-it-short-or-the-next",
  "title": "While an echo verdict holds, the utterance's words decide no barge-in on the reply that cut the echoed one short, nor on the reply after it",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-032"
  ],
  "notes": "Continuous mode, the pipeline's canceller ending each playback as soon as it was sent. The utterance's partial is the first reply's echo, and its stream never closes it. A say cuts that reply short (the one cancel_audio counted); runs of loud audio over that say's reply, then over the next one, last past transcript_wait_ms and cut neither. The timeline holds the reply cut short, no turn of the user's.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "virtual_clock": true,
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "first",
        "second",
        "third"
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "Your table",
                "final": false
              }
            ]
          }
        ]
      },
      "interruption": {
        "transcript_wait_ms": 1000
      },
      "aec": {}
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table for two is ready.",
      "background": true,
      "as": "ready"
    },
    {
      "wait_for": "first"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Anything else?",
      "background": true,
      "as": "else"
    },
    {
      "wait_for": "second"
    },
    {
      "open": "first"
    },
    {
      "await": "ready"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ],
      "repeat": 5
    },
    {
      "call": "clock.advance",
      "ms": 1100
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "cancel_audio": {
            "alice": 1
          }
        }
      }
    },
    {
      "open": "second"
    },
    {
      "await": "else"
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Is that all?",
      "background": true,
      "as": "all"
    },
    {
      "wait_for": "third"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ],
      "repeat": 5
    },
    {
      "call": "clock.advance",
      "ms": 1100
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "cancel_audio": {
            "alice": 1
          }
        }
      }
    },
    {
      "open": "third"
    },
    {
      "await": "all"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": []
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "Your table for two is ready."
          }
        }
      ]
    }
  }
}
