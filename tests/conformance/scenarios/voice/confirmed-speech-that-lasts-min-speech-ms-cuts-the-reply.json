{
  "$schema": "../../scenario.schema.json",
  "id": "voice/confirmed-speech-that-lasts-min-speech-ms-cuts-the-reply",
  "title": "Under CONFIRMED, speech still going on once min_speech_ms has passed cuts the reply",
  "rules": [
    "§12.3.13",
    "§12.6"
  ],
  "requirements": [
    "RK-12.3.13-010"
  ],
  "notes": "The speech starts and never ends: it is sustained when its 1 ms minimum is looked at again.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "confirmed"
          }
        ]
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "playing"
      ],
      "interruption": {
        "strategy": "confirmed",
        "min_speech_ms": 1
      },
      "vad": [
        {
          "type": "speech_start"
        }
      ],
      "transcripts": [
        "Wait"
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "wait_for": "confirmed"
    },
    {
      "open": "confirmed"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ],
      "stopped": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
