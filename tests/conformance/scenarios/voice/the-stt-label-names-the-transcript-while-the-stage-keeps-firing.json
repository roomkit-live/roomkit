{
  "$schema": "../../scenario.schema.json",
  "id": "voice/the-stt-label-names-the-transcript-while-the-stage-keeps-firing",
  "title": "With a diarizing recognizer and a diarization stage, the label is the recognizer's",
  "rules": [
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2.3-009"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "change",
        "trigger": "on_speaker_change",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "hello",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "hello"
                  }
                ]
              }
            ]
          }
        ]
      },
      "speakers": [
        {
          "speaker_id": "x",
          "confidence": 0.9,
          "is_new_speaker": true
        }
      ]
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "hooks": {
      "change": {
        "$unordered": [
          {
            "voice": {
              "speaker_id": "x",
              "source": "pipeline"
            }
          },
          {
            "voice": {
              "speaker_id": "A",
              "source": "stt"
            }
          }
        ]
      }
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "hello"
          },
          "metadata": {
            "speaker_label": "A"
          }
        }
      ]
    }
  }
}
