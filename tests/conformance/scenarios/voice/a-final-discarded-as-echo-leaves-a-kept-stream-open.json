{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-final-discarded-as-echo-leaves-a-kept-stream-open",
  "title": "A final the channel discards as the echo of its own reply does not end a stream kept across turns: the next turn's final comes on the same stream",
  "rules": [
    "§12.2.3",
    "§12.2",
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.2.3-023"
  ],
  "notes": "The echo's final is no turn (voice/an-echo-verdict-outlives-the-reply-until-its-final); the recognizer is opened once.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "playing"
      ],
      "stt": {
        "keeps_stream_across_turns": true,
        "streams": [
          {
            "results": [
              {
                "text": "Your table",
                "final": false
              },
              {
                "text": "your table for two"
              },
              {
                "text": "",
                "final": false,
                "speech_start": true
              },
              {
                "text": "The terrace please"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table for two is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "stt_streams": [
            {
              "language": null
            }
          ]
        }
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "",
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "stt_streams": [
            {
              "language": null
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "The terrace please"
          }
        }
      ]
    }
  }
}
