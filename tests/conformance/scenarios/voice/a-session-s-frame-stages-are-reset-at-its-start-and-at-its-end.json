{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-session-s-frame-stages-are-reset-at-its-start-and-at-its-end",
  "title": "Each frame stage is reset under the session's id when the session becomes active, before its first frame, and again when it ends; the recorder and the turn detector are not",
  "rules": [
    "§12.3.1",
    "§12.3.14"
  ],
  "requirements": [
    "RK-12.3.1-023",
    "RK-12.3.1-024",
    "RK-12.3.1-026",
    "RK-12.3.14-005",
    "RK-12.3.14-008",
    "RK-12.3.14-019"
  ],
  "notes": "The order in which the stages are reset is left open. The turn detector's and the recorder's own reset() is never called by the session's lifecycle; the backchannel detector is not configured here.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "session_ids": {
        "alice": "s-alice"
      },
      "aec": {},
      "agc": {},
      "denoiser": {},
      "postprocessors": [
        {
          "name": "eq"
        }
      ],
      "recorder": {},
      "tones": [],
      "turns": [
        true
      ],
      "vad": [
        null
      ]
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "calls": [
        "reset"
      ],
      "expect": {
        "result": {
          "stages": {
            "$unordered": [
              {
                "stage": "aec",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "agc",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "denoiser",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "eq",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "vad",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "dtmf",
                "call": "reset",
                "stream": "s-alice"
              }
            ]
          }
        }
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "calls": [
        "reset"
      ],
      "expect": {
        "result": {
          "stages": {
            "$unordered": [
              {
                "stage": "aec",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "agc",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "denoiser",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "eq",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "vad",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "dtmf",
                "call": "reset",
                "stream": "s-alice"
              }
            ]
          }
        }
      }
    },
    {
      "call": "voice.leave",
      "channel_id": "phone",
      "participant_id": "alice"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "calls": [
        "reset"
      ],
      "expect": {
        "result": {
          "stages": {
            "$unordered": [
              {
                "stage": "aec",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "aec",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "agc",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "agc",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "denoiser",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "denoiser",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "eq",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "eq",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "vad",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "vad",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "dtmf",
                "call": "reset",
                "stream": "s-alice"
              },
              {
                "stage": "dtmf",
                "call": "reset",
                "stream": "s-alice"
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {}
}
