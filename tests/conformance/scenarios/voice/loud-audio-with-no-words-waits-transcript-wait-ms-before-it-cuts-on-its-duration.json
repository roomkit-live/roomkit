{
  "$schema": "../../scenario.schema.json",
  "id": "voice/loud-audio-with-no-words-waits-transcript-wait-ms-before-it-cuts-on-its-duration",
  "title": "While the echo guard is open, a run of loud audio with no words yet cuts the reply on its duration only once transcript_wait_ms passed",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-035"
  ],
  "notes": "Continuous mode, IMMEDIATE: five loud frames start the run; 900 ms into it the run still waits, the guard open (the session has played less than echo_guard_ms); by 1100 ms its duration cuts the reply.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "virtual_clock": true,
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "playing"
      ],
      "stt": {
        "streams": [
          {}
        ]
      },
      "interruption": {
        "transcript_wait_ms": 1000
      }
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ],
      "repeat": 5
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "clock.advance",
      "ms": 900
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "cancel_audio": {
            "alice": 0
          }
        }
      }
    },
    {
      "call": "clock.advance",
      "ms": 200
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "cancel_audio": {
            "alice": 1
          }
        }
      }
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
