{
  "$schema": "../../scenario.schema.json",
  "id": "voice/vad-reports-a-silence",
  "title": "VAD reports how long the silence lasted",
  "rules": [
    "§9.2"
  ],
  "requirements": [
    "RK-12.3.8-001",
    "RK-12.3.8-007",
    "RK-12.3.8-008",
    "RK-9.2-043"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "observer",
        "trigger": "on_vad_silence",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "vad": [
        {
          "type": "silence",
          "duration_ms": 480
        }
      ]
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "hooks": {
      "observer": [
        {
          "voice": {
            "participant_id": "alice",
            "silence_duration_ms": 480
          }
        }
      ]
    }
  }
}
