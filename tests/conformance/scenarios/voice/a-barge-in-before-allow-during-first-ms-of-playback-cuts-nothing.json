{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-barge-in-before-allow-during-first-ms-of-playback-cuts-nothing",
  "title": "A transport barge-in before allow_during_first_ms of the reply has played cuts nothing",
  "rules": [
    "§12.3.13",
    "§12.6"
  ],
  "requirements": [
    "RK-12.6-013"
  ],
  "notes": "voice/a-transport-barge-in-cancels-active-playback shows the same barge-in cutting with allow_during_first_ms 0.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "playing"
      ],
      "interruption": {
        "allow_during_first_ms": 60000
      }
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.barge_in",
      "channel_id": "phone",
      "participant_id": "alice"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [],
      "stopped": []
    }
  }
}
