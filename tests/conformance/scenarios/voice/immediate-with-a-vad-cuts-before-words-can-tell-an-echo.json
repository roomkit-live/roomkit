{
  "$schema": "../../scenario.schema.json",
  "id": "voice/immediate-with-a-vad-cuts-before-words-can-tell-an-echo",
  "title": "Under IMMEDIATE with a VAD, speech start cuts the reply before any word, and its words are a turn",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-009",
    "RK-12.3.13-026"
  ],
  "notes": "voice.open without backchannels runs IMMEDIATE, and its recognizer gives its words only at the speech's end: the cut is heard after the speech-start frame alone, while the echo guard is open (the session has played nothing), and the echo's words, said over the reply, are the turn.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut-heard"
          }
        ]
      },
      {
        "name": "stopped",
        "trigger": "on_tts_cancelled",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gate": "playing",
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "your table for two"
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table for two is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "wait_for": "cut-heard"
    },
    {
      "open": "cut-heard"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ],
      "stopped": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    },
    "timeline": {
      "r1": {
        "$unordered": [
          {
            "source": {
              "channel_id": "phone",
              "participant_id": {
                "$absent": true
              }
            },
            "metadata": {
              "interrupted": true,
              "played_ms": {
                "$present": true
              }
            }
          },
          {
            "content": {
              "type": "text",
              "body": "your table for two"
            }
          }
        ]
      }
    }
  }
}
