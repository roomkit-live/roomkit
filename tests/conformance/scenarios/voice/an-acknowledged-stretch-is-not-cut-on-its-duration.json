{
  "$schema": "../../scenario.schema.json",
  "id": "voice/an-acknowledged-stretch-is-not-cut-on-its-duration",
  "title": "A loud stretch taken for a backchannel during a reply runs on without cutting it",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-042"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "ack",
        "trigger": "on_backchannel",
        "execution": "async"
      },
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "mm-hmm",
                "final": false
              }
            ]
          }
        ]
      },
      "playback_gate": "playing",
      "backchannels": [
        true
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "The kitchen lamp or the living room lamp?",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ],
      "repeat": 10
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "hooks": {
      "ack": [
        {
          "voice": {
            "text": "mm-hmm"
          }
        }
      ],
      "cut": []
    },
    "timeline": {
      "r1": []
    }
  }
}
