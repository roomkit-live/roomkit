{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-voice-heard-alone-is-nobody-on-the-next-stream",
  "title": "A voice heard alone on a closed kept stream is not known on the next one",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-040"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "supports_diarization": true,
        "streams": [
          {
            "results": [
              {
                "text": "hello",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "hello"
                  }
                ]
              }
            ],
            "then": "end"
          },
          {
            "results": [
              {
                "text": "",
                "speech_start": true
              },
              {
                "text": "the kitchen lamp or the living room lamp",
                "segments": [
                  {
                    "speaker": "A",
                    "text": "the kitchen lamp or the living room lamp"
                  }
                ]
              }
            ]
          }
        ]
      },
      "playback_gate": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "The kitchen lamp or the living room lamp?",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "stt_streams": [
            {
              "language": null
            },
            {
              "language": null
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "hello"
          },
          "metadata": {
            "speaker_label": "A"
          }
        }
      ]
    }
  }
}
