{
  "$schema": "../../scenario.schema.json",
  "id": "voice/frames-between-two-streams-reach-the-next-one",
  "title": "Audio fed while one stream ends and the next is not yet open reaches the next stream",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-067"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "one"
              }
            ],
            "then": "end",
            "gate": "reconnect"
          },
          {
            "results": [
              {
                "text": "two"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "reconnect"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        ""
      ],
      "repeat": 3
    },
    {
      "open": "reconnect"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "stt_streams": [
            {
              "language": null
            },
            {
              "sound_ms": 300
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "one"
          }
        },
        {
          "content": {
            "body": "two"
          }
        }
      ]
    }
  }
}
