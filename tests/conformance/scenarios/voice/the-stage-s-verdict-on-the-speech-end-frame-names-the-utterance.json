{
  "$schema": "../../scenario.schema.json",
  "id": "voice/the-stage-s-verdict-on-the-speech-end-frame-names-the-utterance",
  "title": "A stage that names the voice only on the speech-end frame still names the utterance",
  "rules": [
    "§12.2.3"
  ],
  "requirements": [
    "RK-12.2.3-045"
  ],
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "transcripts": [
        "hello"
      ],
      "pipeline_speakers": true,
      "speakers": [
        {
          "speaker_id": "A",
          "confidence": 0.9,
          "is_new_speaker": false
        },
        {
          "speaker_id": "B",
          "confidence": 0.9,
          "is_new_speaker": false
        }
      ]
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI=",
        ""
      ]
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "hello"
          },
          "metadata": {
            "speaker_label": "B"
          }
        }
      ]
    }
  }
}
