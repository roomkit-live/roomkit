{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-transport-without-dtmf-signalling-refuses-a-sent-digit",
  "title": "A digit sent through a transport that does not declare DTMF_SIGNALING is refused, not dropped",
  "rules": [
    "§12.3.6"
  ],
  "requirements": [
    "RK-12.3.6-012"
  ],
  "notes": "The transport declares interruption and barge_in only and keeps the base interface's send_dtmf; the refusal reaches the caller through the channel.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ]
    },
    {
      "call": "voice.send_dtmf",
      "channel_id": "phone",
      "participant_id": "alice",
      "digit": "1",
      "expect": {
        "error": {
          "name": "not_supported"
        }
      }
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "dtmf_sent": {
            "alice": []
          }
        }
      }
    }
  ]
}
