{
  "$schema": "../../scenario.schema.json",
  "id": "author-images/a-text-held-on-a-first-try-refuses-no-image-when-its-retry-is-refused",
  "title": "When a turn under a response schema, its first request carrying an author image, has its provider stream text it holds, then refuse the request as worth another try, and the try is refused before anything, the image is not refused: the first try showed it was taken",
  "rules": [
    "§6.4",
    "§6.7"
  ],
  "notes": "Python: channels/_ai_stream_round.py keeps a round's `received` across its tries and its fallback (note_received), which _forget_sent_images reads (RFC §6.4).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "vision": true,
          "response_schema": true,
          "rounds": [
            {
              "text": "{\"a\": \"x",
              "refuses": {
                "status": 503,
                "message": "overloaded",
                "retryable": true
              }
            },
            {
              "refuses": {
                "status": 400,
                "message": "bad request"
              }
            },
            {
              "text": "{\"a\": \"x\"}"
            }
          ]
        },
        "response_schema": {
          "type": "object",
          "properties": {
            "a": {
              "type": "string"
            }
          },
          "required": [
            "a"
          ],
          "additionalProperties": false
        },
        "retry_policy": {
          "max_retries": 1,
          "base_delay_ms": 1
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "composite",
        "parts": [
          {
            "type": "text",
            "body": "my lamp"
          },
          {
            "type": "media",
            "url": "data:image/png;base64,AQIDBA==",
            "mime_type": "image/png",
            "filename": "lamp.png"
          }
        ]
      },
      "metadata": {}
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "and now?"
      },
      "metadata": {}
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "my lamp",
              "parts": [
                {
                  "text": "my lamp"
                },
                {
                  "image": "data:image/png;base64,AQIDBA==",
                  "mime_type": "image/png"
                }
              ]
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "my lamp",
              "parts": [
                {
                  "text": "my lamp"
                },
                {
                  "image": "data:image/png;base64,AQIDBA==",
                  "mime_type": "image/png"
                }
              ]
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "my lamp",
              "parts": [
                {
                  "text": "my lamp"
                },
                {
                  "image": "data:image/png;base64,AQIDBA==",
                  "mime_type": "image/png"
                }
              ]
            },
            {
              "role": "user",
              "text": "and now?",
              "parts": {
                "$absent": true
              }
            }
          ]
        }
      ]
    }
  }
}
