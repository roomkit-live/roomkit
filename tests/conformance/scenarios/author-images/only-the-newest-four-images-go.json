{
  "$schema": "../../scenario.schema.json",
  "id": "author-images/only-the-newest-four-images-go",
  "title": "A turn sends the newest four author images as images, its history and its input counted together; an older one reads as an earlier image not shown",
  "rules": [
    "§6.4"
  ],
  "notes": "Python's DEFAULT_MAX_AUTHOR_IMAGES = 4 and _decide, which walks the events newest first.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "vision": true,
          "rounds": [
            {
              "text": "Seen 0."
            },
            {
              "text": "Seen 1."
            },
            {
              "text": "Seen 2."
            },
            {
              "text": "Seen 3."
            },
            {
              "text": "Seen 4."
            },
            {
              "text": "Seen 5."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "media",
          "url": "https://cdn.example.com/p0.png",
          "mime_type": "image/png",
          "filename": "p0.png"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "media",
          "url": "https://cdn.example.com/p1.png",
          "mime_type": "image/png",
          "filename": "p1.png"
        }
      },
