{
  "$schema": "../../scenario.schema.json",
  "id": "author-images/a-context-overflow-nothing-can-relieve-refuses-the-images",
  "title": "When a turn's first request, carrying an author image, is refused by its provider as a context too long for the model, and the channel has nothing to compact, the image reads in the room's later turns as refused by the provider",
  "rules": [
    "§6.4"
  ],
  "notes": "Python's _generate_stream_with_retry compacts and replays once on a context overflow; a context of four messages or fewer cannot be compacted, the compaction's own error (not retryable, of no status) ends the turn, and RefusedImages marks the images the request sent.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "vision": true,
          "rounds": [
            {
              "refuses": {
                "status": 400,
                "message": "maximum context length exceeded",
                "context_overflow": true
              }
            },
            {
              "text": "Seen 1."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "composite",
        "parts": [
          {
            "type": "text",
            "body": "my lamp"
          },
          {
            "type": "media",
            "url": "data:image/png;base64,AQIDBA==",
            "mime_type": "image/png",
            "filename": "lamp.png"
          }
        ]
      },
      "metadata": {}
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "and now?"
      },
      "metadata": {}
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "my lamp",
              "parts": [
                {
                  "text": "my lamp"
                },
                {
                  "image": "data:image/png;base64,AQIDBA==",
                  "mime_type": "image/png"
                }
              ]
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "my lamp[Image refused by the model's provider: “lamp.png”]",
              "parts": [
                {
                  "text": "my lamp"
                },
                {
                  "text": "[Image refused by the model's provider: “lamp.png”]"
                }
              ]
            },
            {
              "role": "user",
              "text": "and now?",
              "parts": {
                "$absent": true
              }
            }
          ]
        }
      ]
    }
  }
}
