{
  "$schema": "../../scenario.schema.json",
  "id": "author-images/a-describer-that-says-nothing-leaves-the-event-out",
  "title": "A describer that says nothing of an event leaves an empty text out of the turn's transcript, and a captionless media to its label",
  "rules": [
    "§6.4",
    "§6.6"
  ],
  "notes": "Python's _transcript_content: the describer answering None, an empty extraction omits the event, unless it is a lone media, which reads as its label (RFC §6.6).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Seen 0."
            },
            {
              "text": "Seen 1."
            },
            {
              "text": "Seen 2."
            }
          ]
        },
        "describe_empty_event": {
          "says": null
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "media",
          "url": "https://cdn.example.com/contract.pdf",
          "mime_type": "application/pdf",
          "filename": "contract.pdf"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": ""
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "[Media: contract.pdf]",
              "parts": {
                "$absent": true
              }
            },
            {
              "role": "assistant",
              "text": "Seen 0."
            },
            {
              "role": "assistant",
              "text": "Seen 1."
            },
            {
              "role": "user",
              "text": "hello",
              "parts": {
                "$absent": true
              }
            }
          ]
        }
      ]
    }
  }
}
