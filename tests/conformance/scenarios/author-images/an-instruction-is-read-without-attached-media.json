{
  "$schema": "../../scenario.schema.json",
  "id": "author-images/an-instruction-is-read-without-attached-media",
  "title": "An instruction, the application's own direction, is read as it is: the kit's attached-media reader does not add the media its metadata lists",
  "rules": [
    "§6.4",
    "§10.1.1"
  ],
  "notes": "Python's with_attached_media returns an instruction as it is (tests/test_attached_media.py::test_an_instruction_is_read_as_it_is).",
  "setup": {
    "kit": {
      "attached_media": {
        "key": "files"
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "vision": true,
          "rounds": [
            {
              "text": "Done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "summarize the room"
      },
      "metadata": {
        "files": [
          {
            "type": "media",
            "url": "https://cdn.example.com/lamp.png",
            "mime_type": "image/png",
            "filename": "lamp.png"
          }
        ]
      },
      "event_type": "instruction",
      "addressed_to": [
        "agent"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "[Instruction from the application: nobody in this conversation said it. Act on it now, in your own words, without quoting it.]\nsummarize the room",
              "parts": {
                "$absent": true
              }
            }
          ]
        }
      ]
    }
  }
}
