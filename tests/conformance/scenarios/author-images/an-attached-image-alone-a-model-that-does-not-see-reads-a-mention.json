{
  "$schema": "../../scenario.schema.json",
  "id": "author-images/an-attached-image-alone-a-model-that-does-not-see-reads-a-mention",
  "title": "An event whose text has no words, with an image the application keeps beside it, reads for a model that does not see as the mention that it does not see the image, the host's describer not asked",
  "rules": [
    "§6.4"
  ],
  "notes": "Python's with_attached_media gives the attached image the place of a text without words, then unseen_images (tests/test_attached_media.py::test_a_model_that_does_not_see_is_told_so).",
  "setup": {
    "kit": {
      "attached_media": {
        "key": "files"
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "vision": false,
          "rounds": [
            {
              "text": "Seen 0."
            }
          ]
        },
        "describe_empty_event": {
          "says": "[a photo, no words]"
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": " "
      },
      "metadata": {
        "files": [
          {
            "type": "media",
            "url": "https://cdn.example.com/lamp.png",
            "mime_type": "image/png",
            "filename": "lamp.png"
          }
        ]
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "[Image not shown, this model does not see images: “lamp.png”]",
              "parts": {
                "$absent": true
              }
            }
          ]
        }
      ]
    }
  }
}
