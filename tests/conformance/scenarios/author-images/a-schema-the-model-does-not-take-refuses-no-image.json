{
  "$schema": "../../scenario.schema.json",
  "id": "author-images/a-schema-the-model-does-not-take-refuses-no-image",
  "title": "A turn whose response schema its model does not take fails before any request, and refuses none of the author images it carried: the next turn sends them as their author did",
  "rules": [
    "§6.4",
    "§6.7"
  ],
  "notes": "Python: tests/test_author_images.py TestRefusal::test_a_refusal_before_any_request_refuses_nothing (HITL fb46b635, d91b8137, RMK-1436). A provider's refusal before any request (ProviderError.before_request, an unsupported ResponseSchemaError's) says nothing of the content.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "vision": true,
          "rounds": [
            {
              "text": "Seen."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "schema",
        "trigger": "before_ai_generation",
        "priority": 0,
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "response_schema": {
                  "type": "object",
                  "properties": {
                    "lamp": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "lamp"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "composite",
        "parts": [
          {
            "type": "text",
            "body": "my lamps"
          },
          {
            "type": "media",
            "url": "data:image/png;base64,AQIDBA==",
            "mime_type": "image/png",
            "filename": "lamp.png"
          }
        ]
      },
      "metadata": {}
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "and now?"
      },
      "metadata": {}
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "my lamps",
              "parts": [
                {
                  "text": "my lamps"
                },
                {
                  "image": "data:image/png;base64,AQIDBA==",
                  "mime_type": "image/png"
                }
              ]
            },
            {
              "role": "user",
              "text": "and now?",
              "parts": {
                "$absent": true
              }
            }
          ]
        }
      ]
    }
  }
}
