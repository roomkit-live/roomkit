{
  "$schema": "../../scenario.schema.json",
  "id": "author-images/a-deleted-event-s-attached-image-stays-withheld",
  "title": "A deleted event's content is withheld from a later turn's history, the image the application keeps beside it included: the kit's media resolver is not asked for it",
  "rules": [
    "§6.4",
    "§10.3"
  ],
  "notes": "Python's with_attached_media returns a deleted event as it is, its content withheld (tests/test_attached_media.py::test_a_deleted_message_s_media_stays_withheld, host.asked == []); the event is marked deleted by a direct update, which opens no turn.",
  "setup": {
    "kit": {
      "media_resolver": {
        "media": {
          "app-media://lamp": "AQIDBA=="
        }
      },
      "attached_media": {
        "key": "files"
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "vision": true,
          "rounds": [
            {
              "text": "Seen 0."
            },
            {
              "text": "Seen 1."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "here is my lamp"
      },
      "metadata": {
        "files": [
          {
            "type": "media",
            "url": "app-media://lamp",
            "mime_type": "image/png",
            "filename": "lamp.png"
          }
        ]
      }
    },
    {
      "idle": true
    },
    {
      "call": "update_event",
      "room_id": "room-1",
      "event_id": "room-1#0",
      "metadata": {
        "deleted": true,
        "files": [
          {
            "type": "media",
            "url": "app-media://lamp",
            "mime_type": "image/png",
            "filename": "lamp.png"
          }
        ]
      }
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "what colour is it?"
      },
      "metadata": {}
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "media_resolver": [
      {
        "url": "app-media://lamp",
        "room_id": "room-1"
      }
    ],
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "here is my lamp",
              "parts": [
                {
                  "text": "here is my lamp"
                },
                {
                  "image": "data:image/png;base64,AQIDBA==",
                  "mime_type": "image/png"
                }
              ]
            }
          ]
        },
        {
          "messages": [
            {
              "role": "assistant",
              "text": "Seen 0."
            },
            {
              "role": "user",
              "text": "what colour is it?",
              "parts": {
                "$absent": true
              }
            }
          ]
        }
      ]
    }
  }
}
