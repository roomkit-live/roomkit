{
  "$schema": "../../scenario.schema.json",
  "id": "skills/a-skill-a-turn-activated-rides-the-next-turn-of-its-registry",
  "title": "An activation under a turn's registry stays the room's: the next turn holding the skill carries its rules in the prompt, and activating it again is acknowledged",
  "rules": [
    "§24.3",
    "§24.4",
    "Appendix A.9"
  ],
  "notes": "Python: channels/_ai_context.py _given_turn_skills, _add_skills; channels/_ai_policy.py _turn_skills. channels/_ai_tools.py _handle_activate_skill, channels/_skill_activation.py: the record is the channel's, per room (RFC §24.4), whichever registry each turn reads.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "skills": [],
        "config_provider": {
          "room-1": {
            "skills": [
              {
                "name": "ada-procedure",
                "description": "The ada-procedure procedure",
                "instructions": "Rules for ada-procedure."
              }
            ]
          }
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "call-1",
                  "name": "activate_skill",
                  "arguments": {
                    "name": "ada-procedure"
                  }
                }
              ]
            },
            {
              "text": "done"
            },
            {
              "calls": [
                {
                  "id": "call-2",
                  "name": "activate_skill",
                  "arguments": {
                    "name": "ada-procedure"
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "system_prompt": {
            "$lacks": "Rules for ada-procedure."
          }
        },
        {
          "tool_results": [
            {
              "content": {
                "$contains": "Rules for ada-procedure."
              },
              "is_error": false,
              "tool_call_id": "call-1"
            }
          ]
        },
        {
          "system_prompt": {
            "$contains": "Rules for ada-procedure."
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "call-2",
              "content": {
                "$contains": "\"already_active\": true"
              },
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
