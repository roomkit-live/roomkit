{
  "$schema": "../../scenario.schema.json",
  "id": "skills/a-standalone-activation-in-a-room-already-read-rides-its-next",
  "title": "What a turn standing alone activates counts for the room: its next ordinary turn carries the rules, in a room already read too",
  "rules": [
    "§10.1.1",
    "§24.4"
  ],
  "notes": "HITL 30895156 option 1, RMK-1356. RFC §24.4: an activation is scoped to the conversation. Python: channels/_ai_tools.py _record_activation.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "skills": [
          {
            "name": "shared",
            "description": "The shared procedure",
            "instructions": "Rules for shared."
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "first"
            },
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "activate_skill",
                  "arguments": {
                    "name": "shared"
                  }
                }
              ]
            },
            {
              "text": "alone"
            },
            {
              "text": "next"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Summarize."
        },
        "event_type": "instruction",
        "addressed_to": [
          "agent"
        ],
        "standalone": true
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Go on."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {},
        {
          "system_prompt": {
            "$contains": "Rules for shared."
          }
        }
      ]
    }
  }
}
