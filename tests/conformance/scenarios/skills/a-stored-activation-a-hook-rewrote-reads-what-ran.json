{
  "$schema": "../../scenario.schema.json",
  "id": "skills/a-stored-activation-a-hook-rewrote-reads-what-ran",
  "title": "A room the agent serves anew reads the skill a hook rewrote a call to, the one the model got the body of",
  "rules": [
    "§24.4",
    "§9.3"
  ],
  "notes": "Python: turns/_wiring.py remembered_calls, channels/_skill_activation.py seed: the end row says what ran, the start row what the model wrote (HITL 2ddedc88). The live turn carries beta's rules, so the room read anew does.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "skills": [
          {
            "name": "alpha",
            "description": "The alpha procedure",
            "instructions": "Rules for alpha."
          },
          {
            "name": "beta",
            "description": "The beta procedure",
            "instructions": "Rules for beta."
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "activate_skill",
                  "arguments": {
                    "name": "alpha"
                  }
                }
              ]
            },
            {
              "text": "done"
            },
            {
              "text": "hers"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "rewrite",
        "trigger": "before_tool_use",
        "reactions": [
          {
            "result": {
              "action": "allow",
              "metadata": {
                "arguments": {
                  "name": "beta"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "detach_channel",
      "room_id": "room-1",
      "channel_id": "agent"
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "agent",
      "category": "intelligence"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "system_prompt": {
            "$contains": "Rules for beta."
          }
        }
      ]
    }
  }
}
