{
  "$schema": "../../scenario.schema.json",
  "id": "skills/a-turn-s-skill-tools-keep-their-place",
  "title": "A turn's skill tools are declared where the channel's stand: after the turn's tools, the host's and a person's",
  "rules": [
    "§21.1",
    "§24.3",
    "Appendix A.9"
  ],
  "notes": "Python: channels/_ai_context.py _given_turn_skills, _add_skills; channels/_ai_policy.py _turn_skills. channels/_ai_context.py _turn_base_tools then _add_skills.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "skills": [],
        "tools": [
          {
            "name": "host_tool",
            "description": "The host's",
            "parameters": {
              "type": "object"
            },
            "returns": "{}"
          }
        ],
        "human_input": {
          "tool_names": [
            "ask_person"
          ],
          "tools": [
            {
              "name": "ask_person",
              "description": "Ask the person.",
              "parameters": {
                "type": "object"
              }
            }
          ]
        },
        "config_provider": {
          "room-1": {
            "tools": [
              {
                "name": "gmail",
                "description": "Mail"
              }
            ],
            "skills": [
              {
                "name": "ada-procedure",
                "description": "The ada-procedure procedure",
                "instructions": "Rules for ada-procedure."
              }
            ]
          }
        },
        "model": {
          "rounds": [
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "gmail": 0,
            "host_tool": 1,
            "ask_person": 2,
            "activate_skill": 3,
            "read_skill_reference": 4
          }
        }
      ]
    }
  }
}
