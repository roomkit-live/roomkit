{
  "$schema": "../../scenario.schema.json",
  "id": "observations/feedback-is-an-observation-the-hooks-observe",
  "title": "submit_feedback stores the rating, clamped to 0..1, as an observation of the room, fires ON_FEEDBACK with it and emits feedback; list_observations reads the room's observations; another organization's room is not found, nothing stored",
  "rules": [
    "§15.9",
    "§9.2",
    "§8.2",
    "§17.2"
  ],
  "notes": "Python: tests/test_hook_observers.py (ON_FEEDBACK observes submit_feedback), tests/test_room_org_scoping.py (submit_feedback and list_observations for another organization), tests/test_framework_queries.py (list_observations). A feedback naming no channel is left out: its observation's channel_id is empty, which roomkit-rs's ids refuse (a question to the maintainer).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "organization_id": "acme",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "rated",
        "trigger": "on_feedback",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "submit_feedback",
      "room_id": "room-1",
      "rating": 1.5,
      "channel_id": "sms",
      "event_id": "e-9",
      "comment": "Fast",
      "dimension": "speed",
      "metadata": {
        "source": "survey"
      },
      "expect": {
        "result": null
      }
    },
    {
      "idle": true
    },
    {
      "call": "submit_feedback",
      "room_id": "room-1",
      "rating": 0.42,
      "channel_id": "sms",
      "organization_id": "acme"
    },
    {
      "call": "submit_feedback",
      "room_id": "room-1",
      "rating": 0.5,
      "channel_id": "sms",
      "organization_id": "globex",
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "idle": true
    },
    {
      "call": "list_observations",
      "room_id": "room-1",
      "expect": {
        "result": [
          {
            "room_id": "room-1",
            "channel_id": "sms",
            "content": "[speed] 1.00: Fast",
            "category": "feedback:speed",
            "confidence": 1.0
          },
          {
            "room_id": "room-1",
            "channel_id": "sms",
            "content": "[overall] 0.42",
            "category": "feedback:overall",
            "confidence": 0.42
          }
        ]
      }
    },
    {
      "call": "list_observations",
      "room_id": "room-1",
      "organization_id": "globex",
      "expect": {
        "error": "room_not_found"
      }
    }
  ],
  "expect": {
    "observations": {
      "room-1": [
        {
          "channel_id": "sms",
          "content": "[speed] 1.00: Fast",
          "category": "feedback:speed",
          "confidence": 1.0,
          "metadata": {
            "type": "feedback",
            "dimension": "speed",
            "rating": 1.0,
            "comment": "Fast",
            "event_id": {
              "$present": true
            },
            "source": "survey"
          }
        },
        {
          "channel_id": "sms",
          "content": "[overall] 0.42",
          "category": "feedback:overall",
          "confidence": 0.42,
          "metadata": {
            "type": "feedback",
            "dimension": "overall",
            "rating": 0.42,
            "comment": "",
            "event_id": null
          }
        }
      ]
    },
    "hooks": {
      "rated": [
        {
          "trigger": "on_feedback",
          "room_id": "room-1",
          "event": null,
          "observation": {
            "content": "[speed] 1.00: Fast",
            "category": "feedback:speed"
          }
        },
        {
          "trigger": "on_feedback",
          "room_id": "room-1",
          "observation": {
            "content": "[overall] 0.42"
          }
        }
      ]
    },
    "framework_events": {
      "room-1": [
        {
          "event": "feedback",
          "channel_id": "sms",
          "event_id": {
            "$present": true
          },
          "dimension": "speed",
          "rating": 1.0
        },
        {
          "event": "feedback",
          "channel_id": "sms",
          "event_id": {
            "$absent": true
          },
          "dimension": "overall",
          "rating": 0.42
        }
      ]
    }
  }
}
