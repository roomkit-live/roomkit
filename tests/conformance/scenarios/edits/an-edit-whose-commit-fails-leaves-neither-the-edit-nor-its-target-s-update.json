{
  "$schema": "../../scenario.schema.json",
  "id": "edits/an-edit-whose-commit-fails-leaves-neither-the-edit-nor-its-target-s-update",
  "title": "An edit whose commit fails leaves neither the edit nor its target's update",
  "rules": [
    "§10.3 State updates",
    "§14.3"
  ],
  "requirements": [
    "RK-10.3-033"
  ],
  "notes": "The store fails the edit's commit (commit_event): the target keeps its content and no edited mark, the room holds no edit, no ON_EVENT_UPDATED fires, and ws is handed nothing of it.",
  "setup": {
    "kit": {
      "store_faults": true
    },
    "channels": [
      {
        "id": "wa",
        "type": "whatsapp",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "wa"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "updated",
        "trigger": "on_event_updated",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Original"
        }
      }
    },
    {
      "store_fault": "commit_event",
      "fail": "the disk is full"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "edit",
          "target_event_id": "room-1#0",
          "new_content": {
            "type": "text",
            "body": "Changed"
          },
          "edit_source": "sender"
        },
        "event_type": "edit"
      },
      "expect": {
        "error": "store_failed"
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "Original"
          },
          "metadata": {
            "edited": {
              "$absent": true
            }
          }
        }
      ]
    },
    "hooks": {
      "updated": []
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "type": "text",
              "body": "Original"
            }
          }
        ]
      }
    }
  }
}
