{
  "$schema": "../../scenario.schema.json",
  "id": "edits/a-hook-s-injected-edit-s-trigger-reads-the-room-as-its-commit-left-it",
  "title": "An edit a hook injects fires ON_EVENT_UPDATED with the room as the edit's commit left it: the target rewritten, the edit last at its index, and the counters",
  "rules": [
    "§10.3 Mutation triggers",
    "§9.4"
  ],
  "requirements": [
    "RK-10.3-047",
    "RK-26.1-022"
  ],
  "notes": "On go, the hook injects the system's edit of the first message. The injected edit commits after go, at index 2.",
  "setup": {
    "channels": [
      {
        "id": "src",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "peer",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "src",
            "participant_id": "+15551234567"
          },
          {
            "channel_id": "peer",
            "participant_id": "bob"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "janitor",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "go"
            },
            "result": {
              "action": "allow",
              "injected_events": [
                {
                  "event": {
                    "type": "edit",
                    "content": {
                      "type": "edit",
                      "target_event_id": "room-1#0",
                      "new_content": {
                        "type": "text",
                        "body": "cleaned"
                      },
                      "edit_source": "system"
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "name": "updated",
        "trigger": "on_event_updated",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "src",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "v1"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "index": 0
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "src",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "index": 1
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "updated": [
        {
          "trigger": "on_event_updated",
          "event": {
            "id": "room-1#0",
            "content": {
              "type": "text",
              "body": "cleaned"
            },
            "metadata": {
              "edited": true
            }
          },
          "recent_events": [
            "room-1#0",
            "room-1#1",
            "room-1#2"
          ],
          "context_events": [
            {
              "id": "room-1#0",
              "content": {
                "type": "text",
                "body": "cleaned"
              },
              "metadata": {
                "edited": true
              }
            },
            {
              "id": "room-1#1",
              "content": {
                "type": "text",
                "body": "go"
              }
            },
            {
              "id": "room-1#2",
              "index": 2,
              "type": "edit",
              "content": {
                "type": "edit",
                "target_event_id": "room-1#0",
                "new_content": {
                  "type": "text",
                  "body": "cleaned"
                },
                "edit_source": "system"
              }
            }
          ],
          "context_room": {
            "id": "room-1",
            "event_count": 3,
            "latest_index": 2
          }
        }
      ]
    }
  }
}
