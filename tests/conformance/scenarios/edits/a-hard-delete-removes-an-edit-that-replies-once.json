{
  "$schema": "../../scenario.schema.json",
  "id": "edits/a-hard-delete-removes-an-edit-that-replies-once",
  "title": "A hard delete of a message whose edit also replies to it removes that edit once: among the replies, or among the changes when cascade_replies is false",
  "rules": [
    "§10.3 Direct mutation"
  ],
  "requirements": [
    "RK-10.3-052",
    "RK-10.3-053",
    "RK-10.3-055"
  ],
  "reentrancy": [
    "change@outside"
  ],
  "notes": "In each room the root's edit names the root as its parent too, and a plain reply follows it. The removed events leave the timeline and read as $e1 to $e5 in the order the step outcomes show them: room-1's root, edit and reply, then room-2's root and edit. The edit listed after the reply, or twice, would be removed among the changes or more than once.",
  "setup": {
    "channels": [
      {
        "id": "wa",
        "type": "whatsapp",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "wa"
          },
          {
            "channel_id": "ws"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "wa"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "deleted",
        "trigger": "on_event_deleted",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Root"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "edit",
          "target_event_id": "room-1#0",
          "new_content": {
            "type": "text",
            "body": "Root, corrected"
          },
          "edit_source": "sender"
        },
        "event_type": "edit",
        "parent_event_id": "room-1#0"
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "parent_event_id": "$e1"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Reply"
        },
        "parent_event_id": "room-1#0"
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Root"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "edit",
          "target_event_id": "room-2#0",
          "new_content": {
            "type": "text",
            "body": "Root, corrected"
          },
          "edit_source": "sender"
        },
        "event_type": "edit",
        "parent_event_id": "room-2#0"
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "parent_event_id": "$e4"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Reply"
        },
        "parent_event_id": "room-2#0"
      }
    },
    {
      "call": "delete_event",
      "room_id": "room-1",
      "event_id": "room-1#0",
      "expect": {
        "result": [
          "$e1",
          "$e2",
          "$e3"
        ]
      }
    },
    {
      "idle": true
    },
    {
      "call": "delete_event",
      "room_id": "room-2",
      "event_id": "room-2#0",
      "cascade_replies": false,
      "expect": {
        "result": [
          "$e4",
          "$e5"
        ]
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [],
      "room-2": [
        {
          "id": "room-2#2",
          "content": {
            "type": "text",
            "body": "Reply"
          }
        }
      ]
    },
    "hooks": {
      "deleted": [
        {
          "room_id": "room-1",
          "event": {
            "id": "$e1"
          }
        },
        {
          "room_id": "room-1",
          "event": {
            "id": "$e2",
            "type": "edit"
          }
        },
        {
          "room_id": "room-1",
          "event": {
            "id": "$e3"
          }
        },
        {
          "room_id": "room-2",
          "event": {
            "id": "$e4"
          }
        },
        {
          "room_id": "room-2",
          "event": {
            "id": "$e5",
            "type": "edit"
          }
        }
      ]
    }
  }
}
