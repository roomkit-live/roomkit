{
  "$schema": "../../scenario.schema.json",
  "id": "edits/a-response-delete-s-trigger-reads-the-room-as-its-commit-left-it",
  "title": "An agent's response deleting its own message fires ON_EVENT_DELETED with the room as the delete's commit left it: the target marked deleted, its content kept, the event its hook committed ahead, the delete last as its hook left it, and the counters",
  "rules": [
    "§10.3 Mutation triggers",
    "§10.3",
    "§10.5"
  ],
  "requirements": [
    "RK-10.3-047"
  ],
  "notes": "The agent's earlier message is committed as a record with an id of the scenario's (commit_event stores it as given), which the agent's response names: a response template's strings are not references. Alice's go makes the agent answer with the delete of its message. The delete's BEFORE_BROADCAST hook sends an event into the room, which commits ahead of it (index 2), then gives the delete a reason. A hook's context keeps a deleted event's content (§10.3, What a channel is handed of a deleted event).",
  "setup": {
    "channels": [
      {
        "id": "src",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "go"
            },
            "respond": [
              {
                "type": "delete",
                "content": {
                  "type": "delete",
                  "target_event_id": "draft-1",
                  "delete_type": "sender"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "src",
            "participant_id": "+15551234567"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "redact",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "type": "delete"
            },
            "do": [
              {
                "call": "send_event",
                "room_id": "$room",
                "channel_id": "src",
                "content": {
                  "type": "text",
                  "body": "Nested"
                },
                "as": "nested"
              }
            ],
            "result": {
              "action": "modify",
              "event": {
                "content": {
                  "type": "delete",
                  "target_event_id": "draft-1",
                  "delete_type": "sender",
                  "reason": "REDACTED"
                }
              }
            }
          }
        ]
      },
      {
        "name": "deleted",
        "trigger": "on_event_deleted",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "commit_event",
      "room_id": "room-1",
      "event": {
        "id": "draft-1",
        "content": {
          "type": "text",
          "body": "draft"
        },
        "source": {
          "channel_id": "agent",
          "channel_type": "ai",
          "direction": "outbound"
        }
      },
      "expect": {
        "result": {
          "index": 0
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "src",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "index": 1
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "draft"
          },
          "metadata": {
            "deleted": true
          }
        },
        {
          "content": {
            "type": "text",
            "body": "go"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "Nested"
          }
        },
        {
          "type": "delete",
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "type": "delete",
            "target_event_id": "room-1#0",
            "delete_type": "sender",
            "reason": "REDACTED"
          }
        }
      ]
    },
    "hooks": {
      "deleted": [
        {
          "trigger": "on_event_deleted",
          "event": {
            "id": "room-1#0",
            "metadata": {
              "deleted": true
            }
          },
          "recent_events": [
            "room-1#0",
            "room-1#1",
            "room-1#2",
            "room-1#3"
          ],
          "context_events": [
            {
              "id": "room-1#0",
              "content": {
                "type": "text",
                "body": "draft"
              },
              "metadata": {
                "deleted": true
              }
            },
            {
              "id": "room-1#1",
              "content": {
                "type": "text",
                "body": "go"
              }
            },
            {
              "id": "room-1#2",
              "index": 2,
              "content": {
                "type": "text",
                "body": "Nested"
              }
            },
            {
              "id": "room-1#3",
              "index": 3,
              "type": "delete",
              "content": {
                "type": "delete",
                "target_event_id": "room-1#0",
                "delete_type": "sender",
                "reason": "REDACTED"
              },
              "source": {
                "channel_id": "agent"
              }
            }
          ],
          "context_room": {
            "id": "room-1",
            "event_count": 4,
            "latest_index": 3
          }
        }
      ]
    }
  }
}
