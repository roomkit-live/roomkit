            "type": "delete"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "wa",
        "sender_id": "agent-1",
        "content": {
          "type": "delete",
          "target_event_id": "room-1#1",
          "delete_type": "admin"
        },
        "event_type": "delete"
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "type": "delete"
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "First"
          },
          "metadata": {
            "deleted": true
          }
        },
        {
          "content": {
            "type": "text",
            "body": "Second"
          },
          "metadata": {
            "deleted": true
          }
        },
        {
          "type": "delete",
          "source": {
            "participant_id": "owner-1"
          }
        },
        {
          "type": "delete",
          "source": {
            "participant_id": "agent-1"
          }
        }
      ]
    }
  }
