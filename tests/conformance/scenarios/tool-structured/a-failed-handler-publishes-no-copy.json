{
  "$schema": "../../scenario.schema.json",
  "id": "tool-structured/a-failed-handler-publishes-no-copy",
  "title": "A failed handler publishes no copy",
  "rules": [
    "§5.3",
    "§9.3",
    "§21.4"
  ],
  "notes": "Python: tests/test_tool_context.py::TestCurrentToolCall and tests/test_tool_call_structured_copy.py; the handler writes the actual current_tool_call record before the result hook reads it.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "Done."
            }
          ],
          "streaming": true
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Find an order.",
            "parameters": {
              "type": "object"
            },
            "raises": {
              "kind": "RuntimeError",
              "message": "handler failed"
            },
            "writes_structured_content": {
              "contact": "Jane Doe",
              "salary": 120000
            }
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "allow"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Where is my order?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "is_error": true
            }
          ]
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "type": "message"
        },
        {
          "type": "tool_call_start"
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_id": "c1",
            "outcome": "failed",
            "status": "failed",
            "structured_content": null
          }
        },
        {
          "type": "message"
        }
      ]
    }
  }
}
