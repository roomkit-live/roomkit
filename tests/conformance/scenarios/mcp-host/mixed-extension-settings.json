{
  "$schema": "../../scenario.schema.json",
  "id": "mcp-host/mixed-extension-settings",
  "title": "A valid extension remains when a sibling declares non-object settings",
  "rules": [
    "§21.2"
  ],
  "notes": "Public MCPToolProvider over a bounded local HTTP peer; operation results and wire requests are both observed. Native stdio and lifecycle assertions are mapped separately in the lot checklist.",
  "steps": [
    {
      "call": "mcp_session",
      "peer": {
        "extensions": {
          "vendor/good": {
            "enabled": true
          },
          "vendor/bad": false
        },
        "replies": []
      },
      "operations": [
        {
          "method": "connect"
        },
        {
          "method": "server_extensions"
        },
        {
          "method": "close"
        }
      ],
      "discover": false,
      "expect": {
        "result": {
          "results": [
            {
              "result": null
            },
            {
              "result": {
                "vendor/good": {
                  "enabled": true
                }
              }
            },
            {
              "result": null
            }
          ],
          "requests": [
            {
              "method": "initialize"
            }
          ],
          "results_json": "[{\"result\":null},{\"result\":{\"vendor/good\":{\"enabled\":true}}},{\"result\":null}]",
          "requests_json": "[{\"method\":\"initialize\"}]"
        }
      }
    }
  ]
}
