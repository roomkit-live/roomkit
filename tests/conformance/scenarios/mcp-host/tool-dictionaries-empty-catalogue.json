{
  "$schema": "../../scenario.schema.json",
  "id": "mcp-host/tool-dictionaries-empty-catalogue",
  "title": "Tool dictionaries empty catalogue",
  "rules": [
    "§21.2"
  ],
  "requirements": [
    "RK-21.2-021"
  ],
  "notes": "Python: tests/test_mcp_tool_provider.py::test_get_tools_as_dicts and the dictionary slice of test_not_connected_guard. Exact six-field snapshots and request counts complement those source assertions.",
  "steps": [
