      "expect": {
        "result": {
          "results": [
            {
              "result": null
            },
            {
              "result": []
            },
            {
              "result": null
            }
          ],
          "requests": [
            {
              "method": "server/discover"
            },
            {
              "method": "initialize"
            },
            {
              "method": "tools/list"
            }
          ],
          "results_json": "[{\"result\":null},{\"result\":[]},{\"result\":null}]",
          "requests_json": "[{\"method\":\"server/discover\"},{\"method\":\"initialize\"},{\"method\":\"tools/list\"}]"
        }
      }
    }
  ]
