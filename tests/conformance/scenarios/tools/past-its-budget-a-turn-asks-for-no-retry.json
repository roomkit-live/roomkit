{
  "$schema": "../../scenario.schema.json",
  "id": "tools/past-its-budget-a-turn-asks-for-no-retry",
  "title": "A turn past its token budget asks for no retry of an empty answer after a round of calls: it ends budget_exceeded",
  "rules": [
    "§6.4",
    "Appendix A.9"
  ],
  "notes": "Python's retry of an empty answer is spent only while the turn's limits hold (_ai_loop_rules.py; test_turn_budget.py test_past_its_budget_a_turn_asks_for_no_retry_of_an_empty_answer): the empty answer brings the turn to 1,000 tokens, past 600.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c0",
                  "name": "lookup",
                  "arguments": {
                    "n": 0
                  }
                }
              ],
              "usage": {
                "input_tokens": 300,
                "cache_read_input_tokens": 100,
                "output_tokens": 100
              }
            },
            {
              "text": "",
              "usage": {
                "input_tokens": 300,
                "cache_read_input_tokens": 100,
                "output_tokens": 100
              }
            },
            {
              "text": "done",
              "usage": {
                "input_tokens": 300,
                "cache_read_input_tokens": 100,
                "output_tokens": 100
              }
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look up an item",
            "parameters": {
              "type": "object",
              "properties": {
                "n": {
                  "type": "integer"
                }
              }
            },
            "returns": "ok"
          }
        ],
        "turn_budget_tokens": 600
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message"
        },
        {
          "index": 1,
          "type": "tool_call_start"
        },
        {
          "index": 2,
          "type": "tool_call_end",
          "content": {
            "tool_id": "c0",
            "outcome": "served"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": "$any"
        }
      ]
    },
    "hooks": {
      "report": [
        {
          "response": {
            "loop_end_reason": "budget_exceeded",
            "tool_calls_count": 1,
            "round_count": 1
          }
        }
      ]
    }
  }
}
