{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-narrowed-binding-s-turn-publishes-no-tool-call-events",
  "title": "An agent whose binding's visibility narrows its answers publishes nothing of its tool calls to the room's subscribers",
  "rules": [
    "§8.4"
  ],
  "notes": "Python: tests/test_turn_ephemerals_scope.py::test_a_turn_whose_answer_the_room_narrows_publishes_no_ephemeral; turns/_owner_publish.py publish_frame; core/visibility.py binding_reaches_room (RFC §8.4: a turn's ephemerals reach no one its answer would not reach).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "x"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look a record up.",
            "parameters": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              }
            },
            "returns": "{\"found\": 1}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "visibility": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look it up."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "tool_events": {
      "room-1": []
    }
  }
}
