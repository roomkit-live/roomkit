{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-token-budget-stops-the-turn-where-it-is-reached",
  "title": "A turn's token budget stops the loop at the first round boundary where the generations' billed tokens reach it: the round's calls do not run, and the turn ends budget_exceeded",
  "rules": [
    "§6.4",
    "Appendix A.9"
  ],
  "notes": "Python counts each generation's input, output and cache tokens against turn_budget_tokens and checks it, after the deadline, where a round's calls would start (_ai_loop_rules.py limit_reached; test_turn_budget.py test_a_token_budget_stops_the_turn_where_it_is_reached): 500 tokens a generation, the third reaches 1,200.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c0",
                  "name": "lookup",
                  "arguments": {
                    "n": 0
                  }
                }
              ],
              "usage": {
                "input_tokens": 300,
                "cache_read_input_tokens": 100,
                "output_tokens": 100
              }
            },
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "n": 1
                  }
                }
              ],
              "usage": {
                "input_tokens": 300,
                "cache_read_input_tokens": 100,
                "output_tokens": 100
              }
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "lookup",
                  "arguments": {
                    "n": 2
                  }
                }
              ],
              "usage": {
                "input_tokens": 300,
                "cache_read_input_tokens": 100,
                "output_tokens": 100
              },
              "text": "Looking again."
            },
            {
              "calls": [
                {
                  "id": "c3",
                  "name": "lookup",
                  "arguments": {
                    "n": 3
                  }
                }
              ],
              "usage": {
                "input_tokens": 300,
                "cache_read_input_tokens": 100,
                "output_tokens": 100
              }
            },
            {
              "calls": [
                {
                  "id": "c4",
                  "name": "lookup",
                  "arguments": {
                    "n": 4
                  }
                }
              ],
              "usage": {
                "input_tokens": 300,
                "cache_read_input_tokens": 100,
                "output_tokens": 100
              }
            },
            {
              "calls": [
                {
                  "id": "c5",
                  "name": "lookup",
                  "arguments": {
                    "n": 5
                  }
                }
              ],
              "usage": {
                "input_tokens": 300,
                "cache_read_input_tokens": 100,
                "output_tokens": 100
              }
            },
            {
              "text": "done",
              "usage": {
                "input_tokens": 300,
                "cache_read_input_tokens": 100,
                "output_tokens": 100
              }
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look up an item",
            "parameters": {
              "type": "object",
              "properties": {
                "n": {
                  "type": "integer"
                }
              }
            },
            "returns": "ok"
          }
        ],
        "turn_budget_tokens": 1200
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message"
        },
        {
          "index": 1,
          "type": "tool_call_start"
        },
        {
          "index": 2,
          "type": "tool_call_end",
          "content": {
            "tool_id": "c0",
            "outcome": "served"
          }
        },
        {
          "index": 3,
          "type": "tool_call_start"
        },
        {
          "index": 4,
          "type": "tool_call_end",
          "content": {
            "tool_id": "c1",
            "outcome": "served"
          }
        },
        {
          "index": 5,
          "type": "message",
          "content": {
            "type": "text",
            "body": "Looking again."
          },
          "metadata": {
            "loop_end_reason": "budget_exceeded"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": "$any"
        },
        {
          "tool_results": "$any"
        }
      ]
    },
    "hooks": {
      "report": [
        {
          "response": {
            "loop_end_reason": "budget_exceeded",
            "tool_calls_count": 2,
            "round_count": 2
          }
        }
      ]
    }
  }
}
