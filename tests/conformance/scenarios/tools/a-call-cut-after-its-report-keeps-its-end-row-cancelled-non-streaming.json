{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-call-cut-after-its-report-keeps-its-end-row-cancelled-non-streaming",
  "title": "A call cut after its report, before the model read its result, keeps its end row cancelled; its report is not made again (non-streaming)",
  "rules": [
    "§9.3"
  ],
  "requirements": [
    "RK-6.4-067",
    "RK-9.3-054"
  ],
  "notes": "Python: tests/tools/test_turn_report_claim_lifecycle.py::test_a_claimed_local_call_keeps_its_end_row_when_cancelled. The handler claims the call's report through turn_report_claim, as a reporter of its own does, then holds at the gate: the turn is cut in the window between the report and the end row. The end row says what the turn delivered (cancelled); the report is the claimer's, so the observers hear no second one; the model is never asked again.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "42"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "report_claim_probe": "claim_then_gate",
            "gate": "claimed"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "defer_delivery": true,
      "as": "turn"
    },
    {
      "wait_for": "claimed"
    },
    {
      "call": "delivery.cancel",
      "of": "turn",
      "reason": "cut"
    },
    {
      "open": "claimed"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tool_results": []
        }
      ]
    },
    "hooks": {
      "audit": []
    },
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "content": {
            "type": "text",
            "body": "Go."
          }
        },
        {
          "index": 1,
          "type": "tool_call_start",
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "type": "tool_call",
            "tool_name": "lookup",
            "tool_id": "c1",
            "arguments": {
              "q": "42"
            }
          }
        },
        {
          "index": 2,
          "type": "tool_call_end",
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "type": "tool_call",
            "tool_name": "lookup",
            "tool_id": "c1",
            "arguments": {
              "q": "42"
            },
            "outcome": "cancelled"
          }
        }
      ]
    }
  }
}
