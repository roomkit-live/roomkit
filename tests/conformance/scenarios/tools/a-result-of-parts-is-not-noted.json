{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-result-of-parts-is-not-noted",
  "title": "A result of parts a model that sees reads carries no note: only a text is compared",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: channels/_ai_tools.py _model_part, _repeated_result_note; _model_part: only when outcome.result is a str.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "boards",
            "description": "Search boards.",
            "returns_parts": [
              {
                "text": "nothing"
              }
            ]
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "boards",
                  "arguments": {
                    "search": "term-1"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t2",
                  "name": "boards",
                  "arguments": {
                    "search": "term-2"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t3",
                  "name": "boards",
                  "arguments": {
                    "search": "term-3"
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "vision": true
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "t1",
              "content": [
                {
                  "text": "nothing"
                }
              ]
            },
            {
              "tool_call_id": "t2",
              "content": [
                {
                  "text": "nothing"
                }
              ]
            },
            {
              "tool_call_id": "t3",
              "content": [
                {
                  "text": "nothing"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
