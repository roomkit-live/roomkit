{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-hoisted-call-runs-folded-into-params",
  "title": "A call to a hub tool ({action, params}, a closed schema) that hoisted its arguments to the root runs with them folded into params: the gate repairs it before the schema check",
  "rules": [
    "§21.1",
    "§9.3",
    "§6.4"
  ],
  "notes": "Python's fold_hoisted_arguments (roomkit tools/validation.py): a closed schema declaring a params object of no shape of its own, an undeclared root key, and params absent or empty. The start row keeps the model's arguments; the hooks, the tool and the end row get the folded ones.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "call-1",
                  "name": "boards",
                  "arguments": {
                    "action": "list_columns",
                    "board_id": "board-1"
                  }
                }
              ]
            },
            {
              "text": "Two columns."
            }
          ]
        },
        "tools": [
          {
            "name": "boards",
            "description": "Board operations",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "type": "string"
                },
                "params": {
                  "type": "object"
                }
              },
              "required": [
                "action"
              ]
            },
            "returns": "{\"columns\": [\"todo\", \"done\"]}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "List the columns of board 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "List the columns of board 1."
          }
        },
        {
          "index": 1,
          "type": "tool_call_start",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "tool_call",
            "tool_name": "boards",
            "tool_id": "call-1",
            "arguments": {
              "action": "list_columns",
              "board_id": "board-1"
            },
            "status": "pending",
            "result": null
          }
        },
        {
          "index": 2,
          "type": "tool_call_end",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "tool_call",
            "tool_name": "boards",
            "tool_id": "call-1",
            "arguments": {
              "action": "list_columns",
              "params": {
                "board_id": "board-1"
              }
            },
            "status": "completed",
            "outcome": "served",
            "result": "{\"columns\": [\"todo\", \"done\"]}"
          }
        },
        {
          "index": 3,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Two columns."
          },
          "chain_depth": 1
        }
      ]
    },
    "hooks": {
      "gate": [
        {
          "trigger": "before_tool_use",
          "room_id": "room-1",
          "tool_call": {
            "name": "boards",
            "tool_call_id": "call-1",
            "arguments": {
              "action": "list_columns",
              "params": {
                "board_id": "board-1"
              }
            }
          }
        }
      ],
      "audit": [
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "name": "boards",
            "tool_call_id": "call-1",
            "arguments": {
              "action": "list_columns",
              "params": {
                "board_id": "board-1"
              }
            },
            "refused": false
          }
        }
      ]
    }
  }
}
