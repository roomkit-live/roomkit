{
  "$schema": "../../scenario.schema.json",
  "id": "tools/the-order-of-a-call-s-keys-makes-no-new-call",
  "title": "Two calls whose arguments differ only by the order of their keys, at any depth, are one call to the guard",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: channels/_ai_tools.py _repeated_call_guard, _repeated_result_note; json.dumps(arguments, sort_keys=True).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "boards",
            "description": "Search boards.",
            "returns": "ok"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "boards",
                  "arguments": {
                    "a": 1,
                    "b": {
                      "x": 1,
                      "y": [
                        {
                          "p": 1,
                          "q": 2
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t2",
                  "name": "boards",
                  "arguments": {
                    "b": {
                      "y": [
                        {
                          "q": 2,
                          "p": 1
                        }
                      ],
                      "x": 1
                    },
                    "a": 1
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t3",
                  "name": "boards",
                  "arguments": {
                    "a": 1,
                    "b": {
                      "x": 1,
                      "y": [
                        {
                          "p": 1,
                          "q": 2
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "t1",
              "content": "ok",
              "is_error": false
            },
            {
              "tool_call_id": "t2",
              "content": "ok",
              "is_error": false
            },
            {
              "tool_call_id": "t3",
              "content": "{\"error\": \"You already called 'boards' with these EXACT arguments 2 time(s) this turn \\u2014 repeating it cannot yield anything new.\", \"hint\": \"STOP repeating this call. Use the results you already have, try genuinely different arguments, or answer the user now with what you know.\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
