{
  "$schema": "../../scenario.schema.json",
  "id": "tools/one-answer-from-two-tools-is-counted-apart",
  "title": "The same answer from two tools is two facts: each tool's count is its own",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: channels/_ai_tools.py _model_part, _repeated_result_note; tests/test_repeated_result_note.py test_two_tools_returning_the_same_string_are_counted_apart.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "boards",
            "description": "Search boards.",
            "returns": "{\"cards\": [], \"total\": 0}"
          },
          {
            "name": "notes",
            "description": "Search notes.",
            "returns": "{\"cards\": [], \"total\": 0}"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "boards",
                  "arguments": {
                    "search": "term-1"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t2",
                  "name": "notes",
                  "arguments": {
                    "search": "term-2"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t3",
                  "name": "boards",
                  "arguments": {
                    "search": "term-3"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t4",
                  "name": "notes",
                  "arguments": {
                    "search": "term-4"
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {},
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "t1",
              "content": "{\"cards\": [], \"total\": 0}"
            },
            {
              "tool_call_id": "t2",
              "content": "{\"cards\": [], \"total\": 0}"
            },
            {
              "tool_call_id": "t3",
              "content": "{\"cards\": [], \"total\": 0}"
            },
            {
              "tool_call_id": "t4",
              "content": "{\"cards\": [], \"total\": 0}"
            }
          ]
        }
      ]
    }
  }
}
