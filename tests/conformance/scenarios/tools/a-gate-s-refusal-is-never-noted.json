{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-gate-s-refusal-is-never-noted",
  "title": "What a gate refuses gets no note, however many times it reads the same: only what a call past its gate answered is compared",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: channels/_ai_tools.py _repeated_call_guard, _reject_call, _channel_tool_handler; _reject_call never reaches _model_part.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "echo",
            "description": "Echo a value back.",
            "returns": "ok",
            "parameters": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            }
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "echo",
                  "arguments": {
                    "value": "v1"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t2",
                  "name": "echo",
                  "arguments": {
                    "value": "v2"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t3",
                  "name": "echo",
                  "arguments": {
                    "value": "v3"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t4",
                  "name": "echo",
                  "arguments": {
                    "value": "v4"
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "denies",
        "trigger": "before_tool_use",
        "reactions": [
          {
            "repeat": true,
            "result": {
              "action": "block",
              "reason": "not today"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {},
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "t1",
              "content": {
                "$lacks": "identical result"
              },
              "is_error": true
            },
            {
              "tool_call_id": "t2",
              "content": {
                "$lacks": "identical result"
              },
              "is_error": true
            },
            {
              "tool_call_id": "t3",
              "content": {
                "$lacks": "identical result"
              },
              "is_error": true
            },
            {
              "tool_call_id": "t4",
              "content": {
                "$lacks": "identical result"
              },
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
