{
  "$schema": "../../scenario.schema.json",
  "id": "tools/report-claim-previous-turn-streaming",
  "title": "An old callback leaves the next turns result and observer report intact (streaming)",
  "rules": [
    "§9.3",
    "§21.4"
  ],
  "notes": "Python: tests/tools/test_turn_report_claim.py and tests/tools/test_turn_report_claim_observers.py. The scripted handler calls the public accessor and actual retained callbacks; observer counts and model results are independent assertions.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": false,
        "tools": [
          {
            "name": "lookup",
            "description": "Lookup",
            "parameters": {
              "type": "object"
            },
            "report_claim_probe": "previous_turn"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "first"
                  }
                }
              ]
            },
            {
              "text": "done"
            },
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "second"
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": true
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "one"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "two"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "[null]",
              "is_error": false
            }
          ]
        },
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "[null]",
              "is_error": false
            },
            {
              "tool_call_id": "c1",
              "content": "[false]",
              "is_error": false
            }
          ]
        }
      ]
    },
    "hooks": {
      "audit": [
        {
          "trigger": "on_tool_call",
          "tool_call": {
            "tool_call_id": "c1",
            "arguments": {
              "q": "first"
            },
            "result": "[null]",
            "is_error": false,
            "refused": false,
            "cancelled": false
          }
        },
        {
          "trigger": "on_tool_call",
          "tool_call": {
            "tool_call_id": "c1",
            "arguments": {
              "q": "second"
            },
            "result": "[false]",
            "is_error": false,
            "refused": false,
            "cancelled": false
          }
        }
      ]
    }
  }
}
