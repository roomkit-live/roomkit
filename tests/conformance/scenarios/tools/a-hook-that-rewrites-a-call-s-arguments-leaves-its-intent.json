{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-hook-that-rewrites-a-call-s-arguments-leaves-its-intent",
  "title": "With call intents on, a BEFORE_TOOL_USE hook whose rewrite of a call's arguments names _roomkit_intent changes no intent: the call's end, its row and the model's next round keep the one the model wrote",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-6.4-119"
  ],
  "notes": "Python: models/tool_call.py ToolCallEvent.intent (a hook cannot change it); channels/_ai_tools.py takes the property once, as a call enters the loop. RK-6.4-119 is cited in part: the scenario's hook rewrites the call's arguments, the members of a tool call's modify patch both runners take; a hook that sets the payload's intent directly is not observed here, roomkit-rs's runner taking no such patch member.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "publish_tool_call_text": true,
        "tools": [
          {
            "name": "shell",
            "description": "Run a command.",
            "parameters": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string"
                }
              },
              "required": [
                "command"
              ]
            },
            "returns": "a.txt"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "shell",
                  "arguments": {
                    "command": "ls",
                    "_roomkit_intent": "Je liste."
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tool_call_intents": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "rewrite",
        "trigger": "before_tool_use",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "arguments": {
                  "command": "ls",
                  "_roomkit_intent": "Autre chose."
                }
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "tool_events": {
      "room-1": [
        {
          "type": "tool_call_start",
          "round": 0,
          "channel_id": "agent",
          "tool_calls": [
            {
              "id": "$e1",
              "intent": "Je liste."
            }
          ]
        },
        {
          "type": "tool_call_end",
          "round": 0,
          "channel_id": "agent",
          "duration_ms": {
            "$present": true
          },
          "tool_calls": [
            {
              "id": "$e1",
              "status": "completed",
              "intent": "Je liste."
            }
          ]
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message"
        },
        {
          "index": 1,
          "type": "tool_call_start",
          "content": {
            "tool_id": "c1",
            "intent": "Je liste."
          }
        },
        {
          "index": 2,
          "type": "tool_call_end",
          "content": {
            "tool_id": "c1",
            "intent": "Je liste."
          }
        },
        {
          "index": 3,
          "type": "message"
        }
      ]
    },
    "models": {
      "agent": [
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "go"
            },
            {
              "role": "assistant",
              "round": [
                {
                  "call": "$e1",
                  "arguments": {
                    "command": "ls",
                    "_roomkit_intent": "Je liste."
                  }
                }
              ]
            },
            {
              "role": "tool"
            }
          ]
        }
      ]
    }
  }
}
