{
  "$schema": "../../scenario.schema.json",
  "id": "tools/an-observer-reads-a-replaced-result-as-the-model-reads-it",
  "title": "The ASYNC ON_TOOL_CALL observers of a served call read the result a SYNC hook replaced as the model reads it, serialized, never the original",
  "rules": [
    "§9.3"
  ],
  "requirements": [
    "RK-9.3-065"
  ],
  "notes": "The SYNC hook replaces the text result with an object through a MODIFY: the model and the observer read it serialized. Python: tests/test_tool_call_hook_chain.py::test_observers_see_a_replacement_as_the_model_reads_it.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "call-1",
                  "name": "lookup",
                  "arguments": {}
                }
              ],
              "finish_reason": "tool_calls"
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look a customer up.",
            "parameters": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                }
              }
            },
            "returns": "SSN 123-45-6789"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "shape",
        "trigger": "on_tool_call",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "result": {
                  "n": 1
                }
              }
            }
          }
        ]
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look me up."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "call-1",
              "content": "{\"n\": 1}",
              "is_error": false
            }
          ]
        }
      ]
    },
    "hooks": {
      "shape": [
        {
          "tool_call": {
            "tool_call_id": "call-1",
            "result": "SSN 123-45-6789"
          }
        }
      ],
      "audit": [
        {
          "tool_call": {
            "tool_call_id": "call-1",
            "result": "{\"n\": 1}",
            "is_error": false
          }
        }
      ]
    }
  }
}
