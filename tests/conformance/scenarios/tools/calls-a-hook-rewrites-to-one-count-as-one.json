{
  "$schema": "../../scenario.schema.json",
  "id": "tools/calls-a-hook-rewrites-to-one-count-as-one",
  "title": "Past its gate a call is counted on the arguments it would run with: three calls a hook rewrites to one are one call, refused at its third",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: channels/_ai_tools.py _repeated_call_guard, _reject_call, _channel_tool_handler; _channel_tool_handler reads the arguments BEFORE_TOOL_USE left.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "echo",
            "description": "Echo a value back.",
            "returns": "ok",
            "parameters": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            }
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "echo",
                  "arguments": {
                    "value": "a"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t2",
                  "name": "echo",
                  "arguments": {
                    "value": "b"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t3",
                  "name": "echo",
                  "arguments": {
                    "value": "c"
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "rewrites",
        "trigger": "before_tool_use",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "arguments": {
                  "value": "one"
                }
              }
            }
          },
          {
            "result": {
              "action": "modify",
              "event": {
                "arguments": {
                  "value": "one"
                }
              }
            }
          },
          {
            "result": {
              "action": "modify",
              "event": {
                "arguments": {
                  "value": "one"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "t1",
              "content": "ok",
              "is_error": false
            },
            {
              "tool_call_id": "t2",
              "content": "ok",
              "is_error": false
            },
            {
              "tool_call_id": "t3",
              "content": "{\"error\": \"You already called 'echo' with these EXACT arguments 2 time(s) this turn \\u2014 repeating it cannot yield anything new.\", \"hint\": \"STOP repeating this call. Use the results you already have, try genuinely different arguments, or answer the user now with what you know.\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
