{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-call-under-an-id-an-earlier-round-used-the-turn-cuts-reads-cancelled",
  "title": "A call under an id an earlier round's call used is a new call: the turn's cut reports it cancelled, its end row its own, the earlier call's left as it was",
  "rules": [
    "§9.3",
    "§12.4"
  ],
  "notes": "Python: tests/test_turn_calls_per_call.py::test_a_reused_id_call_the_turn_cuts_is_reported_cancelled.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up",
            "parameters": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              }
            },
            "returns": "fine",
            "gate": "held"
          },
          {
            "name": "quick",
            "description": "At once",
            "parameters": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              }
            },
            "returns": "fine"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "quick",
                  "arguments": {
                    "q": "first"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "second"
                  }
                }
              ]
            },
            {
              "text": "never"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "defer_delivery": true,
      "as": "a"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "delivery.cancel",
      "of": "a",
      "reason": "stopped"
    },
    {
      "open": "held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "audit": [
        {
          "trigger": "on_tool_call",
          "tool_call": {
            "name": "quick",
            "tool_call_id": "c1",
            "arguments": {
              "q": "first"
            },
            "cancelled": false
          }
        },
        {
          "trigger": "on_tool_call",
          "tool_call": {
            "name": "lookup",
            "tool_call_id": "c1",
            "arguments": {
              "q": "second"
            },
            "refused": false,
            "cancelled": true,
            "is_error": true
          }
        }
      ]
    }
  }
}
