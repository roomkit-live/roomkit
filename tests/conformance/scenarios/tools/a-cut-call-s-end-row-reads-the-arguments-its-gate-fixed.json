{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-cut-call-s-end-row-reads-the-arguments-its-gate-fixed",
  "title": "A turn cut while a call runs closes its row with the arguments its gate fixed, as its report says",
  "rules": [
    "§9.3",
    "§10.6.4",
    "§12.4"
  ],
  "notes": "Python: turns/_executor_changes.py report sends tool_args before the turn's end; RFC §10.6.4, a call's arguments are its tool_args frame's when it has one.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up",
            "parameters": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              }
            },
            "returns": "fine",
            "gate": "held"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "first"
                  }
                }
              ]
            },
            {
              "text": "never"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      },
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "reactions": [
          {
            "result": {
              "action": "allow",
              "metadata": {
                "arguments": {
                  "q": "fixed"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "defer_delivery": true,
      "as": "a"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "delivery.cancel",
      "of": "a",
      "reason": "stopped"
    },
    {
      "open": "held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "audit": [
        {
          "trigger": "on_tool_call",
          "tool_call": {
            "name": "lookup",
            "tool_call_id": "c1",
            "arguments": {
              "q": "fixed"
            },
            "refused": false,
            "cancelled": true,
            "is_error": true
          }
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "type": "message"
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_id": "c1",
            "tool_name": "lookup",
            "arguments": {
              "q": "first"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_id": "c1",
            "tool_name": "lookup",
            "arguments": {
              "q": "fixed"
            },
            "outcome": "cancelled"
          }
        }
      ]
    }
  }
}
