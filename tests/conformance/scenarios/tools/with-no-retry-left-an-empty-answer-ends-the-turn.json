{
  "$schema": "../../scenario.schema.json",
  "id": "tools/with-no-retry-left-an-empty-answer-ends-the-turn",
  "title": "With max_empty_retries 0, a generation that ends empty after a round of calls ends the turn empty_response: no word to the model, no other generation",
  "rules": [
    "§6.4",
    "Appendix A.9"
  ],
  "notes": "Python: tests/test_channels/test_ai_empty_retry.py::test_no_retry_when_budget_zero.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": ""
            }
          ]
        },
        "max_empty_retries": 0
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "report": [
        {
          "trigger": "on_ai_response",
          "room_id": "room-1",
          "response": {
            "loop_end_reason": "empty_response"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": "Go."
              }
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": "Go."
              }
            },
            {
              "role": "assistant",
              "text": ""
            },
            {
              "role": "tool",
              "text": ""
            }
          ],
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "found",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
