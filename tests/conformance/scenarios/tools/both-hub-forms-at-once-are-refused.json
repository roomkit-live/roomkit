{
  "$schema": "../../scenario.schema.json",
  "id": "tools/both-hub-forms-at-once-are-refused",
  "title": "A call to a hub tool giving params and a root key it does not declare is refused unrepaired, with words naming where its arguments go, before BEFORE_TOOL_USE",
  "rules": [
    "§21.1",
    "§9.3",
    "§6.4"
  ],
  "notes": "Python's fold_hoisted_arguments refuses both forms at once as ambiguous. The words are JSON as Python's json.dumps writes them, every character past ASCII escaped.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "call-1",
                  "name": "boards",
                  "arguments": {
                    "action": "list_columns",
                    "params": {
                      "board_id": "board-1"
                    },
                    "column_id": "c-2"
                  }
                }
              ]
            },
            {
              "text": "I could not."
            }
          ]
        },
        "tools": [
          {
            "name": "boards",
            "description": "Board operations",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "action": {
                  "type": "string"
                },
                "params": {
                  "type": "object"
                }
              },
              "required": [
                "action"
              ]
            },
            "returns": "{\"columns\": [\"todo\", \"done\"]}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "List the columns of board 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "List the columns of board 1."
          }
        },
        {
          "index": 1,
          "type": "tool_call_start",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "tool_call",
            "tool_name": "boards",
            "tool_id": "call-1",
            "arguments": {
              "action": "list_columns",
              "params": {
                "board_id": "board-1"
              },
              "column_id": "c-2"
            },
            "status": "pending",
            "result": null
          }
        },
        {
          "index": 2,
          "type": "tool_call_end",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "tool_call",
            "tool_name": "boards",
            "tool_id": "call-1",
            "arguments": {
              "action": "list_columns",
              "params": {
                "board_id": "board-1"
              },
              "column_id": "c-2"
            },
            "status": "failed",
            "outcome": "refused",
            "result": "{\"error\": \"Invalid arguments for 'boards': 'column_id' passed at the root while 'params' is already set \\u2014 pass every tool argument inside 'params'\"}"
          }
        },
        {
          "index": 3,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "I could not."
          },
          "chain_depth": 1
        }
      ]
    },
    "hooks": {
      "gate": [],
      "audit": [
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "name": "boards",
            "tool_call_id": "call-1",
            "arguments": {
              "action": "list_columns",
              "params": {
                "board_id": "board-1"
              },
              "column_id": "c-2"
            },
            "result": "{\"error\": \"Invalid arguments for 'boards': 'column_id' passed at the root while 'params' is already set \\u2014 pass every tool argument inside 'params'\"}",
            "is_error": true,
            "refused": true
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "call-1",
              "content": "{\"error\": \"Invalid arguments for 'boards': 'column_id' passed at the root while 'params' is already set \\u2014 pass every tool argument inside 'params'\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
