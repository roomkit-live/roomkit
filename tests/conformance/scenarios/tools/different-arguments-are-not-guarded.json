{
  "$schema": "../../scenario.schema.json",
  "id": "tools/different-arguments-are-not-guarded",
  "title": "Calls with different arguments are as many calls: the guard does not count them together",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: channels/_ai_tools.py _repeated_call_guard, _reject_call, _channel_tool_handler; tests/test_tool_repeat_guard.py test_different_arguments_are_not_guarded.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "echo",
            "description": "Echo a value back.",
            "returns": "ok",
            "parameters": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            }
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "echo",
                  "arguments": {
                    "value": "a"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t2",
                  "name": "echo",
                  "arguments": {
                    "value": "b"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t3",
                  "name": "echo",
                  "arguments": {
                    "value": "c"
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "t1",
              "is_error": false
            },
            {
              "tool_call_id": "t2",
              "is_error": false
            },
            {
              "tool_call_id": "t3",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
