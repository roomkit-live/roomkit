{
  "$schema": "../../scenario.schema.json",
  "id": "tools/calls-a-hook-rewrites-apart-run-apart",
  "title": "Three identical calls a hook rewrites apart are three calls: the third runs, and its identical answer is noted",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: channels/_ai_tools.py _repeated_call_guard, _reject_call, _channel_tool_handler; _channel_tool_handler reads the arguments BEFORE_TOOL_USE left; _model_part on what it answered.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "echo",
            "description": "Echo a value back.",
            "returns": "ok",
            "parameters": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            }
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "echo",
                  "arguments": {
                    "value": "x"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t2",
                  "name": "echo",
                  "arguments": {
                    "value": "x"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t3",
                  "name": "echo",
                  "arguments": {
                    "value": "x"
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "rewrites",
        "trigger": "before_tool_use",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "arguments": {
                  "value": "1"
                }
              }
            }
          },
          {
            "result": {
              "action": "modify",
              "event": {
                "arguments": {
                  "value": "2"
                }
              }
            }
          },
          {
            "result": {
              "action": "modify",
              "event": {
                "arguments": {
                  "value": "3"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "t1",
              "content": "ok",
              "is_error": false
            },
            {
              "tool_call_id": "t2",
              "content": "ok",
              "is_error": false
            },
            {
              "tool_call_id": "t3",
              "content": "ok\n\n[identical result: 'echo' has now returned exactly this 3 times this turn, for different arguments. Varying the arguments is not finding anything new — this answer is settled. Use it and move on, or answer with what you have.]",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
