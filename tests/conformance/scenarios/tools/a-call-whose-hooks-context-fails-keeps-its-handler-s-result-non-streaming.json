{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-call-whose-hooks-context-fails-keeps-its-handler-s-result-non-streaming",
  "title": "A served call whose ON_TOOL_CALL hooks' context fails to build keeps its handler's result, its hooks and observers unrun, and is reported once (non-streaming)",
  "rules": [
    "§9.3"
  ],
  "requirements": [
    "RK-6.4-397",
    "RK-8.2-037",
    "RK-9.3-094",
    "RK-9.3-095"
  ],
  "notes": "The room's read the hooks' context starts with (load_room_context) fails once the handler served the call: the SYNC hook that would rewrite the result does not run, nor does the observer, the model reads the handler's result, and the tool_call framework event still reports the call once (the handler's one run). Python: tests/test_tool_call_verdict_reading.py::test_a_text_call_keeps_its_result_when_the_hook_context_fails. Partial: the AI channel's loop alone (a speech-to-speech session's or a conference's call is not observed), and a served call alone for RK-9.3-095 (its refused and failed calls have scenarios of their own).",
  "setup": {
    "kit": {
      "store_faults": true
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "Done."
            }
          ],
          "streaming": false
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up",
            "returns": "found",
            "gate": "tool"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "shape",
        "trigger": "on_tool_call",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "result": "rewritten"
              }
            }
          }
        ]
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "event_handlers": [
      {
        "event": "tool_call",
        "reactions": [
          {
            "repeat": true,
            "do": [
              {
                "call": "status.recent",
                "as": "reported"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look it up."
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "tool"
    },
    {
      "store_fault": "load_room_context",
      "fail": "the store is down"
    },
    {
      "open": "tool"
    },
    {
      "await": "turn",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "found",
              "is_error": false
            }
          ]
        }
      ]
    },
    "hooks": {
      "shape": [],
      "audit": []
    },
    "actions": {
      "reported": [
        {}
      ]
    }
  }
}
