{
  "$schema": "../../scenario.schema.json",
  "id": "tools/an-on-tool-call-hook-s-structured-copy-reaches-the-end-row",
  "title": "The structured copy an ON_TOOL_CALL hook leaves is on the call's end row; the model reads the replaced result alone",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: channels/_ai_tools.py keeps the verdict's structured_content on the call's outcome, and core/mixins/_streaming_segments.py stores it on the TOOL_CALL_END row, for the surfaces that render it.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Find an order.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"data\": {\"order\": 42}, \"text\": \"order 42\"}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "text-for-the-model",
        "trigger": "on_tool_call",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "result": "order 42",
                "structured_content": {
                  "data": {
                    "order": 42
                  }
                }
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Where is my order?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "order 42",
              "is_error": false
            }
          ]
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "type": "message"
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_id": "c1"
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_id": "c1",
            "result": "order 42",
            "outcome": "served",
            "structured_content": {
              "data": {
                "order": 42
              }
            }
          }
        },
        {
          "type": "message"
        }
      ]
    }
  }
}
