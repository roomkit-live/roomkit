{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-failure-on-the-try-after-a-malformed-call-is-the-turn-s-own-error",
  "title": "The try after a first-round malformed call ran no round: a provider's failure there is the turn's own error, never a turn interrupted, and ON_AI_RESPONSE does not fire",
  "rules": [
    "§6.4",
    "§9.2"
  ],
  "notes": "Python: tests/test_channels/test_ai_empty_retry.py::test_a_failure_before_any_round_is_the_turn_s_own_error.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "",
              "finish_reason": "MALFORMED_FUNCTION_CALL"
            },
            {
              "refuses": {
                "status": 401,
                "message": "invalid api key"
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "invalid api key"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "report": []
    },
    "timeline": {
      "room-1": [
        {
          "index": 0
        }
      ]
    }
  }
}
