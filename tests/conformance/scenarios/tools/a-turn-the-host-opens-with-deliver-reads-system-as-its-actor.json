{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-turn-the-host-opens-with-deliver-reads-system-as-its-actor",
  "title": "A tool of the turn the host opens with deliver reads system, the framework's own sender, as the turn's actor",
  "rules": [
    "§21.4"
  ],
  "requirements": [
    "RK-21.4-001",
    "RK-22.1-028"
  ],
  "notes": "deliver() writes its message under the framework's own sender, system (§10.4), and the turn it opens reads that id as its actor, not an empty one (RMK-1854). Python: channels/ai.py _turn_loop_ctx. core/_delivery_targets.py _publication.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "actor",
            "description": "The turn's actor.",
            "returns_actor": true
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "actor",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "Seen."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "deliver",
      "room_id": "room-1",
      "content": "Send the report.",
      "addressed_to": [
        "agent"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "\"system\""
            }
          ]
        }
      ]
    }
  }
}
