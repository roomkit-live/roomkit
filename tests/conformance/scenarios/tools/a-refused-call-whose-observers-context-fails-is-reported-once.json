{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-refused-call-whose-observers-context-fails-is-reported-once",
  "title": "A refused call whose ON_TOOL_CALL observers' context fails to build is still reported once by its tool_call framework event, its observers unrun",
  "rules": [
    "§9.3"
  ],
  "requirements": [
    "RK-9.3-095"
  ],
  "notes": "The room's read the observers' context starts with (load_room_context) fails once the call refused: the observer does not run, the model reads the call as it refused, and the tool_call framework event reports the call once. Partial: a cancelled call and a call an external handler ran are not observed, nor another channel than the AI channel's loop.",
  "setup": {
    "kit": {
      "store_faults": true
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "Done."
            }
          ],
          "streaming": false
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up",
            "refuses": "not for you",
            "gate": "tool"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "event_handlers": [
      {
        "event": "tool_call",
        "reactions": [
          {
            "repeat": true,
            "do": [
              {
                "call": "status.recent",
                "as": "reported"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look it up."
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "tool"
    },
    {
      "store_fault": "load_room_context",
      "fail": "the store is down"
    },
    {
      "open": "tool"
    },
    {
      "await": "turn",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "is_error": true
            }
          ]
        }
      ]
    },
    "hooks": {
      "audit": []
    },
    "actions": {
      "reported": [
        {}
      ]
    }
  }
}
