{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-compaction-keeps-the-turn-s-input",
  "title": "When the turn's input falls in the older half of the context, the compaction summarizes only the history before it and keeps the input and the rounds after it whole",
  "rules": [
    "§6.4"
  ],
  "notes": "Python's compaction_cut: the input at index 2 of 7 messages, before the half (3); the summary of messages[:2] joins the input.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a1"
            },
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "2"
                  }
                }
              ]
            },
            {
              "refuses": {
                "status": 400,
                "message": "the request was refused",
                "context_overflow": true
              }
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup_order",
            "description": "Find an order by its number",
            "parameters": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "string"
                }
              },
              "required": [
                "order"
              ]
            },
            "returns": "shipped"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "q1"
      },
      "metadata": {}
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "q2"
      },
      "metadata": {}
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {},
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "[Context compacted — earlier conversation summary]\n[user]: “q1”\n[assistant]: “a1”\n\nq2"
            },
            {
              "role": "assistant",
              "text": ""
            },
            {
              "role": "tool",
              "text": ""
            },
            {
              "role": "assistant",
              "text": ""
            },
            {
              "role": "tool",
              "text": ""
            }
          ]
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "content": {
            "type": "text",
            "body": "q1"
          }
        },
        {
          "index": 1,
          "type": "message",
          "content": {
            "type": "text",
            "body": "a1"
          }
        },
        {
          "index": 2,
          "type": "message",
          "content": {
            "type": "text",
            "body": "q2"
          }
        },
        {
          "index": 3,
          "type": "tool_call_start"
        },
        {
          "index": 4,
          "type": "tool_call_end"
        },
        {
          "index": 5,
          "type": "tool_call_start"
        },
        {
          "index": 6,
          "type": "tool_call_end"
        },
        {
          "index": 7,
          "type": "message",
          "content": {
            "type": "text",
            "body": "Done."
          }
        }
      ]
    }
  }
}
