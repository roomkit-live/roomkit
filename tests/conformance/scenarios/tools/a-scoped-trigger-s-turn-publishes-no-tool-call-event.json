{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-scoped-trigger-s-turn-publishes-no-tool-call-event",
  "title": "A turn whose trigger scopes its answers publishes nothing of its tool calls to the room's subscribers",
  "rules": [
    "§8.4"
  ],
  "notes": "Python: tests/test_turn_ephemerals_scope.py; turns/_owner_publish.py publish_frame: a turn whose answers do not reach the whole room publishes no ephemeral (RFC §8.4), as streaming/a-scoped-trigger-s-turn-publishes-no-reasoning shows for reasoning.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "x"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look a record up.",
            "parameters": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              }
            },
            "returns": "{\"found\": 1}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look it up."
        },
        "response_visibility": "intelligence"
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "tool_events": {
      "room-1": []
    }
  }
}
