{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-context-overflow-is-compacted-and-the-call-replayed-once",
  "title": "When a provider refuses a turn's request as a context too long for the model, whatever its words, the channel summarizes the older half of the context into the user message after it and replays the call once, which answers the turn",
  "rules": [
    "§6.4"
  ],
  "notes": "Python's _generate_stream_with_retry: the typed ProviderError.context_overflow is believed whatever the message says; _compact_context summarizes messages[:half] with summary_text and joins it ahead of the first kept user message (with_leading_text).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a1"
            },
            {
              "text": "a2"
            },
            {
              "refuses": {
                "status": 400,
                "message": "the request was refused",
                "context_overflow": true
              }
            },
            {
              "text": "Done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "q1"
      },
      "metadata": {}
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "q2"
      },
      "metadata": {}
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "q3"
      },
      "metadata": {}
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "q1"
            },
            {
              "role": "assistant",
              "text": "a1"
            },
            {
              "role": "user",
              "text": "q2"
            },
            {
              "role": "assistant",
              "text": "a2"
            },
            {
              "role": "user",
              "text": "q3"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "[Context compacted — earlier conversation summary]\n[user]: “q1”\n[assistant]: “a1”\n\nq2"
            },
            {
              "role": "assistant",
              "text": "a2"
            },
            {
              "role": "user",
              "text": "q3"
            }
          ]
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "content": {
            "type": "text",
            "body": "q1"
          }
        },
        {
          "index": 1,
          "type": "message",
          "content": {
            "type": "text",
            "body": "a1"
          }
        },
        {
          "index": 2,
          "type": "message",
          "content": {
            "type": "text",
            "body": "q2"
          }
        },
        {
          "index": 3,
          "type": "message",
          "content": {
            "type": "text",
            "body": "a2"
          }
        },
        {
          "index": 4,
          "type": "message",
          "content": {
            "type": "text",
            "body": "q3"
          }
        },
        {
          "index": 5,
          "type": "message",
          "content": {
            "type": "text",
            "body": "Done."
          }
        }
      ]
    }
  }
}
