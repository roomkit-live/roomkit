{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-call-s-result-is-previewed-on-the-realtime-in-500-characters",
  "title": "TOOL_CALL_END previews each call's result in its first 500 characters; the model reads it whole",
  "rules": [
    "§6.4",
    "§8.4"
  ],
  "notes": "Python: tests/test_ai_streaming_tool_events.py::test_streaming_tool_end_result_preview_capped; channels/_ai_events.py _RESULT_PREVIEW = 500, part.as_text()[:500]. A call's id is read under `id`, so it is normalized as `$e1`.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look a record up.",
            "parameters": {
              "type": "object"
            },
            "returns": ""
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look it up."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "tool_events": {
      "room-1": [
        {
          "type": "tool_call_start"
        },
        {
          "type": "tool_call_end",
          "tool_calls": [
            {
              "id": "$e1",
              "name": "lookup",
              "result": "",
              "status": "completed"
            }
          ]
        }
      ]
    },
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "$e1",
              "content": ""
            }
          ]
        }
      ]
    }
  }
}
