{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-cancel-outranks-the-force-stop",
  "title": "A cancel that comes while the last generation runs ends the turn cancelled, not force_stopped: someone chose",
  "rules": [
    "§6.4",
    "§21.3"
  ],
  "notes": "Python: channels/_ai_tools.py _repeated_call_guard, _reject_call, _channel_tool_handler; channels/_ai_streaming.py _round_stop_reason reads the cancel first.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "echo",
            "description": "Echo a value back.",
            "returns": "ok",
            "parameters": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            }
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "echo",
                  "arguments": {
                    "value": "x"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t2",
                  "name": "echo",
                  "arguments": {
                    "value": "x"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t3",
                  "name": "echo",
                  "arguments": {
                    "value": "x"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t4",
                  "name": "echo",
                  "arguments": {
                    "value": "x"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t5",
                  "name": "echo",
                  "arguments": {
                    "value": "x"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t6",
                  "name": "echo",
                  "arguments": {
                    "value": "x"
                  }
                }
              ]
            },
            {
              "gate": "last",
              "text": "Stopped."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "last"
    },
    {
      "call": "steer",
      "channel_id": "agent",
      "directive": {
        "type": "cancel",
        "reason": "stop"
      },
      "room_id": "room-1"
    },
    {
      "open": "last"
    },
    {
      "await": "turn",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "response": [
        {
          "trigger": "on_ai_response",
          "response": {
            "loop_end_reason": "cancelled"
          }
        }
      ]
    }
  }
}
