{
  "$schema": "../../scenario.schema.json",
  "id": "tools/an-empty-answer-with-no-round-before-it-is-not-asked-again",
  "title": "A generation that ends empty with no round of calls before it is a legitimately empty turn: whatever max_empty_retries says, no other generation",
  "rules": [
    "§6.4",
    "Appendix A.9"
  ],
  "notes": "Python: tests/test_channels/test_ai_empty_retry.py::test_no_retry_without_prior_tool.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": ""
            }
          ]
        },
        "max_empty_retries": 2
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "report": [
        {
          "trigger": "on_ai_response",
          "room_id": "room-1",
          "response": {
            "loop_end_reason": "completed"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": "Go."
              }
            }
          ]
        }
      ]
    }
  }
}
