{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-round-s-results-go-as-one-tool-message",
  "title": "A round's results go to the model as one tool message holding every result, in the turn and when a later turn replays the round",
  "rules": [
    "§6.4",
    "Appendix A.9"
  ],
  "notes": "Python's _execute_round_tools appends one role=tool message whose parts are the round's results ([*answered, *result_parts]), and _tool_history._round replays a round as two messages, its calls then its results.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                },
                {
                  "id": "c2",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "2"
                  }
                }
              ]
            },
            {
              "text": "Both shipped."
            },
            {
              "text": "Still shipped."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup_order",
            "description": "Find an order by its number",
            "parameters": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "string"
                }
              },
              "required": [
                "order"
              ]
            },
            "returns": "shipped"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Where are orders 1 and 2?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "And now?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "Where are orders 1 and 2?"
            },
            {
              "role": "assistant",
              "text": ""
            },
            {
              "role": "tool",
              "text": ""
            }
          ],
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "shipped",
              "is_error": false
            },
            {
              "tool_call_id": "c2",
              "content": "shipped",
              "is_error": false
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Where are orders 1 and 2?"
            },
            {
              "role": "assistant",
              "text": ""
            },
            {
              "role": "tool",
              "text": ""
            },
            {
              "role": "assistant",
              "text": "Both shipped."
            },
            {
              "role": "user",
              "text": "And now?"
            }
          ],
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "shipped",
              "is_error": false
            },
            {
              "tool_call_id": "c2",
              "content": "shipped",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
