{
  "$schema": "../../scenario.schema.json",
  "id": "tools/continuation-cancelled-generation-is-not-consulted-non-streaming",
  "title": "Cancelled generation is not consulted",
  "rules": [
    "§6.4",
    "§9.2"
  ],
  "requirements": [
    "RK-6.4-125",
    "RK-6.4-397",
    "RK-6.4-420"
  ],
  "notes": "Python: tests/test_continuation_policy.py and tests/test_continuation_policy_boundaries.py. The continuation observer records the exact arguments of the real AIChannel callable.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "continuation": {
          "prefix": "I will check",
          "nudge": "You announced a check: run it now."
        },
        "model": {
          "rounds": [
            {
              "text": "I will check the run.",
              "finish_reason": "stop",
              "gate": "answer"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "answer"
    },
    {
      "call": "steer",
      "room_id": "room-1",
      "channel_id": "agent",
      "directive": {
        "type": "cancel",
        "reason": "The user stopped it."
      },
      "expect": {
        "result": 1
      }
    },
    {
      "open": "answer"
    },
    {
      "await": "turn"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "continuations": {
      "agent": []
    },
    "models": {
      "agent": [
        {}
      ]
    },
    "hooks": {
      "report": [
        {
          "response": {
            "loop_end_reason": "cancelled"
          }
        }
      ]
    }
  }
}
