{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-narrowed-binding-s-turn-still-emits-its-framework-events",
  "title": "An agent whose binding's visibility narrows its answers publishes none of its tool calls' ephemerals, and its turn's framework events are emitted all the same",
  "rules": [
    "§8.2",
    "§8.4"
  ],
  "requirements": [
    "RK-8.4-036"
  ],
  "notes": "The binding's visibility intelligence keeps the turn's ephemerals from the room's subscribers (tools/a-narrowed-binding-s-turn-publishes-no-tool-call-events). The audience rule is for ephemerals only: the turn's BEFORE_AI_GENERATION decision and its ai_response are emitted as for any turn.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "x"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look a record up.",
            "parameters": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              }
            },
            "returns": "{\"found\": 1}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "visibility": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look it up."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "tool_events": {
      "room-1": []
    },
    "ai_events": {
      "room-1": [
        {
          "event": "before_ai_generation",
          "channel_id": "agent",
          "allowed": true
        },
        {
          "event": "ai_response",
          "channel_id": "agent",
          "tool_calls_count": 1
        }
      ]
    }
  }
}
