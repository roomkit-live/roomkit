{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-malformed-call-is-told-and-tried-again-on-the-first-round",
  "title": "A round that ends on a call its provider could not parse is told so and tried again, on the first round too: the model calls again, and the tool runs once",
  "rules": [
    "§6.4",
    "Appendix A.9"
  ],
  "notes": "Python: tests/test_channels/test_ai_empty_retry.py::test_a_malformed_call_is_told_and_retried_on_the_first_round[MALFORMED_FUNCTION_CALL].",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "",
              "finish_reason": "MALFORMED_FUNCTION_CALL"
            },
            {
              "text": "",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": "Done"
            }
          ]
        },
        "max_empty_retries": 1
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1,
          "type": "tool_call_start"
        },
        {
          "index": 2,
          "type": "tool_call_end"
        },
        {
          "index": 3,
          "content": {
            "body": "Done"
          },
          "metadata": {
            "loop_end_reason": "completed"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": "Go."
              }
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": "Go."
              }
            },
            {
              "role": "user",
              "text": "Your last tool call could not be parsed, so it did not run. Call the tool again with arguments that are valid JSON matching its parameters, or answer in plain text."
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": "Go."
              }
            },
            {
              "role": "user",
              "text": "Your last tool call could not be parsed, so it did not run. Call the tool again with arguments that are valid JSON matching its parameters, or answer in plain text."
            },
            {
              "role": "assistant",
              "text": ""
            },
            {
              "role": "tool",
              "text": ""
            }
          ],
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "found",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
