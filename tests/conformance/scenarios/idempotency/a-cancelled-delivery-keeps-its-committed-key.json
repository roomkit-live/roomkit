{
  "$schema": "../../scenario.schema.json",
  "id": "idempotency/a-cancelled-delivery-keeps-its-committed-key",
  "title": "Cancelling delivery while parsing stops its turn, but the message commits and a retry replays it without delivering again",
  "rules": [
    "§13.4",
    "§8.1",
    "§14.3"
  ],
  "notes": "Python: tests/test_delivery_cancel_turns.py::test_a_delivery_cancelled_before_its_commit_starts_no_turn; tests/test_idempotent_redelivery.py. RMK-1609.",
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "first"
        },
        "idempotency_key": "k",
        "delivery_key": "work"
      },
      "background": true,
      "as": "first"
    },
    {
      "wait_for": "parsing"
    },
    {
      "call": "cancel_delivery",
      "key": "work",
      "expect": {
        "result": 1
      }
    },
    {
      "open": "parsing"
    },
    {
      "await": "first",
      "expect": {
        "result": {
          "blocked": false,
          "reason": null,
          "duplicate": false,
          "event": {
            "id": "room-1#0",
            "index": 0
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "ignored"
        },
        "idempotency_key": "k"
      },
      "expect": {
        "result": {
          "blocked": false,
          "reason": null,
          "duplicate": true,
          "event": {
            "id": "room-1#0",
            "index": 0
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "type": "text",
            "body": "first"
          }
        }
      ]
    },
    "rooms": {
      "room-1": {
        "event_count": 1,
        "latest_index": 0
      }
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "index": 0
          }
        ]
      }
    },
    "turns": {
      "room-1": {
        "ai": []
      }
    }
  },
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "parse": [
          {
            "gate": "parsing"
          }
        ]
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ]
  }
}
