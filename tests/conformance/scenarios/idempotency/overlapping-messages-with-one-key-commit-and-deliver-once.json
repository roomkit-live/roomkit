{
  "$schema": "../../scenario.schema.json",
  "id": "idempotency/overlapping-messages-with-one-key-commit-and-deliver-once",
  "title": "Two overlapping messages carrying one key return the same committed event, with one hook pass and one delivery",
  "rules": [
    "§13.4",
    "§8.1",
    "§14.3"
  ],
  "notes": "Python: tests/test_framework.py::TestIdempotencyRace::test_concurrent_duplicate_only_stores_once. RMK-1609.",
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "first"
        },
        "idempotency_key": "k"
      },
      "background": true,
      "as": "first"
    },
    {
      "wait_for": "checked"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "ignored"
        },
        "idempotency_key": "k"
      },
      "background": true,
      "as": "again"
    },
    {
      "wait_for_lock": "room-1"
    },
    {
      "open": "checked"
    },
    {
      "await": "first",
      "expect": {
        "result": {
          "blocked": false,
          "reason": null,
          "duplicate": false,
          "event": {
            "id": "room-1#0",
            "index": 0
          }
        }
      }
    },
    {
      "await": "again",
      "expect": {
        "result": {
          "blocked": false,
          "reason": null,
          "duplicate": true,
          "event": {
            "id": "room-1#0",
            "index": 0
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "next"
        },
        "idempotency_key": "next"
      },
      "expect": {
        "result": {
          "blocked": false,
          "reason": null,
          "duplicate": false,
          "event": {
            "id": "room-1#1",
            "index": 1
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "type": "text",
            "body": "first"
          }
        },
        {
          "index": 1,
          "content": {
            "type": "text",
            "body": "next"
          }
        }
      ]
    },
    "rooms": {
      "room-1": {
        "event_count": 2,
        "latest_index": 1
      }
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "index": 0
          },
          {
            "index": 1
          }
        ]
      }
    },
    "hooks": {
      "check": [
        {
          "event": {
            "content": {
              "type": "text",
              "body": "first"
            }
          }
        },
        {
          "event": {
            "content": {
              "type": "text",
              "body": "next"
            }
          }
        }
      ]
    }
  },
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "check",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "gate": "checked"
          }
        ]
      }
    ]
  }
}
