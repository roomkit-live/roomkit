{
  "$schema": "../../scenario.schema.json",
  "id": "idempotency/a-key-belongs-to-its-room-and-source-channel",
  "title": "A key belongs to its room and source channel; a replay returns that event and consumes no new index",
  "rules": [
    "§13.4",
    "§8.1",
    "§14.3"
  ],
  "notes": "Python: tests/test_idempotent_redelivery.py. RMK-1609.",
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "first"
        },
        "idempotency_key": "k"
      },
      "expect": {
        "result": {
          "blocked": false,
          "reason": null,
          "duplicate": false,
          "event": {
            "id": "room-1#0",
            "index": 0
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "changed"
        },
        "idempotency_key": "k"
      },
      "expect": {
        "result": {
          "blocked": false,
          "reason": null,
          "duplicate": false,
          "event": {
            "id": "room-2#0",
            "index": 0
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "other channel"
        },
        "idempotency_key": "k"
      },
      "expect": {
        "result": {
          "blocked": false,
          "reason": null,
          "duplicate": false,
          "event": {
            "id": "room-1#1",
            "index": 1
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "ignored"
        },
        "idempotency_key": "k"
      },
      "expect": {
        "result": {
          "blocked": false,
          "reason": null,
          "duplicate": true,
          "event": {
            "id": "room-1#0",
            "index": 0
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "ignored again"
        },
        "idempotency_key": "k"
      },
      "expect": {
        "result": {
          "blocked": false,
          "reason": null,
          "duplicate": true,
          "event": {
            "id": "room-1#1",
            "index": 1
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "new key"
        },
        "idempotency_key": "other"
      },
      "expect": {
        "result": {
          "blocked": false,
          "reason": null,
          "duplicate": false,
          "event": {
            "id": "room-1#2",
            "index": 2
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "first"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "other channel"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "new key"
          }
        }
      ],
      "room-2": [
        {
          "content": {
            "type": "text",
            "body": "changed"
          }
        }
      ]
    },
    "rooms": {
      "room-1": {
        "event_count": 3,
        "latest_index": 2
      },
      "room-2": {
        "event_count": 1,
        "latest_index": 0
      }
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "index": 0
          },
          {
            "index": 2
          }
        ]
      },
      "room-2": {
        "ws": [
          {
            "index": 0
          }
        ]
      }
    }
  },
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  }
}
