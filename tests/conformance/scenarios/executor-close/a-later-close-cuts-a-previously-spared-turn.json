{
  "$schema": "../../scenario.schema.json",
  "id": "executor-close/a-later-close-cuts-a-previously-spared-turn",
  "title": "A later external close cuts a turn that its own close had spared",
  "rules": [
    "§10.6.7",
    "§10.6.8"
  ],
  "notes": "Python: tests/test_executor_close_contract.py::test_later_external_close_cuts_a_turn_previously_spared_by_its_own_close. Exemptions apply to each close call, not to the lifetime of a turn.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "transport",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "kit_executor.hook",
      "hook": {
        "name": "lifecycle",
        "trigger": "before_ai_generation",
        "reactions": [
          {
            "do": [
              {
                "call": "kit_executor.close",
                "expect": {
                  "result": null
                }
              }
            ]
          }
        ]
      }
    },
    {
      "call": "kit_executor.hook",
      "hook": {
        "name": "after-close",
        "trigger": "before_ai_generation",
        "priority": 10,
        "reactions": [
          {
            "gate": "closed-inside"
          }
        ]
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "closed-inside"
    },
    {
      "call": "kit_executor.close"
    },
    {
      "await": "turn",
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$present": true
          }
        }
      }
    },
    {
      "call": "kit_executor.closed",
      "expect": {
        "result": true
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "type": "text",
            "body": "hello"
          }
        }
      ]
    },
    "models": {
      "agent": []
    }
  }
}
