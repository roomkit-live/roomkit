{
  "$schema": "../../scenario.schema.json",
  "id": "executor-close/closing-from-a-turn-cuts-another",
  "title": "A turn closing its local executor finishes while another room's turn is cut",
  "rules": [
    "§10.6.7",
    "§10.6.8"
  ],
  "notes": "Python: TurnExecutor._close excludes turns_run_under, but cancels other active turns.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "transport",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "kit_executor.hook",
      "hook": {
        "name": "lifecycle",
        "trigger": "before_ai_generation",
        "reactions": [
          {
            "gate": "entered"
          },
          {
            "do": [
              {
                "call": "kit_executor.close",
                "expect": {
                  "result": null
                }
              }
            ]
          }
        ]
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "background": true,
      "as": "other"
    },
    {
      "wait_for": "entered"
    },
    {
      "call": "process_inbound",
      "room_id": "r2",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "await": "other",
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$present": true
          }
        }
      }
    },
    {
      "call": "kit_executor.closed",
      "expect": {
        "result": true
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "type": "text",
            "body": "hello"
          }
        }
      ],
      "r2": [
        {
          "content": {
            "type": "text",
            "body": "hello"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "answer"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {}
      ]
    }
  }
}
