{
  "$schema": "../../scenario.schema.json",
  "id": "skill-gating/room-activation-persists-but-a-standalone-turn-starts-closed-non-streaming",
  "title": "A later room turn inherits activation while a standalone turn must activate for itself (non-streaming)",
  "rules": [
    "§24.2",
    "§24.4",
    "§21.1",
    "§10.1.1"
  ],
  "requirements": [
    "RK-10.1.1-030",
    "RK-21.1-042",
    "RK-24.3-037",
    "RK-24.4-002",
    "RK-24.4-014",
    "RK-24.4-017"
  ],
  "notes": "Python: tests/test_skills_integration.py::test_gated_tools_stay_visible_on_later_turns; channels/_ai_policy.py::_activated_skill_names. RFC §10.1.1: standalone turns do not borrow room activation.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": false,
        "audit": "tool_auditor",
        "tools": [
          {
            "name": "search_web",
            "description": "search web",
            "parameters": {
              "type": "object"
            },
            "returns": "search_web ran"
          },
          {
            "name": "fetch_v1",
            "description": "fetch v1",
            "parameters": {
              "type": "object"
            },
            "returns": "fetch_v1 ran"
          },
          {
            "name": "safe_read",
            "description": "safe read",
            "parameters": {
              "type": "object"
            },
            "returns": "safe_read ran"
          }
        ],
        "skills": [
          {
            "name": "research",
            "description": "research procedure",
            "instructions": "Rules for research.",
            "allowed_tools": [
              "search_*",
              "fetch_v?"
            ]
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "activate_skill",
                  "arguments": {
                    "name": "research"
                  }
                }
              ]
            },
            {
              "text": "done"
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "search_web",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "done"
            },
            {
              "calls": [
                {
                  "id": "c3",
                  "name": "search_web",
                  "arguments": {}
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c4",
                  "name": "activate_skill",
                  "arguments": {
                    "name": "research"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c5",
                  "name": "search_web",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        },
        "event_type": "instruction",
        "addressed_to": [
          "agent"
        ],
        "standalone": true
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "search_web": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "search_web": {
              "$present": true
            }
          }
        },
        {
          "tools": {
            "search_web": {
              "$present": true
            }
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$contains": "Rules for research."
              },
              "is_error": false
            },
            {
              "tool_call_id": "c2",
              "content": "search_web ran",
              "is_error": false
            }
          ]
        },
        {
          "tools": {
            "search_web": {
              "$absent": true
            }
          },
          "system_prompt": {
            "$lacks": "Rules for research."
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c3",
              "content": "{\"error\": \"Tool 'search_web' is gated by a skill. Activate the skill first using activate_skill.\"}",
              "is_error": true
            }
          ]
        },
        {
          "tools": {
            "search_web": {
              "$present": true
            }
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c3",
              "content": "{\"error\": \"Tool 'search_web' is gated by a skill. Activate the skill first using activate_skill.\"}",
              "is_error": true
            },
            {
              "tool_call_id": "c4",
              "content": {
                "$contains": "Rules for research."
              },
              "is_error": false
            },
            {
              "tool_call_id": "c5",
              "content": "search_web ran",
              "is_error": false
            }
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": [
        {
          "tool_name": "search_web",
          "status": "ok",
          "result": "search_web ran"
        },
        {
          "tool_name": "search_web",
          "status": "ok",
          "result": "search_web ran"
        }
      ]
    }
  }
}
