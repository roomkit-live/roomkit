{
  "$schema": "../../scenario.schema.json",
  "id": "skill-gating/tool-search-keeps-an-activated-held-tool-unreferenced-until-found-non-streaming",
  "title": "Activation does not bypass Tool Search when the provider holds deferred tools (non-streaming)",
  "rules": [
    "§24.2",
    "§24.4",
    "§21.1"
  ],
  "requirements": [
    "RK-24.3-037",
    "RK-24.4-017"
  ],
  "notes": "Python: tests/test_deferred_tools.py::test_an_activation_references_only_what_it_would_have_shown. Held definitions are stable; only a discovery result references the tool Tool Search had hidden.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": true,
        "audit": "tool_auditor",
        "tools": [
          {
            "name": "search_web",
            "description": "search web",
            "parameters": {
              "type": "object"
            },
            "returns": "search_web ran"
          },
          {
            "name": "fetch_v1",
            "description": "fetch v1",
            "parameters": {
              "type": "object"
            },
            "returns": "fetch_v1 ran"
          },
          {
            "name": "safe_read",
            "description": "safe read",
            "parameters": {
              "type": "object"
            },
            "returns": "safe_read ran"
          }
        ],
        "skills": [
          {
            "name": "research",
            "description": "research procedure",
            "instructions": "Rules for research.",
            "allowed_tools": [
              "search_*",
              "fetch_v?"
            ]
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "activate_skill",
                  "arguments": {
                    "name": "research"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "find_tools",
                  "arguments": {
                    "query": "search web"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c3",
                  "name": "search_web",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "deferred_tools": true,
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "deferred_tools": [
            "search_web",
            "fetch_v1",
            "safe_read"
          ]
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$contains": "Rules for research."
              },
              "is_error": false,
              "references": []
            }
          ],
          "deferred_tools": [
            "search_web",
            "fetch_v1",
            "safe_read"
          ]
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$contains": "Rules for research."
              },
              "is_error": false,
              "references": []
            },
            {
              "tool_call_id": "c2",
              "content": {
                "$contains": "search_web"
              },
              "is_error": false,
              "references": [
                "search_web"
              ]
            }
          ],
          "deferred_tools": [
            "search_web",
            "fetch_v1",
            "safe_read"
          ]
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$contains": "Rules for research."
              },
              "is_error": false
            },
            {
              "tool_call_id": "c2",
              "content": {
                "$contains": "search_web"
              },
              "is_error": false
            },
            {
              "tool_call_id": "c3",
              "content": "search_web ran",
              "is_error": false
            }
          ],
          "deferred_tools": [
            "search_web",
            "fetch_v1",
            "safe_read"
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": [
        {
          "tool_name": "search_web",
          "status": "ok",
          "result": "search_web ran"
        }
      ]
    }
  }
}
