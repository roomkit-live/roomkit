{
  "$schema": "../../scenario.schema.json",
  "id": "skill-gating/each-turn-uses-its-configured-gates-non-streaming",
  "title": "A turn registry replaces the channel registry for visibility and execution (non-streaming)",
  "rules": [
    "§24.2",
    "§24.4",
    "§21.1"
  ],
  "notes": "Python: channels/_ai_policy.py::_turn_skills, _gated_tool_names; tests/test_skills_integration.py per-turn configuration; existing shared skills/a-turn-lists-and-activates-its-own-skills.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": false,
        "audit": "tool_auditor",
        "tools": [
          {
            "name": "search_web",
            "description": "search web",
            "parameters": {
              "type": "object"
            },
            "returns": "search_web ran"
          },
          {
            "name": "fetch_v1",
            "description": "fetch v1",
            "parameters": {
              "type": "object"
            },
            "returns": "fetch_v1 ran"
          },
          {
            "name": "safe_read",
            "description": "safe read",
            "parameters": {
              "type": "object"
            },
            "returns": "safe_read ran"
          }
        ],
        "skills": [
          {
            "name": "research",
            "description": "research procedure",
            "instructions": "Rules for research.",
            "allowed_tools": "search_*"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "done"
            },
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "search_web"
                },
                {
                  "id": "c2",
                  "name": "fetch_v1"
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": false
        },
        "config_provider": {
          "r1": [
            {},
            {
              "skills": [
                {
                  "name": "fetcher",
                  "description": "fetcher procedure",
                  "instructions": "Rules for fetcher.",
                  "allowed_tools": "fetch_*"
                }
              ]
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "fetch_v1": {
              "$present": true
            },
            "search_web": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "search_web": {
              "$present": true
            },
            "fetch_v1": {
              "$absent": true
            }
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "search_web ran",
              "is_error": false
            },
            {
              "tool_call_id": "c2",
              "content": "{\"error\": \"Tool 'fetch_v1' is gated by a skill. Activate the skill first using activate_skill.\"}",
              "is_error": true
            }
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": [
        {
          "tool_name": "search_web",
          "status": "ok",
          "result": "search_web ran"
        }
      ]
    }
  }
}
