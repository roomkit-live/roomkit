{
  "$schema": "../../scenario.schema.json",
  "id": "skill-gating/activation-opens-the-next-round-and-its-hook-catalogue-non-streaming",
  "title": "A served activation opens the tools in the next provider request and hook toolsets (non-streaming)",
  "rules": [
    "§24.2",
    "§24.4",
    "§21.1"
  ],
  "requirements": [
    "RK-21.1-021",
    "RK-21.1-042",
    "RK-24.3-037",
    "RK-24.4-017",
    "RK-6.4-227",
    "RK-6.4-257",
    "RK-6.4-397",
    "RK-6.7-111"
  ],
  "notes": "Python: tests/test_channels/test_ai_skill_gating.py::TestSkillGatingExecution::test_gated_tool_allowed_after_activation; channels/_ai_policy.py::_hook_toolset, _apply_tool_filters.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": false,
        "audit": "tool_auditor",
        "tools": [
          {
            "name": "search_web",
            "description": "search web",
            "parameters": {
              "type": "object"
            },
            "returns": "search_web ran"
          },
          {
            "name": "fetch_v1",
            "description": "fetch v1",
            "parameters": {
              "type": "object"
            },
            "returns": "fetch_v1 ran"
          },
          {
            "name": "safe_read",
            "description": "safe read",
            "parameters": {
              "type": "object"
            },
            "returns": "safe_read ran"
          }
        ],
        "skills": [
          {
            "name": "research",
            "description": "research procedure",
            "instructions": "Rules for research.",
            "allowed_tools": [
              "search_*",
              "fetch_v?"
            ]
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "search_web",
                  "arguments": {}
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "activate_skill",
                  "arguments": {
                    "name": "research"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c3",
                  "name": "search_web",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "generation",
        "trigger": "before_ai_generation"
      },
      {
        "name": "round",
        "trigger": "after_tool_round"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "safe_read": {
              "$present": true
            },
            "search_web": {
              "$absent": true
            },
            "fetch_v1": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "search_web": {
              "$absent": true
            }
          },
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"error\": \"Tool 'search_web' is gated by a skill. Activate the skill first using activate_skill.\"}",
              "is_error": true
            }
          ]
        },
        {
          "tools": {
            "search_web": {
              "$present": true
            },
            "fetch_v1": {
              "$present": true
            }
          },
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"error\": \"Tool 'search_web' is gated by a skill. Activate the skill first using activate_skill.\"}",
              "is_error": true
            },
            {
              "tool_call_id": "c2",
              "content": {
                "$contains": "Rules for research."
              },
              "is_error": false
            }
          ]
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"error\": \"Tool 'search_web' is gated by a skill. Activate the skill first using activate_skill.\"}",
              "is_error": true
            },
            {
              "tool_call_id": "c2",
              "content": {
                "$contains": "Rules for research."
              },
              "is_error": false
            },
            {
              "tool_call_id": "c3",
              "content": "search_web ran",
              "is_error": false
            }
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": [
        {
          "tool_name": "search_web",
          "status": "ok",
          "result": "search_web ran"
        }
      ]
    },
    "hooks": {
      "generation": [
        {
          "generation": {
            "tools": {
              "$unordered": [
                "safe_read",
                "activate_skill",
                "read_skill_reference"
              ]
            }
          }
        }
      ],
      "round": [
        {
          "tool_round": {
            "tools": {
              "$unordered": [
                "safe_read",
                "activate_skill",
                "read_skill_reference"
              ]
            }
          }
        },
        {
          "tool_round": {
            "tools": {
              "$unordered": [
                "search_web",
                "fetch_v1",
                "safe_read",
                "activate_skill",
                "read_skill_reference"
              ]
            }
          }
        },
        {
          "tool_round": {
            "tools": {
              "$unordered": [
                "search_web",
                "fetch_v1",
                "safe_read",
                "activate_skill",
                "read_skill_reference"
              ]
            }
          }
        }
      ]
    }
  }
}
