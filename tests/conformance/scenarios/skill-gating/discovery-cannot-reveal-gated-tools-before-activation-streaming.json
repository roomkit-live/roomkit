{
  "$schema": "../../scenario.schema.json",
  "id": "skill-gating/discovery-cannot-reveal-gated-tools-before-activation-streaming",
  "title": "Tool Search lists and finds only reachable tools and starts finding a gated tool after activation (streaming)",
  "rules": [
    "§24.2",
    "§24.4",
    "§21.1"
  ],
  "requirements": [
    "RK-21.1-061",
    "RK-21.1-063"
  ],
  "notes": "Python: channels/_ai_policy.py::_reachable_tools and _apply_tool_filters; tests/test_toolset_edges.py discovery and activation assertions. Gating narrows the discovery catalogue before Tool Search applies its own visibility.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": true,
        "audit": "tool_auditor",
        "tools": [
          {
            "name": "search_web",
            "description": "search web",
            "parameters": {
              "type": "object"
            },
            "returns": "search_web ran"
          },
          {
            "name": "fetch_v1",
            "description": "fetch v1",
            "parameters": {
              "type": "object"
            },
            "returns": "fetch_v1 ran"
          },
          {
            "name": "safe_read",
            "description": "safe read",
            "parameters": {
              "type": "object"
            },
            "returns": "safe_read ran"
          }
        ],
        "skills": [
          {
            "name": "research",
            "description": "research procedure",
            "instructions": "Rules for research.",
            "allowed_tools": [
              "search_*",
              "fetch_v?"
            ]
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "list_tools",
                  "arguments": {}
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "find_tools",
                  "arguments": {
                    "query": "search"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c3",
                  "name": "activate_skill",
                  "arguments": {
                    "name": "research"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c4",
                  "name": "find_tools",
                  "arguments": {
                    "query": "search web"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c5",
                  "name": "search_web",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": true
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "search_web": {
              "$absent": true
            }
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$lacks": "search_web"
              },
              "is_error": false
            }
          ]
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$lacks": "search_web"
              },
              "is_error": false
            },
            {
              "tool_call_id": "c2",
              "content": {
                "$lacks": "search_web"
              },
              "is_error": false
            }
          ]
        },
        {},
        {
          "tools": {
            "search_web": {
              "$present": true
            }
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$lacks": "search_web"
              },
              "is_error": false
            },
            {
              "tool_call_id": "c2",
              "content": {
                "$lacks": "search_web"
              },
              "is_error": false
            },
            {
              "tool_call_id": "c3",
              "content": {
                "$contains": "Rules for research."
              },
              "is_error": false
            },
            {
              "tool_call_id": "c4",
              "content": {
                "$contains": "search_web"
              },
              "is_error": false
            },
            {
              "tool_call_id": "c5",
              "content": "search_web ran",
              "is_error": false
            }
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": [
        {
          "tool_name": "search_web",
          "status": "ok",
          "result": "search_web ran"
        }
      ]
    }
  }
}
