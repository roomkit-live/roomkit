{
  "$schema": "../../scenario.schema.json",
  "id": "anthropic/a-held-tool-called-without-search-references-itself",
  "title": "A held tool recovered by exact name references itself once its call answers",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_deferred_tools.py::test_a_held_tool_called_without_a_search_references_itself. RMK-1306.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look up.",
            "returns": "ok"
          },
          {
            "name": "track_shipment",
            "description": "Track a shipment.",
            "returns": "ok"
          },
          {
            "name": "refund",
            "description": "Refund an order.",
            "returns": "ok"
          }
        ],
        "model": {
          "deferred_tools": true,
          "rounds": [
            {
              "calls": [
                {
                  "id": "c0",
                  "name": "track_shipment"
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tool_search": true,
        "tool_search_pinned": [
          "lookup"
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "deferred_tools": [
            "track_shipment",
            "refund"
          ]
        },
        {
          "deferred_tools": [
            "track_shipment",
            "refund"
          ],
          "tool_results": [
            {
              "name": "track_shipment",
              "references": [
                "track_shipment"
              ]
            }
          ]
        }
      ]
    }
  }
}
