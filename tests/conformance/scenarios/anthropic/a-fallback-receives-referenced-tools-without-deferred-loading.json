{
  "$schema": "../../scenario.schema.json",
  "id": "anthropic/a-fallback-receives-referenced-tools-without-deferred-loading",
  "title": "A fallback without deferred loading receives revealed tools plainly and no native references",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_deferred_tools.py::test_a_fallback_that_cannot_hold_receives_what_the_turn_shows. RMK-1306.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look up.",
            "returns": "ok"
          },
          {
            "name": "track_shipment",
            "description": "Track a shipment.",
            "returns": "ok"
          },
          {
            "name": "refund",
            "description": "Refund an order.",
            "returns": "ok"
          }
        ],
        "model": {
          "deferred_tools": true,
          "rounds": [
            {
              "calls": [
                {
                  "id": "c0",
                  "name": "find_tools",
                  "arguments": {
                    "query": "track shipment",
                    "max_results": 1
                  }
                }
              ]
            },
            {
              "refuses": {
                "status": 529,
                "retryable": true,
                "message": "overloaded"
              }
            }
          ]
        },
        "tool_search": true,
        "tool_search_pinned": [
          "lookup"
        ],
        "retry_policy": {
          "max_retries": 0
        },
        "fallback_model": {
          "rounds": [
            {
              "text": "Done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent/fallback": [
        {
          "deferred_tools": [],
          "tools": {
            "track_shipment": {
              "$present": true
            },
            "refund": {
              "$absent": true
            }
          },
          "tool_results": [
            {
              "name": "find_tools",
              "references": []
            }
          ]
        }
      ]
    }
  }
}
