{
  "$schema": "../../scenario.schema.json",
  "id": "addressing/set-agent-response-policy-stops-an-agent-s-answer-asking-the-others",
  "title": "set_agent_response_policy sets what an agent's own output asks in a room from the next event on: under AGENT_CHAIN an agent's unaddressed answer asks the room's other agents, under ADDRESSED_ONLY it asks none; setting the policy a room holds changes nothing, and a missing room is refused",
  "rules": [
    "§19.3.1",
    "§17.2"
  ],
  "notes": "Python: tests/test_addressing.py::TestAgentResponsePolicy (test_the_policy_can_be_switched_on_a_live_room, test_setting_the_policy_it_already_has_is_a_no_op, test_setting_the_policy_on_a_missing_room_raises); core/mixins/room_lifecycle.py set_agent_response_policy, which writes the room's agent_response_policy under its lock and returns the room, unchanged when it holds the policy already. The first message asks a1; its answer asks a2, whose answer asks a1 again, which answers nothing more (addressing/an-address-names-the-agents-asked). Under ADDRESSED_ONLY, a1's answer to the second message asks a2 no more: a2, which answers a1 whenever asked, has no second turn.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "a1",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "@a1 hello"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "from a1"
                }
              }
            ]
          },
          {
            "when": {
              "text": "@a1 again"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "from a1 again"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "a2",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "source_channel_id": "a1"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "from a2"
                }
              }
            ],
            "repeat": true
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "organization_id": "acme",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "a1"
          },
          {
            "channel_id": "a2"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "set_agent_response_policy",
      "room_id": "room-1",
      "policy": "agent_chain",
      "expect": {
        "result": {
          "id": "room-1",
          "agent_response_policy": "agent_chain"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "@a1 hello"
        },
        "addressed_to": [
          "a1"
        ]
      }
    },
    {
      "idle": true
    },
    {
      "call": "set_agent_response_policy",
      "room_id": "room-1",
      "policy": "addressed_only",
      "organization_id": "globex",
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "call": "set_agent_response_policy",
      "room_id": "room-1",
      "policy": "addressed_only",
      "organization_id": "acme",
      "expect": {
        "result": {
          "id": "room-1",
          "agent_response_policy": "addressed_only"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "@a1 again"
        },
        "addressed_to": [
          "a1"
        ]
      }
    },
    {
      "idle": true
    },
    {
      "call": "set_agent_response_policy",
      "room_id": "nope",
      "policy": "addressed_only",
      "expect": {
        "error": "room_not_found"
      }
    }
  ],
  "expect": {
    "rooms": {
      "room-1": {
        "agent_response_policy": "addressed_only"
      }
    },
    "turns": {
      "room-1": {
        "a1": [
          {
            "id": "room-1#0"
          },
          {
            "id": "room-1#2"
          },
          {
            "id": "room-1#3"
          }
        ],
        "a2": [
          {
            "id": "room-1#1"
          }
        ]
      }
    },
    "timeline": {
      "room-1": [
        {
          "addressed_to": [
            "a1"
          ]
        },
        {
          "source": {
            "channel_id": "a1"
          }
        },
        {
          "source": {
            "channel_id": "a2"
          }
        },
        {
          "addressed_to": [
            "a1"
          ],
          "content": {
            "type": "text",
            "body": "@a1 again"
          }
        },
        {
          "source": {
            "channel_id": "a1"
          },
          "responds_to": "room-1#3",
          "content": {
            "type": "text",
            "body": "from a1 again"
          }
        }
      ]
    }
  }
}
