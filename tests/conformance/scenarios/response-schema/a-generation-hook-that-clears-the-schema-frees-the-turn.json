{
  "$schema": "../../scenario.schema.json",
  "id": "response-schema/a-generation-hook-that-clears-the-schema-frees-the-turn",
  "title": "A BEFORE_AI_GENERATION hook that hands back a context whose response schema it cleared frees the turn: the request carries none, and the prose answer is stored",
  "rules": [
    "§6.7",
    "§9.3"
  ],
  "notes": "Python: channels/_ai_generation.py returns the hook's ai_context, which the turn runs on (_ai_streaming.py); tests/test_response_schema.py TestAIContextField::test_model_copy_can_clear_it.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "response_schema": {
          "type": "object",
          "properties": {
            "department": {
              "type": "string",
              "enum": [
                "billing",
                "other"
              ]
            }
          },
          "required": [
            "department"
          ],
          "additionalProperties": false
        },
        "model": {
          "response_schema": true,
          "rounds": [
            {
              "text": "Sure, billing."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "schema",
        "trigger": "before_ai_generation",
        "priority": 0,
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "response_schema": null
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "response_schema": null
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1,
          "type": "message",
          "content": {
            "body": "Sure, billing."
          }
        }
      ]
    }
  }
}
