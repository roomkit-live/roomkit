{
  "$schema": "../../scenario.schema.json",
  "id": "response-schema/a-schema-turn-its-round-cap-cuts-fails-truncated",
  "title": "A turn under a response schema whose tool loop its round cap stops has no document to deliver: it fails truncated, ON_ERROR fires once, and no response is reported",
  "rules": [
    "§6.7",
    "Appendix A.9",
    "§9.2"
  ],
  "notes": "Python: tests/test_channels/test_ai_response_schema.py TestToolLoopCutShort::test_the_turn_raises_truncated; tests/test_turn_that_did_not_complete.py::test_a_schema_turn_cut_short_reports_nothing_in_either_loop.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "response_schema": {
          "type": "object",
          "properties": {
            "department": {
              "type": "string",
              "enum": [
                "billing",
                "other"
              ]
            }
          },
          "required": [
            "department"
          ],
          "additionalProperties": false
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "max_tool_rounds": 1,
        "model": {
          "response_schema": true,
          "response_schema_with_tools": true,
          "rounds": [
            {
              "text": "Let me look that up.",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": "Still looking.",
              "calls": [
                {
                  "id": "c2",
                  "name": "lookup"
                }
              ]
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "errors",
        "trigger": "on_error",
        "execution": "async"
      },
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "the tool loop stopped (max_rounds) before a final answer in the response schema"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "errors": [
        {
          "trigger": "on_error",
          "event": {
            "metadata": {
              "error": {
                "$contains": "max_rounds"
              }
            }
          }
        }
      ],
      "report": []
    }
  }
}
