{
  "$schema": "../../scenario.schema.json",
  "id": "response-schema/a-schema-turn-its-token-budget-stops-fails-truncated",
  "title": "A turn under a response schema whose token budget stops its loop after a round has no document to deliver: it fails truncated, naming the budget",
  "rules": [
    "§6.7",
    "§6.4",
    "Appendix A.9"
  ],
  "notes": "Python: tests/test_channels/test_turn_budget.py::test_a_schema_turn_stopped_by_its_budget_has_no_document.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "response_schema": {
          "type": "object",
          "properties": {
            "department": {
              "type": "string",
              "enum": [
                "billing",
                "other"
              ]
            }
          },
          "required": [
            "department"
          ],
          "additionalProperties": false
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "turn_budget_tokens": 100,
        "model": {
          "response_schema": true,
          "response_schema_with_tools": true,
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ],
              "usage": {
                "input_tokens": 90,
                "output_tokens": 20
              }
            },
            {
              "text": "{\"department\": \"billing\"}"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "the tool loop stopped (budget_exceeded) before a final answer in the response schema"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "response_schema": {
            "type": "object",
            "properties": {
              "department": {
                "type": "string",
                "enum": [
                  "billing",
                  "other"
                ]
              }
            },
            "required": [
              "department"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  }
}
