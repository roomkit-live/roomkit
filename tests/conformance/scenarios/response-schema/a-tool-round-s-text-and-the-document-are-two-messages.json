{
  "$schema": "../../scenario.schema.json",
  "id": "response-schema/a-tool-round-s-text-and-the-document-are-two-messages",
  "title": "On a model that takes a schema beside tools, a round that calls a tool is a step of the loop, not checked: its text reaches the room as its own message, and the final answer, checked, as the turn's last",
  "rules": [
    "§6.7",
    "Appendix A.9"
  ],
  "notes": "Python: tests/test_channels/test_ai_response_schema.py TestTurn::test_tools_beside_the_schema_run_where_they_combine, TestToolRoundNarration::test_the_narration_and_the_document_are_separate_messages.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "response_schema": {
          "type": "object",
          "properties": {
            "department": {
              "type": "string",
              "enum": [
                "billing",
                "other"
              ]
            }
          },
          "required": [
            "department"
          ],
          "additionalProperties": false
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "model": {
          "response_schema": true,
          "response_schema_with_tools": true,
          "rounds": [
            {
              "text": "Let me look that up.",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": "{\"department\": \"billing\"}"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "response_schema": {
            "type": "object",
            "properties": {
              "department": {
                "type": "string",
                "enum": [
                  "billing",
                  "other"
                ]
              }
            },
            "required": [
              "department"
            ],
            "additionalProperties": false
          },
          "tools": {
            "lookup": 0
          }
        },
        {
          "response_schema": {
            "type": "object",
            "properties": {
              "department": {
                "type": "string",
                "enum": [
                  "billing",
                  "other"
                ]
              }
            },
            "required": [
              "department"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1,
          "type": "message",
          "content": {
            "body": "Let me look that up."
          }
        },
        {
          "index": 2,
          "type": "tool_call_start"
        },
        {
          "index": 3,
          "type": "tool_call_end"
        },
        {
          "index": 4,
          "type": "message",
          "content": {
            "body": "{\"department\": \"billing\"}"
          },
          "metadata": {
            "loop_end_reason": "completed"
          }
        }
      ]
    }
  }
}
