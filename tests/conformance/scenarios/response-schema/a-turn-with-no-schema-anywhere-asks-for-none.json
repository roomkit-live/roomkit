{
  "$schema": "../../scenario.schema.json",
  "id": "response-schema/a-turn-with-no-schema-anywhere-asks-for-none",
  "title": "A turn whose binding, configuration and agent set no response schema asks its model for none, and its prose is the answer, from a model that takes no schema",
  "rules": [
    "§6.7",
    "Appendix A.9"
  ],
  "notes": "Python: tests/test_channels/test_ai_response_schema.py TestResolution::test_no_schema_anywhere_leaves_the_turn_free.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Sure, the answer is yes."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "response_schema": null
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1,
          "type": "message",
          "content": {
            "body": "Sure, the answer is yes."
          }
        }
      ]
    }
  }
}
