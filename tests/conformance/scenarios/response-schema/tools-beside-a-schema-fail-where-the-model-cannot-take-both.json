{
  "$schema": "../../scenario.schema.json",
  "id": "response-schema/tools-beside-a-schema-fail-where-the-model-cannot-take-both",
  "title": "A turn with tools and a response schema, on a model that takes a schema but not beside tools, fails before any request, unsupported",
  "rules": [
    "§6.7",
    "Appendix A.9"
  ],
  "notes": "Python: tests/test_channels/test_ai_response_schema.py TestTurn::test_tools_beside_the_schema_fail_the_turn_where_they_cannot_combine.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "response_schema": {
          "type": "object",
          "properties": {
            "department": {
              "type": "string",
              "enum": [
                "billing",
                "other"
              ]
            }
          },
          "required": [
            "department"
          ],
          "additionalProperties": false
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "model": {
          "response_schema": true,
          "rounds": [
            {
              "text": "{\"department\": \"billing\"}"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "cannot combine a response schema with tools"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": []
    },
    "timeline": {
      "room-1": [
        {
          "index": 0
        }
      ]
    }
  }
}
