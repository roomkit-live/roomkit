{
  "$schema": "../../scenario.schema.json",
  "id": "response-schema/a-keyword-outside-the-portable-subset-fails-the-turn",
  "title": "A binding's response schema using anyOf, $ref or a numeric or string bound fails the turn before its model is asked; an answer that may be absent is a required field with an agreed empty value, which the turn takes",
  "rules": [
    "§6.7",
    "Appendix A.9"
  ],
  "requirements": [
    "RK-6.7-077"
  ],
  "notes": "Python: providers/ai/json_schema.py check_portable_schema; channels/ai.py _portable_schema reads a binding's schema as the turn reads its settings, before the model is asked; tests/test_channels/test_ai_response_schema.py TestResolution.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "response_schema": true,
          "rounds": [
            {
              "text": "{\"department\": \"billing\", \"note\": \"\", \"tags\": []}"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-any-of",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "metadata": {
              "response_schema": {
                "type": "object",
                "properties": {
                  "note": {
                    "type": "string",
                    "anyOf": [
                      {
                        "type": "string"
                      }
                    ]
                  }
                },
                "required": [
                  "note"
                ],
                "additionalProperties": false
              }
            }
          }
        ]
      },
      {
        "id": "room-ref",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "metadata": {
              "response_schema": {
                "type": "object",
                "properties": {
                  "card": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false,
                    "$ref": "#/card"
                  }
                },
                "required": [
                  "card"
                ],
                "additionalProperties": false
              }
            }
          }
        ]
      },
      {
        "id": "room-length",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "metadata": {
              "response_schema": {
                "type": "object",
                "properties": {
                  "note": {
                    "type": "string",
                    "maxLength": 80
                  }
                },
                "required": [
                  "note"
                ],
                "additionalProperties": false
              }
            }
          }
        ]
      },
      {
        "id": "room-minimum",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "metadata": {
              "response_schema": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "count"
                ],
                "additionalProperties": false
              }
            }
          }
        ]
      },
      {
        "id": "room-empty-answer",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "metadata": {
              "response_schema": {
                "type": "object",
                "properties": {
                  "department": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "department",
                  "note",
                  "tags"
                ],
                "additionalProperties": false
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-any-of",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "Value error, $.note: ['anyOf'] not portable on a 'string' schema"
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-ref",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "Value error, $.card: ['$ref'] not portable on a 'object' schema"
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-length",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "Value error, $.note: ['maxLength'] not portable on a 'string' schema"
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-minimum",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "Value error, $.count: ['minimum'] not portable on a 'integer' schema"
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-empty-answer",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "response_schema": {
            "type": "object",
            "properties": {
              "department": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "department",
              "note",
              "tags"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "timeline": {
      "room-any-of": [
        {
          "index": 0
        }
      ],
      "room-ref": [
        {
          "index": 0
        }
      ],
      "room-length": [
        {
          "index": 0
        }
      ],
      "room-minimum": [
        {
          "index": 0
        }
      ],
      "room-empty-answer": [
        {
          "index": 0
        },
        {
          "index": 1,
          "type": "message",
          "content": {
            "body": "{\"department\": \"billing\", \"note\": \"\", \"tags\": []}"
          }
        }
      ]
    }
  }
}
