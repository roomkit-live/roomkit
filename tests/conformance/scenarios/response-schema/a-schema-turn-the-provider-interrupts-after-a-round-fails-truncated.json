{
  "$schema": "../../scenario.schema.json",
  "id": "response-schema/a-schema-turn-the-provider-interrupts-after-a-round-fails-truncated",
  "title": "A turn under a response schema whose provider fails after a round of calls has no document to deliver: it fails truncated, and the interruption's marker is never stored as its answer",
  "rules": [
    "§6.7",
    "Appendix A.9",
    "§6.4"
  ],
  "notes": "Python: tests/test_turn_that_did_not_complete.py::test_a_schema_turn_the_provider_interrupts_fails_in_either_loop.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "response_schema": {
          "type": "object",
          "properties": {
            "department": {
              "type": "string",
              "enum": [
                "billing",
                "other"
              ]
            }
          },
          "required": [
            "department"
          ],
          "additionalProperties": false
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "model": {
          "response_schema": true,
          "response_schema_with_tools": true,
          "rounds": [
            {
              "text": "Let me check that.",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "refuses": {
                "status": 500,
                "message": "upstream 500"
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "the tool loop stopped (error) before a final answer in the response schema"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1,
          "type": "message",
          "content": {
            "body": "Let me check that."
          }
        },
        {
          "index": 2,
          "type": "tool_call_start"
        },
        {
          "index": 3,
          "type": "tool_call_end"
        }
      ]
    }
  }
}
