      {
        "id": "room-strings",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "metadata": {
              "response_schema": {
                "type": "object",
                "properties": {
                  "department": {
                    "type": "string",
                    "enum": [
                      "billing",
