                },
                "required": [
                  "department"
                ],
                "additionalProperties": false
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-number",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "Value error, $.count: ['enum'] not portable on a 'integer' schema"
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-empty",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "Value error, $.department: 'enum' must be a non-empty list of distinct strings"
