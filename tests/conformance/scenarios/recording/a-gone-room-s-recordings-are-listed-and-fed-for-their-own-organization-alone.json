{
  "$schema": "../../scenario.schema.json",
  "id": "recording/a-gone-room-s-recordings-are-listed-and-fed-for-their-own-organization-alone",
  "title": "Once a recording room's record is gone, its recordings are listed and fed a track for the organization they were started under, and refused to another",
  "rules": [
    "§12.11",
    "§17.2"
  ],
  "requirements": [
    "RK-12.11-036"
  ],
  "notes": "The live room is shown by recording/listing-or-feeding-a-room-s-recordings-for-another-organization-is-refused.",
  "requires_features": [
    "recording"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1",
        "organization_id": "acme"
      }
    ]
  },
  "steps": [
    {
      "call": "recording.start",
      "room_id": "r1",
      "recorder": "rec",
      "organization_id": "acme"
    },
    {
      "call": "store.delete_room",
      "room_id": "r1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "recording.list",
      "room_id": "r1",
      "organization_id": "globex",
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "call": "recording.track",
      "room_id": "r1",
      "track_id": "spy",
      "organization_id": "globex",
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "call": "recording.list",
      "room_id": "r1",
      "organization_id": "acme",
      "expect": {
        "result": [
          {
            "recording_id": "rec",
            "room_id": "r1"
          }
        ]
      }
    },
    {
      "call": "recording.track",
      "room_id": "r1",
      "track_id": "mic",
      "organization_id": "acme"
    },
    {
      "call": "recording.feed",
      "room_id": "r1",
      "track_id": "mic",
      "data": "AQI="
    },
    {
      "call": "recording.calls",
      "recorder": "rec",
      "expect": {
        "result": [
          {
            "call": "on_recording_start",
            "recording_id": "rec"
          },
          {
            "call": "on_track_added",
            "recording_id": "rec",
            "track": {
              "track_id": "mic"
            }
          },
          {
            "call": "on_data",
            "recording_id": "rec",
            "track_id": "mic",
            "data": "AQI="
          }
        ]
      }
    }
  ],
  "expect": {}
}
