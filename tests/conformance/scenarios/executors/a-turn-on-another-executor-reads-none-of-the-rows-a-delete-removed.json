            "id": "owner-1",
            "channel_id": "ws",
            "role": "owner",
            "status": "active"
          }
        ]
      }
    ],
    "executors": [
      {
        "id": "first",
        "hosts": [
          "agent"
        ]
      },
      {
        "id": "second",
        "hosts": [
          "agent"
        ],
        "started": false
      }
    ]
  },
  "steps": [
