{
  "$schema": "../../scenario.schema.json",
  "id": "executors/a-hook-on-an-executor-reads-the-room-when-it-fires",
  "title": "A hook on an executor reads the room as it is when it fires, not as its turn began",
  "rules": [
    "§10.6.6"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "declared": true,
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up",
            "returns": "fine",
            "gate": "held"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "executors": [
      {
        "id": "first",
        "hosts": [
          "agent"
        ],
        "hooks": [
          {
            "name": "audit",
            "trigger": "on_tool_call",
            "execution": "async"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "background": true,
      "as": "a"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "update_room_metadata",
      "room_id": "room-1",
      "metadata": {
        "during": "the turn"
      }
    },
    {
      "open": "held"
    },
    {
      "await": "a"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "audit": [
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "context_room": {
            "metadata": {
              "during": "the turn"
            }
          }
        }
      ]
    }
  }
}
