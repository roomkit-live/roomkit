          "previous": {
            "text": "",
            "want_to_say": [],
            "urgent": false
          }
        },
        {
          "previous": {
            "text": "They discuss the weather.",
            "want_to_say": [],
            "urgent": false
          }
        },
        {
          "previous": {
            "text": "",
            "want_to_say": [],
            "urgent": false
          }
        }
      ]
    },
    "timeline": {
      "r2": [
        {
          "content": {
            "type": "text",
            "body": "Hello."
          }
        },
        {
          "content": {
            "type": "text",
            "body": "From other."
          }
        }
      ]
