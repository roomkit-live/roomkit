    "executors": {
      "pool": {
        "$unordered": [
          {
            "call": "built",
            "channel_id": "agent",
            "build": 1
          },
          {
            "call": "on_event",
            "channel_id": "agent",
            "build": 1,
            "room_id": "r1"
          },
          {
            "call": "on_event",
            "channel_id": "agent",
            "build": 1,
            "room_id": "r1"
          },
          {
            "call": "built",
            "channel_id": "other",
            "build": 1
          },
          {
            "call": "close",
            "channel_id": "agent",
            "build": 1
