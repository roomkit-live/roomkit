{
  "$schema": "../../scenario.schema.json",
  "id": "executors/a-failed-state-discard-is-retried-before-the-next-turn",
  "title": "An executor retries a failed discard before running the room's next turn",
  "rules": [
    "§10.6.2"
  ],
  "requirements": [
    "RK-10.6.2-038"
  ],
  "notes": "Covers the retry after a failed discard. Eviction at the private ROOMS_KEPT = 10_000 bound is covered by the implementations' own tests: test_a_record_that_falls_out_drops_the_state_it_vouched_for in Python and a_record_that_falls_out_drops_the_state_it_vouched_for in Rust.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "coder",
        "type": "ai",
        "category": "intelligence",
        "declared": true,
        "on_event": [
          {
            "repeat": true,
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Done."
                }
              }
            ]
          }
        ],
        "on_room_detached": [
          {
            "fail": "discard failed"
          }
        ]
      }
    ],
    "executors": [
      {
        "id": "first",
        "hosts": [
          "coder"
        ]
      },
      {
        "id": "second",
        "hosts": [
          "coder"
        ],
        "started": false
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "coder",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "A."
        }
      }
    },
    {
      "call": "executor.pause",
      "executor": "first"
    },
    {
      "call": "executor.start",
      "executor": "second"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Away."
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Still away."
        }
      }
    },
    {
      "call": "executor.resume",
      "executor": "first"
    },
    {
      "call": "executor.close",
      "executor": "second"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Back."
        }
      }
    },
    {
      "call": "executor.calls",
      "executor": "first",
      "expect": {
        "result": [
          {
            "call": "built",
            "channel_id": "coder",
            "build": 1
          },
          {
            "call": "on_event",
            "channel_id": "coder",
            "room_id": "r1",
            "build": 1
          },
          {
            "call": "on_room_detached",
            "channel_id": "coder",
            "room_id": "r1",
            "build": 1
          }
        ]
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Retry."
        }
      }
    }
  ],
  "expect": {
    "executors": {
      "first": [
        {
          "call": "built",
          "channel_id": "coder",
          "build": 1
        },
        {
          "call": "on_event",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        },
        {
          "call": "on_room_detached",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        },
        {
          "call": "on_room_detached",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        },
        {
          "call": "on_event",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        }
      ]
    }
  }
}
