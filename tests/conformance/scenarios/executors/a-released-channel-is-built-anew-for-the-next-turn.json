{
  "$schema": "../../scenario.schema.json",
  "id": "executors/a-released-channel-is-built-anew-for-the-next-turn",
  "title": "A released channel's build is closed and the next turn runs on a new one",
  "rules": [
    "§10.6.3"
  ],
  "notes": "Python: tests/test_turns_channel_release.py test_a_released_channel_is_built_anew_for_the_next_turn_and_closed.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "coder",
        "type": "ai",
        "category": "intelligence",
        "declared": true
      }
    ],
    "executors": [
      {
        "id": "first",
        "hosts": [
          "coder"
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "coder",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "A."
        }
      }
    },
    {
      "call": "release_channel",
      "channel_id": "coder"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "B."
        }
      }
    }
  ],
  "expect": {
    "executors": {
      "first": {
        "$unordered": [
          {
            "call": "on_event",
            "channel_id": "coder",
            "room_id": "r1",
            "build": 1
          },
          {
            "call": "close",
            "channel_id": "coder",
            "build": 1
          },
          {
            "call": "built",
            "channel_id": "coder",
            "build": 2
          },
          {
            "call": "on_event",
            "channel_id": "coder",
            "room_id": "r1",
            "build": 2
          }
        ]
      }
    }
  }
}
