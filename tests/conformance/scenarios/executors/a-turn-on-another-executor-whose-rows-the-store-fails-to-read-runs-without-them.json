{
  "$schema": "../../scenario.schema.json",
  "id": "executors/a-turn-on-another-executor-whose-rows-the-store-fails-to-read-runs-without-them",
  "title": "A room's next turn on another executor, whose rows of the agent its owner's store fails to read, runs without them: its request holds the agent's earlier call neither in its history nor in its tool memory, and the agent answers",
  "rules": [
    "§10.6.5",
    "§6.4",
    "§14.1"
  ],
  "requirements": [
    "RK-10.6.5-039"
  ],
  "notes": "The agent's first turn, on the executor first, calls lookup (c1). The next turn runs on second, which never ran the agent in the room, so what it reads of the agent's own rows comes with its request, the channel_rows its owner reads for it (§10.6.5). That read fails once. The gate only orders the fault: it holds the turn at its first read of the room's events after the message's commit, which implementations make with different operations (get_timeline for the agent's latest tool rows, or list_events for the turn's messages). Once the step arms the fault, the next list_events fails: the read of the room's last message before the turn's history, which only the read of the rows makes. The failure costs the turn those rows, not the turn: its request replays the room's messages without c1, in its history and in its tool memory, and the agent answers. The unit's deleted row is executors/a-turn-on-another-executor-reads-none-of-the-rows-a-delete-removed. Python: tests/test_executor_without_store.py::test_a_store_that_fails_costs_the_turn_its_rows_not_the_turn; roomkit-rs: crates/roomkit/tests/remote_channel_rows.rs::one_failed_read_costs_the_remote_turn_its_rows.",
  "setup": {
    "kit": {
      "store_faults": true
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up",
            "parameters": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              }
            },
            "returns": "fine"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "first"
                  }
                }
              ]
            },
            {
              "text": "done"
            },
            {
              "text": "again"
            }
          ]
        },
        "declared": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "executors": [
      {
        "id": "first",
        "hosts": [
          "agent"
        ]
      },
      {
        "id": "second",
        "hosts": [
          "agent"
        ],
        "started": false
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "executor.close",
      "executor": "first"
    },
    {
      "call": "executor.start",
      "executor": "second"
    },
    {
      "store_fault": [
        "get_timeline",
        "list_events"
      ],
      "gate": "read"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "More."
        }
      },
      "background": true,
      "as": "more"
    },
    {
      "wait_for": "read"
    },
    {
      "store_fault": "list_events",
      "fail": "the store is down"
    },
    {
      "open": "read"
    },
    {
      "await": "more",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "type": "message",
          "content": {
            "body": "Go."
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_id": "c1"
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_id": "c1"
          }
        },
        {
          "type": "message",
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "body": "done"
          }
        },
        {
          "type": "message",
          "content": {
            "body": "More."
          }
        },
        {
          "type": "message",
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "body": "again"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {},
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "Go."
            },
            {
              "role": "assistant",
              "text": "done"
            },
            {
              "role": "user",
              "text": "More."
            }
          ],
          "tool_results": []
        }
      ]
    }
  }
}
