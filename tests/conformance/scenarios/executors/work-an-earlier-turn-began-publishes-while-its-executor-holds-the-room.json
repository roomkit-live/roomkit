{
  "$schema": "../../scenario.schema.json",
  "id": "executors/work-an-earlier-turn-began-publishes-while-its-executor-holds-the-room",
  "title": "A publication work an earlier turn began makes after a later turn of its room was sent to the same executor still reaches the room",
  "rules": [
    "§10.6.3",
    "§8.4"
  ],
  "requirements": [
    "RK-10.6.3-037"
  ],
  "notes": "Python: tests/test_turns_between.py test_a_publication_after_the_turn_reaches_the_owner_for_its_room_only; turns/_owner_publish.py. A.'s work waits at the gate, B.'s turn is sent and ends on first, which still holds the room's state, then A.'s publication names A.'s turn and is published.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "coder",
        "type": "ai",
        "category": "intelligence",
        "declared": true,
        "on_event": [
          {
            "when": {
              "text": "A."
            },
            "after_turn": [
              {
                "call": "channel.publish",
                "executor": "first",
                "channel_id": "coder",
                "room_id": "r1",
                "kind": "thinking_delta",
                "data": {
                  "thinking_length": 5,
                  "round": 0,
                  "channel_id": "coder"
                },
                "gate": "later",
                "as": "late"
              }
            ]
          }
        ]
      }
    ],
    "executors": [
      {
        "id": "first",
        "hosts": [
          "coder"
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "coder",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "A."
        }
      }
    },
    {
      "wait_for": "later"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "B."
        }
      }
    },
    {
      "open": "later"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "thinking_events": {
      "r1": [
        {
          "type": "thinking_delta",
          "channel_id": "coder",
          "round": 0
        }
      ]
    },
    "executors": {
      "first": [
        {
          "call": "built",
          "channel_id": "coder",
          "build": 1
        },
        {
          "call": "on_event",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        },
        {
          "call": "on_event",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        }
      ]
    }
  }
}
