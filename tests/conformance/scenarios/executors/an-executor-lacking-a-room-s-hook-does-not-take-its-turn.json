{
  "$schema": "../../scenario.schema.json",
  "id": "executors/an-executor-lacking-a-room-s-hook-does-not-take-its-turn",
  "title": "A turn whose room enabled a hook goes to an executor defining that hook, never to one lacking it",
  "rules": [
    "§10.6.6",
    "§10.6.7"
  ],
  "notes": "Python: tests/test_turns_control.py, tests/test_turns_backend.py test_an_event_no_executor_takes_names_the_room_hooks_it_needs. The executor lacking the hook is served first.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "coder",
        "type": "ai",
        "declared": true,
        "model": {
          "rounds": [
            {
              "text": "Audited."
            }
          ]
        }
      }
    ],
    "executors": [
      {
        "id": "plain",
        "hosts": [
          "coder"
        ]
      },
      {
        "id": "audited",
        "hosts": [
          "coder"
        ],
        "room_hooks": [
          {
            "name": "audit",
            "trigger": "before_tool_use"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "coder",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "enable_room_hook",
      "room_id": "r1",
      "name": "audit"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "type": "text",
            "body": "Go."
          }
        },
        {
          "content": {
            "type": "text",
            "body": "Audited."
          }
        }
      ]
    },
    "executors": {
      "plain": [],
      "audited": [
        {
          "call": "on_event",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        }
      ]
    }
  }
}
