{
  "$schema": "../../scenario.schema.json",
  "id": "executors/attach-and-detach-reach-every-executor-declaring-the-channel",
  "title": "A room's attach and detach of a declared channel reach every executor that declares it",
  "rules": [
    "§10.6.3"
  ],
  "notes": "Python: tests/test_turns_channel_control.py test_attach_and_detach_reach_every_executor_declaring_the_channel.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "coder",
        "type": "ai",
        "category": "intelligence",
        "declared": true
      }
    ],
    "executors": [
      {
        "id": "first",
        "hosts": [
          "coder"
        ]
      },
      {
        "id": "second",
        "hosts": [
          "coder"
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "attach_channel",
      "room_id": "r1",
      "channel_id": "coder",
      "category": "intelligence"
    },
    {
      "call": "detach_channel",
      "room_id": "r1",
      "channel_id": "coder"
    }
  ],
  "expect": {
    "executors": {
      "first": [
        {
          "call": "built",
          "channel_id": "coder",
          "build": 1
        },
        {
          "call": "on_room_attached",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        },
        {
          "call": "on_room_detached",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        }
      ],
      "second": [
        {
          "call": "built",
          "channel_id": "coder",
          "build": 1
        },
        {
          "call": "on_room_attached",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        },
        {
          "call": "on_room_detached",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        }
      ]
    }
  }
}
