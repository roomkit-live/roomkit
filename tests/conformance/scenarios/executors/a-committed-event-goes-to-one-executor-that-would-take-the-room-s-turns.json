{
  "$schema": "../../scenario.schema.json",
  "id": "executors/a-committed-event-goes-to-one-executor-that-would-take-the-room-s-turns",
  "title": "A discussion's committed message reaches a declared agent's memory once, through the one executor that would take the room's turns, the room's hook and organization included",
  "rules": [
    "§10.6.3",
    "§10.6.6",
    "§10.6.7",
    "§19.7.5 rule 3"
  ],
  "requirements": [
    "RK-10.6.3-022"
  ],
  "notes": "Python: tests/test_turns_between.py test_a_committed_event_goes_where_the_room_s_turns_would. Three executors declare ana: plain serves acme but lacks the room's hook, elsewhere defines the hook but serves globex, audited serves acme and defines it. Only audited would take ana's turns in r1, so only it builds ana, for the committed messages; nobody is asked a turn. bob, live, is offline in r1: the kit's own executor lacks the room's hook.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "ana",
        "type": "ai",
        "declared": true,
        "model": {
          "rounds": [
            {
              "text": "ana here."
            }
          ]
        },
        "memory": {}
      },
      {
        "id": "bob",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "bob here."
            }
          ]
        }
      }
    ],
    "executors": [
      {
        "id": "plain",
        "hosts": [
          "ana"
        ],
        "organizations": [
          "acme"
        ]
      },
      {
        "id": "elsewhere",
        "hosts": [
          "ana"
        ],
        "organizations": [
          "globex"
        ],
        "room_hooks": [
          {
            "name": "audit",
            "trigger": "before_tool_use"
          }
        ]
      },
      {
        "id": "audited",
        "hosts": [
          "ana"
        ],
        "organizations": [
          "acme"
        ],
        "room_hooks": [
          {
            "name": "audit",
            "trigger": "before_tool_use"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "organization_id": "acme",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "ana",
            "bob"
          ],
          "addressed_only": true
        }
      }
    ]
  },
  "steps": [
    {
      "call": "enable_room_hook",
      "room_id": "r1",
      "name": "audit"
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "the deploy is done"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "the customer is Acme"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "type": "text",
            "body": "the deploy is done"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "type": "text",
            "body": "the customer is Acme"
          }
        }
      ]
    },
    "ingested": {
      "r1": {
        "ana": [
          {
            "source": {
              "channel_id": "ops"
            },
            "content": {
              "body": "the deploy is done"
            }
          },
          {
            "source": {
              "channel_id": "ops"
            },
            "content": {
              "body": "the customer is Acme"
            }
          }
        ]
      }
    },
    "executors": {
      "plain": [],
      "elsewhere": [],
      "audited": [
        {
          "call": "built",
          "channel_id": "ana",
          "build": 1
        }
      ]
    }
  }
}
