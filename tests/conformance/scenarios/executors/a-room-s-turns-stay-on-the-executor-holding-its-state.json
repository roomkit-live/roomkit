{
  "$schema": "../../scenario.schema.json",
  "id": "executors/a-room-s-turns-stay-on-the-executor-holding-its-state",
  "title": "A room's turns of a channel stay on the executor that ran the last one, though another serves it too",
  "rules": [
    "§10.6.2",
    "§10.6.7"
  ],
  "notes": "Python: tests/test_turns_channel_control.py test_a_room_s_turns_stay_on_the_executor_holding_its_state. The others are served before and after it and paused for the room's first turn: which executor takes a first turn is left open, and a backend that ignored the holder would give the next turn to one of them.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "coder",
        "type": "ai",
        "declared": true,
        "model": {
          "rounds": [
            {
              "text": "One."
            },
            {
              "text": "Two."
            }
          ]
        }
      }
    ],
    "executors": [
      {
        "id": "before",
        "hosts": [
          "coder"
        ]
      },
      {
        "id": "holder",
        "hosts": [
          "coder"
        ]
      },
      {
        "id": "after",
        "hosts": [
          "coder"
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "coder",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "executor.pause",
      "executor": "before"
    },
    {
      "call": "executor.pause",
      "executor": "after"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "First."
        }
      }
    },
    {
      "call": "executor.resume",
      "executor": "before"
    },
    {
      "call": "executor.resume",
      "executor": "after"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Second."
        }
      }
    }
  ],
  "expect": {
    "executors": {
      "before": [],
      "holder": [
        {
          "call": "on_event",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        },
        {
          "call": "on_event",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        }
      ],
      "after": []
    }
  }
}
