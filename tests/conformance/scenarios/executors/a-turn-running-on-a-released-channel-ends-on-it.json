{
  "$schema": "../../scenario.schema.json",
  "id": "executors/a-turn-running-on-a-released-channel-ends-on-it",
  "title": "A turn running on a released channel ends on that build, which closes only then, and the next turn runs on a new one",
  "rules": [
    "§10.6.3"
  ],
  "notes": "Python: tests/test_turns_channel_release.py test_a_turn_running_on_a_released_channel_ends_on_it_before_it_closes.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "coder",
        "type": "ai",
        "category": "intelligence",
        "declared": true,
        "on_event": [
          {
            "when": {
              "text": "A."
            },
            "gate": "running",
            "do": [
              {
                "call": "executor.calls",
                "executor": "first",
                "expect": {
                  "result": [
                    {
                      "call": "on_event",
                      "channel_id": "coder",
                      "room_id": "r1",
                      "build": 1
                    }
                  ]
                }
              }
            ],
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Old."
                }
              }
            ]
          },
          {
            "when": {
              "text": "B."
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "New."
                }
              }
            ]
          }
        ]
      }
    ],
    "executors": [
      {
        "id": "first",
        "hosts": [
          "coder"
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "coder",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "A."
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "running"
    },
    {
      "call": "release_channel",
      "channel_id": "coder"
    },
    {
      "open": "running"
    },
    {
      "await": "turn"
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "B."
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "type": "text",
            "body": "A."
          }
        },
        {
          "content": {
            "type": "text",
            "body": "Old."
          }
        },
        {
          "content": {
            "type": "text",
            "body": "B."
          }
        },
        {
          "content": {
            "type": "text",
            "body": "New."
          }
        }
      ]
    },
    "executors": {
      "first": [
        {
          "call": "on_event",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        },
        {
          "call": "close",
          "channel_id": "coder",
          "build": 1
        },
        {
          "call": "built",
          "channel_id": "coder",
          "build": 2
        },
        {
          "call": "on_event",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 2
        }
      ]
    }
  }
}
