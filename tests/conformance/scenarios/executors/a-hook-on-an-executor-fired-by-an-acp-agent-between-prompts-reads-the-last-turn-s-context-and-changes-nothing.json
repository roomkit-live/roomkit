                      "options": [
                        {
                          "kind": "allow_once",
                          "name": "allow_once",
                          "optionId": "allow_once"
                        },
                        {
                          "kind": "reject_once",
                          "name": "reject_once",
                          "optionId": "reject_once"
                        }
                      ]
                    },
                    "updates": [
                      {
                        "sessionUpdate": "agent_message_chunk",
                        "content": {
                          "type": "text",
                          "text": "Read it."
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "updates": [
                  {
                    "sessionUpdate": "agent_message_chunk",
                    "content": {
                      "type": "text",
                      "text": "Again."
                    }
                  }
