    "executors": [
      {
        "id": "first",
        "hosts": [
          "claude"
        ],
        "hooks": [
          {
            "name": "seen",
            "trigger": "before_tool_use",
            "execution": "sync",
            "reactions": [
              {
                "do": [
                  {
                    "call": "current_turn_host",
                    "expect": {
                      "result": true
                    }
                  },
                  {
                    "call": "host.send_event",
                    "room_id": "r1",
                    "channel_id": "claude",
                    "content": {
                      "type": "text",
                      "body": "Read during the turn."
                    }
                  }
                ]
              },
              {
                "do": [
                  {
                    "call": "current_turn_host",
                    "expect": {
                      "result": false
                    }
                  }
                ],
                "after_do_gate": "seen"
              }
            ]
          }
        ]
      }
    ],
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "declared": true,
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
