{
  "$schema": "../../scenario.schema.json",
  "id": "executors/a-publication-from-an-executor-no-longer-holding-the-room-is-dropped",
  "title": "What an executor that no longer holds the room publishes after its turn does not reach the room",
  "rules": [
    "§10.6.3"
  ],
  "notes": "Python: tests/test_turns_between.py test_a_publication_from_an_executor_no_longer_holding_the_room_is_dropped.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "coder",
        "type": "ai",
        "category": "intelligence",
        "declared": true,
        "on_event": [
          {
            "when": {
              "text": "A."
            },
            "after_turn": [
              {
                "call": "channel.publish",
                "executor": "first",
                "channel_id": "coder",
                "room_id": "r1",
                "kind": "thinking_delta",
                "data": {
                  "thinking_length": 5,
                  "round": 0,
                  "channel_id": "coder"
                },
                "gate": "later",
                "as": "late"
              }
            ]
          }
        ]
      }
    ],
    "executors": [
      {
        "id": "first",
        "hosts": [
          "coder"
        ]
      },
      {
        "id": "second",
        "hosts": [
          "coder"
        ],
        "started": false
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "coder",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "A."
        }
      }
    },
    {
      "wait_for": "later"
    },
    {
      "call": "executor.pause",
      "executor": "first"
    },
    {
      "call": "executor.start",
      "executor": "second"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "B."
        }
      }
    },
    {
      "open": "later"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "thinking_events": {
      "r1": []
    },
    "executors": {
      "second": [
        {
          "call": "built",
          "channel_id": "coder",
          "build": 1
        },
        {
          "call": "on_event",
          "channel_id": "coder",
          "room_id": "r1",
          "build": 1
        }
      ]
    }
  }
}
