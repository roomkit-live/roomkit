{
  "$schema": "../../scenario.schema.json",
  "id": "executors/a-plan-a-build-let-go-held-reads-empty-at-its-next-build",
  "title": "A room's plan an agent made is shown in its next turn on the same build, and reads empty on the build its executor makes after letting the first go, as after a restart",
  "rules": [
    "§10.6.2",
    "§6.4"
  ],
  "requirements": [
    "RK-10.6.2-028"
  ],
  "notes": "Python: tests/test_task_planner.py; planning/missing-title-does-not-replace-the-plan-streaming for the plan shown in a request. A plan is session state of the build (§10.6.2): the owner does not carry it, so the build made after release_channel, which left the room's state with the same executor, reads no plan. The close runs apart from the turns, so the executor's list is matched in any order.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "declared": true,
        "enable_planning": true,
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "p0",
                  "name": "plan_tasks",
                  "arguments": {
                    "tasks": [
                      {
                        "title": "Keep",
                        "status": "pending"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "text": "Planned."
            },
            {
              "text": "Still planned."
            },
            {
              "text": "No plan here."
            }
          ]
        }
      }
    ],
    "executors": [
      {
        "id": "first",
        "hosts": [
          "agent"
        ]
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Plan it."
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Continue."
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "release_channel",
      "channel_id": "agent"
    },
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "And now?"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "messages": [
            "$any",
            "$any",
            "$any",
            "$any",
            {
              "role": "user",
              "text": {
                "$contains": [
                  "Continue.",
                  "## Current Task Plan",
                  "Keep"
                ]
              }
            }
          ]
        },
        {
          "messages": [
            "$any",
            "$any",
            "$any",
            "$any",
            "$any",
            "$any",
            {
              "role": "user",
              "text": {
                "$lacks": "Current Task Plan"
              }
            }
          ]
        }
      ]
    },
    "executors": {
      "first": {
        "$unordered": [
          {
            "call": "built",
            "channel_id": "agent",
            "build": 1
          },
          {
            "call": "on_event",
            "channel_id": "agent",
            "build": 1,
            "room_id": "r"
          },
          {
            "call": "on_event",
            "channel_id": "agent",
            "build": 1,
            "room_id": "r"
          },
          {
            "call": "close",
            "channel_id": "agent",
            "build": 1
          },
          {
            "call": "built",
            "channel_id": "agent",
            "build": 2
          },
          {
            "call": "on_event",
            "channel_id": "agent",
            "build": 2,
            "room_id": "r"
          }
        ]
      }
    }
  }
}
