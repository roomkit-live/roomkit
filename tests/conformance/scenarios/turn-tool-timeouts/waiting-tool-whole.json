{
  "$schema": "../../scenario.schema.json",
  "id": "turn-tool-timeouts/waiting-tool-whole",
  "title": "A turn bound applies to a tool that waits for a person by design (whole)",
  "rules": [
    "§21.6",
    "Appendix A.9"
  ],
  "requirements": [
    "RK-21.6-002",
    "RK-21.6-008",
    "RK-21.6-012",
    "RK-21.6-014",
    "RK-6.4-397",
    "RK-6.7-111"
  ],
  "notes": "Python: tests/test_turn_tool_timeouts.py::test_a_turn_bound_applies_to_a_tool_that_waits_by_design. The named turn bound applies ahead of the human-input handler timeout.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "ask_user",
                  "arguments": {
                    "question": "Color?"
                  }
                }
              ]
            },
            {
              "text": "Nobody answered."
            }
          ],
          "streaming": false
        },
        "human_input": {
          "tool_names": [
            "ask_user"
          ],
          "timeout_ms": 5000,
          "tools": [
            {
              "name": "ask_user",
              "description": "Ask the user.",
              "parameters": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "config_provider": {
          "room-1": {
            "tool_timeouts_ms": {
              "ask_user": 20
            }
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "asked",
        "trigger": "on_user_input_required"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "ops",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "asked": [
        {
          "trigger": "on_user_input_required",
          "room_id": "room-1",
          "request": {
            "pending_id": "$p1",
            "tool_name": "ask_user",
            "arguments": {
              "question": "Color?"
            },
            "room_id": "room-1",
            "tool_call_id": "c1",
            "channel_id": "agent",
            "channel_type": "ai"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"error\": \"Tool 'ask_user' failed (ToolTimeoutError)\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
