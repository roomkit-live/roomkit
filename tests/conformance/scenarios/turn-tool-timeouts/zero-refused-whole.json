{
  "$schema": "../../scenario.schema.json",
  "id": "turn-tool-timeouts/zero-refused-whole",
  "title": "A zero per-turn bound refuses the turn before asking its model (whole)",
  "rules": [
    "§21.6",
    "Appendix A.9"
  ],
  "requirements": [
    "RK-21.6-010",
    "RK-6.4-397"
  ],
  "notes": "Python: tests/test_tool_timeout.py::test_a_turns_bound_that_is_not_positive_fails_the_turn. Validation must fail before the model receives any request.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "report",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "The report took too long."
            }
          ],
          "streaming": false
        },
        "tools": [
          {
            "name": "report",
            "description": "Build the report",
            "parameters": {
              "type": "object",
              "properties": {}
            },
            "hangs": true
          }
        ],
        "config_provider": {
          "room-1": {
            "tool_timeouts_ms": {
              "report": 0
            }
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": []
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Run the report."
        }
      },
      "expect": {
        "result": {
          "delivery_results": {
            "agent": {
              "status": "failed",
              "error": {
                "code": "ValueError",
                "message": {
                  "$contains": "tool timeout for 'report' must be positive or None"
                }
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": []
    },
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message"
        }
      ]
    }
  }
}
