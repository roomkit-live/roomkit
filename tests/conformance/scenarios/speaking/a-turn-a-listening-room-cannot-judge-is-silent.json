{
  "$schema": "../../scenario.schema.json",
  "id": "speaking/a-turn-a-listening-room-cannot-judge-is-silent",
  "title": "While the room listens, a turn the classifier policy cannot judge is a final silence: a turn with no text, which no classifier call judges, and a turn whose classifier call fails",
  "rules": [
    "§6.4",
    "§6.8"
  ],
  "requirements": [
    "RK-6.4-160",
    "RK-6.4-167"
  ],
  "notes": "After Alice's request to only listen, she sends a message with no text, then a question whose classifier call fails: each is a final silence reporting `listening`, and no turn runs. RK-6.4-160 is cited for its exception, a room that listens; the open room is speaking/a-classifier-that-fails-lets-the-agent-speak-in-an-open-room. Python: speaking/classifier.py ClassifierSpeakPolicy.decide.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "speak_policy": {
          "classifier": {
            "calls": [
              {
                "answers": {
                  "listen_request": 0.9
                }
              },
              {
                "fail": "the classifier is down"
              }
            ]
          },
          "agent_name": "Nova"
        },
        "model": {
          "rounds": [
            {
              "text": "unused"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "participants": [
          {
            "id": "alice",
            "channel_id": "ws",
            "display_name": "Alice",
            "connected_via": [
              "ws"
            ]
          },
          {
            "id": "bob",
            "channel_id": "ws",
            "display_name": "Bob",
            "connected_via": [
              "ws"
            ]
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "decisions",
        "trigger": "on_speak_decision",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Nova, only listen from now on."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": ""
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Nova, what time is it?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "classifier_calls": {
      "agent": [
        {
          "questions": {
            "directness": {
              "$present": true
            },
            "deferred": {
              "$present": true
            },
            "unfinished": {
              "$present": true
            },
            "hush": {
              "$present": true
            },
            "request": {
              "$present": true
            },
            "answered": {
              "$present": true
            },
            "listen_request": {
              "$present": true
            },
            "asked_me": {
              "$absent": true
            },
            "lift": {
              "$absent": true
            },
            "answers": {
              "$absent": true
            },
            "corrects": {
              "$absent": true
            },
            "waiting": {
              "$absent": true
            },
            "resume": {
              "$absent": true
            },
            "language": {
              "$absent": true
            }
          }
        },
        {
          "questions": {
            "directness": {
              "$present": true
            },
            "deferred": {
              "$present": true
            },
            "unfinished": {
              "$present": true
            },
            "hush": {
              "$present": true
            },
            "request": {
              "$present": true
            },
            "answered": {
              "$present": true
            },
            "asked_me": {
              "$present": true
            },
            "lift": {
              "$present": true
            },
            "listen_request": {
              "$absent": true
            }
          }
        }
      ]
    },
    "hooks": {
      "decisions": [
        {
          "speak_decision": {
            "decision": {
              "mode": "silent",
              "final": true
            }
          }
        },
        {
          "speak_decision": {
            "decision": {
              "mode": "silent",
              "final": true,
              "judgments": {
                "listening": 1
              }
            }
          }
        },
        {
          "speak_decision": {
            "decision": {
              "mode": "silent",
              "final": true,
              "judgments": {
                "listening": 1
              }
            }
          }
        }
      ]
    },
    "models": {
      "agent": []
    }
  }
}
