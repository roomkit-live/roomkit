{
  "$schema": "../../scenario.schema.json",
  "id": "speaking/no-policy-runs-without-a-decision-report-non-streaming",
  "title": "No policy runs without a decision report (non-streaming)",
  "rules": [
    "§6.4",
    "§9.2"
  ],
  "requirements": [
    "RK-6.4-142"
  ],
  "notes": "Python: tests/test_speak_policy.py::test_without_a_policy_nothing_is_decided. The policy records actual public calls; generation and observation counts are independently asserted.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Hi.",
              "finish_reason": "stop"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "decision-observer",
        "trigger": "on_speak_decision",
        "execution": "async"
      },
      {
        "name": "generated",
        "trigger": "before_ai_generation"
      },
      {
        "name": "answer",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Nova, a question."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {}
      ]
    },
    "speak_turns": {
      "agent": []
    },
    "hooks": {
      "decision-observer": [],
      "generated": [
        {}
      ],
      "answer": [
        {
          "response": {
            "loop_end_reason": "completed"
          }
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "type": "message",
          "content": {
            "body": "Nova, a question."
          }
        },
        {
          "content": {
            "body": "Hi."
          }
        }
      ]
    }
  }
}
