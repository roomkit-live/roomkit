{
  "$schema": "../../scenario.schema.json",
  "id": "speaking/a-room-the-agent-leaves-and-joins-again-starts-open",
  "title": "The channel has the classifier policy forget a room it leaves or joins: a room the agent was asked to only listen in, detached from it and attached again, starts open",
  "rules": [
    "§6.4",
    "§6.8"
  ],
  "requirements": [
    "RK-6.4-161"
  ],
  "notes": "Alice asks the agent to only listen; the agent's channel is detached from the room and attached again; her next turn is asked as in an open room and the agent speaks. RK-6.4-161 is cited for `forget_room` here; the state kept per room is speaking/a-request-to-only-listen-is-a-state-of-the-room-the-classifier-reads-with-every-turn. Python: channels/_ai_speaking.py (forget_room on attach and detach).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "speak_policy": {
          "classifier": {
            "calls": [
              {
                "answers": {
                  "listen_request": 0.9
                }
              },
              {
                "answers": {
                  "directness": 3
                }
              }
            ]
          },
          "agent_name": "Nova"
        },
        "model": {
          "rounds": [
            {
              "text": "It is ten."
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "participants": [
          {
            "id": "alice",
            "channel_id": "ws",
            "display_name": "Alice",
            "connected_via": [
              "ws"
            ]
          },
          {
            "id": "bob",
            "channel_id": "ws",
            "display_name": "Bob",
            "connected_via": [
              "ws"
            ]
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "decisions",
        "trigger": "on_speak_decision",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Nova, only listen from now on."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "detach_channel",
      "room_id": "room-1",
      "channel_id": "agent"
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "agent",
      "category": "intelligence"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Nova, what time is it?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "classifier_calls": {
      "agent": [
        {
          "questions": {
            "directness": {
              "$present": true
            },
            "deferred": {
              "$present": true
            },
            "unfinished": {
              "$present": true
            },
            "hush": {
              "$present": true
            },
            "request": {
              "$present": true
            },
            "answered": {
              "$present": true
            },
            "listen_request": {
              "$present": true
            },
            "asked_me": {
              "$absent": true
            },
            "lift": {
              "$absent": true
            },
            "answers": {
              "$absent": true
            },
            "corrects": {
              "$absent": true
            },
            "waiting": {
              "$absent": true
            },
            "resume": {
              "$absent": true
            },
            "language": {
              "$absent": true
            }
          }
        },
        {
          "state": {
            "agent": {
              "listening_only": {
                "$absent": true
              }
            }
          },
          "questions": {
            "directness": {
              "$present": true
            },
            "deferred": {
              "$present": true
            },
            "unfinished": {
              "$present": true
            },
            "hush": {
              "$present": true
            },
            "request": {
              "$present": true
            },
            "answered": {
              "$present": true
            },
            "listen_request": {
              "$present": true
            },
            "asked_me": {
              "$absent": true
            },
            "lift": {
              "$absent": true
            },
            "answers": {
              "$absent": true
            },
            "corrects": {
              "$absent": true
            },
            "waiting": {
              "$absent": true
            },
            "resume": {
              "$absent": true
            },
            "language": {
              "$absent": true
            }
          }
        }
      ]
    },
    "hooks": {
      "decisions": [
        {
          "speak_decision": {
            "decision": {
              "mode": "silent",
              "final": true
            }
          }
        },
        {
          "speak_decision": {
            "decision": {
              "mode": "speak"
            }
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "$present": true
        }
      ]
    }
  }
}
