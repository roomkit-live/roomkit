{
  "$schema": "../../scenario.schema.json",
  "id": "speaking/a-classifier-that-fails-lets-the-agent-speak-in-an-open-room",
  "title": "A classifier that fails falls back as any policy does: in a room that does not listen, the agent speaks, the decision reported with the reason fallback",
  "rules": [
    "§6.4",
    "§6.8"
  ],
  "requirements": [
    "RK-6.4-160"
  ],
  "notes": "The implementation's mock classifier fails its call with a classifier error. RK-6.4-160 is cited for the open room here; its exception, a room that listens, is speaking/a-turn-a-listening-room-cannot-judge-is-silent. Python: speaking/classifier.py ClassifierSpeakPolicy.decide.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "speak_policy": {
          "classifier": {
            "calls": [
              {
                "fail": "the classifier is down"
              }
            ]
          },
          "agent_name": "Nova"
        },
        "model": {
          "rounds": [
            {
              "text": "It is ten."
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "participants": [
          {
            "id": "alice",
            "channel_id": "ws",
            "display_name": "Alice",
            "connected_via": [
              "ws"
            ]
          },
          {
            "id": "bob",
            "channel_id": "ws",
            "display_name": "Bob",
            "connected_via": [
              "ws"
            ]
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "decisions",
        "trigger": "on_speak_decision",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Nova, what time is it?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "classifier_calls": {
      "agent": [
        {
          "questions": {
            "directness": {
              "$present": true
            },
            "deferred": {
              "$present": true
            },
            "unfinished": {
              "$present": true
            },
            "hush": {
              "$present": true
            },
            "request": {
              "$present": true
            },
            "answered": {
              "$present": true
            },
            "listen_request": {
              "$present": true
            },
            "asked_me": {
              "$absent": true
            },
            "lift": {
              "$absent": true
            },
            "answers": {
              "$absent": true
            },
            "corrects": {
              "$absent": true
            },
            "waiting": {
              "$absent": true
            },
            "resume": {
              "$absent": true
            },
            "language": {
              "$absent": true
            }
          }
        }
      ]
    },
    "hooks": {
      "decisions": [
        {
          "speak_decision": {
            "decision": {
              "mode": "speak",
              "reason": "fallback"
            }
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "$present": true
        }
      ]
    }
  }
}
