            {
              "decision": {
                "mode": "offer",
                "reason": "has something to add",
                "judgments": {},
                "notes": [],
                "final": false
              }
            }
          ]
        },
        "thinker": {
          "thoughts": [
            {
              "thought": {
                "text": "They need the price.",
                "want_to_say": [
                  "It costs 1,200 a year."
                ],
                "urgent": true
              }
            }
          ]
        },
        "think_wait_ms": 1000,
        "model": {
          "rounds": [
            {
              "text": "Hi.",
              "finish_reason": "stop"
