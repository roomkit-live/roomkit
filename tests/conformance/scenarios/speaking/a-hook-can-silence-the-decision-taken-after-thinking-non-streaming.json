        ]
      },
      {
        "name": "decisions",
        "trigger": "on_speak_decision",
        "execution": "async"
      },
      {
        "name": "thoughts",
        "trigger": "on_thought",
        "execution": "async"
      },
      {
        "name": "generation",
        "trigger": "before_ai_generation"
      },
      {
        "name": "answer",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
