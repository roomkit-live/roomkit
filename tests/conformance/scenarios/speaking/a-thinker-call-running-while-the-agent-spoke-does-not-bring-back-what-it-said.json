{
  "$schema": "../../scenario.schema.json",
  "id": "speaking/a-thinker-call-running-while-the-agent-spoke-does-not-bring-back-what-it-said",
  "title": "A thinker call running while the agent spoke with its thought does not bring back what it wanted to say",
  "rules": [
    "§6.4",
    "§9.2"
  ],
  "requirements": [
    "RK-6.4-193"
  ],
  "notes": "The first message is left silent and its thought, back in time, has something to say; the policy, asked again, keeps the silence. The second message is decided silent and final: its thinker call starts, held at its gate. The third is decided speak: the agent speaks with its thought, which is emptied of what it wanted to say. The held call then comes back with something to say: the agent spoke since its context was taken, so what it would say is that answer, and the thought it leaves wants to say nothing. Python: channels/_ai_thinking.py _RoomMind._run (spoke).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "speak_policy": {
          "decisions": [
            {
              "decision": {
                "mode": "silent",
                "reason": "listening",
                "judgments": {},
                "notes": [],
                "final": false
              }
            },
            {
              "decision": {
                "mode": "silent",
                "reason": "still listening",
                "judgments": {},
                "notes": [],
                "final": false
              }
            },
            {
              "decision": {
                "mode": "silent",
                "reason": "quiet",
                "judgments": {},
                "notes": [],
                "final": true
              }
            },
            {
              "decision": {
                "mode": "speak",
                "reason": "addressed",
                "judgments": {},
                "notes": [],
                "final": false
              }
            }
          ]
        },
        "thinker": {
          "thoughts": [
            {
              "thought": {
                "text": "They need the price.",
                "want_to_say": [
                  "It costs 1,200 a year."
                ],
                "urgent": false
              }
            },
            {
              "thought": {
                "text": "They still need the price.",
                "want_to_say": [
                  "It is 1,200."
                ],
                "urgent": false
              },
              "gate": "think-2"
            }
          ]
        },
        "think_wait_ms": 1000,
        "model": {
          "rounds": [
            {
              "text": "It costs 1,200 a year.",
              "gate": "answer"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "decisions",
        "trigger": "on_speak_decision",
        "execution": "async"
      },
      {
        "name": "thoughts",
        "trigger": "on_thought",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "We need the price."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Let me think."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "think-2"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Nova, what does it cost?"
        }
      },
      "background": true,
      "as": "asked"
    },
    {
      "wait_for": "answer"
    },
    {
      "open": "think-2"
    },
    {
      "open": "answer"
    },
    {
      "await": "asked",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "We need the price."
            },
            {
              "role": "user",
              "text": "Let me think."
            },
            {
              "role": "user",
              "text": {
                "$contains": [
                  "Nova, what does it cost?",
                  "Your impression:",
                  "They need the price.",
                  "It costs 1,200 a year."
                ]
              }
            }
          ]
        }
      ]
    },
    "hooks": {
      "thoughts": [
        {
          "thought": {
            "thought": {
              "text": "They need the price.",
              "want_to_say": [
                "It costs 1,200 a year."
              ],
              "urgent": false
            },
            "previous": {
              "text": "",
              "want_to_say": [],
              "urgent": false
            },
            "duration_ms": {
              "$present": true
            }
          }
        },
        {
          "thought": {
            "thought": {
              "text": "They need the price.",
              "want_to_say": [],
              "urgent": false
            },
            "previous": {
              "text": "They need the price.",
              "want_to_say": [
                "It costs 1,200 a year."
              ],
              "urgent": false
            },
            "duration_ms": null
          }
        },
        {
          "thought": {
            "thought": {
              "text": "They still need the price.",
              "want_to_say": [],
              "urgent": false
            },
            "previous": {
              "text": "They need the price.",
              "want_to_say": [],
              "urgent": false
            },
            "duration_ms": {
              "$present": true
            }
          }
        }
      ]
    }
  }
}
