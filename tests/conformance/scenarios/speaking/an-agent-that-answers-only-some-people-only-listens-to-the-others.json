{
  "$schema": "../../scenario.schema.json",
  "id": "speaking/an-agent-that-answers-only-some-people-only-listens-to-the-others",
  "title": "The answer-only policy decides a turn from someone it does not answer silent, with the reason only listened to, final, without asking the policy it wraps; the turn is stored and thought about; a speaker it answers is matched by the room's name, ignoring case",
  "rules": [
    "§6.4"
  ],
  "requirements": [
    "RK-6.4-172",
    "RK-6.4-174",
    "RK-6.4-175"
  ],
  "notes": "The policy answers only `ALICE` (as configured, a tab after it) around a scripted policy; the room names her Alice. Bob's turn, and a turn from a sender with no participant record, whom the room labels by its channel, are silent (`only listened to`, final): the scripted policy is not asked, and each turn is stored and thought about. Alice's turn is the scripted policy's. RK-6.4-172 is cited in part: an event whose speaker the room does not name at all (only the runtime's own events have none) is tests/test_answer_only.py::test_a_speaker_the_room_does_not_name_is_not_answered. RK-6.4-175 is cited in part: that this is no access control is a statement the scenario cannot observe. Python: speaking/answer_only.py AnswerOnly.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "speak_policy": {
          "answer_only": {
            "people": [
              "ALICE\t"
            ]
          },
          "decisions": [
            {
              "decision": {
                "mode": "speak",
                "reason": "from policy"
              }
            }
          ]
        },
        "model": {
          "rounds": [
            {
              "text": "It is ten."
            }
          ],
          "streaming": false
        },
        "thinker": {
          "thoughts": [
            {
              "thought": {
                "text": "They talk about the budget.",
                "want_to_say": []
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "participants": [
          {
            "id": "alice",
            "channel_id": "ws",
            "display_name": "Alice",
            "connected_via": [
              "ws"
            ]
          },
          {
            "id": "bob",
            "channel_id": "ws",
            "display_name": "Bob",
            "connected_via": [
              "ws"
            ]
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "decisions",
        "trigger": "on_speak_decision",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "bob",
        "content": {
          "type": "text",
          "body": "The budget is tight."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "stranger",
        "content": {
          "type": "text",
          "body": "Hello?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Nova, what time is it?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "speak_turns": {
      "agent": [
        {
          "event": {
            "content": {
              "body": "Nova, what time is it?"
            }
          }
        }
      ]
    },
    "hooks": {
      "decisions": [
        {
          "speak_decision": {
            "decision": {
              "mode": "silent",
              "reason": "only listened to",
              "final": true
            }
          }
        },
        {
          "speak_decision": {
            "decision": {
              "mode": "silent",
              "reason": "only listened to",
              "final": true
            }
          }
        },
        {
          "speak_decision": {
            "decision": {
              "mode": "speak"
            }
          }
        }
      ]
    },
    "thinker_calls": {
      "agent": [
        {
          "context": {
            "messages": [
              {
                "role": "user",
                "text": {
                  "$contains": "The budget is tight."
                }
              }
            ]
          }
        },
        {
          "context": {
            "messages": [
              {
                "$present": true
              },
              {
                "role": "user",
                "text": {
                  "$contains": "Hello?"
                }
              }
            ]
          }
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "The budget is tight."
          }
        },
        {
          "content": {
            "body": "Hello?"
          }
        },
        {
          "content": {
            "body": "Nova, what time is it?"
          }
        },
        {
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "body": "It is ten."
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "$present": true
        }
      ]
    }
  }
}
