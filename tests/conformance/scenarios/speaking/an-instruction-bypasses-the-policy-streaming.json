{
  "$schema": "../../scenario.schema.json",
  "id": "speaking/an-instruction-bypasses-the-policy-streaming",
  "title": "An instruction bypasses the policy (streaming)",
  "rules": [
    "§6.4",
    "§9.2"
  ],
  "requirements": [
    "RK-6.4-131"
  ],
  "notes": "Python: tests/test_speak_policy.py::test_an_instruction_is_not_submitted_to_the_policy. The policy records actual public calls; generation and observation counts are independently asserted.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "speak_policy": {
          "decisions": [
            {
              "decision": {
                "mode": "silent",
                "reason": "from policy",
                "judgments": {
                  "addressed": 0.75
                },
                "notes": [],
                "final": false
              }
            }
          ]
        },
        "model": {
          "rounds": [
            {
              "text": "Hi.",
              "finish_reason": "stop"
            }
          ],
          "streaming": true
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "decision-observer",
        "trigger": "on_speak_decision",
        "execution": "async"
      },
      {
        "name": "generated",
        "trigger": "before_ai_generation"
      },
      {
        "name": "answer",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Nova, a question."
      },
      "event_type": "instruction",
      "addressed_to": [
        "agent"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {}
      ]
    },
    "speak_turns": {
      "agent": []
    },
    "hooks": {
      "decision-observer": [],
      "generated": [
        {}
      ],
      "answer": [
        {
          "response": {
            "loop_end_reason": "completed"
          }
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "type": "instruction_read",
          "content": {
            "body": "Nova, a question."
          },
          "index": 0
        },
        {
          "content": {
            "body": "Hi."
          },
          "metadata": {
            "follows_index": 0
          }
        }
      ]
    }
  }
}
