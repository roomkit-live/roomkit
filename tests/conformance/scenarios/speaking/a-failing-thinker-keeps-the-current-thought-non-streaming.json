{
  "$schema": "../../scenario.schema.json",
  "id": "speaking/a-failing-thinker-keeps-the-current-thought-non-streaming",
  "title": "A failing thinker keeps the current thought (non-streaming)",
  "rules": [
    "§6.4",
    "§9.2"
  ],
  "notes": "Python: tests/test_thinker.py::test_a_failing_thinker_keeps_the_thought. Real policy, thinker, hooks and model boundaries are observed separately; gates make late return explicit, without wall-clock duration assertions. The two changes during one answering turn retain exact previous/new pairs without imposing an order on async observers.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "speak_policy": {
          "decisions": [
            {
              "decision": {
                "mode": "silent",
                "reason": "listening",
                "judgments": {},
                "notes": [],
                "final": false
              }
            }
          ]
        },
        "thinker": {
          "thoughts": [
            {
              "fail": "unavailable"
            }
          ]
        },
        "think_wait_ms": 1000,
        "model": {
          "rounds": [
            {
              "text": "Hi.",
              "finish_reason": "stop"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "decisions",
        "trigger": "on_speak_decision",
        "execution": "async"
      },
      {
        "name": "thoughts",
        "trigger": "on_thought",
        "execution": "async"
      },
      {
        "name": "generation",
        "trigger": "before_ai_generation"
      },
      {
        "name": "answer",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "We need the price."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": []
    },
    "thinker_calls": {
      "agent": [
        {
          "previous": {
            "text": "",
            "want_to_say": [],
            "urgent": false
          },
          "context": {
            "messages": [
              {
                "role": "user",
                "text": {
                  "$contains": "We need the price."
                }
              }
            ],
            "room": {
              "room": {
                "id": "room-1"
              }
            }
          }
        }
      ]
    },
    "speak_turns": {
      "agent": [
        {
          "event": {
            "content": {
              "body": "We need the price."
            }
          },
          "thought": {
            "text": "",
            "want_to_say": [],
            "urgent": false
          }
        }
      ]
    },
    "hooks": {
      "decisions": [
        {
          "speak_decision": {
            "decision": {
              "mode": "silent",
              "reason": "listening",
              "judgments": {},
              "notes": [],
              "final": false
            },
            "asked_again": false,
            "late": false,
            "thought": {
              "text": "",
              "want_to_say": [],
              "urgent": false
            }
          }
        }
      ],
      "thoughts": [],
      "generation": [
        {
          "generation": {
            "purpose": "thought"
          }
        }
      ],
      "answer": []
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "We need the price."
          }
        }
      ]
    }
  }
}
