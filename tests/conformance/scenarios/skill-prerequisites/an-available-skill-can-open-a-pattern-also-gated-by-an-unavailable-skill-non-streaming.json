{
  "$schema": "../../scenario.schema.json",
  "id": "skill-prerequisites/an-available-skill-can-open-a-pattern-also-gated-by-an-unavailable-skill-non-streaming",
  "title": "An available skill can open a pattern also gated by an unavailable skill (non-streaming)",
  "rules": [
    "§24.2",
    "§24.3",
    "§24.4",
    "§21.1"
  ],
  "requirements": [
    "RK-21.1-042",
    "RK-24.3-034",
    "RK-24.3-036",
    "RK-24.3-037",
    "RK-24.4-017"
  ],
  "notes": "Python: tests/test_skill_requires_parity.py::test_an_activated_skill_opens_a_gate_an_unavailable_one_shares[text]. Before activation, the available inactive skill means the gate is openable, so refusal directs activation; afterward its identical pattern opens.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "audit": "tool_auditor",
        "tool_search": false,
        "tools": [
          {
            "name": "calendar_read",
            "description": "calendar_read",
            "parameters": {
              "type": "object"
            },
            "returns": "calendar_read ran"
          }
        ],
        "skills": [
          {
            "name": "calendar",
            "description": "calendar procedure",
            "instructions": "Rules for calendar.",
            "allowed_tools": "calendar_*"
          },
          {
            "name": "closed",
            "description": "closed procedure",
            "instructions": "Rules for closed.",
            "allowed_tools": "calendar_*",
            "unavailable": "not granted"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "name": "calendar_read",
                  "arguments": {},
                  "id": "c1"
                }
              ]
            },
            {
              "calls": [
                {
                  "name": "activate_skill",
                  "arguments": {
                    "name": "calendar"
                  },
                  "id": "c2"
                }
              ]
            },
            {
              "calls": [
                {
                  "name": "calendar_read",
                  "arguments": {},
                  "id": "c3"
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "calendar_read": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "calendar_read": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "calendar_read": {
              "$present": true
            }
          }
        },
        {
          "tool_results": [
            {
              "content": "{\"error\": \"Tool 'calendar_read' is gated by a skill. Activate the skill first using activate_skill.\"}",
              "is_error": true,
              "tool_call_id": "c1"
            },
            {
              "content": {
                "$contains": "Rules for calendar."
              },
              "is_error": false,
              "tool_call_id": "c2"
            },
            {
              "content": "calendar_read ran",
              "is_error": false,
              "tool_call_id": "c3"
            }
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": [
        {
          "tool_name": "calendar_read",
          "status": "ok",
          "result": "calendar_read ran"
        }
      ]
    }
  }
}
