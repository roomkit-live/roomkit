{
  "$schema": "../../scenario.schema.json",
  "id": "skill-prerequisites/channel-owned-tools-count-as-prerequisites-despite-policy-non-streaming",
  "title": "Channel owned tools count as prerequisites despite policy (non-streaming)",
  "rules": [
    "§24.2",
    "§24.3",
    "§24.4",
    "§21.1"
  ],
  "requirements": [
    "RK-21.1-016",
    "RK-24.3-028",
    "RK-24.3-030"
  ],
  "notes": "Python: tests/test_skill_requires_parity.py::test_a_channel_tool_counts_as_a_requirement_on_both_doors[text].",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "audit": "tool_auditor",
        "tool_search": false,
        "tools": [
          {
            "name": "safe_read",
            "description": "safe_read",
            "parameters": {
              "type": "object"
            },
            "returns": "safe_read ran"
          }
        ],
        "skills": [
          {
            "name": "calendar",
            "description": "calendar procedure",
            "instructions": "Rules for calendar.",
            "requires": "read_skill_reference"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "name": "activate_skill",
                  "arguments": {
                    "name": "calendar"
                  },
                  "id": "c1"
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": false
        },
        "tool_policy": {
          "deny": [
            "*"
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "content": {
                "$contains": "Rules for calendar."
              },
              "is_error": false,
              "tool_call_id": "c1"
            }
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": []
    }
  }
}
