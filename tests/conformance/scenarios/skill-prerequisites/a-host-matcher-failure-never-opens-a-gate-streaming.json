{
  "$schema": "../../scenario.schema.json",
  "id": "skill-prerequisites/a-host-matcher-failure-never-opens-a-gate-streaming",
  "title": "A host matcher failure never opens a gate (streaming)",
  "rules": [
    "§24.2",
    "§24.3",
    "§24.4",
    "§21.1"
  ],
  "notes": "Python: skills/models.py::missing_required_tools and channels/_ai_tools.py::_execute_single_tool_call: a host matcher exception is a failed call, never activation.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "audit": "tool_auditor",
        "tool_search": false,
        "tools": [
          {
            "name": "boards_get_card",
            "description": "boards_get_card",
            "parameters": {
              "type": "object"
            },
            "returns": "boards_get_card ran"
          },
          {
            "name": "calendar_read",
            "description": "calendar_read",
            "parameters": {
              "type": "object"
            },
            "returns": "calendar_read ran"
          }
        ],
        "skills": [
          {
            "name": "calendar",
            "description": "calendar procedure",
            "instructions": "Rules for calendar.",
            "requires": "boards",
            "allowed_tools": "calendar_*"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "name": "activate_skill",
                  "arguments": {
                    "name": "calendar"
                  },
                  "id": "c1"
                }
              ]
            },
            {
              "calls": [
                {
                  "name": "calendar_read",
                  "arguments": {},
                  "id": "c2"
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": true
        },
        "skills_requires_match": "fail"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "observe",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "calendar_read": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "calendar_read": {
              "$absent": true
            }
          }
        },
        {
          "tool_results": [
            {
              "content": {
                "$contains": "failed"
              },
              "is_error": true,
              "tool_call_id": "c1"
            },
            {
              "content": "{\"error\": \"Tool 'calendar_read' is gated by a skill. Activate the skill first using activate_skill.\"}",
              "is_error": true,
              "tool_call_id": "c2"
            }
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": []
    },
    "hooks": {
      "observe": {
        "$unordered": [
          {
            "tool_call": {
              "name": "activate_skill",
              "tool_call_id": "c1",
              "is_error": true,
              "refused": false,
              "cancelled": false
            }
          },
          {
            "tool_call": {
              "name": "calendar_read",
              "tool_call_id": "c2",
              "is_error": true,
              "refused": true,
              "cancelled": false
            }
          }
        ]
      }
    }
  }
}
