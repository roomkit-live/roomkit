{
  "$schema": "../../scenario.schema.json",
  "id": "skill-prerequisites/an-unlisted-skill-remains-activatable-and-opens-its-tools-streaming",
  "title": "An unlisted skill remains activatable and opens its tools (streaming)",
  "rules": [
    "§24.2",
    "§24.3",
    "§24.4",
    "§21.1"
  ],
  "requirements": [
    "RK-24.3-013",
    "RK-24.3-017",
    "RK-24.4-017"
  ],
  "notes": "Python: tests/test_skills.py::TestSkillRegistry::test_mark_unlisted_hides_from_manifest_but_keeps_activation.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "audit": "tool_auditor",
        "tool_search": false,
        "tools": [
          {
            "name": "calendar_read",
            "description": "calendar_read",
            "parameters": {
              "type": "object"
            },
            "returns": "calendar_read ran"
          }
        ],
        "skills": [
          {
            "name": "calendar",
            "description": "calendar procedure",
            "instructions": "Rules for calendar.",
            "requires": "calendar_read",
            "allowed_tools": "calendar_*",
            "unlisted": true
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "name": "activate_skill",
                  "arguments": {
                    "name": "calendar"
                  },
                  "id": "c1"
                }
              ]
            },
            {
              "calls": [
                {
                  "name": "calendar_read",
                  "arguments": {},
                  "id": "c2"
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": true
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "calendar_read": {
              "$absent": true
            }
          },
          "system_prompt": {
            "$lacks": "<skill name=\"calendar\">"
          }
        },
        {
          "tools": {
            "calendar_read": {
              "$present": true
            }
          }
        },
        {
          "tool_results": [
            {
              "content": {
                "$contains": "Rules for calendar."
              },
              "is_error": false,
              "tool_call_id": "c1"
            },
            {
              "content": "calendar_read ran",
              "is_error": false,
              "tool_call_id": "c2"
            }
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": [
        {
          "tool_name": "calendar_read",
          "status": "ok",
          "result": "calendar_read ran"
        }
      ]
    }
  }
}
