{
  "$schema": "../../scenario.schema.json",
  "id": "skill-prerequisites/unavailable-references-explain-the-same-restriction-non-streaming",
  "title": "Unavailable references explain the same restriction (non-streaming)",
  "rules": [
    "§24.2",
    "§24.3",
    "§24.4",
    "§21.1"
  ],
  "notes": "Python: channels/_skill_handlers.py::handle_read_reference uses missing_skill_error for unavailable local skills.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "audit": "tool_auditor",
        "tool_search": false,
        "tools": [],
        "skills": [
          {
            "name": "calendar",
            "description": "calendar procedure",
            "instructions": "Rules for calendar.",
            "unavailable": "not granted",
            "references": {
              "guide.md": "Secret reference."
            }
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "name": "read_skill_reference",
                  "arguments": {
                    "skill_name": "calendar",
                    "filename": "guide.md"
                  },
                  "id": "c1"
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "content": "{\"error\": \"Skill 'calendar' is unavailable in this context: not granted\"}",
              "is_error": true,
              "tool_call_id": "c1"
            }
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": []
    }
  }
}
