{
  "$schema": "../../scenario.schema.json",
  "id": "skill-prerequisites/list-prerequisites-include-the-candidates-own-gated-tools-non-streaming",
  "title": "List prerequisites include the candidates own gated tools (non-streaming)",
  "rules": [
    "§24.2",
    "§24.3",
    "§24.4",
    "§21.1"
  ],
  "requirements": [
    "RK-24.1-010",
    "RK-24.1-011",
    "RK-24.2-007",
    "RK-24.3-016",
    "RK-24.3-028",
    "RK-24.3-030",
    "RK-24.3-031",
    "RK-24.3-032",
    "RK-24.4-017",
    "RK-6.4-397",
    "RK-6.7-111"
  ],
  "notes": "Python: tests/test_skill_requires_parity.py::test_an_offered_required_tool_lets_the_activation_through; channels/_ai_tools.py::_missing_required_tools includes the candidate in opened patterns.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "audit": "tool_auditor",
        "tool_search": false,
        "tools": [
          {
            "name": "calendar_read",
            "description": "calendar_read",
            "parameters": {
              "type": "object"
            },
            "returns": "calendar_read ran"
          },
          {
            "name": "calendar_write",
            "description": "calendar_write",
            "parameters": {
              "type": "object"
            },
            "returns": "calendar_write ran"
          }
        ],
        "skills": [
          {
            "name": "calendar",
            "description": "calendar procedure",
            "instructions": "Rules for calendar.",
            "requires": [
              "calendar_read",
              "calendar_write"
            ],
            "allowed_tools": "calendar_*"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "name": "activate_skill",
                  "arguments": {
                    "name": "calendar"
                  },
                  "id": "c1"
                }
              ]
            },
            {
              "calls": [
                {
                  "name": "calendar_write",
                  "arguments": {},
                  "id": "c2"
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "calendar_read": {
              "$absent": true
            },
            "calendar_write": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "calendar_read": {
              "$present": true
            },
            "calendar_write": {
              "$present": true
            }
          }
        },
        {
          "tool_results": [
            {
              "content": {
                "$contains": "Rules for calendar."
              },
              "is_error": false,
              "tool_call_id": "c1"
            },
            {
              "content": "calendar_write ran",
              "is_error": false,
              "tool_call_id": "c2"
            }
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": [
        {
          "tool_name": "calendar_write",
          "status": "ok",
          "result": "calendar_write ran"
        }
      ]
    }
  }
}
