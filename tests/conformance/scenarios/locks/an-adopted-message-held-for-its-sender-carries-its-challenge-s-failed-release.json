{
  "$schema": "../../scenario.schema.json",
  "id": "locks/an-adopted-message-held-for-its-sender-carries-its-challenge-s-failed-release",
  "title": "A message an off-lock hook adopts, held for its sender, answers once its challenge committed and carries the challenge's failed release; the event that adopted it does not",
  "rules": [
    "§13.5 A release that fails",
    "§9.5.1 Reentrance",
    "§11"
  ],
  "notes": "Python: the held call commits its identity challenge through _inject_off_lock, within its own collecting_release_failures, before it returns (RMK-1516 item 2, the review's probe P6).",
  "setup": {
    "kit": {
      "lock_manager": {
        "release_error": "lease expired"
      },
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "text": "side"
            },
            "repeat": true,
            "result": {
              "status": "ambiguous",
              "candidates": [
                {
                  "id": "alice-id",
                  "display_name": "Alice"
                },
                {
                  "id": "bob-id",
                  "display_name": "Bob"
                }
              ]
            }
          }
        ]
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "identity_hooks": [
      {
        "name": "ambiguous",
        "trigger": "on_identity_ambiguous",
        "reactions": [
          {
            "repeat": true,
            "result": {
              "status": "challenge_sent",
              "message": "Identify yourself",
              "inject": {
                "event": {
                  "content": {
                    "type": "text",
                    "body": "Who are you?"
                  }
                }
              }
            }
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "adopts",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "timeout_ms": 20000,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "do": [
              {
                "call": "process_inbound",
                "room_id": "room-1",
                "message": {
                  "channel_id": "ws",
                  "sender_id": "alice",
                  "content": {
                    "type": "text",
                    "body": "side"
                  }
                },
                "expect": {
                  "result": {
                    "blocked": true,
                    "reason": "identity_challenge_sent",
                    "error": {
                      "$contains": "lease expired"
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "scan",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "Who are you?"
            },
            "gate": "scan"
          },
          {
            "when": {
              "text": "hello"
            },
            "gate": "late"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "background": true,
      "as": "h"
    },
    {
      "wait_for": "scan"
    },
    {
      "lock_releases": "fail"
    },
    {
      "open": "scan"
    },
    {
      "wait_for": "late"
    },
    {
      "lock_releases": "succeed"
    },
    {
      "open": "late"
    },
    {
      "await": "h",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ]
}
