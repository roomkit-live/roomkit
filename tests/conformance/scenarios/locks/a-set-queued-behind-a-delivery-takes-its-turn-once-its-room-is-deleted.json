{
  "$schema": "../../scenario.schema.json",
  "id": "locks/a-set-queued-behind-a-delivery-takes-its-turn-once-its-room-is-deleted",
  "title": "A delivery set queued in its room's lane behind a set under way takes its turn once that set is over, though the room was deleted meanwhile and its delivery cursor reads -1 for good",
  "rules": [
    "§13.5 Delivery lanes across processes",
    "§10.2",
    "§5.1"
  ],
  "requirements": [
    "RK-10.2-010"
  ],
  "notes": "One process. `zero` is delivered and moves the cursor past it. `one` is held at `held` in its delivery; `two` is committed behind it and waits in the lane. The room is then deleted: its cursor reads -1 from then on, and no lane moves or skips it any more. Once `one` is delivered, `two` takes its turn, the lane's order kept, rather than waiting for `zero`'s and `one`'s indexes to reach a cursor that will never move. Indexes are not asserted: the room's lifecycle records, which they are read without, are deleted with it. The gap timeout is the implementation's default, far above the run: nothing is skipped.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "deliver": [
          {
            "when": {
              "text": "one"
            },
            "gate": "held"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "zero"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "background": true,
      "as": "one",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "one"
        }
      }
    },
    {
      "wait_for": "held"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "defer_delivery": true,
      "as": "two",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "two"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "call": "store.delete_room",
      "room_id": "room-1",
      "expect": {
        "result": true
      }
    },
    {
      "open": "held"
    },
    {
      "await": "one",
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "call": "delivery.wait",
      "of": "two",
      "expect": {
        "result": {
          "blocked": false,
          "cancellation_reason": null
        }
      }
    }
  ],
  "expect": {
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "zero"
            }
          },
          {
            "content": {
              "body": "one"
            }
          },
          {
            "content": {
              "body": "two"
            }
          }
        ]
      }
    }
  }
}
