{
  "$schema": "../../scenario.schema.json",
  "id": "locks/a-regeneration-refused-trigger-moved-carries-its-lock-s-failed-release",
  "title": "A regeneration refused trigger_moved under a room lock whose release fails carries that failure as its error",
  "rules": [
    "§13.5 A release that fails",
    "§13.6"
  ],
  "notes": "Python: src/roomkit/core/mixins/regenerate.py, regenerate_response collects the failed releases of its call and makes the first its result's error when it has none (RMK-1443 G3).",
  "setup": {
    "kit": {
      "lock_manager": {
        "release_error": "lease expired"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "First answer"
            },
            {
              "text": "Saturday answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "What is the weather?"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "regenerate_target",
      "room_id": "room-1",
      "as": "t"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "And on Saturdays?"
        }
      }
    },
    {
      "idle": true
    },
    {
      "lock_releases": "fail"
    },
    {
      "call": "regenerate_response",
      "room_id": "room-1",
      "trigger_id": "$t",
      "expect": {
        "result": {
          "blocked": true,
          "reason": "trigger_moved",
          "event": null,
          "error": {
            "$contains": "lease expired"
          }
        }
      }
    }
  ]
}
