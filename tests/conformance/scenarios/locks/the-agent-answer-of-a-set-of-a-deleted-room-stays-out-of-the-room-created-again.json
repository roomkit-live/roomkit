{
  "$schema": "../../scenario.schema.json",
  "id": "locks/the-agent-answer-of-a-set-of-a-deleted-room-stays-out-of-the-room-created-again",
  "title": "An agent's answer to a delivery set of a room deleted while the set runs, and created again under the same id before it ends, is refused as in a room gone, a null status announced: nothing of it is written into or delivered in the new room",
  "rules": [
    "§13.5 Delivery lanes across processes",
    "§10.1 step 14",
    "§5.1",
    "§8.2"
  ],
  "notes": "One process. `held` is held at `held` in its delivery to `ws`, while the agent `ai` answers it with `reply`. The room is deleted and created again under the same id with `sms` and `ws` only. Once `held` is let go, its set ends and its answer re-enters: the room it was asked in is gone, so the answer is refused as in a room the store no longer holds (`room_refused_event`, a null status, `operation = reentry`), never committed into the new room, which never asked for it and has no agent. The new room's first message takes index 0. Indexes are read without lifecycle records.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "deliver": [
          {
            "when": {
              "text": "held"
            },
            "gate": "held"
          }
        ]
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "held"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "reply"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "background": true,
      "as": "held",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "held"
        }
      }
    },
    {
      "wait_for": "held"
    },
    {
      "call": "store.delete_room",
      "room_id": "room-1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "create_room",
      "room": {
        "id": "room-1"
      }
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "sms"
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "ws"
    },
    {
      "open": "held"
    },
    {
      "await": "held",
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "again 0"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "index": 0
          }
        }
      }
    }
  ],
  "expect": {
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "held"
            }
          }
        ]
      }
    },
    "deliveries": {
      "room-1": {
        "sms": [],
        "ws": [
          {
            "content": {
              "body": "held"
            }
          },
          {
            "content": {
              "body": "again 0"
            }
          }
        ]
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "again 0"
          },
          "status": "delivered"
        }
      ]
    },
    "framework_events": {
      "room-1": [
        "room_created",
        {
          "event": "room_channel_attached",
          "channel_id": "sms"
        },
        {
          "event": "room_channel_attached",
          "channel_id": "ws"
        },
        {
          "$unordered": [
            {
              "event": "delivery_succeeded",
              "channel_id": "ws"
            },
            {
              "event": "room_refused_event",
              "status": null,
              "operation": "reentry",
              "event_type": "message"
            },
            "event_processed"
          ]
        },
        {
          "event": "delivery_succeeded",
          "channel_id": "ws"
        },
        "event_processed"
      ]
    },
    "rooms": {
      "room-1": {
        "latest_index": 0,
        "delivered_index": 0
      }
    }
  }
}
