{
  "$schema": "../../scenario.schema.json",
  "id": "locks/a-failed-release-keeps-a-refusal",
  "title": "A room lock whose release fails leaves a refused message refused, stored blocked and delivered nowhere, and its result carries the failure as its error",
  "rules": [
    "§13.5 A release that fails",
    "§10.1"
  ],
  "setup": {
    "kit": {
      "lock_manager": {
        "release_error": "lease expired"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "no_spam",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "result": {
              "action": "block",
              "reason": "spam"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "lock_releases": "fail"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "buy now"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "spam",
          "error": {
            "$contains": "lease expired"
          }
        }
      }
    }
  ],
  "expect": {
    "deliveries": {
      "room-1": {
        "ws": []
      }
    }
  }
}
