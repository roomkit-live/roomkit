{
  "$schema": "../../scenario.schema.json",
  "id": "locks/a-failed-release-keeps-the-committed-event-and-is-its-error",
  "title": "A room lock whose release fails leaves the message committed and delivered, and the inbound result carries the failure as its error",
  "rules": [
    "§13.5 A release that fails",
    "§10.1"
  ],
  "setup": {
    "kit": {
      "lock_manager": {
        "release_error": "lease expired"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "lock_releases": "fail"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "lease expired"
          },
          "event": {
            "index": 0,
            "content": {
              "body": "hello"
            }
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "hello"
          }
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "hello"
            }
          }
        ]
      }
    }
  }
}
