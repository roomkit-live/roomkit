{
  "$schema": "../../scenario.schema.json",
  "id": "locks/an-agent-a-set-of-a-deleted-room-does-not-ask-leaves-no-record-in-the-room-created-again",
  "title": "The record of an agent a delivery set does not ask past the depth limit, the set's room deleted while it runs and created again under the same id before it ends, is refused as in a room gone: it is not stored in the new room",
  "rules": [
    "§13.5 Delivery lanes across processes",
    "§8.3",
    "§5.1",
    "§8.2"
  ],
  "requirements": [
    "RK-5.1-001",
    "RK-8.2-002",
    "RK-8.2-003",
    "RK-8.2-007",
    "RK-8.2-010",
    "RK-8.2-020",
    "RK-8.2-023",
    "RK-8.2-061",
    "RK-8.2-062",
    "RK-8.2-063"
  ],
  "notes": "One process, `max_chain_depth` 1: the agent `ai` is not asked for `held`, and its set owes a BLOCKED record of the agent not asked (§8.3). `held` is held at `held` in its delivery to `ws`; the room is deleted and created again under the same id with `sms` and `ws` only. Once `held` is let go, the record finds the room it stands in gone: it is refused as in a room the store no longer holds (`room_refused_event`, a null status, `operation = reentry`), never stored in the new room, whose first message takes index 0. Indexes are read without lifecycle records.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "deliver": [
          {
            "when": {
              "text": "held"
            },
            "gate": "held"
          }
        ]
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "held"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "never"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "kit": {
      "max_chain_depth": 1
    }
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "background": true,
      "as": "held",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "held"
        }
      }
    },
    {
      "wait_for": "held"
    },
    {
      "call": "store.delete_room",
      "room_id": "room-1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "create_room",
      "room": {
        "id": "room-1"
      }
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "sms"
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "ws"
    },
    {
      "open": "held"
    },
    {
      "await": "held",
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "again 0"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "index": 0
          }
        }
      }
    }
  ],
  "expect": {
    "turns": {
      "room-1": {
        "ai": []
      }
    },
    "deliveries": {
      "room-1": {
        "sms": [],
        "ws": [
          {
            "content": {
              "body": "held"
            }
          },
          {
            "content": {
              "body": "again 0"
            }
          }
        ]
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "again 0"
          },
          "status": "delivered"
        }
      ]
    },
    "framework_events": {
      "room-1": [
        "room_created",
        {
          "event": "room_channel_attached",
          "channel_id": "sms"
        },
        {
          "event": "room_channel_attached",
          "channel_id": "ws"
        },
        {
          "$unordered": [
            {
              "event": "delivery_succeeded",
              "channel_id": "ws"
            },
            {
              "event": "room_refused_event",
              "status": null,
              "operation": "reentry",
              "event_type": "message"
            },
            "event_processed"
          ]
        },
        {
          "event": "delivery_succeeded",
          "channel_id": "ws"
        },
        "event_processed"
      ]
    },
    "rooms": {
      "room-1": {
        "latest_index": 0,
        "delivered_index": 0
      }
    }
  }
}
