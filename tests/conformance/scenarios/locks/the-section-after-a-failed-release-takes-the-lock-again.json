{
  "$schema": "../../scenario.schema.json",
  "id": "locks/the-section-after-a-failed-release-takes-the-lock-again",
  "title": "After a release that failed, the next message takes the room's lock again, and its result carries no error",
  "rules": [
    "§13.5 A release that fails",
    "§10.1"
  ],
  "setup": {
    "kit": {
      "lock_manager": {
        "release_error": "lease expired"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "lock_releases": "fail"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "first"
        }
      }
    },
    {
      "lock_releases": "succeed"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "second"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$absent": true
          }
        }
      }
    }
  ],
  "expect": {
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "first"
            }
          },
          {
            "content": {
              "body": "second"
            }
          }
        ]
      }
    }
  }
}
