{
  "$schema": "../../scenario.schema.json",
  "id": "locks/the-streamed-answer-of-a-set-of-a-deleted-room-stays-out-of-the-room-created-again",
  "title": "An agent's streamed answer to a delivery set of a room deleted while the set runs, and created again under the same id before it ends, is not read: nothing of it is written into or delivered in the new room, and the set's call raises nothing",
  "rules": [
    "§13.5 Delivery lanes across processes",
    "§10.1 step 14",
    "§13.6",
    "§5.1"
  ],
  "requirements": [
    "RK-10.1-084",
    "RK-10.6.4-004",
    "RK-13.5-039",
    "RK-5.1-001",
    "RK-8.2-003",
    "RK-8.2-010",
    "RK-8.2-020",
    "RK-8.2-023"
  ],
  "notes": "One process. `held` is held at `held` in its delivery to `ws`, while the agent `ai`, whose model streams, answers it. The room is deleted and created again under the same id with `sms` and `ws` only. Once `held` is let go, the agent's stream is to be read on the room it was asked in, which is gone: it is closed unread, its model never asked to generate, as in a room the store no longer holds, no row of it committed into the new room, and `held`'s call returns its result with no error. The new room's first message takes index 0. Indexes are read without lifecycle records.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "deliver": [
          {
            "when": {
              "text": "held"
            },
            "gate": "held"
          }
        ]
      },
      {
        "id": "ai",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "deltas": [
                "re",
                "ply"
              ]
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "background": true,
      "as": "held",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "held"
        }
      }
    },
    {
      "wait_for": "held"
    },
    {
      "call": "store.delete_room",
      "room_id": "room-1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "create_room",
      "room": {
        "id": "room-1"
      }
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "sms"
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "ws"
    },
    {
      "open": "held"
    },
    {
      "await": "held",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "again 0"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "index": 0
          }
        }
      }
    }
  ],
  "expect": {
    "deliveries": {
      "room-1": {
        "sms": [],
        "ws": [
          {
            "content": {
              "body": "held"
            }
          },
          {
            "content": {
              "body": "again 0"
            }
          }
        ]
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "again 0"
          },
          "status": "delivered"
        }
      ]
    },
    "framework_events": {
      "room-1": [
        "room_created",
        {
          "event": "room_channel_attached",
          "channel_id": "sms"
        },
        {
          "event": "room_channel_attached",
          "channel_id": "ws"
        },
        {
          "$unordered": [
            {
              "event": "delivery_succeeded",
              "channel_id": "ws"
            },
            "event_processed"
          ]
        },
        {
          "event": "delivery_succeeded",
          "channel_id": "ws"
        },
        "event_processed"
      ]
    },
    "rooms": {
      "room-1": {
        "latest_index": 0,
        "delivered_index": 0
      }
    },
    "models": {
      "ai": []
    }
  }
}
