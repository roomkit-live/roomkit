{
  "$schema": "../../scenario.schema.json",
  "id": "locks/the-hooks-side-effects-of-a-set-of-a-deleted-room-the-close-drops-stay-out-of-the-room-created-again",
  "title": "A delivery set of a room deleted while it waits in the room's lane, then created again under the same id, writes its event's hook side effects into neither room once the kit's close drops it",
  "rules": [
    "§13.5 Delivery lanes across processes",
    "§10.1 step 15",
    "§5.1",
    "§12.10.4"
  ],
  "requirements": [
    "RK-10.1-088",
    "RK-10.1-092",
    "RK-13.5-040",
    "RK-12.10.4-040",
    "RK-12.10.4-061"
  ],
  "notes": "One process. `held` is held at `held` in its delivery to `ws`. `call me` is committed behind it, its deferred set waiting in the lane, and the `triage` hook gave it the task `Call back`. The room is deleted and created again under the same id. The kit's close drops the waiting set, whose call reads `kit_closed`: a dropped set stores what its event's hooks gave (§10.1 step 15), but this one's room is gone, so the task is not written, and the new room holds none, read while the close is still in its grace.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket",
        "deliver": [
          {
            "when": {
              "text": "held"
            },
            "gate": "held"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "triage",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "call me"
            },
            "result": {
              "action": "allow",
              "tasks": [
                {
                  "title": "Call back"
                }
              ]
            }
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "background": true,
      "as": "held",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "held"
        }
      }
    },
    {
      "wait_for": "held"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "call me"
        }
      },
      "defer_delivery": true,
      "as": "second",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "content": {
              "body": "call me"
            }
          }
        }
      }
    },
    {
      "call": "store.delete_room",
      "room_id": "room-1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "create_room",
      "room": {
        "id": "room-1"
      }
    },
    {
      "call": "close",
      "background": true,
      "as": "closing"
    },
    {
      "call": "delivery.wait",
      "of": "second",
      "expect": {
        "result": {
          "cancellation_reason": "kit_closed"
        }
      }
    },
    {
      "call": "store.list_tasks",
      "room_id": "room-1",
      "expect": {
        "result": []
      }
    },
    {
      "open": "held"
    },
    {
      "await": "closing"
    },
    {
      "await": "held"
    }
  ]
}
