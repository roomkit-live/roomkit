{
  "$schema": "../../scenario.schema.json",
  "id": "locks/a-lifecycle-change-stands-though-its-release-fails",
  "title": "A channel attached under a room lock whose release fails stays attached: the change raises nothing",
  "rules": [
    "§13.5 A release that fails",
    "§10.5"
  ],
  "setup": {
    "kit": {
      "lock_manager": {
        "release_error": "lease expired"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "email",
        "type": "email",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "lock_releases": "fail"
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "email",
      "expect": {
        "result": {
          "channel_id": "email"
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "email": {
          "channel_id": "email"
        }
      }
    }
  }
}
