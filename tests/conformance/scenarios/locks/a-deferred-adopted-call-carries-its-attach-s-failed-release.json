{
  "$schema": "../../scenario.schema.json",
  "id": "locks/a-deferred-adopted-call-carries-its-attach-s-failed-release",
  "title": "A deferred call an off-lock hook adopts, whose step 2 attached its channel under a lock whose release failed, carries that failure as its error at its commit and on its handle's wait",
  "rules": [
    "§13.5 A release that fails",
    "§9.5.1 Reentrance"
  ],
  "notes": "Python: src/roomkit/core/mixins/inbound.py, the nested process_inbound's _process_inbound_inner makes its own first failed release its result's error, the result its handle holds (models/delivery.py DeliveryHandle.wait keeps the error it carries). Found by the review of RMK-1443's G2.",
  "setup": {
    "kit": {
      "lock_manager": {
        "release_error": "lease expired"
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "adopts",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "timeout_ms": 5000,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "do": [
              {
                "call": "process_inbound",
                "room_id": "room-1",
                "message": {
                  "channel_id": "sms",
                  "sender_id": "+15551234567",
                  "content": {
                    "type": "text",
                    "body": "side"
                  }
                },
                "defer_delivery": true,
                "as": "side",
                "expect": {
                  "result": {
                    "blocked": false,
                    "event": {
                      "content": {
                        "body": "side"
                      }
                    },
                    "error": {
                      "$contains": "lease expired"
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "scan",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "reactions": [
          {
            "when": {
              "text": "side"
            },
            "gate": "scan"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "lock_releases": "fail"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "background": true,
      "as": "h"
    },
    {
      "wait_for": "scan"
    },
    {
      "lock_releases": "succeed"
    },
    {
      "open": "scan"
    },
    {
      "await": "h",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "delivery.wait",
      "of": "side",
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "lease expired"
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "side"
          }
        },
        {
          "content": {
            "body": "hello"
          }
        }
      ]
    }
  }
}
