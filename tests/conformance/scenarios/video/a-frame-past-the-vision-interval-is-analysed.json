{
  "$schema": "../../scenario.schema.json",
  "id": "video/a-frame-past-the-vision-interval-is-analysed",
  "title": "With a vision interval, the first frame once the interval passed since the last analysed one is analysed, and the frames inside the interval it starts are not",
  "rules": [
    "§12.8.4"
  ],
  "requirements": [
    "RK-12.8.4-005"
  ],
  "notes": "No frame carries a timestamp: the interval is measured on the clock, from each analysis.",
  "requires_features": [
    "video"
  ],
  "setup": {
    "virtual_clock": true,
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "video.open",
      "room_id": "r1",
      "channel_id": "camera",
      "participants": [
        "alice"
      ],
      "vision": [
        "the first view",
        "a second view"
      ],
      "vision_interval_ms": 1000
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 1,
      "data": "AQID"
    },
    {
      "call": "clock.advance",
      "ms": 900
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 2,
      "data": "BAUG"
    },
    {
      "call": "clock.advance",
      "ms": 200
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 3,
      "data": "BwgJ"
    },
    {
      "call": "clock.advance",
      "ms": 100
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 4,
      "data": "CgsM"
    },
    {
      "call": "video.read",
      "channel_id": "camera",
      "expect": {
        "result": {
          "analysed": [
            "AQID",
            "BwgJ"
          ],
          "vision": [
            {
              "description": "the first view"
            },
            {
              "description": "a second view"
            }
          ]
        }
      }
    }
  ],
  "expect": {}
}
