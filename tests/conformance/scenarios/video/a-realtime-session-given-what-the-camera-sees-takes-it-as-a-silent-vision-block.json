{
  "$schema": "../../scenario.schema.json",
  "id": "video/a-realtime-session-given-what-the-camera-sees-takes-it-as-a-silent-vision-block",
  "title": "A realtime session given the room's vision takes each published result as a silent injection, the same <vision> block a turn reads, under the lead it was given",
  "rules": [
    "§12.8.7"
  ],
  "requirements": [
    "RK-12.8.7-016"
  ],
  "requires_features": [
    "video",
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "caller"
    },
    {
      "call": "realtime.vision",
      "channel_id": "rt",
      "room_id": "r1",
      "context_prefix": "The camera shows:"
    },
    {
      "call": "video.open",
      "room_id": "r1",
      "channel_id": "camera",
      "participants": [
        "alice"
      ],
      "vision": [
        "a person waves"
      ],
      "vision_labels": [
        [
          "person"
        ]
      ]
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 1,
      "data": "AQID"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "injections": [
            {
              "text": {
                "$contains": [
                  "The camera shows:",
                  "<vision>",
                  "a person waves",
                  "person",
                  "</vision>"
                ]
              },
              "silent": true
            }
          ]
        }
      }
    }
  ],
  "expect": {}
}
