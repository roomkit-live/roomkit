{
  "$schema": "../../scenario.schema.json",
  "id": "video/a-view-ends-with-its-video-session",
  "title": "Once the video session that produced a vision result ends, no turn reads it",
  "rules": [
    "§12.8.7"
  ],
  "requirements": [
    "RK-12.8.7-015"
  ],
  "requires_features": [
    "video"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "I see someone waving."
            },
            {
              "text": "I see nothing."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "video.open",
      "room_id": "r1",
      "channel_id": "camera",
      "participants": [
        "alice"
      ],
      "vision": [
        "a person waves"
      ]
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 1,
      "data": "AQID"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "What do you see?"
      }
    },
    {
      "idle": true
    },
    {
      "call": "video.disconnect",
      "channel_id": "camera",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "And now?"
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": [
                  "What do you see?",
                  "<vision>",
                  "a person waves",
                  "</vision>"
                ]
              }
            }
          ]
        },
        {
          "messages": [
            {
              "text": {
                "$lacks": "a person waves"
              }
            },
            {
              "role": "assistant"
            },
            {
              "text": {
                "$lacks": "a person waves"
              }
            }
          ]
        }
      ]
    }
  }
}
