{
  "$schema": "../../scenario.schema.json",
  "id": "video/a-vision-result-rides-the-turn-of-the-room-s-agent",
  "title": "What the vision provider saw reaches the room's agent as a vision block in its turn, with no wiring, leaving its system prompt and binding as they were",
  "rules": [
    "§12.8.4",
    "§12.8.7",
    "§6.4"
  ],
  "requirements": [
    "RK-12.8.4-013",
    "RK-12.8.7-011",
    "RK-12.8.7-012"
  ],
  "requires_features": [
    "video"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "I see someone waving."
            }
          ]
        },
        "system_prompt": "You watch the room."
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "get_binding",
      "room_id": "r1",
      "channel_id": "agent",
      "expect": {
        "result": {
          "$as": "binding"
        }
      }
    },
    {
      "call": "video.open",
      "room_id": "r1",
      "channel_id": "camera",
      "participants": [
        "alice"
      ],
      "vision": [
        "a person waves"
      ]
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 1,
      "data": "AQID"
    },
    {
      "call": "get_binding",
      "room_id": "r1",
      "channel_id": "agent",
      "expect": {
        "result": {
          "$as": "binding"
        }
      }
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "What do you see?"
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "system_prompt": "You watch the room.",
          "messages": [
            {
              "role": "user",
              "text": {
                "$contains": [
                  "What do you see?",
                  "<vision>",
                  "a person waves",
                  "</vision>"
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
