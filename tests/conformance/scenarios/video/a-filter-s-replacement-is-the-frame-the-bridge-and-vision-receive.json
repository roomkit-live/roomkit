{
  "$schema": "../../scenario.schema.json",
  "id": "video/a-filter-s-replacement-is-the-frame-the-bridge-and-vision-receive",
  "title": "A filter that replaces a frame hands the replacement on: the bridge forwards it and the vision provider analyses it, not the frame the transport delivered",
  "rules": [
    "§12.8.4",
    "§12.8.5"
  ],
  "requirements": [
    "RK-12.8.5-012"
  ],
  "requires_features": [
    "video"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "video.open",
      "room_id": "r1",
      "channel_id": "camera",
      "participants": [
        "alice",
        "bob"
      ],
      "bridge": true,
      "vision": [
        "a covered view"
      ],
      "filters": [
        {
          "name": "cover",
          "data": "AAAA"
        }
      ]
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 1,
      "data": "AQID"
    },
    {
      "call": "video.read",
      "channel_id": "camera",
      "expect": {
        "result": {
          "filters": {
            "cover": [
              {
                "sequence": 1,
                "data": "AQID"
              }
            ]
          },
          "forwarded": {
            "alice": [],
            "bob": [
              "AAAA"
            ]
          },
          "analysed": [
            "AAAA"
          ]
        }
      }
    }
  ],
  "expect": {}
}
