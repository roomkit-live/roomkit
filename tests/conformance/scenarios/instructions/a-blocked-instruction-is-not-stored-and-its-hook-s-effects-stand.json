{
  "$schema": "../../scenario.schema.json",
  "id": "instructions/a-blocked-instruction-is-not-stored-and-its-hook-s-effects-stand",
  "title": "An instruction a BEFORE_BROADCAST hook or the source check blocks is not stored and its result reports the block, while event_blocked is emitted and its hook's injected event, task and observation are still processed",
  "rules": [
    "§10.1.1 rule 4",
    "§10.1.1 rule 5",
    "§10.1 step 10",
    "§10.1 step 11",
    "§7.5 rule 2",
    "§9.4",
    "§26.1"
  ],
  "requirements": [
    "RK-10.1.1-014",
    "RK-10.1.1-019",
    "RK-10.1.1-020"
  ],
  "notes": "In room-1 the `gate` hook blocks the instruction and gives it a task, an observation and a notice for `ws`. In room-2 `sms` is muted: the hook lets the instruction through with the same side effects, and the source check blocks it after the hooks (source_muted). Nothing of either instruction is stored: each room's first index goes to the notice, the instruction's provisional index too, so each instruction reads as an id of no timeline event ($e1, $e2). The addressed agent is never asked. Python: tests/test_instruction_events.py::test_a_hook_blocked_instruction_is_not_stored; core/mixins/inbound_locked.py `_write_decision`.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "never"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "sms",
            "muted": true
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "type": "instruction",
              "room_id": "room-2"
            },
            "result": {
              "action": "allow",
              "tasks": [
                {
                  "title": "Muted follow up"
                }
              ],
              "observations": [
                {
                  "category": "instruction",
                  "content": "muted"
                }
              ],
              "injected_events": [
                {
                  "target_channel_ids": [
                    "ws"
                  ],
                  "event": {
                    "content": {
                      "type": "text",
                      "body": "The muted instruction was refused."
                    }
                  }
                }
              ]
            }
          },
          {
            "when": {
              "type": "instruction",
              "room_id": "room-1"
            },
            "result": {
              "action": "block",
              "reason": "not now",
              "tasks": [
                {
                  "title": "Follow up"
                }
              ],
              "observations": [
                {
                  "category": "instruction",
                  "content": "refused"
                }
              ],
              "injected_events": [
                {
                  "target_channel_ids": [
                    "ws"
                  ],
                  "event": {
                    "content": {
                      "type": "text",
                      "body": "The instruction was refused."
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "name": "follow_up",
        "trigger": "on_task_created",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "app",
        "content": {
          "type": "text",
          "body": "Introduce yourself"
        },
        "event_type": "instruction",
        "addressed_to": [
          "ai"
        ]
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "not now",
          "event": {
            "id": "$e1",
            "type": "instruction",
            "status": "blocked",
            "blocked_by": "gate",
            "index": 0
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "sms",
        "sender_id": "app",
        "content": {
          "type": "text",
          "body": "Introduce yourself"
        },
        "event_type": "instruction",
        "addressed_to": [
          "ai"
        ]
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "source_muted",
          "event": {
            "id": "$e2",
            "type": "instruction",
            "status": "blocked",
            "blocked_by": "source_muted",
            "index": 0
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "The instruction was refused."
          },
          "status": "delivered",
          "visibility": "ws",
          "chain_depth": 0
        }
      ],
      "room-2": [
        {
          "content": {
            "type": "text",
            "body": "The muted instruction was refused."
          },
          "status": "delivered",
          "visibility": "ws",
          "chain_depth": 0
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "sms": [],
        "ws": [
          {
            "id": "room-1#0"
          }
        ]
      },
      "room-2": {
        "sms": [],
        "ws": [
          {
            "id": "room-2#0"
          }
        ]
      }
    },
    "turns": {
      "room-1": {
        "ai": []
      },
      "room-2": {
        "ai": []
      }
    },
    "tasks": {
      "room-1": [
        {
          "title": "Follow up",
          "status": "pending"
        }
      ],
      "room-2": [
        {
          "title": "Muted follow up",
          "status": "pending"
        }
      ]
    },
    "observations": {
      "room-1": [
        {
          "category": "instruction",
          "content": "refused"
        }
      ],
      "room-2": [
        {
          "category": "instruction",
          "content": "muted"
        }
      ]
    },
    "hooks": {
      "follow_up": [
        {
          "trigger": "on_task_created",
          "room_id": "room-1",
          "event": {
            "type": "task_created",
            "content": {
              "body": "Introduce yourself"
            },
            "metadata": {
              "task_title": "Follow up"
            }
          }
        },
        {
          "trigger": "on_task_created",
          "room_id": "room-2",
          "event": {
            "type": "task_created",
            "content": {
              "body": "Introduce yourself"
            },
            "metadata": {
              "task_title": "Muted follow up"
            }
          }
        }
      ]
    },
    "framework_events": {
      "room-1": [
        {
          "event": "event_blocked",
          "event_id": "$e1",
          "channel_id": "sms",
          "blocked_by": "gate"
        }
      ],
      "room-2": [
        {
          "event": "event_blocked",
          "event_id": "$e2",
          "channel_id": "sms",
          "blocked_by": "source_muted"
        }
      ]
    }
  }
}
