{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-hook-s-binding-under-the-key-of-a-channel-reading-no-recipient-keeps-its-recipient",
  "title": "A binding a hook stored with a value under the declared key, in a room a message with no address opened, is that recipient's, on a channel whose recipient_address answers none",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "The name no sender is is not written over it: Bob, the recipient, is found and recorded; Carol is not.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number"
      }
    ],
    "hooks": [
      {
        "name": "attach",
        "trigger": "on_room_created",
        "execution": "async",
        "reactions": [
          {
            "do": [
              {
                "call": "store.add_binding",
                "binding": {
                  "room_id": "$room",
                  "channel_id": "sms",
                  "channel_type": "sms",
                  "metadata": {
                    "phone_number": "+15550000002"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "first"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000003",
        "content": {
          "type": "text",
          "body": "carol: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r2"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "the recipient answers"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "$r1": {
        "sms": {
          "participant_id": "+15550000002",
          "metadata": {
            "phone_number": "+15550000002"
          }
        }
      }
    },
    "timeline": {
      "$r1": [
        {
          "content": {
            "body": "first"
          }
        },
        {
          "content": {
            "body": "the recipient answers"
          }
        }
      ],
      "$r2": [
        {
          "content": {
            "body": "carol: hi"
          }
        }
      ]
    }
  }
}
