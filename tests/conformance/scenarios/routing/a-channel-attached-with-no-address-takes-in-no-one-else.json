{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-channel-attached-with-no-address-takes-in-no-one-else",
  "title": "A binding step 2 attaches for a routed message with no address names no sender, so the room admits no one else through it",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "The router answers room-1, which does not bind sms: the channel is attached, whoever writes. Bob, routed there too, is refused under the lock, twice, and gets a new room.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "room-1"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "let me in"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "room-1"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "sms": {
          "participant_id": "system"
        }
      },
      "$r1": {
        "sms": {
          "participant_id": "+15550000002"
        }
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "let me in"
          }
        }
      ],
      "$r1": [
        {
          "content": {
            "body": "bob: hi"
          }
        }
      ]
    }
  }
}
