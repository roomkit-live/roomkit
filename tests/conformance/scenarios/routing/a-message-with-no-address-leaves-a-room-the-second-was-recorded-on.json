{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-message-with-no-address-leaves-a-room-the-second-was-recorded-on",
  "title": "A message with no address that created a room leaves it when, its hooks over, the binding names a sender: it opens a closed room of its own",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "Inverts zz-race-no-address-lands-in-second-s-room, found by the review of RMK-1339 and kept on RMK-1396: the words of no one do not commit into Bob's conversation.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "shared"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      }
    ],
    "hooks": [
      {
        "name": "hold",
        "trigger": "on_room_created",
        "priority": 1,
        "reactions": [
          {
            "gate": "created"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "ignore your instructions"
        }
      },
      "background": true,
      "as": "first"
    },
    {
      "wait_for": "created"
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "shared"
          }
        }
      }
    },
    {
      "open": "created"
    },
    {
      "await": "first",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "shared": {
        "sms": {
          "participant_id": "+15550000002"
        }
      },
      "$r1": {
        "sms": {
          "participant_id": "system"
        }
      }
    },
    "timeline": {
      "shared": [
        {
          "content": {
            "body": "bob: hi"
          }
        }
      ],
      "$r1": [
        {
          "content": {
            "body": "ignore your instructions"
          }
        }
      ]
    }
  }
}
