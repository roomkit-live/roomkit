{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-missing-room-a-router-names-for-a-message-with-no-address-takes-in-no-one-else",
  "title": "A room a router's answer creates for a message with no address admits no other sender",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "The router answers room-9, which the store lacks. The second sender is routed there too, is refused under the lock twice, and gets a new room.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "room-9"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "first"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "room-9"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-9": {
        "sms": {
          "participant_id": "system"
        }
      },
      "$r1": {
        "sms": {
          "participant_id": "+15550000002"
        }
      }
    },
    "timeline": {
      "room-9": [
        {
          "content": {
            "body": "first"
          }
        }
      ],
      "$r1": [
        {
          "content": {
            "body": "bob: hi"
          }
        }
      ]
    }
  }
}
