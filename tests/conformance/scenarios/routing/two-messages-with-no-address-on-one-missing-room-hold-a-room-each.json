{
  "$schema": "../../scenario.schema.json",
  "id": "routing/two-messages-with-no-address-on-one-missing-room-hold-a-room-each",
  "title": "Of two messages with no address a router gives one missing room, the second stays and the first, which created it, leaves",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "Each binding names system, which no sender is.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "shared"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      }
    ],
    "hooks": [
      {
        "name": "hold",
        "trigger": "on_room_created",
        "priority": 1,
        "reactions": [
          {
            "gate": "created"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "first"
        }
      },
      "background": true,
      "as": "first"
    },
    {
      "wait_for": "created"
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "second"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "shared"
          }
        }
      }
    },
    {
      "open": "created"
    },
    {
      "await": "first",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "shared": {
        "sms": {
          "participant_id": "system"
        }
      },
      "$r1": {
        "sms": {
          "participant_id": "system"
        }
      }
    },
    "timeline": {
      "shared": [
        {
          "content": {
            "body": "second"
          }
        }
      ],
      "$r1": [
        {
          "content": {
            "body": "first"
          }
        }
      ]
    }
  }
}
