{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-channel-reading-no-recipient-keeps-a-stranger-out",
  "title": "A channel whose recipient_address answers none still names a binding's conversation by the value under its declared key: a stranger gets a room of her own, the recipient is found",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "The channel declares phone_number and keeps the default recipient_address, which answers none. Bob's number is under the key: step 3 does not take Alice in, and step 1 finds Bob. This inverts the behaviour X8 pinned on Python as routing/a-channel-reading-no-recipient-leaves-the-room-open (RMK-1129).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number"
      }
    ],
    "rooms": [
      {
        "id": "room-1"
      }
    ]
  },
  "steps": [
    {
      "call": "store.add_binding",
      "binding": {
        "room_id": "room-1",
        "channel_id": "sms",
        "channel_type": "sms",
        "metadata": {
          "phone_number": "+15550000002"
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000001",
        "content": {
          "type": "text",
          "body": "Hello, Alice here"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "Hello, Bob here"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "room-1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "sms": {
          "participant_id": "+15550000002",
          "metadata": {
            "phone_number": "+15550000002"
          }
        }
      },
      "$r1": {
        "sms": {
          "participant_id": "+15550000001"
        }
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "Hello, Bob here"
          }
        }
      ],
      "$r1": [
        {
          "content": {
            "body": "Hello, Alice here"
          }
        }
      ]
    }
  }
}
