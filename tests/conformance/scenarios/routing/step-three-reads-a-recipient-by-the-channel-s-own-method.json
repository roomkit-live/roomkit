{
  "$schema": "../../scenario.schema.json",
  "id": "routing/step-three-reads-a-recipient-by-the-channel-s-own-method",
  "title": "Step 3 reads a binding's recipient by the channel's recipient_address, whatever its declared key says",
  "rules": [
    "§5.7",
    "§10.4"
  ],
  "notes": "The channel declares phone_number and its recipient_address reads reached_at. The room's binding holds Bob under reached_at: the room delivers to him, so Alice gets a room of her own, whether step 3 or the lock refuses her. What only the router's read shows: routing/the-channel-s-answer-naming-the-sender-admits-her-whatever-the-key-holds. Translates roomkit core/inbound_router.py routed_recipient.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {
          "recipient_at": "reached_at"
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1"
      }
    ]
  },
  "steps": [
    {
      "call": "store.add_binding",
      "binding": {
        "room_id": "room-1",
        "channel_id": "sms",
        "channel_type": "sms",
        "metadata": {
          "reached_at": "+15550000002"
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000001",
        "content": {
          "type": "text",
          "body": "Hello, Alice here"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "sms": {
          "participant_id": null
        }
      },
      "$r1": {
        "sms": {
          "participant_id": "+15550000001"
        }
      }
    },
    "timeline": {
      "room-1": [],
      "$r1": [
        {
          "content": {
            "body": "Hello, Alice here"
          }
        }
      ]
    }
  }
}
