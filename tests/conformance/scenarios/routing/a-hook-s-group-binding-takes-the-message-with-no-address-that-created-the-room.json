{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-hook-s-group-binding-takes-the-message-with-no-address-that-created-the-room",
  "title": "A group binding a creation hook made takes the message with no address that created the room",
  "rules": [
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "Review probe for the RFC's 'a group binding takes either'. Found by the review of RMK-1396.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      }
    ],
    "hooks": [
      {
        "name": "bind",
        "trigger": "on_room_created",
        "reactions": [
          {
            "do": [
              {
                "call": "store.add_binding",
                "binding": {
                  "room_id": "$room",
                  "channel_id": "sms",
                  "channel_type": "sms",
                  "group": true
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "no one"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "$r1": {
        "sms": {
          "group": true,
          "participant_id": null
        }
      }
    },
    "timeline": {
      "$r1": [
        {
          "content": {
            "body": "no one"
          }
        }
      ]
    }
  }
}
