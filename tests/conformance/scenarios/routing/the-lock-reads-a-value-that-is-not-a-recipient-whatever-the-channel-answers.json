{
  "$schema": "../../scenario.schema.json",
  "id": "routing/the-lock-reads-a-value-that-is-not-a-recipient-whatever-the-channel-answers",
  "title": "Under the lock, a value under the key that is not a recipient makes the room no longer the message's, even for the sender the channel answers",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "A scripted router answers room-1. Found by the review of RMK-1129.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "room-1"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {
          "recipient_at": "reached_at"
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1"
      }
    ]
  },
  "steps": [
    {
      "call": "store.add_binding",
      "binding": {
        "room_id": "room-1",
        "channel_id": "sms",
        "channel_type": "sms",
        "metadata": {
          "phone_number": true,
          "reached_at": "+15550000001"
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000001",
        "content": {
          "type": "text",
          "body": "alice: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "sms": {
          "participant_id": null
        }
      }
    },
    "timeline": {
      "room-1": []
    }
  }
}
