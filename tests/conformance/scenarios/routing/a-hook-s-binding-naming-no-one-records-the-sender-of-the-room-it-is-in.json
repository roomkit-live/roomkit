{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-hook-s-binding-naming-no-one-records-the-sender-of-the-room-it-is-in",
  "title": "A binding an ON_ROOM_CREATED hook made naming no one, in the room created for a routed message, is the message's: the sender is recorded on it",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "Unnamed, the binding would pass step 3 for the next sender until the message is stored. The hook's own fields stay.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      }
    ],
    "hooks": [
      {
        "name": "bind",
        "trigger": "on_room_created",
        "reactions": [
          {
            "repeat": true,
            "do": [
              {
                "call": "attach_channel",
                "room_id": "$room",
                "channel_id": "sms",
                "metadata": {
                  "tier": "gold"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000001",
        "content": {
          "type": "text",
          "body": "alice: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r2"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "$r1": {
        "sms": {
          "participant_id": "+15550000001",
          "metadata": {
            "tier": "gold",
            "phone_number": "+15550000001"
          }
        }
      },
      "$r2": {
        "sms": {
          "participant_id": "+15550000002"
        }
      }
    },
    "timeline": {
      "$r1": [
        {
          "content": {
            "body": "alice: hi"
          }
        }
      ],
      "$r2": [
        {
          "content": {
            "body": "bob: hi"
          }
        }
      ]
    }
  }
}
