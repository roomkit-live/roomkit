{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-message-with-no-address-routed-away-opens-a-closed-room",
  "title": "A message with no address a router's room turns away twice gets a new room, as closed as any it opens",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "room-1 is Bob's. The router answers it twice, the lock refuses it twice, and the message's new room names no sender.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "room-1"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms",
            "participant_id": "+15550000002"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "first"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "$r1": {
        "sms": {
          "participant_id": "system"
        }
      },
      "room-1": {
        "sms": {
          "participant_id": "+15550000002"
        }
      }
    }
  }
}
