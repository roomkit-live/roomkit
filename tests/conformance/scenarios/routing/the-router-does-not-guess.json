{
  "$schema": "../../scenario.schema.json",
  "id": "routing/the-router-does-not-guess",
  "title": "A channel bound to several rooms that name no one routes a stranger to a new room",
  "rules": [
    "§10.4 A router MUST NOT guess",
    "§10.4"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sink",
        "type": "sms",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-a",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "sink"
          }
        ]
      },
      {
        "id": "room-b",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "sink"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "default_router.route",
      "channel_id": "sms",
      "channel_type": "sms",
      "participant_id": "+15551234567",
      "expect": {
        "result": null
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hello?"
        }
      },
      "expect": {
        "result": {
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-a": [],
      "room-b": [],
      "$r1": [
        {
          "content": {
            "type": "text",
            "body": "Hello?"
          }
        }
      ]
    },
    "deliveries": {
      "room-a": {
        "sink": []
      },
      "room-b": {
        "sink": []
      }
    },
    "bindings": {
      "room-a": {
        "sms": {
          "participant_id": null
        }
      },
      "room-b": {
        "sms": {
          "participant_id": null
        }
      }
    },
    "rooms": {
      "$created": {
        "$unordered": [
          {
            "organization_id": null,
            "event_count": 1
          }
        ]
      }
    }
  }
}
