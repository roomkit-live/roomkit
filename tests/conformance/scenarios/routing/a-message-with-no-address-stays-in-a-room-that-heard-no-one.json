{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-message-with-no-address-stays-in-a-room-that-heard-no-one",
  "title": "Under the lock, a message with no address stays in a room that heard no one on the channel, and records no one",
  "rules": [
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "The other side of routing/a-message-with-no-address-is-held-to-step-three-under-the-lock: step 3's conditions hold, the message is the room's, and with no address nothing is written on the binding.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "room-1"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "no one: hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "room-1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "sms": {
          "participant_id": null
        }
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "no one: hello"
          }
        }
      ]
    }
  }
}
