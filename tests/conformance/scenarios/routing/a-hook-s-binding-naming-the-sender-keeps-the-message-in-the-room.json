{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-hook-s-binding-naming-the-sender-keeps-the-message-in-the-room",
  "title": "A binding an ON_ROOM_CREATED hook made for the sender's own number keeps the message in the room created for it",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "The hook read the sender and named them: nothing changes.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      }
    ],
    "hooks": [
      {
        "name": "bind",
        "trigger": "on_room_created",
        "reactions": [
          {
            "do": [
              {
                "call": "attach_channel",
                "room_id": "$room",
                "channel_id": "sms",
                "metadata": {
                  "phone_number": "+15550000001"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000001",
        "content": {
          "type": "text",
          "body": "alice: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "$r1": {
        "sms": {
          "participant_id": "+15550000001",
          "metadata": {
            "phone_number": "+15550000001"
          }
        }
      }
    },
    "timeline": {
      "$r1": [
        {
          "content": {
            "body": "alice: hi"
          }
        }
      ]
    }
  }
}
