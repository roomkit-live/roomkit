{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-hook-detaching-the-channel-while-another-is-routed-in-binds-no-one",
  "title": "A creation hook attaches then detaches the message's channel; another sender is routed in meanwhile",
  "rules": [
    "§7.5 rule 7",
    "§10.1 step 2"
  ],
  "notes": "Review probe. Found by the review of RMK-1396.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "shared"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "on_room_created",
        "priority": 0,
        "reactions": [
          {
            "do": [
              {
                "call": "attach_channel",
                "room_id": "$room",
                "channel_id": "sms"
              },
              {
                "call": "detach_channel",
                "room_id": "$room",
                "channel_id": "sms"
              }
            ]
          }
        ]
      },
      {
        "name": "hold",
        "trigger": "on_room_created",
        "priority": 1,
        "reactions": [
          {
            "gate": "created",
            "do": []
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000001",
        "content": {
          "type": "text",
          "body": "alice: secret"
        }
      },
      "background": true,
      "as": "alice"
    },
    {
      "wait_for": "created"
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: secret"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "source_unbound"
        }
      }
    },
    {
      "open": "created"
    },
    {
      "await": "alice",
      "expect": {
        "result": {
          "blocked": true,
          "reason": "source_unbound"
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "shared": {
        "sms": null
      }
    }
  }
}
