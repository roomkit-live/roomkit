{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-chat-under-the-framework-s-name-is-refused",
  "title": "A message is refused by the address it would be routed by: on a chat channel, a chat under the framework's name, whoever its author",
  "rules": [
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "The channel names a message's conversation by its metadata under chat. Alice is no borrower, her chat is: routed by it, it would read as the framework's own at every step.",
  "setup": {
    "channels": [
      {
        "id": "chat",
        "type": "websocket",
        "category": "transport",
        "addresses": {
          "conversation_key": "chat"
        }
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "chat",
        "sender_id": "alice",
        "metadata": {
          "chat": "system"
        },
        "content": {
          "type": "text",
          "body": "hi"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "reserved_sender",
          "event": null
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "chat",
        "sender_id": "alice",
        "metadata": {
          "chat": "team"
        },
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "$r1": {
        "chat": {
          "participant_id": "team"
        }
      }
    },
    "timeline": {
      "$r1": [
        {
          "content": {
            "body": "hello"
          }
        }
      ]
    }
  }
}
