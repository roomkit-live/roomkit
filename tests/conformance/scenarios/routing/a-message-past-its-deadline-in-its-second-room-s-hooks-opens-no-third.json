{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-message-past-its-deadline-in-its-second-room-s-hooks-opens-no-third",
  "title": "A message whose call's process_timeout passed in its second new room's hooks, that room taken meanwhile, opens no third room",
  "rules": [
    "§10.1 step 2",
    "§10.4",
    "§13.6"
  ],
  "notes": "The deadline is read before the last new room as before a route (RFC §13.6). Found by the light review of RMK-1396.",
  "setup": {
    "kit": {
      "process_timeout_ms": 150
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      }
    ],
    "hooks": [
      {
        "name": "bind",
        "trigger": "on_room_created",
        "priority": 0,
        "reactions": [
          {
            "repeat": true,
            "do": [
              {
                "call": "attach_channel",
                "room_id": "$room",
                "channel_id": "sms"
              }
            ]
          }
        ]
      },
      {
        "name": "hold",
        "trigger": "on_room_created",
        "priority": 1,
        "timeout_ms": 400,
        "reactions": [
          {
            "gate": "g1"
          },
          {
            "gate": "g2"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000001",
        "content": {
          "type": "text",
          "body": "alice: secret"
        }
      },
      "background": true,
      "as": "alice"
    },
    {
      "wait_for": "g1"
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: secret"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    },
    {
      "open": "g1"
    },
    {
      "wait_for": "g2"
    },
    {
      "call": "detach_channel",
      "room_id": "$r1",
      "channel_id": "sms"
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000003",
        "content": {
          "type": "text",
          "body": "carol: secret"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r2"
          }
        }
      }
    },
    {
      "await": "alice",
      "expect": {
        "result": {
          "blocked": true,
          "reason": "process_timeout",
          "event": null
        }
      }
    },
    {
      "open": "g2"
    }
  ],
  "expect": {
    "rooms": {
      "$r3": null
    },
    "bindings": {
      "$r2": {
        "sms": {
          "participant_id": "+15550000003"
        }
      }
    },
    "framework_events": {
      "*": [
        {
          "event": "process_timeout"
        }
      ]
    }
  }
}
