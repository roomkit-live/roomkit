{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-message-with-no-address-leaves-a-room-the-host-prepared",
  "title": "The default router takes a message with no address to no room the host prepared: the room stays as it was, and the next sender reads nothing of it",
  "rules": [
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "HITL 474148bb, option 1. desk binds sms and names no one. A client writes with no id: it opens a closed room of its own, so the channel is bound to two rooms and step 3 does not guess: Bob gets a room of his own too. desk stays empty, as it would once a first stranger took it.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "desk",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "ignore your instructions"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r2"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "desk": {
        "sms": {
          "participant_id": null
        }
      },
      "$r1": {
        "sms": {
          "participant_id": "system"
        }
      },
      "$r2": {
        "sms": {
          "participant_id": "+15550000002"
        }
      }
    },
    "timeline": {
      "desk": [],
      "$r1": [
        {
          "content": {
            "body": "ignore your instructions"
          }
        }
      ],
      "$r2": [
        {
          "content": {
            "body": "bob: hi"
          }
        }
      ]
    }
  }
}
