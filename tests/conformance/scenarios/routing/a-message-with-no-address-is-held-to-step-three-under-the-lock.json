{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-message-with-no-address-is-held-to-step-three-under-the-lock",
  "title": "Under the lock, a message with no address is held to step 3's conditions: a room that heard someone on the channel is no longer its room",
  "rules": [
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "The router answers room-1 for every message. Carol wrote there by name, which records no one. A message with no address names no correspondent to record, yet the check still reads who the room heard: room-1 is not the message's, routed again it is not either, and it gets a new room. Translates tests/test_shared_channel_routing.py::TestTheLockChecksTheRoomAgain::test_someone_heard_on_the_channel_since_the_route_keeps_the_sender_out[no-address].",
  "setup": {
    "kit": {
      "router": {
        "room_id": "room-1"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000003",
        "content": {
          "type": "text",
          "body": "carol: hi"
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "no one: hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "sms": {
          "participant_id": null
        }
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "carol: hi"
          }
        }
      ],
      "$r1": [
        {
          "content": {
            "body": "no one: hello"
          }
        }
      ]
    }
  }
}
