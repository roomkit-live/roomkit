{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-value-under-the-key-naming-the-sender-s-identity-is-recorded-as-written",
  "title": "A value under the declared key that is the sender's identity is theirs, on a channel whose recipient_address answers none: the record names that value",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "As a channel reading its recipient does: the recipient as routing reads it names the correspondent.",
  "setup": {
    "identities": [
      {
        "id": "identity-of-bob",
        "channel_addresses": {
          "sms": [
            "+15550000002"
          ]
        }
      }
    ],
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number"
      }
    ],
    "rooms": [
      {
        "id": "room-1"
      }
    ]
  },
  "steps": [
    {
      "call": "store.add_binding",
      "binding": {
        "room_id": "room-1",
        "channel_id": "sms",
        "channel_type": "sms",
        "metadata": {
          "phone_number": "identity-of-bob"
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "Hello, Bob here"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "room-1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "sms": {
          "participant_id": "identity-of-bob",
          "metadata": {
            "phone_number": "identity-of-bob"
          }
        }
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "Hello, Bob here"
          }
        }
      ]
    }
  }
}
