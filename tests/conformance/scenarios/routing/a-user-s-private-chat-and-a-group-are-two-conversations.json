{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-user-s-private-chat-and-a-group-are-two-conversations",
  "title": "On a chat channel a user's private chat and a group they write in are two rooms, each answered in its own chat; a group's members share its room and their private chats stay apart",
  "rules": [
    "§10.4",
    "§5.7"
  ],
  "notes": "Python: tests/test_chat_conversations.py::test_a_group_message_is_answered_in_the_group_after_a_private_chat, test_a_private_message_is_answered_in_private_after_a_group, test_a_groups_members_share_its_room_and_their_private_chats_stay_apart. A private chat's id is its user's. Each answer is delivered in its room, whose binding names the chat it replies to.",
  "setup": {
    "channels": [
      {
        "id": "tg",
        "type": "telegram",
        "category": "transport",
        "recipient_key": "telegram_chat_id",
        "addresses": {
          "conversation_key": "chat_id"
        }
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "text": "ok"
            },
            {
              "text": "ok"
            },
            {
              "text": "ok"
            },
            {
              "text": "ok"
            },
            {
              "text": "ok"
            }
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "agent-joins",
        "trigger": "on_room_created",
        "reactions": [
          {
            "repeat": true,
            "do": [
              {
                "call": "attach_channel",
                "room_id": "$room",
                "channel_id": "ai",
                "category": "intelligence"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "tg",
        "sender_id": "1001",
        "content": {
          "type": "text",
          "body": "hi"
        },
        "metadata": {
          "chat_id": "1001"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "tg",
        "sender_id": "1001",
        "content": {
          "type": "text",
          "body": "hi everyone"
        },
        "metadata": {
          "chat_id": "-100500"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r2"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "tg",
        "sender_id": "1002",
        "content": {
          "type": "text",
          "body": "hello"
        },
        "metadata": {
          "chat_id": "-100500"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r2"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "tg",
        "sender_id": "1002",
        "content": {
          "type": "text",
          "body": "something private"
        },
        "metadata": {
          "chat_id": "1002"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r3"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "tg",
        "sender_id": "1001",
        "content": {
          "type": "text",
          "body": "a private question"
        },
        "metadata": {
          "chat_id": "1001"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "$r1": {
        "tg": {
          "participant_id": "1001",
          "metadata": {
            "telegram_chat_id": "1001"
          }
        }
      },
      "$r2": {
        "tg": {
          "participant_id": "-100500",
          "metadata": {
            "telegram_chat_id": "-100500"
          }
        }
      },
      "$r3": {
        "tg": {
          "participant_id": "1002",
          "metadata": {
            "telegram_chat_id": "1002"
          }
        }
      }
    },
    "timeline": {
      "$r2": [
        {
          "content": {
            "body": "hi everyone"
          },
          "source": {
            "participant_id": "1001"
          }
        },
        {
          "content": {
            "body": "ok"
          }
        },
        {
          "content": {
            "body": "hello"
          },
          "source": {
            "participant_id": "1002"
          }
        },
        {
          "content": {
            "body": "ok"
          }
        }
      ]
    },
    "deliveries": {
      "$r1": {
        "tg": [
          {
            "content": {
              "body": "ok"
            }
          },
          {
            "content": {
              "body": "ok"
            }
          }
        ]
      },
      "$r2": {
        "tg": [
          {
            "content": {
              "body": "ok"
            }
          },
          {
            "content": {
              "body": "ok"
            }
          }
        ]
      },
      "$r3": {
        "tg": [
          {
            "content": {
              "body": "ok"
            }
          }
        ]
      }
    }
  }
}
