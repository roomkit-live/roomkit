{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-group-room-takes-a-message-with-no-address",
  "title": "A group binding takes a routed message with no address, and records no one: a flow of anonymous messages into one room declares it so",
  "rules": [
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "The other side of routing/a-message-with-no-address-leaves-a-room-the-host-prepared.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1"
      }
    ]
  },
  "steps": [
    {
      "call": "store.add_binding",
      "binding": {
        "room_id": "room-1",
        "channel_id": "sms",
        "channel_type": "sms",
        "group": true
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "one"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "room-1"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "  ",
        "content": {
          "type": "text",
          "body": "two"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "room-1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "sms": {
          "participant_id": null
        }
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "one"
          }
        },
        {
          "content": {
            "body": "two"
          }
        }
      ]
    }
  }
}
