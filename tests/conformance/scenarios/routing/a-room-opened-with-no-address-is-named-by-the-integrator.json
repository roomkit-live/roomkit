{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-room-opened-with-no-address-is-named-by-the-integrator",
  "title": "A recipient the integrator gives a room opened with no address names its correspondent: the room is theirs, and they are routed there",
  "rules": [
    "§5.7",
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "Until then the room admits no one and its deliveries are refused. The name system holds no one's place: an update naming a recipient writes the recipient as the correspondent, as on a binding naming no one.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "",
        "content": {
          "type": "text",
          "body": "a first message"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    },
    {
      "call": "update_binding_metadata",
      "room_id": "$r1",
      "channel_id": "sms",
      "metadata": {
        "phone_number": "+15550000002"
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "$r1": {
        "sms": {
          "participant_id": "+15550000002",
          "metadata": {
            "phone_number": "+15550000002"
          }
        }
      }
    },
    "timeline": {
      "$r1": [
        {
          "content": {
            "body": "a first message"
          }
        },
        {
          "content": {
            "body": "bob: hi"
          }
        }
      ]
    }
  }
}
