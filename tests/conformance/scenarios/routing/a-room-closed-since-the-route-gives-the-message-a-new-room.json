{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-room-closed-since-the-route-gives-the-message-a-new-room",
  "title": "A sender routed to a free room, closed before his message is recorded, is not refused room_closed: he opens a room of his own, and the closed room names no one",
  "rules": [
    "§10.1 step 2",
    "§10.4",
    "§5.1"
  ],
  "notes": "Python: tests/test_shared_channel_routing.py::TestTheLockChecksTheRoomAgain::test_a_room_closed_since_the_route_gives_the_message_a_new_room. A routed message is never refused room_closed at step 2. A scripted router answers the free room each time it is asked, where Python's default router answers no room the second time; either gives the message a new room.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "free",
        "gate": "routed"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "text": "AI reply"
            }
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "agent-joins",
        "trigger": "on_room_created",
        "reactions": [
          {
            "repeat": true,
            "do": [
              {
                "call": "attach_channel",
                "room_id": "$room",
                "channel_id": "ai",
                "category": "intelligence"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "create_room",
      "room": {
        "id": "free"
      }
    },
    {
      "call": "attach_channel",
      "room_id": "free",
      "channel_id": "sms"
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: hello"
        }
      },
      "background": true,
      "as": "bob"
    },
    {
      "wait_for": "routed"
    },
    {
      "call": "close_room",
      "room_id": "free"
    },
    {
      "open": "routed"
    },
    {
      "await": "bob",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "free": {
        "sms": {
          "participant_id": null
        }
      },
      "$r1": {
        "sms": {
          "participant_id": "+15550000002"
        }
      }
    },
    "rooms": {
      "free": {
        "status": "closed"
      }
    }
  }
}
