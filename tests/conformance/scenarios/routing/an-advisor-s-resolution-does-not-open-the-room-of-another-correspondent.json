{
  "$schema": "../../scenario.schema.json",
  "id": "routing/an-advisor-s-resolution-does-not-open-the-room-of-another-correspondent",
  "title": "An advisor resolving a participant reached through the channel does not take the binding naming another correspondent: it still names them, they still reach their room, and the participant gets a room of their own",
  "rules": [
    "§5.5",
    "§5.7",
    "§10.1 step 2",
    "§10.4",
    "Appendix B.3"
  ],
  "requirements": [
    "RK-10.1-018",
    "RK-10.1-024",
    "RK-10.4-053",
    "RK-5.5-024"
  ],
  "notes": "The binding names bob, its correspondent and recipient. Resolving alice, a member the host added on sms, leaves it naming him: bob's next message is the room's, alice's opens another.",
  "setup": {
    "identities": [
      {
        "id": "id-alice"
      }
    ],
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "participants": [
          {
            "id": "+15550000001",
            "channel_id": "sms",
            "connected_via": [
              "sms"
            ],
            "identification": "pending"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "store.add_binding",
      "binding": {
        "room_id": "room-1",
        "channel_id": "sms",
        "channel_type": "sms",
        "metadata": {
          "phone_number": "+15550000002"
        },
        "participant_id": "+15550000002"
      }
    },
    {
      "call": "resolve_participant",
      "room_id": "room-1",
      "participant_id": "+15550000001",
      "identity_id": "id-alice",
      "expect": {
        "result": {
          "identification": "identified",
          "identity_id": "id-alice"
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000001",
        "content": {
          "type": "text",
          "body": "alice: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "room-1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "sms": {
          "participant_id": "+15550000002"
        }
      }
    },
    "participants": {
      "room-1": [
        {
          "id": "+15550000001",
          "identification": "identified",
          "identity_id": "id-alice"
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "bob: hi"
          }
        }
      ]
    }
  }
}
