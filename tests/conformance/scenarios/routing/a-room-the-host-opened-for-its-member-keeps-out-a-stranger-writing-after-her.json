{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-room-the-host-opened-for-its-member-keeps-out-a-stranger-writing-after-her",
  "title": "A room the host opened for a customer, her member record added, keeps out a stranger writing after her: he gets a room of his own, nothing more is sent to her, and his agent reads nothing of hers",
  "rules": [
    "§10.4",
    "§10.1 step 2",
    "§7.5 rule 8"
  ],
  "notes": "Python: tests/test_shared_channel_routing.py::TestARoomTheHostOpened::test_bob_is_kept_out_of_alices_room_and_nothing_reaches_her. An agent joins every room the kit opens.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "text": "AI reply"
            },
            {
              "text": "AI reply"
            }
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "agent-joins",
        "trigger": "on_room_created",
        "reactions": [
          {
            "repeat": true,
            "do": [
              {
                "call": "attach_channel",
                "room_id": "$room",
                "channel_id": "ai",
                "category": "intelligence"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "create_room",
      "room": {
        "id": "alice-room"
      }
    },
    {
      "call": "attach_channel",
      "room_id": "alice-room",
      "channel_id": "sms",
      "metadata": {
        "phone_number": "+15550000001"
      }
    },
    {
      "call": "add_member",
      "room_id": "alice-room",
      "channel_id": "sms",
      "participant_id": "+15550000001"
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000001",
        "content": {
          "type": "text",
          "body": "alice: my account number is 1234"
        }
      },
      "expect": {
        "result": {
          "event": {
            "room_id": "alice-room"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: hello"
        }
      },
      "expect": {
        "result": {
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "alice-room": {
        "sms": {
          "participant_id": "+15550000001"
        }
      },
      "$r1": {
        "sms": {
          "participant_id": "+15550000002"
        }
      }
    },
    "deliveries": {
      "alice-room": {
        "sms": [
          {
            "content": {
              "body": "AI reply"
            }
          }
        ]
      },
      "$r1": {
        "sms": [
          {
            "content": {
              "body": "AI reply"
            }
          }
        ]
      }
    },
    "models": {
      "ai": [
        {
          "messages": [
            {
              "role": "user",
              "text": "alice: my account number is 1234"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "bob: hello"
            }
          ]
        }
      ]
    }
  }
}
