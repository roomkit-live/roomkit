{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-sender-is-read-in-the-channel-s-own-form",
  "title": "A sender is written by the channel's own normalize_address before anything reads it: two spellings of one id are one sender in one room",
  "rules": [
    "§10.1 step 1",
    "§5.7",
    "§10.4"
  ],
  "notes": "The channel writes its users' ids lower-case by its own normalize_address, whatever its declared addressing (a WebSocket's, ids as written). The framework reads every inbound sender through it before routing, so the room, its binding and the events name one sender.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "addresses": {
          "normalizes": {
            "User-42": "user-42"
          }
        }
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "ws",
        "sender_id": "User-42",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "expect": {
        "result": {
          "event": {
            "room_id": "$r1",
            "source": {
              "participant_id": "user-42"
            }
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "ws",
        "sender_id": "user-42",
        "content": {
          "type": "text",
          "body": "Again"
        }
      },
      "expect": {
        "result": {
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "$r1": [
        {
          "content": {
            "type": "text",
            "body": "Hello"
          },
          "source": {
            "participant_id": "user-42"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "Again"
          },
          "source": {
            "participant_id": "user-42"
          }
        }
      ]
    },
    "bindings": {
      "$r1": {
        "ws": {
          "participant_id": "user-42"
        }
      }
    }
  }
}
