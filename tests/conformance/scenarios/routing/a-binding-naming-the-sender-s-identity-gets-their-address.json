{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-binding-naming-the-sender-s-identity-gets-their-address",
  "title": "The record writes the sender's address as the recipient of a binding naming their identity, which holds none",
  "rules": [
    "§5.7",
    "§10.1 step 2"
  ],
  "notes": "A binding the host named by the identity holds no value under the key. Bob is found at step 1, and the room answers him at the address he wrote from (HITL b75a9c93).",
  "setup": {
    "identities": [
      {
        "id": "identity-of-bob",
        "channel_addresses": {
          "sms": [
            "+15550000002"
          ]
        }
      }
    ],
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      }
    ],
    "rooms": [
      {
        "id": "room-1"
      }
    ]
  },
  "steps": [
    {
      "call": "store.add_binding",
      "binding": {
        "room_id": "room-1",
        "channel_id": "sms",
        "channel_type": "sms",
        "metadata": {},
        "participant_id": "identity-of-bob"
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "Hello, Bob here"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "room-1"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "sms": {
          "participant_id": "identity-of-bob",
          "metadata": {
            "phone_number": "+15550000002"
          }
        }
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "Hello, Bob here"
          }
        }
      ]
    }
  }
}
