{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-foreign-explicit-room-is-refused-before-attach",
  "title": "A foreign explicit room fails before attach, hooks, storage or delivery, even with deferred delivery",
  "rules": [
    "§10.1 step 2",
    "§10.4",
    "§17.2"
  ],
  "notes": "Python: tests/test_room_org_scoping.py::TestScopedInbound::test_an_explicit_room_of_another_organization_is_not_found, test_a_router_answering_another_organizations_room_fails_the_message and test_a_deferred_send_to_another_organization_is_refused_synchronously. The foreign room has no source binding, making an accidental auto-attach observable.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "foreign"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sink",
        "type": "sms",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "foreign",
        "organization_id": "globex",
        "bindings": [
          {
            "channel_id": "sink"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_broadcast"
      },
      {
        "name": "attached",
        "trigger": "on_channel_attached"
      },
      {
        "name": "created",
        "trigger": "on_room_created"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "defer_delivery": false,
      "expect": {
        "error": "room_not_found"
      },
      "room_id": "foreign",
      "organization_id": "acme"
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "defer_delivery": true,
      "expect": {
        "error": "room_not_found"
      },
      "room_id": "foreign",
      "organization_id": "acme"
    }
  ],
  "expect": {
    "router_calls": [],
    "rooms": {
      "$created": {
        "$unordered": []
      },
      "foreign": {
        "organization_id": "globex",
        "event_count": 0
      }
    },
    "bindings": {
      "foreign": {
        "sms": {
          "$absent": true
        }
      }
    },
    "timeline": {
      "foreign": []
    },
    "deliveries": {
      "foreign": {
        "sink": []
      }
    },
    "hooks": {
      "before": [],
      "attached": [],
      "created": []
    }
  }
}
