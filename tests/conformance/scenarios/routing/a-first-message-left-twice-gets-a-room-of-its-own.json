{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-first-message-left-twice-gets-a-room-of-its-own",
  "title": "A third sender recorded on the second room the message is given: the message gets a third of its own",
  "rules": [
    "§10.1 step 2",
    "§10.4"
  ],
  "notes": "Review probe, default router. Bob takes Alice's first room by step 3; Bob's room loses its channel, so Carol takes Alice's second by step 3 too. Found by the review of RMK-1396.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {}
      }
    ],
    "hooks": [
      {
        "name": "bind",
        "trigger": "on_room_created",
        "priority": 0,
        "reactions": [
          {
            "repeat": true,
            "do": [
              {
                "call": "attach_channel",
                "room_id": "$room",
                "channel_id": "sms"
              }
            ]
          }
        ]
      },
      {
        "name": "hold",
        "trigger": "on_room_created",
        "priority": 1,
        "reactions": [
          {
            "gate": "g1"
          },
          {
            "gate": "g2"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000001",
        "content": {
          "type": "text",
          "body": "alice: secret"
        }
      },
      "background": true,
      "as": "alice"
    },
    {
      "wait_for": "g1"
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000002",
        "content": {
          "type": "text",
          "body": "bob: secret"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    },
    {
      "open": "g1"
    },
    {
      "wait_for": "g2"
    },
    {
      "call": "detach_channel",
      "room_id": "$r1",
      "channel_id": "sms"
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000003",
        "content": {
          "type": "text",
          "body": "carol: secret"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r2"
          }
        }
      }
    },
    {
      "open": "g2"
    },
    {
      "await": "alice",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r3"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "$r2": {
        "sms": {
          "participant_id": "+15550000003"
        }
      },
      "$r3": {
        "sms": {
          "participant_id": "+15550000001"
        }
      }
    },
    "timeline": {
      "$r1": [
        {
          "content": {
            "body": "bob: secret"
          }
        }
      ],
      "$r2": [
        {
          "content": {
            "body": "carol: secret"
          }
        }
      ],
      "$r3": [
        {
          "content": {
            "body": "alice: secret"
          }
        }
      ]
    }
  }
}
