{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-failure-closes-the-text-window",
  "title": "A provider's failure closes the answer's text window: what it held goes out",
  "rules": [
    "§6.4",
    "§23.3"
  ],
  "notes": "Python: channels/_ai_stream_round.py stream, close in its finally.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "publish_text_deltas": true,
        "text_coalesce_ms": 60000,
        "model": {
          "rounds": [
            {
              "deltas": [
                "ab"
              ],
              "fails": "boom"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "parent",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Go.",
      "wait": true
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "text_events": {
      "$r1": [
        {
          "text": "ab",
          "round": 0,
          "channel_id": "worker"
        }
      ]
    }
  }
}
