{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-reader-that-stops-on-a-blank-delta-stores-no-text",
  "title": "A reader that stops on a blank delta stores no text for it: the turn ends cancelled on the last message it stored",
  "rules": [
    "§6.4",
    "§12.2 step 13s"
  ],
  "notes": "Python: core/mixins/inbound_streaming.py _stop_unread_stream, core/mixins/_streaming_segments.py flush_text, end_stopped (RMK-1300).",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true,
        "deliver_stream": [
          {
            "stop_after": "\n\n"
          }
        ]
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "Looking.",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "deltas": [
                "\n\n",
                "later"
              ]
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        }
      },
      "expect": {
        "result": {
          "response_metadata": {
            "turns": {
              "agent": {
                "loop_end_reason": "cancelled"
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "hi"
          }
        },
        {
          "index": 1,
          "type": "message",
          "content": {
            "body": "Looking."
          },
          "metadata": {
            "loop_end_reason": "cancelled"
          }
        },
        {
          "index": 2,
          "type": "tool_call_start"
        },
        {
          "index": 3,
          "type": "tool_call_end"
        }
      ]
    }
  }
}
