{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-room-s-subscriber-reads-no-reasoning-text-by-default",
  "title": "A room's realtime subscriber reads no reasoning text by default: each thinking event carries its length, its round and the agent, the text absent; the hook and the turn's record, on the server's side, still read it",
  "rules": [
    "§6.7",
    "§9.2"
  ],
  "notes": "Python: channels/_ai_events.py _publish_thinking_event; tests/test_ai_streaming_thinking.py test_a_subscriber_reads_the_reasoning_text_only_when_opted_in[private-by-default].",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "thinking_coalesce_ms": 60000,
        "model": {
          "rounds": [
            {
              "thinking": [
                "user asked ",
                "the meaning"
              ],
              "text": "42."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reasons",
        "trigger": "on_ai_thinking",
        "execution": "async"
      },
      {
        "name": "answers",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "thinking_events": {
      "room-1": [
        {
          "type": "thinking_start",
          "thinking": {
            "$absent": true
          },
          "thinking_length": 0,
          "round": 0,
          "channel_id": "agent"
        },
        {
          "type": "thinking_delta",
          "thinking": {
            "$absent": true
          },
          "thinking_length": 22,
          "round": 0,
          "channel_id": "agent"
        },
        {
          "type": "thinking_end",
          "thinking": {
            "$absent": true
          },
          "thinking_length": 22,
          "round": 0,
          "channel_id": "agent"
        }
      ]
    },
    "hooks": {
      "reasons": [
        {
          "room_id": "room-1",
          "thinking": {
            "channel_id": "agent",
            "thinking": "",
            "round_index": 0
          }
        }
      ],
      "answers": [
        {
          "room_id": "room-1",
          "response": {
            "channel_id": "agent",
            "thinking": "user asked the meaning"
          }
        }
      ]
    }
  }
}
