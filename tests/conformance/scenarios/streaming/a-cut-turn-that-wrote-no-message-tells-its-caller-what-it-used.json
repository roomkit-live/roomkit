{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-cut-turn-that-wrote-no-message-tells-its-caller-what-it-used",
  "title": "A turn cut while a call runs, having written no text at all, has no message to hold its record: its caller still reads its end and what it used",
  "rules": [
    "§6.1",
    "§6.4 The turn's record",
    "§12.2 step 13s"
  ],
  "notes": "Python: channels/_ai_streaming.py _stream_generation (a UsageMarker after each generation), core/mixins/_streaming_segments.py read and end_stopped (RMK-1333). record_on_last_message finds no MESSAGE. Where the record lands in the store: see the card RMK-1333.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "name": "opus",
          "provider": "anthropic",
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "wait"
                }
              ],
              "usage": {
                "input_tokens": 1000,
                "output_tokens": 10
              }
            }
          ]
        },
        "tools": [
          {
            "name": "wait",
            "description": "Wait.",
            "gate": "waits",
            "hangs": true
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        },
        "delivery_key": "k"
      },
      "background": true,
      "as": "a"
    },
    {
      "wait_for": "waits"
    },
    {
      "call": "cancel_delivery",
      "key": "k",
      "reason": "stopped",
      "expect": {
        "result": 1
      }
    },
    {
      "await": "a",
      "expect": {
        "result": {
          "cancellation_reason": "stopped",
          "response_metadata": {
            "turns": {
              "agent": {
                "loop_end_reason": "cancelled",
                "ai_usage": {
                  "input_tokens": 1000,
                  "output_tokens": 10
                }
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "Go."
          },
          "metadata": {
            "loop_end_reason": {
              "$absent": true
            }
          }
        },
        {
          "index": 1,
          "type": "tool_call_start"
        },
        {
          "index": 2,
          "type": "tool_call_end"
        }
      ]
    }
  }
}
