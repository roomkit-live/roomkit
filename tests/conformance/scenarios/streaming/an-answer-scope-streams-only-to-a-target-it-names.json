            "channel_id": "ai",
            "category": "intelligence"
          },
          {
            "channel_id": "st1"
          },
          {
            "channel_id": "st2"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "ai",
            "category": "intelligence"
