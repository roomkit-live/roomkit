          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "src",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Hi"
        },
        "response_visibility": "st1,st3"
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
