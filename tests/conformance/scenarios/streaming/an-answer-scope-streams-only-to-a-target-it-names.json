              ]
            },
            {
              "deltas": [
                "ans",
                "wer"
              ]
            }
          ]
        }
      },
      {
        "id": "st1",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "st2",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "st3",
        "type": "websocket",
        "category": "transport",
        "streams": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
