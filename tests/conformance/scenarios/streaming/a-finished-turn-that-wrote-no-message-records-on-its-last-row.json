{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-finished-turn-that-wrote-no-message-records-on-its-last-row",
  "title": "A turn that reaches its end having written no message holds its record on its last row, the call's end: an update, as on a message, ON_EVENT_UPDATED firing and the row not delivered again",
  "rules": [
    "§6.4 The turn's record"
  ],
  "notes": "Python: core/mixins/_streaming_segments.py write_owed_record (RMK-1344, HITL 5f58e3e3). The blank round comes back empty, so the loop asks once more (test_ai_empty_retry.py) and the second blank ends the turn.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ],
              "usage": {
                "input_tokens": 1000,
                "output_tokens": 10
              }
            },
            {
              "deltas": [
                "\n\n"
              ]
            },
            {
              "deltas": [
                "\n"
              ]
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "updated",
        "trigger": "on_event_updated",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        }
      },
      "expect": {
        "result": {
          "response_metadata": {
            "turns": {
              "agent": {
                "loop_end_reason": "empty_response",
                "ai_usage": {
                  "input_tokens": 1000,
                  "output_tokens": 10
                }
              }
            }
          },
          "response_events": [
            {
              "type": "tool_call_start",
              "metadata": {
                "loop_end_reason": {
                  "$absent": true
                }
              }
            },
            {
              "type": "tool_call_end",
              "metadata": {
                "loop_end_reason": "empty_response",
                "ai_usage": {
                  "input_tokens": 1000,
                  "output_tokens": 10
                }
              }
            }
          ]
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "content": {
            "body": "hi"
          },
          "metadata": {
            "loop_end_reason": {
              "$absent": true
            }
          }
        },
        {
          "index": 1,
          "type": "tool_call_start",
          "metadata": {
            "loop_end_reason": {
              "$absent": true
            }
          }
        },
        {
          "index": 2,
          "type": "tool_call_end",
          "metadata": {
            "loop_end_reason": "empty_response",
            "ai_usage": {
              "input_tokens": 1000,
              "output_tokens": 10
            }
          }
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "web": [
          {
            "index": 0
          },
          {
            "index": 1,
            "type": "tool_call_start"
          },
          {
            "index": 2,
            "type": "tool_call_end"
          }
        ]
      }
    },
    "hooks": {
      "updated": [
        {
          "event": {
            "type": "tool_call_end",
            "metadata": {
              "loop_end_reason": "empty_response"
            }
          }
        }
      ]
    }
  }
}
