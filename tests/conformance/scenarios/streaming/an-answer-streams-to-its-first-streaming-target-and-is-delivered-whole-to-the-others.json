{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/an-answer-streams-to-its-first-streaming-target-and-is-delivered-whole-to-the-others",
  "title": "With no answer scope, the first streaming transport is streamed the answer and another streaming one is delivered it whole, stored `all`",
  "rules": [
    "§12.2 step 11s",
    "§12.2 step 13s",
    "§6.1"
  ],
  "notes": "Python: tests/test_response_visibility.py::TestResponseVisibilityDefault::test_default_streams_to_first_target and TestResponseVisibilityStoredEvent::test_stored_event_default_visibility. One streaming target per response.",
  "setup": {
    "channels": [
      {
        "id": "src",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "deltas": [
                "ans",
                "wer"
              ]
            }
          ]
        }
      },
      {
        "id": "st1",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "st2",
        "type": "websocket",
        "category": "transport",
        "streams": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "ai",
            "category": "intelligence"
          },
          {
            "channel_id": "st1"
          },
          {
            "channel_id": "st2"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "src",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "Hi"
          }
        },
        {
          "id": "room-1#1",
          "source": {
            "channel_id": "ai"
          },
          "content": {
            "body": "answer"
          },
          "visibility": "all"
        }
      ]
    },
    "streamed": {
      "room-1": {
        "st1": [
          {
            "text": "ans"
          },
          {
            "text": "wer"
          },
          {
            "row": {
              "id": "room-1#1",
              "content": {
                "body": "answer"
              }
            }
          }
        ],
        "st2": []
      }
    },
    "deliveries": {
      "room-1": {
        "st1": [
          {
            "index": 0
          }
        ],
        "st2": [
          {
            "index": 0
          },
          {
            "id": "room-1#1",
            "source": {
              "channel_id": "ai"
            },
            "content": {
              "body": "answer"
            }
          }
        ]
      }
    }
  }
}
