{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-streaming-target-a-tool-call-row-s-hook-narrows-away-reads-on",
  "title": "A streaming target a streamed tool-call row's BEFORE_BROADCAST hook narrows the row away from is handed every row but that one, and the stream goes on",
  "rules": [
    "§7.3",
    "§7.5 rule 2",
    "§9.5",
    "§12.2 step 14s"
  ],
  "requirements": [
    "RK-9.4-011"
  ],
  "notes": "A BEFORE_BROADCAST hook narrows the agent's tool-call start to web. ws, the streaming target, is not handed that row (§7.3), but a tool-call row withdraws no response: ws reads the rest of the stream, its text and its rows, as before.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "deltas": [
                "Let me ",
                "check."
              ],
              "calls": [
                {
                  "id": "call-1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "42"
                  }
                }
              ]
            },
            {
              "deltas": [
                "Order 42 ",
                "shipped."
              ]
            }
          ]
        },
        "tools": [
          {
            "name": "lookup_order",
            "description": "Find an order by its number",
            "parameters": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "string"
                }
              },
              "required": [
                "order"
              ]
            },
            "returns": "shipped"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "narrow",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "type": "tool_call_start"
            },
            "result": {
              "action": "modify",
              "event": {
                "visibility": "web"
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Where is order 42?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "web"
          },
          "content": {
            "body": "Where is order 42?"
          },
          "status": "delivered"
        },
        {
          "index": 1,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Let me check."
          },
          "status": "delivered"
        },
        {
          "index": 2,
          "type": "tool_call_start",
          "content": {
            "tool_id": "call-1",
            "status": "pending"
          },
          "status": "delivered",
          "visibility": "web"
        },
        {
          "index": 3,
          "type": "tool_call_end",
          "content": {
            "tool_id": "call-1",
            "status": "completed",
            "result": "shipped"
          },
          "status": "delivered"
        },
        {
          "index": 4,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Order 42 shipped."
          },
          "status": "delivered"
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "index": 0
          }
        ],
        "web": [
          {
            "id": "room-1#1"
          },
          {
            "id": "room-1#2"
          },
          {
            "id": "room-1#3"
          },
          {
            "id": "room-1#4"
          }
        ]
      }
    },
    "streamed": {
      "room-1": {
        "ws": [
          {
            "text": "Let me "
          },
          {
            "text": "check."
          },
          {
            "row": {
              "id": "room-1#1",
              "index": 1,
              "type": "message",
              "content": {
                "body": "Let me check."
              }
            }
          },
          {
            "row": {
              "id": "room-1#3",
              "index": 3,
              "type": "tool_call_end"
            }
          },
          {
            "text": "Order 42 "
          },
          {
            "text": "shipped."
          },
          {
            "row": {
              "id": "room-1#4",
              "index": 4,
              "type": "message",
              "content": {
                "body": "Order 42 shipped."
              }
            }
          }
        ]
      }
    }
  }
}
