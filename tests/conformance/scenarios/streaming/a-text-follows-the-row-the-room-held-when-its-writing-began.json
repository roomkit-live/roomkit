{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-text-follows-the-row-the-room-held-when-its-writing-began",
  "title": "A text of a streamed turn names the row the room held when its writing began: a record received while the round was under way, before its first text, is stored before that text, which follows the row before the record",
  "rules": [
    "§5.2",
    "§6.4",
    "§21.3"
  ],
  "requirements": [
    "RK-21.3-009",
    "RK-5.2-001"
  ],
  "notes": "Python: tests/test_conversation_order.py. The first round is held at its gate once its generation started, before it writes anything. Another session's answer is committed meanwhile, a record no member receives, and steered into the turn. The round then writes that it waits, the same turn asks the model again, and the second round gives the value. The timeline holds the rows in the order they were stored, the record before the text whose writing began before it; the text's metadata.follows_index names the message it answers, the last row the room held when the kit began to read the response, and the second text's names the first, the response's row stored before it. A reader that orders by (follows_index, else index; then index) reads the wait, the record, the value. A row's created_at is its own: the two texts and the message they answer carry three instants.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "first-text",
              "text": "I wait for the answer."
            },
            {
              "text": "The value is MAC-ERABLE."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "Ask the other session."
        }
      },
      "background": true,
      "as": "asking"
    },
    {
      "wait_for": "first-text"
    },
    {
      "call": "commit_event",
      "room_id": "room-1",
      "event": {
        "type": "system",
        "source": {
          "channel_id": "ws",
          "channel_type": "websocket"
        },
        "content": {
          "type": "text",
          "body": "Reply from @review: MAC-ERABLE"
        }
      }
    },
    {
      "call": "steer",
      "room_id": "room-1",
      "channel_id": "agent",
      "directive": {
        "type": "inject_message",
        "content": "The other session answered MAC-ERABLE."
      },
      "expect": {
        "result": 1
      }
    },
    {
      "open": "first-text"
    },
    {
      "await": "asking",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "Ask the other session."
          },
          "created_at": {
            "$as": "asked"
          }
        },
        {
          "index": 1,
          "type": "system",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "Reply from @review: MAC-ERABLE"
          },
          "metadata": {
            "follows_index": {
              "$absent": true
            }
          }
        },
        {
          "index": 2,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "I wait for the answer."
          },
          "created_at": {
            "$as": "first text"
          },
          "metadata": {
            "follows_index": 0
          }
        },
        {
          "index": 3,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "The value is MAC-ERABLE."
          },
          "created_at": {
            "$as": "second text"
          },
          "metadata": {
            "follows_index": 2,
            "loop_end_reason": "completed"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Ask the other session."
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Ask the other session."
            },
            {
              "role": "assistant",
              "text": "I wait for the answer."
            },
            {
              "role": "user",
              "text": "The other session answered MAC-ERABLE."
            }
          ]
        }
      ]
    }
  }
}
