{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-narrowed-binding-s-turn-publishes-no-reasoning",
  "title": "An agent whose binding's visibility narrows its answers publishes nothing of its reasoning to the room's subscribers",
  "rules": [
    "§6.7",
    "§8.4"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "thinking_coalesce_ms": 60000,
        "model": {
          "rounds": [
            {
              "thinking": [
                "Let me"
              ],
              "text": "Done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "visibility": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "thinking_events": {
      "room-1": []
    }
  },
  "notes": "Python: tests/test_turn_ephemerals_scope.py test_a_turn_whose_answer_the_room_narrows_publishes_no_ephemeral; turns/_owner_publish.py publish_frame; core/visibility.py binding_reaches_room."
}
