{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-cut-after-two-generations-keeps-what-they-used",
  "title": "A turn cut while a call runs, two generations done, records what they used as a finished turn does, its end cancelled and its usage complete",
  "rules": [
    "§6.1",
    "§6.4 The turn's record",
    "§12.2 step 13s"
  ],
  "notes": "Python: channels/_ai_streaming.py _stream_generation (a UsageMarker after each generation), core/mixins/_streaming_segments.py read and end_stopped (RMK-1333). tests/tasks/test_stopped_stream_turn_end.py. The real bases: 8 cut turns of 8 stored no usage (RMK-1333).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "name": "opus",
          "provider": "anthropic",
          "rounds": [
            {
              "text": "One.",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ],
              "usage": {
                "input_tokens": 1000,
                "output_tokens": 10
              }
            },
            {
              "text": "Two.",
              "calls": [
                {
                  "id": "c2",
                  "name": "wait"
                }
              ],
              "usage": {
                "input_tokens": 2000,
                "output_tokens": 10
              }
            },
            {
              "text": "Never."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "returns": "found"
          },
          {
            "name": "wait",
            "description": "Wait.",
            "gate": "waits",
            "hangs": true
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        },
        "delivery_key": "k"
      },
      "background": true,
      "as": "a"
    },
    {
      "wait_for": "waits"
    },
    {
      "call": "cancel_delivery",
      "key": "k",
      "reason": "stopped",
      "expect": {
        "result": 1
      }
    },
    {
      "await": "a",
      "expect": {
        "result": {
          "cancellation_reason": "stopped",
          "response_metadata": {
            "turns": {
              "agent": {
                "loop_end_reason": "cancelled",
                "ai_usage": {
                  "input_tokens": 3000,
                  "output_tokens": 20
                }
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1
        },
        {
          "index": 2
        },
        {
          "index": 3
        },
        {
          "index": 4,
          "content": {
            "body": "Two."
          },
          "metadata": {
            "loop_end_reason": "cancelled",
            "ai_usage": {
              "input_tokens": 3000,
              "output_tokens": 20
            },
            "ai_last_usage": {
              "input_tokens": 2000,
              "output_tokens": 10
            },
            "ai_usage_complete": true,
            "ai_model": "opus",
            "ai_provider": "anthropic"
          }
        },
        {
          "index": 5,
          "type": "tool_call_start"
        },
        {
          "index": 6,
          "type": "tool_call_end"
        }
      ]
    }
  }
}
