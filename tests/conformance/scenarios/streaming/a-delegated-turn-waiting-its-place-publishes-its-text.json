{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-delegated-turn-waiting-its-place-publishes-its-text",
  "title": "A delegated turn that waits its place in the room is read as a trace all the same",
  "rules": [
    "§6.4",
    "§23.3"
  ],
  "notes": "Python: core/_room_turns.py read_as_trace; tests/test_ai_streaming_text_events.py::test_a_delegated_turns_text_reaches_its_child_room_while_it_is_written, one at a time.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "deltas": [
                "ab"
              ]
            }
          ]
        },
        "serialize_room_turns": true,
        "text_coalesce_ms": 0,
        "publish_text_deltas": true
      }
    ],
    "rooms": [
      {
        "id": "parent",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Go.",
      "wait": true
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "text_events": {
      "$r1": [
        {
          "text": "ab",
          "round": 0,
          "channel_id": "worker"
        }
      ]
    }
  }
}
