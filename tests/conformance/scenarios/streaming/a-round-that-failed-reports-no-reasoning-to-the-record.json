{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-round-that-failed-reports-no-reasoning-to-the-record",
  "title": "The turn's record reads the reasoning of the rounds whose generation returned: a round that failed reports none",
  "rules": [
    "§6.4",
    "§6.7"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "thinking_coalesce_ms": 60000,
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "thinking": [
                "First."
              ],
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "thinking": [
                "Second."
              ],
              "fails": "the model is down"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "answers",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "answers": [
        {
          "response": {
            "thinking": "First."
          }
        }
      ]
    }
  },
  "notes": "Python: channels/_ai_streaming.py keeps a round's reasoning once its generation returned."
}
