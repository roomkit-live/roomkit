{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-streamed-row-s-hooks-read-the-room-at-the-row",
  "title": "A streamed row's BEFORE_BROADCAST hooks, its synchronous ones and its observers, read the room as it stands at the row, at the row's index, not as it stood when the stream began",
  "rules": [
    "§9.5.1",
    "§10.1 step 12",
    "§10.2"
  ],
  "requirements": [
    "RK-26.1-014",
    "RK-9.5.1-068"
  ],
  "notes": "The integrator commits web's “Any news?” while the agent's tool runs. Each row's hooks read the room's latest events when the row comes, that message included (tool-call rows are no part of them), and the row at the index it takes; a row's hooks still run off the room lock (§9.5.1).",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "deltas": [
                "Let me ",
                "check."
              ],
              "calls": [
                {
                  "id": "call-1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "42"
                  }
                }
              ]
            },
            {
              "deltas": [
                "Done."
              ]
            }
          ]
        },
        "tools": [
          {
            "name": "lookup_order",
            "description": "Find an order by its number",
            "parameters": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "string"
                }
              },
              "required": [
                "order"
              ]
            },
            "returns": "shipped"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "post",
        "trigger": "on_tool_call",
        "reactions": [
          {
            "do": [
              {
                "call": "commit_event",
                "room_id": "$room",
                "event": {
                  "source": {
                    "channel_id": "web"
                  },
                  "content": {
                    "type": "text",
                    "body": "Any news?"
                  },
                  "status": "delivered"
                },
                "as": "posted"
              }
            ]
          }
        ]
      },
      {
        "name": "rows",
        "trigger": "before_broadcast"
      },
      {
        "name": "watch",
        "trigger": "before_broadcast",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Where is order 42?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "rows": [
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "index": 0,
            "type": "message",
            "content": {
              "body": "Where is order 42?"
            }
          },
          "recent_events": []
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "index": 1,
            "type": "message",
            "content": {
              "body": "Let me check."
            }
          },
          "recent_events": [
            "room-1#0"
          ]
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "index": 2,
            "type": "tool_call_start"
          },
          "recent_events": [
            "room-1#0",
            "room-1#1"
          ]
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "index": 4,
            "type": "tool_call_end"
          },
          "recent_events": [
            "room-1#0",
            "room-1#1",
            "room-1#3"
          ]
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "index": 5,
            "type": "message",
            "content": {
              "body": "Done."
            }
          },
          "recent_events": [
            "room-1#0",
            "room-1#1",
            "room-1#3"
          ]
        }
      ],
      "watch": [
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "index": 0,
            "type": "message",
            "content": {
              "body": "Where is order 42?"
            }
          },
          "recent_events": []
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "index": 1,
            "type": "message",
            "content": {
              "body": "Let me check."
            }
          },
          "recent_events": [
            "room-1#0"
          ]
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "index": 2,
            "type": "tool_call_start"
          },
          "recent_events": [
            "room-1#0",
            "room-1#1"
          ]
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "index": 4,
            "type": "tool_call_end"
          },
          "recent_events": [
            "room-1#0",
            "room-1#1",
            "room-1#3"
          ]
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "index": 5,
            "type": "message",
            "content": {
              "body": "Done."
            }
          },
          "recent_events": [
            "room-1#0",
            "room-1#1",
            "room-1#3"
          ]
        }
      ]
    }
  }
}
