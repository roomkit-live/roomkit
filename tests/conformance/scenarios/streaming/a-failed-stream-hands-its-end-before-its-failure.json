{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-failed-stream-hands-its-end-before-its-failure",
  "title": "A response the provider fails after a round of calls hands the reader of the stream its last text's row, then the turn's end, error, then the failure",
  "rules": [
    "§6.4",
    "§12.2 step 13s"
  ],
  "notes": "Python: core/mixins/_streaming_segments.py SegmentWriter.stream (the marker last), end_turn, write_owed_record; core/mixins/inbound_streaming.py _handle_streaming_response. RMK-1537 (HITL 577ecd24).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true,
        "reads_loop_end": true
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": "Partial",
              "fails": "boom"
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "returns": "found"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "streamed": {
      "room-1": {
        "ws": [
          {
            "row": {
              "index": 1,
              "type": "tool_call_start"
            }
          },
          {
            "row": {
              "index": 2,
              "type": "tool_call_end"
            }
          },
          {
            "text": "Partial"
          },
          {
            "row": {
              "index": 3,
              "type": "message"
            }
          },
          {
            "loop_end": {
              "reason": "error",
              "rounds": 1
            }
          },
          {
            "failed": true
          }
        ]
      }
    }
  }
}
