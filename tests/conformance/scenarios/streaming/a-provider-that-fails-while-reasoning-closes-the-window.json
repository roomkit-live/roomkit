{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-provider-that-fails-while-reasoning-closes-the-window",
  "title": "A provider that fails while its model reasons closes the window: what the coalescer held, then THINKING_END with the block; the failure still reaches the turn",
  "rules": [
    "§6.7"
  ],
  "notes": "Python: channels/_ai_stream_round.py _add_thinking, _end_thinking; channels/_ai_streaming.py _close_thinking_window; channels/_ai_events.py _publish_thinking_event; turns/_wiring.py build_thinking_hook; tests/test_ai_streaming_thinking.py test_no_tools_path_closes_the_window_when_the_provider_fails, test_no_tools_path_error_still_reaches_the_consumer.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "thinking_coalesce_ms": 60000,
        "model": {
          "rounds": [
            {
              "thinking": [
                "Let me"
              ],
              "fails": "the model is down"
            }
          ]
        },
        "publish_thinking_text": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        }
      },
      "expect": {
        "result": {
          "error": "the model is down"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "thinking_events": {
      "room-1": [
        {
          "type": "thinking_start",
          "thinking": "",
          "thinking_length": 0,
          "round": 0,
          "channel_id": "agent"
        },
        {
          "type": "thinking_delta",
          "thinking": "Let me",
          "thinking_length": 6,
          "round": 0,
          "channel_id": "agent"
        },
        {
          "type": "thinking_end",
          "thinking": "Let me",
          "thinking_length": 6,
          "round": 0,
          "channel_id": "agent"
        }
      ]
    }
  }
}
