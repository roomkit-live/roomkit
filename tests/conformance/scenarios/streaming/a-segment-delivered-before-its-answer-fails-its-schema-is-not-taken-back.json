{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-segment-delivered-before-its-answer-fails-its-schema-is-not-taken-back",
  "title": "A streamed turn's segment before a call is stored and delivered as it ends; the final answer then failing its schema fails the turn, and takes nothing of that segment back: it stays in the room, as its transports were handed it",
  "rules": [
    "§6.4",
    "§6.7"
  ],
  "requirements": [
    "RK-6.4-049"
  ],
  "notes": "Python: channels/_ai_streaming.py stores each segment as its round ends; the schema check applies to the final answer (RFC §6.7, Tools in the same turn).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "response_schema": {
          "type": "object",
          "properties": {
            "department": {
              "type": "string",
              "enum": [
                "billing",
                "other"
              ]
            }
          },
          "required": [
            "department"
          ],
          "additionalProperties": false
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              }
            },
            "returns": "found"
          }
        ],
        "model": {
          "response_schema": true,
          "response_schema_with_tools": true,
          "rounds": [
            {
              "text": "Let me check that.",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": "Sure, it is billing."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "My card was charged twice."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "the answer is not a JSON document"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1,
          "type": "message",
          "content": {
            "body": "Let me check that."
          }
        },
        {
          "index": 2,
          "type": "tool_call_start"
        },
        {
          "index": 3,
          "type": "tool_call_end"
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "sms": [
          {
            "index": 0
          },
          {
            "index": 1,
            "type": "message",
            "content": {
              "body": "Let me check that."
            }
          },
          {
            "index": 2,
            "type": "tool_call_start"
          },
          {
            "index": 3,
            "type": "tool_call_end"
          }
        ]
      }
    },
    "streamed": {
      "room-1": {
        "ws": [
          {
            "text": "Let me check that."
          },
          {
            "row": {
              "index": 1,
              "type": "message",
              "content": {
                "body": "Let me check that."
              }
            }
          },
          {
            "row": {
              "index": 2,
              "type": "tool_call_start"
            }
          },
          {
            "row": {
              "index": 3,
              "type": "tool_call_end"
            }
          },
          {
            "failed": true
          }
        ]
      }
    }
  }
}
