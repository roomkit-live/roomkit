{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/another-agent-s-message-in-a-task-s-room-publishes-no-text",
  "title": "A turn another agent's message starts in a task's room crosses the room's hooks, so it publishes no text; the task's own turn did",
  "rules": [
    "§6.4",
    "§23.3"
  ],
  "notes": "tests/test_ai_streaming_text_events.py::test_an_answer_a_hook_judges_is_never_published_as_text, another agent in a task's room: the planner is a scripted channel with no reaction, addressed_to asks the worker alone.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "planner",
        "type": "ai",
        "category": "intelligence"
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "publish_text_deltas": true,
        "text_coalesce_ms": 0,
        "model": {
          "rounds": [
            {
              "deltas": [
                "Warm."
              ]
            },
            {
              "deltas": [
                "Secret."
              ]
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "parent",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Warm up.",
      "wait": true
    },
    {
      "call": "attach_channel",
      "room_id": "$r1",
      "channel_id": "planner",
      "category": "intelligence"
    },
    {
      "call": "send_event",
      "room_id": "$r1",
      "channel_id": "planner",
      "content": {
        "type": "text",
        "body": "The card?"
      },
      "addressed_to": [
        "worker"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "text_events": {
      "$r1": [
        {
          "text": "Warm.",
          "round": 0,
          "channel_id": "worker"
        }
      ]
    }
  }
}
