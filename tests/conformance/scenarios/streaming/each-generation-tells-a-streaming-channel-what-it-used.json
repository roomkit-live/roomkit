{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/each-generation-tells-a-streaming-channel-what-it-used",
  "title": "A streaming channel that reads it is told after each generation what the generation used, the model and the provider, in its order among the text and the rows; the store holds none of it",
  "rules": [
    "§6.1",
    "§6.4 The turn's record"
