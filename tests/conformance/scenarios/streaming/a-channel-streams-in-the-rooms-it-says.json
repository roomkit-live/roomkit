{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-channel-streams-in-the-rooms-it-says",
  "title": "A channel that streams in one room only is handed the stream there and the answer whole in the other",
  "rules": [
    "§6.1",
    "§12.2 step 13s"
  ],
  "notes": "The framework asks the channel, per room, whether it takes a streamed response there (supports_streaming_delivery_for): a WebSocket channel can hold streaming clients for one room and none for another, and only the room delivered counts.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true,
        "streams_in": [
          "room-1"
        ]
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "deltas": [
                "The ",
                "answer."
              ]
            },
            {
              "deltas": [
                "The ",
                "answer."
              ]
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Question?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "web",
        "sender_id": "bob",
        "content": {
          "type": "text",
          "body": "Question?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "streamed": {
      "room-1": {
        "ws": [
          {
            "text": "The "
          },
          {
            "text": "answer."
          },
          {
            "row": {
              "id": "room-1#1",
              "content": {
                "body": "The answer."
              }
            }
          }
        ]
      },
      "room-2": {
        "ws": []
      }
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "index": 0
          }
        ]
      },
      "room-2": {
        "ws": [
          {
            "index": 0
          },
          {
            "id": "room-2#1",
            "content": {
              "body": "The answer."
            }
          }
        ]
      }
    }
  }
}
