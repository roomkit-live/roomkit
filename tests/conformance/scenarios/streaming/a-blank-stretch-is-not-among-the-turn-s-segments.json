{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-blank-stretch-is-not-among-the-turn-s-segments",
  "title": "A blank text before a call is not among the segments ON_AI_RESPONSE reports: they say what the room saw, the last the answer",
  "rules": [
    "§6.4",
    "§12.2 step 13s"
  ],
  "notes": "Python: models/tool_call.py response_transcript; tests/test_ai_response_transcript.py::test_the_transcript_drops_what_says_nothing.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "deltas": [
                "\n\n"
              ],
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reported",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "reported": [
        {
          "trigger": "on_ai_response",
          "room_id": "room-1",
          "response": {
            "response_content": "Done.",
            "segments": [
              "Done."
            ]
          }
        }
      ]
    }
  }
}
