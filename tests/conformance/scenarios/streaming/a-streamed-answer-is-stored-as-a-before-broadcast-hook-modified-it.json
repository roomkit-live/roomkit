{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/a-streamed-answer-is-stored-as-a-before-broadcast-hook-modified-it",
  "title": "A streamed answer's row passes BEFORE_BROADCAST: it is stored and delivered as the hook modified it, while a streaming target read its text raw before the hook",
  "rules": [
    "§12.2 step 13s",
    "§10.1 step 9",
    "§9.4"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms1",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws1",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "ai1",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "deltas": [
                "Hi [PERSON_1], ",
                "welcome"
              ]
            }
          ]
        }
      },
      {
        "id": "ai2",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "deltas": [
                "Hi [PERSON_1], ",
                "welcome"
              ]
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms1"
          },
          {
            "channel_id": "ai1",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "sms1"
          },
          {
            "channel_id": "ws1"
          },
          {
            "channel_id": "ai2",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "deanon",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "Hi [PERSON_1], welcome"
            },
            "result": {
              "action": "modify",
              "event": {
                "content": {
                  "type": "text",
                  "body": "Hi Alice, welcome"
                }
              }
            },
            "repeat": true
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms1",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "go"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "sms1",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "go"
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "go"
          }
        },
        {
          "source": {
            "channel_id": "ai1"
          },
          "status": "delivered",
          "content": {
            "type": "text",
            "body": "Hi Alice, welcome"
          }
        }
      ],
      "room-2": [
        {
          "content": {
            "body": "go"
          }
        },
        {
          "source": {
            "channel_id": "ai2"
          },
          "status": "delivered",
          "content": {
            "type": "text",
            "body": "Hi Alice, welcome"
          }
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "sms1": [
          {
            "id": "room-1#1",
            "content": {
              "body": "Hi Alice, welcome"
            }
          }
        ]
      },
      "room-2": {
        "sms1": [
          {
            "id": "room-2#1",
            "content": {
              "body": "Hi Alice, welcome"
            }
          }
        ],
        "ws1": [
          {
            "index": 0
          }
        ]
      }
    },
    "streamed": {
      "room-2": {
        "ws1": [
          {
            "text": "Hi [PERSON_1], "
          },
          {
            "text": "welcome"
          },
          {
            "row": {
              "id": "room-2#1",
              "content": {
                "body": "Hi Alice, welcome"
              }
            }
          }
        ]
      }
    }
  },
  "notes": "Python: tests/test_streaming_before_broadcast.py::test_streamed_segment_applies_before_broadcast_modification (room-1, no streaming target) and test_streaming_transport_persists_modified_but_streams_raw (room-2). The live deltas precede the row's hooks by construction: a host that must not show raw text withholds the stream."
}
