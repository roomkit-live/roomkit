{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/each-round-s-reasoning-ends-with-its-own-block",
  "title": "Each round's reasoning opens a window of its own, closed by a call or the text, THINKING_END carrying that block alone; the turn's record reads every round's",
  "rules": [
    "§6.7"
  ],
  "notes": "Python: channels/_ai_stream_round.py _add_thinking, _end_thinking; channels/_ai_streaming.py _close_thinking_window; channels/_ai_events.py _publish_thinking_event; turns/_wiring.py build_thinking_hook; tests/test_ai_streaming_thinking.py test_each_thinking_end_carries_only_its_own_block_across_a_tool_call, test_the_tool_loop_end_of_round_close_also_scopes_its_block.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "thinking_coalesce_ms": 60000,
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "thinking": [
                "First."
              ],
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "thinking": [
                "Second."
              ],
              "text": "Done."
            }
          ]
        },
        "publish_thinking_text": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reasons",
        "trigger": "on_ai_thinking",
        "execution": "async"
      },
      {
        "name": "answers",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "thinking_events": {
      "room-1": [
        {
          "type": "thinking_start",
          "thinking": "",
          "thinking_length": 0,
          "round": 0,
          "channel_id": "agent"
        },
        {
          "type": "thinking_delta",
          "thinking": "First.",
          "thinking_length": 6,
          "round": 0,
          "channel_id": "agent"
        },
        {
          "type": "thinking_end",
          "thinking": "First.",
          "thinking_length": 6,
          "round": 0,
          "channel_id": "agent"
        },
        {
          "type": "thinking_start",
          "thinking": "",
          "thinking_length": 0,
          "round": 1,
          "channel_id": "agent"
        },
        {
          "type": "thinking_delta",
          "thinking": "Second.",
          "thinking_length": 7,
          "round": 1,
          "channel_id": "agent"
        },
        {
          "type": "thinking_end",
          "thinking": "Second.",
          "thinking_length": 7,
          "round": 1,
          "channel_id": "agent"
        }
      ]
    },
    "hooks": {
      "reasons": [
        {
          "thinking": {
            "round_index": 0
          }
        },
        {
          "thinking": {
            "round_index": 1
          }
        }
      ],
      "answers": [
        {
          "response": {
            "thinking": "First.\n\nSecond."
          }
        }
      ]
    }
  }
}
