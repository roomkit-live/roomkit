{
  "$schema": "../../scenario.schema.json",
  "id": "reasoning/a-named-thinking-field-carries-a-round-s-reasoning",
  "title": "A provider told which field a server reads carries a round's reasoning there, nothing for a round that did not reason, and a later turn none",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: providers/openai/config.py OpenAIConfig.thinking_field, providers/openai/ai.py _dialect; tests/test_providers/test_chat_request.py. Z.ai's documentation asks for reasoning_content back with the tool results; strict servers (Mistral, Cerebras, Groq, SambaNova) answer 400 on a field they do not know, so only a named field sends it. Measured on Terminal-Bench 2.1, GLM-5.3-Flash, 40 tasks (2026-11-09): rounds 1614 without, 846 with; rounds that reason 15 % without, 60 % with.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "get_weather",
            "description": "The weather.",
            "returns": "sunny"
          }
        ],
        "model": {
          "chat_dialect": "openai_thinking_field",
          "rounds": [
            {
              "stream": [
                {
                  "thinking": "WHY."
                },
                {
                  "text": "Let me look."
                },
                {
                  "call": {
                    "id": "c1",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "stream": [
                {
                  "call": {
                    "id": "c2",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "thinking": [
                "DONE."
              ],
              "text": "Sunny."
            },
            {
              "text": "You are welcome."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "thanks"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "go"
            },
            {
              "role": "assistant",
              "content": "Let me look.",
              "reasoning_content": "WHY.",
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": null,
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            }
          ]
        },
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "go"
            },
            {
              "role": "assistant",
              "content": "Let me look.",
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": null,
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": "Sunny.",
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
