{
  "$schema": "../../scenario.schema.json",
  "id": "reasoning/a-named-thinking-field-carries-a-round-s-reasoning",
  "title": "A provider told which field a server reads carries a round's reasoning there, nothing for a round that did not reason, and a later turn none",
  "rules": [
    "§6.4"
  ],
  "requirements": [
    "RK-6.4-077",
    "RK-6.4-079",
    "RK-6.4-080",
    "RK-6.4-086"
  ],
  "notes": "A dialect that names the field its server reads a model's earlier reasoning in (ChatDialect thinking_field, as a provider's configuration names it, RK-6.4-080) carries there the reasoning of a round or an answer that reasoned, and nothing on one that did not (RK-6.4-079), in that field only (RK-6.4-077); a later turn reads none (RK-6.4-086). A server that does not know the field may refuse the request, so only a named field sends it. Python: providers/ai/chat_request.py chat_messages.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "get_weather",
            "description": "The weather.",
            "returns": "sunny"
          }
        ],
        "model": {
          "chat_dialect": {
            "thinking_field": "reasoning_content"
          },
          "rounds": [
            {
              "stream": [
                {
                  "thinking": "WHY."
                },
                {
                  "text": "Let me look."
                },
                {
                  "call": {
                    "id": "c1",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "stream": [
                {
                  "call": {
                    "id": "c2",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "thinking": [
                "DONE."
              ],
              "text": "Sunny."
            },
            {
              "text": "You are welcome."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "thanks"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "go"
            },
            {
              "role": "assistant",
              "content": "Let me look.",
              "reasoning_content": "WHY.",
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": null,
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            }
          ]
        },
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "go"
            },
            {
              "role": "assistant",
              "content": "Let me look.",
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": null,
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": "Sunny.",
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              }
            },
            {
              "role": "user",
              "content": "thanks"
            }
          ]
        }
      ]
    }
  }
}
