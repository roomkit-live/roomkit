{
  "$schema": "../../scenario.schema.json",
  "id": "reasoning/a-required-reasoning-field-carries-a-placeholder-where-empty-reads-as-missing",
  "title": "A dialect that requires its reasoning field and reads an empty one as missing carries a round's reasoning in it, a single space for a round with none, a later turn's rounds included",
  "rules": [
    "§6.4"
  ],
  "requirements": [
    "RK-6.4-077",
    "RK-6.4-078"
  ],
  "notes": "The dialect of a server that requires the reasoning field on every round that called tools and reads an empty field as missing (RK-6.4-078): round_thinking_placeholder fills the field of a round that did not reason, and a later turn's rounds hold no reasoning (§6.4). The reasoning goes in that field only (RK-6.4-077). A later turn replays the round's text and its calls in one message, as the turn sent them, without the round's reasoning (RMK-1370).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "get_weather",
            "description": "The weather.",
            "returns": "sunny"
          }
        ],
        "model": {
          "chat_dialect": {
            "thinking_field": "reasoning_content",
            "round_thinking_required": true,
            "round_thinking_placeholder": " "
          },
          "rounds": [
            {
              "stream": [
                {
                  "thinking": "WHY."
                },
                {
                  "text": "Let me look."
                },
                {
                  "call": {
                    "id": "c1",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "stream": [
                {
                  "call": {
                    "id": "c2",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "thinking": [
                "DONE."
              ],
              "text": "Sunny."
            },
            {
              "text": "You are welcome."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "thanks"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "go"
            },
            {
              "role": "assistant",
              "content": "Let me look.",
              "reasoning_content": "WHY.",
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": null,
              "reasoning_content": " ",
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            }
          ]
        },
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "go"
            },
            {
              "role": "assistant",
              "content": "Let me look.",
              "reasoning_content": " ",
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": null,
              "reasoning_content": " ",
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": "Sunny.",
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              }
            },
            {
              "role": "user",
              "content": "thanks"
            }
          ]
        }
      ]
    }
  }
}
