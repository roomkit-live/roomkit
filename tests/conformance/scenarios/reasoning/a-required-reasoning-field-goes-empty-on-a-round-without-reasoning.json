{
  "$schema": "../../scenario.schema.json",
  "id": "reasoning/a-required-reasoning-field-goes-empty-on-a-round-without-reasoning",
  "title": "A dialect that requires its reasoning field carries a round's reasoning in it, empty for a round that did not reason, and nothing of it in the text",
  "rules": [
    "§6.4"
  ],
  "requirements": [
    "RK-6.4-077",
    "RK-6.4-078"
  ],
  "notes": "The dialect of a server that refuses a round of the turn in progress that called tools without its reasoning field (RK-6.4-078): round_thinking_required puts the field on every round that called tools, empty for one that did not reason, and the reasoning goes in that field only (RK-6.4-077). Python: providers/ai/chat_request.py chat_messages.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "get_weather",
            "description": "The weather.",
            "returns": "sunny"
          }
        ],
        "model": {
          "chat_dialect": {
            "thinking_field": "reasoning_content",
            "round_thinking_required": true
          },
          "rounds": [
            {
              "stream": [
                {
                  "thinking": "WHY."
                },
                {
                  "text": "Let me look."
                },
                {
                  "call": {
                    "id": "c1",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "stream": [
                {
                  "call": {
                    "id": "c2",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "text": "Sunny."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "go"
            },
            {
              "role": "assistant",
              "content": "Let me look.",
              "reasoning_content": "WHY.",
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": null,
              "reasoning_content": "",
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            }
          ]
        }
      ]
    }
  }
}
