{
  "$schema": "../../scenario.schema.json",
  "id": "reasoning/a-response-read-whole-keeps-its-signature-and-its-call-s-metadata",
  "title": "A provider that reports one block hands its reasoning with its signature, and a call's metadata goes back with the call",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: thinking_parts_of, providers/ai/round_parts.py call_part; tests/test_providers/test_stream_adapter.py test_a_wrapped_response_keeps_its_thinking_signature_and_call_metadata.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "get_weather",
            "description": "The weather.",
            "returns": "sunny"
          },
          {
            "name": "get_time",
            "description": "The time.",
            "returns": "noon"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "Looking.",
              "calls": [
                {
                  "id": "c1",
                  "name": "get_weather",
                  "metadata": {
                    "thought_signature": "TS"
                  }
                }
              ],
              "whole_response": {
                "thinking": "I should look it up.",
                "thinking_signature": "SIG-123"
              }
            },
            {
              "text": "Done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "go"
            },
            {
              "role": "assistant",
              "round": [
                {
                  "thinking": "I should look it up.",
                  "signature": "SIG-123"
                },
                {
                  "text": "Looking."
                },
                {
                  "call": "c1",
                  "metadata": {
                    "thought_signature": "TS"
                  }
                }
              ]
            },
            {
              "role": "tool"
            }
          ]
        }
      ]
    }
  }
}
