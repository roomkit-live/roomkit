{
  "$schema": "../../scenario.schema.json",
  "id": "reasoning/minimax-s-dialect-sends-a-round-s-reasoning-in-its-field",
  "title": "MiniMax's dialect carries a round's reasoning in reasoning_content, nothing for a round that did not reason, and a later turn none",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: providers/minimax/ai.py MINIMAX_CHAT; tests/test_providers/test_minimax_kimi.py. MiniMax's API documentation asks for the reasoning_content of each message back in a tool loop, and says a round that did not think has none (https://platform.minimax.io/docs/guides/text-m2-function-call). Its chat templates, M2's and M3's, read that field; llama.cpp hands it to them (run on b11960), and vLLM too (read in its source). A later turn replays the round's text and its calls in one message, as the turn sent them, without the round's reasoning (RMK-1370).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "get_weather",
            "description": "The weather.",
            "returns": "sunny"
          }
        ],
        "model": {
          "chat_dialect": "minimax",
          "rounds": [
            {
              "stream": [
                {
                  "thinking": "WHY."
                },
                {
                  "text": "Let me look."
                },
                {
                  "call": {
                    "id": "c1",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "stream": [
                {
                  "call": {
                    "id": "c2",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "thinking": [
                "DONE."
              ],
              "text": "Sunny."
            },
            {
              "text": "You are welcome."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "thanks"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "go"
            },
            {
              "role": "assistant",
              "content": "Let me look.",
              "reasoning_content": "WHY.",
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": null,
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            }
          ]
        },
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "go"
            },
            {
              "role": "assistant",
              "content": "Let me look.",
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": null,
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              },
              "tool_calls": [
                {
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "arguments": "{}"
                  }
                }
              ]
            },
            {
              "role": "tool",
              "content": "sunny"
            },
            {
              "role": "assistant",
              "content": "Sunny.",
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              }
            },
            {
              "role": "user",
              "content": "thanks"
            }
          ]
        }
      ]
    }
  }
}
