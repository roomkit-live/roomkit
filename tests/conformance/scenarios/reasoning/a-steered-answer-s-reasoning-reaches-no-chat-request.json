{
  "$schema": "../../scenario.schema.json",
  "id": "reasoning/a-steered-answer-s-reasoning-reaches-no-chat-request",
  "title": "An answer a steered message asks the model after goes back on Chat Completions without its reasoning",
  "rules": [
    "§6.4",
    "§21.3"
  ],
  "notes": "Python: chat_request._plain over OPENAI_CHAT, reached by channels/_ai_streaming.py _steered_after_answer.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "steer_room_turns": true,
        "model": {
          "chat_dialect": "openai",
          "rounds": [
            {
              "gate": "answer",
              "thinking": [
                "Weighing."
              ],
              "text": "a.py, b.txt"
            },
            {
              "text": "a.py"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "List the files."
        }
      },
      "background": true,
      "as": "first"
    },
    {
      "wait_for": "answer"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "Only the .py files."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "open": "answer"
    },
    {
      "await": "first",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "List the files."
            },
            {
              "role": "assistant",
              "content": [
                {
                  "type": "text",
                  "text": "a.py, b.txt"
                }
              ],
              "reasoning_content": {
                "$absent": true
              },
              "reasoning": {
                "$absent": true
              },
              "reasoning_details": {
                "$absent": true
              }
            },
            {
              "role": "user",
              "content": "Only the .py files."
            }
          ]
        }
      ]
    }
  }
}
