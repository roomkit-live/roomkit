{
  "$schema": "../../scenario.schema.json",
  "id": "reasoning/a-round-s-reasoning-reaches-no-chat-request",
  "title": "A round's reasoning reaches no Chat Completions request, in no form, and still reaches the room's reader and the request's parts",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: providers/ai/chat_request.py chat_messages over OPENAI_CHAT; tests/test_providers/test_chat_request.py. Measured on a real Qwen (RMK-1369): a <think> sent back empties the server's cache at every step of a turn.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "get_weather",
            "description": "The weather.",
            "returns": "sunny"
          }
        ],
        "model": {
          "chat_dialect": "openai",
          "rounds": [
            {
              "stream": [
                {
                  "thinking": "FIRST."
                },
                {
                  "text": "Let me look."
                },
                {
                  "thinking": "SECOND."
                },
                {
                  "call": {
                    "id": "c1",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "stream": [
                {
                  "thinking": "THIRD."
                },
                {
                  "call": {
                    "id": "c2",
                    "name": "get_weather"
                  }
                }
              ]
            },
            {
              "thinking": [
                "FOURTH."
              ],
              "text": "Sunny."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "go"
            }
          ]
        },
        {
          "chat_messages": [
            {
              "role": "user",
              "content": "go"
            },
            {
              "role": "assistant",
              "content": "Let me look.",
              "tool_calls": [
                {
                  "type": "function",
