{
  "$schema": "../../scenario.schema.json",
  "id": "reasoning/a-round-replays-its-blocks-where-they-came",
  "title": "A round whose reasoning comes in blocks is replayed block by block where each came among its calls, each with its signature, a redacted one as its data",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: providers/ai/round_parts.py RoundTranscript.parts, providers/ai/thinking_blocks.py; tests/test_providers/test_thinking_blocks.py TestThinkingBlocks::test_each_block_keeps_its_text_and_signature, TestTheLoopReplaysTheRound::test_blocks_go_back_where_they_came.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "get_weather",
            "description": "The weather.",
            "returns": "sunny"
          },
          {
            "name": "get_time",
            "description": "The time.",
            "returns": "noon"
          }
        ],
        "model": {
          "rounds": [
            {
              "stream": [
                {
                  "thinking": "Weather first.",
                  "block": 0
                },
                {
                  "thinking": "",
                  "block": 0,
                  "signature": "S0"
                },
                {
                  "call": {
                    "id": "c1",
                    "name": "get_weather"
                  }
                },
                {
                  "thinking": "",
                  "block": 2,
                  "redacted": "RRR"
                },
                {
                  "thinking": "Now the time.",
                  "block": 3
                },
                {
                  "thinking": "",
                  "block": 3,
                  "signature": "S3"
                },
                {
                  "call": {
                    "id": "c2",
                    "name": "get_time"
                  }
                }
              ],
              "finish_reason": "tool_use"
            },
            {
              "text": "Done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "go"
            },
            {
              "role": "assistant",
              "round": [
                {
                  "thinking": "Weather first.",
                  "signature": "S0",
                  "redacted": {
                    "$absent": true
                  }
                },
                {
                  "call": "c1"
                },
                {
                  "thinking": "",
                  "signature": {
                    "$absent": true
                  },
                  "redacted": "RRR"
                },
                {
                  "thinking": "Now the time.",
                  "signature": "S3",
                  "redacted": {
                    "$absent": true
                  }
                },
                {
                  "call": "c2"
                }
              ]
            },
            {
              "role": "tool"
            }
          ]
        }
      ]
    }
  }
}
