{
  "$schema": "../../scenario.schema.json",
  "id": "channel-release/a-closed-kit-refuses-release-before-checking-registration",
  "title": "A closed kit refuses release before looking up an unknown channel",
  "rules": [
    "§10.6.3"
  ],
  "requirements": [
    "RK-12.10.4-038"
  ],
  "notes": "Python: RoomKit public methods are wrapped by _work_refused_once_closed before ChannelStateMixin.release_channel; the public close error precedes registration and backend control.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "verbs": {
          "keep": {
            "keeps": true
          },
          "read": {
            "reads": true
          },
          "forget": {
            "forgets": true,
            "reads": true
          },
          "answer": {
            "result": {
              "ok": true
            }
          },
          "nothing": {}
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "close"
    },
    {
      "call": "release_channel",
      "channel_id": "nobody",
      "expect": {
        "error": "kit_closed"
      }
    }
  ],
  "expect": {}
}
