{
  "$schema": "../../scenario.schema.json",
  "id": "memory/a-memory-that-does-not-compact-leaves-a-tool-turn-as-it-is",
  "title": "The default memory defines no compaction between two tool rounds: it answers nothing, and each later round of the turn sends the whole history and the rounds before it unchanged",
  "rules": [
    "§20.1",
    "§6.4"
  ],
  "requirements": [
    "RK-20.1-008"
  ],
  "notes": "The agent keeps the implementation's default memory, a sliding window, which does not define compact. After each tool round the AI channel asks the memory to compact (§6.4, \"The history compacted between two rounds\"); the answer is nothing, whatever the round's usage reports, so the next request carries the history before the input as the turn's start read it, and every round since.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Answer 1."
            },
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "one"
                  }
                }
              ],
              "usage": {
                "input_tokens": 900,
                "output_tokens": 10
              }
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "lookup",
                  "arguments": {
                    "q": "two"
                  }
                }
              ],
              "usage": {
                "input_tokens": 950,
                "output_tokens": 12
              }
            },
            {
              "text": "Answer 2."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up",
            "parameters": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              },
              "required": [
                "q"
              ]
            },
            "returns": "found"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Question 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Question 2."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Question 1."
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Question 1."
            },
            {
              "role": "assistant",
              "text": "Answer 1."
            },
            {
              "role": "user",
              "text": "Question 2."
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Question 1."
            },
            {
              "role": "assistant",
              "text": "Answer 1."
            },
            {
              "role": "user",
              "text": "Question 2."
            },
            {
              "role": "assistant",
              "round": [
                {
                  "call": "c1",
                  "arguments": {
                    "q": "one"
                  },
                  "metadata": {}
                }
              ]
            },
            {
              "role": "tool"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Question 1."
            },
            {
              "role": "assistant",
              "text": "Answer 1."
            },
            {
              "role": "user",
              "text": "Question 2."
            },
            {
              "role": "assistant",
              "round": [
                {
                  "call": "c1",
                  "arguments": {
                    "q": "one"
                  },
                  "metadata": {}
                }
              ]
            },
            {
              "role": "tool"
            },
            {
              "role": "assistant",
              "round": [
                {
                  "call": "c2",
                  "arguments": {
                    "q": "two"
                  },
                  "metadata": {}
                }
              ]
            },
            {
              "role": "tool"
            }
          ]
        }
      ]
    }
  }
}
