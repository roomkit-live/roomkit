{
  "$schema": "../../scenario.schema.json",
  "id": "memory/an-author-s-image-counts-in-the-budget-and-a-media-as-its-mention",
  "title": "The images an author sent count in what the turn's memory budget measures, and a media that is no image counts as its mention",
  "rules": [
    "§6.4",
    "§20.3"
  ],
  "requirements": [
    "RK-6.4-326"
  ],
  "notes": "Python's BudgetAwareMemory over a model that sees images. Alice sends an image, then a document, then a question. The question's turn keeps the newest events that fit what the budget leaves: the answer before it fit, and so does the document, which counts as its mention ([Media: invoice.pdf]), a few tokens, not as its 4000-character address; the image counts as an image (a flat thousand tokens in both implementations) and does not fit, so the turn reads it no more. Python: memory/token_estimator.py estimate_event_tokens.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "vision": true,
          "rounds": [
            {
              "text": "Seen 0."
            },
            {
              "text": "Seen 1."
            },
            {
              "text": "Seen 2."
            }
          ]
        },
        "memory": {
          "budget_aware": {
            "max_context_tokens": 1300,
            "min_events": 1
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "media",
          "url": "https://cdn.example.com/chart.png",
          "mime_type": "image/png"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "media",
          "url": "https://cdn.example..pdf",
          "mime_type": "application/pdf",
          "filename": "invoice.pdf"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Which one is due?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "messages": [
            {
              "role": "assistant",
              "text": "Seen 0."
            },
            {
              "role": "user",
              "text": "[Media: invoice.pdf]"
            },
            {
              "role": "assistant",
              "text": "Seen 1."
            },
            {
              "role": "user",
              "text": "Which one is due?"
            }
          ]
        }
      ]
    }
  }
}
