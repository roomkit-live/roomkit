{
  "$schema": "../../scenario.schema.json",
  "id": "memory/a-summarizing-memory-applies-no-first-threshold-between-two-tool-rounds",
  "title": "Between two tool rounds a summarizing memory compacts only past its second threshold: a round whose usage passes the first alone shortens no older long text, and the summarizer is not asked",
  "rules": [
    "§20.3",
    "§6.4"
  ],
  "requirements": [
    "RK-20.3-030"
  ],
  "notes": "Its window of 1000 tokens puts the first threshold at 500 and the second at 850 between rounds. The turn's start reads a short history, under the read's first threshold. The tool round's usage (600 and 10) passes the first alone: the next request sends the first question as it was, though it is longer than truncate_chars, which shortens long older texts past the first threshold at a read.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Answer 1."
            },
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "one"
                  }
                }
              ],
              "usage": {
                "input_tokens": 600,
                "output_tokens": 10
              }
            },
            {
              "text": "Answer 2."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up",
            "parameters": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              },
              "required": [
                "q"
              ]
            },
            "returns": "found"
          }
        ],
        "memory": {
          "summarizing": {
            "max_context_tokens": 1000,
            "truncate_chars": 20,
            "min_events": 1
          },
          "summarizer": {
            "rounds": [
              {
                "text": "never"
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Question 1: word word word word word word word word word word"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Question 2."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent/summarizer": [],
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Question 1: word word word word word word word word word word"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Question 1: word word word word word word word word word word"
            },
            {
              "role": "assistant",
              "text": "Answer 1."
            },
            {
              "role": "user",
              "text": "Question 2."
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Question 1: word word word word word word word word word word"
            },
            {
              "role": "assistant",
              "text": "Answer 1."
            },
            {
              "role": "user",
              "text": "Question 2."
            },
            {
              "role": "assistant",
              "round": [
                {
                  "call": "c1",
                  "arguments": {
                    "q": "one"
                  },
                  "metadata": {}
                }
              ]
            },
            {
              "role": "tool"
            }
          ]
        }
      ]
    }
  }
}
