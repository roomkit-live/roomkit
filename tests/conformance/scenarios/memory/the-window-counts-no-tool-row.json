{
  "$schema": "../../scenario.schema.json",
  "id": "memory/the-window-counts-no-tool-row",
  "title": "The memory's window counts the room's messages, never the agent's tool rows: an earlier turn's round of calls is replayed at its place and leaves the window's messages whole",
  "rules": [
    "§20.3",
    "§6.4"
  ],
  "notes": "Python's turn context holds the room's messages (get_conversation) and the turn's event; the agent's earlier rounds are read from its tool rows apart and placed after the message they followed (RFC §6.4, The tools of earlier turns).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "call-1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "42"
                  }
                }
              ]
            },
            {
              "text": "Order 42 shipped."
            },
            {
              "text": "You are welcome."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup_order",
            "description": "Find an order by its number",
            "parameters": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "string"
                }
              },
              "required": [
                "order"
              ]
            },
            "returns": "{\"order\": \"42\", \"status\": \"shipped\"}"
          }
        ],
        "max_context_events": 3
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Where is order 42?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Thanks."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Where is order 42?"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Where is order 42?"
            },
            {
              "role": "assistant",
              "text": ""
            },
            {
              "role": "tool",
              "text": ""
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Where is order 42?"
            },
            {
              "role": "assistant",
              "text": ""
            },
            {
              "role": "tool",
              "text": ""
            },
            {
              "role": "assistant",
              "text": "Order 42 shipped."
            },
            {
              "role": "user",
              "text": "Thanks."
            }
          ],
          "tool_results": [
            {
              "tool_call_id": "call-1",
              "content": "{\"order\": \"42\", \"status\": \"shipped\"}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
