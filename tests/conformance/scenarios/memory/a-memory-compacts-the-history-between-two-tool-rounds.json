              "role": "tool"
            },
            {
              "role": "assistant",
              "round": [
                {
                  "call": "c2",
                  "arguments": {
                    "q": "two"
                  },
                  "metadata": {}
                }
              ]
            },
            {
              "role": "tool"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Summary 2.\n\nQuestion 2."
            },
            {
              "role": "assistant"
            },
            {
              "role": "tool"
            },
            {
              "role": "assistant"
            },
            {
              "role": "tool"
            },
            {
              "role": "assistant",
              "round": [
                {
                  "call": "c3",
                  "arguments": {
                    "q": "three"
                  },
