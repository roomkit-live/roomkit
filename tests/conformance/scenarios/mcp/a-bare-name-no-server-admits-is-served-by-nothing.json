{
  "$schema": "../../scenario.schema.json",
  "id": "mcp/a-bare-name-no-server-admits-is-served-by-nothing",
  "title": "A bare MCP tool name runs on no server when the policy keeps every server that serves it out",
  "rules": [
    "§21.1",
    "§21.2",
    "§21.4"
  ],
  "requirements": [
    "RK-21.1-026",
    "RK-21.2-015",
    "RK-21.2-016",
    "RK-21.2-018",
    "RK-21.2-032",
    "RK-21.4-008",
    "RK-21.4-009",
    "RK-9.3-089"
  ],
  "notes": "Both labelled servers serve delete_records, the CRM's tools declared bare; the policy keeps both servers out by their aliases and leaves the bare name: each handler declines, and the call is served by nothing.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "call-1",
                  "name": "delete_records",
                  "arguments": {
                    "query": "2019"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "mcp_servers": [
          {
            "label": "archive",
            "declare": "none",
            "tools": [
              {
                "name": "delete_records",
                "description": "Delete the records matching a query.",
                "input_schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "query"
                  ]
                },
                "returns": "archive: deleted the records matching 2019"
              }
            ]
          },
          {
            "label": "crm",
            "declare": "bare",
            "tools": [
              {
                "name": "delete_records",
                "description": "Delete the records matching a query.",
                "input_schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "query"
                  ]
                },
                "returns": "crm: deleted the records matching 2019"
              }
            ]
          }
        ],
        "tool_policy": {
          "deny": [
            "mcp__archive__*",
            "mcp__crm__*"
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Delete the 2019 records."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tool_results": "$any"
        },
        {
          "tool_results": [
            {
              "tool_call_id": "call-1",
              "name": "delete_records",
              "content": "{\"error\": \"No handler for tool delete_records\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
