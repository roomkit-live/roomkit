{
  "$schema": "../../scenario.schema.json",
  "id": "mcp/an-is-error-result-is-a-failure-never-a-refusal-non-streaming",
  "title": "An MCP tool whose result says isError ran and failed: the call reads failed, never refused (non-streaming)",
  "rules": [
    "§9.3",
    "§21.2"
  ],
  "requirements": [
    "RK-6.4-067",
    "RK-9.3-085"
  ],
  "notes": "Python: tests/test_mcp_tool_provider.py::test_tool_handler_raises_on_a_failed_call and ::test_as_tool_handler_ungated_still_raises_on_a_failed_call, the MCP provider's handler raising ToolFailedError on isError. The model reads the server's text beside the failure marker (§9.3, the body travels verbatim); the observers read it failed, not refused, not cancelled; the stored end row's outcome is failed. Only the AI channel is observed: a realtime voice channel serving an MCP tool needs a session step neither runner has.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "call-1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "42"
                  }
                }
              ]
            },
            {
              "text": "Order 42 cannot be found."
            }
          ]
        },
        "mcp_servers": [
          {
            "label": "crm",
            "tools": [
              {
                "name": "lookup_order",
                "description": "Find an order.",
                "input_schema": {
                  "type": "object",
                  "properties": {
                    "order": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "order"
                  ]
                },
                "returns": "Order 42 not found",
                "is_error": true
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Where is order 42?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "call-1",
              "name": "lookup_order",
              "content": "Order 42 not found",
              "is_error": true
            }
          ]
        }
      ]
    },
    "hooks": {
      "audit": [
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "name": "lookup_order",
            "tool_call_id": "call-1",
            "arguments": {
              "order": "42"
            },
            "result": "Order 42 not found",
            "is_error": true,
            "refused": false,
            "cancelled": false
          }
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "content": {
            "type": "text",
            "body": "Where is order 42?"
          }
        },
        {
          "index": 1,
          "type": "tool_call_start",
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "type": "tool_call",
            "tool_name": "lookup_order",
            "tool_id": "call-1",
            "arguments": {
              "order": "42"
            },
            "status": "pending"
          }
        },
        {
          "index": 2,
          "type": "tool_call_end",
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "type": "tool_call",
            "tool_name": "lookup_order",
            "tool_id": "call-1",
            "arguments": {
              "order": "42"
            },
            "status": "failed",
            "outcome": "failed",
            "result": "Order 42 not found"
          }
        },
        {
          "index": 3,
          "type": "message",
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "type": "text",
            "body": "Order 42 cannot be found."
          }
        }
      ]
    }
  }
}
