{
  "$schema": "../../scenario.schema.json",
  "id": "turn-record/a-generation-back-on-its-provider-names-it-on-the-record",
  "title": "A generation handed back to the channel's provider after its fallback served one names that provider and its model on the turn's record: the record names the last generation's",
  "rules": [
    "§6.4 The turn's record"
  ],
  "notes": "Python: channels/_ai_streaming.py _StreamTurnState.count_generation (RMK-1056), channels/_ai_resilience.py _rerouted (RMK-1638). roomkit-rs: tool_loop/mod.rs end_of (RMK-1029). The fallback serves the first round and keeps the turn; its second round is refused, and the fallback router hands it back to the primary.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "returns": "found"
          }
        ],
        "retry_policy": {
          "max_retries": 0,
          "base_delay_ms": 1
        },
        "model": {
          "name": "opus",
          "provider": "anthropic",
          "rounds": [
            {
              "refuses": {
                "status": 503,
                "message": "overloaded",
                "retryable": true
              }
            },
            {
              "text": "Done.",
              "usage": {
                "input_tokens": 40,
                "output_tokens": 7
              }
            }
          ]
        },
        "fallback_model": {
          "name": "gpt",
          "provider": "openai",
          "rounds": [
            {
              "text": "Checking.",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ],
              "usage": {
                "input_tokens": 5,
                "output_tokens": 2
              }
            },
            {
              "refuses": {
                "status": 503,
                "message": "overloaded",
                "retryable": true
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1
        },
        {
          "index": 2
        },
        {
          "index": 3
        },
        {
          "index": 4,
          "content": {
            "body": "Done."
          },
          "metadata": {
            "ai_model": "opus",
            "ai_provider": "anthropic"
          }
        }
      ]
    }
  }
}
