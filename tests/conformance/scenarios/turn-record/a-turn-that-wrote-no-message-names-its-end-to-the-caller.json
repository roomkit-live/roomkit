                "output_tokens": 2
              }
            },
            {
              "calls": [
                {
                  "id": "c5",
                  "name": "lookup"
                }
              ],
              "usage": {
                "input_tokens": 10,
                "output_tokens": 2
              }
            }
          ]
        }
      },
      {
        "id": "done",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "look up",
            "parameters": {
