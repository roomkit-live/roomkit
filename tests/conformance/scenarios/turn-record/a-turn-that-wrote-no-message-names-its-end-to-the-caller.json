              }
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "lookup"
                }
              ],
              "usage": {
                "input_tokens": 10,
                "output_tokens": 2
              }
            },
            {
              "calls": [
                {
                  "id": "c3",
                  "name": "lookup"
                }
              ],
              "usage": {
                "input_tokens": 10,
                "output_tokens": 2
              }
            },
            {
              "calls": [
                {
                  "id": "c4",
                  "name": "lookup"
                }
              ],
              "usage": {
