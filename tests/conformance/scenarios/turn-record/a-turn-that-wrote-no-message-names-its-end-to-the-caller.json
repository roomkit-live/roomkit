{
  "$schema": "../../scenario.schema.json",
  "id": "turn-record/a-turn-that-wrote-no-message-names-its-end-to-the-caller",
  "title": "An agent whose turn its round cap cut before it wrote any message names its end and its usage to the caller, beside another agent's own end",
  "rules": [
