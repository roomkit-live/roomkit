{
  "$schema": "../../scenario.schema.json",
  "id": "turn-record/a-turn-s-record-keeps-its-last-generation-its-model-and-its-provider",
  "title": "A turn's record keeps beside its totals what its last generation used, that every generation reported its counters, and the model and provider it ran on",
  "rules": [
    "§6.4 The turn's record"
  ],
  "notes": "Python: channels/_ai_streaming.py _StreamTurnState.end, core/mixins/_streaming_segments.py end_turn (RMK-1056). roomkit-rs: tests/turn/main.rs last_generation_usage_is_distinct_from_turn_totals (RMK-1029).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "returns": "found"
          }
        ],
        "model": {
          "name": "opus",
          "provider": "anthropic",
          "rounds": [
            {
              "text": "Checking.",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ],
              "usage": {
                "input_tokens": 100,
                "output_tokens": 10
              }
            },
            {
              "text": "Done.",
              "usage": {
                "input_tokens": 40,
                "cache_read_input_tokens": 80,
                "output_tokens": 7
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1,
          "content": {
            "body": "Checking."
          }
        },
        {
          "index": 2,
          "type": "tool_call_start"
        },
        {
          "index": 3,
          "type": "tool_call_end"
        },
        {
          "index": 4,
          "content": {
            "body": "Done."
          },
          "metadata": {
            "loop_end_reason": "completed",
            "ai_usage": {
              "input_tokens": 140,
              "output_tokens": 17,
              "cache_read_input_tokens": 80
            },
            "ai_last_usage": {
              "input_tokens": 40,
              "cache_read_input_tokens": 80,
              "output_tokens": 7
            },
            "ai_usage_complete": true,
            "ai_model": "opus",
            "ai_provider": "anthropic"
          }
        }
      ]
    }
  }
}
