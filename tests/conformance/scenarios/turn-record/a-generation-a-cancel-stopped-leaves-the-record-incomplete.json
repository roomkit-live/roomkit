{
  "$schema": "../../scenario.schema.json",
  "id": "turn-record/a-generation-a-cancel-stopped-leaves-the-record-incomplete",
  "title": "A generation a steering Cancel stopped reported nothing: the turn's record reads no usage of it and incomplete, not the generation before it",
  "rules": [
    "§6.4 The turn's record",
    "§21.3"
  ],
  "notes": "Python: channels/_ai_streaming.py _StreamTurnState.count_generation (RMK-1056). roomkit-rs: tool_loop/generation.rs Generation::cut (RMK-1029).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "Checking.",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ],
              "usage": {
                "input_tokens": 100,
                "output_tokens": 10
              }
            },
            {
              "gate": "second",
              "text": "Never.",
              "usage": {
                "input_tokens": 40,
                "output_tokens": 7
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "background": true,
      "as": "a"
    },
    {
      "wait_for": "second"
    },
    {
      "call": "steer",
      "channel_id": "agent",
      "room_id": "room-1",
      "directive": {
        "type": "cancel"
      }
    },
    {
      "open": "second"
    },
    {
      "await": "a"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1,
          "content": {
            "body": "Checking."
          },
          "metadata": {
            "loop_end_reason": "cancelled",
            "ai_usage": {
              "input_tokens": 100,
              "output_tokens": 10
            },
            "ai_last_usage": {
              "input_tokens": {
                "$absent": true
              },
              "output_tokens": {
                "$absent": true
              }
            },
            "ai_usage_complete": false,
            "ai_model": "scripted",
            "ai_provider": "scripted"
          }
        },
        {
          "index": 2
        },
        {
          "index": 3
        }
      ]
    }
  }
}
