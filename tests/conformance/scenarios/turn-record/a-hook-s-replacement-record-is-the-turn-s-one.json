{
  "$schema": "../../scenario.schema.json",
  "id": "turn-record/a-hook-s-replacement-record-is-the-turn-s-one",
  "title": "A BEFORE_AI_GENERATION hook that replaces its context's record makes it the turn's one record: what a tool writes then lands on it, and the reply reads it",
  "rules": [
    "§6.7"
  ],
  "notes": "Python: channels/_ai_generation.py loop_ctx.response_metadata = gen_event.ai_context.response_metadata; tests/test_response_metadata.py::TestLiveRecord::test_a_hook_that_replaces_the_context_keeps_one_record.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "read_page",
            "description": "Read a page.",
            "parameters": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer"
                }
              }
            },
            "returns": "page text",
            "writes_record": {
              "cited": [
                {
                  "tool": "read_page",
                  "page": 3
                }
              ]
            }
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "Let me read.",
              "calls": [
                {
                  "id": "c1",
                  "name": "read_page",
                  "arguments": {
                    "page": 3
                  }
                }
              ]
            },
            {
              "text": "Page 3 says so."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "replaces",
        "trigger": "before_ai_generation",
        "priority": 0,
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "response_metadata": {
                  "rag_sources": [
                    "doc-1"
                  ]
                }
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Read page 3"
        }
      },
      "expect": {
        "result": {
          "response_metadata": {
            "rag_sources": [
              "doc-1"
            ],
            "cited": [
              {
                "tool": "read_page",
                "page": 3
              }
            ]
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "Read page 3"
          }
        },
        {
          "index": 1,
          "type": "message",
          "metadata": {
            "rag_sources": [
              "doc-1"
            ],
            "cited": {
              "$absent": true
            }
          }
        },
        {
          "index": 2,
          "type": "tool_call_start"
        },
        {
          "index": 3,
          "type": "tool_call_end"
        },
        {
          "index": 4,
          "type": "message",
          "metadata": {
            "rag_sources": [
              "doc-1"
            ],
            "cited": [
              {
                "tool": "read_page",
                "page": 3
              }
            ]
          }
        }
      ]
    }
  }
}
