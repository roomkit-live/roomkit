{
  "$schema": "../../scenario.schema.json",
  "id": "turn-record/a-generation-hook-s-write-rides-every-message",
  "title": "What a BEFORE_AI_GENERATION hook writes on its context's record rides every message of the turn and reaches the caller's result",
  "rules": [
    "§6.7"
  ],
  "notes": "Python: channels/_ai_context.py hands the loop context's record to AIContext.response_metadata; tests/test_response_metadata.py::TestResponseMetadataDirect::test_streaming_output_carries_response_metadata, test_streaming_tool_loop_output_carries_response_metadata, test_streaming_stored_event_has_metadata, test_non_streaming_stored_event_has_metadata, TestInboundResultResponseMetadata::test_non_streaming_turn_returns_its_final_record.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "read_page",
            "description": "Read a page.",
            "parameters": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer"
                }
              }
            },
            "returns": "page text"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "Let me read.",
              "calls": [
                {
                  "id": "c1",
                  "name": "read_page",
                  "arguments": {
                    "page": 3
                  }
                }
              ]
            },
            {
              "text": "Page 3 says so."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "cites",
        "trigger": "before_ai_generation",
        "priority": 0,
        "reactions": [
          {
            "writes_record": {
              "rag_sources": [
                "doc-1"
              ]
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Read page 3"
        }
      },
      "expect": {
        "result": {
          "response_metadata": {
            "rag_sources": [
              "doc-1"
            ]
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "Read page 3"
          }
        },
        {
          "index": 1,
          "type": "message",
          "metadata": {
            "rag_sources": [
              "doc-1"
            ]
          }
        },
        {
          "index": 2,
          "type": "tool_call_start",
          "metadata": {
            "rag_sources": {
              "$absent": true
            }
          }
        },
        {
          "index": 3,
          "type": "tool_call_end",
          "metadata": {
            "rag_sources": {
              "$absent": true
            }
          }
        },
        {
          "index": 4,
          "type": "message",
          "metadata": {
            "rag_sources": [
              "doc-1"
            ]
          }
        }
      ]
    }
  }
}
