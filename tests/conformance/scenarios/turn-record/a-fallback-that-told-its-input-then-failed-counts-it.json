{
  "$schema": "../../scenario.schema.json",
  "id": "turn-record/a-fallback-that-told-its-input-then-failed-counts-it",
  "title": "A generation the router handed to a fallback that told its input as its stream started, then refused before handing anything, counts that input on the turn's record, the primary's refusal its error",
  "rules": [
    "§6.4 The turn's record"
  ],
  "notes": "RMK-369 (review of C40-12). The primary refuses the second generation; the fallback tells its input, then fails: the turn ends error after a round. Python: the round's told usage, counted in its finally. roomkit-rs: tool_loop/resilience.rs rerouted keeps the fallback failure's reports.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "Checking.",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ],
              "usage": {
                "input_tokens": 100,
                "output_tokens": 10
              }
            },
            {
              "refuses": {
                "status": 503,
                "message": "overloaded",
                "retryable": true
              }
            }
          ]
        },
        "retry_policy": {
          "max_retries": 0,
          "base_delay_ms": 1
        },
        "fallback_model": {
          "rounds": [
            {
              "usage_at_start": {
                "input_tokens": 40
              },
              "refuses": {
                "status": 500,
                "message": "fallback down"
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": {
            "$contains": "overloaded"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "report": [
        {
          "trigger": "on_ai_response",
          "response": {
            "loop_end_reason": "error",
            "usage": {
              "input_tokens": 140,
              "output_tokens": 10
            },
            "usage_complete": false
          }
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1,
          "content": {
            "body": "Checking."
          },
          "metadata": {
            "loop_end_reason": "error",
            "ai_usage": {
              "input_tokens": 140,
              "output_tokens": 10
            },
            "ai_last_usage": null,
            "ai_usage_complete": false
          }
        },
        {
          "index": 2
        },
        {
          "index": 3
        }
      ]
    }
  }
}
