{
  "$schema": "../../scenario.schema.json",
  "id": "skill-scripts/no-executor-non-streaming",
  "title": "A local skill executor: no executor (non-streaming)",
  "rules": [
    "§24.6",
    "§24.3",
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-6.4-397",
    "RK-6.7-111"
  ],
  "notes": "Python: tests/test_skills_integration.py, tests/test_skill_reference_unknown_skill.py, tests/test_tool_policy_exemptions.py and tests/skills/test_script_executor.py. The fixture records actual host invocations; no process is executed.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "agent",
        "type": "ai",
        "skills": [
          {
            "name": "local",
            "description": "Build locally",
            "instructions": "Local rules.",
            "scripts": {
              "build.sh": "local script"
            }
          }
        ],
        "model": {
          "streaming": false,
          "rounds": [
            {
              "calls": [
                {
                  "id": "s1",
                  "name": "run_skill_script",
                  "arguments": {
                    "skill_name": "local",
                    "script_name": "build.sh",
                    "arguments": {
                      "target": "release"
                    }
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Build"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "script_executors": {
      "agent": {
        "$absent": true
      }
    },
    "models": {
      "agent": [
        {
          "tools": {
            "run_skill_script": {
              "$absent": true
            },
            "activate_skill": 0,
            "read_skill_reference": 1
          },
          "system_prompt": {
            "$contains": "Script execution is not available"
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "s1",
              "name": "run_skill_script",
              "content": {
                "$contains": "Tool 'run_skill_script' is not declared"
              },
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
