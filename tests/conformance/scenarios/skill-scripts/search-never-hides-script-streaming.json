{
  "$schema": "../../scenario.schema.json",
  "id": "skill-scripts/search-never-hides-script-streaming",
  "title": "Local script tools stay declared outside the searchable catalogue (search-never-hides-script, streaming)",
  "rules": [
    "§24.6",
    "§24.3",
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-24.6-011"
  ],
  "notes": "Python: CHANNEL_TOOL_TRAITS[run_skill_script] sets deferrable=False independently of exempt=False. The same host invocation stays visible with forced discovery and at the catalogue threshold.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "agent",
        "type": "ai",
        "skills": [
          {
            "name": "local",
            "description": "Build locally",
            "instructions": "Local rules.",
            "scripts": {
              "build.sh": "local script"
            }
          }
        ],
        "script_executor": {
          "result": {
            "exit_code": 7,
            "stdout": "résultat",
            "stderr": "",
            "success": true,
            "metadata": {
              "attempt": 2
            }
          }
        },
        "model": {
          "streaming": true,
          "rounds": [
            {
              "calls": [
                {
                  "id": "s1",
                  "name": "run_skill_script",
                  "arguments": {
                    "skill_name": "local",
                    "script_name": "build.sh",
                    "arguments": {
                      "target": "release"
                    }
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look up",
            "parameters": {
              "type": "object"
            },
            "returns": "{}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Build"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "script_executors": {
      "agent": {
        "calls": [
          {
            "skill_name": "local",
            "script_name": "build.sh",
            "arguments": {
              "target": "release"
            },
            "contents": "local script"
          }
        ],
        "closes": 1
      }
    },
    "models": {
      "agent": [
        {
          "tools": {
            "run_skill_script": {
              "$present": true
            },
            "lookup": {
              "$absent": true
            },
            "find_tools": {
              "$present": true
            }
          },
          "system_prompt": {
            "$lacks": "Script execution is not available"
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "s1",
              "name": "run_skill_script",
              "content": "{\"exit_code\":7,\"stdout\":\"résultat\",\"stderr\":\"\",\"success\":true,\"metadata\":{\"attempt\":2}}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
