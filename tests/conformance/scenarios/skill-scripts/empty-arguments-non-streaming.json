{
  "$schema": "../../scenario.schema.json",
  "id": "skill-scripts/empty-arguments-non-streaming",
  "title": "A local skill executor: empty arguments (non-streaming)",
  "rules": [
    "§24.6",
    "§24.3",
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-24.6-011",
    "RK-6.4-397",
    "RK-6.7-111"
  ],
  "notes": "Python: tests/test_skills_integration.py, tests/test_skill_reference_unknown_skill.py, tests/test_tool_policy_exemptions.py and tests/skills/test_script_executor.py. The fixture records actual host invocations; no process is executed.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "agent",
        "type": "ai",
        "skills": [
          {
            "name": "local",
            "description": "Build locally",
            "instructions": "Local rules.",
            "scripts": {
              "build.sh": "local script"
            }
          }
        ],
        "script_executor": {
          "result": {
            "exit_code": 7,
            "stdout": "résultat",
            "stderr": "",
            "success": true,
            "metadata": {
              "attempt": 2
            }
          }
        },
        "model": {
          "streaming": false,
          "rounds": [
            {
              "calls": [
                {
                  "id": "s1",
                  "name": "run_skill_script",
                  "arguments": {
                    "skill_name": "local",
                    "script_name": "build.sh",
                    "arguments": {}
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Build"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "script_executors": {
      "agent": {
        "calls": [
          {
            "skill_name": "local",
            "script_name": "build.sh",
            "arguments": {},
            "contents": "local script"
          }
        ],
        "closes": 1
      }
    },
    "models": {
      "agent": [
        {
          "tools": {
            "run_skill_script": {
              "$present": true
            }
          },
          "system_prompt": {
            "$lacks": "Script execution is not available"
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "s1",
              "name": "run_skill_script",
              "content": "{\"exit_code\":7,\"stdout\":\"résultat\",\"stderr\":\"\",\"success\":true,\"metadata\":{\"attempt\":2}}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
