{
  "$schema": "../../scenario.schema.json",
  "id": "input-request/timed-out-whole",
  "title": "A timed-out request is no longer open on its owner (whole)",
  "rules": [
    "§10.6.5",
    "§17.2",
    "§9.3"
  ],
  "requirements": [
    "RK-9.3-112",
    "RK-9.3-114"
  ],
  "notes": "Python: tests/test_turns_inputs.py. input_request reads the owner record while open, preserves request fields, and returns None after settlement. Original creation time is checked with a controlled clock in the native reference; these reads also pin a stable timestamp.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "ask_user",
                  "arguments": {
                    "question": "Color?"
                  }
                }
              ]
            },
            {
              "text": "Thanks."
            }
          ],
          "streaming": false
        },
        "human_input": {
          "tool_names": [
            "ask_user"
          ],
          "timeout_ms": 100,
          "tools": [
            {
              "name": "ask_user",
              "description": "Ask the user.",
              "parameters": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "tool_timeout_ms": 20
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "calls",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "ops",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "answer_input",
      "request_id": "$p1",
      "value": "Red",
      "expect": {
        "result": false
      }
    },
    {
      "call": "reject_input",
      "request_id": "$p1",
      "reason": "late",
      "expect": {
        "result": false
      }
    },
    {
      "call": "input_request",
      "request_id": "$p1",
      "expect": {
        "result": null
      }
    }
  ],
  "expect": {
    "hooks": {
      "calls": [
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "name": "ask_user",
            "tool_call_id": "c1",
            "arguments": {
              "question": "Color?"
            },
            "result": "{\"error\": \"Human input timed out after 0.1s for tool 'ask_user'\"}",
            "is_error": true,
            "refused": false
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"error\": \"Human input timed out after 0.1s for tool 'ask_user'\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
