{
  "$schema": "../../scenario.schema.json",
  "id": "input-request/open-record-whole",
  "title": "The owner reads the full open request and no longer reads it after answering (whole)",
  "rules": [
    "§10.6.5",
    "§17.2",
    "§9.3"
  ],
  "requirements": [
    "RK-10.6.5-058",
    "RK-10.6.5-059",
    "RK-10.6.5-062"
  ],
  "notes": "Python: tests/test_turns_inputs.py. input_request reads the owner record while open, preserves request fields, and returns None after settlement. Original creation time is checked with a controlled clock in the native reference; these reads also pin a stable timestamp.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "ask_user",
                  "arguments": {
                    "question": "Color?"
                  }
                }
              ]
            },
            {
              "text": "Thanks."
            }
          ],
          "streaming": false
        },
        "human_input": {
          "tool_names": [
            "ask_user"
          ],
          "timeout_ms": 5000,
          "tools": [
            {
              "name": "ask_user",
              "description": "Ask the user.",
              "parameters": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "asked",
        "trigger": "on_user_input_required",
        "reactions": [
          {
            "do": [
              {
                "call": "await_input_request",
                "request_id": "$request",
                "expect": {
                  "result": true
                }
              },
              {
                "call": "input_request",
                "request_id": "$request",
                "expect": {
                  "result": {
                    "pending_id": "$p1",
                    "tool_name": "ask_user",
                    "arguments": {
                      "question": "Color?"
                    },
                    "room_id": "room-1",
                    "tool_call_id": "c1",
                    "channel_id": "agent",
                    "channel_type": "ai",
                    "actor_id": "ops",
                    "timestamp": {
                      "$as": "request-created"
                    }
                  }
                }
              },
              {
                "call": "input_request",
                "request_id": "$request",
                "expect": {
                  "result": {
                    "pending_id": "$p1",
                    "tool_name": "ask_user",
                    "arguments": {
                      "question": "Color?"
                    },
                    "room_id": "room-1",
                    "tool_call_id": "c1",
                    "channel_id": "agent",
                    "channel_type": "ai",
                    "actor_id": "ops",
                    "timestamp": {
                      "$as": "request-created"
                    }
                  }
                }
              },
              {
                "call": "answer_input",
                "request_id": "$request",
                "value": "Blue",
                "expect": {
                  "result": true
                }
              }
            ]
          }
        ]
      },
      {
        "name": "calls",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ops",
        "sender_id": "ops",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "answer_input",
      "request_id": "$p1",
      "value": "Red",
      "expect": {
        "result": false
      }
    },
    {
      "call": "reject_input",
      "request_id": "$p1",
      "reason": "late",
      "expect": {
        "result": false
      }
    },
    {
      "call": "input_request",
      "request_id": "$p1",
      "expect": {
        "result": null
      }
    }
  ],
  "expect": {
    "hooks": {
      "asked": [
        {
          "trigger": "on_user_input_required",
          "room_id": "room-1",
          "request": {
            "pending_id": "$p1",
            "tool_name": "ask_user",
            "arguments": {
              "question": "Color?"
            },
            "room_id": "room-1",
            "tool_call_id": "c1",
            "channel_id": "agent",
            "channel_type": "ai"
          }
        }
      ],
      "calls": [
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "name": "ask_user",
            "tool_call_id": "c1",
            "arguments": {
              "question": "Color?"
            },
            "result": "Blue",
            "is_error": false,
            "refused": false
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "Blue",
              "is_error": false
            }
          ]
        }
      ]
    },
    "framework_events": {
      "room-1": [
        {
          "$unordered": [
            {
              "event": "event_processed",
              "event_id": "room-1#0"
            },
            {
              "event": "user_input_required",
              "room_id": "room-1",
              "channel_id": "agent",
              "pending_id": "$p1",
              "tool_name": "ask_user",
              "tool_call_id": "c1",
              "allowed": true,
              "reason": null
            }
          ]
        }
      ]
    }
  }
}
