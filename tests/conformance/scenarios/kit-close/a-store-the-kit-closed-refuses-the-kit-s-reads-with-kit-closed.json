{
  "$schema": "../../scenario.schema.json",
  "id": "kit-close/a-store-the-kit-closed-refuses-the-kit-s-reads-with-kit-closed",
  "title": "Once the kit's close closed its store, the kit refuses a read with kit_closed, never the store's own error",
  "rules": [
    "§12.10.4",
    "§14.1"
  ],
  "requirements": [
    "RK-12.10.4-035"
  ],
  "notes": "Python: tests/test_kit_close.py::test_a_read_answers_during_the_close_and_after_it_while_its_store_is_open. The store is one the kit closes (setup.kit.store_owner kit): once closed it refuses every operation, as a closed store fails them, and the kit's reads are refused naming the close.",
  "setup": {
    "kit": {
      "store_owner": "kit"
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "close",
      "expect": {
        "result": null
      }
    },
    {
      "call": "get_room",
      "room_id": "r",
      "expect": {
        "error": "kit_closed"
      }
    },
    {
      "call": "get_timeline",
      "room_id": "r",
      "expect": {
        "error": "kit_closed"
      }
    },
    {
      "call": "list_bindings",
      "room_id": "r",
      "expect": {
        "error": "kit_closed"
      }
    }
  ],
  "expect": {
    "timeline": {
      "r": []
    }
  }
}
