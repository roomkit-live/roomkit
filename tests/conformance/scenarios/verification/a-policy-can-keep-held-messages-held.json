{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-policy-can-keep-held-messages-held",
  "title": "A policy that does not release on verification leaves the held messages held once the request completes: no update, no agent",
  "rules": [
    "§11.7.6"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py (_release_held, _restore_held, _held_window), src/roomkit/core/mixins/regenerate.py (_rerun_agents_on); tests/test_verification_release.py::test_a_policy_can_keep_held_messages_held (RMK-1173).",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15551234567"
            },
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {
        "release_on_verify": false
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "Did my transfer go through?"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "updated",
        "trigger": "on_event_updated",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Did my transfer go through?"
        }
      }
    },
    {
      "call": "request_verification",
      "identity_id": "alice-id",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "req",
      "window_start": "2000-01-01T00:00:00Z"
    },
    {
      "call": "complete_verification",
      "request_id": "$req",
      "secret": "$req.secret"
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "Did my transfer go through?"
          },
          "visibility": "transport",
          "source": {
            "participant_id": "alice-id",
            "verification": "unverified"
          },
          "metadata": {
            "roomkit:verification_held": {
              "visibility": "all",
              "identity_id": "alice-id",
              "organization_id": null
            }
          }
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": []
      }
    },
    "hooks": {
      "updated": []
    }
  }
}
