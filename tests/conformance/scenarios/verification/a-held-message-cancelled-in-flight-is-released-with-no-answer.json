{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-held-message-cancelled-in-flight-is-released-with-no-answer",
  "title": "A held message whose delivery is cancelled while its sender is resolved is committed held all the same, and its release by a code reply restores it with no agent answering",
  "rules": [
    "§11.7.6",
    "§10.1 Explicit delivery cancellation"
  ],
  "notes": "Python: src/roomkit/core/_delivery_keys.py (hold, unhold), src/roomkit/core/mixins/verification.py (_name_held, _unhold_released, _record_held_cancellation, _answer_released); tests/test_verification_release_cancel.py::test_a_cancelled_held_message_is_released_with_no_answer[code-in flight] (RMK-1182); its [link-in flight] and [code-after the call] cases combine what this one and verification/a-held-message-cancelled-after-its-call-is-released-with-no-answer show.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "text": "Wire 500 to Bob"
            },
            "gate": "resolving",
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          },
          {
            "when": {
              "sender_id": "+15551234567"
            },
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "Wire 500 to Bob"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to Wire 500 to Bob"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Wire 500 to Bob"
        },
        "delivery_key": "task-42"
      },
      "background": true,
      "as": "held"
    },
    {
      "wait_for": "resolving"
    },
    {
      "call": "cancel_delivery",
      "key": "task-42",
      "reason": "user_stopped",
      "expect": {
        "result": 1
      }
    },
    {
      "open": "resolving"
    },
    {
      "await": "held",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "content": {
              "body": "Wire 500 to Bob"
            },
            "visibility": "transport"
          }
        }
      }
    },
    {
      "call": "request_verification",
      "identity_id": "alice-id",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "req",
      "window_start": "2000-01-01T00:00:00Z",
      "method": "code"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "$req.secret"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "verification_code"
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "Wire 500 to Bob"
          },
          "visibility": "all",
          "metadata": {
            "roomkit:verification_held": {
              "$absent": true
            }
          }
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": []
      }
    }
  }
}
