{
  "$schema": "../../scenario.schema.json",
  "id": "verification/an-unanswered-request-ends-when-it-expires",
  "title": "A request left unanswered ends at its expiry, announced then: the person reads as having none open, and its secret no longer completes it",
  "rules": [
    "§11.7.2",
    "§11.7.5",
    "§11.7.7",
    "§9.2"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py; tests/test_identity_verification.py::test_an_expired_request_cannot_be_completed, tests/test_verification_lifecycle.py::test_a_request_left_unanswered_ends_when_it_expires (RMK-1171). The ended hook holds at its gate until the step opens it: the request's timer ran by then.",
  "setup": {
    "kit": {
      "verification_policy": {
        "request_ttl_ms": 30
      }
    },
    "rooms": [
      {
        "id": "room-1"
      }
    ],
    "hooks": [
      {
        "name": "ended",
        "trigger": "on_verification_ended",
        "execution": "async",
        "reactions": [
          {
            "gate": "ended"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "request_verification",
      "identity_id": "alice",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "req"
    },
    {
      "wait_for": "ended"
    },
    {
      "open": "ended"
    },
    {
      "call": "verification_of",
      "identity_id": "alice",
      "expect": {
        "result": {
          "status": "unverified",
          "request_id": null
        }
      }
    },
    {
      "call": "complete_verification",
      "request_id": "$req",
      "secret": "$req.secret",
      "expect": {
        "error": {
          "name": "verification_refused",
          "reason": "expired"
        }
      }
    },
    {
      "call": "store.get_verification_request",
      "request_id": "$req",
      "expect": {
        "result": {
          "status": "expired"
        }
      }
    }
  ],
  "expect": {
    "framework_events": {
      "room-1": [
        {
          "event": "verification_requested",
          "identity_id": "alice",
          "request_id": "$e1",
          "channel_id": "sms"
        },
        {
          "event": "verification_ended",
          "identity_id": "alice",
          "request_id": "$e1",
          "channel_id": "sms",
          "reason": "expired",
          "ended": "request"
        }
      ]
    },
    "hooks": {
      "ended": [
        {
          "trigger": "on_verification_ended",
          "room_id": "room-1",
          "event": {
            "type": "system",
            "source": {
              "channel_id": "system"
            },
            "content": {
              "type": "system",
              "code": "on_verification_ended",
              "data": {
                "identity_id": "alice",
                "request_id": "$e1",
                "channel_id": "sms",
                "reason": "expired",
                "ended": "request"
              }
            }
          }
        }
      ]
    }
  }
}
