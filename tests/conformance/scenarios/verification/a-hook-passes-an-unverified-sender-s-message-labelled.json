{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-hook-passes-an-unverified-sender-s-message-labelled",
  "title": "A hook on ON_VERIFICATION_REQUIRED passes one message: it goes on as sent, labelled unverified, and reaches the agent; the message no hook passed stays held",
  "rules": [
    "§10.1 step 5b",
    "§11.7.3",
    "§9.4"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py (_apply_verification), src/roomkit/core/mixins/inbound.py; tests/test_verification_inbound.py::test_a_hook_lets_a_general_question_through_labelled (RMK-1172). Passing is the hook result's metadata roomkit:verification = pass, Python's HookResult.allow_unverified(). The held message's absence from the agent's context follows from its visibility (§7.5 rule 8).",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "general",
        "trigger": "on_verification_required",
        "reactions": [
          {
            "when": {
              "text": "What are your opening hours?"
            },
            "repeat": true,
            "result": {
              "action": "allow",
              "metadata": {
                "roomkit:verification": "pass"
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "My account number is 12345, what's my balance?"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "What are your opening hours?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "content": {
              "body": "What are your opening hours?"
            },
            "visibility": "all",
            "source": {
              "channel_id": "sms",
              "participant_id": "alice-id",
              "verification": "unverified"
            },
            "metadata": {
              "roomkit:verification_held": null
            }
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "My account number is 12345, what's my balance?"
          },
          "visibility": "transport",
          "source": {
            "channel_id": "sms",
            "participant_id": "alice-id",
            "verification": "unverified"
          },
          "metadata": {
            "roomkit:verification_held": {
              "visibility": "all",
              "identity_id": "alice-id",
              "organization_id": null
            }
          }
        },
        {
          "index": 1,
          "content": {
            "body": "What are your opening hours?"
          },
          "visibility": "all",
          "source": {
            "channel_id": "sms",
            "participant_id": "alice-id",
            "verification": "unverified"
          },
          "metadata": {
            "roomkit:verification_held": null
          }
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "What are your opening hours?"
            },
            "source": {
              "verification": "unverified"
            }
          }
        ]
      }
    }
  }
}
