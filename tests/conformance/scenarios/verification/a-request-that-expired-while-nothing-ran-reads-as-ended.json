{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-request-that-expired-while-nothing-ran-reads-as-ended",
  "title": "An open request whose expiry passed while nothing ran reads as ended, the identity unverified with none open; the next request announces it expired, not cancelled",
  "rules": [
    "§11.7.2",
    "§11.7.5",
    "§9.2"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py; tests/test_verification_lifecycle.py::test_a_request_that_expired_while_nothing_ran_reads_as_ended (RMK-1171). The records are the store's, as another process left them.",
  "setup": {
    "rooms": [
      {
        "id": "room-1"
      }
    ],
    "hooks": [
      {
        "name": "ended",
        "trigger": "on_verification_ended",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "store.create_verification_request",
      "request": {
        "id": "req-1",
        "identity_id": "alice",
        "room_id": "room-1",
        "channel_id": "sms",
        "method": "link",
        "secret_hash": "scrypt$00",
        "window_start": "2020-01-01T00:00:00Z",
        "created_at": "2020-01-01T00:00:00Z",
        "expires_at": "2020-01-01T00:10:00Z",
        "max_attempts": 3
      }
    },
    {
      "call": "store.put_verification",
      "verification": {
        "identity_id": "alice",
        "status": "pending",
        "request_id": "req-1"
      }
    },
    {
      "call": "verification_of",
      "identity_id": "alice",
      "expect": {
        "result": {
          "status": "unverified",
          "request_id": null
        }
      }
    },
    {
      "call": "request_verification",
      "identity_id": "alice",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "again"
    },
    {
      "call": "store.get_verification_request",
      "request_id": "req-1",
      "expect": {
        "result": {
          "status": "expired"
        }
      }
    },
    {
      "call": "verification_of",
      "identity_id": "alice",
      "expect": {
        "result": {
          "status": "pending",
          "request_id": "$e2"
        }
      }
    }
  ],
  "expect": {
    "framework_events": {
      "room-1": [
        {
          "event": "verification_ended",
          "identity_id": "alice",
          "request_id": "$e1",
          "channel_id": "sms",
          "reason": "expired",
          "ended": "request"
        },
        {
          "event": "verification_requested",
          "identity_id": "alice",
          "request_id": "$e2",
          "channel_id": "sms"
        }
      ]
    },
    "hooks": {
      "ended": [
        {
          "trigger": "on_verification_ended",
          "room_id": "room-1",
          "event": {
            "type": "system",
            "source": {
              "channel_id": "system"
            },
            "content": {
              "type": "system",
              "code": "on_verification_ended",
              "data": {
                "identity_id": "alice",
                "request_id": "$e1",
                "channel_id": "sms",
                "reason": "expired",
                "ended": "request"
              }
            }
          }
        }
      ]
    }
  }
}
