{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-code-reply-s-release-is-answered-past-its-budget",
  "title": "A code reply's release is no part of its pre-commit work: an answer longer than process_timeout is in once the reply returns verification_code",
  "rules": [
    "§11.7.6",
    "§11.7.4",
    "§10.1 step 5b",
    "§13.6"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py (_apply_verification, _code_reply, _attempt_code: the attempt run to its end; _release_held), src/roomkit/core/mixins/inbound.py (_prepare_event: the pre-commit budget); RMK-913. The agent takes twice the budget. A wrong code is verification/a-reply-of-other-digits-is-a-wrong-code.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15551234567"
            },
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {},
      "process_timeout_ms": 300
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "What's my balance?"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer"
                }
              }
            ],
            "delay_ms": 600
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "What's my balance?"
        }
      }
    },
    {
      "call": "request_verification",
      "identity_id": "alice-id",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "req",
      "window_start": "2000-01-01T00:00:00Z",
      "method": "code"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "$req.secret"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "verification_code",
          "event": null
        }
      }
    },
    {
      "call": "store.get_verification_request",
      "request_id": "$req",
      "expect": {
        "result": {
          "status": "completed"
        }
      }
    },
    {
      "call": "store.get_timeline",
      "room_id": "room-1",
      "expect": {
        "result": [
          {
            "content": {
              "body": "What's my balance?"
            },
            "visibility": "all"
          },
          {
            "content": {
              "body": "answer"
            },
            "responds_to": "room-1#0"
          }
        ]
      },
      "event_filter": {
        "event_types": [
          "message"
        ]
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "What's my balance?"
          },
          "visibility": "all",
          "source": {
            "channel_id": "sms",
            "participant_id": "alice-id",
            "verification": "unverified"
          },
          "metadata": {
            "roomkit:verification_held": {
              "$absent": true
            }
          }
        },
        {
          "index": 1,
          "content": {
            "body": "answer"
          },
          "source": {
            "channel_id": "ai",
            "direction": "outbound"
          },
          "responds_to": "room-1#0"
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "What's my balance?"
            },
            "visibility": "intelligence"
          }
        ]
      }
    },
    "deliveries": {
      "room-1": {
        "sms": [
          {
            "content": {
              "body": "answer"
            }
          }
        ]
      }
    }
  }
}
