{
  "$schema": "../../scenario.schema.json",
  "id": "verification/check-verifications-ends-what-expired-while-nothing-ran",
  "title": "check_verifications ends the verifications whose time passed while nothing ran, announcing each in the room of the request that completed it, and leaves those in force",
  "rules": [
    "§11.7.5",
    "§9.2"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py; tests/test_verification_lifecycle.py::test_what_expired_while_nothing_ran_is_ended_at_start (RMK-1171). The records are the store's, as another process left them. A kit's start runs the same check: that is in each implementation's own tests.",
  "setup": {
    "rooms": [
      {
        "id": "room-1"
      }
    ],
    "hooks": [
      {
        "name": "ended",
        "trigger": "on_verification_ended",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "store.create_verification_request",
      "request": {
        "id": "req-1",
        "identity_id": "alice",
        "room_id": "room-1",
        "channel_id": "sms",
        "method": "link",
        "secret_hash": "scrypt$00",
        "window_start": "2020-01-01T00:00:00Z",
        "created_at": "2020-01-01T00:00:00Z",
        "expires_at": "2020-01-01T00:10:00Z",
        "max_attempts": 3,
        "status": "completed"
      }
    },
    {
      "call": "store.put_verification",
      "verification": {
        "identity_id": "alice",
        "status": "verified",
        "method": "link",
        "verified_via": "sms",
        "verified_at": "2020-01-01T00:01:00Z",
        "expires_at": "2020-01-01T00:16:00Z",
        "completed_request_id": "req-1"
      }
    },
    {
      "call": "store.put_verification",
      "verification": {
        "identity_id": "bob",
        "status": "verified",
        "method": "link",
        "verified_via": "sms",
        "verified_at": "2030-01-01T00:00:00Z",
        "expires_at": "2100-01-01T00:00:00Z"
      }
    },
    {
      "call": "check_verifications",
      "expect": {
        "result": [
          {
            "identity_id": "alice",
            "status": "expired",
            "ended_reason": "expired"
          }
        ]
      }
    },
    {
      "call": "verification_of",
      "identity_id": "alice",
      "expect": {
        "result": {
          "status": "expired",
          "ended_reason": "expired"
        }
      }
    },
    {
      "call": "verification_of",
      "identity_id": "bob",
      "expect": {
        "result": {
          "status": "verified"
        }
      }
    },
    {
      "call": "check_verifications",
      "expect": {
        "result": []
      }
    }
  ],
  "expect": {
    "framework_events": {
      "room-1": [],
      "*": [
        {
          "event": "verification_ended",
          "identity_id": "alice",
          "reason": "expired",
          "ended": "verification"
        }
      ]
    },
    "hooks": {
      "ended": [
        {
          "trigger": "on_verification_ended",
          "room_id": "room-1",
          "event": {
            "type": "system",
            "source": {
              "channel_id": "system"
            },
            "content": {
              "type": "system",
              "code": "on_verification_ended",
              "data": {
                "identity_id": "alice",
                "request_id": "$e1",
                "channel_id": "sms",
                "reason": "expired",
                "ended": "verification"
              }
            }
          }
        }
      ]
    }
  }
}
