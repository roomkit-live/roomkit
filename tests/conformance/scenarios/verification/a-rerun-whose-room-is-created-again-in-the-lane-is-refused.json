{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-rerun-whose-room-is-created-again-in-the-lane-is-refused",
  "title": "A held message released from a turn in its room is answered in the room's lane after that turn's delivery: its room deleted meanwhile and created again under the same id, the answer is refused before any agent runs, as in a room gone, room_refused_event naming no status, and nothing is written into the new room",
  "rules": [
    "§11.7.6",
    "§5.1",
    "§13.5 Delivery lanes across processes",
    "§13.6",
    "§10.1 step 18"
  ],
  "requirements": [
    "RK-11.7.6-010",
    "RK-13.5-037",
    "RK-13.5-038",
    "RK-26.1-013",
    "RK-8.2-003",
    "RK-8.2-007",
    "RK-8.2-010",
    "RK-8.2-020",
    "RK-8.2-023",
    "RK-8.2-027",
    "RK-8.2-029",
    "RK-8.2-030",
    "RK-8.2-061",
    "RK-8.2-062",
    "RK-8.2-063"
  ],
  "notes": "As verification/a-rerun-whose-room-is-deleted-in-the-lane-is-refused, the room then created again under the same id with `sms` and `ws` only, in the same turn. The regeneration waits in the deleted room's lane; once its turn comes, the room it was released in is gone, though one is held under its id: the regeneration is refused before the agent runs (`operation = regenerate`, a null status), and the new room's timeline stays empty.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15551234567"
            },
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "Wire 500 to Bob"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to Wire 500 to Bob"
                }
              }
            ]
          },
          {
            "when": {
              "text": "Verified by phone"
            },
            "do": [
              {
                "call": "complete_verification",
                "request_id": "$req",
                "secret": "$req.secret",
                "as": "verified"
              },
              {
                "call": "store.delete_room",
                "room_id": "room-1"
              },
              {
                "call": "create_room",
                "room": {
                  "id": "room-1"
                }
              },
              {
                "call": "attach_channel",
                "room_id": "room-1",
                "channel_id": "sms"
              },
              {
                "call": "attach_channel",
                "room_id": "room-1",
                "channel_id": "ws"
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Wire 500 to Bob"
        }
      }
    },
    {
      "call": "request_verification",
      "identity_id": "alice-id",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "req",
      "window_start": "2000-01-01T00:00:00Z"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "advisor",
        "content": {
          "type": "text",
          "body": "Verified by phone"
        }
      }
    }
  ],
  "expect": {
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "Verified by phone"
            }
          }
        ]
      }
    },
    "framework_events": {
      "room-1": [
        "identity_resolved",
        {
          "event": "delivery_succeeded",
          "channel_id": "ws"
        },
        "event_processed",
        "verification_requested",
        "verification_completed",
        "room_created",
        {
          "event": "room_channel_attached",
          "channel_id": "sms"
        },
        {
          "event": "room_channel_attached",
          "channel_id": "ws"
        },
        {
          "$unordered": [
            {
              "event": "room_refused_event",
              "status": null,
              "operation": "regenerate",
              "event_type": "message"
            },
            {
              "event": "delivery_succeeded",
              "channel_id": "sms"
            },
            "event_processed"
          ]
        }
      ]
    },
    "timeline": {
      "room-1": []
    }
  }
}
