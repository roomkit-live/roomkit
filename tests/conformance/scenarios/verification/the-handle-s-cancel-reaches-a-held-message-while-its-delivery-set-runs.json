{
  "$schema": "../../scenario.schema.json",
  "id": "verification/the-handle-s-cancel-reaches-a-held-message-while-its-delivery-set-runs",
  "title": "A held message whose call is cancelled by its key while its delivery set runs is released with no answer: the cancellation is written on its mark",
  "rules": [
    "§11.7.6",
    "§10.1 Explicit delivery cancellation"
  ],
  "notes": "Python: src/roomkit/core/_delivery_keys.py (hold, unhold), src/roomkit/core/mixins/verification.py (_name_held, _unhold_released, _record_held_cancellation, _answer_released); tests/test_verification_release_cancel.py::test_the_handle_reaches_a_held_message_while_its_delivery_set_runs[while its delivery set runs] (RMK-1182): there the handle's cancel, here a cancel by the key the call gave. The handle's own cancel, with no key, and its [once it ran] case, a cancel that reaches nothing: roomkit-rs tests/verification_release.rs::the_handle_reaches_a_held_message_while_its_delivery_set_runs, ::the_handle_does_not_reach_a_held_message_once_its_delivery_set_ran.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15551234567"
            },
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "Wire 500 to Bob"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to Wire 500 to Bob"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "slow",
        "trigger": "after_broadcast",
        "reactions": [
          {
            "when": {
              "text": "Wire 500 to Bob"
            },
            "gate": "delivering"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Wire 500 to Bob"
        },
        "delivery_key": "task-42"
      },
      "background": true,
      "as": "held"
    },
    {
      "wait_for": "delivering"
    },
    {
      "call": "cancel_delivery",
      "key": "task-42",
      "reason": "user_stopped",
      "expect": {
        "result": 1
      }
    },
    {
      "open": "delivering"
    },
    {
      "await": "held"
    },
    {
      "call": "request_verification",
      "identity_id": "alice-id",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "req",
      "window_start": "2000-01-01T00:00:00Z"
    },
    {
      "call": "complete_verification",
      "request_id": "$req",
      "secret": "$req.secret"
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "Wire 500 to Bob"
          },
          "visibility": "all",
          "metadata": {
            "roomkit:verification_held": {
              "$absent": true
            }
          }
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": []
      }
    }
  }
}
