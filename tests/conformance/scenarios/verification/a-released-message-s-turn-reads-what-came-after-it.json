{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-released-message-s-turn-reads-what-came-after-it",
  "title": "A released message's turn reads the messages stored after it, then the message, last",
  "rules": [
    "§11.7.6",
    "§6.4"
  ],
  "notes": "Python: core/mixins/regenerate.py _rerun_agents_on builds the context under the lock: the turn's history holds what came after the held message.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15551234567"
            },
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Note answer"
            },
            {
              "text": "Your balance"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "What's my balance?"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "bob",
        "content": {
          "type": "text",
          "body": "A note after it"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "request_verification",
      "identity_id": "alice-id",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "req",
      "window_start": "2000-01-01T00:00:00Z",
      "method": "code"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "$req.secret"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "verification_code"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "@ws: \"A note after it\""
            },
            {
              "role": "assistant",
              "text": "Note answer"
            },
            {
              "role": "user",
              "text": {
                "$contains": "@sms: \"What's my balance?\""
              }
            }
          ]
        }
      ]
    }
  }
}
