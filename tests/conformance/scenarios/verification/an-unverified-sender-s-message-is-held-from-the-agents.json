{
  "$schema": "../../scenario.schema.json",
  "id": "verification/an-unverified-sender-s-message-is-held-from-the-agents",
  "title": "An identified sender not verified: the message is labelled, ON_VERIFICATION_REQUIRED hears it, and a hook that only allows leaves it held: stored and delivered to the transports it reached, marked with the scope it had, and read by no agent",
  "rules": [
    "§10.1 step 5b",
    "§11.7.3",
    "§7.3",
    "§7.5"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py (_apply_verification), src/roomkit/core/mixins/inbound.py; tests/test_verification_inbound.py::test_an_unverified_message_is_held_from_the_agent (RMK-1172). The hook allows without passing: a hook that only watches never lets a message through.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "required",
        "trigger": "on_verification_required"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Did my transfer go through?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "content": {
              "body": "Did my transfer go through?"
            },
            "visibility": "transport",
            "source": {
              "channel_id": "sms",
              "participant_id": "alice-id",
              "verification": "unverified"
            },
            "metadata": {
              "roomkit:verification_held": {
                "visibility": "all",
                "identity_id": "alice-id",
                "organization_id": null
              }
            }
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "Did my transfer go through?"
          },
          "visibility": "transport",
          "source": {
            "channel_id": "sms",
            "participant_id": "alice-id",
            "verification": "unverified"
          },
          "metadata": {
            "roomkit:verification_held": {
              "visibility": "all",
              "identity_id": "alice-id",
              "organization_id": null
            }
          }
        }
      ]
    },
    "hooks": {
      "required": [
        {
          "trigger": "on_verification_required",
          "room_id": "room-1",
          "event": {
            "content": {
              "body": "Did my transfer go through?"
            },
            "visibility": "all",
            "source": {
              "participant_id": "alice-id",
              "verification": "unverified"
            },
            "metadata": {
              "roomkit:verification_held": null
            }
          }
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "Did my transfer go through?"
            },
            "visibility": "transport"
          }
        ],
        "sms": []
      }
    },
    "turns": {
      "room-1": {
        "ai": []
      }
    }
  }
}
