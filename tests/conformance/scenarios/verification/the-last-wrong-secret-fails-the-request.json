{
  "$schema": "../../scenario.schema.json",
  "id": "verification/the-last-wrong-secret-fails-the-request",
  "title": "A wrong secret counts as an attempt; the last one fails the request, which no secret completes after, and the identity reads unverified",
  "rules": [
    "§11.7.2",
    "§11.7.5",
    "§11.7.7",
    "§9.2"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py; tests/test_identity_verification.py::test_a_wrong_secret_counts_and_the_last_attempt_fails_the_request, tests/test_verification_lifecycle.py::test_a_request_that_fails_fires_the_end (RMK-1171).",
  "setup": {
    "kit": {
      "verification_policy": {
        "max_attempts": 2
      }
    },
    "rooms": [
      {
        "id": "room-1"
      }
    ],
    "hooks": [
      {
        "name": "completed",
        "trigger": "on_verification_completed",
        "execution": "async"
      },
      {
        "name": "ended",
        "trigger": "on_verification_ended",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "request_verification",
      "identity_id": "alice",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "req"
    },
    {
      "call": "complete_verification",
      "request_id": "$req",
      "secret": "wrong",
      "expect": {
        "error": {
          "name": "verification_refused",
          "reason": "mismatch"
        }
      }
    },
    {
      "call": "complete_verification",
      "request_id": "$req",
      "secret": "wrong again",
      "expect": {
        "error": {
          "name": "verification_refused",
          "reason": "failed"
        }
      }
    },
    {
      "call": "complete_verification",
      "request_id": "$req",
      "secret": "$req.secret",
      "expect": {
        "error": {
          "name": "verification_refused",
          "reason": "not_open"
        }
      }
    },
    {
      "call": "store.get_verification_request",
      "request_id": "$req",
      "expect": {
        "result": {
          "status": "failed",
          "attempts": 2
        }
      }
    },
    {
      "call": "verification_of",
      "identity_id": "alice",
      "expect": {
        "result": {
          "status": "unverified",
          "ended_reason": "failed",
          "request_id": null
        }
      }
    }
  ],
  "expect": {
    "framework_events": {
      "room-1": [
        {
          "event": "verification_requested",
          "identity_id": "alice",
          "request_id": "$e1",
          "channel_id": "sms"
        },
        {
          "event": "verification_ended",
          "identity_id": "alice",
          "request_id": "$e1",
          "channel_id": "sms",
          "reason": "failed",
          "ended": "request"
        }
      ]
    },
    "hooks": {
      "completed": [],
      "ended": [
        {
          "trigger": "on_verification_ended",
          "room_id": "room-1",
          "event": {
            "type": "system",
            "source": {
              "channel_id": "system"
            },
            "content": {
              "type": "system",
              "code": "on_verification_ended",
              "data": {
                "identity_id": "alice",
                "request_id": "$e1",
                "channel_id": "sms",
                "reason": "failed",
                "ended": "request"
              }
            }
          }
        }
      ]
    }
  }
}
