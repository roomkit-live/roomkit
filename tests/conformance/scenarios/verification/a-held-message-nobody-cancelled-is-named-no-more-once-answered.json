{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-held-message-nobody-cancelled-is-named-no-more-once-answered",
  "title": "A held message's key names it until its release is answered, and nothing after",
  "rules": [
    "§11.7.6",
    "§10.1 Explicit delivery cancellation"
  ],
  "notes": "Python: src/roomkit/core/_delivery_keys.py (hold, unhold), src/roomkit/core/mixins/verification.py (_name_held, _unhold_released, _record_held_cancellation, _answer_released); tests/test_verification_release_cancel.py::test_a_held_message_nobody_cancelled_is_answered_and_named_no_more[link] (RMK-1182); its [code] case releases the same way, verification/a-code-reply-releases-the-held-message.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15551234567"
            },
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "Wire 500 to Bob"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to Wire 500 to Bob"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Wire 500 to Bob"
        },
        "delivery_key": "task-42"
      }
    },
    {
      "call": "request_verification",
      "identity_id": "alice-id",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "req",
      "window_start": "2000-01-01T00:00:00Z"
    },
    {
      "call": "complete_verification",
      "request_id": "$req",
      "secret": "$req.secret"
    },
    {
      "call": "cancel_delivery",
      "key": "task-42",
      "expect": {
        "result": 0
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "Wire 500 to Bob"
          },
          "visibility": "all",
          "metadata": {
            "roomkit:verification_held": {
              "$absent": true
            }
          }
        },
        {
          "content": {
            "body": "answer to Wire 500 to Bob"
          },
          "responds_to": "room-1#0"
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "Wire 500 to Bob"
            }
          }
        ]
      }
    }
  }
}
