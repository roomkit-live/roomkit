{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-secret-is-checked-against-its-scrypt-hash",
  "title": "A request's secret is checked against its stored hash, scrypt salted with the request's id: a request another implementation opened on a shared store is completed with its secret",
  "rules": [
    "§11.7.2",
    "§11.7.7"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py; _secret_hash (RMK-1171). The stored hash is Python's: hashlib.scrypt(b\"s3cret\", salt=b\"req-1\", n=2**15, r=8, p=1, dklen=32), hex, after `scrypt$`; every implementation hashes a secret so, so that one store serves them all.",
  "setup": {
    "rooms": [
      {
        "id": "room-1"
      }
    ],
    "hooks": []
  },
  "steps": [
    {
      "call": "store.create_verification_request",
      "request": {
        "id": "req-1",
        "identity_id": "alice",
        "room_id": "room-1",
        "channel_id": "sms",
        "method": "link",
        "secret_hash": "scrypt$cfc5f8a1bfb9fe3c1bfed3e2a763e483ff22faede0cf65d56496df0197b58cc3",
        "window_start": "2030-01-01T00:00:00Z",
        "created_at": "2030-01-01T00:00:00Z",
        "expires_at": "2100-01-01T00:00:00Z",
        "max_attempts": 3
      }
    },
    {
      "call": "store.put_verification",
      "verification": {
        "identity_id": "alice",
        "status": "pending",
        "request_id": "req-1"
      }
    },
    {
      "call": "complete_verification",
      "request_id": "req-1",
      "secret": "s3cre",
      "expect": {
        "error": {
          "name": "verification_refused",
          "reason": "mismatch"
        }
      }
    },
    {
      "call": "complete_verification",
      "request_id": "req-1",
      "secret": "s3cret",
      "expect": {
        "result": {
          "status": "verified",
          "method": "link",
          "verified_via": "sms",
          "completed_request_id": "$e1"
        }
      }
    }
  ],
  "expect": {
    "framework_events": {
      "room-1": [
        {
          "event": "verification_completed",
          "identity_id": "alice",
          "request_id": "$e1",
          "channel_id": "sms"
        }
      ]
    }
  }
}
