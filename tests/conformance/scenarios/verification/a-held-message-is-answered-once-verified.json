{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-held-message-is-answered-once-verified",
  "title": "Once its request completes, a held message gets back the scope it had, through an update ON_EVENT_UPDATED hears, and the room's agents answer it as its author's turn, the host's later message notwithstanding; its transports are not handed it again",
  "rules": [
    "§11.7.6",
    "§11.7.3",
    "§10.3"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py (_release_held, _restore_held, _held_window), src/roomkit/core/mixins/regenerate.py (_rerun_agents_on); tests/test_verification_release.py::test_a_held_question_is_answered_once_verified (RMK-1173). The bank's message after the question is not the one the agents answer: the release names its last message.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15551234567"
            },
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "Did my transfer go through?"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "updated",
        "trigger": "on_event_updated",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Did my transfer go through?"
        }
      }
    },
    {
      "call": "request_verification",
      "identity_id": "alice-id",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "req",
      "window_start": "2000-01-01T00:00:00Z"
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Please confirm it's you"
      },
      "addressed_to": []
    },
    {
      "call": "complete_verification",
      "request_id": "$req",
      "secret": "$req.secret"
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "Did my transfer go through?"
          },
          "visibility": "all",
          "source": {
            "channel_id": "sms",
            "participant_id": "alice-id",
            "verification": "unverified"
          },
          "metadata": {
            "roomkit:verification_held": {
              "$absent": true
            }
          }
        },
        {
          "index": 1,
          "content": {
            "body": "Please confirm it's you"
          },
          "source": {
            "channel_id": "ws"
          }
        },
        {
          "index": 2,
          "content": {
            "body": "answer"
          },
          "source": {
            "channel_id": "ai",
            "direction": "outbound"
          },
          "responds_to": "room-1#0"
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "Did my transfer go through?"
            },
            "visibility": "intelligence"
          }
        ]
      }
    },
    "deliveries": {
      "room-1": {
        "sms": [
          {
            "content": {
              "body": "Please confirm it's you"
            }
          },
          {
            "content": {
              "body": "answer"
            }
          }
        ],
        "ws": [
          {
            "content": {
              "body": "Did my transfer go through?"
            }
          },
          {
            "content": {
              "body": "answer"
            }
          }
        ]
      }
    },
    "hooks": {
      "updated": [
        {
          "trigger": "on_event_updated",
          "room_id": "room-1",
          "event": {
            "content": {
              "body": "Did my transfer go through?"
            },
            "visibility": "all",
            "metadata": {
              "roomkit:verification_held": {
                "$absent": true
              }
            }
          }
        }
      ]
    }
  }
}
