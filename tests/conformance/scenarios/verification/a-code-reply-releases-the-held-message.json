{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-code-reply-releases-the-held-message",
  "title": "A code reply that completes its request releases what its sender wrote while it was open: the room's agents answer the held message, and the code itself is never stored",
  "rules": [
    "§11.7.6",
    "§11.7.4",
    "§10.1 step 5b"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py (_release_held, _restore_held, _held_window), src/roomkit/core/mixins/regenerate.py (_rerun_agents_on); tests/test_verification_release.py::test_a_code_reply_releases_too (RMK-1173). The release runs within the code reply's call: its answer is in once the call returns.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15551234567"
            },
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "What's my balance?"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "updated",
        "trigger": "on_event_updated",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "What's my balance?"
        }
      }
    },
    {
      "call": "request_verification",
      "identity_id": "alice-id",
      "room_id": "room-1",
      "channel_id": "sms",
      "as": "req",
      "window_start": "2000-01-01T00:00:00Z",
      "method": "code"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "$req.secret"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "verification_code",
          "event": null
        }
      }
    },
    {
      "call": "store.get_timeline",
      "room_id": "room-1",
      "expect": {
        "result": [
          {
            "content": {
              "body": "What's my balance?"
            },
            "visibility": "all"
          },
          {
            "content": {
              "body": "answer"
            },
            "responds_to": "room-1#0"
          }
        ]
      },
      "event_filter": {
        "event_types": [
          "message"
        ]
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "What's my balance?"
          },
          "visibility": "all",
          "source": {
            "channel_id": "sms",
            "participant_id": "alice-id",
            "verification": "unverified"
          },
          "metadata": {
            "roomkit:verification_held": {
              "$absent": true
            }
          }
        },
        {
          "index": 1,
          "content": {
            "body": "answer"
          },
          "source": {
            "channel_id": "ai",
            "direction": "outbound"
          },
          "responds_to": "room-1#0"
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "What's my balance?"
            },
            "visibility": "intelligence"
          }
        ]
      }
    },
    "deliveries": {
      "room-1": {
        "sms": [
          {
            "content": {
              "body": "answer"
            }
          }
        ]
      }
    }
  }
}
