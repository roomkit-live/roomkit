{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-hook-blocks-an-unverified-sender-s-message-before-it-is-stored",
  "title": "A hook on ON_VERIFICATION_REQUIRED that blocks refuses the message with its reason: nothing of it is stored or delivered",
  "rules": [
    "§10.1 step 5b",
    "§11.7.3",
    "§9.4"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py (_apply_verification), src/roomkit/core/mixins/inbound.py; tests/test_verification_inbound.py::test_a_hook_blocks_a_message_before_it_is_stored (RMK-1172).",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "refuse",
        "trigger": "on_verification_required",
        "reactions": [
          {
            "result": {
              "action": "block",
              "reason": "verify first"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Close my account"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "verify first",
          "event": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": []
    },
    "deliveries": {
      "room-1": {
        "ws": [],
        "sms": []
      }
    },
    "turns": {
      "room-1": {
        "ai": []
      }
    }
  }
}
