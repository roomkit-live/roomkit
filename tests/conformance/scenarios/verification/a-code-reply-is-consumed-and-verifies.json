{
  "$schema": "../../scenario.schema.json",
  "id": "verification/a-code-reply-is-consumed-and-verifies",
  "title": "A reply whose whole text is the code of the sender's open code request in its room is attempted and consumed: refused verification_code, its text never stored nor delivered, and the identity verified",
  "rules": [
    "§10.1 step 5b",
    "§11.7.4",
    "§11.7.2"
  ],
  "notes": "Python: src/roomkit/core/mixins/verification.py (_apply_verification, _consume_code); tests/test_verification_inbound.py::test_a_code_reply_is_consumed_and_verifies (RMK-1172). A wrong code, consumed and counted, and a code surrounded by spaces are in each implementation's own tests: a scenario cannot write a code it does not know.",
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "required",
        "trigger": "on_verification_required"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "hello"
        }
      }
    },
    {
      "call": "request_verification",
      "identity_id": "alice-id",
      "room_id": "room-1",
      "channel_id": "sms",
      "method": "code",
      "as": "req"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "$req.secret"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "verification_code",
          "event": null
        }
      }
    },
    {
      "call": "verification_of",
      "identity_id": "alice-id",
      "expect": {
        "result": {
          "status": "verified",
          "method": "code",
          "request_id": null
        }
      }
    },
    {
      "call": "store.get_verification_request",
      "request_id": "$req",
      "expect": {
        "result": {
          "status": "completed",
          "attempts": 0
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "hello"
          },
          "visibility": "transport",
          "source": {
            "channel_id": "sms",
            "participant_id": "alice-id",
            "verification": "unverified"
          },
          "metadata": {
            "roomkit:verification_held": {
              "visibility": "all",
              "identity_id": "alice-id",
              "organization_id": null
            }
          }
        }
      ]
    },
    "hooks": {
      "required": [
        {
          "trigger": "on_verification_required",
          "room_id": "room-1",
          "event": {
            "content": {
              "body": "hello"
            }
          }
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "hello"
            }
          }
        ],
        "sms": []
      }
    },
    "turns": {
      "room-1": {
        "ai": []
      }
    }
  }
}
