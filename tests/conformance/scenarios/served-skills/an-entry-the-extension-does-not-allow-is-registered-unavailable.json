{
  "$schema": "../../scenario.schema.json",
  "id": "served-skills/an-entry-the-extension-does-not-allow-is-registered-unavailable",
  "title": "An entry whose name, own file, directory or files break the rules is unavailable",
  "rules": [
    "§24.7"
  ],
  "requirements": [
    "RK-24.7-026",
    "RK-24.7-027",
    "RK-24.7-028",
    "RK-24.7-081"
  ],
  "notes": "Each refused entry breaks one rule and is otherwise well formed: #1's frontmatter name is not its directory's, #2 does not list its own SKILL.md, #3 lists a file of another skill's directory, #4 lists its SKILL.md twice. An entry the registry cannot name is named <label>:#<position in the listing>, with the reason the model is given.",
  "steps": [
    {
      "call": "skill_registry_session",
      "servers": {
        "remote": {
          "replies": [
            {
              "method": "skills/list",
              "params": {},
              "result": {
                "skills": [
                  {
                    "uri": "skill://guide/SKILL.md",
                    "frontmatter": {
                      "name": "guide",
                      "description": "Read the guide"
                    },
                    "resources": [
