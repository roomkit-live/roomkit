{
  "$schema": "../../scenario.schema.json",
  "id": "served-skills/frontmatter-refuses-broken-yaml",
  "title": "A verified digest does not admit broken yaml frontmatter",
  "rules": [
    "§24.7"
  ],
  "steps": [
    {
      "call": "skill_registry_session",
      "servers": {
        "remote": {
          "replies": [
            {
              "method": "skills/list",
              "params": {},
              "result": {
                "skills": [
                  {
                    "uri": "skill://guide/SKILL.md",
                    "frontmatter": {
                      "name": "guide",
                      "description": "Read the guide"
                    },
                    "resources": [
                      {
                        "uri": "skill://guide/SKILL.md",
                        "digest": "sha256:e4b4cb4dccd92eb8c10a2d25f06d9a96a597e6309909f21225c219e57256a1a6",
                        "size": 43
                      }
                    ]
                  }
                ]
              }
            },
            {
              "method": "resources/read",
              "params": {
                "uri": "skill://guide/SKILL.md"
              },
              "result": {
                "contents": [
                  {
                    "uri": "skill://guide/SKILL.md",
                    "text": "---\nname: [unclosed\n---\n\nFollow the steps.\n"
                  }
                ]
              }
            },
            {
              "method": "skills/get",
              "params": {
                "uri": "skill://guide/SKILL.md"
              },
              "result": {
                "skill": {
                  "uri": "skill://guide/SKILL.md",
                  "frontmatter": {
                    "name": "guide",
                    "description": "Read the guide"
                  },
                  "resources": [
                    {
                      "uri": "skill://guide/SKILL.md",
                      "digest": "sha256:e4b4cb4dccd92eb8c10a2d25f06d9a96a597e6309909f21225c219e57256a1a6",
                      "size": 43
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "operations": [
        {
          "method": "add_mcp_server",
          "server": "remote",
          "label": "docs"
        },
        {
          "method": "load_skill",
          "name": "docs:guide"
        },
        {
          "method": "get_skill",
          "name": "docs:guide"
        }
      ],
      "expect": {
        "result": {
          "results": [
            {
              "status": "ok",
              "result": 1
            },
            {
              "error": "SkillVerificationError",
              "message": "Skill 'docs:guide' changed on its server or could not be verified",
              "status": "error"
            },
            {
              "status": "ok",
              "result": null
            }
          ],
          "requests": {
            "remote": [
              {
                "method": "skills/list",
                "params": {}
              },
              {
                "method": "resources/read",
                "params": {
                  "uri": "skill://guide/SKILL.md"
                }
              },
              {
                "method": "skills/get",
                "params": {
                  "uri": "skill://guide/SKILL.md"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
