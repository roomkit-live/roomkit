{
  "$schema": "../../scenario.schema.json",
  "id": "served-skills/text-blocked-activation-leaves-no-prompt-content",
  "title": "A hook-blocked activation leaves no server body active",
  "rules": [
    "§24.7"
  ],
  "requirements": [
    "RK-24.7-039",
    "RK-9.2-073",
    "RK-9.3-060"
  ],
  "steps": [
    {
      "call": "skill_registry_session",
      "servers": {
        "remote": {
          "replies": [
            {
              "method": "skills/list",
              "params": {},
              "result": {
                "skills": [
                  {
                    "uri": "skill://guide/SKILL.md",
                    "frontmatter": {
                      "name": "guide",
                      "description": "Read the guide"
                    },
                    "resources": [
                      {
                        "uri": "skill://guide/SKILL.md",
                        "digest": "sha256:a0f5cbce5cfdb05a47d0b6a147ed4215f0da111e5d132c63d7b6697af919fb6c",
                        "size": 67
                      }
                    ]
                  }
                ]
              }
            },
            {
              "method": "resources/read",
              "params": {
                "uri": "skill://guide/SKILL.md"
              },
              "result": {
                "contents": [
                  {
                    "uri": "skill://guide/SKILL.md",
                    "text": "---\nname: guide\ndescription: Read the guide\n---\n\nFollow the steps.\n"
                  }
                ]
              }
            }
          ]
        }
      },
      "operations": [
        {
          "method": "add_mcp_server",
          "server": "remote",
          "label": "docs"
        },
        {
          "method": "install_channel",
          "channel": {
            "id": "agent",
            "type": "ai",
            "model": {
              "rounds": [
                {
                  "calls": [
                    {
                      "id": "activate",
                      "name": "activate_skill",
                      "arguments": {
                        "name": "docs:guide"
                      }
                    }
                  ]
                },
                {
                  "text": "done"
                },
                {
                  "text": "again"
                }
              ]
            }
          }
        },
        {
          "method": "room_call",
          "action": {
            "call": "attach_channel",
            "room_id": "room-1",
            "channel_id": "agent",
            "category": "intelligence"
          }
        },
        {
          "method": "room_call",
          "action": {
            "call": "process_inbound",
            "room_id": "room-1",
            "message": {
              "channel_id": "ws",
              "sender_id": "ada",
              "content": {
                "type": "text",
                "body": "Hello"
              }
            }
          }
        },
        {
          "method": "room_call",
          "action": {
            "call": "process_inbound",
            "room_id": "room-1",
            "message": {
              "channel_id": "ws",
              "sender_id": "ada",
              "content": {
                "type": "text",
                "body": "Hello"
              }
            }
          }
        }
      ],
      "expect": {
        "result": {
          "results": [
            {
              "status": "ok"
            },
            {
              "status": "ok"
            },
            {
              "status": "ok"
            },
            {
              "status": "ok"
            },
            {
              "status": "ok"
            }
          ],
          "requests": {
            "remote": [
              {
                "method": "skills/list",
                "params": {}
              },
              {
                "method": "resources/read",
                "params": {
                  "uri": "skill://guide/SKILL.md"
                }
              }
            ]
          }
        }
      }
    }
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "block",
        "trigger": "on_tool_call",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "block",
              "reason": "no skills here"
            }
          }
        ]
      }
    ]
  },
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "activate",
              "name": "activate_skill",
              "content": "{\"error\": \"no skills here\"}",
              "is_error": true
            }
          ]
        },
        {
          "system_prompt": {
            "$lacks": "# Active skills served by MCP servers (their servers' content)"
          }
        }
      ]
    }
  }
}
