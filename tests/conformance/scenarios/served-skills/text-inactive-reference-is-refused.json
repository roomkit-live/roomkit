{
  "$schema": "../../scenario.schema.json",
  "id": "served-skills/text-inactive-reference-is-refused",
  "title": "An inactive served reference performs no resource read",
  "rules": [
    "§24.7"
  ],
  "requirements": [
    "RK-24.7-018"
  ],
  "steps": [
    {
      "call": "skill_registry_session",
      "servers": {
        "remote": {
          "replies": [
            {
              "method": "skills/list",
              "params": {},
              "result": {
                "skills": [
                  {
                    "uri": "skill://guide/SKILL.md",
                    "frontmatter": {
                      "name": "guide",
                      "description": "Read the guide"
                    },
                    "resources": [
                      {
                        "uri": "skill://guide/SKILL.md",
                        "digest": "sha256:a0f5cbce5cfdb05a47d0b6a147ed4215f0da111e5d132c63d7b6697af919fb6c",
                        "size": 67
                      },
                      {
                        "uri": "skill://guide/notes.txt",
                        "digest": "sha256:38732073f309589131fec63f417896537e63d27fc29fcf7c60d5f47379f0887a",
                        "size": 6
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      "operations": [
        {
          "method": "add_mcp_server",
          "server": "remote",
          "label": "docs"
        },
        {
          "method": "install_channel",
          "channel": {
            "id": "agent",
            "type": "ai",
            "model": {
              "rounds": [
                {
                  "calls": [
                    {
                      "id": "read",
                      "name": "read_skill_reference",
                      "arguments": {
                        "skill_name": "docs:guide",
                        "filename": "notes.txt"
                      }
                    }
                  ]
                },
                {
                  "text": "done"
                }
              ]
            }
          }
        },
        {
          "method": "room_call",
          "action": {
            "call": "attach_channel",
            "room_id": "room-1",
            "channel_id": "agent",
            "category": "intelligence"
          }
        },
        {
          "method": "room_call",
          "action": {
            "call": "process_inbound",
            "room_id": "room-1",
            "message": {
              "channel_id": "ws",
              "sender_id": "ada",
              "content": {
                "type": "text",
                "body": "Hello"
              }
            }
          }
        }
      ],
      "expect": {
        "result": {
          "results": [
            {
              "status": "ok"
            },
            {
              "status": "ok"
            },
            {
              "status": "ok"
            },
            {
              "status": "ok"
            }
          ],
          "requests": {
            "remote": [
              {
                "method": "skills/list",
                "params": {}
              }
            ]
          }
        }
      }
    }
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "read",
              "name": "read_skill_reference",
              "content": "{\"error\": \"Skill 'docs:guide' is not active: activate it before reading its files\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
