{
  "$schema": "../../scenario.schema.json",
  "id": "served-skills/an-entry-read-again-that-is-malformed-leaves-the-entry-held-before",
  "title": "An entry read again that is malformed leaves the entry held before, as a server that does not answer does: the skill stays available and its next activation reads it again",
  "rules": [
    "§24.7"
  ],
  "requirements": [
    "RK-24.7-051"
  ],
  "steps": [
    {
      "call": "skill_registry_session",
      "servers": {
        "remote": {
          "replies": [
            {
              "method": "skills/list",
              "params": {},
              "result": {
                "skills": [
                  {
                    "uri": "skill://guide/SKILL.md",
                    "frontmatter": {
                      "name": "guide",
                      "description": "Read the guide"
                    },
                    "resources": [
                      {
                        "uri": "skill://guide/SKILL.md",
                        "digest": "sha256:a0f5cbce5cfdb05a47d0b6a147ed4215f0da111e5d132c63d7b6697af919fb6c",
                        "size": 67
                      }
                    ]
                  }
                ]
              }
            },
            {
              "method": "resources/read",
              "params": {
                "uri": "skill://guide/SKILL.md"
              },
              "result": {
                "contents": [
                  {
                    "uri": "skill://guide/SKILL.md",
                    "text": "---\nname: guide\ndescription: Read the guide\n---\n\nFollow the steps.\nx"
                  }
                ]
              }
            },
            {
              "method": "skills/get",
              "params": {
