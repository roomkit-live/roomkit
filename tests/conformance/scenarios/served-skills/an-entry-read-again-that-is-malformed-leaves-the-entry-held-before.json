                    }
                  ]
                }
              }
            },
            {
              "method": "resources/read",
              "params": {
                "uri": "skill://guide/SKILL.md"
              },
              "result": {
                "contents": [
                  {
                    "uri": "skill://guide/SKILL.md",
                    "text": "---\nname: guide\ndescription: Read the guide\n---\n\nFollow the steps.\nx"
                  }
                ]
              }
            },
            {
              "method": "skills/get",
              "params": {
                "uri": "skill://guide/SKILL.md"
