              "result": {
                "skill": {
                  "uri": "skill://guide/SKILL.md",
                  "frontmatter": {
                    "name": "other",
                    "description": "Read the guide"
                  },
                  "resources": [
                    {
                      "uri": "skill://guide/SKILL.md",
                      "digest": "sha256:6fcaa413b7edda2156378747fb4109fe50b92bb9dc6fd5c681bc77833d1b00d6",
                      "size": 68
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "operations": [
        {
          "method": "add_mcp_server",
          "server": "remote",
          "label": "docs"
        },
        {
          "method": "load_skill",
          "name": "docs:guide"
        },
        {
          "method": "load_skill",
          "name": "docs:guide"
        },
        {
