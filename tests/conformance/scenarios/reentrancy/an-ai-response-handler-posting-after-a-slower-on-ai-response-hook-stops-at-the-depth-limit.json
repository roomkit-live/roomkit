      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "background": true,
      "as": "inbound"
    },
    {
      "wait_for": "audit"
    },
