            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "a",
        "trigger": "after_broadcast",
        "execution": "async",
        "reactions": [
          {
            "when": {
              "text": "go"
            },
            "spawn": {
              "gate": "during",
              "do": [
                {
                  "call": "send_event",
                  "room_id": "$room",
                  "channel_id": "ws",
                  "content": {
                    "type": "text",
                    "body": "during"
                  },
                  "as": "during"
                }
              ],
              "after_do_gate": "during-sent"
            },
            "gate": "a-body",
            "do": [
              {
                "call": "send_event",
                "room_id": "$room",
                "channel_id": "ws",
                "content": {
                  "type": "text",
                  "body": "awaited"
                },
                "own_task": true,
                "as": "awaited"
              }
            ]
          }
        ]
      },
      {
        "name": "b",
        "trigger": "after_broadcast",
        "execution": "async",
        "timeout_ms": 300,
        "reactions": [
          {
            "when": {
