{
  "$schema": "../../scenario.schema.json",
  "id": "reentrancy/a-locked-hook-s-task-calling-once-its-body-returned-is-a-new-arrival",
  "title": "A task a locked hook's body started, calling once the body returned, is a new arrival: it waits for the lock the event's section still holds and commits after the event",
  "rules": [
    "§9.5.1 Reentrance",
    "§13.5"
  ],
  "requirements": [
    "RK-13.5-019",
    "RK-9.5.1-020",
    "RK-9.5.1-040"
  ],
  "reentrancy": [
    "inject@outside"
  ],
  "notes": "The first hook's body starts the task and returns; the section's next hook holds the lock at its gate when the task calls. Python: tests/test_reentrance.py::TestACallFromATaskALockedHookStarted::test_once_the_hook_is_over_its_call_is_a_new_arrival[locked].",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "notifier",
        "trigger": "before_broadcast",
        "priority": 0,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "spawn": {
              "gate": "task_go",
              "do": [
                {
                  "call": "send_event",
                  "room_id": "$room",
                  "channel_id": "ws",
                  "content": {
                    "type": "text",
                    "body": "heads up"
                  },
                  "as": "notice"
                }
              ]
            }
          }
        ]
      },
      {
        "name": "next",
        "trigger": "before_broadcast",
        "priority": 1,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "gate": "next_held"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "background": true,
      "as": "hello"
    },
    {
      "wait_for": "next_held"
    },
    {
      "open": "task_go"
    },
    {
      "wait_for_lock": "room-1"
    },
    {
      "open": "next_held"
    },
    {
      "await": "hello",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "index": 0
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "hello"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "heads up"
          }
        }
      ]
    },
    "actions": {
      "notice": [
        {
          "result": {
            "id": "room-1#1"
          }
        }
      ]
    }
  }
}
