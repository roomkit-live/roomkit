{
  "$schema": "../../scenario.schema.json",
  "id": "reentrancy/an-ai-response-handler-sends-as-deep-as-the-turn",
  "title": "A handler of ai_response that sends into the turn's room once the turn is over sends at least as deep as the turn's response, the depth it keeps while it runs",
  "rules": [
    "§8.2",
    "§8.3",
    "§10.6.3"
  ],
  "notes": "The handler holds at 'handler' until the inbound call has returned, its turn over, then sends as the agent, which answers none of its own events. Python: the owner publishes the turn's framework events, during the turn (turns/_owner_publish.py) and after it (turns/_owner_between.py), within its response depth, which core/_kit_wiring.py KitEvents lends each handler while it runs; roomkit-rs: the turn's host emits them with its response depth, which Handlers::emit_at lends each handler. Before RMK-1699 both implementations stored it at depth 0.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "text": "answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "event_handlers": [
      {
        "event": "ai_response",
        "reactions": [
          {
            "gate": "handler",
            "do": [
              {
                "call": "send_event",
                "room_id": "$room",
                "channel_id": "ai",
                "content": {
                  "type": "text",
                  "body": "from the handler"
                },
                "as": "sent"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "background": true,
      "as": "inbound"
    },
    {
      "wait_for": "handler"
    },
    {
      "await": "inbound",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "id": "room-1#0"
          }
        }
      }
    },
    {
      "open": "handler"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": {
        "$unordered": [
          {
            "type": "message",
            "content": {
              "type": "text",
              "body": "go"
            },
            "chain_depth": 0
          },
          {
            "type": "message",
            "source": {
              "channel_id": "ai"
            },
            "content": {
              "type": "text",
              "body": "from the handler"
            },
            "chain_depth": 1
          },
          {
            "type": "message",
            "responds_to": "room-1#0",
            "source": {
              "channel_id": "ai"
            },
            "content": {
              "type": "text",
              "body": "answer"
            },
            "chain_depth": 1
          }
        ]
      }
    },
    "actions": {
      "sent": [
        {
          "result": {
            "room_id": "room-1",
            "content": {
              "type": "text",
              "body": "from the handler"
            }
          }
        }
      ]
    }
  }
}
