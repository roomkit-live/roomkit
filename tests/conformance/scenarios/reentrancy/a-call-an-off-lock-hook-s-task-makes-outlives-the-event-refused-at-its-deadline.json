{
  "$schema": "../../scenario.schema.json",
  "id": "reentrancy/a-call-an-off-lock-hook-s-task-makes-outlives-the-event-refused-at-its-deadline",
  "title": "A call a task of an off-lock hook makes, adopted beside the check, outlives the event: the event is refused at its process_timeout while the call holds the room's lock it waits for, and the call commits within its own",
  "rules": [
    "§9.5.1 Reentrance",
    "§13.6"
  ],
  "requirements": [
    "RK-13.6-007",
    "RK-13.6-008",
    "RK-9.5.1-039"
  ],
  "reentrancy": [
    "inject@admitted"
  ],
  "notes": "process_timeout is 2 s. The off-lock hook's body starts the task and holds; 1 s in, the task sends, adopted beside the check, and a locked hook holds that call at its gate, under the room's lock. The body then returns and the event waits for that lock until its deadline. The call's own deadline runs from its start, a second after the event's: opened once the event is refused, it commits. A call that was a new arrival instead would wait for the event's ticket, reach its gate only once the event is refused, and leave no one waiting for the lock. Python: tests/test_reentrance.py::TestAnAdoptedCallBeforeItsCommit::test_a_call_a_hook_s_task_makes_keeps_its_own_deadline, test_a_lock_request_held_back_past_the_deadline_is_given_up_on.",
  "setup": {
    "kit": {
      "process_timeout_ms": 2000
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "notifier",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "timeout_ms": 5000,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "spawn": {
              "delay_ms": 1000,
              "do": [
                {
                  "call": "send_event",
                  "room_id": "$room",
                  "channel_id": "ws",
                  "content": {
                    "type": "text",
                    "body": "heads up"
                  },
                  "as": "notice"
                }
              ]
            },
            "gate": "body_held"
          }
        ]
      },
      {
        "name": "slow",
        "trigger": "before_broadcast",
        "timeout_ms": 5000,
        "reactions": [
          {
            "when": {
              "text": "heads up"
            },
            "gate": "slow_held"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "background": true,
      "as": "hello"
    },
    {
      "wait_for": "slow_held"
    },
    {
      "open": "body_held"
    },
    {
      "wait_for_lock": "room-1"
    },
    {
      "await": "hello",
      "expect": {
        "result": {
          "blocked": true,
          "reason": "process_timeout",
          "event": null
        }
      }
    },
    {
      "open": "slow_held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "heads up"
          }
        }
      ]
    },
    "actions": {
      "notice": [
        {
          "result": {
            "id": "room-1#0"
          }
        }
      ]
    }
  }
}
