{
  "$schema": "../../scenario.schema.json",
  "id": "reentrancy/an-on-ai-response-hook-posting-after-each-answer-stops-at-the-depth-limit",
  "title": "An ASYNC ON_AI_RESPONSE hook that posts into the room after each answer ends at the depth limit, its body as deep as the turn that fired it, the turn over or not",
  "rules": [
    "§8.3",
    "§9.2"
  ],
  "requirements": [
    "RK-9.5.1-054"
  ],
  "notes": "The first post waits at 'first' until the inbound call has returned, its turn over; the next are made as each answer comes. Each post is at least as deep as the answer that fired it, so the agent answers one deeper each time and is not asked at the limit. Python: tests/test_reentrance.py::TestACallFromAnAsyncHook::test_a_hook_telling_the_agent_again_from_its_body_ends_at_the_depth_limit. The same code as a framework-event handler: reentrancy/an-ai-response-handler-posting-after-each-answer-stops-at-the-depth-limit.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "again",
        "trigger": "on_ai_response",
        "execution": "async",
        "reactions": [
          {
            "gate": "first",
            "do": [
              {
                "call": "send_event",
                "room_id": "$room",
                "channel_id": "sms",
                "content": {
                  "type": "text",
                  "body": "again"
                },
                "as": "again"
              }
            ]
          },
          {
            "repeat": true,
            "do": [
              {
                "call": "send_event",
                "room_id": "$room",
                "channel_id": "sms",
                "content": {
                  "type": "text",
                  "body": "again"
                },
                "as": "again"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "background": true,
      "as": "inbound"
    },
    {
      "wait_for": "first"
    },
    {
      "await": "inbound",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "id": "room-1#0"
          }
        }
      }
    },
    {
      "open": "first"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": {
        "$unordered": [
          {
            "type": "message",
            "content": {
              "type": "text",
              "body": "go"
            },
            "chain_depth": 0
          },
          {
            "type": "message",
            "source": {
              "channel_id": "ai"
            },
            "content": {
              "type": "text",
              "body": "answer"
            },
            "chain_depth": 1
          },
          {
            "type": "message",
            "source": {
              "channel_id": "sms"
            },
            "content": {
              "type": "text",
              "body": "again"
            },
            "chain_depth": 1
          },
          {
            "type": "message",
            "source": {
              "channel_id": "ai"
            },
            "content": {
              "type": "text",
              "body": "answer"
            },
            "chain_depth": 2
          },
          {
            "type": "message",
            "source": {
              "channel_id": "sms"
            },
            "content": {
              "type": "text",
              "body": "again"
            },
            "chain_depth": 2
          },
          {
            "type": "message",
            "source": {
              "channel_id": "ai"
            },
            "content": {
              "type": "text",
              "body": "answer"
            },
            "chain_depth": 3
          },
          {
            "type": "message",
            "source": {
              "channel_id": "sms"
            },
            "content": {
              "type": "text",
              "body": "again"
            },
            "chain_depth": 3
          },
          {
            "type": "message",
            "source": {
              "channel_id": "ai"
            },
            "content": {
              "type": "text",
              "body": "answer"
            },
            "chain_depth": 4
          },
          {
            "type": "message",
            "source": {
              "channel_id": "sms"
            },
            "content": {
              "type": "text",
              "body": "again"
            },
            "chain_depth": 4
          },
          {
            "source": {
              "channel_id": "ai"
            },
            "chain_depth": 5,
            "status": "blocked",
            "blocked_by": "event_chain_depth_limit"
          }
        ]
      }
    }
  }
}
