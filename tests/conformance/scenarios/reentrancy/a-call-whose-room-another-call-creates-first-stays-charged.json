{
  "$schema": "../../scenario.schema.json",
  "id": "reentrancy/a-call-whose-room-another-call-creates-first-stays-charged",
  "title": "A delivery's call naming a room step 2 reads absent, which another call creates first, stays charged and goes into that room as into one that exists, on a budget of its own there",
  "rules": [
    "§9.5.1",
    "§10.1 step 2"
  ],
  "requirements": [
    "RK-9.5.1-050"
  ],
  "notes": "room-1's delivery to loop sends x naming room-new, which the store does not hold: step 2 reads it absent (room_exists or load_room_context, held after it answered), then the steps create room-new and bind inner to it. The call stays charged: room-1's cascade spends its budget with x and nine more, the tenth refused. In room-new, x's cascade has a budget of its own: each of its deliveries to inner sends another y there, ten committed, the eleventh refused.",
  "setup": {
    "kit": {
      "max_chain_depth": 1,
      "store_faults": true
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "loop",
        "type": "websocket",
        "category": "transport",
        "deliver": [
          {
            "when": {
              "text": "hello"
            },
            "do": [
              {
                "call": "process_inbound",
                "room_id": "room-new",
                "message": {
                  "channel_id": "sms",
                  "sender_id": "u",
                  "content": {
                    "type": "text",
                    "body": "x"
                  }
                },
                "as": "named",
                "expect": {
                  "result": {
                    "blocked": false,
                    "event": {
                      "room_id": "room-new"
                    }
                  }
                }
              },
              {
                "call": "process_inbound",
                "room_id": "room-1",
                "message": {
                  "channel_id": "sms",
                  "sender_id": "u",
                  "content": {
                    "type": "text",
                    "body": "again"
                  }
                },
                "as": "loop"
              }
            ]
          },
          {
            "when": {
              "text": "again"
            },
            "repeat": true,
            "do": [
              {
                "call": "process_inbound",
                "room_id": "room-1",
                "message": {
                  "channel_id": "sms",
                  "sender_id": "u",
                  "content": {
                    "type": "text",
                    "body": "again"
                  }
                },
                "as": "loop"
              }
            ]
          }
        ]
      },
      {
        "id": "inner",
        "type": "websocket",
        "category": "transport",
        "deliver": [
          {
            "repeat": true,
            "do": [
              {
                "call": "process_inbound",
                "room_id": "$room",
                "message": {
                  "channel_id": "sms",
                  "sender_id": "u",
                  "content": {
                    "type": "text",
                    "body": "y"
                  }
                },
                "as": "inner"
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "loop"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "store_fault": [
        "room_exists",
        "load_room_context"
      ],
      "room_id": "room-new",
      "gate": "read"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "background": true,
      "as": "hello"
    },
    {
      "wait_for": "read"
    },
    {
      "call": "create_room",
      "room": {
        "id": "room-new"
      }
    },
    {
      "call": "attach_channel",
      "room_id": "room-new",
      "channel_id": "inner"
    },
    {
      "open": "read"
    },
    {
      "await": "hello",
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "actions": {
      "named": [
        {
          "result": {
            "blocked": false,
            "event": {
              "room_id": "room-new"
            }
          }
        }
      ],
      "loop": [
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": true,
            "reason": "reentry_loop_cap",
            "event": null
          }
        }
      ],
      "inner": [
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": false
          }
        },
        {
          "result": {
            "blocked": true,
            "reason": "reentry_loop_cap",
            "event": null
          }
        }
      ]
    },
    "rooms": {
      "$created": {
        "$unordered": []
      }
    }
  }
}
