{
  "$schema": "../../scenario.schema.json",
  "id": "reentrancy/an-ai-response-handler-posting-after-each-answer-stops-at-the-depth-limit",
  "title": "A handler of ai_response that posts into the room after each answer ends at the depth limit, as an ASYNC ON_AI_RESPONSE hook doing the same does",
  "rules": [
    "§8.2",
    "§8.3",
    "§10.6.3"
  ],
  "notes": "The first post waits at 'first' until the inbound call has returned, its turn over; the next are made as each answer comes. Each post is at least as deep as the answer that fired it, so the agent answers one deeper each time and is not asked at the limit. Python: the owner publishes the turn's framework events, during the turn (turns/_owner_publish.py) and after it (turns/_owner_between.py), within its response depth, which core/_kit_wiring.py KitEvents lends each handler while it runs; roomkit-rs: the turn's host emits them with its response depth, which Handlers::emit_at lends each handler. tests/test_reentrance.py::TestACallFromAnAsyncHook::test_a_framework_event_handler_telling_the_agent_again_ends_at_the_depth_limit. The same code as a hook: reentrancy/an-on-ai-response-hook-posting-after-each-answer-stops-at-the-depth-limit. Before RMK-1699 both implementations looped without end: the posts at depth 0, the answers at 1, 8 answers for 8 rounds, nothing blocked.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            },
            {
              "text": "answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "event_handlers": [
      {
        "event": "ai_response",
        "reactions": [
          {
            "gate": "first",
            "do": [
              {
                "call": "send_event",
                "room_id": "$room",
                "channel_id": "sms",
                "content": {
                  "type": "text",
                  "body": "again"
                },
                "as": "again"
              }
            ]
          },
          {
            "repeat": true,
            "do": [
              {
                "call": "send_event",
                "room_id": "$room",
                "channel_id": "sms",
                "content": {
                  "type": "text",
                  "body": "again"
                },
                "as": "again"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "background": true,
      "as": "inbound"
    },
    {
      "wait_for": "first"
    },
    {
      "await": "inbound",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "id": "room-1#0"
          }
        }
      }
    },
    {
      "open": "first"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": {
        "$unordered": [
          {
            "type": "message",
            "content": {
              "type": "text",
              "body": "go"
            },
            "chain_depth": 0
          },
          {
            "type": "message",
            "source": {
              "channel_id": "ai"
            },
            "content": {
              "type": "text",
              "body": "answer"
            },
            "chain_depth": 1
          },
          {
            "type": "message",
            "source": {
              "channel_id": "sms"
            },
            "content": {
              "type": "text",
              "body": "again"
            },
            "chain_depth": 1
          },
          {
            "type": "message",
            "source": {
              "channel_id": "ai"
            },
            "content": {
              "type": "text",
              "body": "answer"
            },
            "chain_depth": 2
          },
          {
            "type": "message",
            "source": {
              "channel_id": "sms"
            },
            "content": {
              "type": "text",
              "body": "again"
            },
            "chain_depth": 2
          },
          {
            "type": "message",
            "source": {
              "channel_id": "ai"
            },
            "content": {
              "type": "text",
              "body": "answer"
            },
            "chain_depth": 3
          },
          {
            "type": "message",
            "source": {
              "channel_id": "sms"
            },
            "content": {
              "type": "text",
              "body": "again"
            },
            "chain_depth": 3
          },
          {
            "type": "message",
            "source": {
              "channel_id": "ai"
            },
            "content": {
              "type": "text",
              "body": "answer"
            },
            "chain_depth": 4
          },
          {
            "type": "message",
            "source": {
              "channel_id": "sms"
            },
            "content": {
              "type": "text",
              "body": "again"
            },
            "chain_depth": 4
          },
          {
            "source": {
              "channel_id": "ai"
            },
            "chain_depth": 5,
            "status": "blocked",
            "blocked_by": "event_chain_depth_limit"
          }
        ]
      }
    }
  }
}
