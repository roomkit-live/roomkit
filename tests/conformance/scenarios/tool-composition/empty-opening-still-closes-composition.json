{
  "$schema": "../../scenario.schema.json",
  "id": "tool-composition/empty-opening-still-closes-composition",
  "title": "An opening fragment with no argument characters still publishes and closes",
  "rules": [
    "§6.4",
    "§8.4"
  ],
  "notes": "Python: tests/test_ai_streaming_tool_events.py (composition, coalescing and attempt closure); tests/test_ai_stream_contract.py (stream lifecycle). Fragments drive the real channel through process_inbound; tool_events are read from the room realtime subscription. No real provider or external executor is involved.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "stream": [
                {
                  "tool_call_delta": {
                    "id": "c1",
                    "name": "lookup",
                    "index": 0,
                    "arguments_delta": ""
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look a record up.",
            "parameters": {
              "type": "object",
              "properties": {
                "q": {
                  "type": "string"
                }
              }
            },
            "returns": "{\"found\": 1}"
          }
        ],
        "thinking_coalesce_ms": 0
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look it up."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "tool_events": {
      "room-1": [
        {
          "type": "tool_call_delta",
          "tool_calls": [
            {
              "id": "$e1",
              "name": "lookup",
              "arguments_chars": 0,
              "arguments": {
                "$absent": true
              },
              "arguments_delta": {
                "$absent": true
              }
            }
          ],
          "round": 0,
          "channel_id": "agent"
        },
        {
          "type": "tool_call_delta",
          "tool_calls": [],
          "round": 0,
          "channel_id": "agent"
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "type": "message"
        }
      ]
    }
  }
}
