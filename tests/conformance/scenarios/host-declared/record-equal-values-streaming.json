{
  "$schema": "../../scenario.schema.json",
  "id": "host-declared/record-equal-values-streaming",
  "title": "A callback reply carries no changes for values equal to its original record",
  "rules": [
    "§10.6.5",
    "§21.4"
  ],
  "notes": "Python: tests/test_turns_host.py declared-verb tests; core/_turn_host.py; turns/_owner_calls.py and _call_record.py. The callbacks use public tool-context accessors and calls use current_turn_host().call().",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": false,
        "tools": [
          {
            "name": "lookup",
            "host_calls": {
              "calls": [
                {
                  "verb": "app.equal"
                }
              ],
              "record_keys": [
                "zero",
                "one",
                "nested"
              ]
            },
            "writes_record": {
              "zero": 0,
              "one": 1,
              "nested": {
                "enabled": true,
                "count": 2
              }
            }
          }
        ],
        "model": {
          "streaming": true,
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "declare_host_verb",
      "name": "app.equal",
      "handler": {
        "returns": null,
        "writes_record": {
          "zero": false,
          "one": 1.0,
          "nested": {
            "enabled": 1,
            "count": 2.0
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "response_metadata": {
            "zero": 0,
            "one": 1,
            "nested": {
              "count": 2,
              "enabled": true
            }
          }
        }
      }
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"calls\": [{\"error\": null, \"result\": null}], \"record\": {\"nested\": {\"count\": 2, \"enabled\": true}, \"one\": 1, \"zero\": 0}}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
