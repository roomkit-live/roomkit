{
  "$schema": "../../scenario.schema.json",
  "id": "host-declared/record-return-non-streaming",
  "title": "The owner reads a carried record and its successful reply merges writes and removals before returning",
  "rules": [
    "§10.6.5",
    "§21.4"
  ],
  "requirements": [
    "RK-10.6.5-028",
    "RK-10.6.5-044",
    "RK-10.6.5-045",
    "RK-10.6.5-046",
    "RK-10.6.5-047"
  ],
  "notes": "Python: tests/test_turns_host.py declared-verb tests; core/_turn_host.py; turns/_owner_calls.py and _call_record.py. The callbacks use public tool-context accessors and calls use current_turn_host().call().",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": false,
        "tools": [
          {
            "name": "lookup",
            "host_calls": {
              "calls": [
                {
                  "verb": "app.record"
                }
              ],
              "record_keys": [
                "asked",
                "answered",
                "stale"
              ]
            },
            "writes_record": {
              "asked": "boards",
              "stale": true
            }
          }
        ],
        "model": {
          "streaming": false,
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "declare_host_verb",
      "name": "app.record",
      "handler": {
        "returns": "recorded",
        "as": "served",
        "record_keys": [
          "asked",
          "stale"
        ],
        "writes_record": {
          "answered": "read boards"
        },
        "removes_record": [
          "stale"
        ]
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "response_metadata": {
            "asked": "boards",
            "answered": "read boards",
            "stale": {
              "$absent": true
            }
          }
        }
      }
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"calls\": [{\"error\": null, \"result\": \"recorded\"}], \"record\": {\"answered\": \"read boards\", \"asked\": \"boards\"}}",
              "is_error": false
            }
          ]
        }
      ]
    },
    "actions": {
      "served": [
        {
          "result": {
            "record": {
              "asked": "boards",
              "stale": true
            }
          }
        }
      ]
    }
  }
}
