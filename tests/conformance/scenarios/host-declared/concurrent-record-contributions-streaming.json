{
  "$schema": "../../scenario.schema.json",
  "id": "host-declared/concurrent-record-contributions-streaming",
  "title": "Two owner callbacks preserve an unchanged entry and both contributions while removing a carried key",
  "rules": [
    "§10.6.5",
    "§21.4"
  ],
  "requirements": [
    "RK-10.6.5-028",
    "RK-10.6.5-046",
    "RK-10.6.5-047",
    "RK-10.6.5-048",
    "RK-10.6.5-050"
  ],
  "notes": "Python: tests/test_turns_host.py declared-verb tests; core/_turn_host.py; turns/_owner_calls.py and _call_record.py. The callbacks use public tool-context accessors and calls use current_turn_host().call().",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": false,
        "tools": [
          {
            "name": "lookup",
            "host_calls": {
              "calls": [
                {
                  "verb": "app.first",
                  "returned": "first-returned"
                },
                {
                  "verb": "app.last"
                }
              ],
              "concurrent": true,
              "record_keys": [
                "names",
                "stale"
              ]
            },
            "writes_record": {
              "names": {
                "a": 1
              },
              "stale": true
            }
          }
        ],
        "model": {
          "streaming": true,
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "declare_host_verb",
      "name": "app.first",
      "handler": {
        "returns": null,
        "gate": "first",
        "updates_record": {
          "names": {
            "b": 1
          }
        }
      }
    },
    {
      "call": "declare_host_verb",
      "name": "app.last",
      "handler": {
        "returns": null,
        "gate": "last",
        "updates_record": {
          "names": {
            "c": 1
          }
        },
        "removes_record": [
          "stale"
        ]
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "first"
    },
    {
      "wait_for": "last"
    },
    {
      "open": "first"
    },
    {
      "wait_for": "first-returned"
    },
    {
      "open": "last"
    },
    {
      "await": "turn",
      "expect": {
        "result": {
          "response_metadata": {
            "names": {
              "a": 1,
              "b": 1,
              "c": 1
            },
            "stale": {
              "$absent": true
            }
          }
        }
      }
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"calls\": [{\"error\": null, \"result\": null}, {\"error\": null, \"result\": null}], \"record\": {\"names\": {\"a\": 1, \"b\": 1, \"c\": 1}}}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
