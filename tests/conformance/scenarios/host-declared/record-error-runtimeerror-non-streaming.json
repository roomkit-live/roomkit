{
  "$schema": "../../scenario.schema.json",
  "id": "host-declared/record-error-runtimeerror-non-streaming",
  "title": "A failed declared callback preserves its error kind and message and still merges its record writes",
  "rules": [
    "§10.6.5",
    "§21.4"
  ],
  "requirements": [
    "RK-10.6.5-028",
    "RK-10.6.5-046",
    "RK-10.6.8-043",
    "RK-10.6.8-044",
    "RK-21.4-026",
    "RK-6.4-397"
  ],
  "notes": "Python: tests/test_turns_host.py declared-verb tests; core/_turn_host.py; turns/_owner_calls.py and _call_record.py. The callbacks use public tool-context accessors and calls use current_turn_host().call().",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": false,
        "tools": [
          {
            "name": "lookup",
            "host_calls": {
              "calls": [
                {
                  "verb": "app.refuse"
                }
              ],
              "record_keys": [
                "refused"
              ]
            }
          }
        ],
        "model": {
          "streaming": false,
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "declare_host_verb",
      "name": "app.refuse",
      "handler": {
        "raises": {
          "kind": "RuntimeError",
          "message": "not this member"
        },
        "writes_record": {
          "refused": true
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "response_metadata": {
            "refused": true
          }
        }
      }
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"calls\": [{\"error\": {\"kind\": \"builtins:RuntimeError\", \"message\": \"not this member\"}, \"result\": null}], \"record\": {\"refused\": true}}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
