{
  "$schema": "../../scenario.schema.json",
  "id": "host-declared/arguments-and-results-non-streaming",
  "title": "Declared calls preserve JSON data and default absent or null arguments to an empty object",
  "rules": [
    "§10.6.5",
    "§21.4"
  ],
  "requirements": [
    "RK-10.6.5-028",
    "RK-6.4-397",
    "RK-6.7-111"
  ],
  "notes": "Python: tests/test_turns_host.py declared-verb tests; core/_turn_host.py; turns/_owner_calls.py and _call_record.py. The callbacks use public tool-context accessors and calls use current_turn_host().call().",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": false,
        "tools": [
          {
            "name": "lookup",
            "host_calls": {
              "calls": [
                {
                  "verb": "app.echo"
                },
                {
                  "verb": "app.echo",
                  "arguments": null
                },
                {
                  "verb": "app.echo",
                  "arguments": {
                    "n": 2,
                    "list": [
                      true,
                      null,
                      {
                        "name": "café"
                      }
                    ]
                  }
                }
              ]
            }
          }
        ],
        "model": {
          "streaming": false,
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "declare_host_verb",
      "name": "app.echo",
      "handler": {
        "returns_arguments": true
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      }
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"calls\": [{\"error\": null, \"result\": {}}, {\"error\": null, \"result\": {}}, {\"error\": null, \"result\": {\"list\": [true, null, {\"name\": \"café\"}], \"n\": 2}}], \"record\": {}}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
