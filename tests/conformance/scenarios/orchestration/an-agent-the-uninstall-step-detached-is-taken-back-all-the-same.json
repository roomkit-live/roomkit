{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/an-agent-the-uninstall-step-detached-is-taken-back-all-the-same",
  "title": "An agent the install attached and the strategy's own uninstall step detached is gone: the uninstall finishes and the room is free",
  "rules": [
    "§19.7"
  ],
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket"
      },
      {
        "id": "sales",
        "type": "ai"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "tidy",
        "agents": [
          "sales"
        ],
        "uninstall": {
          "do": [
            {
              "call": "detach_channel",
              "room_id": "$room",
              "channel_id": "sales"
            }
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "tidy"
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "room_strategy",
      "room_id": "r1",
      "expect": {
        "result": null
      }
    }
  ],
  "expect": {
    "bindings": {
      "r1": {
        "sales": null,
        "ops": {
          "$present": true
        }
      }
    }
  }
}
