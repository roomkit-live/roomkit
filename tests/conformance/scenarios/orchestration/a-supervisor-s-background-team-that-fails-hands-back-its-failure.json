{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-supervisor-s-background-team-that-fails-hands-back-its-failure",
  "title": "A background team whose run raises (its worker no longer registered) hands the supervisor that the work could not be completed, without the error's message, and the run's terminal entry is failed with it",
  "rules": [
    "§19.7.3",
    "§23.3",
    "§9.3"
  ],
  "notes": "Python: tests/tasks/test_delegation_result_delivery.py::test_a_supervisor_s_failed_background_workers_hand_back_their_failure; orchestration/_background.py _work (the run raised: posted failed with its message) and background_failure_text; core/_fallback.py FALLBACK_FAILED.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {
          "role": "Coordinator"
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_workers",
                  "arguments": {
                    "task": "Find the facts."
                  }
                }
              ]
            },
            {
              "text": "On it."
            },
            {
              "text": "Sorry, it failed."
            }
          ]
        }
      },
      {
        "id": "researcher",
        "type": "ai",
        "agent": {
          "role": "Researcher"
        },
        "model": {
          "rounds": [
            {
              "text": "Never."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "researcher"
          ],
          "strategy": "parallel",
          "async_delivery": true
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "team"
    },
    {
      "call": "unregister_channel",
      "channel_id": "researcher"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Find it."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "status.recent",
      "agent_id": "orchestration",
      "expect": {
        "result": [
          {
            "action": "pipeline",
            "status": "failed",
            "detail": {
              "$contains": "researcher"
            },
            "metadata": {
              "room_id": "r1",
              "strategy": "parallel",
              "workers": [
                "researcher"
              ]
            }
          }
        ]
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "type": "text",
            "body": "Find it."
          }
        },
        {
          "type": "tool_call_start"
        },
        {
          "type": "tool_call_end",
          "content": {
            "type": "tool_call",
            "result": "{\"status\": \"dispatched\", \"workers\": [\"researcher\"], \"message\": \"Workers are running in the background. Their combined results will be handed to you when they are done.\"}"
          }
        },
        {
          "source": {
            "channel_id": "sup"
          },
          "content": {
            "type": "text",
            "body": "On it."
          },
          "chain_depth": 1
        },
        {
          "type": "instruction_read",
          "source": {
            "channel_id": "sup"
          },
          "visibility": "sup",
          "content": {
            "body": {
              "$contains": "[Your background workers failed: The delegated work could not be completed. Tell the user.]"
            }
          }
        },
        {
          "source": {
            "channel_id": "sup"
          },
          "content": {
            "type": "text",
            "body": "Sorry, it failed."
          },
          "chain_depth": 2
        }
      ]
    }
  }
}
