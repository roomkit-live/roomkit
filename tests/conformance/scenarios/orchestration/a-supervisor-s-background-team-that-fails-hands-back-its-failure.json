{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-supervisor-s-background-team-that-fails-hands-back-its-failure",
  "title": "A background team whose run raises (its worker no longer registered) hands the supervisor that the work could not be completed, without the error's message, and the run's terminal entry is failed with it",
  "rules": [
    "§19.7.3",
    "§23.3",
    "§9.3"
  ],
  "notes": "Python: tests/tasks/test_delegation_result_delivery.py::test_a_supervisor_s_failed_background_workers_hand_back_their_failure; orchestration/_background.py _work (the run raised: posted failed with its message) and background_failure_text; core/_fallback.py FALLBACK_FAILED. The failure hand-back is held at BEFORE_DELIVER until the original call has returned its acknowledgement: the background run and that answer otherwise race. This pins the scenario's schedule without requiring an order between independent turns.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {
          "role": "Coordinator"
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_workers",
                  "arguments": {
                    "task": "Find the facts."
                  }
                }
              ]
            },
            {
              "text": "On it."
            },
            {
              "text": "Sorry, it failed."
            }
          ]
        }
      },
      {
        "id": "researcher",
        "type": "ai",
        "agent": {
          "role": "Researcher"
        },
        "model": {
          "rounds": [
            {
              "text": "Never."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "researcher"
          ],
          "strategy": "parallel",
          "async_delivery": true
        }
      }
    ],
    "hooks": [
      {
        "name": "hold-hand-back",
        "trigger": "before_deliver",
        "reactions": [
          {
            "gate": "hand-back",
            "result": {
              "action": "allow"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "team"
    },
    {
      "call": "unregister_channel",
      "channel_id": "researcher"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Find it."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null,
          "response_events": [
            {
              "type": "tool_call_start"
            },
            {
              "type": "tool_call_end"
            },
            {
              "content": {
                "type": "text",
                "body": "On it."
              },
              "chain_depth": 1
            }
          ]
        }
      }
    },
    {
      "wait_for": "hand-back"
    },
    {
      "open": "hand-back"
    },
    {
      "idle": true
    },
    {
      "call": "status.recent",
      "agent_id": "orchestration",
      "expect": {
        "result": [
          {
            "action": "pipeline",
            "status": "failed",
            "detail": {
              "$contains": "not registered"
            },
            "metadata": {
              "room_id": "r1",
              "strategy": "parallel",
              "workers": [
                "researcher"
              ]
            }
          }
        ]
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "type": "text",
            "body": "Find it."
          }
        },
        {
          "type": "tool_call_start"
        },
        {
          "type": "tool_call_end",
          "content": {
            "type": "tool_call",
            "result": "{\"status\": \"dispatched\", \"workers\": [\"researcher\"], \"message\": \"Workers are running in the background. Their combined results will be handed to you when they are done.\"}"
          }
        },
        {
          "source": {
            "channel_id": "sup"
          },
          "content": {
            "type": "text",
            "body": "On it."
          },
          "chain_depth": 1
        },
        {
          "type": "instruction_read",
          "source": {
            "channel_id": "sup"
          },
          "visibility": "sup",
          "content": {
            "body": "[Your background workers failed: The delegated work could not be completed. Tell the user.]\nThis turn only gives this task's result: give it, without answering anything else that was said; another reply of yours is taking care of that. Say it in the language the conversation is in, whatever the result's."
          }
        },
        {
          "source": {
            "channel_id": "sup"
          },
          "content": {
            "type": "text",
            "body": "Sorry, it failed."
          },
          "chain_depth": 2
        }
      ]
    },
    "models": {
      "sup": [
        {},
        {},
        {
          "messages": [
            {},
            {},
            {},
            {
              "role": "assistant",
              "text": "On it."
            },
            {
              "role": "user",
              "text": {
                "$starts_with": "[Instruction from the application: nobody in this conversation said it. Act on it now, in your own words, without quoting it.]\n[Your background workers failed: The delegated work could not be completed. Tell the user.]\nThis turn only gives this task's result: give it, without answering anything else that was said; another reply of yours is taking care of that. Say it in the language the conversation is in, whatever the result's."
              }
            }
          ]
        }
      ]
    }
  }
}
