        {
          "phase": "intake",
          "agent_id": "a",
          "next": "review"
        },
        {
          "phase": "review",
          "agent_id": "b",
          "next": "report",
          "can_return_to": [
            "intake"
          ]
        },
        {
          "phase": "report",
          "agent_id": "c"
        }
      ],
      "agents": [
        "a",
        "b",
        "c"
      ]
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "One."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
