              "text": "A in intake."
            },
            {
              "text": "A by default."
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "agent": {
          "role": "B"
        },
        "model": {
          "rounds": [
            {
              "text": "B in review."
            }
          ]
        }
      },
      {
        "id": "c",
        "type": "ai",
        "agent": {
          "role": "C"
