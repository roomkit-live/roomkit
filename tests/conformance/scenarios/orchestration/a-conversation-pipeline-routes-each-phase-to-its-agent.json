  "rules": [
    "§19.5",
    "§19.4"
  ],
  "notes": "Python: tests/orchestration/test_pipeline.py TestToRouter::test_generates_rules_per_stage, test_default_agent_is_first_stage, TestPipelineInstall::test_install_registers_hook. orchestration/pipeline.py to_router, install.",
