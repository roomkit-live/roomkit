{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/an-install-refused-by-a-handoff-already-set-up-leaves-nothing",
  "title": "A ConversationPipeline's or a router's install, refused for an agent whose handoff is set up already, in every room or in one, leaves no router and no tool behind: the next message reads no stamp, the other agent gains no tool and its handoff stays free to set up",
  "rules": [
    "§19.5",
    "§19.6"
  ],
  "notes": "Python: orchestration/pipeline.py install, router.py install, handoff.py setup_handoff.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "agent": {
          "role": "A"
        },
        "model": {
          "rounds": [
            {
              "text": "A alone."
            },
            {
              "text": "A again."
            },
            {
              "text": "A once more."
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "agent": {
          "role": "B"
        },
        "model": {
          "rounds": []
        }
      },
      {
        "id": "c",
        "type": "ai",
        "agent": {
          "role": "C"
        },
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "a"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "c"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "seen",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "handoff_handler",
      "handler": "h",
      "router": {
        "default_agent_id": "b"
      }
    },
    {
      "call": "setup_handoff",
      "agent_id": "b",
      "handler": "h"
    },
    {
      "call": "install_pipeline",
      "handler": "p",
      "stages": [
        {
          "phase": "intake",
          "agent_id": "a",
          "next": "review"
        },
        {
          "phase": "review",
          "agent_id": "b"
        }
      ],
      "agents": [
        "a",
        "b"
      ],
      "expect": {
        "error": "already_set_up"
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "One."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "install_router",
      "handler": "q",
      "router": {
        "default_agent_id": "a"
      },
      "agents": [
        "a",
        "b"
      ],
      "expect": {
        "error": "already_set_up"
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Two."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "setup_handoff",
      "agent_id": "c",
      "handler": "h",
      "room_id": "r2"
    },
    {
      "call": "install_pipeline",
      "handler": "p",
      "stages": [
        {
          "phase": "intake",
          "agent_id": "a",
          "next": "review"
        },
        {
          "phase": "review",
          "agent_id": "b"
        }
      ],
      "agents": [
        "a",
        "c"
      ],
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Three."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "setup_handoff",
      "agent_id": "a",
      "handler": "h"
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "type": "text",
            "body": "One."
          },
          "metadata": {
            "_routed_to": {
              "$absent": true
            }
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "type": "text",
            "body": "A alone."
          }
        },
        {
          "content": {
            "type": "text",
            "body": "Two."
          },
          "metadata": {
            "_routed_to": {
              "$absent": true
            }
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "type": "text",
            "body": "A again."
          }
        },
        {
          "content": {
            "type": "text",
            "body": "Three."
          },
          "metadata": {
            "_routed_to": {
              "$absent": true
            }
          }
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "type": "text",
            "body": "A once more."
          }
        }
      ]
    },
    "hooks": {
      "seen": [
        {
          "response": {
            "channel_id": "a",
            "declared_tools": {
              "handoff_conversation": {
                "$absent": true
              }
            }
          }
        },
        {
          "response": {
            "channel_id": "a",
            "declared_tools": {
              "handoff_conversation": {
                "$absent": true
              }
            }
          }
        },
        {
          "response": {
            "channel_id": "a",
            "declared_tools": {
              "handoff_conversation": {
                "$absent": true
              }
            }
          }
        }
      ]
    }
  }
}
