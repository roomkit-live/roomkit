{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/each-room-s-per-worker-tools-run-with-its-own-install-without-streaming",
  "title": "A shared supervisor runs each room's per-worker background install with its own worker and shared transport, and declares no delegation tool in a plain room (provider without streaming)",
  "rules": [
    "§19.7",
    "§19.7.3",
    "§23.3"
  ],
  "notes": "Python: tests/orchestration/test_room_installs.py::test_each_room_s_per_worker_tools_run_with_its_own_install. Real delegated child rooms expose share_channels instead of replacing kit.delegate; the second install is called first, then the first, then a room with no install. This variant uses generate() through the default provider adapter; every model request asserts the actual generation method.",
  "setup": {
    "channels": [
      {
        "id": "bank_sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "clinic_sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "plain_sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {},
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "b",
                  "name": "delegate_to_worker_b",
                  "arguments": {
                    "task": "Clinic"
                  }
                }
              ]
            },
            {
              "text": "Clinic started."
            },
            {
              "text": "Clinic done."
            },
            {
              "calls": [
                {
                  "id": "a",
                  "name": "delegate_to_worker_a",
                  "arguments": {
                    "task": "Bank"
                  }
                }
              ]
            },
            {
              "text": "Bank started."
            },
            {
              "text": "Bank done."
            },
            {
              "text": "My own answer."
            }
          ],
          "streaming": false
        }
      },
      {
        "id": "worker_a",
        "type": "ai",
        "agent": {},
        "model": {
          "rounds": [
            {
              "text": "Accounts.",
              "gate": "bank"
            }
          ],
          "streaming": false
        }
      },
      {
        "id": "worker_b",
        "type": "ai",
        "agent": {},
        "model": {
          "rounds": [
            {
              "text": "Patients.",
              "gate": "clinic"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "bank",
        "bindings": [
          {
            "channel_id": "bank_sms"
          }
        ]
      },
      {
        "id": "clinic",
        "bindings": [
          {
            "channel_id": "clinic_sms"
          }
        ]
      },
      {
        "id": "plain",
        "bindings": [
          {
            "channel_id": "plain_sms"
          },
          {
            "channel_id": "sup"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "bank",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "worker_a"
          ],
          "wait_for_result": false,
          "share_channels": [
            "bank_sms"
          ]
        }
      },
      {
        "id": "clinic",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "worker_b"
          ],
          "wait_for_result": false,
          "share_channels": [
            "clinic_sms"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "bank",
      "strategy": "bank"
    },
    {
      "call": "install_strategy",
      "room_id": "clinic",
      "strategy": "clinic"
    },
    {
      "call": "process_inbound",
      "room_id": "clinic",
      "message": {
        "channel_id": "clinic_sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "Check clinic."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "clinic"
    },
    {
      "open": "clinic"
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "bank",
      "message": {
        "channel_id": "bank_sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "Check bank."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "bank"
    },
    {
      "open": "bank"
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "plain",
      "message": {
        "channel_id": "plain_sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "Hello."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "sup": [
        {
          "tools": {
            "delegate_to_worker_b": {
              "$present": true
            },
            "delegate_to_worker_a": {
              "$absent": true
            }
          },
          "method": "generate"
        },
        {
          "tools": {
            "delegate_to_worker_b": {
              "$present": true
            },
            "delegate_to_worker_a": {
              "$absent": true
            }
          },
          "method": "generate"
        },
        {
          "tools": {
            "delegate_to_worker_b": {
              "$present": true
            },
            "delegate_to_worker_a": {
              "$absent": true
            }
          },
          "method": "generate"
        },
        {
          "tools": {
            "delegate_to_worker_a": {
              "$present": true
            },
            "delegate_to_worker_b": {
              "$absent": true
            }
          },
          "method": "generate"
        },
        {
          "tools": {
            "delegate_to_worker_a": {
              "$present": true
            },
            "delegate_to_worker_b": {
              "$absent": true
            }
          },
          "method": "generate"
        },
        {
          "tools": {
            "delegate_to_worker_a": {
              "$present": true
            },
            "delegate_to_worker_b": {
              "$absent": true
            }
          },
          "method": "generate"
        },
        {
          "tools": {
            "delegate_to_worker_a": {
              "$absent": true
            },
            "delegate_to_worker_b": {
              "$absent": true
            }
          },
          "method": "generate"
        }
      ],
      "worker_a": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Bank"
            }
          ],
          "method": "generate"
        }
      ],
      "worker_b": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Clinic"
            }
          ],
          "method": "generate"
        }
      ]
    },
    "rooms": {
      "$r1": {
        "metadata": {
          "task_agent_id": "worker_b",
          "task_input": "Clinic"
        }
      },
      "$r2": {
        "metadata": {
          "task_agent_id": "worker_a",
          "task_input": "Bank"
        }
      },
      "$r3": null
    },
    "bindings": {
      "$r1": {
        "clinic_sms": {
          "category": "transport"
        },
        "bank_sms": null,
        "worker_b": {
          "category": "intelligence"
        }
      },
      "$r2": {
        "bank_sms": {
          "category": "transport"
        },
        "clinic_sms": null,
        "worker_a": {
          "category": "intelligence"
        }
      }
    },
    "timeline": {
      "plain": [
        {
          "source": {
            "channel_id": "plain_sms"
          },
          "content": {
            "body": "Hello."
          }
        },
        {
          "source": {
            "channel_id": "sup"
          },
          "content": {
            "body": "My own answer."
          }
        }
      ]
    }
  }
}
