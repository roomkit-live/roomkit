{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-hosts-own-strategy-is-taken-back-out-whole",
  "title": "A host's own strategy removes its additions while preserving the room's existing hooks, metadata, bindings and timeline",
  "rules": [
    "§19.7",
    "§9.1"
  ],
  "notes": "What an install adds is recorded from the room before and after it, so a strategy that undoes nothing itself is taken back out all the same.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ],
        "metadata": {
          "host_state": {
            "owner": "ops"
          }
        }
      }
    ],
    "strategies": [
      {
        "id": "custom",
        "install": {
          "do": [
            {
              "call": "add_room_hook",
              "room_id": "$room",
              "hook": {
                "name": "custom_tag",
                "trigger": "before_broadcast"
              }
            },
            {
              "call": "update_room_metadata",
              "room_id": "$room",
              "metadata": {
                "custom_state": {
                  "on": true
                }
              }
            }
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "add_room_hook",
      "room_id": "r1",
      "hook": {
        "name": "host_tag",
        "trigger": "before_broadcast"
      }
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "custom",
      "expect": {
        "result": null
      }
    },
    {
      "call": "room_strategy",
      "room_id": "r1",
      "expect": {
        "result": "custom"
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "+15550001111",
        "content": {
          "type": "text",
          "body": "hello"
        }
      }
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "+15550001111",
        "content": {
          "type": "text",
          "body": "again"
        }
      }
    },
    {
      "call": "room_strategy",
      "room_id": "r1",
      "expect": {
        "result": null
      }
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "expect": {
        "result": false
      }
    }
  ],
  "expect": {
    "hooks": {
      "custom_tag": [
        {
          "trigger": "before_broadcast",
          "room_id": "r1",
          "event": {
            "content": {
              "body": "hello"
            }
          }
        }
      ],
      "host_tag": [
        {
          "event": {
            "content": {
              "body": "hello"
            }
          }
        },
        {
          "event": {
            "content": {
              "body": "again"
            }
          }
        }
      ]
    },
    "rooms": {
      "r1": {
        "metadata": {
          "custom_state": {
            "$absent": true
          },
          "host_state": {
            "owner": "ops"
          }
        }
      }
    },
    "bindings": {
      "r1": {
        "ops": {
          "category": "transport"
        }
      }
    },
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "hello"
          }
        },
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "again"
          }
        }
      ]
    }
  }
}
