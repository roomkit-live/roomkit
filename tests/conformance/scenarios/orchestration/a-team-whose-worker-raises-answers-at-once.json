{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-team-whose-worker-raises-answers-at-once",
  "title": "A parallel team one of whose delegations raises (its worker left the kit) answers delegate_workers with that failure as soon as it is raised: the call does not wait for the other workers, still at work",
  "rules": [
    "§19.7.3",
    "§23.3"
  ],
  "notes": "Python: orchestration/strategies/supervisor/execution.py _run_parallel (asyncio.gather without return_exceptions: the first error propagates at once, the other delegations go on); _inject_strategy.py _run (logged, raised: a failed call, RFC §9.3). Found by the review of stream I lot 5a; whether the others should be cut instead is asked of the maintainer (HITL 4080f241). The slow worker's model waits at its gate until the call has answered; what it does after is not pinned (Python's idle does not wait for a gather's orphan, roomkit-rs's kit holds every inline delegation).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {
          "role": "Coordinator"
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_workers",
                  "arguments": {
                    "task": "Acme"
                  }
                }
              ]
            },
            {
              "text": "The team failed."
            }
          ]
        }
      },
      {
        "id": "gone",
        "type": "ai",
        "agent": {
          "role": "Gone"
        },
        "model": {
          "rounds": [
            {
              "text": "Never."
            }
          ]
        }
      },
      {
        "id": "slow",
        "type": "ai",
        "agent": {
          "role": "Slow"
        },
        "model": {
          "rounds": [
            {
              "text": "Too late.",
              "gate": "slow"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "gone",
            "slow"
          ],
          "strategy": "parallel"
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "team"
    },
    {
      "call": "unregister_channel",
      "channel_id": "gone"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Look into Acme."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "slow"
    },
    {
      "open": "slow"
    },
    {
      "idle": true
    },
    {
      "call": "status.recent",
      "agent_id": "gone",
      "expect": {
        "result": [
          {
            "agent_id": "gone",
            "action": "task",
            "status": "pending",
            "detail": "Acme",
            "metadata": {
              "room_id": "r1",
              "strategy": "parallel",
              "task_run": true,
              "task_id": {
                "$absent": true
              }
            }
          },
          {
            "agent_id": "gone",
            "status": "failed",
            "metadata": {
              "strategy": "parallel"
            }
          }
        ]
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {},
        {},
        {
          "type": "tool_call_end",
          "content": {
            "result": "{\"error\": \"Tool 'delegate_workers' failed (ChannelNotRegisteredError)\"}"
          }
        },
        {
          "source": {
            "channel_id": "sup",
            "channel_type": "ai"
          },
          "content": {
            "type": "text",
            "body": "The team failed."
          },
          "chain_depth": 1,
          "responds_to": "r1#0"
        }
      ]
    },
    "models": {
      "gone": [],
      "slow": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Acme"
            }
          ]
        }
      ],
      "sup": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"error\": \"Tool 'delegate_workers' failed (ChannelNotRegisteredError)\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
