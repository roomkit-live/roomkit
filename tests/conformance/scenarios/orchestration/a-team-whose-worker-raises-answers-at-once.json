{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-team-whose-worker-raises-answers-at-once",
  "title": "A parallel team one of whose delegations raises (its worker left the kit) answers delegate_workers with that failure without waiting for the other workers: each of them has started, posted pending, and is cut, its task posted failed 'cancelled'",
  "rules": [
    "§19.7.3",
    "§23.3"
  ],
  "notes": "Python: orchestration/strategies/supervisor/execution.py _run_parallel (core/task_utils.py gather_or_cut: the first error cuts the others, then is raised), _inject_strategy.py _run (logged, raised: a failed call, RFC §9.3); tests/orchestration/test_supervisor_strategy.py TestParallelWorkerFailure::test_the_first_error_cuts_the_other_workers. Decided by the maintainer, HITL 4080f241 (RMK-1279). The raising worker is the first: each worker still starts, posted pending, before the error answers; the slow worker's model holds at a gate never opened, so whether its turn reached the model is not pinned.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {
          "role": "Coordinator"
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_workers",
                  "arguments": {
                    "task": "Acme"
                  }
                }
              ]
            },
            {
              "text": "The team failed."
            }
          ]
        }
      },
      {
        "id": "gone",
        "type": "ai",
        "agent": {
          "role": "Gone"
        },
        "model": {
          "rounds": [
            {
              "text": "Never."
            }
          ]
        }
      },
      {
        "id": "slow",
        "type": "ai",
        "agent": {
          "role": "Slow"
        },
        "model": {
          "rounds": [
            {
              "text": "Too late.",
              "gate": "slow"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "gone",
            "slow"
          ],
          "strategy": "parallel"
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "team"
    },
    {
      "call": "unregister_channel",
      "channel_id": "gone"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Look into Acme."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "status.recent",
      "agent_id": "gone",
      "expect": {
        "result": [
          {
            "agent_id": "gone",
            "action": "task",
            "status": "pending",
            "detail": "Acme",
            "metadata": {
              "room_id": "r1",
              "strategy": "parallel",
              "task_run": true,
              "task_id": {
                "$absent": true
              }
            }
          },
          {
            "agent_id": "gone",
            "status": "failed",
            "metadata": {
              "strategy": "parallel"
            }
          }
        ]
      }
    },
    {
      "call": "status.recent",
      "agent_id": "slow",
      "expect": {
        "result": [
          {
            "agent_id": "slow",
            "action": "task",
            "status": "pending",
            "detail": "Acme",
            "metadata": {
              "room_id": "r1",
              "strategy": "parallel",
              "task_run": true
            }
          },
          {
            "agent_id": "slow",
            "action": "task",
            "status": "failed",
            "detail": "cancelled",
            "metadata": {
              "room_id": "r1",
              "strategy": "parallel",
              "task_run": true
            }
          }
        ]
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {},
        {},
        {
          "type": "tool_call_end",
          "content": {
            "result": "{\"error\": \"Tool 'delegate_workers' failed (ChannelNotRegisteredError)\"}"
          }
        },
        {
          "source": {
            "channel_id": "sup",
            "channel_type": "ai"
          },
          "content": {
            "type": "text",
            "body": "The team failed."
          },
          "chain_depth": 1,
          "responds_to": "r1#0"
        }
      ]
    },
    "models": {
      "gone": [],
      "sup": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"error\": \"Tool 'delegate_workers' failed (ChannelNotRegisteredError)\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
