{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/an-audited-call-is-recorded-to-a-tool-auditor-of-the-integrator-s-own",
  "title": "A tool handler wrapped by audit_tool_handler over a ToolAuditor the integrator implements records each call to it, as to a built-in auditor",
  "rules": [
    "§15.8.1"
  ],
  "requirements": [
    "RK-15.8.1-023"
  ],
  "notes": "The runner's own auditor implements the ToolAuditor interface and keeps what it is handed (README, own_auditor); the wrapper hands it the entry a built-in auditor records. Python: orchestration/tool_audit.py audit_tool_handler. roomkit-rs: roomkit-ai orchestration audit_tool_handler.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "roomkit"
                  }
                }
              ]
            },
            {
              "text": "Found it."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object",
              "properties": {}
            },
            "returns": "found"
          }
        ],
        "audit": "own_auditor"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look up roomkit."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "own_audit": [
      {
        "ts": {
          "$present": true
        },
        "agent_id": "agent",
        "tool_name": "lookup",
        "arguments": {
          "q": "roomkit"
        },
        "result": "found",
        "status": "ok",
        "duration_ms": {
          "$present": true
        },
        "metadata": {}
      }
    ]
  }
}
