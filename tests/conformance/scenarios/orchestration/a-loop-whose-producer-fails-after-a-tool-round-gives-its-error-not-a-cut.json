{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-loop-whose-producer-fails-after-a-tool-round-gives-its-error-not-a-cut",
  "title": "A Loop whose producer's provider fails after a tool round hands that error to the caller, the producer's turn ended on error, not cut short",
  "rules": [
    "§19.7.4",
    "§23.3",
    "§6.4"
  ],
  "notes": "Python: test_loop_producer_cut.py test_a_producer_failing_after_a_round_gives_its_error_not_a_cut.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "writer",
        "type": "ai",
        "agent": {},
        "model": {
          "rounds": [
            {
              "text": "Still checking.",
              "calls": [
                {
                  "id": "c",
                  "name": "lookup"
                }
              ]
            },
            {
              "refuses": {
                "status": 400,
                "message": "upstream 400"
              }
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "look up",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "max_tool_rounds": 3
      },
      {
        "id": "editor",
        "type": "ai",
        "agent": {
          "role": "Editor"
        },
        "model": {
          "rounds": [
            {
              "text": "APPROVED"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "loop",
        "loop": {
          "agent": "writer",
          "reviewer": "editor"
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "loop"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Write it."
        }
      },
      "expect": {
        "result": {
          "error": {
            "$contains": "upstream 400"
          },
          "response_metadata": {
            "turns": {
              "writer": {
                "loop_end_reason": "error"
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "sms"
          },
          "content": {
            "type": "text",
            "body": "Write it."
          }
        }
      ]
    },
    "models": {
      "editor": []
    }
  }
}
