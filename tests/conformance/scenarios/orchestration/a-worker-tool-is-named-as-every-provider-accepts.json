{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-worker-tool-is-named-as-every-provider-accepts",
  "title": "A supervisor's per-worker tool is named as every built-in provider accepts a tool name, whatever its worker's channel id holds: a worker whose id makes such a name keeps delegate_to_<id>, any other id has each other character replaced by _, a replaced name that meets another worker's or passes 128 characters ends with _ and 8 hex digits of the id's SHA-256, and a call on the name reaches its worker",
  "rules": [
    "§19.7.3",
    "§6.7"
  ],
  "requirements": [
    "RK-8.5-007"
  ],
  "notes": "A host that names its agent channels agent:<uuid>. Python: tests/orchestration/test_strategy_supervisor.py TestSupervisorInstall::test_injects_delegation_tools (every built-in provider's rule checks the names), test_delegation_tool_handler. orchestration/strategies/supervisor/_worker_tool_names.py worker_tool_names; _inject_per_worker.py _worker_tool. The tool's description still names the worker's id (the on_ai_response hook reads the supervisor's declared tools).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {
          "role": "Coordinator"
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_to_agent_6f1c2a9e-1111-2222-3333-444455556666",
                  "arguments": {
                    "task": "Find the facts."
                  }
                }
              ]
            },
            {
              "text": "Here are the facts."
            }
          ]
        }
      },
      {
        "id": "agent:6f1c2a9e-1111-2222-3333-444455556666",
        "type": "ai",
        "agent": {
          "role": "Researcher",
          "description": "Finds facts."
        },
        "model": {
          "rounds": [
            {
              "text": "The facts."
            }
          ]
        }
      },
      {
        "id": "writer",
        "type": "ai",
        "agent": {
          "role": "Writer",
          "description": "Writes."
        },
        "model": {
          "rounds": []
        }
      },
      {
        "id": "agent_x",
        "type": "ai",
        "agent": {},
        "model": {
          "rounds": []
        }
      },
      {
        "id": "agent:x",
        "type": "ai",
        "agent": {},
        "model": {
          "rounds": []
        }
      },
      {
        "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "type": "ai",
        "agent": {},
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "agent:6f1c2a9e-1111-2222-3333-444455556666",
            "writer",
            "agent_x",
            "agent:x",
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "seen",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "team"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Find it."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "sms"
          },
          "content": {
            "type": "text",
            "body": "Find it."
          }
        },
        {
          "type": "tool_call_start",
          "source": {
            "channel_id": "sup"
          },
          "content": {
            "type": "tool_call",
            "tool_name": "delegate_to_agent_6f1c2a9e-1111-2222-3333-444455556666",
            "arguments": {
              "task": "Find the facts."
            }
          }
        },
        {
          "type": "tool_call_end",
          "source": {
            "channel_id": "sup"
          },
          "content": {
            "type": "tool_call",
            "tool_name": "delegate_to_agent_6f1c2a9e-1111-2222-3333-444455556666",
            "result": "{\"status\": \"completed\", \"worker\": \"agent:6f1c2a9e-1111-2222-3333-444455556666\", \"result\": \"The facts.\"}",
            "status": "completed"
          }
        },
        {
          "source": {
            "channel_id": "sup",
            "channel_type": "ai"
          },
          "content": {
            "type": "text",
            "body": "Here are the facts."
          },
          "responds_to": "r1#0"
        }
      ]
    },
    "hooks": {
      "seen": [
        {
          "room_id": "$r1",
          "response": {
            "channel_id": "agent:6f1c2a9e-1111-2222-3333-444455556666"
          }
        },
        {
          "room_id": "r1",
          "response": {
            "channel_id": "sup",
            "declared_tools": {
              "delegate_to_agent_6f1c2a9e-1111-2222-3333-444455556666": {
                "position": 0,
                "description": "Delegate a task to agent:6f1c2a9e-1111-2222-3333-444455556666. Finds facts."
              }
            }
          }
        }
      ]
    },
    "models": {
      "sup": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Find it."
            }
          ],
          "tools": {
            "delegate_to_agent_6f1c2a9e-1111-2222-3333-444455556666": 0,
            "delegate_to_writer": 1,
            "delegate_to_agent_x": 2,
            "delegate_to_agent_x_c9d679f9": 3,
            "delegate_to_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_2f3d3354": 4,
            "delegate_to_agent:6f1c2a9e-1111-2222-3333-444455556666": {
              "$absent": true
            },
            "delegate_to_agent:x": {
              "$absent": true
            }
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"status\": \"completed\", \"worker\": \"agent:6f1c2a9e-1111-2222-3333-444455556666\", \"result\": \"The facts.\"}",
              "is_error": false
            }
          ]
        }
      ],
      "agent:6f1c2a9e-1111-2222-3333-444455556666": [
        {
          "messages": [
            {
              "role": "user",
              "text": "Find the facts."
            }
          ]
        }
      ]
    }
  }
}
