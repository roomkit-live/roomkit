{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/an-agent-named-by-an-id-is-one-the-kit-holds",
  "title": "A strategy's agent named by its id is a channel the kit holds, an intelligence channel: an id it does not hold, or a transport's, is refused and nothing installed",
  "rules": [
    "§19.7"
  ],
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket"
      },
      {
        "id": "sales",
        "type": "ai"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "ghostly",
        "agents": [
          "sales",
          "ghost"
        ]
      },
      {
        "id": "transported",
        "agents": [
          "sales",
          "ops"
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "ghostly",
      "expect": {
        "error": "channel_not_registered"
      }
    },
    {
      "call": "room_strategy",
      "room_id": "r1",
      "expect": {
        "result": null
      }
    },
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "transported",
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "call": "room_strategy",
      "room_id": "r1",
      "expect": {
        "result": null
      }
    }
  ],
  "expect": {
    "bindings": {
      "r1": {
        "sales": null
      }
    }
  }
}
