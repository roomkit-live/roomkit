{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-loop-whose-producer-is-cut-after-an-output-answers-that-output-not-approved",
  "title": "A Loop whose producer's turn is cut short after an earlier output answers that output, not approved, saying the producer's task stopped the loop: the cut is an expected end, no error and no ON_ERROR",
  "rules": [
    "§19.7.4",
    "§23.3",
    "§6.4"
  ],
  "notes": "Python: test_loop_producer_cut.py test_a_producer_cut_after_an_output_keeps_it_not_approved.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "writer",
        "type": "ai",
        "agent": {},
        "model": {
          "rounds": [
            {
              "text": "Draft one."
            },
            {
              "text": "Still checking.",
              "calls": [
                {
                  "id": "c",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": "Still checking.",
              "calls": [
                {
                  "id": "c",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": "Still checking.",
              "calls": [
                {
                  "id": "c",
                  "name": "lookup"
                }
              ]
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "look up",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "max_tool_rounds": 1
      },
      {
        "id": "editor",
        "type": "ai",
        "agent": {
          "role": "Editor"
        },
        "model": {
          "rounds": [
            {
              "text": "Needs work."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "loop",
        "loop": {
          "agent": "writer",
          "reviewer": "editor"
        }
      }
    ],
    "hooks": [
      {
        "name": "errors",
        "trigger": "on_error",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "loop"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Write it."
        }
      },
      "expect": {
        "result": {
          "error": null,
          "response_metadata": {
            "turns": {
              "writer": {
                "loop_end_reason": "max_rounds"
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "sms"
          },
          "content": {
            "type": "text",
            "body": "Write it."
          }
        },
        {
          "source": {
            "channel_id": "writer",
            "channel_type": "ai"
          },
          "content": {
            "type": "text",
            "body": "Draft one."
          },
          "responds_to": "r1#0",
          "metadata": {
            "approved": false,
            "iteration": 1,
            "stopped": "producer_failed"
          }
        }
      ]
    },
    "rooms": {
      "r1": {
        "metadata": {
          "_conversation_state": {
