{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-room-held-for-a-human-takes-no-handoff-to-an-agent",
  "title": "While a room is held for a human, a handoff to an agent is refused by the handler's own call too, naming the hold, and fires no transition; a further handoff to a human is taken, and the hold stays",
  "rules": [
    "§19.6"
  ],
  "notes": "Python: orchestration/handoff.py HandoffHandler._refused_while_held. Decided on RMK-1233, answering an automated security finding: releasing a hold is the host's act, by a transition, with no model's tool on its way.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "agent": {
          "role": "A"
        },
        "model": {
          "rounds": []
        }
      },
      {
        "id": "b",
        "type": "ai",
        "agent": {
          "role": "B"
        },
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "a"
          },
          {
            "channel_id": "b"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "rejected",
        "trigger": "on_handoff_rejected",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "handoff_handler",
      "handler": "h",
      "router": {
        "default_agent_id": "a"
      }
    },
    {
      "call": "handoff.handle",
      "handler": "h",
      "room_id": "r1",
      "calling_agent_id": "a",
      "arguments": {
        "target": "human",
        "reason": "R.",
        "summary": "S."
      },
      "expect": {
        "result": {
          "accepted": true,
          "new_agent_id": null,
          "new_phase": "handling"
        }
      }
    },
    {
      "call": "handoff.handle",
      "handler": "h",
      "room_id": "r1",
      "calling_agent_id": "a",
      "arguments": {
        "target": "b",
        "reason": "R.",
        "summary": "S."
      },
      "expect": {
        "result": {
          "accepted": false,
          "new_agent_id": null,
          "new_phase": null,
          "message": "",
          "reason": "Room r1 is held for a human"
        }
      }
    },
    {
      "call": "handoff.handle",
      "handler": "h",
      "room_id": "r1",
      "calling_agent_id": "a",
      "arguments": {
        "target": "human",
        "reason": "R.",
        "summary": "S."
      },
      "expect": {
        "result": {
          "accepted": true,
          "new_agent_id": null,
          "new_phase": "handling"
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "rejected": [
        {
          "event": {
            "metadata": {
              "from_agent": "a",
              "to_agent": "b",
              "accepted": false
            }
          }
        }
      ]
    },
    "rooms": {
      "r1": {
        "metadata": {
          "_conversation_state": {
            "phase": "handling",
            "active_agent_id": null,
            "human_hold": true
          }
        }
      }
    }
  }
}
