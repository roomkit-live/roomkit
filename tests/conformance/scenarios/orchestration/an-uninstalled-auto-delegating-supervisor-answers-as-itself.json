{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/an-uninstalled-auto-delegating-supervisor-answers-as-itself",
  "title": "Once an auto-delegating Supervisor is uninstalled, the supervisor attached again answers the room's messages with its own turn: no task-formulation instruction, no team",
  "rules": [
    "§19.7",
    "§19.7.3"
  ],
  "notes": "Python: orchestration/strategies/supervisor/_install_auto.py (the turns taken with owner=self), core/mixins/strategies.py uninstall_strategy (the owner's turn runners released).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {
          "role": "Coordinator"
        },
        "model": {
          "rounds": [
            {
              "text": "Hello."
            }
          ]
        }
      },
      {
        "id": "analyst",
        "type": "ai",
        "agent": {
          "role": "Analyst"
        },
        "model": {
          "rounds": [
            {
              "text": "A."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "analyst"
          ],
          "strategy": "parallel",
          "auto_delegate": true
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "team"
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "attach_channel",
      "room_id": "r1",
      "channel_id": "sup",
      "category": "intelligence"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Hi."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "sms"
          }
        },
        {
          "source": {
            "channel_id": "sup"
          },
          "content": {
            "body": "Hello."
          },
          "chain_depth": 1,
          "responds_to": "r1#0"
        }
      ]
    },
    "models": {
      "sup": [
        {
          "system_prompt": "\n--- Agent Identity ---\nRole: Coordinator",
          "messages": [
            {
              "role": "user",
              "text": "Hi."
            }
          ]
        }
      ],
      "analyst": []
    }
  }
}
