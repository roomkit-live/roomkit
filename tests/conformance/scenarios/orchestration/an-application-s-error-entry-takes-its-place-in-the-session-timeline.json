{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/an-application-s-error-entry-takes-its-place-in-the-session-timeline",
  "title": "An error entry the application records on the session auditor, system, its content the error message, is kept after the tool calls recorded before it, in memory and in the auditor's file",
  "rules": [
    "§15.8.2"
  ],
  "requirements": [
    "RK-15.8.2-014"
  ],
  "notes": "The session audit table's error row is the application's to record: no hook makes it. Python: orchestration/session_audit.py JSONLSessionAuditor.record. roomkit-rs: orchestration/session_audit.rs.",
  "setup": {
    "session_auditor": {},
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup",
                  "arguments": {
                    "q": "roomkit"
                  }
                }
              ]
            },
            {
              "text": "Found it."
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object",
              "properties": {}
            },
            "returns": "found"
          }
        ],
        "audit": "session_auditor"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Look up roomkit."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "session_audit.record",
      "entry": {
        "ts": "2026-01-01T00:00:00+00:00",
        "type": "error",
        "role": "system",
        "content": "The payment service did not answer.",
        "duration_ms": null,
        "metadata": {
          "code": "timeout"
        }
      },
      "expect": {
        "result": null
      }
    }
  ],
  "expect": {
    "session_audit": [
      {
        "ts": {
          "$present": true
        },
        "type": "tool_call",
        "role": "assistant",
        "content": "found",
        "duration_ms": {
          "$present": true
        },
        "metadata": {
          "tool_name": "lookup",
          "arguments": {
            "q": "roomkit"
          },
          "status": "ok",
          "agent_id": "agent"
        }
      },
      {
        "ts": {
          "$present": true
        },
        "type": "error",
        "role": "system",
        "content": "The payment service did not answer.",
        "duration_ms": null,
        "metadata": {
          "code": "timeout"
        }
      }
    ]
  }
}
