        }
      ],
      "r2": [
        {
          "content": {
            "type": "text",
            "body": "Find it."
          }
        },
        {
          "type": "tool_call_start"
        },
        {
          "type": "tool_call_end",
          "content": {
            "type": "tool_call",
            "tool_name": "delegate_to_researcher",
            "result": {
              "$contains": "{\"status\": \"delegated\", \"task_id\": \"task-"
            },
