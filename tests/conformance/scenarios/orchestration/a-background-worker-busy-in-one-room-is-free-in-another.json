{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-background-worker-busy-in-one-room-is-free-in-another",
  "title": "While a Supervisor's worker works in the background on a room's task, a second delegate_to_<worker> call in that room answers already_running and starts nothing, where a call in another room the strategy is installed in delegates at once; each room is handed back its own outcome",
  "rules": [
    "§19.7.3",
    "§23.3"
  ],
  "notes": "Python: tests/test_supervisor.py TestPerWorkerDelegation::test_no_wait_already_running; tests/orchestration/test_supervisor_strategy.py TestBackgroundDedup::test_pending_guard_blocks_re_delegation; tests/orchestration/test_supervisor_room_state.py test_a_worker_busy_in_one_room_is_free_in_another. orchestration/strategies/supervisor/_inject_per_worker.py _PerWorkerToolServer (its pending set by room and worker), _already_working. The two hand-backs' order is the runner's: their worker outputs and the supervisor's answers are alike. The agent keeps its own copy of each instruction its turn read, an instruction_read row visible to it alone, before what the turn wrote (RFC §10.1.1, HITL 25b07f2a, RMK-1407).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {
          "role": "Coordinator"
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_to_researcher",
                  "arguments": {
                    "task": "Find the facts."
                  }
                }
              ]
            },
            {
              "text": "Started."
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "delegate_to_researcher",
                  "arguments": {
                    "task": "Find the facts."
                  }
                }
              ]
            },
            {
              "text": "Started."
            },
            {
              "calls": [
                {
                  "id": "c3",
                  "name": "delegate_to_researcher",
                  "arguments": {
                    "task": "Find more."
                  }
                }
              ]
            },
            {
              "text": "Still working."
            },
            {
              "text": "Done."
            },
            {
              "text": "Done."
            }
          ]
        }
      },
      {
        "id": "researcher",
        "type": "ai",
        "agent": {
          "role": "Researcher"
        },
        "model": {
          "rounds": [
            {
              "text": "The facts.",
              "gate": "w"
            },
            {
              "text": "The facts.",
              "gate": "w"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "researcher"
          ],
          "wait_for_result": false
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "team"
    },
    {
      "call": "install_strategy",
      "room_id": "r2",
      "strategy": "team"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Find it."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "w"
    },
    {
      "call": "process_inbound",
      "room_id": "r2",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Find it."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Anything yet?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "open": "w"
    },
    {
      "idle": true
    },
    {
      "call": "status.recent",
      "agent_id": "orchestration",
      "expect": {
        "result": {
          "$unordered": [
            {
              "action": "worker",
              "status": "completed",
              "detail": "completed",
              "metadata": {
                "room_id": "r1",
                "mode": "per_worker_async",
                "worker": "researcher"
              }
            },
            {
              "action": "worker",
              "status": "completed",
              "detail": "completed",
              "metadata": {
                "room_id": "r2",
                "mode": "per_worker_async",
                "worker": "researcher"
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
