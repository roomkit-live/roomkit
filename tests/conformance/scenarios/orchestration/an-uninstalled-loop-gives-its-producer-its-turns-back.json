{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/an-uninstalled-loop-gives-its-producer-its-turns-back",
  "title": "Once its Loop is uninstalled, the producer bound before the install answers its room's messages itself, and the conversation state the install wrote is taken back",
  "rules": [
    "§19.7",
    "§19.7.4"
  ],
  "notes": "Python: core/mixins/strategies.py _take_back releases the turn runners an install took (core/_turn_runners.py).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "writer",
        "type": "ai",
        "agent": {},
        "model": {
          "rounds": [
            {
              "text": "Mine."
            }
          ]
        }
      },
      {
        "id": "editor",
        "type": "ai",
        "agent": {
          "role": "Editor"
        },
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "writer"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "loop",
        "loop": {
          "agent": "writer",
          "reviewer": "editor"
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "loop"
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Write it."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "sms"
          },
          "content": {
            "type": "text",
            "body": "Write it."
          }
        },
        {
          "source": {
            "channel_id": "writer"
          },
          "content": {
            "type": "text",
            "body": "Mine."
          },
          "metadata": {
            "approved": {
              "$absent": true
            }
          }
        }
      ]
    },
    "rooms": {
      "r1": {
        "metadata": {
          "_conversation_state": {
            "$absent": true
          }
        }
      }
    },
    "bindings": {
      "r1": {
        "writer": {
          "category": "intelligence"
        }
      }
    }
  }
}
