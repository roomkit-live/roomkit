{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-supervisor-s-background-team-whose-results-nobody-hears-posts-its-run-failed",
  "title": "A background team whose hand-back a BEFORE_DELIVER hook blocks posts its run failed, not handed back with the hook's reason, and the supervisor is told nothing",
  "rules": [
    "§19.7.3",
    "§23.3",
    "§22.2"
  ],
  "notes": "Python: tests/orchestration/test_supervisor_text_background.py::test_an_outcome_no_one_hears_posts_its_run_failed[team-tool]; orchestration/_background.py run_in_background (not_handed_back).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {
          "role": "Coordinator"
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_workers",
                  "arguments": {
                    "task": "Find the facts."
                  }
                }
              ]
            },
            {
              "text": "On it."
            }
          ]
        }
      },
      {
        "id": "researcher",
        "type": "ai",
        "agent": {
          "role": "Researcher"
        },
        "model": {
          "rounds": [
            {
              "text": "The facts."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "researcher"
          ],
          "strategy": "parallel",
          "async_delivery": true
        }
      }
    ],
    "hooks": [
      {
        "name": "quiet",
        "trigger": "before_deliver",
        "reactions": [
          {
            "result": {
              "action": "block",
              "reason": "quiet hours"
            },
            "repeat": true
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "team"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Find it."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "status.recent",
      "agent_id": "orchestration",
      "expect": {
        "result": [
          {
            "action": "pipeline",
            "status": "failed",
            "detail": "not handed back: blocked (quiet hours)"
          }
        ]
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "type": "text",
            "body": "Find it."
          }
        },
        {
          "type": "tool_call_start"
        },
        {
          "type": "tool_call_end",
          "content": {
            "type": "tool_call",
            "result": "{\"status\": \"dispatched\", \"workers\": [\"researcher\"], \"message\": \"Workers are running in the background. Their combined results will be handed to you when they are done.\"}"
          }
        },
        {
          "source": {
            "channel_id": "sup"
          },
          "content": {
            "type": "text",
            "body": "On it."
          },
          "chain_depth": 1
        }
      ]
    }
  }
}
