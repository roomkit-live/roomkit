{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-supervisor-s-background-team-ends-with-the-kit-s-close",
  "title": "Closing the kit cancels a Supervisor's background team: the worker's delegation it cut posts its own end, then the run posts its terminal entry failed, and nothing is handed back to the supervisor",
  "rules": [
    "§19.7.3",
    "§12.10.4",
    "§19.8"
  ],
  "requirements": [
    "RK-19.7.3-024"
  ],
  "notes": "The supervisor's delegate_workers call is dispatched in the background (async_delivery) and answered at once; the worker holds its turn at a gate no step opens. The kit's close cancels the run: the worker's delegation ends first, posting its terminal entry, then the run's own, the orchestration's pipeline entry, failed. The room's timeline gains no hand-back instruction and the supervisor no third request. Python: tests/orchestration/test_background_close.py::test_close_ends_a_background_run. Cited in part: that the cancelled run frees its room is not observed, since nothing can run in the room once the kit is closed.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {
          "role": "Coordinator"
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_workers",
                  "arguments": {
                    "task": "Find the facts."
                  }
                }
              ]
            },
            {
              "text": "On it."
            },
            {
              "text": "never"
            }
          ]
        }
      },
      {
        "id": "researcher",
        "type": "ai",
        "agent": {
          "role": "Researcher"
        },
        "model": {
          "rounds": [
            {
              "text": "Facts.",
              "gate": "w"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "researcher"
          ],
          "strategy": "parallel",
          "async_delivery": true
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "team"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Find it."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "w"
    },
    {
      "call": "close"
    },
    {
      "call": "status.recent",
      "n": 20,
      "expect": {
        "result": [
          {
            "agent_id": "researcher",
            "action": "task",
            "status": "pending",
            "detail": "Find the facts.",
            "metadata": {
              "room_id": "r1"
            }
          },
          {
            "agent_id": "researcher",
            "status": "failed",
            "detail": "cancelled",
            "metadata": {
              "room_id": "r1"
            }
          },
          {
            "agent_id": "orchestration",
            "action": "pipeline",
            "status": "failed",
            "detail": "cancelled",
            "metadata": {
              "room_id": "r1"
            }
          }
        ]
      }
    }
  ],
  "expect": {
    "models": {
      "sup": [
        {},
        {}
      ],
      "researcher": [
        {}
      ]
    },
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "Find it."
          }
        },
        {
          "type": "tool_call_start"
        },
        {
          "type": "tool_call_end"
        },
        {
          "content": {
            "body": "On it."
          }
        }
      ]
    }
  }
}
