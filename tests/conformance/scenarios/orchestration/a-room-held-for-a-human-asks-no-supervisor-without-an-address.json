                "sup"
              ]
            }
          },
          {
            "source": {
              "channel_id": "y"
            },
            "content": {
              "type": "text",
              "body": "Y, addressed."
            }
          },
          {
            "source": {
              "channel_id": "sup"
            },
            "content": {
              "type": "text",
              "body": "Noted."
            }
          }
        ]
      }
    },
    "models": {
      "x": [],
