{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/an-install-attaches-its-agents-as-intelligence-channels",
  "title": "An install attaches each of its agents the room does not bind as an intelligence channel, and leaves one bound before as it is",
  "rules": [
    "§19.7"
  ],
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket"
      },
      {
        "id": "assistant",
        "type": "ai"
      },
      {
        "id": "helper",
        "type": "ai"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          },
          {
            "channel_id": "assistant",
            "category": "intelligence"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "agents": [
          "assistant",
          "helper"
        ],
        "install": {
          "do": [
            {
              "call": "store.binding_exists",
              "room_id": "$room",
              "channel_id": "helper",
              "expect": {
                "result": true
              }
            }
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "team"
    }
  ],
  "expect": {
    "bindings": {
      "r1": {
        "ops": {
          "$present": true
        },
        "assistant": {
          "category": "intelligence"
        },
        "helper": {
          "category": "intelligence"
        }
      }
    }
  }
}
