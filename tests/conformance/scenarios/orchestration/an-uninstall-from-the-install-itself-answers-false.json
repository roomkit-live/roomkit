{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/an-uninstall-from-the-install-itself-answers-false",
  "title": "An uninstall the strategy's own install makes answers false at once, nothing being installed yet, and the install goes on to its end",
  "rules": [
    "§19.7",
    "§13.5"
  ],
  "notes": "The install runs under the room's lock: an uninstall from within it holds that lock, and does not wait for the install it runs within (RFC §19.7).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "fickle",
        "install": {
          "do": [
            {
              "call": "uninstall_strategy",
              "room_id": "$room",
              "as": "inner"
            }
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "fickle"
    },
    {
      "call": "room_strategy",
      "room_id": "r1",
      "expect": {
        "result": "fickle"
      }
    }
  ],
  "expect": {
    "actions": {
      "inner": [
        {
          "result": false
        }
      ]
    }
  }
}
