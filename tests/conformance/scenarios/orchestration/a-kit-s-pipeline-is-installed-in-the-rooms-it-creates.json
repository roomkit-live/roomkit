{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-kit-s-pipeline-is-installed-in-the-rooms-it-creates",
  "title": "A kit built with a Pipeline installs it in each room it creates, attaching its agents and setting the state; a creation naming none takes none, and one naming another Pipeline takes that one",
  "rules": [
    "§19.7",
    "§19.7.1"
  ],
  "notes": "Python: tests/orchestration/test_framework_orchestration.py TestCreateRoomOrchestration::test_kit_level_orchestration, test_per_room_orchestration, test_per_room_none_disables_kit_default.",
  "setup": {
    "kit": {
      "orchestration": "team"
    },
    "channels": [
      {
        "id": "a",
        "type": "ai",
        "agent": {
          "role": "A"
        },
        "model": {
          "rounds": []
        }
      },
      {
        "id": "b",
        "type": "ai",
        "agent": {
          "role": "B"
        },
        "model": {
          "rounds": []
        }
      },
      {
        "id": "x",
        "type": "ai",
        "agent": {
          "role": "X"
        },
        "model": {
          "rounds": []
        }
      }
    ],
    "strategies": [
      {
        "id": "team",
        "pipeline": {
          "agents": [
            "a",
            "b"
          ]
        }
      },
      {
        "id": "other",
        "pipeline": {
          "agents": [
            "x"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "create_room",
      "room": {
        "id": "r1"
      }
    },
    {
      "call": "create_room",
      "room": {
        "id": "r2"
      },
      "orchestration": null
    },
    {
      "call": "create_room",
      "room": {
        "id": "r3"
      },
      "orchestration": "other"
    },
    {
      "call": "room_strategy",
      "room_id": "r1",
      "expect": {
        "result": "team"
      }
    },
    {
      "call": "room_strategy",
      "room_id": "r2",
      "expect": {
        "result": null
      }
    },
    {
      "call": "room_strategy",
      "room_id": "r3",
      "expect": {
        "result": "other"
      }
    }
  ],
  "expect": {
    "rooms": {
      "r1": {
        "metadata": {
          "_conversation_state": {
            "phase": "a",
            "active_agent_id": "a"
          }
        }
      },
      "r2": {
        "metadata": {
          "_conversation_state": {
            "$absent": true
          }
        }
      },
      "r3": {
        "metadata": {
          "_conversation_state": {
            "phase": "x",
            "active_agent_id": "x"
          }
        }
      }
    },
    "bindings": {
      "r1": {
        "a": {
          "category": "intelligence"
        },
        "b": {
          "category": "intelligence"
        },
        "x": {
          "$absent": true
        }
      },
      "r2": {
        "a": {
          "$absent": true
        },
        "b": {
          "$absent": true
        },
        "x": {
          "$absent": true
        }
      },
      "r3": {
        "x": {
          "category": "intelligence"
        },
        "a": {
          "$absent": true
        }
      }
    }
  }
}
