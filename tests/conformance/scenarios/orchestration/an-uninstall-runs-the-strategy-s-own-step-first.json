{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/an-uninstall-runs-the-strategy-s-own-step-first",
  "title": "An uninstall runs the strategy's own uninstall step, then takes back what the install added; what that step writes stays the host's",
  "rules": [
    "§19.7"
  ],
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "custom",
        "install": {
          "do": [
            {
              "call": "update_room_metadata",
              "room_id": "$room",
              "metadata": {
                "custom_state": {
                  "on": true
                }
              }
            }
          ]
        },
        "uninstall": {
          "do": [
            {
              "call": "update_room_metadata",
              "room_id": "$room",
              "metadata": {
                "farewell": true
              }
            }
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "custom"
    },
    {
      "call": "uninstall_strategy",
      "room_id": "r1",
      "expect": {
        "result": true
      }
    }
  ],
  "expect": {
    "rooms": {
      "r1": {
        "metadata": {
          "custom_state": {
            "$absent": true
          },
          "farewell": true
        }
      }
    }
  }
}
