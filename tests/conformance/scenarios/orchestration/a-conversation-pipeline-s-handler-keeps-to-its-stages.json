{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-conversation-pipeline-s-handler-keeps-to-its-stages",
  "title": "The handler a ConversationPipeline's install returns reads its aliases, leads each target to its stage's phase, and allows a stage's next and return phases alone",
  "rules": [
    "§19.5",
    "§19.6"
  ],
  "notes": "Python: tests/orchestration/test_pipeline.py TestPipelineInstall::test_install_returns_router_and_handler, test_install_passes_aliases, test_install_enforces_transitions. orchestration/pipeline.py install.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "agent": {
          "role": "A"
        },
        "model": {
          "rounds": []
        }
      },
      {
        "id": "b",
        "type": "ai",
        "agent": {
          "role": "B"
        },
        "model": {
          "rounds": []
        }
      },
      {
        "id": "c",
        "type": "ai",
        "agent": {
          "role": "C"
        },
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "a"
          },
          {
            "channel_id": "b"
          },
          {
            "channel_id": "c"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "install_pipeline",
      "handler": "h",
      "stages": [
        {
          "phase": "intake",
          "agent_id": "a",
          "next": "review"
        },
        {
          "phase": "review",
          "agent_id": "b",
          "next": "report",
          "can_return_to": [
            "intake"
          ]
        },
        {
          "phase": "report",
          "agent_id": "c"
        }
      ],
      "agents": [
        "a",
        "b",
        "c"
      ],
      "agent_aliases": {
        "support": "b"
      }
    },
    {
      "call": "handoff.handle",
      "handler": "h",
      "room_id": "r1",
      "calling_agent_id": "a",
      "arguments": {
        "target": "c",
        "reason": "R.",
        "summary": "S."
      },
      "expect": {
        "result": {
          "accepted": false,
          "new_agent_id": null,
          "new_phase": null,
          "message": "",
          "reason": "Transition from 'intake' to 'report' is not allowed"
        }
      }
    },
    {
      "call": "handoff.handle",
      "handler": "h",
      "room_id": "r1",
      "calling_agent_id": "a",
      "arguments": {
        "target": "support",
        "reason": "R.",
        "summary": "S."
      },
      "expect": {
        "result": {
          "accepted": true,
          "new_agent_id": "b",
          "new_phase": "review",
          "message": "Conversation transferred to b. Do not respond — the receiving agent will greet the user.",
          "reason": ""
        }
      }
    },
    {
      "call": "handoff.handle",
      "handler": "h",
      "room_id": "r1",
      "calling_agent_id": "b",
      "arguments": {
        "target": "a",
        "reason": "R.",
        "summary": "S."
      },
      "expect": {
        "result": {
          "accepted": true,
          "new_agent_id": "a",
          "new_phase": "intake",
          "message": "Conversation transferred to a. Do not respond — the receiving agent will greet the user.",
          "reason": ""
        }
      }
    },
    {
      "call": "handoff.handle",
      "handler": "h",
      "room_id": "r1",
      "calling_agent_id": "a",
      "arguments": {
        "target": "b",
        "reason": "R.",
        "summary": "S.",
        "next_phase": "report"
      },
      "expect": {
        "result": {
          "accepted": false,
          "new_agent_id": null,
          "new_phase": null,
          "message": "",
          "reason": "Transition from 'intake' to 'report' is not allowed"
        }
      }
    },
    {
      "call": "handoff.handle",
      "handler": "h",
      "room_id": "r1",
      "calling_agent_id": "a",
      "arguments": {
        "target": "b",
        "reason": "R.",
        "summary": "S."
      },
      "expect": {
        "result": {
          "accepted": true,
          "new_agent_id": "b",
          "new_phase": "review",
          "message": "Conversation transferred to b. Do not respond — the receiving agent will greet the user.",
          "reason": ""
        }
      }
    },
    {
      "call": "handoff.handle",
      "handler": "h",
      "room_id": "r1",
      "calling_agent_id": "b",
      "arguments": {
        "target": "c",
        "reason": "R.",
        "summary": "S."
      },
      "expect": {
        "result": {
          "accepted": true,
          "new_agent_id": "c",
          "new_phase": "report",
          "message": "Conversation transferred to c. Do not respond — the receiving agent will greet the user.",
          "reason": ""
        }
      }
    },
    {
      "call": "handoff.handle",
      "handler": "h",
      "room_id": "r1",
      "calling_agent_id": "c",
      "arguments": {
        "target": "a",
        "reason": "R.",
        "summary": "S."
      },
      "expect": {
        "result": {
          "accepted": false,
          "new_agent_id": null,
          "new_phase": null,
          "message": "",
          "reason": "Transition from 'report' to 'intake' is not allowed"
        }
      }
    }
  ],
  "expect": {
    "rooms": {
      "r1": {
        "metadata": {
          "_conversation_state": {
            "phase": "report",
            "active_agent_id": "c",
            "previous_agent_id": "b",
            "handoff_count": 4
          }
        }
      }
    }
  }
}
