{
  "$schema": "../../scenario.schema.json",
  "id": "ai-external-handler/report-modify-keeps-the-original-outcome-non-streaming",
  "title": "Report modify keeps the original outcome (non-streaming)",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-6.4-067",
    "RK-9.3-055",
    "RK-9.3-056"
  ],
  "notes": "Python: tests/test_tool_call_hook_chain.py::test_an_external_report_s_observers_see_the_provider_s_outcome. A complete AI turn additionally proves that the original external outcome survives the SYNC hook in observers and stored END rows.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "external_tool_handler": {
          "decisions": [
            {
              "approved": true,
              "result": "proxy result"
            }
          ]
        },
        "tools": [],
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "p1",
                  "name": "remote",
                  "arguments": {
                    "q": "original"
                  }
                }
              ]
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "sync",
        "trigger": "on_tool_call",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "result": "REWRITTEN",
                "is_error": true
              }
            }
          }
        ]
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "error": null,
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "external_handlers": {
      "agent": [
        {
          "method": "process_tool_call",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r"
        },
        {
          "method": "on_tool_result",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r",
          "result": "proxy result",
          "is_error": false
        }
      ]
    },
    "models": {
      "agent": [
        {}
      ]
    },
    "hooks": {
      "before": [],
      "sync": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "proxy result",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        }
      ],
      "audit": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "proxy result",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        }
      ]
    },
    "timeline": {
      "r": [
        {
          "type": "message",
          "content": {
            "body": "Go."
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "proxy result",
            "status": "completed",
            "outcome": "served"
          }
        }
      ]
    }
  }
}
