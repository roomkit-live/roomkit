{
  "$schema": "../../scenario.schema.json",
  "id": "ai-external-handler/replacement-arguments-reach-the-report-streaming",
  "title": "Replacement arguments reach the report (streaming)",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: channels/_ai_stream_external_tools.py::_decide and tests/test_external_tool_handler.py. A replacement decision changes the report and END arguments; the decision and START still read the original input.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "external_tool_handler": {
          "decisions": [
            {
              "approved": true,
              "result": "rewritten",
              "modified_input": {
                "q": "replaced",
                "extra": {
                  "allowed": true
                }
              }
            }
          ]
        },
        "tools": [],
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "p1",
                  "name": "remote",
                  "arguments": {
                    "q": "original"
                  }
                }
              ]
            }
          ],
          "streaming": true
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "sync",
        "trigger": "on_tool_call",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "error": null,
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "external_handlers": {
      "agent": [
        {
          "method": "process_tool_call",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r"
        },
        {
          "method": "on_tool_result",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "replaced",
            "extra": {
              "allowed": true
            }
          },
          "tool_call_id": "p1",
          "room_id": "r",
          "result": "rewritten",
          "is_error": false
        }
      ]
    },
    "models": {
      "agent": [
        {}
      ]
    },
    "hooks": {
      "before": [],
      "sync": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "replaced",
              "extra": {
                "allowed": true
              }
            },
            "result": "rewritten",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        }
      ],
      "audit": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "replaced",
              "extra": {
                "allowed": true
              }
            },
            "result": "rewritten",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        }
      ]
    },
    "timeline": {
      "r": [
        {
          "type": "message",
          "content": {
            "body": "Go."
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "replaced",
              "extra": {
                "allowed": true
              }
            },
            "result": "rewritten",
            "status": "completed",
            "outcome": "served"
          }
        }
      ]
    }
  }
}
