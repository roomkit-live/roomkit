{
  "$schema": "../../scenario.schema.json",
  "id": "ai-external-handler/refusal-private-detail-raise-before-streaming",
  "title": "A refusal keeps its private detail through raise_before",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: tests/test_external_call_routing.py, tests/test_served_call_marker.py, tests/test_handler_report_raise.py and channels/_ai_stream_external_tools.py. A real external handler records callbacks; local results, hook observations, stored rows and model request counts are independent product observations.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "external_tool_handler": {
          "decisions": [
            {
              "approved": false,
              "reason": "not on this host",
              "detail": "approval service unavailable"
            }
          ],
          "reports": "raise_before"
        },
        "tools": [],
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "p1",
                  "name": "remote",
                  "arguments": {
                    "q": "original"
                  }
                }
              ]
            }
          ],
          "streaming": true
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "sync",
        "trigger": "on_tool_call",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "error": null,
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "external_handlers": {
      "agent": [
        {
          "method": "process_tool_call",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r"
        },
        {
          "method": "on_tool_refused",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r",
          "reason": "{\"error\": \"not on this host\"}",
          "detail": "approval service unavailable"
        }
      ]
    },
    "models": {
      "agent": [
        {}
      ]
    },
    "hooks": {
      "before": [],
      "sync": [],
      "audit": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "{\"error\": \"not on this host\"}",
            "is_error": true,
            "cancelled": false,
            "refused": true,
            "error_detail": "approval service unavailable"
          }
        }
      ]
    },
    "timeline": {
      "r": [
        {
          "type": "message",
          "content": {
            "body": "Go."
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "{\"error\": \"not on this host\"}",
            "status": "failed",
            "outcome": "refused"
          }
        }
      ]
    }
  }
}
