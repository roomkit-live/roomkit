{
  "$schema": "../../scenario.schema.json",
  "id": "ai-external-handler/provider-failed-report-raise-before-streaming",
  "title": "A provider outcome is observed once when its handler raise_before",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-9.3-043",
    "RK-9.3-074",
    "RK-9.3-078"
  ],
  "notes": "Python: tests/test_external_call_routing.py, tests/test_served_call_marker.py, tests/test_handler_report_raise.py and channels/_ai_stream_external_tools.py. A real external handler records callbacks; local results, hook observations, stored rows and model request counts are independent product observations.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "external_tool_handler": {
          "reports": "raise_before"
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "local result"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "p1",
                  "name": "remote",
                  "arguments": {
                    "q": "original"
                  },
                  "served": {
                    "result": "provider result",
                    "is_error": true
                  }
                }
              ]
            }
          ],
          "streaming": true
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "sync",
        "trigger": "on_tool_call",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "error": null,
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "external_handlers": {
      "agent": [
        {
          "method": "on_tool_result",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r",
          "result": "provider result",
          "is_error": true
        }
      ]
    },
    "models": {
      "agent": [
        {}
      ]
    },
    "hooks": {
      "before": [],
      "sync": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "provider result",
            "is_error": true,
            "cancelled": false,
            "refused": false
          }
        }
      ],
      "audit": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "provider result",
            "is_error": true,
            "cancelled": false,
            "refused": false
          }
        }
      ]
    },
    "timeline": {
      "r": [
        {
          "type": "message",
          "content": {
            "body": "Go."
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "provider result",
            "status": "failed",
            "outcome": "failed"
          }
        }
      ]
    }
  }
}
