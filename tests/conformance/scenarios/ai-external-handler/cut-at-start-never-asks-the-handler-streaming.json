{
  "$schema": "../../scenario.schema.json",
  "id": "ai-external-handler/cut-at-start-never-asks-the-handler-streaming",
  "title": "Cut at start never asks the handler (streaming)",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-9.3-048",
    "RK-9.3-072"
  ],
  "notes": "Python: tests/test_external_call_cut.py::test_a_call_cut_before_its_handler_is_asked_is_reported_cancelled. The transport ends its stream on the first actual tool row, before a pending external decision; one cancellation callback reaches ASYNC observers.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true,
        "deliver_stream": [
          {
            "stop_after_rows": 1
          }
        ]
      },
      {
        "id": "agent",
        "type": "ai",
        "external_tool_handler": {
          "decisions": [
            {
              "approved": true,
              "result": "proxy result"
            }
          ],
          "reports": "delegate"
        },
        "tools": [],
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "p1",
                  "name": "remote",
                  "arguments": {
                    "q": "original"
                  }
                }
              ]
            }
          ],
          "streaming": true
        },
        "publish_tool_call_text": true
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "sync",
        "trigger": "on_tool_call",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "external_handlers": {
      "agent": [
        {
          "method": "on_tool_cancelled",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r"
        }
      ]
    },
    "models": {
      "agent": [
        {}
      ]
    },
    "hooks": {
      "before": [],
      "sync": [],
      "audit": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": {
              "$contains": "Tool call cancelled"
            },
            "is_error": true,
            "cancelled": true,
            "refused": false
          }
        }
      ]
    }
  }
}
