{
  "$schema": "../../scenario.schema.json",
  "id": "ai-external-handler/cut-local-tool-never-notifies-external-handler-non-streaming",
  "title": "Cut local tool never notifies external handler (non-streaming)",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-9.3-048",
    "RK-9.3-069",
    "RK-9.3-072"
  ],
  "notes": "Python: tests/test_external_call_cut.py::test_a_local_call_cut_is_reported_by_the_channel_not_the_handler. A real local handler reaches a held gate before cancellation; an external handler configured beside it receives no callback.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "external_tool_handler": {
          "decisions": []
        },
        "tools": [
          {
            "name": "remote",
            "description": "Local waiting tool",
            "parameters": {
              "type": "object"
            },
            "returns": "local result",
            "gate": "held"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "p1",
                  "name": "remote",
                  "arguments": {
                    "q": "original"
                  }
                }
              ]
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "sync",
        "trigger": "on_tool_call",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "defer_delivery": true,
      "as": "turn"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "delivery.cancel",
      "of": "turn",
      "reason": "cut"
    },
    {
      "open": "held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "external_handlers": {
      "agent": []
    },
    "models": {
      "agent": [
        {}
      ]
    },
    "hooks": {
      "before": [
        {
          "tool_call": {
            "name": "remote",
            "arguments": {
              "q": "original"
            }
          }
        }
      ],
      "sync": [],
      "audit": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": {
              "$contains": "Tool call cancelled"
            },
            "is_error": true,
            "cancelled": true,
            "refused": false
          }
        }
      ]
    }
  }
}
