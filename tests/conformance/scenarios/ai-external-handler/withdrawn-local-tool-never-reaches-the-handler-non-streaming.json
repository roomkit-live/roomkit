{
  "$schema": "../../scenario.schema.json",
  "id": "ai-external-handler/withdrawn-local-tool-never-reaches-the-handler-non-streaming",
  "title": "Withdrawn local tool never reaches the handler (non-streaming)",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-6.4-067",
    "RK-6.4-397",
    "RK-9.3-046",
    "RK-9.3-070",
    "RK-9.3-072"
  ],
  "notes": "Python: tests/test_external_call_routing.py::test_a_tool_the_hook_withdrew_stays_the_channels_to_refuse. A declared local tool removed by BEFORE_AI_GENERATION remains local to refuse; no external callback or local execution occurs.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "external_tool_handler": {
          "decisions": []
        },
        "tools": [
          {
            "name": "remote",
            "description": "Local",
            "parameters": {
              "type": "object"
            },
            "returns": "must not run"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "p1",
                  "name": "remote",
                  "arguments": {
                    "q": "original"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "withdraw",
        "trigger": "before_ai_generation",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "tools": []
              }
            }
          }
        ]
      },
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "sync",
        "trigger": "on_tool_call",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "error": null,
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "external_handlers": {
      "agent": []
    },
    "models": {
      "agent": [
        {
          "tools": {}
        },
        {
          "tool_results": [
            {
              "tool_call_id": "p1",
              "content": "{\"error\": \"Tool 'remote' is not available in this turn.\"}",
              "is_error": true
            }
          ]
        }
      ]
    },
    "hooks": {
      "before": [],
      "sync": [],
      "audit": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": {
              "$contains": "not available in this turn"
            },
            "is_error": true,
            "cancelled": false,
            "refused": true
          }
        }
      ]
    },
    "timeline": {
      "r": [
        {
          "type": "message",
          "content": {
            "body": "Go."
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": {
              "$contains": "not available in this turn"
            },
            "status": "failed",
            "outcome": "refused"
          }
        },
        {
          "type": "message",
          "content": {
            "body": "Done."
          }
        }
      ]
    }
  }
}
