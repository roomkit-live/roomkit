{
  "$schema": "../../scenario.schema.json",
  "id": "ai-external-handler/duplicate-pending-call-is-refused-before-its-cut-non-streaming",
  "title": "A duplicate pending call is refused before its cut arguments (non-streaming)",
  "rules": [
    "§6.4",
    "§9.3",
    "§12.4"
  ],
  "requirements": [
    "RK-6.4-067",
    "RK-6.4-397",
    "RK-9.3-070",
    "RK-9.3-072"
  ],
  "notes": "Python: channels/_ai_stream_external_tools.py::_settle checks the announced occurrence duplicate before closing or partial arguments. The external handler receives only the first decision and result; the second occurrence has its own refusal report.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "external_tool_handler": {
          "decisions": [
            {
              "approved": true,
              "result": "proxy result"
            }
          ]
        },
        "tools": [],
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "p1",
                  "name": "remote",
                  "arguments": {
                    "q": "original"
                  }
                },
                {
                  "id": "p1",
                  "name": "remote",
                  "arguments": {},
                  "cut": true
                }
              ],
              "finish_reason": "length"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "sync",
        "trigger": "on_tool_call",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "error": null,
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "external_handlers": {
      "agent": [
        {
          "method": "process_tool_call",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r"
        },
        {
          "method": "on_tool_result",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r",
          "result": "proxy result",
          "is_error": false
        }
      ]
    },
    "models": {
      "agent": [
        {}
      ]
    },
    "hooks": {
      "before": [],
      "sync": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "proxy result",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        }
      ],
      "audit": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "proxy result",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        },
        {
          "tool_call": {
            "tool_call_id": "p1",
            "name": "remote",
            "arguments": {},
            "result": "{\"error\": \"Tool call 'p1' has not had its result yet\"}",
            "is_error": true,
            "refused": true,
            "cancelled": false
          }
        }
      ]
    },
    "timeline": {
      "r": [
        {
          "type": "message",
          "content": {
            "body": "Go."
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_name": "remote",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "proxy result",
            "status": "completed",
            "outcome": "served"
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_id": "p1",
            "tool_name": "remote",
            "arguments": {}
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_id": "p1",
            "tool_name": "remote",
            "arguments": {},
            "result": "{\"error\": \"Tool call 'p1' has not had its result yet\"}",
            "outcome": "refused",
            "status": "failed"
          }
        }
      ]
    }
  }
}
