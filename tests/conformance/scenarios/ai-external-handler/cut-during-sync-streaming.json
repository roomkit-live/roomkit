{
  "$schema": "../../scenario.schema.json",
  "id": "ai-external-handler/cut-during-sync-streaming",
  "title": "Cut during sync preserves the call report (delegate, streaming)",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: tests/test_external_call_cut.py and tests/test_handler_report_raise.py; the real handler or real SYNC hook holds at a deterministic gate. No sleep or guessed report.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "external_tool_handler": {
          "decisions": [
            {
              "approved": true,
              "result": "proxy result"
            }
          ],
          "reports": "delegate"
        },
        "tools": [],
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "p1",
                  "name": "remote",
                  "arguments": {
                    "q": "original"
                  }
                }
              ]
            }
          ],
          "streaming": true
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "sync",
        "trigger": "on_tool_call",
        "execution": "sync",
        "reactions": [
          {
            "gate": "held"
          }
        ],
        "timeout_ms": 10000
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "defer_delivery": true,
      "as": "turn"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "delivery.cancel",
      "of": "turn",
      "reason": "cut"
    },
    {
      "open": "held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "external_handlers": {
      "agent": [
        {
          "method": "process_tool_call",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r"
        },
        {
          "method": "on_tool_result",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r",
          "result": "proxy result",
          "is_error": false
        }
      ]
    },
    "models": {
      "agent": [
        {}
      ]
    },
    "hooks": {
      "before": [],
      "sync": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "proxy result",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        }
      ],
      "audit": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "proxy result",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        }
      ]
    }
  }
}
