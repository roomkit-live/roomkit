{
  "$schema": "../../scenario.schema.json",
  "id": "ai-external-handler/cut-with-held-observer-keeps-one-report-non-streaming",
  "title": "Cut with held observer keeps one report (non-streaming)",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-6.4-397",
    "RK-9.3-052"
  ],
  "notes": "Python: tests/test_external_call_cut.py::test_a_call_cut_while_its_observers_run_is_reported_once. Both the real observer and next generation reach deterministic gates, proving the turn remains live before cancellation; close drains the released observer. Each local/external occurrence is observed once.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "external_tool_handler": {
          "decisions": [
            {
              "approved": true,
              "result": "proxy result"
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "parameters": {
              "type": "object"
            },
            "returns": "local result"
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "",
              "calls": [
                {
                  "id": "p1",
                  "name": "remote",
                  "arguments": {
                    "q": "original"
                  }
                },
                {
                  "id": "l1",
                  "name": "lookup",
                  "arguments": {
                    "q": "original"
                  }
                }
              ]
            },
            {
              "text": "Done.",
              "gate": "generating"
            }
          ],
          "streaming": false
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "sync",
        "trigger": "on_tool_call",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async",
        "reactions": [
          {
            "gate": "observing"
          }
        ],
        "timeout_ms": 10000
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "defer_delivery": true,
      "as": "turn"
    },
    {
      "wait_for": "observing"
    },
    {
      "wait_for": "generating"
    },
    {
      "call": "delivery.cancel",
      "of": "turn",
      "reason": "cut"
    },
    {
      "open": "observing"
    },
    {
      "open": "generating"
    },
    {
      "call": "close"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "external_handlers": {
      "agent": [
        {
          "method": "process_tool_call",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r"
        },
        {
          "method": "on_tool_result",
          "channel_id": "agent",
          "name": "remote",
          "arguments": {
            "q": "original"
          },
          "tool_call_id": "p1",
          "room_id": "r",
          "result": "proxy result",
          "is_error": false
        }
      ]
    },
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "name": "remote",
              "content": "proxy result",
              "tool_call_id": "p1",
              "is_error": false
            },
            {
              "name": "lookup",
              "content": "local result",
              "tool_call_id": "l1",
              "is_error": false
            }
          ]
        }
      ]
    },
    "hooks": {
      "before": [
        {
          "tool_call": {
            "name": "lookup"
          }
        }
      ],
      "sync": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "proxy result",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        },
        {
          "tool_call": {
            "name": "lookup",
            "tool_call_id": "l1",
            "arguments": {
              "q": "original"
            },
            "result": "local result",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        }
      ],
      "audit": [
        {
          "tool_call": {
            "name": "remote",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "proxy result",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        },
        {
          "tool_call": {
            "name": "lookup",
            "tool_call_id": "l1",
            "arguments": {
              "q": "original"
            },
            "result": "local result",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        }
      ]
    }
  }
}
