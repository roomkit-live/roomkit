          "type": "text",
          "body": "observation"
        }
      }
    },
    {
      "call": "store.commit_event",
      "room_id": "room-1",
      "event": {
        "type": "tool_call_start",
        "content": {
          "type": "tool_call",
          "tool_name": "lookup",
          "tool_id": "call-1"
        }
      }
    },
    {
      "call": "store.commit_event",
      "room_id": "room-1",
      "event": {
        "type": "tool_call_end",
