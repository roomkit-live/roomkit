        "type": "reaction",
        "content": {
          "type": "text",
          "body": "reaction"
        }
      }
    },
    {
      "call": "store.commit_event",
      "room_id": "room-1",
      "event": {
        "type": "edit",
        "content": {
          "type": "edit",
          "target_event_id": "room-1#0",
          "new_content": {
            "type": "text",
            "body": "edited"
          }
        }
      }
    },
    {
      "call": "store.commit_event",
      "room_id": "room-1",
