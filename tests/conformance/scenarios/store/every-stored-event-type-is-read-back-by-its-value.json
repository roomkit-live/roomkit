{
  "$schema": "../../scenario.schema.json",
  "id": "store/every-stored-event-type-is-read-back-by-its-value",
  "title": "An event of each type the RFC stores is read back with its type, by its serialized value",
  "rules": [
    "§5.2",
    "§14.1"
  ],
  "requirements": [
    "RK-5.2-002"
  ],
  "notes": "One event of each EventType a room stores, committed through the store and read back in index order. INSTRUCTION is never stored (§10.1.1), nor are TASK_DELEGATED and TASK_COMPLETED, the payloads of their hooks (§23.5), nor TYPING and PRESENCE, published without being stored (§8.4): their behaviours are their own units'. An INSTRUCTION_READ is visible to its agent alone (§10.1.1), so it is written with that visibility; the store reads every row back whatever its visibility.",
  "steps": [
    {
      "call": "store.create_room",
      "room": {
        "id": "room-1"
      }
    },
    {
      "call": "store.commit_event",
      "room_id": "room-1",
      "event": {
        "type": "message",
        "content": {
          "type": "text",
          "body": "message"
        }
      }
    },
    {
      "call": "store.commit_event",
      "room_id": "room-1",
      "event": {
        "type": "system",
        "content": {
          "type": "text",
          "body": "system"
        }
      }
    },
    {
      "call": "store.commit_event",
      "room_id": "room-1",
      "event": {
        "type": "read_receipt",
        "content": {
          "type": "text",
          "body": "read_receipt"
        }
      }
    },
    {
      "call": "store.commit_event",
      "room_id": "room-1",
      "event": {
        "type": "delivery_receipt",
        "content": {
          "type": "text",
          "body": "delivery_receipt"
        }
      }
    },
    {
      "call": "store.commit_event",
