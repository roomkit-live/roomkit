{
  "$schema": "../../scenario.schema.json",
  "id": "store/an-added-event-keeps-its-index-and-the-room-s-next-is-past-it",
  "title": "An event added keeps the index it carries, an auto-indexed one and a commit take the room's next index past every index given out, a deleted one included, and only a commit moves the room's counters",
  "rules": [
    "§14.1",
    "§14.3",
    "§8.1"
  ],
  "notes": "Python: tests/test_store_memory.py::TestCursorPagination::test_auto_index_does_not_reuse_deleted_latest_index, TestDeleteEvent::test_commit_after_deleting_latest_keeps_index_monotonic. add_event writes the event as it is, its index the caller's; add_event_auto_index gives it the room's next index; neither moves event_count nor latest_index, which only a commit moves (§10.1 step 12).",
  "steps": [
    {
      "call": "store.create_room",
      "room": {
        "id": "room-1"
      }
    },
    {
      "call": "store.add_event",
      "event": {
        "room_id": "room-1",
        "index": 1,
        "content": {
          "type": "text",
          "body": "one"
        }
      },
      "expect": {
        "result": {
          "index": 1
        }
      }
    },
    {
      "call": "store.add_event",
      "event": {
        "room_id": "room-1",
        "index": 0,
        "content": {
          "type": "text",
          "body": "zero"
        }
      },
      "expect": {
        "result": {
          "index": 0
        }
      }
    },
    {
      "call": "store.add_event_auto_index",
      "room_id": "room-1",
      "event": {
        "content": {
          "type": "text",
          "body": "two"
        }
      },
      "expect": {
        "result": {
          "index": 2
        }
      }
    },
    {
      "call": "store.commit_event",
      "room_id": "room-1",
      "event": {
        "content": {
          "type": "text",
          "body": "three"
        }
      },
      "as": "three",
      "expect": {
        "result": {
          "index": 3
        }
      }
    },
    {
      "call": "store.delete_event",
      "room_id": "room-1",
      "event_id": "$three",
      "expect": {
        "result": [
          {
            "index": 3
          }
        ]
      }
    },
    {
      "call": "store.add_event_auto_index",
      "room_id": "room-1",
      "event": {
        "content": {
          "type": "text",
          "body": "four"
        }
      },
      "expect": {
        "result": {
          "index": 4
        }
      }
    },
    {
      "call": "store.commit_event",
      "room_id": "room-1",
      "event": {
        "content": {
          "type": "text",
          "body": "five"
        }
      },
      "expect": {
        "result": {
          "index": 5
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "zero"
          }
        },
        {
          "index": 1,
          "content": {
            "body": "one"
          }
        },
        {
          "index": 2,
          "content": {
            "body": "two"
          }
        },
        {
          "index": 4,
          "content": {
            "body": "four"
          }
        },
        {
          "index": 5,
          "content": {
            "body": "five"
          }
        }
      ]
    },
    "rooms": {
      "room-1": {
        "event_count": 2,
        "latest_index": 5
      }
    }
  }
}
