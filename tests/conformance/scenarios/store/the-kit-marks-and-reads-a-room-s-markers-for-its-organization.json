{
  "$schema": "../../scenario.schema.json",
  "id": "store/the-kit-marks-and-reads-a-room-s-markers-for-its-organization",
  "title": "The kit marks a room read and lists its markers, one per channel: for an organization, only a room of that organization, another's not found and left unmarked",
  "rules": [
    "§14.1",
    "§17.2"
  ],
  "notes": "Python: tests/test_room_org_scoping.py::TestRoomOrgScoping::test_query_and_read_tracking_operations_share_the_room_scope (its read markers); tests/test_participant_membership.py::TestReadMarkerAggregation::test_list_read_markers_empty, test_list_read_markers_per_channel. Without an organization the kit reads the store as it is, a room it lacks holding no marker.",
  "steps": [
    {
      "call": "store.create_room",
      "room": {
        "id": "globex-room",
        "organization_id": "globex"
      }
    },
    {
      "call": "store.commit_event",
      "room_id": "globex-room",
      "event": {
        "content": {
          "type": "text",
          "body": "m0"
        }
      },
      "as": "first"
    },
    {
      "call": "store.commit_event",
      "room_id": "globex-room",
      "event": {
        "content": {
          "type": "text",
          "body": "m1"
        }
      },
      "as": "last"
    },
    {
      "call": "list_read_markers",
      "room_id": "globex-room",
      "expect": {
        "result": {
          "ws:u1:r1": {
            "$absent": true
          }
        }
      }
    },
    {
      "call": "mark_read",
      "room_id": "globex-room",
      "channel_id": "sms1",
      "event_id": "$last",
      "organization_id": "acme",
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "call": "mark_all_read",
      "room_id": "globex-room",
      "channel_id": "sms1",
      "organization_id": "acme",
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "call": "list_read_markers",
      "room_id": "globex-room",
      "organization_id": "acme",
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "call": "list_read_markers",
      "room_id": "globex-room",
      "expect": {
        "result": {
          "sms1": {
            "$absent": true
          }
        }
      }
    },
    {
      "call": "mark_read",
      "room_id": "globex-room",
      "channel_id": "ws:u1:r1",
      "event_id": "$last",
      "organization_id": "globex"
    },
    {
      "call": "mark_read",
      "room_id": "globex-room",
      "channel_id": "ws:u2:r1",
      "event_id": "$first"
    },
    {
      "call": "list_read_markers",
      "room_id": "globex-room",
      "expect": {
        "result": {
          "ws:u1:r1": 1,
          "ws:u2:r1": 0
        }
      }
    },
    {
      "call": "mark_all_read",
      "room_id": "globex-room",
      "channel_id": "ws:u2:r1",
      "organization_id": "globex"
    },
    {
      "call": "list_read_markers",
      "room_id": "globex-room",
      "organization_id": "globex",
      "expect": {
        "result": {
          "ws:u1:r1": 1,
          "ws:u2:r1": 1
        }
      }
    },
    {
      "call": "list_read_markers",
      "room_id": "no-such-room",
      "expect": {
        "result": {
          "ws:u1:r1": {
            "$absent": true
          }
        }
      }
    }
  ]
}
