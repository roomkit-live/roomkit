{
  "$schema": "../../scenario.schema.json",
  "id": "store/the-latest-room-is-the-newest-the-greatest-id-breaking-a-tie",
  "title": "The latest room is the last created, the greatest id by code point among rooms created at one instant, of the status asked",
  "rules": [
    "§14.1"
  ],
  "notes": "Python: tests/test_store_room_contract.py::test_the_latest_room_breaks_a_tie_by_id_in_every_store, test_ids_compare_by_code_point_in_every_store; tests/test_store_memory.py::TestFindLatestRoomIndex::test_latest_wins_across_rooms. A room of a greater id created earlier is not the latest; ids compare by code point, \"room-B\" before \"room-a\".",
  "steps": [
    {
      "call": "store.create_room",
      "room": {
        "id": "room-z",
        "created_at": "2026-01-01T00:00:01Z"
      }
    },
    {
      "call": "store.create_room",
      "room": {
        "id": "room-closed",
        "created_at": "2026-01-01T00:00:00Z",
        "status": "closed"
      }
    },
    {
      "call": "store.create_room",
      "room": {
        "id": "room-a",
        "created_at": "2026-01-01T00:00:02Z"
      }
    },
    {
      "call": "store.create_room",
      "room": {
        "id": "room-B",
        "created_at": "2026-01-01T00:00:02Z"
      }
    },
    {
      "call": "store.create_room",
      "room": {
        "id": "room-Z",
        "created_at": "2026-01-01T00:00:02Z"
      }
    },
    {
      "call": "store.add_participant",
      "participant": {
        "id": "p",
        "room_id": "room-z",
        "channel_id": "sms"
      }
    },
    {
      "call": "store.add_participant",
      "participant": {
        "id": "p",
        "room_id": "room-closed",
        "channel_id": "sms"
      }
    },
    {
      "call": "store.add_participant",
      "participant": {
        "id": "p",
        "room_id": "room-a",
        "channel_id": "sms"
      }
    },
    {
      "call": "store.add_participant",
      "participant": {
        "id": "p",
        "room_id": "room-B",
        "channel_id": "sms"
      }
    },
    {
      "call": "store.add_participant",
      "participant": {
        "id": "p",
        "room_id": "room-Z",
        "channel_id": "sms"
      }
    },
    {
      "call": "store.find_latest_room",
      "participant_id": "p",
      "expect": {
        "result": {
          "id": "room-a"
        }
      }
    },
    {
      "call": "store.find_latest_room",
      "participant_id": "p",
      "status": "closed",
      "expect": {
        "result": {
          "id": "room-closed"
        }
      }
    },
    {
      "call": "store.find_latest_room",
      "participant_id": "p",
      "status": "archived",
      "expect": {
        "result": null
      }
    }
  ]
}
