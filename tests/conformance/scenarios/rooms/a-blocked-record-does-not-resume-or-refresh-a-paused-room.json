{
  "title": "A blocked record leaves the paused room and its activity unchanged",
  "rules": [
    "§5.1"
  ],
  "notes": "Python: tests/test_room_timers.py::test_what_is_no_activity_resumes_nothing; tests/test_room_activity.py. The old activity is the earliest instant (@1); each operation must keep it.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "status": "paused",
        "timers": {
          "last_activity_at": "2026-01-01T11:00:00Z"
        },
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "refuse",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "repeat": true,
            "result": {
              "action": "block",
              "reason": "refused"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "event": {
            "status": "blocked"
          }
        }
      },
      "room_id": "room-1"
    }
  ],
  "expect": {
    "rooms": {
      "room-1": {
        "status": "paused",
        "timers": {
          "last_activity_at": "@1"
        }
      }
    },
    "framework_events": {
      "room-1": [
        {
          "event": "event_blocked",
          "reason": "refused",
          "blocked_by": "refuse"
        }
      ]
    }
  },
  "id": "rooms/a-blocked-record-does-not-resume-or-refresh-a-paused-room",
  "$schema": "../../scenario.schema.json"
}
