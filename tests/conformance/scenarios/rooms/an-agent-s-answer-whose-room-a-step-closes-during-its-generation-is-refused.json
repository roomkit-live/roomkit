{
  "$schema": "../../scenario.schema.json",
  "id": "rooms/an-agent-s-answer-whose-room-a-step-closes-during-its-generation-is-refused",
  "title": "An agent's answer whose room is closed while its generation runs is refused, nothing of it stored or delivered",
  "rules": [
    "§5.1",
    "§8.2",
    "§10.1 step 14",
    "§10.6.1",
    "§26.1"
  ],
  "notes": "The agent's model holds its round at a gate and calls no kit; a step closes the room, then the round answers. Each streamed row's commit reads the room's status (§5.1, §10.2), whatever executor ran the turn, one of another process included (§10.6.1). The framework events are left out: whether a refused streamed row emits room_refused_event is open (RMK-1665).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "generate",
              "text": "Too late"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "background": true,
      "as": "a"
    },
    {
      "wait_for": "generate"
    },
    {
      "call": "close_room",
      "room_id": "room-1",
      "expect": {
        "result": {
          "status": "closed"
        }
      }
    },
    {
      "open": "generate"
    },
    {
      "await": "a",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "status": "delivered"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "Hello"
          }
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "sms": []
      }
    },
    "rooms": {
      "room-1": {
        "status": "closed"
      }
    }
  }
}
