{
  "$schema": "../../scenario.schema.json",
  "id": "rooms/a-metadata-update-of-a-group-binding-names-no-one",
  "title": "A binding metadata update on a group binding writes the recipient in the channel's form and names no correspondent",
  "rules": [
    "§5.7",
    "§7.2",
    "§10.4"
  ],
  "notes": "A group binding is one conversation whoever writes on it, so its recipient names no one.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {
          "normalizes": {
            "555-000-0001": "+15550000001",
            "555.000.0002": "+15550000002"
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "store.add_binding",
      "binding": {
        "room_id": "r1",
        "channel_id": "sms",
        "channel_type": "sms",
        "group": true
      }
    },
    {
      "call": "update_binding_metadata",
      "room_id": "r1",
      "channel_id": "sms",
      "metadata": {
        "phone_number": "555.000.0002"
      },
      "expect": {
        "result": {
          "participant_id": null,
          "metadata": {
            "phone_number": "+15550000002"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "r1": {
        "sms": {
          "participant_id": null,
          "metadata": {
            "phone_number": "+15550000002"
          }
        }
      }
    }
  }
}
