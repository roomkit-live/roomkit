{
  "$schema": "../../scenario.schema.json",
  "id": "rooms/resume-from-every-room-status",
  "title": "Resume from every room status: accepted transitions, no-ops and refusals",
  "rules": [
    "§5.1",
    "§8.2",
    "§17.2",
    "§26.1"
  ],
  "notes": "Python: tests/test_room_transitions.py. Whole-room equality checks timestamps and state on no-op/refusal; specialized store-write assertions are still needed to prove that equal values were not written. Setup reaches each status through public transitions before observation starts.",
  "setup": {
    "rooms": [
      {
        "id": "active",
        "status": "active"
      },
      {
        "id": "paused",
        "status": "paused"
      },
      {
        "id": "closed",
        "status": "closed"
      },
      {
        "id": "archived",
        "status": "archived"
      }
    ],
    "hooks": [
      {
        "name": "paused",
        "trigger": "on_room_paused",
        "execution": "async"
      },
      {
        "name": "closed",
        "trigger": "on_room_closed",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "store.get_room",
      "room_id": "active",
      "expect": {
        "result": {
          "$as": "before-active"
        }
      }
    },
    {
      "call": "resume_room",
      "room_id": "active",
      "expect": {
        "result": {
          "$as": "before-active"
        }
      }
    },
    {
      "call": "store.get_room",
      "room_id": "active",
      "expect": {
        "result": {
          "$as": "before-active"
        }
      }
    },
    {
      "call": "resume_room",
      "room_id": "paused",
      "expect": {
        "result": {
          "status": "active",
          "paused_at": null,
          "closed_at": null
        }
      }
    },
    {
      "call": "store.get_room",
      "room_id": "closed",
      "expect": {
        "result": {
          "$as": "before-closed"
        }
      }
    },
    {
      "call": "resume_room",
      "room_id": "closed",
      "expect": {
        "error": "transition_refused"
      }
    },
    {
      "call": "store.get_room",
      "room_id": "closed",
      "expect": {
        "result": {
          "$as": "before-closed"
        }
      }
    },
    {
      "call": "store.get_room",
      "room_id": "archived",
      "expect": {
        "result": {
          "$as": "before-archived"
        }
      }
    },
    {
      "call": "resume_room",
      "room_id": "archived",
      "expect": {
        "error": "transition_refused"
      }
    },
    {
      "call": "store.get_room",
      "room_id": "archived",
      "expect": {
        "result": {
          "$as": "before-archived"
        }
      }
    }
  ],
  "expect": {
    "rooms": {
      "active": {
        "status": "active"
      },
      "paused": {
        "status": "active"
      },
      "closed": {
        "status": "closed"
      },
      "archived": {
        "status": "archived"
      }
    },
    "timeline": {
      "active": [],
      "paused": [],
      "closed": [],
      "archived": []
    },
    "hooks": {
      "paused": [],
      "closed": []
    },
    "framework_events": {
      "active": [],
      "paused": [],
      "closed": [],
      "archived": []
    }
  }
}
