{
  "$schema": "../../scenario.schema.json",
  "id": "rooms/a-response-after-room-deletion-reports-a-null-status",
  "title": "A response landing after its room was deleted is refused with a null status",
  "rules": [
    "§5.1",
    "§8.2",
    "§10.1 step 14",
    "§26.1"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "do": [
              {
                "call": "close_room",
                "room_id": "$room",
                "as": "close"
              },
              {
                "call": "store.delete_room",
                "room_id": "$room"
              }
            ],
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Too late"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "status": "delivered"
          }
        }
      }
    },
    {
      "call": "get_room",
      "room_id": "room-1",
      "expect": {
        "error": "room_not_found"
      }
    }
  ],
  "expect": {
    "deliveries": {
      "room-1": {
        "sms": []
      }
    },
    "framework_events": {
      "room-1": [
        "room_closed",
        {
          "$unordered": [
            {
              "event": "room_refused_event",
              "status": null,
              "operation": "reentry",
              "event_type": "message"
            },
            {
              "event": "event_processed"
            }
          ]
        }
      ]
    }
  },
  "notes": "Python: tests/test_rfc_write_gates.py::TestReentryMeetsTheStatusGate::test_a_room_deleted_meanwhile_refuses_with_a_null_status."
}
