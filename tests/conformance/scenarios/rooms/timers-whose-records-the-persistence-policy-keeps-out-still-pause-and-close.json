{
  "$schema": "../../scenario.schema.json",
  "id": "rooms/timers-whose-records-the-persistence-policy-keeps-out-still-pause-and-close",
  "title": "A check long after both timers fell due pauses and closes the room, each transition announced and its hook fired, while the persistence policy keeps their lifecycle records out of the timeline",
  "rules": [
    "§5.1",
    "§9.2",
    "§8.2",
    "§14.3"
  ],
  "notes": "Python: core/_timer_transitions.py _announce (the record written through the policy, then the framework event, whatever the record became). As rooms/timers-pause-then-close-in-one-check, under a policy that stores messages only.",
  "setup": {
    "kit": {
      "persistence_policy": {
        "persist_types": [
          "message"
        ]
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ],
    "hooks": [
      {
        "name": "paused",
        "trigger": "on_room_paused",
        "execution": "async"
      },
      {
        "name": "closed",
        "trigger": "on_room_closed",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "create_room",
      "room": {
        "id": "room-1",
        "timers": {
          "inactive_after_seconds": 0,
          "closed_after_seconds": 0
        }
      }
    },
    {
      "call": "check_timers",
      "room_id": "room-1",
      "expect": {
        "result": {
          "status": "closed"
        }
      }
    }
  ],
  "expect": {
    "rooms": {
      "room-1": {
        "status": "closed",
        "event_count": 0,
        "latest_index": null
      }
    },
    "hooks": {
      "paused": [
        {
          "trigger": "on_room_paused",
          "room_id": "room-1",
          "context_room": {
            "status": "closed",
            "paused_at": null
          }
        }
      ],
      "closed": [
        {
          "trigger": "on_room_closed",
          "room_id": "room-1",
          "context_room": {
            "status": "closed",
            "paused_at": null
          }
        }
      ]
    },
    "framework_events": {
      "room-1": [
        "room_created",
        {
          "event": "room_paused",
          "reason": "timer"
        },
        {
          "event": "room_closed",
          "reason": "timer"
        }
      ]
    },
    "lifecycle": {
      "room-1": []
    }
  }
}
