{
  "$schema": "../../scenario.schema.json",
  "id": "rooms/a-refused-attach-leaves-nothing-behind",
  "title": "A channel that refuses its attach fails the call, keeps no binding and announces nothing",
  "rules": [
    "§6.1",
    "§5.7"
  ],
  "notes": "Translates roomkit tests/test_channel_attach_contract.py::TestRefusedAttach (test_the_failure_reaches_the_caller, test_no_binding_survives, test_nothing_was_announced) and TestRefusedReattach::test_a_first_attach_still_leaves_nothing_behind.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "on_room_attached": [
          {
            "fail": "the outside world said no"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "observer",
        "trigger": "on_channel_attached",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "attach_channel",
      "room_id": "r1",
      "channel_id": "sms",
      "expect": {
        "error": "channel_failed"
      }
    },
    {
      "call": "detach_channel",
      "room_id": "r1",
      "channel_id": "sms",
      "expect": {
        "error": "channel_not_bound"
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "bindings": {
      "r1": {
        "sms": null
      }
    },
    "hooks": {
      "observer": []
    },
    "framework_events": {
      "r1": []
    },
    "lifecycle": {
      "r1": []
    },
    "room_callbacks": {
      "r1": {
        "sms": [
          {
            "call": "on_room_attached",
            "binding": {
              "channel_id": "sms"
            }
          }
        ]
      }
    }
  }
}
