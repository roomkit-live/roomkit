{
  "$schema": "../../scenario.schema.json",
  "id": "rooms/a-metadata-update-names-its-correspondent-in-the-channel-s-form",
  "title": "A binding metadata update writes the recipient in the channel's form, and a recipient on a binding naming no one names its correspondent",
  "rules": [
    "§5.7",
    "§7.2",
    "§10.4"
  ],
  "notes": "As an attach does (rooms/an-attach-names-its-correspondent-in-the-channel-s-form): roomkit's _named_correspondent runs on the merged binding. The other keys of the update are kept as written.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {
          "normalizes": {
            "555-000-0001": "+15550000001",
            "555.000.0002": "+15550000002"
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "update_binding_metadata",
      "room_id": "r1",
      "channel_id": "sms",
      "metadata": {
        "phone_number": "555.000.0002",
        "team": "blue"
      },
      "expect": {
        "result": {
          "participant_id": "+15550000002",
          "metadata": {
            "phone_number": "+15550000002",
            "team": "blue"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "r1": {
        "sms": {
          "participant_id": "+15550000002",
          "metadata": {
            "phone_number": "+15550000002",
            "team": "blue"
          }
        }
      }
    },
    "lifecycle": {
      "r1": [
        {
          "type": "channel_attached"
        },
        {
          "type": "channel_updated"
        }
      ]
    }
  }
}
