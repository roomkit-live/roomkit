{
  "$schema": "../../scenario.schema.json",
  "id": "sandbox/an-empty-catalogue-non-streaming",
  "title": "The channel closes a sandbox with an empty catalogue (non-streaming)",
  "rules": [
    "§6.4",
    "§9.3",
    "§21.1"
  ],
  "notes": "Python: tests/test_sandbox_contract.py and tests/test_tool_policy_exemptions.py. The host fixture records invocations; it starts no process and applies no framework guards.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "agent",
        "type": "ai",
        "system_prompt": "Host instructions.",
        "sandbox": {
          "tools": []
        },
        "model": {
          "streaming": false,
          "rounds": [
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Read"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "sandbox_executors": {
      "agent": {
        "calls": [],
        "closes": 1
      }
    },
    "models": {
      "agent": [
        {
          "tools": {
            "sandbox_bash": {
              "$absent": true
            },
            "host_only": {
              "$absent": true
            }
          },
          "system_prompt": {
            "$lacks": "Do not assume it is isolated from the host machine."
          }
        }
      ]
    }
  }
}
