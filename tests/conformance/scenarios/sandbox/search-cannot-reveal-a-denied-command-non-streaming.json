{
  "$schema": "../../scenario.schema.json",
  "id": "sandbox/search-cannot-reveal-a-denied-command-non-streaming",
  "title": "Tool Search cannot reveal a denied sandbox command (non-streaming)",
  "rules": [
    "§6.4",
    "§9.3",
    "§21.1"
  ],
  "notes": "Python: tests/test_sandbox_contract.py and tests/test_tool_policy_exemptions.py. The host fixture records invocations; it starts no process and applies no framework guards.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "agent",
        "type": "ai",
        "system_prompt": "Host instructions.",
        "sandbox": {
          "tools": [
            {
              "name": "sandbox_read",
              "description": "Read file contents from the sandbox.",
              "parameters": {
                "type": "object"
              }
            },
            {
              "name": "sandbox_grep",
              "description": "Regex pattern search across the workspace.",
              "parameters": {
                "type": "object"
              }
            }
          ]
        },
        "model": {
          "streaming": false,
          "rounds": [
            {
              "calls": [
                {
                  "id": "s1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "read file contents"
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        },
        "tool_search": true,
        "tool_policy": {
          "allow": [
            "host_only"
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "ada",
        "content": {
          "type": "text",
          "body": "Read"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "sandbox_executors": {
      "agent": {
        "calls": [],
        "closes": 1
      }
    },
    "models": {
      "agent": [
        {
          "tools": {
            "sandbox_read": {
              "$absent": true
            },
            "sandbox_grep": {
              "$absent": true
            },
            "find_tools": {
              "$present": true
            }
          },
          "system_prompt": {
            "$lacks": "Do not assume it is isolated from the host machine."
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "s1",
              "name": "find_tools",
              "content": {
                "$lacks": "sandbox_"
              },
              "is_error": false
            }
          ],
          "tools": {
            "sandbox_read": {
              "$absent": true
            },
            "sandbox_grep": {
              "$absent": true
            }
          }
        }
      ]
    }
  }
}
