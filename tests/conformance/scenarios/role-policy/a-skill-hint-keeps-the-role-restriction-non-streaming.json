{
  "$schema": "../../scenario.schema.json",
  "id": "role-policy/a-skill-hint-keeps-the-role-restriction-non-streaming",
  "title": "A mistaken skill name suggests only tools the role admits (non-streaming)",
  "rules": [
    "§21.1",
    "§24.3",
    "§6.4"
  ],
  "notes": "Python: tests/test_tool_policy_exemptions.py::test_a_skill_name_hint_offers_only_reachable_tools. The model result excludes tenant_delete; the hook independently confirms tenant_export is present in that same hint. No ordinary handler runs.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "agent",
        "type": "ai",
        "audit": "tool_auditor",
        "tool_search": false,
        "tool_policy": {
          "role_overrides": {
            "observer": {
              "deny": [
                "tenant_delete"
              ]
            }
          }
        },
        "tools": [
          {
            "name": "tenant_export",
            "description": "Export.",
            "returns": "export"
          },
          {
            "name": "tenant_delete",
            "description": "Delete.",
            "returns": "delete"
          }
        ],
        "skills": [
          {
            "name": "ops",
            "description": "Operations",
            "instructions": "Use operations tools.",
            "scripts": {
              "deploy.sh": "exit 0"
            }
          }
        ],
        "model": {
          "streaming": false,
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "activate_skill",
                  "arguments": {
                    "name": "tenant"
                  }
                }
              ]
            },
            {
              "text": "done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "participants": [
          {
            "id": "observer",
            "room_id": "r1",
            "channel_id": "ws",
            "role": "observer"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "observer",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$lacks": "tenant_delete"
              }
            }
          ]
        }
      ]
    },
    "hooks": {
      "audit": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "result": {
              "$contains": "tenant_export"
            }
          }
        }
      ]
    },
    "tool_audit": {
      "$unordered": []
    }
  }
}
