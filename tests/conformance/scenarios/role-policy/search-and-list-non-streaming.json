{
  "$schema": "../../scenario.schema.json",
  "id": "role-policy/search-and-list-non-streaming",
  "title": "A role policy governs search and list (non-streaming)",
  "rules": [
    "§6.4",
    "§21.1",
    "§5.5"
  ],
  "requirements": [
    "RK-21.1-016",
    "RK-21.1-061",
    "RK-21.1-062",
    "RK-21.1-063",
    "RK-21.1-073"
  ],
  "notes": "Python: tests/test_tool_search_text.py::TestPolicyExemption::test_find_tools_runs_under_whitelist_policy, tests/test_tool_policy_exemptions.py::test_tool_search_names_no_denied_or_gated_tool. Role-selection counterpart of tool-search/tool-search-names-no-denied-tool-and-runs-under-an-allow-list; the channel base admits everything except in the owner-replace case. The original public oracle is retained, with an exhaustive wrapped-handler audit. widget_0 is denied by the selected role; widget_1 is admitted by the role but gated by an inactive skill. Model results assert an allowed tool is found and listed; separate tool-hook observers assert both hidden names are absent from both results.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "send sms"
                  }
                },
                {
                  "id": "c2",
                  "name": "list_tools"
                }
              ]
            },
            {
              "text": "Done."
            }
          ],
          "streaming": false
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Send an SMS text message with a widget.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Send an SMS text message with a widget.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true,
        "tool_policy": {
          "role_overrides": {
            "observer": {
              "allow": [
                "send_sms",
                "widget_1"
              ]
            }
          }
        },
        "audit": "tool_auditor",
        "skills": [
          {
            "name": "messaging",
            "description": "Messaging procedure",
            "instructions": "Rules for messaging.",
            "allowed_tools": [
              "widget_1"
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "participants": [
          {
            "id": "alice",
            "room_id": "room-1",
            "channel_id": "ws",
            "role": "observer"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "role_denied",
        "trigger": "on_tool_call",
        "execution": "async"
      },
      {
        "name": "skill_gated",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "find_tools": "$any",
            "list_tools": "$any",
            "widget_0": {
              "$absent": true
            },
            "widget_1": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "send_sms": "$any",
            "find_tools": "$any",
            "list_tools": "$any",
            "widget_0": {
              "$absent": true
            },
            "widget_1": {
              "$absent": true
            }
          },
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"matches\": [{\"name\": \"send_sms\", \"description\": \"Send an SMS text message to a phone number.\"}], \"_note\": \"These tools are now invocable \\u2014 their full schemas are in your tool list. Call the right one directly. Do not call find_tools again unless none of these fit.\"}",
              "is_error": false
            },
            {
              "tool_call_id": "c2",
              "is_error": false,
              "content": {
                "$contains": "send_sms"
              }
            }
          ]
        }
      ]
    },
    "tool_audit": {
      "$unordered": []
    },
    "hooks": {
      "role_denied": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "result": {
              "$lacks": "widget_0"
            }
          }
        },
        {
          "tool_call": {
            "tool_call_id": "c2",
            "result": {
              "$lacks": "widget_0"
            }
          }
        }
      ],
      "skill_gated": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "result": {
              "$lacks": "widget_1"
            }
          }
        },
        {
          "tool_call": {
            "tool_call_id": "c2",
            "result": {
              "$lacks": "widget_1"
            }
          }
        }
      ]
    }
  }
}
