{
  "$schema": "../../scenario.schema.json",
  "rules": [
    "§6.4",
    "§21.4"
  ],
  "requirements": [
    "RK-21.4-022"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tool_search": false,
        "tools": [
          {
            "name": "inspect",
            "description": "inspect",
            "parameters": {
              "type": "object"
            },
            "returns_allowed_names": true
          },
          {
            "name": "book",
            "description": "book",
            "parameters": {
              "type": "object"
            },
            "returns": "ok"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "inspect"
                }
              ]
            },
            {
              "text": "done"
            }
          ],
          "streaming": true
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "[\"book\", \"inspect\", \"read_stored_result\"]",
              "is_error": false
            }
          ]
        }
      ]
    }
  },
  "notes": "Python: tests/test_tool_context.py::TestCurrentToolAllowedNames; tests/test_toolset_edges.py::test_the_reread_tool_is_offered_before_any_result_is_stored.",
  "id": "tool-allowed-names/a-handler-reads-the-resolved-catalogue-and-first-round-reread-streaming",
  "title": "A handler reads the resolved catalogue and first round reread (streaming)"
}
