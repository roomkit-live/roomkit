{
  "$schema": "../../scenario.schema.json",
  "id": "acp/tools-cut-during-report",
  "title": "A completed ACP call is reported once even when its turn is cancelled during the synchronous report hook",
  "rules": [
    "§6.4",
    "§9.3",
    "Appendix A.9.1"
  ],
  "notes": "Python: channels/_acp_events.py::_merge_tool, _emit_tool_start, _emit_tool_end, _close_open_tools; channels/_acp_turn.py::_stream and _report_response; tests/test_channels/test_acp.py tools, abandoned calls, persisted markers and end-of-turn reports. Active room turns without an external permission handler; no permission-policy, plan, media or out-of-turn claim. Source: tests/test_tool_call_reports.py::test_an_acp_call_whose_report_is_cut_is_still_reported_once, no-handler variant.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "updates": [
                  {
                    "sessionUpdate": "tool_call",
                    "toolCallId": "call-1",
                    "title": "Read",
                    "status": "in_progress"
                  },
                  {
                    "sessionUpdate": "tool_call_update",
                    "toolCallId": "call-1",
                    "status": "completed",
                    "rawOutput": "already ran"
                  }
                ],
                "after_updates_gate": "prompt-never-released"
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      },
      {
        "name": "tools",
        "trigger": "on_tool_call",
        "execution": "async"
      },
      {
        "name": "held",
        "trigger": "on_tool_call",
        "execution": "sync",
        "reactions": [
          {
            "gate": "report-held"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        },
        "delivery_key": "turn"
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "report-held"
    },
    {
      "call": "cancel_delivery",
      "key": "turn",
      "reason": "stopped",
      "expect": {
        "result": 1
      }
    },
    {
      "open": "report-held"
    },
    {
      "await": "turn"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "tool_events": {
      "room-1": [
        {
          "type": "tool_call_start",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "id": "$e1",
              "name": "Read"
            }
          ]
        },
        {
          "type": "tool_call_end",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "id": "$e1",
              "name": "Read",
              "status": "completed",
              "result": "already ran"
            }
          ]
        }
      ]
    },
    "hooks": {
      "tools": [
        {
          "room_id": "room-1",
          "tool_call": {
            "name": "Read",
            "arguments": {},
            "result": "already ran",
            "is_error": false,
            "cancelled": false,
            "refused": false,
            "error_detail": null
          }
        }
      ],
      "response": [],
      "held": [
        {
          "room_id": "room-1",
          "tool_call": {
            "name": "Read",
            "arguments": {},
            "result": "already ran",
            "is_error": false,
            "cancelled": false,
            "refused": false,
            "error_detail": null
          }
        }
      ]
    }
  }
}
