{
  "$schema": "../../scenario.schema.json",
  "id": "acp/context-host-before-request",
  "title": "The host's context blocks precede the current request",
  "rules": [
    "§6.4",
    "§19.3.2"
  ],
  "notes": "Python: tests/test_channels/test_acp.py::TestHostContext::test_blocks_precede_the_request_when_nothing_was_missed. Exact public ACP prompt attempts. Explicit message-only persistence isolates conversation indices; RMK-1447 separately tracks the default-policy lifecycle gap.",
  "setup": {
    "kit": {
      "persistence_policy": {
        "persist_types": [
          "message"
        ]
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {},
          "context_contributor": {
            "responses": [
              {
                "blocks": [
                  "Corpus: overdue"
                ]
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "what do I owe?"
      },
      "addressed_to": [
        "claude"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_prompts": {
      "claude": [
        {
          "text": "Corpus: overdue\n\nwhat do I owe?"
        }
      ]
    }
  }
}
