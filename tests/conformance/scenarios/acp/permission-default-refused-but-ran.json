{
  "$schema": "../../scenario.schema.json",
  "id": "acp/permission-default-refused-but-ran",
  "title": "Default refused but ran",
  "rules": [
    "§6.4",
    "§9.3",
    "Appendix A.9.1"
  ],
  "notes": "Python: tests/test_channels/test_acp.py::test_default_permission_policy_rejects, tests/test_tool_call_reports.py::test_an_acp_call_whose_permission_was_refused_is_refused, and channels/_acp_events.py::_permission_response/_record_decision. The wire reply is awaited before the agent reports an outcome. No external handler is installed; no custom-handler API credit.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "updates": [
                  {
                    "sessionUpdate": "tool_call",
                    "toolCallId": "call-1",
                    "title": "Read",
                    "status": "in_progress",
                    "rawInput": {
                      "path": "notes.txt"
                    }
                  }
                ],
                "permission_steps": [
                  {
                    "request": {
                      "toolCall": {
                        "toolCallId": "call-1",
                        "title": "Read",
                        "rawInput": {
                          "path": "notes.txt"
                        }
                      },
                      "options": [
                        {
                          "optionId": "reject-once",
                          "name": "reject_once",
                          "kind": "reject_once"
                        },
                        {
                          "optionId": "allow-once",
                          "name": "allow_once",
                          "kind": "allow_once"
                        }
                      ]
                    },
                    "updates": [
                      {
                        "sessionUpdate": "tool_call_update",
                        "toolCallId": "call-1",
                        "status": "completed",
                        "rawOutput": "ran anyway"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      },
      {
        "name": "tools",
        "trigger": "on_tool_call",
        "execution": "async"
      },
      {
        "name": "sync-tools",
        "trigger": "on_tool_call",
        "execution": "sync"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "Hello"
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "type": "tool_call",
            "tool_name": "Read",
            "tool_id": "call-1"
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "type": "tool_call",
            "tool_name": "Read",
            "tool_id": "call-1",
            "status": "completed",
            "outcome": "served",
            "refused_but_ran": true,
            "result": "ran anyway"
          }
        }
      ]
    },
    "hooks": {
      "tools": [
        {
          "room_id": "room-1",
          "tool_call": {
            "name": "Read",
            "arguments": {
              "path": "notes.txt"
            },
            "result": "ran anyway",
            "is_error": false,
            "cancelled": false,
            "refused": false,
            "error_detail": null,
            "refused_but_ran": true
          }
        }
      ],
      "response": [
        {
          "room_id": "room-1",
          "response": {
            "channel_id": "claude",
            "segments": [],
            "response_content": "",
            "tool_calls_count": 1,
            "streaming": true
          }
        }
      ],
      "sync-tools": [
        {
          "room_id": "room-1",
          "tool_call": {
            "name": "Read",
            "arguments": {
              "path": "notes.txt"
            },
            "result": "ran anyway",
            "is_error": false,
            "cancelled": false,
            "refused": false,
            "error_detail": null,
            "refused_but_ran": true
          }
        }
      ]
    },
    "acp_permissions": {
      "claude": [
        {
          "session_id": "session-1",
          "tool_call_id": "call-1",
          "result": {
            "outcome": {
              "outcome": "selected",
              "optionId": "reject-once"
            }
          }
        }
      ]
    }
  }
}
