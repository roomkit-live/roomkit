{
  "$schema": "../../scenario.schema.json",
  "id": "acp/cancel-targets-only-the-selected-room",
  "title": "Cancelling one idle room leaves the other ACP session usable",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_acp_session_setup.py::TestACancelReachesATurnWhileItsSessionOpens; tests/test_channels/test_acp_recovery.py::test_public_cancel_stops_reconstruction_before_prompt; test_acp.py::TestACPChannel::test_sessions_are_isolated_by_room_and_can_be_cancelled. Actual public cancel and wire ordering; no runner mutation of channel state. Standalone and the config-publication callback are distinct follow-ups.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {}
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "call": "acp.cancel",
      "channel_id": "claude",
      "room_id": "room-1",
      "expect": {
        "result": true
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Second room continues"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "claude": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new"
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1"
          }
        },
        {
          "method": "session/new"
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-2"
          }
        },
        {
          "method": "session/cancel",
          "params": {
            "sessionId": "session-1"
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-2"
          }
        }
      ]
    }
  }
}
