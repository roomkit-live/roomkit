{
  "$schema": "../../scenario.schema.json",
  "id": "acp/thinking-cancelled-prompt-closes-window",
  "title": "Public ACP cancel preserves a returned cancelled prompt and closes its thought window once",
  "rules": [
    "§6.4",
    "Appendix A.9.1"
  ],
  "notes": "Python: channels/_acp_events.py::_on_thought_chunk, channels/_acp_turn.py::_stream and _report_response; tests/test_channels/test_acp.py::TestACPChannel::test_streams_updates_and_reuses_room_session, TestEndOfTurnReport::test_a_finished_turn_reports_what_it_produced; test_acp_backend.py thinking privacy and per-room cases. This case covers thoughts only, not tool or plan updates.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true,
        "deliver_stream": [
          {
            "hold_after": "Working",
            "hold_gate": "reader"
          }
        ]
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "updates": [
                  {
                    "sessionUpdate": "agent_thought_chunk",
                    "content": {
                      "type": "text",
                      "text": "Before cancel"
                    }
                  },
                  {
                    "sessionUpdate": "agent_message_chunk",
                    "content": {
                      "type": "text",
                      "text": "Working"
                    }
                  }
                ],
                "after_updates_gate": "agent",
                "stop_reason": "cancelled"
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "reader"
    },
    {
      "call": "acp.cancel",
      "channel_id": "claude",
      "room_id": "room-1",
      "expect": {
        "result": true
      }
    },
    {
      "open": "agent"
    },
    {
      "open": "reader"
    },
    {
      "await": "turn",
      "expect": {
        "result": {
          "error": null,
          "response_metadata": {
            "acp": {
              "prompt_returned": true,
              "stop_reason": "cancelled",
              "interrupted": {
                "$absent": true
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "thinking_events": {
      "room-1": [
        {
          "type": "thinking_start",
          "thinking": "",
          "round": 0,
          "channel_id": "claude"
        },
        {
          "type": "thinking_delta",
          "thinking": {
            "$absent": true
          },
          "thinking_length": 13,
          "round": 0,
          "channel_id": "claude"
        },
        {
          "type": "thinking_end",
          "thinking": "",
          "round": 0,
          "channel_id": "claude"
        }
      ]
    },
    "hooks": {
      "response": [
        {
          "room_id": "room-1",
          "response": {
            "channel_id": "claude",
            "thinking": "Before cancel",
            "response_content": "Working",
            "segments": [
              "Working"
            ],
            "tool_calls_count": 0,
            "streaming": true,
            "loop_end_reason": "cancelled"
          }
        }
      ]
    },
    "acp_wire": {
      "claude": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new"
        },
        {
          "method": "session/prompt"
        },
        {
          "method": "session/cancel"
        }
      ]
    }
  }
}
