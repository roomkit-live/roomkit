{
  "$schema": "../../scenario.schema.json",
  "id": "acp/context-rebuild-replays-history",
  "title": "Authorized recovery rebuilds catch-up for the new session without another host callback",
  "rules": [
    "§6.4",
    "§19.3.2"
  ],
  "notes": "Python: tests/test_channels/test_acp.py::TestACPSessionRecovery::test_authorized_recovery_rebuilds_catch_up_without_interleaving. Exact public ACP prompt attempts. Explicit message-only persistence isolates conversation indices; RMK-1447 separately tracks the default-policy lifecycle gap.",
  "setup": {
    "kit": {
      "persistence_policy": {
        "persist_types": [
          "message"
        ]
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {},
          "context_contributor": {
            "responses": [
              {
                "blocks": [
                  "Host policy"
                ]
              },
              {
                "blocks": [
                  "Host policy"
                ]
              },
              {
                "blocks": [
                  "Host policy"
                ]
              }
            ]
          },
          "transport": {
            "refuse_prompt": [
              null,
              {
                "reason": "unusable",
                "recovery_authorized": true
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "earlier"
      },
      "addressed_to": [
        "claude"
      ]
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "retry"
      },
      "addressed_to": [
        "claude"
      ]
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "following"
      },
      "addressed_to": [
        "claude"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_prompts": {
      "claude": [
        {
          "text": "Host policy\n\nearlier"
        },
        {
          "text": "Host policy\n\nretry"
        },
        {
          "text": "Host policy\n\n[Room context — 1 message you did not receive. Context only; the request follows.]\n[1] @ws: “earlier”\n[End of room context]\n\nretry"
        },
        {
          "text": "Host policy\n\nfollowing"
        }
      ]
    },
    "acp_context_requests": {
      "claude": [
        {
          "event": {
            "content": {
              "body": "earlier"
            }
          }
        },
        {
          "event": {
            "content": {
              "body": "retry"
            }
          }
        },
        {
          "event": {
            "content": {
              "body": "following"
            }
          }
        }
      ]
    }
  }
}
