{
  "$schema": "../../scenario.schema.json",
  "id": "acp/config-unknown-verbs-are-refused-without-connecting",
  "title": "ACP exposes only the four per-room configuration verbs",
  "rules": [
    "§6.4",
    "§10.6.3"
  ],
  "notes": "Python: tests/test_channels/test_acp_backend.py::test_a_verb_an_acp_agent_lacks_is_refused. Sequential room-session contract; standalone turns, recovery and notifications are separate lots.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {}
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "channel_call",
      "channel_id": "claude",
      "room_id": "room-1",
      "verb": "prompt",
      "arguments": {},
      "expect": {
        "error": "invalid_argument"
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "claude": []
    }
  }
}
