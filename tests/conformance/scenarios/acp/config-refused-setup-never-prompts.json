{
  "$schema": "../../scenario.schema.json",
  "id": "acp/config-refused-setup-never-prompts",
  "title": "A refused initial setting releases the new session and never prompts",
  "rules": [
    "§6.4",
    "§10.6.3"
  ],
  "notes": "Python: tests/test_channels/test_acp_session_setup.py::TestARefusedValueFailsClosed::test_a_turn_fails_and_prompts_nothing[room]. Sequential room-session contract; standalone turns, recovery and notifications are separate lots.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "new_sessions": [
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "opus",
                      "options": [
                        {
                          "value": "opus",
                          "name": "Opus"
                        },
                        {
                          "value": "sonnet",
                          "name": "Sonnet"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    },
                    {
                      "id": "mode",
                      "name": "Mode",
                      "type": "select",
                      "currentValue": "auto",
                      "options": [
                        {
                          "value": "auto",
                          "name": "Auto"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "set_config_options": [
              {
                "error": {
                  "code": -32602,
                  "message": "mode refused"
                }
              }
            ]
          },
          "session_config": {
            "mode": "default"
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go"
        }
      },
      "expect": {
        "result": {
          "error": {
            "$contains": "could not take mode='default'"
          },
          "response_metadata": {
            "acp": {
              "interrupted": {
                "$absent": true
              },
              "prompt_returned": {
                "$absent": true
              }
            }
          }
        }
      }
    },
    {
      "call": "channel_call",
      "channel_id": "claude",
      "room_id": "room-1",
      "verb": "session_config",
      "arguments": {},
      "expect": {
        "result": {
          "model": {
            "$absent": true
          },
          "mode": {
            "$absent": true
          },
          "fast": {
            "$absent": true
          }
        }
      }
    },
    {
      "call": "channel_call",
      "channel_id": "claude",
      "room_id": "room-1",
      "verb": "config_options",
      "arguments": {},
      "expect": {
        "result": []
      }
    },
    {
      "call": "channel_call",
      "channel_id": "claude",
      "room_id": "room-1",
      "verb": "close_session",
      "arguments": {},
      "expect": {
        "result": false
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "claude": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new",
          "params": {
            "cwd": "/srv/project",
            "_meta": {
              "roomkit.live/roomId": "room-1",
              "roomkit.live/sessionScope": "room"
            }
          }
        },
        {
          "method": "session/set_config_option",
          "params": {
            "sessionId": "session-1",
            "configId": "mode",
            "value": "default"
          }
        },
        {
          "method": "session/close",
          "params": {
            "sessionId": "session-1"
          }
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "Go"
          }
        }
      ]
    }
  }
}
