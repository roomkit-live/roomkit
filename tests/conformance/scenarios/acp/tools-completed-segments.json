{
  "$schema": "../../scenario.schema.json",
  "id": "acp/tools-completed-segments",
  "title": "ACP tool markers persist raw and display results and separate the response segments",
  "rules": [
    "§6.4",
    "§9.3",
    "Appendix A.9.1"
  ],
  "notes": "Python: channels/_acp_events.py::_merge_tool, _emit_tool_start, _emit_tool_end, _close_open_tools; channels/_acp_turn.py::_stream and _report_response; tests/test_channels/test_acp.py tools, abandoned calls, persisted markers and end-of-turn reports. Active room turns without an external permission handler; no permission-policy, plan, media or out-of-turn claim.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "updates": [
                  {
                    "sessionUpdate": "agent_message_chunk",
                    "content": {
                      "type": "text",
                      "text": "Working "
                    }
                  },
                  {
                    "sessionUpdate": "tool_call",
                    "toolCallId": "call-1",
                    "title": "Read",
                    "status": "in_progress",
                    "rawInput": {
                      "path": "README.md"
                    }
                  },
                  {
                    "sessionUpdate": "tool_call_update",
                    "toolCallId": "call-1",
                    "status": "completed",
                    "rawOutput": {
                      "content": "RoomKit"
                    },
                    "content": [
                      {
                        "type": "diff",
                        "path": "/srv/project/README.md",
                        "oldText": "old",
                        "newText": "new"
                      }
                    ]
                  },
                  {
                    "sessionUpdate": "agent_message_chunk",
                    "content": {
                      "type": "text",
                      "text": "done"
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      },
      {
        "name": "tools",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "Hello"
          }
        },
        {
          "content": {
            "body": "Working "
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "type": "tool_call",
            "tool_name": "Read",
            "tool_id": "call-1",
            "status": "pending",
            "arguments": {
              "path": "README.md"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "type": "tool_call",
            "tool_name": "Read",
            "tool_id": "call-1",
            "status": "completed",
            "outcome": "served",
            "arguments": {
              "path": "README.md"
            },
            "result": {
              "content": "RoomKit"
            },
            "structured_content": {
              "acp_content": [
                {
                  "type": "diff",
                  "path": "/srv/project/README.md",
                  "oldText": "old",
                  "newText": "new"
                }
              ]
            },
            "error": null
          }
        },
        {
          "content": {
            "body": "done"
          }
        }
      ]
    },
    "tool_events": {
      "room-1": [
        {
          "type": "tool_call_start",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "id": "$e1",
              "name": "Read",
              "arguments": {
                "path": "README.md"
              }
            }
          ]
        },
        {
          "type": "tool_call_end",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "id": "$e1",
              "name": "Read",
              "result": "{\"content\": \"RoomKit\"}",
              "status": "completed"
            }
          ]
        }
      ]
    },
    "hooks": {
      "tools": [
        {
          "room_id": "room-1",
          "tool_call": {
            "name": "Read",
            "arguments": {
              "path": "README.md"
            },
            "result": "{\"content\": \"RoomKit\"}",
            "is_error": false,
            "cancelled": false,
            "refused": false,
            "error_detail": null
          }
        }
      ],
      "response": [
        {
          "room_id": "room-1",
          "response": {
            "channel_id": "claude",
            "segments": [
              "Working ",
              "done"
            ],
            "response_content": "Working \n\ndone",
            "tool_calls_count": 1,
            "streaming": true
          }
        }
      ]
    },
    "streamed": {
      "room-1": {
        "ws": [
          {
            "text": "Working "
          },
          {
            "row": {
              "content": {
                "body": "Working "
              }
            }
          },
          {
            "row": {
              "type": "tool_call_start",
              "content": {
                "type": "tool_call",
                "tool_name": "Read",
                "tool_id": "call-1"
              }
            }
          },
          {
            "row": {
              "type": "tool_call_end",
              "content": {
                "type": "tool_call",
                "tool_name": "Read",
                "tool_id": "call-1",
                "status": "completed",
                "outcome": "served",
                "arguments": {
                  "path": "README.md"
                },
                "result": {
                  "content": "RoomKit"
                },
                "structured_content": {
                  "acp_content": [
                    {
                      "type": "diff",
                      "path": "/srv/project/README.md",
                      "oldText": "old",
                      "newText": "new"
                    }
                  ]
                },
                "error": null
              }
            }
          },
          {
            "text": "done"
          },
          {
            "row": {
              "content": {
                "body": "done"
              }
            }
          }
        ]
      }
    }
  }
}
