{
  "$schema": "../../scenario.schema.json",
  "id": "acp/config-already-reported-is-not-set-again",
  "title": "A session already reporting the requested value needs no setting",
  "rules": [
    "§6.4",
    "§10.6.3"
  ],
  "notes": "Python: tests/test_channels/test_acp_session_setup.py::TestSessionConfig::test_a_value_the_session_already_has_is_not_set_again. Sequential room-session contract; standalone turns, recovery and notifications are separate lots.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "new_sessions": [
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "opus",
                      "options": [
                        {
                          "value": "opus",
                          "name": "Opus"
                        },
                        {
                          "value": "sonnet",
                          "name": "Sonnet"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    },
                    {
                      "id": "mode",
                      "name": "Mode",
                      "type": "select",
                      "currentValue": "auto",
                      "options": [
                        {
                          "value": "auto",
                          "name": "Auto"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "session_config": {
            "model": "opus"
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "claude": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new",
          "params": {
            "cwd": "/srv/project",
            "_meta": {
              "roomkit.live/roomId": "room-1",
              "roomkit.live/sessionScope": "room"
            }
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1",
            "prompt": [
              {
                "text": {
                  "$contains": "Go"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
