{
  "$schema": "../../scenario.schema.json",
  "id": "acp/mcp-cancel-during-callback",
  "title": "Cancel stops a held MCP callback before session/new and a later turn resolves afresh",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_acp_session_setup.py::TestMCPServersPerRoom::test_a_function_gives_each_room_its_servers (cancellation boundary). Exact callback inputs and ordered session/new descriptors are observed through public APIs. Standalone is a separate contract.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "initialize": {
              "mcp_capabilities": {
                "http": true,
                "sse": true
              }
            }
          },
          "mcp_servers": {
            "mode": "async",
            "responses": [
              {
                "servers": [
                  {
                    "name": "workspace",
                    "command": "/usr/local/bin/workspace-mcp",
                    "args": [
                      "--room",
                      "room-1"
                    ],
                    "env": [
                      {
                        "name": "ROOM_ID",
                        "value": "room-1"
                      },
                      {
                        "name": "MODE",
                        "value": "text"
                      }
                    ]
                  }
                ],
                "gate": "held"
              },
              {
                "servers": [
                  {
                    "name": "workspace",
                    "command": "/usr/local/bin/workspace-mcp",
                    "args": [
                      "--room",
                      "room-2"
                    ],
                    "env": [
                      {
                        "name": "ROOM_ID",
                        "value": "room-2"
                      },
                      {
                        "name": "MODE",
                        "value": "text"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "steer",
      "channel_id": "claude",
      "room_id": "room-1",
      "expect": {
        "result": 1
      },
      "directive": {
        "type": "cancel",
        "reason": "hold"
      }
    },
    {
      "await": "turn",
      "expect": {
        "result": {
          "error": null,
          "response_metadata": {
            "acp": {
              "protocol_version": 1,
              "interrupted": true,
              "prompt_returned": {
                "$absent": true
              },
              "stop_reason": {
                "$absent": true
              }
            }
          }
        }
      }
    },
    {
      "open": "held"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "After cancellation"
        }
      },
      "expect": {
        "result": {
          "error": null,
          "response_metadata": {
            "acp": {
              "protocol_version": 1,
              "interrupted": {
                "$absent": true
              },
              "prompt_returned": true,
              "stop_reason": {
                "$absent": true
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "claude": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new",
          "params": {
            "cwd": "/srv/project",
            "_meta": {
              "roomkit.live/roomId": "room-1",
              "roomkit.live/sessionScope": "room"
            },
            "mcpServers": [
              {
                "name": "workspace",
                "command": "/usr/local/bin/workspace-mcp",
                "args": [
                  "--room",
                  "room-2"
                ],
                "env": [
                  {
                    "name": "ROOM_ID",
                    "value": "room-2"
                  },
                  {
                    "name": "MODE",
                    "value": "text"
                  }
                ]
              }
            ]
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1"
          }
        }
      ]
    },
    "hooks": {
      "response": [
        {
          "response": {
            "loop_end_reason": "completed"
          }
        }
      ]
    },
    "acp_mcp_requests": {
      "claude": [
        "room-1",
        "room-1"
      ]
    }
  }
}
