{
  "$schema": "../../scenario.schema.json",
  "id": "acp/standalone-cancel-during-config",
  "title": "Cancellation during standalone configuration closes the new session before any prompt, preserving the room session",
  "rules": [
    "§6.4",
    "§10.1.1 step 7"
  ],
  "requirements": [
    "RK-10.1.1-034",
    "RK-10.1.1-037",
    "RK-6.4-474"
  ],
  "notes": "Python: tests/test_channels/test_acp_instruction.py; test_acp_session_setup.py; test_acp_recovery.py::test_standalone_never_rebuilds_or_changes_the_room_session (RMK-1655); test_acp_backend.py::test_a_detach_during_a_standalone_turn_closes_the_room_s_session. Actual public calls and ordered ACP RPCs. Native tests cover reader abandonment, exact cancellation boundaries and logs; no Discussion or model-output guarantee is inferred.",
  "setup": {
    "kit": {
      "persistence_policy": {
        "persist_types": [
          "message"
        ]
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "coder",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "new_sessions": [
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "small",
                      "options": [
                        {
                          "value": "large",
                          "name": "Large"
                        },
                        {
                          "value": "small",
                          "name": "Small"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        },
                        {
                          "value": "auto",
                          "name": "Auto"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "large",
                      "options": [
                        {
                          "value": "large",
                          "name": "Large"
                        },
                        {
                          "value": "small",
                          "name": "Small"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        },
                        {
                          "value": "auto",
                          "name": "Auto"
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "set_config_options": [
              {
                "gate": "setting",
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "small",
                      "options": [
                        {
                          "value": "large",
                          "name": "Large"
                        },
                        {
                          "value": "small",
                          "name": "Small"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        },
                        {
                          "value": "auto",
                          "name": "Auto"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "coder",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "first"
      },
      "addressed_to": [
        "coder"
      ]
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Summarize."
      },
      "addressed_to": [
        "coder"
      ],
      "event_type": "instruction",
      "standalone": true,
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "setting"
    },
    {
      "call": "acp.cancel",
      "channel_id": "coder",
      "room_id": "room-1",
      "expect": {
        "result": true
      }
    },
    {
      "await": "turn"
    },
    {
      "open": "setting"
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "next"
      },
      "addressed_to": [
        "coder"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "coder": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new",
          "params": {
            "_meta": {
              "roomkit.live/roomId": "room-1",
              "roomkit.live/sessionScope": "room"
            }
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1"
          }
        },
        {
          "method": "session/new",
          "params": {
            "_meta": {
              "roomkit.live/roomId": "room-1",
              "roomkit.live/sessionScope": "turn"
            }
          }
        },
        {
          "method": "session/set_config_option",
          "params": {
            "sessionId": "session-2",
            "configId": "model",
            "value": "small"
          }
        },
        {
          "method": "session/close",
          "params": {
            "sessionId": "session-2"
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1",
            "prompt": [
              {
                "type": "text",
                "text": "next"
              }
            ]
          }
        }
      ]
    }
  }
}
