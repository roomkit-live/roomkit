{
  "$schema": "../../scenario.schema.json",
  "id": "acp/standalone-detach-closes-both-session-scopes",
  "title": "Detaching during a standalone turn releases the turn session and the retained room session before reattachment",
  "rules": [
    "§6.4",
    "§10.1.1 step 7"
  ],
  "notes": "Python: tests/test_channels/test_acp_instruction.py; test_acp_session_setup.py; test_acp_recovery.py::test_standalone_never_rebuilds_or_changes_the_room_session (RMK-1655); test_acp_backend.py::test_a_detach_during_a_standalone_turn_closes_the_room_s_session. Actual public calls and ordered ACP RPCs. Native tests cover reader abandonment, exact cancellation boundaries and logs; no Discussion or model-output guarantee is inferred.",
  "setup": {
    "kit": {
      "persistence_policy": {
        "persist_types": [
          "message"
        ]
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {},
              {
                "gate": "prompt"
              },
              {}
            ],
            "close_sessions": [
              {},
              {
                "gate": "room-close"
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "first"
      },
      "addressed_to": [
        "claude"
      ]
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Summarize."
      },
      "addressed_to": [
        "claude"
      ],
      "event_type": "instruction",
      "standalone": true,
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "prompt"
    },
    {
      "call": "detach_channel",
      "channel_id": "claude",
      "room_id": "room-1"
    },
    {
      "open": "prompt"
    },
    {
      "await": "turn"
    },
    {
      "wait_for": "room-close"
    },
    {
      "open": "room-close"
    },
    {
      "call": "attach_channel",
      "channel_id": "claude",
      "room_id": "room-1",
      "category": "intelligence"
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "next"
      },
      "addressed_to": [
        "claude"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "claude": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new",
          "params": {
            "_meta": {
              "roomkit.live/roomId": "room-1",
              "roomkit.live/sessionScope": "room"
            }
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1"
          }
        },
        {
          "method": "session/new",
          "params": {
            "_meta": {
              "roomkit.live/roomId": "room-1",
              "roomkit.live/sessionScope": "turn"
            }
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-2"
          }
        },
        {
          "method": "session/close",
          "params": {
            "sessionId": "session-2"
          }
        },
        {
          "method": "session/close",
          "params": {
            "sessionId": "session-1"
          }
        },
        {
          "method": "session/new",
          "params": {
            "_meta": {
              "roomkit.live/roomId": "room-1",
              "roomkit.live/sessionScope": "room"
            }
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-3",
            "prompt": [
              {
                "type": "text",
                "text": {
                  "$contains": "next"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
