{
  "$schema": "../../scenario.schema.json",
  "id": "acp/tools-abandoned-stream",
  "title": "Abandoning an ACP reader closes outstanding calls in ephemerals and observers without a completed response",
  "rules": [
    "§6.4",
    "§9.3",
    "Appendix A.9.1"
  ],
  "notes": "Python: channels/_acp_events.py::_merge_tool, _emit_tool_start, _emit_tool_end, _close_open_tools; channels/_acp_turn.py::_stream and _report_response; tests/test_channels/test_acp.py tools, abandoned calls, persisted markers and end-of-turn reports. Active room turns without an external permission handler; no permission-policy, plan, media or out-of-turn claim.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true,
        "deliver_stream": [
          {
            "stop_after": "Anchor"
          }
        ]
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "updates": [
                  {
                    "sessionUpdate": "tool_call",
                    "toolCallId": "call-1",
                    "title": "Read",
                    "status": "in_progress"
                  },
                  {
                    "sessionUpdate": "agent_message_chunk",
                    "content": {
                      "type": "text",
                      "text": "Anchor"
                    }
                  }
                ],
                "after_updates_gate": "never-released"
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      },
      {
        "name": "tools",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "tool_events": {
      "room-1": [
        {
          "type": "tool_call_start",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "id": "$e1",
              "name": "Read"
            }
          ]
        },
        {
          "type": "tool_call_end",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "id": "$e1",
              "name": "Read",
              "status": "failed",
              "result": "The ACP turn ended before the tool reported a result"
            }
          ]
        }
      ]
    },
    "hooks": {
      "tools": [
        {
          "room_id": "room-1",
          "tool_call": {
            "name": "Read",
            "arguments": {},
            "result": "{\"error\": \"Tool call cancelled\", \"tool\": \"Read\", \"hint\": \"The turn ended before its result.\"}",
            "is_error": true,
            "cancelled": true,
            "refused": false,
            "error_detail": null
          }
        }
      ],
      "response": []
    }
  }
}
