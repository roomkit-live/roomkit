{
  "$schema": "../../scenario.schema.json",
  "id": "acp/a-mode-the-agent-switches-to-itself-is-not-set-on-the-room-s-next-session",
  "title": "A configuration value the ACP agent switches to itself is its live session's: the Room's next session is set again to the value the host set through the kit, never to the agent's own",
  "rules": [
    "§6.4",
    "§10.6.3"
  ],
  "requirements": [
    "RK-6.4-495"
  ],
  "notes": "The host sets model to small through a channel call. During the prompt the agent reports mode plan itself (config_option_update): the live session reads it, the Room stores none of it. After the agent's connection drops, the Room's next session is set to model small again and receives no session/set_config_option for mode.",
  "setup": {
    "channels": [
      {
        "id": "chat",
        "type": "chat",
        "category": "transport"
      },
      {
        "id": "coder",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "new_sessions": [
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "large",
                      "options": [
                        {
                          "value": "large",
                          "name": "Large"
                        },
                        {
                          "value": "small",
                          "name": "Small"
                        }
                      ]
                    },
                    {
                      "id": "mode",
                      "name": "Mode",
                      "type": "select",
                      "currentValue": "auto",
                      "options": [
                        {
                          "value": "auto",
                          "name": "Auto"
                        },
                        {
                          "value": "plan",
                          "name": "Plan"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "large",
                      "options": [
                        {
                          "value": "large",
                          "name": "Large"
                        },
                        {
                          "value": "small",
                          "name": "Small"
                        }
                      ]
                    },
                    {
                      "id": "mode",
                      "name": "Mode",
                      "type": "select",
                      "currentValue": "auto",
                      "options": [
                        {
                          "value": "auto",
                          "name": "Auto"
                        },
                        {
                          "value": "plan",
                          "name": "Plan"
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "set_config_options": [
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "small",
                      "options": [
                        {
                          "value": "large",
