            ],
            "prompts": [
              {
                "updates": [
                  {
                    "sessionUpdate": "config_option_update",
                    "configOptions": [
                      {
                        "id": "model",
                        "name": "Model",
                        "type": "select",
                        "currentValue": "small",
                        "options": [
                          {
                            "value": "large",
                            "name": "Large"
                          },
                          {
                            "value": "small",
                            "name": "Small"
