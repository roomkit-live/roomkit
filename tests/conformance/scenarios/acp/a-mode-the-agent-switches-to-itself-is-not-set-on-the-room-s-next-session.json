          {
            "channel_id": "coder",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "channel_call",
      "channel_id": "coder",
      "room_id": "room-1",
      "verb": "set_config_option",
      "arguments": {
        "config_id": "model",
        "value": "small"
      },
      "expect": {
        "result": {
          "model": "small",
          "mode": "auto"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "chat",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "channel_call",
      "channel_id": "coder",
      "room_id": "room-1",
      "verb": "session_config",
      "arguments": {},
      "expect": {
        "result": {
          "model": "small",
          "mode": "plan"
        }
      }
    },
    {
      "acp_disconnect": "coder"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "chat",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Again"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "channel_call",
      "channel_id": "coder",
      "room_id": "room-1",
      "verb": "session_config",
      "arguments": {},
      "expect": {
        "result": {
          "model": "small",
          "mode": "auto"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "coder": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new"
        },
        {
          "method": "session/set_config_option",
          "params": {
