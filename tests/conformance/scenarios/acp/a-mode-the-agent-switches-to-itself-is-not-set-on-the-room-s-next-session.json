        },
        {
          "method": "session/new"
        },
        {
          "method": "session/set_config_option",
          "params": {
            "sessionId": "session-2",
            "configId": "model",
            "value": "small"
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-2"
          }
        }
      ]
    },
    "rooms": {
      "room-1": {
        "metadata": {
          "roomkit:channel_state:coder": {
            "config": {
              "model": "small",
              "mode": {
                "$absent": true
              }
            }
          }
        }
      }
    }
  }
