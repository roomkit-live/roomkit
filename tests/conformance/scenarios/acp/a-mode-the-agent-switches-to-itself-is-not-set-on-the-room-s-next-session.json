                        },
                        {
                          "value": "plan",
                          "name": "Plan"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "small",
                      "options": [
                        {
                          "value": "large",
                          "name": "Large"
                        },
                        {
                          "value": "small",
                          "name": "Small"
                        }
                      ]
                    },
                    {
                      "id": "mode",
                      "name": "Mode",
