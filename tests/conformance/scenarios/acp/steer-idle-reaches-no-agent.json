{
  "$schema": "../../scenario.schema.json",
  "id": "acp/steer-idle-reaches-no-agent",
  "title": "Steering an idle ACP room returns zero without a cancellation request",
  "rules": [
    "§6.4",
    "§10.6.8",
    "§21.3"
  ],
  "notes": "Python: tests/test_channels/test_acp_backend.py steering tests. Public kit steering reaches a turn, preserving the remote outcome; idle sessions are not cancelled. Exact ordered RPC trace. Direct turn-id addressing has a native test; the context_contributor boundary, standalone turns and publications remain separate.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {}
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "call": "steer",
      "channel_id": "claude",
      "room_id": "room-1",
      "expect": {
        "result": 0
      },
      "directive": {
        "type": "cancel",
        "reason": "hold"
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Again"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "claude": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new"
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1"
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1"
          }
        }
      ]
    }
  }
}
