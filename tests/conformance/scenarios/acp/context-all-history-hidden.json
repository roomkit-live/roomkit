{
  "$schema": "../../scenario.schema.json",
  "id": "acp/context-all-history-hidden",
  "title": "Hidden history creates neither disclosure nor a false missing-history warning",
  "rules": [
    "§6.4",
    "§19.3.2"
  ],
  "notes": "Python: tests/test_context_history_boundary.py. Exact public ACP prompt attempts. Explicit message-only persistence isolates conversation indices; RMK-1447 separately tracks the default-policy lifecycle gap.",
  "setup": {
    "kit": {
      "persistence_policy": {
        "persist_types": [
          "message"
        ]
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {},
          "room_history": 20,
          "context_contributor": {
            "responses": [
              {
                "blocks": []
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "SECRET"
      },
      "addressed_to": [],
      "visibility": "transport"
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "go"
      },
      "addressed_to": [
        "claude"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_prompts": {
      "claude": [
        {
          "text": "go"
        }
      ]
    },
    "acp_context_requests": {
      "claude": [
        {
          "history_start_index": 0
        }
      ]
    }
  }
}
