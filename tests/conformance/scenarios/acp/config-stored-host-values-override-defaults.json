{
  "$schema": "../../scenario.schema.json",
  "id": "acp/config-stored-host-values-override-defaults",
  "title": "A room restores its stored host settings before opening a new session",
  "rules": [
    "§6.4",
    "§10.6.3"
  ],
  "notes": "Python: tests/test_channels/test_acp_backend.py::test_a_host_s_session_values_belong_to_the_room. Sequential room-session contract; standalone turns, recovery and notifications are separate lots.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "new_sessions": [
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "opus",
                      "options": [
                        {
                          "value": "opus",
                          "name": "Opus"
                        },
                        {
                          "value": "sonnet",
                          "name": "Sonnet"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    },
                    {
                      "id": "mode",
                      "name": "Mode",
                      "type": "select",
                      "currentValue": "auto",
                      "options": [
                        {
                          "value": "auto",
                          "name": "Auto"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "set_config_options": [
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "sonnet",
                      "options": [
                        {
                          "value": "opus",
                          "name": "Opus"
                        },
                        {
                          "value": "sonnet",
                          "name": "Sonnet"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    },
                    {
                      "id": "mode",
                      "name": "Mode",
                      "type": "select",
                      "currentValue": "auto",
                      "options": [
                        {
                          "value": "auto",
                          "name": "Auto"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "sonnet",
                      "options": [
                        {
                          "value": "opus",
                          "name": "Opus"
                        },
                        {
                          "value": "sonnet",
                          "name": "Sonnet"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    },
                    {
                      "id": "mode",
                      "name": "Mode",
                      "type": "select",
                      "currentValue": "default",
                      "options": [
                        {
                          "value": "auto",
                          "name": "Auto"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "session_config": {
            "model": "default",
            "mode": "default"
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ],
        "store_metadata": {
          "roomkit:channel_state:claude": {
            "config": {
              "model": "sonnet"
            }
          }
        }
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go"
        }
      }
    },
    {
      "call": "channel_call",
      "channel_id": "claude",
      "room_id": "room-1",
      "verb": "session_config",
      "arguments": {},
      "expect": {
        "result": {
          "model": "sonnet",
          "mode": "default"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "claude": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new",
          "params": {
            "cwd": "/srv/project",
            "_meta": {
              "roomkit.live/roomId": "room-1",
              "roomkit.live/sessionScope": "room"
            }
          }
        },
        {
          "method": "session/set_config_option",
          "params": {
            "sessionId": "session-1",
            "configId": "model",
            "value": "sonnet"
          }
        },
        {
          "method": "session/set_config_option",
          "params": {
            "sessionId": "session-1",
            "configId": "mode",
            "value": "default"
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1",
            "prompt": [
              {
                "text": {
                  "$contains": "Go"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
