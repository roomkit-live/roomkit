{
  "$schema": "../../scenario.schema.json",
  "id": "acp/directories-empty-are-not-declared",
  "title": "An empty additional directories list adds no session field",
  "rules": [
    "§6.4",
    "Appendix A.9.1"
  ],
  "notes": "Python: ACPChannel.__init__ and ACPSessionsMixin._new_session. There was no direct additional_directories test in the source inventory; these cases add the public wire proof. Native test_acp_directories.py covers path validation. This scenario concerns room sessions and their declaration, not access to the remote filesystem. Standalone remains a separate contract.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "updates": [
                  {
                    "sessionUpdate": "agent_message_chunk",
                    "content": {
                      "type": "text",
                      "text": "Hi "
                    }
                  },
                  {
                    "sessionUpdate": "agent_message_chunk",
                    "content": {
                      "type": "text",
                      "text": "there."
                    }
                  }
                ]
              }
            ],
            "initialize": {
              "agent_info": {
                "name": "scripted-agent",
                "version": "1.0.0"
              }
            }
          },
          "additional_directories": []
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "expect": {
        "result": {
          "response_metadata": {
            "acp": {
              "protocol_version": 1,
              "prompt_returned": true,
              "stop_reason": {
                "$absent": true
              },
              "interrupted": {
                "$absent": true
              }
            },
            "turns": {
              "claude": {
                "loop_end_reason": "completed"
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "Hello"
          }
        },
        {
          "index": 1,
          "type": "message",
          "chain_depth": 1,
          "content": {
            "type": "text",
            "body": "Hi there."
          },
          "source": {
            "channel_id": "claude",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "metadata": {
            "acp": {
              "protocol_version": 1,
              "prompt_returned": true
            }
          }
        }
      ]
    },
    "acp_wire": {
      "claude": [
        {
          "method": "initialize",
          "params": {
            "protocolVersion": 1,
            "clientCapabilities": {
              "$absent": true
            },
            "clientInfo": {
              "name": "roomkit",
              "title": "RoomKit",
              "version": {
                "$present": true
              }
            }
          }
        },
        {
          "method": "session/new",
          "params": {
            "cwd": "/srv/project",
            "mcpServers": [],
            "_meta": {
              "roomkit.live/roomId": "room-1",
              "roomkit.live/sessionScope": "room"
            },
            "additionalDirectories": {
              "$absent": true
            }
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1",
            "prompt": [
              {
                "type": "text",
                "text": {
                  "$contains": "Hello"
                }
              }
            ],
            "_meta": {
              "roomkit.live/eventId": "room-1#0"
            }
          }
        }
      ]
    }
  }
}
