{
  "$schema": "../../scenario.schema.json",
  "id": "acp/tools-observer-turn-context",
  "title": "An ACP tool observer writes the record of the second room turn, not the turn that opened the shared connection",
  "rules": [
    "§6.4",
    "§9.3",
    "Appendix A.9.1"
  ],
  "notes": "Python: channels/_acp_events.py::_merge_tool, _emit_tool_start, _emit_tool_end, _close_open_tools; channels/_acp_turn.py::_stream and _report_response; tests/test_channels/test_acp.py tools, abandoned calls, persisted markers and end-of-turn reports. Active room turns without an external permission handler; no permission-policy, plan, media or out-of-turn claim.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "updates": []
              },
              {
                "updates": [
                  {
                    "sessionUpdate": "tool_call",
                    "toolCallId": "call-1",
                    "title": "Read",
                    "status": "in_progress"
                  },
                  {
                    "sessionUpdate": "tool_call_update",
                    "toolCallId": "call-1",
                    "status": "completed",
                    "rawOutput": "done"
                  }
                ],
                "after_updates_gate": "prompt-held"
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      },
      {
        "name": "tools",
        "trigger": "on_tool_call",
        "execution": "async",
        "reactions": [
          {
            "writes_record": {
              "tool_observed": true
            },
            "gate": "observed"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "expect": {
        "result": {
          "response_metadata": {
            "tool_observed": {
              "$absent": true
            }
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "background": true,
      "as": "second"
    },
    {
      "wait_for": "observed"
    },
    {
      "open": "observed"
    },
    {
      "wait_for": "prompt-held"
    },
    {
      "open": "prompt-held"
    },
    {
      "await": "second",
      "expect": {
        "result": {
          "response_metadata": {
            "tool_observed": true
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "Hello"
          }
        }
      ],
      "room-2": [
        {
          "content": {
            "body": "Hello"
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "type": "tool_call",
            "tool_name": "Read"
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "type": "tool_call",
            "tool_name": "Read",
            "result": "done"
          }
        }
      ]
    },
    "tool_events": {
      "room-1": [],
      "room-2": [
        {
          "type": "tool_call_start",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "name": "Read"
            }
          ]
        },
        {
          "type": "tool_call_end",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "name": "Read",
              "result": "done"
            }
          ]
        }
      ]
    },
    "hooks": {
      "tools": [
        {
          "room_id": "room-2",
          "tool_call": {
            "name": "Read",
            "arguments": {},
            "result": "done",
            "is_error": false,
            "cancelled": false,
            "refused": false,
            "error_detail": null
          }
        }
      ],
      "response": [
        {
          "room_id": "room-1",
          "response": {
            "channel_id": "claude",
            "segments": [],
            "response_content": "",
            "tool_calls_count": 0,
            "streaming": true
          }
        },
        {
          "room_id": "room-2",
          "response": {
            "channel_id": "claude",
            "segments": [],
            "response_content": "",
            "tool_calls_count": 1,
            "streaming": true
          }
        }
      ]
    }
  }
}
