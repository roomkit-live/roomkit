{
  "$schema": "../../scenario.schema.json",
  "id": "acp/tools-interleaved-identifiers",
  "title": "Interleaved ACP calls finish by identifier and count distinct calls",
  "rules": [
    "§6.4",
    "§9.3",
    "Appendix A.9.1"
  ],
  "notes": "Python: channels/_acp_events.py::_merge_tool, _emit_tool_start, _emit_tool_end, _close_open_tools; channels/_acp_turn.py::_stream and _report_response; tests/test_channels/test_acp.py tools, abandoned calls, persisted markers and end-of-turn reports. Active room turns without an external permission handler; no permission-policy, plan, media or out-of-turn claim.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "updates": [
                  {
                    "sessionUpdate": "tool_call",
                    "toolCallId": "one",
                    "title": "First",
                    "status": "in_progress"
                  },
                  {
                    "sessionUpdate": "tool_call",
                    "toolCallId": "two",
                    "title": "Second",
                    "status": "in_progress"
                  },
                  {
                    "sessionUpdate": "tool_call_update",
                    "toolCallId": "two",
                    "status": "completed",
                    "rawOutput": "result two"
                  },
                  {
                    "sessionUpdate": "tool_call_update",
                    "toolCallId": "one",
                    "title": "Renamed",
                    "rawInput": {
                      "new": true
                    },
                    "status": "completed",
                    "rawOutput": "result one"
                  }
                ]
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      },
      {
        "name": "tools",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "Hello"
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "type": "tool_call",
            "tool_name": "First",
            "tool_id": "one"
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "type": "tool_call",
            "tool_name": "Second",
            "tool_id": "two"
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "type": "tool_call",
            "tool_name": "Second",
            "tool_id": "two",
            "result": "result two"
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "type": "tool_call",
            "tool_name": "Renamed",
            "tool_id": "one",
            "arguments": {
              "new": true
            },
            "result": "result one"
          }
        }
      ]
    },
    "tool_events": {
      "room-1": [
        {
          "type": "tool_call_start",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "id": "$e1",
              "name": "First"
            }
          ]
        },
        {
          "type": "tool_call_start",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "id": "$e2",
              "name": "Second"
            }
          ]
        },
        {
          "type": "tool_call_end",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "id": "$e2",
              "name": "Second",
              "result": "result two"
            }
          ]
        },
        {
          "type": "tool_call_end",
          "round": 0,
          "channel_id": "claude",
          "tool_calls": [
            {
              "id": "$e1",
              "name": "Renamed",
              "result": "result one"
            }
          ]
        }
      ]
    },
    "hooks": {
      "tools": [
        {
          "room_id": "room-1",
          "tool_call": {
            "name": "Second",
            "arguments": {},
            "result": "result two",
            "is_error": false,
            "cancelled": false,
            "refused": false,
            "error_detail": null
          }
        },
        {
          "room_id": "room-1",
          "tool_call": {
            "name": "Renamed",
            "arguments": {
              "new": true
            },
            "result": "result one",
            "is_error": false,
            "cancelled": false,
            "refused": false,
            "error_detail": null
          }
        }
      ],
      "response": [
        {
          "room_id": "room-1",
          "response": {
            "channel_id": "claude",
            "segments": [],
            "response_content": "",
            "tool_calls_count": 2,
            "streaming": true
          }
        }
      ]
    }
  }
}
