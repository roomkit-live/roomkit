{
  "$schema": "../../scenario.schema.json",
  "id": "acp/context-failed-prompt",
  "title": "A failed prompt does not advance the catch-up cursor",
  "rules": [
    "§6.4",
    "§19.3.2"
  ],
  "notes": "Python: tests/test_channels/test_acp.py::TestRoomCatchUp::test_a_failed_prompt_remains_in_the_next_turns_catch_up. Exact public ACP prompt attempts. Explicit message-only persistence isolates conversation indices; RMK-1447 separately tracks the default-policy lifecycle gap.",
  "setup": {
    "kit": {
      "persistence_policy": {
        "persist_types": [
          "message"
        ]
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "error": {
                  "code": -32603,
                  "message": "rejected"
                }
              },
              {}
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "rejected request"
      },
      "addressed_to": [
        "claude"
      ]
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "next request"
      },
      "addressed_to": [
        "claude"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_prompts": {
      "claude": [
        {
          "text": "rejected request"
        },
        {
          "text": "[Room context — 1 message you did not receive. Context only; the request follows.]\n[1] @ws: “rejected request”\n[End of room context]\n\nnext request"
        }
      ]
    }
  }
}
