                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "large",
                      "options": [
                        {
                          "value": "large",
                          "name": "Large"
                        },
                        {
                          "value": "small",
                          "name": "Small"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "coder",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "channel_call",
      "room_id": "room-1",
      "channel_id": "coder",
      "verb": "set_config_option",
      "arguments": {
        "config_id": "model",
        "value": "small"
      },
      "expect": {
        "result": {
          "model": "small"
        }
      }
    },
    {
      "call": "channel_call",
      "room_id": "room-1",
      "channel_id": "coder",
      "verb": "set_config_option",
      "arguments": {
        "config_id": "model",
        "value": "large"
      },
      "expect": {
        "result": {
          "model": "large"
        }
      }
    },
