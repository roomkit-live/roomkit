        "id": "coder",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [],
            "initialize": {
              "agent_info": {
                "name": "scripted-agent",
                "version": "1.0.0"
              }
            },
            "new_sessions": [
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "large",
                      "options": [
                        {
                          "value": "large",
                          "name": "Large"
                        },
                        {
                          "value": "small",
                          "name": "Small"
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "set_config_options": [
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "small",
                      "options": [
                        {
                          "value": "large",
                          "name": "Large"
                        },
                        {
                          "value": "small",
                          "name": "Small"
                        }
                      ]
                    }
