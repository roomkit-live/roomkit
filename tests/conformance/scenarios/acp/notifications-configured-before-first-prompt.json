{
  "$schema": "../../scenario.schema.json",
  "id": "acp/notifications-configured-before-first-prompt",
  "title": "Opening from an explicit setter publishes the configured values and labels before any prompt",
  "rules": [
    "§6.4",
    "Appendix A.9.1"
  ],
  "notes": "Python: tests/test_channels/test_acp.py::TestACPChannel::test_set_config_option_opens_a_session_when_needed. Actual subscriber and channel_call; no prompt required. Opening announces once, then the successful explicit setter announces its full state again, as ACPChannel.set_config_option calls _publish_config_options after _room_session.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
