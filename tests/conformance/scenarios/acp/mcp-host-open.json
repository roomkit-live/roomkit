{
  "$schema": "../../scenario.schema.json",
  "id": "acp/mcp-host-open",
  "title": "A host call resolves MCP servers once before a turn reuses its session",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_acp_session_setup.py::TestMCPServersPerRoom::test_a_function_gives_each_room_its_servers (host-open boundary). Exact callback inputs and ordered session/new descriptors are observed through public APIs. Standalone is a separate contract.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "new_sessions": [
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "opus",
                      "options": [
                        {
                          "value": "opus",
                          "name": "Opus"
                        },
                        {
                          "value": "sonnet",
                          "name": "Sonnet"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    },
                    {
                      "id": "mode",
                      "name": "Mode",
                      "type": "select",
                      "currentValue": "auto",
                      "options": [
                        {
                          "value": "auto",
                          "name": "Auto"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "set_config_options": [
              {
                "result": {
                  "configOptions": [
                    {
                      "id": "model",
                      "name": "Model",
                      "type": "select",
                      "currentValue": "sonnet",
                      "options": [
                        {
                          "value": "opus",
                          "name": "Opus"
                        },
                        {
                          "value": "sonnet",
                          "name": "Sonnet"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    },
                    {
                      "id": "mode",
                      "name": "Mode",
                      "type": "select",
                      "currentValue": "auto",
                      "options": [
                        {
                          "value": "auto",
                          "name": "Auto"
                        },
                        {
                          "value": "default",
                          "name": "Default"
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "initialize": {
              "mcp_capabilities": {
                "http": true,
                "sse": true
              }
            }
          },
          "mcp_servers": {
            "mode": "async",
            "responses": [
              {
                "servers": [
                  {
                    "name": "workspace",
                    "command": "/usr/local/bin/workspace-mcp",
                    "args": [
                      "--room",
                      "room-1"
                    ],
                    "env": [
                      {
                        "name": "ROOM_ID",
                        "value": "room-1"
                      },
                      {
                        "name": "MODE",
                        "value": "text"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "channel_call",
      "channel_id": "claude",
      "room_id": "room-1",
      "verb": "set_config_option",
      "arguments": {
        "config_id": "model",
        "value": "sonnet"
      },
      "expect": {
        "result": {
          "model": "sonnet",
          "mode": "auto"
        }
      }
    },
    {
      "call": "channel_call",
      "channel_id": "claude",
      "room_id": "room-1",
      "verb": "config_options",
      "arguments": {},
      "expect": {
        "result": [
          {
            "id": "model",
            "name": "Model",
            "type": "select",
            "currentValue": "sonnet",
            "options": [
              {
                "value": "opus",
                "name": "Opus"
              },
              {
                "value": "sonnet",
                "name": "Sonnet"
              },
              {
                "value": "default",
                "name": "Default"
              }
            ]
          },
          {
            "id": "mode",
            "name": "Mode",
            "type": "select",
            "currentValue": "auto",
            "options": [
              {
                "value": "auto",
                "name": "Auto"
              },
              {
                "value": "default",
                "name": "Default"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go"
        }
      }
    },
    {
      "call": "channel_call",
      "channel_id": "claude",
      "room_id": "room-1",
      "verb": "session_config",
      "arguments": {},
      "expect": {
        "result": {
          "model": "sonnet",
          "mode": "auto"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "claude": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new",
          "params": {
            "cwd": "/srv/project",
            "_meta": {
              "roomkit.live/roomId": "room-1",
              "roomkit.live/sessionScope": "room"
            },
            "mcpServers": [
              {
                "name": "workspace",
                "command": "/usr/local/bin/workspace-mcp",
                "args": [
                  "--room",
                  "room-1"
                ],
                "env": [
                  {
                    "name": "ROOM_ID",
                    "value": "room-1"
                  },
                  {
                    "name": "MODE",
                    "value": "text"
                  }
                ]
              }
            ]
          }
        },
        {
          "method": "session/set_config_option",
          "params": {
            "sessionId": "session-1",
            "configId": "model",
            "value": "sonnet"
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1",
            "prompt": [
              {
                "text": {
                  "$contains": "Go"
                }
              }
            ]
          }
        }
      ]
    },
    "rooms": {
      "room-1": {
        "metadata": {
          "roomkit:channel_state:claude": {
            "config": {
              "model": "sonnet"
            }
          }
        }
      }
    },
    "acp_mcp_requests": {
      "claude": [
        "room-1"
      ]
    }
  }
}
