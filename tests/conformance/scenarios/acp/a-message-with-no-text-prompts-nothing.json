{
  "$schema": "../../scenario.schema.json",
  "id": "acp/a-message-with-no-text-prompts-nothing",
  "title": "A message whose text is blank opens no ACP turn: the agent is not connected, no session is opened and nothing is prompted",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_acp_empty_prompt.py.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [],
            "initialize": {
              "agent_info": {
                "name": "scripted-agent",
                "version": "1.0.0"
              }
            }
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "   "
        }
      },
      "expect": {
        "result": {
          "error": null,
          "response_metadata": {},
          "response_events": []
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0
        }
      ]
    },
    "acp_wire": {
      "claude": []
    }
  }
}
