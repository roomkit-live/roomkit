{
  "$schema": "../../scenario.schema.json",
  "id": "acp/cancel-running-prompt-keeps-its-outcome",
  "title": "Cancelling a prompting session lets the agent return its outcome",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_acp_session_setup.py::TestACancelReachesATurnWhileItsSessionOpens; tests/test_channels/test_acp_recovery.py::test_public_cancel_stops_reconstruction_before_prompt; test_acp.py::TestACPChannel::test_sessions_are_isolated_by_room_and_can_be_cancelled. Actual public cancel and wire ordering; no runner mutation of channel state. Standalone and the config-publication callback are distinct follow-ups.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "gate": "prompt",
                "stop_reason": "cancelled"
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "background": true,
      "as": "turn"
    },
    {
      "wait_for": "prompt"
    },
    {
      "call": "acp.cancel",
      "channel_id": "claude",
      "room_id": "room-1",
      "expect": {
        "result": true
      }
    },
    {
      "open": "prompt"
    },
    {
      "await": "turn",
      "expect": {
        "result": {
          "error": null,
          "response_metadata": {
            "acp": {
              "prompt_returned": true,
              "stop_reason": "cancelled",
              "interrupted": {
                "$absent": true
              }
            }
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Again"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_wire": {
      "claude": [
        {
          "method": "initialize"
        },
        {
          "method": "session/new"
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1"
          }
        },
        {
          "method": "session/cancel",
          "params": {
            "sessionId": "session-1"
          }
        },
        {
          "method": "session/prompt",
          "params": {
            "sessionId": "session-1"
          }
        }
      ]
    },
    "hooks": {
      "response": [
        {
          "response": {
            "loop_end_reason": "cancelled"
          }
        },
        {
          "response": {
            "loop_end_reason": "completed"
          }
        }
      ]
    }
  }
}
