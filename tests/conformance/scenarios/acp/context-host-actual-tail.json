{
  "$schema": "../../scenario.schema.json",
  "id": "acp/context-host-actual-tail",
  "title": "A host contributor receives the actual framework tail with history disabled",
  "rules": [
    "§6.4",
    "§19.3.2"
  ],
  "notes": "Python: tests/test_channels/test_acp_catch_up_integration.py::test_a_contributor_sees_the_frameworks_tail_not_a_floor. Exact public ACP prompt attempts. Explicit message-only persistence isolates conversation indices; RMK-1447 separately tracks the default-policy lifecycle gap.",
  "setup": {
    "kit": {
      "persistence_policy": {
        "persist_types": [
          "message"
        ]
      }
    },
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {},
          "room_history": 0,
          "context_contributor": {
            "responses": [
              {
                "blocks": [
                  "Policy"
                ]
              }
            ]
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "earlier"
      },
      "addressed_to": []
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "go"
      },
      "addressed_to": [
        "claude"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "acp_prompts": {
      "claude": [
        {
          "text": "Policy\n\ngo"
        }
      ]
    },
    "acp_context_requests": {
      "claude": [
        {
          "room_id": "room-1",
          "event": {
            "id": "room-1#1",
            "content": {
              "body": "go"
            }
          },
          "recent_events": [
            {
              "id": "room-1#1",
              "content": {
                "body": "go"
              }
            }
          ]
        }
      ]
    }
  }
}
