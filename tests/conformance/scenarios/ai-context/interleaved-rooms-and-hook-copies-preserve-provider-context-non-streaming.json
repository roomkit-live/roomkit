        "name": "generation",
        "trigger": "before_ai_generation",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "system_prompt": "Keep context."
              }
            },
            "repeat": true
          }
        ]
      }
    ]
