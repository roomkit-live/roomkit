{
  "$schema": "../../scenario.schema.json",
  "id": "steering/a-message-during-the-answer-is-answered-by-the-same-turn",
  "title": "With steer_room_turns, a message that comes while the model writes its answer is read once it answered: the same turn asks the model again, the answer then the message, and answers it",
  "rules": [
    "§6.4",
    "§21.3"
  ],
  "notes": "The answer is a stop too (§21.3): a loop reads its directives once the model has answered, and an InjectMessage that came meanwhile asks the model again in the same turn. The first answer is a message of its own; the turn's record is on its last.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "answer",
              "text": "a.py, b.txt"
            },
            {
              "text": "a.py"
            }
          ]
        },
        "steer_room_turns": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "List the files."
        }
      },
      "background": true,
      "as": "first"
    },
    {
      "wait_for": "answer"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "Only the .py files."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "open": "answer"
    },
    {
      "await": "first",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "List the files."
          }
        },
        {
          "index": 1,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "Only the .py files."
          }
        },
        {
          "index": 2,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "a.py, b.txt"
          },
          "metadata": {
            "loop_end_reason": {
              "$absent": true
            }
          }
        },
        {
          "index": 3,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "a.py"
          },
          "metadata": {
            "loop_end_reason": "completed"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "List the files."
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "List the files."
            },
            {
              "role": "assistant",
              "text": "a.py, b.txt"
            },
            {
              "role": "user",
              "text": "Only the .py files."
            }
          ]
        }
      ]
    }
  }
}
