{
  "$schema": "../../scenario.schema.json",
  "id": "steering/a-message-delivered-after-a-cut-gets-a-turn-of-its-own",
  "title": "A message committed while the turn runs but delivered once the cut turn has ended reaches no loop: a turn of its own answers it, reading the room as the cut turn left it",
  "rules": [
    "§6.4",
    "§21.3",
    "§10.1 Explicit delivery cancellation"
  ],
  "notes": "The room's delivery lane holds the message's set behind the row before it, so the cut turn ends between the message's commit and its delivery. A turn being cut that has not ended yet would still take the message. Python: core/_room_turns.py RoomTurns._steered, the steer reaches nothing and the event takes its place in the line (RMK-1371). The cut turn's call, cancelled before it answered, is not replayed: no model read its result (RFC §6.4, HITL 4ffcc5e0, RMK-1370).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "slow",
        "type": "websocket",
        "category": "transport",
        "deliver": [
          {
            "when": {
              "type": "tool_call_start"
            },
            "gate": "lane"
          }
        ]
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "list_files"
                }
              ]
            },
            {
              "text": "a.py"
            }
          ]
        },
        "tools": [
          {
            "name": "list_files",
            "description": "List the project's files.",
            "parameters": {
              "type": "object"
            },
            "gate": "tool",
            "returns": "a.py b.txt"
          }
        ],
        "steer_room_turns": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "slow"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "List the files."
        },
        "delivery_key": "first"
      },
      "background": true,
      "as": "first"
    },
    {
      "wait_for": "lane"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "Only the .py files."
        }
      },
      "defer_delivery": true,
      "as": "second",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "cancel_delivery",
      "key": "first",
      "expect": {
        "result": 1
      }
    },
    {
      "await": "first",
      "expect": {
        "result": {
          "blocked": false,
          "cancellation_reason": "caller_cancelled"
        }
      }
    },
    {
      "open": "lane"
    },
    {
      "call": "delivery.wait",
      "of": "second",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "content": {
            "body": "List the files."
          }
        },
        {
          "index": 1,
          "type": "tool_call_start"
        },
        {
          "index": 2,
          "content": {
            "body": "Only the .py files."
          }
        },
        {
          "index": 3,
          "type": "tool_call_end"
        },
        {
          "index": 4,
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "body": "a.py"
          },
          "metadata": {
            "loop_end_reason": "completed"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "List the files."
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "List the files."
            },
            {
              "role": "user",
              "text": "Only the .py files."
            }
          ]
        }
      ]
    }
  }
}
