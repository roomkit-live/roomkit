{
  "$schema": "../../scenario.schema.json",
  "id": "steering/off-a-second-message-starts-a-turn-beside-the-first",
  "title": "By default, a message that comes while the agent's turn runs starts a turn of its own beside it, which does not read the first turn's answer",
  "rules": [
    "§6.4"
  ],
  "notes": "Without serialize_room_turns or steer_room_turns, the channel's turns in a room run side by side, each on the room as it stood when it was asked (§6.4): the second turn answers while the first still waits for its model.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "gate": "first",
              "text": "first"
            },
            {
              "text": "second"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "one"
        }
      },
      "background": true,
      "as": "first"
    },
    {
      "wait_for": "first"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "two"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "open": "first"
    },
    {
      "await": "first",
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "one"
          }
        },
        {
          "index": 1,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "two"
          }
        },
        {
          "index": 2,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "second"
          },
          "metadata": {
            "loop_end_reason": "completed"
          }
        },
        {
          "index": 3,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "first"
          },
          "metadata": {
            "loop_end_reason": "completed"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "messages": [
            {
              "role": "user",
              "text": "one"
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "one"
            },
            {
              "role": "user",
              "text": "two"
            }
          ]
        }
      ]
    }
  }
}
