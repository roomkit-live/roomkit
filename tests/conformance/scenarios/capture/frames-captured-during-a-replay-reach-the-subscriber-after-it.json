{
  "$schema": "../../scenario.schema.json",
  "id": "capture/frames-captured-during-a-replay-reach-the-subscriber-after-it",
  "title": "Frames captured while a subscriber replays its backlog reach it after every replayed frame, never between them",
  "rules": [
    "§12.12"
  ],
  "requirements": [
    "RK-12.12-025"
  ],
  "requires_features": [
    "realtime",
    "capture_source"
  ],
  "notes": "The source captures two frames on another thread as the replaying subscriber records its first replayed frame. The subscriber already live receives them at once; the replaying one after the rest of its replay, then the next live frame.",
  "setup": {
    "capture_sources": [
      {
        "id": "mic"
      }
    ]
  },
  "steps": [
    {
      "call": "capture.subscribe",
      "source_id": "mic",
      "subscriber": "live"
    },
    {
      "call": "capture.mark",
      "source_id": "mic",
      "mark": "wake"
    },
    {
      "call": "capture.feed",
      "source_id": "mic",
      "frames": [
        "AQABAA==",
        "AgACAA=="
      ]
    },
    {
      "call": "capture.subscribe",
      "source_id": "mic",
      "subscriber": "session",
      "since": "wake",
      "captures_during_replay": [
        "IQAhAA==",
        "IgAiAA=="
      ]
    },
    {
      "call": "capture.feed",
      "source_id": "mic",
      "frames": [
        "AwADAA=="
      ]
    },
    {
      "call": "capture.read",
      "source_id": "mic",
      "expect": {
        "result": {
          "subscribers": {
            "live": {
              "frames": [
                {
                  "data": "AQABAA=="
                },
                {
                  "data": "AgACAA=="
                },
                {
                  "data": "IQAhAA=="
                },
                {
                  "data": "IgAiAA=="
                },
                {
                  "data": "AwADAA=="
                }
              ]
            },
            "session": {
              "frames": [
                {
                  "data": "AQABAA=="
                },
                {
                  "data": "AgACAA=="
                },
                {
                  "data": "IQAhAA=="
                },
                {
                  "data": "IgAiAA=="
                },
                {
                  "data": "AwADAA=="
                }
              ],
              "replayed_bytes": 8
            }
          }
        }
      }
    }
  ]
}
