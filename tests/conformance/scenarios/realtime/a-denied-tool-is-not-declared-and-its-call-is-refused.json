{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-denied-tool-is-not-declared-and-its-call-is-refused",
  "title": "A tool the realtime channel's policy denies is not declared and its call is refused before the hooks",
  "rules": [
    "§12.4",
    "§21.1",
    "§9.3"
  ],
  "requirements": [
    "RK-12.4-071",
    "RK-12.4-072"
  ],
  "notes": "The exempt names and a call recovered from spoken text are not shown.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "secret": {
              "result": "s3cret"
            }
          },
          "tool_policy": {
            "deny": [
              "secret"
            ]
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "secret"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c2",
      "name": "lookup"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "declared": [
            {
              "lookup": "$any",
              "secret": {
                "$absent": true
              }
            }
          ],
          "results": [
            {
              "call_id": "c1",
              "result": {
                "$contains": "Tool 'secret' is not permitted by the agent's tool policy."
              }
            },
            {
              "call_id": "c2",
              "result": "found"
            }
          ],
          "handlers": [
            {
              "name": "lookup",
              "outcome": "returned"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "gate": [
        {
          "tool_call": {
            "name": "lookup"
          }
        }
      ],
      "reports": {
        "$unordered": [
          {
            "tool_call": {
              "tool_call_id": "c1",
              "name": "secret",
              "is_error": true,
              "refused": true
            }
          },
          {
            "tool_call": {
              "tool_call_id": "c2",
              "name": "lookup",
              "result": "found",
              "is_error": false
            }
          }
        ]
      }
    }
  }
}
