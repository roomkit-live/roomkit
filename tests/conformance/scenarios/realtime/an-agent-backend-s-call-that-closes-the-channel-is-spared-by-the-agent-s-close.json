{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-agent-backend-s-call-that-closes-the-channel-is-spared-by-the-agent-s-close",
  "title": "A backend agent's call whose handler closes the channel runs on through the close of the agent's turns",
  "rules": [
    "§12.4",
    "§12.4.1",
    "§9.3"
  ],
  "requirements": [
    "RK-12.4-026",
    "RK-12.4-025"
  ],
  "notes": "The hang-up's handler closes the realtime channel from a task it starts and awaits; the channel's close closes the backend's agent, whose close cuts the turn holding the call.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "gate": "lookup-held",
              "result": "late"
            },
            "hangup": {
              "action": "close",
              "in_task": "awaited",
              "result": "bye"
            }
          },
          "reasoning": {
            "agent": {
              "id": "reasoner",
              "type": "ai",
              "model": {
                "rounds": [
                  {
                    "calls": [
                      {
                        "id": "b1",
                        "name": "lookup"
                      },
                      {
                        "id": "b2",
                        "name": "hangup"
                      }
                    ]
                  },
                  {
                    "text": "never"
                  }
                ]
              }
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": [
            {
              "name": "lookup",
              "outcome": "interrupted"
            },
            {
              "name": "hangup",
              "outcome": "returned"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": {
        "$unordered": [
          {
            "tool_call": {
              "tool_call_id": {
                "$contains": [
                  "d1",
                  "b1"
                ]
              },
              "name": "lookup",
              "is_error": true,
              "cancelled": true
            }
          },
          {
            "tool_call": {
              "tool_call_id": {
                "$contains": [
                  "d1",
                  "b2"
                ]
              },
              "name": "hangup",
              "result": "bye",
              "is_error": false
            }
          }
        ]
      }
    },
    "models": {
      "reasoner": [
        "$any"
      ]
    }
  }
}
