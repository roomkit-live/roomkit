{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-role-the-store-holds-at-the-start-shapes-the-declared-tools",
  "title": "A role override applies to the session's participant, with the role the store holds when the tools are declared",
  "rules": [
    "§12.4",
    "§21.1"
  ],
  "requirements": [
    "RK-12.4-073"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "secret": {
              "result": "s3cret"
            }
          },
          "tool_policy": {
            "role_overrides": {
              "observer": {
                "deny": [
                  "secret"
                ]
              }
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ],
        "participants": [
          {
            "id": "alice",
            "room_id": "r1",
            "role": "observer",
            "channel_id": "src"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "secret"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "declared": [
            {
              "lookup": "$any",
              "secret": {
                "$absent": true
              }
            }
          ],
          "results": [
            {
              "call_id": "c1",
              "result": {
                "$contains": "Tool 'secret' is not permitted by the agent's tool policy."
              }
            }
          ],
          "handlers": []
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "name": "secret",
            "is_error": true,
            "refused": true
          }
        }
      ]
    }
  }
}
