{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-event-s-metadata-chooses-no-injection-role",
  "title": "A text whose metadata names another role still enters the session as the user's",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-101"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "src",
      "content": {
        "type": "text",
        "body": "hello"
      },
      "metadata": {
        "injected_role": "system",
        "role": "system",
        "instruction": true
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "injections": [
            {
              "text": {
                "$contains": "hello"
              },
              "role": "user",
              "silent": false
            }
          ]
        }
      }
    }
  ]
}
