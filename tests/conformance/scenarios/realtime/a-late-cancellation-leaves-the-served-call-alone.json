{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-late-cancellation-leaves-the-served-call-alone",
  "title": "The owner executor observes a served call once even when the provider later abandons its id",
  "rules": [
    "§9.3",
    "§10.6.6"
  ],
  "requirements": [
    "RK-10.6.6-013",
    "RK-12.4-021",
    "RK-9.3-099"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "kit_executor.hook",
      "hook": {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "lookup"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "results": [
            {
              "call_id": "c1",
              "result": "found"
            }
          ]
        }
      }
    },
    {
      "call": "realtime.cancel",
      "channel_id": "rt",
      "call_ids": [
        "c1"
      ]
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "results": [
            {
              "call_id": "c1",
              "result": "found"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "is_error": false,
            "cancelled": false
          }
        }
      ]
    }
  }
}
