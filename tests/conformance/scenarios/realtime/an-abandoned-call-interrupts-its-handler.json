{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-abandoned-call-interrupts-its-handler",
  "title": "The channel interrupts the handler of an abandoned call, withholds its result and reports the cancellation",
  "rules": [
    "§9.3"
  ],
  "requirements": [
    "RK-12.4-033",
    "RK-9.3-096",
    "RK-9.3-097",
    "RK-9.3-098"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "gate": "inside",
              "result": "too late"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "lookup"
    },
    {
      "wait_for": "inside"
    },
    {
      "call": "realtime.cancel",
      "channel_id": "rt",
      "call_ids": [
        "c1"
      ]
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "results": [],
          "handlers": [
            {
              "name": "lookup",
              "outcome": "interrupted"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "is_error": true,
            "cancelled": true,
            "refused": false
          }
        }
      ]
    }
  }
}
