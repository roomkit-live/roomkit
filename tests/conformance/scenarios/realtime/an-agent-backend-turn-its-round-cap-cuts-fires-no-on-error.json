{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-agent-backend-turn-its-round-cap-cuts-fires-no-on-error",
  "title": "An agent backend's turn its round cap cuts is an expected end and fires no ON_ERROR",
  "rules": [
    "§12.4.1",
    "§19",
    "§6.4"
  ],
  "requirements": [
    "RK-12.4.1-058"
  ],
  "notes": "The cap stops the turn at its second round of calls, which do not run. A turn its deadline or its budget cut is not shown.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "weather": {
              "result": "sunny"
            }
          },
          "reasoning": {
            "agent": {
              "id": "reasoner",
              "type": "ai",
              "model": {
                "rounds": [
                  {
                    "calls": [
                      {
                        "id": "b1",
                        "name": "lookup"
                      }
                    ]
                  },
                  {
                    "calls": [
                      {
                        "id": "b2",
                        "name": "lookup"
                      }
                    ]
                  },
                  {
                    "text": "never"
                  }
                ]
              },
              "max_tool_rounds": 1
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "errors",
        "trigger": "on_error",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": [
            {
              "name": "lookup",
              "outcome": "returned"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "errors": []
    },
    "models": {
      "reasoner": [
        "$any",
        "$any"
      ]
    }
  }
}
