{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/audio-received-while-the-provider-connects-reaches-it-in-order-before-the-session-starts",
  "title": "The caller's audio received while the provider connects is retained, then flushed to it in arrival order before ON_SESSION_STARTED",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-114",
    "RK-12.4-116"
  ],
  "requires_features": [
    "realtime"
  ],
  "notes": "The 1 MiB bound of the retained audio, and a frame that arrives while the retained ones are flushed, are left to each implementation's tests.",
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "started",
        "trigger": "on_session_started",
        "execution": "async",
        "reactions": [
          {
            "gate": "started"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice",
      "gate": "connecting",
      "background": true,
      "as": "start"
    },
    {
      "wait_for": "connecting"
    },
    {
      "call": "realtime.audio",
      "channel_id": "rt",
      "source": "transport",
      "frames": [
        "ABAAEAAQABA=",
        "ACAAIAAgACA="
      ]
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "provider_audio": []
        }
      }
    },
    {
      "open": "connecting"
    },
    {
      "wait_for": "started"
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "provider_audio": [
            "ABAAEAAQABA=",
            "ACAAIAAgACA="
          ]
        }
      }
    },
    {
      "open": "started"
    },
    {
      "await": "start"
    }
  ]
}
