{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-channel-with-no-backend-answers-each-integrator-delegation-aloud",
  "title": "A realtime channel with no ReasoningBackend answers each delegation to the integrator's target with one spoken output, and a hosted one with none",
  "rules": [
    "§12.4.1"
  ],
  "requirements": [
    "RK-12.4.1-086"
  ],
  "requires_features": [
    "realtime"
  ],
  "notes": "What the output says is the implementation's wording: only that there is one, spoken, is read.",
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d2",
      "target": "hosted"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d3",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "delegation_outputs": [
            {
              "delegation_id": "d1",
              "text": {
                "$present": true
              },
              "spoken": true
            },
            {
              "delegation_id": "d3",
              "text": {
                "$present": true
              },
              "spoken": true
            }
          ]
        }
      }
    }
  ]
}
