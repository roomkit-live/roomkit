{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/the-user-speaking-over-a-full-duplex-model-interrupts-nothing",
  "title": "On a full-duplex provider the user's speech over the model, as the provider reports it, fires the speech hooks and nothing else: no interrupt or truncation, no flush, and the model's audio still plays",
  "rules": [
    "§12.4.1"
  ],
  "requirements": [
    "RK-12.4.1-018",
    "RK-12.4.1-025"
  ],
  "requires_features": [
    "realtime"
  ],
  "notes": "RK-12.4.1-025: the sensor here is the provider's speech events; a transport-level barge-in is not scripted. A flush the channel would ask through a client message of its own, outside the transport's interface, is not read.",
  "setup": {
    "channels": [
      {
        "id": "duplex",
        "type": "realtime_voice",
        "realtime": {
          "full_duplex": true
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "duplex"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "starts",
        "trigger": "on_speech_start",
        "execution": "async"
      },
      {
        "name": "ends",
        "trigger": "on_speech_end",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "duplex",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.response",
      "channel_id": "duplex",
      "edge": "start"
    },
    {
      "call": "realtime.audio",
      "channel_id": "duplex",
      "source": "provider",
      "frames": [
        "ABAAEAAQABA="
      ]
    },
    {
      "idle": true
    },
    {
      "call": "realtime.speech",
      "channel_id": "duplex",
      "edge": "start"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.audio",
      "channel_id": "duplex",
      "source": "provider",
      "frames": [
        "ACAAIAAgACA="
      ]
    },
    {
      "idle": true
    },
    {
      "call": "realtime.speech",
      "channel_id": "duplex",
      "edge": "end"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "duplex",
      "expect": {
        "result": {
          "provider_calls": [],
          "transport_calls": [],
          "transport_audio": [
            "ABAAEAAQABA=",
            "ACAAIAAgACA="
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "starts": [
        {
          "room_id": "r1"
        }
      ],
      "ends": [
        {
          "room_id": "r1"
        }
      ]
    }
  }
}
