{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-hook-injection-enters-the-session-silently",
  "title": "A hook-injected notice enters the realtime model context without requesting an answer",
  "rules": [
    "§9.4"
  ],
  "requirements": [
    "RK-12.4-099",
    "RK-12.4-102",
    "RK-9.4-035"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "notify",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "result": {
              "action": "allow",
              "injected_events": [
                {
                  "event": {
                    "source": {
                      "channel_id": "src",
                      "channel_type": "websocket"
                    },
                    "content": {
                      "type": "text",
                      "body": "notice"
                    }
                  },
                  "target_channel_ids": [
                    "rt"
                  ]
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "src",
      "content": {
        "type": "text",
        "body": "hello"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "injections": [
            {
              "text": {
                "$contains": "hello"
              },
              "silent": false
            },
            {
              "text": {
                "$contains": "notice"
              },
              "silent": true
            }
          ]
        }
      }
    }
  ]
}
