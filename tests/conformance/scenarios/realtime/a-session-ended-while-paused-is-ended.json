{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-session-ended-while-paused-is-ended",
  "title": "A realtime session the integrator paused goes from PAUSED to ENDED when it is ended",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-053"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.set_state",
      "channel_id": "rt",
      "state": "paused"
    },
    {
      "call": "realtime.end",
      "channel_id": "rt"
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "state": "ended"
        }
      }
    }
  ]
}
