{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/call-tool-stays-declared-and-the-policy-judges-the-tool-it-carries",
  "title": "On a session whose declaration is fixed, call_tool stays declared whatever the policy, and the policy judges the tool it carries once the call is unwrapped",
  "rules": [
    "§21.1",
    "§6.4",
    "§12.4"
  ],
  "requirements": [
    "RK-21.1-022"
  ],
  "requires_features": [
    "realtime"
  ],
  "notes": "The policy allows lookup and weather alone, names neither call_tool nor the search tools, and so would deny them were they not exempt. Part of RK-21.1-022: that call_tool is among the names a handler reads is not observed (no realtime handler script reads its call's context).",
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "weather": {
              "result": "sunny"
            },
            "secret": {
              "result": "s3cret"
            }
          },
          "tool_policy": {
            "allow": [
              "lookup",
              "weather"
            ]
          },
          "tool_search": true,
          "tool_search_threshold": 1,
          "supports_mid_session_reconfigure": false
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "call_tool",
      "arguments": {
        "name": "lookup",
        "arguments_json": "{}"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c2",
      "name": "call_tool",
      "arguments": {
        "name": "secret",
        "arguments_json": "{}"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "declared": [
            {
              "call_tool": {
                "$present": true
              },
              "find_tools": {
                "$present": true
              },
              "list_tools": {
                "$present": true
              },
              "lookup": {
                "$absent": true
              },
              "secret": {
                "$absent": true
              }
            }
          ],
          "results": [
            {
              "call_id": "c1",
              "result": "found"
            },
            {
              "call_id": "c2",
              "result": "{\"error\": \"Tool 'secret' is not permitted by the agent's tool policy.\"}"
            }
          ],
          "handlers": [
            {
              "name": "lookup",
              "outcome": "returned"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "name": "lookup",
            "refused": false
          }
        },
        {
          "tool_call": {
            "tool_call_id": "c2",
            "name": "secret",
            "refused": true
          }
        }
      ]
    }
  }
}
