{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-agent-backend-asks-again-after-a-call-its-provider-could-not-parse",
  "title": "An agent backend's turn asks its model again after a call the provider could not parse",
  "rules": [
    "§12.4.1",
    "§19",
    "§6.4"
  ],
  "requirements": [
    "RK-12.4.1-064"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "weather": {
              "result": "sunny"
            }
          },
          "reasoning": {
            "agent": {
              "id": "reasoner",
              "type": "ai",
              "model": {
                "rounds": [
                  {
                    "finish_reason": "malformed_call"
                  },
                  {
                    "text": "Found it."
                  }
                ]
              }
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": []
        }
      }
    }
  ],
  "expect": {
    "models": {
      "reasoner": [
        "$any",
        "$any"
      ]
    },
    "hooks": {
      "reports": []
    }
  }
}
