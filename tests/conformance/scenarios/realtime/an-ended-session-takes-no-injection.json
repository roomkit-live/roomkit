{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-ended-session-takes-no-injection",
  "title": "Text injected into a session that ended reaches no provider and fires no injection hook",
  "rules": [
    "§12.4",
    "§9.2"
  ],
  "requirements": [
    "RK-12.4-092"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "heard",
        "trigger": "on_realtime_text_injected",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.end",
      "channel_id": "rt"
    },
    {
      "call": "realtime.inject",
      "channel_id": "rt",
      "text": "Too late",
      "role": "system"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "injections": []
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "heard": []
    }
  }
}
