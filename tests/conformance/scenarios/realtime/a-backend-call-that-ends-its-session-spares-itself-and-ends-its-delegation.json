{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-backend-call-that-ends-its-session-spares-itself-and-ends-its-delegation",
  "title": "A backend call whose handler ends the session runs on; its other call is answered cancelled and no round follows",
  "rules": [
    "§12.4",
    "§12.4.1",
    "§9.3"
  ],
  "requirements": [
    "RK-12.4-025"
  ],
  "notes": "The hang-up's handler ends the session from a task it starts and awaits, while the backend's lookup waits in a task of its own; the backend's next call is cut before it runs. An ending in a task the handler does not await is not shown.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "gate": "lookup-held",
              "result": "late"
            },
            "hangup": {
              "action": "end_session",
              "in_task": "awaited",
              "result": "bye"
            },
            "more": {
              "result": "more"
            }
          },
          "reasoning": {
            "runs": [
              [
                {
                  "call": "lookup",
                  "task": "l"
                },
                {
                  "wait_for": "lookup-held"
                },
                {
                  "call": "hangup"
                },
                {
                  "join": "l"
                },
                {
                  "call": "more"
                }
              ]
            ]
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": [
            {
              "name": "lookup",
              "outcome": "interrupted"
            },
            {
              "name": "hangup",
              "outcome": "returned"
            }
          ],
          "backend_calls": [
            {
              "name": "lookup",
              "is_error": true,
              "refused": false
            },
            {
              "name": "hangup",
              "text": "bye",
              "is_error": false,
              "refused": false
            },
            {
              "name": "more",
              "cut": true
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": {
        "$unordered": [
          {
            "tool_call": {
              "tool_call_id": {
                "$contains": "d1"
              },
              "name": "lookup",
              "is_error": true,
              "cancelled": true
            }
          },
          {
            "tool_call": {
              "tool_call_id": {
                "$contains": "d1"
              },
              "name": "hangup",
              "result": "bye",
              "is_error": false
            }
          }
        ]
      }
    }
  }
}
