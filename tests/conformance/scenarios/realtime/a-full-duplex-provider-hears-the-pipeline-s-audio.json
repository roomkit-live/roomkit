{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-full-duplex-provider-hears-the-pipeline-s-audio",
  "title": "On a full-duplex provider the audio pipeline keeps its preprocessing role: the provider hears what the denoiser made",
  "rules": [
    "§12.4.1"
  ],
  "requirements": [
    "RK-12.4.1-028"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "full_duplex": true,
          "pipeline": {
            "denoiser": {
              "output": "MzMzMzMzMzM="
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.audio",
      "channel_id": "rt",
      "source": "transport",
      "frames": [
        "ABAAEAAQABA="
      ]
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "provider_audio": [
            "MzMzMzMzMzM="
          ]
        }
      }
    }
  ]
}
