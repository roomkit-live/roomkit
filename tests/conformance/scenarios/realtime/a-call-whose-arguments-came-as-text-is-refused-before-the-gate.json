{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-call-whose-arguments-came-as-text-is-refused-before-the-gate",
  "title": "A call whose arguments reached the channel as text is refused before the gate and reported",
  "rules": [
    "§12.4",
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-12.4-055"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "lookup",
      "arguments_text": "[\"Paris\"]"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "results": [
            {
              "call_id": "c1",
              "result": {
                "$present": true
              }
            }
          ],
          "handlers": []
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "gate": [],
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "name": "lookup",
            "is_error": true,
            "refused": true
          }
        }
      ]
    }
  }
}
