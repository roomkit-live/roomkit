{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-endpointing-pipeline-vad-signals-each-turn-to-the-provider",
  "title": "On a provider that takes turns, the pipeline VAD's speech start and end reach the provider as activity start and end, and the provider's own speech events reach it as nothing",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-122",
    "RK-12.4-123"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "pipeline": {
            "vad": [
              {
                "type": "speech_start"
              },
              {
                "type": "speech_end"
              }
            ]
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "connects": [
            {
              "server_vad": false
            }
          ]
        }
      }
    },
    {
      "call": "realtime.speech",
      "channel_id": "rt",
      "edge": "start"
    },
    {
      "call": "realtime.speech",
      "channel_id": "rt",
      "edge": "end"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "provider_calls": []
        }
      }
    },
    {
      "call": "realtime.audio",
      "channel_id": "rt",
      "source": "transport",
      "frames": [
        "ABAAEAAQABA=",
        "ACAAIAAgACA="
      ]
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "provider_calls": [
            {
              "call": "send_activity_start"
            },
            {
              "call": "send_activity_end"
            }
          ]
        }
      }
    }
  ]
}
