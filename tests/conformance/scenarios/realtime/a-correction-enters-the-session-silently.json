{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-correction-enters-the-session-silently",
  "title": "A model learns the correction silently and can answer the next message",
  "rules": [
    "§10.3"
  ],
  "requirements": [
    "RK-10.3-071"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "src",
      "content": {
        "type": "text",
        "body": "original"
      },
      "participant_id": "alice",
      "as": "said"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "src",
      "participant_id": "alice",
      "event_type": "edit",
      "content": {
        "type": "edit",
        "target_event_id": "$said",
        "new_content": {
          "type": "text",
          "body": "corrected"
        }
      }
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "src",
      "content": {
        "type": "text",
        "body": "next"
      },
      "participant_id": "alice"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "injections": [
            {
              "text": {
                "$contains": "original"
              },
              "silent": false
            },
            {
              "text": {
                "$contains": "corrected"
              },
              "silent": true
            },
            {
              "text": {
                "$contains": "next"
              },
              "silent": false
            }
          ]
        }
      }
    }
  ]
}
