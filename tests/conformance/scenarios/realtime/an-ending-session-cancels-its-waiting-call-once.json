{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-ending-session-cancels-its-waiting-call-once",
  "title": "A call waiting in its handler when the session ends is reported once, as cancelled",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-022"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "gate": "inside",
              "result": "too late"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "lookup"
    },
    {
      "wait_for": "inside"
    },
    {
      "call": "realtime.end",
      "channel_id": "rt"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "results": [],
          "handlers": [
            {
              "name": "lookup",
              "outcome": "interrupted"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "is_error": true,
            "cancelled": true
          }
        }
      ]
    }
  }
}
