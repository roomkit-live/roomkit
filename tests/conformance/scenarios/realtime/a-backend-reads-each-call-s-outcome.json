{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-backend-reads-each-call-s-outcome",
  "title": "execute_tool_call tells a backend a served, a refused and a failed call apart; execute_tool gives the text",
  "rules": [
    "§12.4.1",
    "§9.3"
  ],
  "requirements": [
    "RK-12.4.1-050",
    "RK-12.4.1-062"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "broken": {
              "fails": "upstream down"
            }
          },
          "reasoning": {
            "runs": [
              [
                {
                  "call": "lookup"
                },
                {
                  "call": "missing"
                },
                {
                  "call": "broken"
                },
                {
                  "call": "missing",
                  "via": "execute_tool"
                }
              ]
            ]
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "backend_calls": [
            {
              "name": "lookup",
              "text": "found",
              "is_error": false,
              "refused": false
            },
            {
              "name": "missing",
              "text": {
                "$present": true
              },
              "is_error": true,
              "refused": true
            },
            {
              "name": "broken",
              "text": {
                "$present": true
              },
              "is_error": true,
              "refused": false
            },
            {
              "name": "missing",
              "text": {
                "$present": true
              },
              "is_error": {
                "$absent": true
              }
            }
          ]
        }
      }
    }
  ]
}
