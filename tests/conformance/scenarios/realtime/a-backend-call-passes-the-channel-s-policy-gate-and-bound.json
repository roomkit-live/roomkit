{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-backend-call-passes-the-channel-s-policy-gate-and-bound",
  "title": "A reasoning backend's calls pass the channel's policy, BEFORE_TOOL_USE, ON_TOOL_CALL and result bound",
  "rules": [
    "§12.4.1",
    "§21.1",
    "§21.5",
    "§9.3"
  ],
  "requirements": [
    "RK-12.4.1-060",
    "RK-12.4-072"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found: detail detail detail detail detail detail detail detail detail detail detail detail detail detail detail detail detail detail detail detail END-OF-RESULT"
            },
            "secret": {
              "result": "s3cret"
            }
          },
          "tool_policy": {
            "deny": [
              "secret"
            ]
          },
          "tool_result_max_length": 100,
          "reasoning": {
            "runs": [
              [
                {
                  "call": "secret"
                },
                {
                  "call": "lookup"
                }
              ]
            ]
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "backend_requests": [
            {
              "delegation_id": "d1",
              "tools": {
                "lookup": "$any",
                "secret": {
                  "$absent": true
                }
              }
            }
          ],
          "backend_calls": [
            {
              "name": "secret",
              "text": {
                "$contains": "not permitted"
              },
              "is_error": true,
              "refused": true
            },
            {
              "name": "lookup",
              "text": {
                "$starts_with": "found: detail"
              },
              "is_error": false,
              "refused": false
            }
          ],
          "handlers": [
            {
              "name": "lookup",
              "outcome": "returned"
            }
          ]
        }
      }
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "backend_calls": [
            "$any",
            {
              "name": "lookup",
              "text": {
                "$lacks": "END-OF-RESULT"
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "gate": [
        {
          "tool_call": {
            "name": "lookup"
          }
        }
      ],
      "reports": {
        "$unordered": [
          {
            "tool_call": {
              "tool_call_id": {
                "$contains": "d1"
              },
              "name": "secret",
              "is_error": true,
              "refused": true
            }
          },
          {
            "tool_call": {
              "tool_call_id": {
                "$contains": "d1"
              },
              "name": "lookup",
              "is_error": false
            }
          }
        ]
      }
    }
  }
}
