{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-agent-backend-s-policy-resolves-for-the-participant-s-role",
  "title": "An agent backend's own policy is resolved for the session participant's role and refuses in its loop",
  "rules": [
    "§12.4.1",
    "§19",
    "§6.4"
  ],
  "requirements": [
    "RK-12.4.1-077"
  ],
  "notes": "Its composition with the channel's own policy is not shown.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "weather": {
              "result": "sunny"
            }
          },
          "reasoning": {
            "agent": {
              "id": "reasoner",
              "type": "ai",
              "model": {
                "rounds": [
                  {
                    "calls": [
                      {
                        "id": "b1",
                        "name": "lookup"
                      }
                    ]
                  },
                  {
                    "text": "Cannot."
                  }
                ]
              },
              "tool_policy": {
                "role_overrides": {
                  "observer": {
                    "deny": [
                      "lookup"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ],
        "participants": [
          {
            "id": "alice",
            "room_id": "r1",
            "role": "observer",
            "channel_id": "src"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": [],
          "backend_requests": "$any"
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "gate": [],
      "reports": [
        {
          "tool_call": {
            "tool_call_id": {
              "$contains": [
                "d1",
                "b1"
              ]
            },
            "name": "lookup",
            "is_error": true,
            "refused": true
          }
        }
      ]
    }
  }
}
