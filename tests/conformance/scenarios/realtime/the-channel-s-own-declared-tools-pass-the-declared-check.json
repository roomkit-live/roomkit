{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/the-channel-s-own-declared-tools-pass-the-declared-check",
  "title": "Tool Search's tool while it hides the catalogue, and run_skill_script with an executor, pass the declared check",
  "rules": [
    "§12.4",
    "§21.1",
    "§24.6"
  ],
  "requirements": [
    "RK-12.4-079"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "weather": {
              "result": "sunny"
            }
          },
          "tool_search": true,
          "tool_search_threshold": 1,
          "skills": [
            {
              "name": "billing",
              "description": "Billing work",
              "instructions": "Run the report.",
              "scripts": {
                "report.py": "print('ok')"
              }
            }
          ],
          "script_executor": {
            "result": {
              "exit_code": 0,
              "stdout": "report ready"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "find_tools",
      "arguments": {
        "query": "lookup"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c2",
      "name": "run_skill_script",
      "arguments": {
        "skill_name": "billing",
        "script_name": "report.py"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "declared": [
            {
              "find_tools": "$any",
              "lookup": {
                "$absent": true
              },
              "run_skill_script": "$any"
            },
            "$any"
          ],
          "results": [
            {
              "call_id": "c1",
              "result": {
                "$contains": "lookup"
              }
            },
            {
              "call_id": "c2",
              "result": {
                "$contains": "report ready"
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "name": "find_tools",
            "is_error": false
          }
        },
        {
          "tool_call": {
            "tool_call_id": "c2",
            "name": "run_skill_script",
            "is_error": false
          }
        }
      ]
    },
    "script_executors": {
      "rt": {
        "calls": [
          {
            "skill_name": "billing",
            "script_name": "report.py"
          }
        ],
        "closes": "$any"
      }
    }
  }
}
