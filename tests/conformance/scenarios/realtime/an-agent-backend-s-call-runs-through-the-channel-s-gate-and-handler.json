{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-agent-backend-s-call-runs-through-the-channel-s-gate-and-handler",
  "title": "An agent backend's call runs through the channel's gate and handler, under its model's id within the delegation's",
  "rules": [
    "§12.4.1",
    "§19",
    "§6.4"
  ],
  "requirements": [
    "RK-12.4.1-061",
    "RK-12.4.1-068"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "weather": {
              "result": "sunny"
            }
          },
          "reasoning": {
            "agent": {
              "id": "reasoner",
              "type": "ai",
              "model": {
                "rounds": [
                  {
                    "calls": [
                      {
                        "id": "b1",
                        "name": "lookup"
                      }
                    ]
                  },
                  {
                    "text": "Found it."
                  }
                ]
              }
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": [
            {
              "name": "lookup",
              "outcome": "returned"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "gate": [
        {
          "tool_call": {
            "name": "lookup",
            "tool_call_id": {
              "$contains": [
                "d1",
                "b1"
              ]
            }
          }
        }
      ],
      "reports": [
        {
          "tool_call": {
            "tool_call_id": {
              "$contains": [
                "d1",
                "b1"
              ]
            },
            "name": "lookup",
            "result": "found",
            "is_error": false
          }
        }
      ]
    },
    "models": {
      "reasoner": [
        {
          "tools": {
            "lookup": "$any"
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "b1",
              "name": "lookup",
              "content": "found",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
