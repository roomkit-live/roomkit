{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-call-served-by-hooks-or-the-channel-s-own-tools-passes-the-gate",
  "title": "The gate holds the same whether a call falls to the hooks, Tool Search or a skill activation",
  "rules": [
    "§12.4",
    "§9.3",
    "§21.1"
  ],
  "requirements": [
    "RK-12.4-077"
  ],
  "notes": "The channel has no tool handler: its tools fall to ON_TOOL_CALL's hooks. Tool Search pins lookup, which it leaves declared.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "weather": {
              "result": "sunny"
            }
          },
          "tool_handler": false,
          "tool_search": true,
          "tool_search_pinned": [
            "lookup"
          ],
          "tool_search_threshold": 1,
          "skills": [
            {
              "name": "billing",
              "description": "Billing work",
              "instructions": "Refund with care.",
              "allowed_tools": [
                "refund",
                "secret"
              ]
            }
          ]
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "execution": "sync",
        "reactions": [
          {
            "repeat": true,
            "result": {
              "action": "block",
              "reason": "closed for audit"
            }
          }
        ]
      },
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "lookup"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c2",
      "name": "find_tools",
      "arguments": {
        "query": "lookup"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c3",
      "name": "activate_skill",
      "arguments": {
        "name": "billing"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "results": [
            {
              "call_id": "c1",
              "result": {
                "$contains": "closed for audit"
              }
            },
            {
              "call_id": "c2",
              "result": {
                "$contains": "closed for audit"
              }
            },
            {
              "call_id": "c3",
              "result": {
                "$contains": "closed for audit"
              }
            }
          ],
          "handlers": []
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "gate": [
        {
          "tool_call": {
            "name": "lookup"
          }
        },
        {
          "tool_call": {
            "name": "find_tools"
          }
        },
        {
          "tool_call": {
            "name": "activate_skill"
          }
        }
      ],
      "reports": {
        "$unordered": [
          {
            "tool_call": {
              "tool_call_id": "c1",
              "name": "lookup",
              "is_error": true
            }
          },
          {
            "tool_call": {
              "tool_call_id": "c2",
              "name": "find_tools",
              "is_error": true
            }
          },
          {
            "tool_call": {
              "tool_call_id": "c3",
              "name": "activate_skill",
              "is_error": true
            }
          }
        ]
      }
    }
  }
}
