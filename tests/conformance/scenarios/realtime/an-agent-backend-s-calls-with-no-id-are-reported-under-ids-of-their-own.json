{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-agent-backend-s-calls-with-no-id-are-reported-under-ids-of-their-own",
  "title": "An agent backend's calls that came with no id are each reported under an id of their own",
  "rules": [
    "§12.4.1",
    "§19",
    "§6.4"
  ],
  "requirements": [
    "RK-12.4.1-068"
  ],
  "notes": "Two calls with no id in one round are reported under two distinct ids; whether the second runs is left open.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "weather": {
              "result": "sunny"
            }
          },
          "reasoning": {
            "agent": {
              "id": "reasoner",
              "type": "ai",
              "model": {
                "rounds": [
                  {
                    "calls": [
                      {
                        "id": "",
                        "name": "lookup"
                      },
                      {
                        "id": "",
                        "name": "weather"
                      }
                    ]
                  },
                  {
                    "text": "Found it."
                  }
                ]
              }
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "reports": {
        "$unordered": [
          {
            "tool_call": {
              "tool_call_id": {
                "$as": "first"
              },
              "name": "lookup",
              "is_error": false
            }
          },
          {
            "tool_call": {
              "tool_call_id": {
                "$as": "second"
              },
              "name": "weather"
            }
          }
        ]
      }
    }
  }
}
