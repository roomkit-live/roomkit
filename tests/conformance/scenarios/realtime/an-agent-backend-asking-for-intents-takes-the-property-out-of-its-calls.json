{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-agent-backend-asking-for-intents-takes-the-property-out-of-its-calls",
  "title": "An agent with call intents on that a realtime session delegates to takes the property out of its calls, which the session's door reports with the tool's arguments alone",
  "rules": [
    "§6.4",
    "§12.4.1"
  ],
  "requirements": [
    "RK-6.4-121"
  ],
  "notes": "The reasoning backend is a scripted agent with tool_call_intents on: its model reads the session's tool with the property added to its schema, and calls it with the property among its arguments. Its own loop takes the property out: the call passes the tool's closed schema, and the session's door reports it, BEFORE_TOOL_USE and ON_TOOL_CALL, with the tool's arguments alone. Cited in part: that the door's reports carry no intent is not observed, a hook's tool call not exposing its intent to the runners.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found",
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "city"
                ],
                "properties": {
                  "city": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "reasoning": {
            "agent": {
              "id": "reasoner",
              "type": "ai",
              "tool_call_intents": true,
              "model": {
                "rounds": [
                  {
                    "calls": [
                      {
                        "id": "b1",
                        "name": "lookup",
                        "arguments": {
                          "city": "Paris",
                          "_roomkit_intent": "Je cherche la ville."
                        }
                      }
                    ]
                  },
                  {
                    "text": "Found it."
                  }
                ]
              }
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": [
            {
              "name": "lookup",
              "outcome": "returned"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "gate": [
        {
          "tool_call": {
            "name": "lookup",
            "arguments": {
              "city": "Paris",
              "_roomkit_intent": {
                "$absent": true
              }
            }
          }
        }
      ],
      "reports": [
        {
          "tool_call": {
            "name": "lookup",
            "arguments": {
              "city": "Paris",
              "_roomkit_intent": {
                "$absent": true
              }
            },
            "result": "found",
            "is_error": false
          }
        }
      ]
    },
    "models": {
      "reasoner": [
        {
          "tool_definitions": {
            "lookup": {
              "parameters": {
                "properties": {
                  "city": {
                    "type": "string"
                  },
                  "_roomkit_intent": {
                    "$present": true
                  }
                }
              }
            }
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "b1",
              "name": "lookup",
              "content": "found",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
