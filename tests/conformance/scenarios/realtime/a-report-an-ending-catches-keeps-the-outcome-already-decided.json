{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-report-an-ending-catches-keeps-the-outcome-already-decided",
  "title": "A report under way when the session ends is still made with the outcome already decided: a refusal refused, its body sent or still held, and a call the provider abandoned cancelled",
  "rules": [
    "§12.4",
    "§9.3"
  ],
  "requirements": [
    "RK-12.4-030"
  ],
  "requires_features": [
    "realtime"
  ],
  "notes": "A report is held while it reads the room for its observers; a refusal's body is held at its submission.",
  "setup": {
    "kit": {
      "store_faults": true
    },
    "channels": [
      {
        "id": "sent",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            }
          }
        }
      },
      {
        "id": "held",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            }
          },
          "submit_gate": "submitting"
        }
      },
      {
        "id": "abandoned",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "gate": "running",
              "result": "found"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "sent"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "held"
          }
        ]
      },
      {
        "id": "r3",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "abandoned"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "sent_reports",
        "trigger": "on_tool_call",
        "execution": "async",
        "channel_ids": [
          "sent"
        ]
      },
      {
        "name": "held_reports",
        "trigger": "on_tool_call",
        "execution": "async",
        "channel_ids": [
          "held"
        ]
      },
      {
        "name": "abandoned_reports",
        "trigger": "on_tool_call",
        "execution": "async",
        "channel_ids": [
          "abandoned"
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "sent",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.start",
      "channel_id": "held",
      "room_id": "r2",
      "participant_id": "alice"
    },
    {
      "call": "realtime.start",
      "channel_id": "abandoned",
      "room_id": "r3",
      "participant_id": "alice"
    },
    {
      "store_fault": "load_room_context",
      "room_id": "r1",
      "gate": "reporting"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "sent",
      "call_id": "c1",
      "name": "unknown"
    },
    {
      "wait_for": "reporting"
    },
    {
      "call": "realtime.read",
      "channel_id": "sent",
      "expect": {
        "result": {
          "results": [
            {
              "call_id": "c1",
              "result": {
                "$present": true
              }
            }
          ]
        }
      }
    },
    {
      "call": "realtime.end",
      "channel_id": "sent",
      "background": true,
      "as": "end_sent"
    },
    {
      "open": "reporting"
    },
    {
      "await": "end_sent"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "held",
      "call_id": "c1",
      "name": "unknown"
    },
    {
      "wait_for": "submitting"
    },
    {
      "call": "realtime.end",
      "channel_id": "held",
      "background": true,
      "as": "end_held"
    },
    {
      "open": "submitting"
    },
    {
      "await": "end_held"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "abandoned",
      "call_id": "c1",
      "name": "lookup"
    },
    {
      "wait_for": "running"
    },
    {
      "store_fault": "load_room_context",
      "room_id": "r3",
      "gate": "cancelling"
    },
    {
      "call": "realtime.cancel",
      "channel_id": "abandoned",
      "call_ids": [
        "c1"
      ]
    },
    {
      "wait_for": "cancelling"
    },
    {
      "call": "realtime.end",
      "channel_id": "abandoned",
      "background": true,
      "as": "end_abandoned"
    },
    {
      "open": "cancelling"
    },
    {
      "await": "end_abandoned"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "sent_reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "refused": true,
            "cancelled": false
          }
        }
      ],
      "held_reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "refused": true,
            "cancelled": false
          }
        }
      ],
      "abandoned_reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "refused": false,
            "cancelled": true
          }
        }
      ]
    }
  }
}
