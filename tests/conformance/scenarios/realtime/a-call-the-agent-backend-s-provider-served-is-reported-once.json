{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-call-the-agent-backend-s-provider-served-is-reported-once",
  "title": "A call the agent backend's own provider served is reported once to ON_TOOL_CALL, outside the gate",
  "rules": [
    "§12.4.1",
    "§19",
    "§6.4"
  ],
  "requirements": [
    "RK-12.4.1-067"
  ],
  "notes": "A provider-side call that failed is not shown.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "weather": {
              "result": "sunny"
            }
          },
          "reasoning": {
            "agent": {
              "id": "reasoner",
              "type": "ai",
              "model": {
                "rounds": [
                  {
                    "calls": [
                      {
                        "id": "b1",
                        "name": "web_search",
                        "served": {
                          "result": "three hits"
                        }
                      }
                    ]
                  },
                  {
                    "text": "Found it."
                  }
                ]
              }
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": []
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "gate": [],
      "reports": [
        {
          "tool_call": {
            "tool_call_id": {
              "$contains": [
                "d1",
                "b1"
              ]
            },
            "name": "web_search",
            "result": "three hits",
            "is_error": false
          }
        }
      ]
    }
  }
}
