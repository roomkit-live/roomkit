{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-start-whose-provider-fails-to-connect-ends-its-session",
  "title": "A realtime session whose provider fails to connect goes from CONNECTING to ENDED",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-053"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice",
      "fail": "connect refused",
      "gate": "connecting",
      "background": true,
      "as": "start"
    },
    {
      "wait_for": "connecting"
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "state": "connecting"
        }
      }
    },
    {
      "open": "connecting"
    },
    {
      "await": "start",
      "expect": {
        "error": "provider_failed"
      }
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "state": "ended"
        }
      }
    }
  ]
}
