{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-failed-start-ends-the-call-issued-while-it-was-pending",
  "title": "A start whose provider fails is a session's end for the call the provider issued while it was pending: its handler is interrupted, it is reported once, cancelled, and nothing is sent",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-029"
  ],
  "requires_features": [
    "realtime"
  ],
  "notes": "The call's handler is running when the start fails. A call whose handler has not started when the start fails is not covered (RMK-2129).",
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "gate": "inside",
              "result": "found"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice",
      "gate": "connecting",
      "fail": "connect refused",
      "background": true,
      "as": "start"
    },
    {
      "wait_for": "connecting"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "lookup"
    },
    {
      "wait_for": "inside"
    },
    {
      "open": "connecting"
    },
    {
      "await": "start",
      "expect": {
        "error": "provider_failed"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "results": [],
          "handlers": [
            {
              "name": "lookup",
              "outcome": "interrupted"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "is_error": true,
            "cancelled": true
          }
        }
      ]
    }
  }
}
