{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-called-tool-stays-declared-for-the-session-s-catalogue",
  "title": "A tool a realtime session called stays declared once its result went out, after a later search replaced the window",
  "rules": [
    "§6.4",
    "§12.4"
  ],
  "requirements": [
    "RK-6.4-237"
  ],
  "notes": "Tool Search hides the channel's tools past its threshold. The model calls weather, which Tool Search recovers at call time; the provider's submission of its result holds at a gate, and while it is held the declaration is unchanged. Once the result went out, the session declares weather: the called tool is retained for the current catalogue. A later find_tools for news replaces the search window, and weather stays declared beside it. Cited in part: the retained names a session's end discards are not observed (no declaration follows an end); the catalogue's replacement is realtime/a-replaced-catalogue-keeps-no-called-tool-and-an-old-call-retains-nothing.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "news": {
              "result": "calm"
            },
            "weather": {
              "result": "sunny"
            }
          },
          "tool_search": true,
          "tool_search_threshold": 2,
          "submit_gate": "submitting"
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "weather",
      "background": true,
      "as": "call"
    },
    {
      "wait_for": "submitting"
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "declared": [
            {
              "find_tools": {
                "$present": true
              },
              "weather": {
                "$absent": true
              },
              "news": {
                "$absent": true
              }
            }
          ],
          "results": []
        }
      }
    },
    {
      "open": "submitting"
    },
    {
      "await": "call"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "declared": [
            {
              "find_tools": {
                "$present": true
              },
              "weather": {
                "$absent": true
              },
              "news": {
                "$absent": true
              }
            },
            {
              "find_tools": {
                "$present": true
              },
              "weather": {
                "$present": true
              },
              "news": {
                "$absent": true
              }
            }
          ],
          "results": [
            {
              "call_id": "c1",
              "result": "sunny"
            }
          ]
        }
      }
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c2",
      "name": "find_tools",
      "arguments": {
        "query": "news"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "declared": [
            {
              "find_tools": {
                "$present": true
              },
              "weather": {
                "$absent": true
              },
              "news": {
                "$absent": true
              }
            },
            {
              "find_tools": {
                "$present": true
              },
              "weather": {
                "$present": true
              },
              "news": {
                "$absent": true
              }
            },
            {
              "find_tools": {
                "$present": true
              },
              "weather": {
                "$present": true
              },
              "news": {
                "$present": true
              }
            }
          ]
        }
      }
    }
  ]
}
