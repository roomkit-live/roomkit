{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-keyed-injection-is-one-per-room-channel-and-session",
  "title": "A keyed injection's identity is its room, channel, session and key: one key injects once into each session of another channel or another room, and only a repeat into the same session is a duplicate",
  "rules": [
    "§22.1"
  ],
  "requirements": [
    "RK-22.1-075"
  ],
  "requires_features": [
    "realtime"
  ],
  "notes": "Channel a holds a session in r1 and one in r2, channel b one in r1. Part of RK-22.1-075: two sessions of one channel in one room, which differ by their session alone, are not staged (the fixture starts one session per room on a channel): every pair here differs by its session too, so an identity of the session and the key alone would pass as well.",
  "setup": {
    "channels": [
      {
        "id": "a",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "b",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "a"
          },
          {
            "channel_id": "b"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "a"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "a",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.start",
      "channel_id": "b",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.start",
      "channel_id": "a",
      "room_id": "r2",
      "participant_id": "bob"
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "content": "Your table is ready.",
      "channel_id": "a",
      "idempotency_key": "k",
      "expect": {
        "result": {
          "status": "sent",
          "duplicate": false
        }
      }
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "content": "Your table is ready.",
      "channel_id": "b",
      "idempotency_key": "k",
      "expect": {
        "result": {
          "status": "sent",
          "duplicate": false
        }
      }
    },
    {
      "call": "deliver",
      "room_id": "r2",
      "content": "Your table is ready.",
      "channel_id": "a",
      "idempotency_key": "k",
      "expect": {
        "result": {
          "status": "sent",
          "duplicate": false
        }
      }
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "content": "Your table is ready.",
      "channel_id": "a",
      "idempotency_key": "k",
      "expect": {
        "result": {
          "status": "sent",
          "duplicate": true
        }
      }
    },
    {
      "call": "realtime.read",
      "channel_id": "a",
      "expect": {
        "result": {
          "injections": [
            {
              "text": "Your table is ready."
            },
            {
              "text": "Your table is ready."
            }
          ]
        }
      }
    },
    {
      "call": "realtime.read",
      "channel_id": "b",
      "expect": {
        "result": {
          "injections": [
            {
              "text": "Your table is ready."
            }
          ]
        }
      }
    }
  ]
}
