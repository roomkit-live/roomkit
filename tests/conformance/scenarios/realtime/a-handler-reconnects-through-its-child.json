{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-handler-reconnects-through-its-child",
  "title": "A handler survives the reconnect its child requested while another outstanding call is cancelled",
  "rules": [
    "§9.3"
  ],
  "requirements": [
    "RK-12.4-033",
    "RK-12.4-036",
    "RK-12.4-064",
    "RK-12.4-065",
    "RK-12.4-118",
    "RK-9.3-100",
    "RK-9.3-101",
    "RK-9.3-102",
    "RK-9.3-103"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "gate": "inside",
              "result": "too late"
            },
            "switch_agent": {
              "reconnect": "child",
              "result": "switched"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "lookup"
    },
    {
      "wait_for": "inside"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "h1",
      "name": "switch_agent"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "results": [],
          "handlers": {
            "$unordered": [
              {
                "name": "lookup",
                "outcome": "interrupted"
              },
              {
                "name": "switch_agent",
                "outcome": "returned"
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": {
        "$unordered": [
          {
            "tool_call": {
              "tool_call_id": "c1",
              "is_error": true,
              "cancelled": true
            }
          },
          {
            "tool_call": {
              "tool_call_id": "h1",
              "is_error": false,
              "cancelled": false,
              "result": "switched"
            }
          }
        ]
      }
    }
  }
}
