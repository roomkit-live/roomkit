{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-ended-session-reports-a-late-call-once",
  "title": "A call issued after the session ends bypasses its gate and handler and is reported once as cancelled",
  "rules": [
    "§9.3"
  ],
  "requirements": [
    "RK-9.3-053"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "late"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.end",
      "channel_id": "rt"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "lookup"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "results": [],
          "handlers": []
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "gate": [],
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "is_error": true,
            "cancelled": true
          }
        }
      ]
    }
  }
}
