{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-delivery-waiting-for-idle-waits-out-a-tool-call-the-answer-and-the-user-s-speech",
  "title": "A delivery waiting for idle on a channel hosting a realtime model goes in only once its sessions are idle: not while a tool call runs, nor while the model's answer is awaited or open, nor while the user is heard speaking",
  "rules": [
    "§22.2",
    "§12.4.1"
  ],
  "requirements": [
    "RK-22.2-007",
    "RK-22.2-014"
  ],
  "requires_features": [
    "realtime"
  ],
  "notes": "Each wait is read past a delivery's buffer: a delivery waiting for idle into a second channel's room, idle, is sent once its buffer passed, and the first is still waiting then, held by the tool call, then by the user's speech. The idle wait is read with a short bound where the answer, then the speech alone, holds the room. Part of RK-22.2-007: a session whose audio is still being forwarded is not staged.",
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "gate": "looking",
              "result": "found"
            }
          }
        }
      },
      {
        "id": "other",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "other"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.start",
      "channel_id": "other",
      "room_id": "r2",
      "participant_id": "bob"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "lookup"
    },
    {
      "wait_for": "looking"
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "content": "Next item.",
      "channel_id": "rt",
      "strategy": "wait_for_idle",
      "background": true,
      "as": "held"
    },
    {
      "call": "deliver",
      "room_id": "r2",
      "content": "First pass.",
      "channel_id": "other",
      "strategy": "wait_for_idle",
      "expect": {
        "result": {
          "status": "sent"
        }
      }
    },
    {
      "wait_for": "looking",
      "pending": "held"
    },
    {
      "open": "looking"
    },
    {
      "call": "realtime.wait_idle",
      "channel_id": "rt",
      "room_id": "r1",
      "timeout_ms": 150,
      "expect": {
        "result": false
      }
    },
    {
      "call": "realtime.response",
      "channel_id": "rt",
      "edge": "start"
    },
    {
      "call": "realtime.speech",
      "channel_id": "rt",
      "edge": "start"
    },
    {
      "call": "realtime.wait_idle",
      "channel_id": "rt",
      "room_id": "r1",
      "timeout_ms": 150,
      "expect": {
        "result": false
      }
    },
    {
      "call": "realtime.response",
      "channel_id": "rt",
      "edge": "end"
    },
    {
      "call": "realtime.wait_idle",
      "channel_id": "rt",
      "room_id": "r1",
      "timeout_ms": 150,
      "expect": {
        "result": false
      }
    },
    {
      "call": "deliver",
      "room_id": "r2",
      "content": "Second pass.",
      "channel_id": "other",
      "strategy": "wait_for_idle",
      "expect": {
        "result": {
          "status": "sent"
        }
      }
    },
    {
      "wait_for": "looking",
      "pending": "held"
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "injections": []
        }
      }
    },
    {
      "call": "realtime.speech",
      "channel_id": "rt",
      "edge": "end"
    },
    {
      "await": "held",
      "expect": {
        "result": {
          "status": "sent"
        }
      }
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "injections": [
            {
              "text": "Next item.",
              "role": "user"
            }
          ]
        }
      }
    }
  ]
}
