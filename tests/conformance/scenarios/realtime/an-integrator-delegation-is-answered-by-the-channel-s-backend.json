{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-integrator-delegation-is-answered-by-the-channel-s-backend",
  "title": "A delegation to the integrator's target runs the channel's ReasoningBackend, whose answer reaches the provider under its delegation id; a hosted one does not run it",
  "rules": [
    "§12.4.1"
  ],
  "requirements": [
    "RK-12.4.1-047"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "reasoning": {
            "runs": [
              [
                {
                  "say": "It will be sunny",
                  "final": true
                }
              ]
            ]
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "hosted"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d2",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "backend_requests": [
            {
              "delegation_id": "d2"
            }
          ],
          "delegation_outputs": [
            {
              "delegation_id": "d2",
              "text": "It will be sunny",
              "spoken": true
            }
          ]
        }
      }
    }
  ]
}
