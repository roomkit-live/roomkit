{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-failed-start-discards-the-audio-it-retained",
  "title": "The caller's audio retained while the provider connects is discarded when the start fails",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-116"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice",
      "gate": "connecting",
      "fail": "connect refused",
      "background": true,
      "as": "start"
    },
    {
      "wait_for": "connecting"
    },
    {
      "call": "realtime.audio",
      "channel_id": "rt",
      "source": "transport",
      "frames": [
        "ABAAEAAQABA="
      ]
    },
    {
      "open": "connecting"
    },
    {
      "await": "start",
      "expect": {
        "error": "provider_failed"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "provider_audio": []
        }
      }
    }
  ]
}
