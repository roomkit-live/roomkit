{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/ending-a-session-disconnects-its-provider-and-its-transport",
  "title": "end_session disconnects the session's provider and its transport",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-119"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "provider_calls": [],
          "transport_calls": []
        }
      }
    },
    {
      "call": "realtime.end",
      "channel_id": "rt"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "provider_calls": [
            {
              "call": "disconnect"
            }
          ],
          "transport_calls": [
            {
              "call": "disconnect"
            }
          ]
        }
      }
    }
  ]
}
