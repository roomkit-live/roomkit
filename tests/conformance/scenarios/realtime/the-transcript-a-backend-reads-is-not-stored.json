{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/the-transcript-a-backend-reads-is-not-stored",
  "title": "The transcript a backend is handed is session state: the room stores no event of it beside the transcriptions themselves",
  "rules": [
    "§12.4.1"
  ],
  "requirements": [
    "RK-12.4.1-054"
  ],
  "requires_features": [
    "realtime"
  ],
  "notes": "The room stores the two final transcriptions (RK-12.4-062) and nothing more.",
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "full_duplex": true,
          "reasoning": {
            "runs": [
              [
                {
                  "say": "Sunny",
                  "final": true
                }
              ]
            ]
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.transcribe",
      "channel_id": "rt",
      "text": "Weather?",
      "role": "user",
      "is_final": false
    },
    {
      "call": "realtime.transcribe",
      "channel_id": "rt",
      "text": "Weather?",
      "role": "user"
    },
    {
      "call": "realtime.transcribe",
      "channel_id": "rt",
      "text": "Checking.",
      "role": "assistant",
      "is_final": false
    },
    {
      "call": "realtime.transcribe",
      "channel_id": "rt",
      "text": "Checking.",
      "role": "assistant"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "backend_requests": [
            {
              "transcript": [
                {
                  "role": "user",
                  "text": "Weather?"
                },
                {
                  "role": "assistant",
                  "text": "Checking."
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "body": "Weather?"
          }
        },
        {
          "content": {
            "body": "Checking."
          }
        }
      ]
    }
  }
}
