{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-injection-reports-what-the-provider-knows-of-its-sending",
  "title": "A delivery into a realtime session reports the provider's injection result: sent, a not_sent retryable only when the provider says so, unknown, and no result read as unknown",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-052"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "sent",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "refused",
        "type": "realtime_voice",
        "realtime": {
          "inject_result": {
            "status": "not_sent",
            "reason": "no_connection"
          }
        }
      },
      {
        "id": "busy",
        "type": "realtime_voice",
        "realtime": {
          "inject_result": {
            "status": "not_sent",
            "reason": "provider_busy",
            "retryable": true
          }
        }
      },
      {
        "id": "uncertain",
        "type": "realtime_voice",
        "realtime": {
          "inject_result": {
            "status": "unknown",
            "reason": "queued_locally"
          }
        }
      },
      {
        "id": "silent",
        "type": "realtime_voice",
        "realtime": {
          "inject_result": null
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "sent"
          },
          {
            "channel_id": "refused"
          },
          {
            "channel_id": "busy"
          },
          {
            "channel_id": "uncertain"
          },
          {
            "channel_id": "silent"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "sent",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.start",
      "channel_id": "refused",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.start",
      "channel_id": "busy",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.start",
      "channel_id": "uncertain",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.start",
      "channel_id": "silent",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "content": "Hello",
      "channel_id": "sent",
      "expect": {
        "result": {
          "status": "sent"
        }
      }
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "content": "Hello",
      "channel_id": "refused",
      "expect": {
        "result": {
          "status": "failed",
          "reason": "no_connection",
          "error": {
            "retryable": false
          }
        }
      }
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "content": "Hello",
      "channel_id": "busy",
      "expect": {
        "result": {
          "status": "failed",
          "reason": "provider_busy",
          "error": {
            "retryable": true
          }
        }
      }
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "content": "Hello",
      "channel_id": "uncertain",
      "expect": {
        "result": {
          "status": "unknown",
          "reason": "queued_locally",
          "error": {
            "retryable": false
          }
        }
      }
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "content": "Hello",
      "channel_id": "silent",
      "expect": {
        "result": {
          "status": "unknown"
        }
      }
    }
  ]
}
