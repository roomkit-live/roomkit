{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/on-usage-is-called-on-every-report-with-its-session-and-map",
  "title": "on_usage is called on every report, with the session and the map just recorded",
  "rules": [
    "§12.4.2"
  ],
  "requirements": [
    "RK-12.4.2-008"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "on_usage": {}
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.usage",
      "channel_id": "rt",
      "input_tokens": 120,
      "output_tokens": 45,
      "details": {
        "cached_tokens": 30,
        "audio_output_tokens": 40
      }
    },
    {
      "call": "realtime.usage",
      "channel_id": "rt",
      "input_tokens": 200,
      "output_tokens": 80
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "usage_reports": [
            {
              "session": {
                "room_id": "r1",
                "participant_id": "alice"
              },
              "usage": {
                "input_tokens": 120,
                "output_tokens": 45,
                "cached_tokens": 30
              }
            },
            {
              "session": {
                "room_id": "r1",
                "participant_id": "alice"
              },
              "usage": {
                "input_tokens": 200,
                "output_tokens": 80,
                "cached_tokens": {
                  "$absent": true
                }
              }
            }
          ]
        }
      }
    }
  ]
}
