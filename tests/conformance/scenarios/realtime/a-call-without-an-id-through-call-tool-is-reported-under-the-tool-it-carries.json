{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-call-without-an-id-through-call-tool-is-reported-under-the-tool-it-carries",
  "title": "On a session whose declaration is fixed, a call without an id that came through call_tool is refused and reported under the tool it carries",
  "rules": [
    "§12.4",
    "§6.4"
  ],
  "requirements": [
    "RK-12.4-038"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            },
            "weather": {
              "result": "sunny"
            },
            "news": {
              "result": "calm"
            }
          },
          "tool_search": true,
          "tool_search_threshold": 2,
          "supports_mid_session_reconfigure": false
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "declared": [
            {
              "call_tool": {
                "$present": true
              },
              "weather": {
                "$absent": true
              }
            }
          ]
        }
      }
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "",
      "name": "call_tool",
      "arguments": {
        "name": "weather",
        "arguments_json": "{}"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": [],
          "results": []
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "name": "weather",
            "refused": true
          }
        }
      ]
    }
  }
}
