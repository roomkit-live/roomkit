{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-call-its-handler-declines-is-served-by-nothing-issued-or-recovered-from-speech",
  "title": "A call whose handler declines it is a call nothing served, whether the provider issued it or the channel recovered it from the model's words, and so is one with no handler at all",
  "rules": [
    "§21.4",
    "§9.3",
    "§12.4"
  ],
  "requirements": [
    "RK-21.4-043"
  ],
  "requires_features": [
    "realtime",
    "call_recovery"
  ],
  "notes": "The declining handler answers the earlier convention's envelope, which the adapter reads as the unserved signal (RK-21.4-008). Both channels read the same result on the function-calling path and the same injection on the recovered one, each reporting the call failed, and the declining handler's envelope reaches the model on neither.",
  "setup": {
    "channels": [
      {
        "id": "declines",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "{\"error\": \"Unknown tool: lookup\"}"
            }
          }
        }
      },
      {
        "id": "bare",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            }
          },
          "tool_handler": false
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "declines"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "bare"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "declines",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.start",
      "channel_id": "bare",
      "room_id": "r2",
      "participant_id": "bob"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "declines",
      "call_id": "c1",
      "name": "lookup",
      "arguments": {}
    },
    {
      "idle": true
    },
    {
      "call": "realtime.transcribe",
      "channel_id": "declines",
      "text": "Let me check. call:lookup{}",
      "role": "assistant"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "bare",
      "call_id": "c2",
      "name": "lookup",
      "arguments": {}
    },
    {
      "idle": true
    },
    {
      "call": "realtime.transcribe",
      "channel_id": "bare",
      "text": "Let me check. call:lookup{}",
      "role": "assistant"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "declines",
      "expect": {
        "result": {
          "results": [
            {
              "call_id": "c1",
              "result": {
                "$as": "unserved"
              }
            }
          ],
          "injections": [
            {
              "text": {
                "$as": "recovered"
              },
              "silent": true
            }
          ]
        }
      }
    },
    {
      "call": "realtime.read",
      "channel_id": "bare",
      "expect": {
        "result": {
          "results": [
            {
              "call_id": "c2",
              "result": {
                "$as": "unserved"
              }
            }
          ],
          "injections": [
            {
              "text": {
                "$as": "recovered"
              },
              "silent": true
            }
          ],
          "handlers": []
        }
      }
    },
    {
      "call": "realtime.read",
      "channel_id": "declines",
      "expect": {
        "result": {
          "results": [
            {
              "result": {
                "$lacks": "Unknown tool"
              }
            }
          ],
          "injections": [
            {
              "text": {
                "$starts_with": "[Tool lookup failed]"
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": {
        "$unordered": [
          {
            "room_id": "r1",
            "tool_call": {
              "tool_call_id": "c1",
              "name": "lookup",
              "is_error": true
            }
          },
          {
            "room_id": "r1",
            "tool_call": {
              "name": "lookup",
              "is_error": true
            }
          },
          {
            "room_id": "r2",
            "tool_call": {
              "tool_call_id": "c2",
              "name": "lookup",
              "is_error": true
            }
          },
          {
            "room_id": "r2",
            "tool_call": {
              "name": "lookup",
              "is_error": true
            }
          }
        ]
      }
    }
  }
}
