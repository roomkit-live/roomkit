{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-full-duplex-session-fires-no-barge-in",
  "title": "Speech over the model's audio fires ON_BARGE_IN on a provider that takes turns, never on a full-duplex one",
  "rules": [
    "§12.4.1"
  ],
  "requirements": [
    "RK-12.4.1-027"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "turns",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "duplex",
        "type": "realtime_voice",
        "realtime": {
          "full_duplex": true
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "turns"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "duplex"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "barge",
        "trigger": "on_barge_in",
        "execution": "async"
      },
      {
        "name": "starts",
        "trigger": "on_speech_start",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "turns",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.start",
      "channel_id": "duplex",
      "room_id": "r2",
      "participant_id": "alice"
    },
    {
      "call": "realtime.audio",
      "channel_id": "turns",
      "source": "provider",
      "frames": [
        "ABAAEAAQABA="
      ]
    },
    {
      "call": "realtime.audio",
      "channel_id": "duplex",
      "source": "provider",
      "frames": [
        "ABAAEAAQABA="
      ]
    },
    {
      "idle": true
    },
    {
      "call": "realtime.speech",
      "channel_id": "turns",
      "edge": "start"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.speech",
      "channel_id": "duplex",
      "edge": "start"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "barge": [
        {
          "room_id": "r1"
        }
      ],
      "starts": [
        {
          "room_id": "r1"
        },
        {
          "room_id": "r2"
        }
      ]
    }
  }
}
