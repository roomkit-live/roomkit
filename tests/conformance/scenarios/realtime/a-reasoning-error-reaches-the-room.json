{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-reasoning-error-reaches-the-room",
  "title": "The room receives a failed reasoning turn in the reasoning category",
  "rules": [
    "§9.2"
  ],
  "requirements": [
    "RK-9.2-105",
    "RK-A.11-004",
    "RK-A.11-009"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "reasoning_error": "reasoner offline"
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "errors",
        "trigger": "on_error",
        "execution": "async",
        "reactions": [
          {
            "gate": "reported"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "wait_for": "reported"
    },
    {
      "open": "reported"
    }
  ],
  "expect": {
    "hooks": {
      "errors": [
        {
          "event": {
            "metadata": {
              "error_category": "reasoning",
              "error": "reasoner offline"
            }
          },
          "room_id": "r1"
        }
      ]
    }
  }
}
