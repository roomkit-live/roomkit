{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-gate-that-refuses-a-recovered-call-runs-no-handler",
  "title": "BEFORE_TOOL_USE refuses a call recovered from the model's words as it refuses a provider's call: its handler never runs, and the refusal returns as silent injected context",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-046",
    "RK-12.4-047"
  ],
  "requires_features": [
    "realtime",
    "call_recovery"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "block",
              "reason": "not now"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.transcribe",
      "channel_id": "rt",
      "text": "call:lookup{}",
      "role": "assistant"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "results": [],
          "handlers": [],
          "injections": [
            {
              "text": {
                "$starts_with": "[Tool lookup denied]"
              },
              "silent": true
            }
          ]
        }
      }
    }
  ]
}
