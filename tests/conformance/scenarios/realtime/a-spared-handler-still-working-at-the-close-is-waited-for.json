{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-spared-handler-still-working-at-the-close-is-waited-for",
  "title": "A handler that ended its session and still works when the kit closes is waited for, then reports once",
  "rules": [
    "§12.4",
    "§12.10.4",
    "§9.3"
  ],
  "requirements": [
    "RK-12.4-027"
  ],
  "notes": "The handler is held at a gate after its ending until the kit's close is under way, then works 300 ms more while its channel closes. The channel's own close, while the kit lives, is not shown.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "gate": "lookup-held",
              "result": "late"
            },
            "hangup": {
              "action": "end_session",
              "after_gate": "working",
              "delay_ms": 300,
              "result": "bye"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "lookup"
    },
    {
      "wait_for": "lookup-held"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c2",
      "name": "hangup"
    },
    {
      "wait_for": "working"
    },
    {
      "call": "close",
      "background": true,
      "as": "closing"
    },
    {
      "open": "working"
    },
    {
      "await": "closing"
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": [
            {
              "name": "lookup",
              "outcome": "interrupted"
            },
            {
              "name": "hangup",
              "outcome": "returned"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": {
        "$unordered": [
          {
            "tool_call": {
              "tool_call_id": "c1",
              "name": "lookup",
              "is_error": true,
              "cancelled": true
            }
          },
          {
            "tool_call": {
              "tool_call_id": "c2",
              "name": "hangup",
              "result": "bye",
              "is_error": false,
              "cancelled": false
            }
          }
        ]
      }
    }
  }
}
