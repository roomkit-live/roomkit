{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-handler-that-closes-its-channel-runs-on-and-the-other-call-is-cut",
  "title": "A handler that closes its channel runs on and reports its result; the other call is cut",
  "rules": [
    "§12.4",
    "§9.3"
  ],
  "requirements": [
    "RK-12.4-023"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "gate": "lookup-held",
              "result": "late"
            },
            "hangup": {
              "action": "close",
              "result": "bye"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c1",
      "name": "lookup"
    },
    {
      "wait_for": "lookup-held"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "c2",
      "name": "hangup"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": [
            {
              "name": "lookup",
              "outcome": "interrupted"
            },
            {
              "name": "hangup",
              "outcome": "returned"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": {
        "$unordered": [
          {
            "tool_call": {
              "tool_call_id": "c1",
              "name": "lookup",
              "is_error": true,
              "cancelled": true
            }
          },
          {
            "tool_call": {
              "tool_call_id": "c2",
              "name": "hangup",
              "result": "bye",
              "is_error": false,
              "cancelled": false
            }
          }
        ]
      }
    }
  }
}
