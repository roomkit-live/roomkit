{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-broadcast-text-enters-under-its-author-s-label",
  "title": "A text another channel broadcast enters the session as the user's, under its author's label",
  "rules": [
    "§12.4",
    "§6.4"
  ],
  "requirements": [
    "RK-12.4-100"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "sms1",
        "type": "sms"
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms1"
          },
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ],
        "participants": [
          {
            "id": "marie",
            "channel_id": "sms1",
            "display_name": "Marie"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "caller"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "sms1",
      "participant_id": "marie",
      "content": {
        "type": "text",
        "body": "one"
      }
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "src",
      "content": {
        "type": "text",
        "body": "two"
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "injections": [
            {
              "text": "Marie: “one”",
              "role": "user",
              "silent": false
            },
            {
              "text": "@src: “two”",
              "role": "user",
              "silent": false
            }
          ]
        }
      }
    }
  ]
}
