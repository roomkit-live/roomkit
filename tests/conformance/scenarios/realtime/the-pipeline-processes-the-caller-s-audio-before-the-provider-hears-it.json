{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/the-pipeline-processes-the-caller-s-audio-before-the-provider-hears-it",
  "title": "A pipeline on a realtime channel sits between the transport and the provider: AEC, AGC, denoiser, then diarization, and the provider hears what they made",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-120",
    "RK-12.4-127"
  ],
  "requires_features": [
    "realtime"
  ],
  "notes": "No resampler is scripted: the transport's rate is the provider's.",
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "pipeline": {
            "aec": {
              "output": "ERERERERERE="
            },
            "agc": {
              "output": "IiIiIiIiIiI="
            },
            "denoiser": {
              "output": "MzMzMzMzMzM="
            },
            "speakers": [
              {
                "speaker_id": "s1",
                "confidence": 0.9,
                "is_new_speaker": true
              }
            ]
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.audio",
      "channel_id": "rt",
      "source": "transport",
      "frames": [
        "ABAAEAAQABA="
      ]
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "calls": [
        "process"
      ],
      "expect": {
        "result": {
          "stages": [
            {
              "stage": "aec",
              "frame": {
                "data": "ABAAEAAQABA="
              }
            },
            {
              "stage": "agc",
              "frame": {
                "data": "ERERERERERE="
              }
            },
            {
              "stage": "denoiser",
              "frame": {
                "data": "IiIiIiIiIiI="
              }
            },
            {
              "stage": "diarization",
              "frame": {
                "data": "MzMzMzMzMzM="
              }
            }
          ],
          "provider_audio": [
            "MzMzMzMzMzM="
          ]
        }
      }
    }
  ]
}
