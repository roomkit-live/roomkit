{
  "$schema": "../../scenario.schema.json",
  "id": "binding-update/update-binding-metadata-changed",
  "title": "update_binding_metadata changes storage without notifying the channel",
  "rules": [
    "§7.2",
    "§7.5"
  ],
  "requirements": [
    "RK-5.1-016",
    "RK-7.2-010",
    "RK-7.2-012"
  ],
  "notes": "Python: tests/test_lifecycle_hooks.py::test_a_binding_change_that_changes_nothing_writes_and_fires_nothing; tests/test_binding_updates.py::test_a_gate_change_notifies_after_storage_before_its_hook. Callback arguments preserve the stored room and binding.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "update_binding": {}
      }
    ],
    "rooms": [
      {
        "id": "room",
        "bindings": [
          {
            "channel_id": "sms",
            "muted": false,
            "output_muted": false,
            "access": "read_write",
            "visibility": "all",
            "metadata": {}
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "muted",
        "trigger": "on_channel_muted",
        "execution": "async"
      },
      {
        "name": "unmuted",
        "trigger": "on_channel_unmuted",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "update_binding_metadata",
      "room_id": "room",
      "channel_id": "sms",
      "metadata": {
        "team": "blue"
      },
      "expect": {
        "result": {
          "room_id": "room",
          "channel_id": "sms",
          "muted": false,
          "output_muted": false,
          "access": "read_write",
          "visibility": "all",
          "metadata": {
            "team": "blue"
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room": {
        "sms": {
          "room_id": "room",
          "channel_id": "sms",
          "muted": false,
          "output_muted": false,
          "access": "read_write",
          "visibility": "all",
          "metadata": {
            "team": "blue"
          }
        }
      }
    },
    "room_callbacks": {
      "room": {
        "sms": []
      }
    },
    "hook_order": [],
    "hooks": {
      "muted": [],
      "unmuted": []
    },
    "lifecycle": {
      "room": [
        {
          "type": "channel_attached"
        },
        {
          "type": "channel_updated"
        }
      ]
    }
  }
}
