{
  "$schema": "../../scenario.schema.json",
  "id": "binding-update/mute-output-changed",
  "title": "mute_output notifies after its stored gate change",
  "rules": [
    "§7.2",
    "§7.5"
  ],
  "requirements": [
    "RK-7.2-008",
    "RK-7.2-010"
  ],
  "notes": "Python: tests/test_lifecycle_hooks.py::test_a_binding_change_that_changes_nothing_writes_and_fires_nothing; tests/test_binding_updates.py::test_a_gate_change_notifies_after_storage_before_its_hook. Callback arguments preserve the stored room and binding.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "update_binding": {}
      }
    ],
    "rooms": [
      {
        "id": "room",
        "bindings": [
          {
            "channel_id": "sms",
            "muted": false,
            "output_muted": false,
            "access": "read_write",
            "visibility": "all",
            "metadata": {}
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "muted",
        "trigger": "on_channel_muted",
        "execution": "async"
      },
      {
        "name": "unmuted",
        "trigger": "on_channel_unmuted",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "mute_output",
      "room_id": "room",
      "channel_id": "sms",
      "expect": {
        "result": {
          "room_id": "room",
          "channel_id": "sms",
          "muted": false,
          "output_muted": true,
          "access": "read_write",
          "visibility": "all",
          "metadata": {}
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room": {
        "sms": {
          "room_id": "room",
          "channel_id": "sms",
          "muted": false,
          "output_muted": true,
          "access": "read_write",
          "visibility": "all",
          "metadata": {}
        }
      }
    },
    "room_callbacks": {
      "room": {
        "sms": [
          {
            "call": "update_binding",
            "binding": {
              "room_id": "room",
              "channel_id": "sms",
              "muted": false,
              "output_muted": true,
              "access": "read_write",
              "visibility": "all",
              "metadata": {}
            }
          }
        ]
      }
    },
    "hook_order": [
      "sms.update_binding"
    ],
    "hooks": {
      "muted": [],
      "unmuted": []
    },
    "lifecycle": {
      "room": [
        {
          "type": "channel_attached"
        }
      ]
    }
  }
}
