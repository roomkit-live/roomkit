{
  "$schema": "../../scenario.schema.json",
  "id": "binding-update/a-binding-changes-in-a-room-of-any-status",
  "title": "mute, set_access and update_binding_metadata change a binding in a paused, a closed and an archived room alike: stored, and ON_CHANNEL_MUTED fired, the room's status unchanged",
  "rules": [
    "§7.2",
    "§5.1"
  ],
  "requirements": [
    "RK-7.2-013"
  ],
  "notes": "The rooms reach their status through the kit's transitions before the steps. Whether a lifecycle record is written in a room that is not active is §5.1's, and not compared.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      }
    ],
    "rooms": [
      {
        "id": "room-paused",
        "status": "paused",
        "bindings": [
          {
            "channel_id": "sms",
            "muted": false,
            "access": "read_write",
            "visibility": "all",
            "metadata": {}
          }
        ]
      },
      {
        "id": "room-closed",
        "status": "closed",
        "bindings": [
          {
            "channel_id": "sms",
            "muted": false,
            "access": "read_write",
            "visibility": "all",
            "metadata": {}
          }
        ]
      },
      {
        "id": "room-archived",
        "status": "archived",
        "bindings": [
          {
            "channel_id": "sms",
            "muted": false,
            "access": "read_write",
            "visibility": "all",
            "metadata": {}
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "muted",
        "trigger": "on_channel_muted",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "mute",
      "room_id": "room-paused",
      "channel_id": "sms",
      "expect": {
        "result": {
          "room_id": "room-paused",
          "channel_id": "sms",
          "muted": true
        }
      }
    },
    {
      "call": "set_access",
      "room_id": "room-paused",
      "channel_id": "sms",
      "access": "read_only",
      "expect": {
        "result": {
          "room_id": "room-paused",
          "access": "read_only",
          "muted": true
        }
      }
    },
    {
      "call": "update_binding_metadata",
      "room_id": "room-paused",
      "channel_id": "sms",
      "metadata": {
        "persona": "night"
      },
      "expect": {
        "result": {
          "room_id": "room-paused",
          "access": "read_only",
          "muted": true,
          "metadata": {
            "persona": "night"
          }
        }
      }
    },
    {
      "call": "get_room",
      "room_id": "room-paused",
      "expect": {
        "result": {
          "id": "room-paused",
          "status": "paused"
        }
      }
    },
    {
      "call": "mute",
      "room_id": "room-closed",
      "channel_id": "sms",
      "expect": {
        "result": {
          "room_id": "room-closed",
          "channel_id": "sms",
          "muted": true
        }
      }
    },
    {
      "call": "set_access",
      "room_id": "room-closed",
      "channel_id": "sms",
      "access": "read_only",
      "expect": {
        "result": {
          "room_id": "room-closed",
          "access": "read_only",
          "muted": true
        }
      }
    },
    {
      "call": "update_binding_metadata",
      "room_id": "room-closed",
      "channel_id": "sms",
      "metadata": {
        "persona": "night"
      },
      "expect": {
        "result": {
          "room_id": "room-closed",
          "access": "read_only",
          "muted": true,
          "metadata": {
            "persona": "night"
          }
        }
      }
    },
    {
      "call": "get_room",
      "room_id": "room-closed",
      "expect": {
        "result": {
          "id": "room-closed",
          "status": "closed"
        }
      }
    },
    {
      "call": "mute",
      "room_id": "room-archived",
      "channel_id": "sms",
      "expect": {
        "result": {
          "room_id": "room-archived",
          "channel_id": "sms",
          "muted": true
        }
      }
    },
    {
      "call": "set_access",
      "room_id": "room-archived",
      "channel_id": "sms",
      "access": "read_only",
      "expect": {
        "result": {
          "room_id": "room-archived",
          "access": "read_only",
          "muted": true
        }
      }
    },
    {
      "call": "update_binding_metadata",
      "room_id": "room-archived",
      "channel_id": "sms",
      "metadata": {
        "persona": "night"
      },
      "expect": {
        "result": {
          "room_id": "room-archived",
          "access": "read_only",
          "muted": true,
          "metadata": {
            "persona": "night"
          }
        }
      }
    },
    {
      "call": "get_room",
      "room_id": "room-archived",
      "expect": {
        "result": {
          "id": "room-archived",
          "status": "archived"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "bindings": {
      "room-paused": {
        "sms": {
          "muted": true,
          "access": "read_only",
          "visibility": "all",
          "metadata": {
            "persona": "night"
          }
        }
      },
      "room-closed": {
        "sms": {
          "muted": true,
          "access": "read_only",
          "visibility": "all",
          "metadata": {
            "persona": "night"
          }
        }
      },
      "room-archived": {
        "sms": {
          "muted": true,
          "access": "read_only",
          "visibility": "all",
          "metadata": {
            "persona": "night"
          }
        }
      }
    },
    "hooks": {
      "muted": {
        "$unordered": [
          {
            "trigger": "on_channel_muted",
            "room_id": "room-paused"
          },
          {
            "trigger": "on_channel_muted",
            "room_id": "room-closed"
          },
          {
            "trigger": "on_channel_muted",
            "room_id": "room-archived"
          }
        ]
      }
    }
  }
}
