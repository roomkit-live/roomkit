{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-dial-in-reaches-the-identity-a-text-from-its-number-reaches",
  "title": "A phone participant joining the conference reaches the Identity a text message from the same number reaches",
  "rules": [
    "§12.10.2"
  ],
  "requirements": [
    "RK-12.10.2-031"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15550101"
            },
            "result": {
              "status": "identified",
              "identity": {
                "id": "user-42",
                "display_name": "Alice"
              }
            },
            "repeat": true
          }
        ]
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "address_keys": [
        "caller_number"
      ]
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550101",
        "content": {
          "type": "text",
          "body": "On my way"
        }
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "dial-in-1",
      "metadata": {
        "caller_number": "+15550101"
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "resolver": [
      {
        "room_id": "r1",
        "channel_id": "sms",
        "sender_id": "+15550101"
      },
      {
        "room_id": "r1",
        "channel_id": "conf",
        "sender_id": "+15550101"
      }
    ],
    "participants": {
      "r1": {
        "$unordered": [
          {
            "identity_id": "user-42",
            "channel_id": "sms"
          },
          {
            "id": "dial-in-1",
            "identity_id": "user-42",
            "channel_id": "conf"
          }
        ]
      }
    }
  }
}
