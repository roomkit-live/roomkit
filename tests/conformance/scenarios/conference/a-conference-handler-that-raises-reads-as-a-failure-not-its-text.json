{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-conference-handler-that-raises-reads-as-a-failure-not-its-text",
  "title": "A conference tool handler that raises answers the model that the tool failed, without the exception's text",
  "rules": [
    "§12.10.12"
  ],
  "requirements": [
    "RK-12.10.12-060"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "ON_TOOL_CALL's result is the text the model reads: it lacks the exception's text, whatever members it holds.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {
        "lookup": {
          "fails": "connection string secret-7731 refused"
        }
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "c1",
      "name": "lookup",
      "expect": {
        "result": {
          "error": {
            "$lacks": "secret-7731"
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "handlers": [
            {
              "name": "lookup",
              "outcome": "raised"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "is_error": true,
            "result": {
              "$lacks": "secret-7731"
            }
          }
        }
      ]
    }
  }
}
