{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-resolved-participant-s-utterances-are-not-resolved-again",
  "title": "A dial-in resolved on arrival speaks twice and a guest with no address speaks once: identity resolution does not run per utterance and no unknown-identity hook fires",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-11.6-003",
    "RK-12.10.4-146"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15550101"
            },
            "result": {
              "status": "identified",
              "identity": {
                "id": "user-42",
                "display_name": "Alice"
              }
            },
            "repeat": true
          }
        ]
      }
    },
    "identity_hooks": [
      {
        "name": "unknown",
        "trigger": "on_identity_unknown"
      }
    ],
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        },
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "First point"
              }
            ]
          },
          {
            "results": [
              {
                "text": "Second point"
              }
            ]
          },
          {
            "results": [
              {
                "text": "Guest point"
              }
            ]
          }
        ]
      },
      "address_keys": [
        "caller_number"
      ]
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "dial-in-1",
      "metadata": {
        "caller_number": "+15550101"
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "guest"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "dial-in-1",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "guest",
      "track_id": "g-mic",
      "kind": "audio"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        "AQA=",
        "AgA="
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        "AwA=",
        "BAA="
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "g-mic",
      "frames": [
        "AQA=",
        "AgA="
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    }
  ],
  "expect": {
    "resolver": [
      {
        "room_id": "r1",
        "channel_id": "conf",
        "sender_id": "+15550101"
      }
    ],
    "hooks": {
      "unknown": []
    },
    "timeline": {
      "r1": [
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "First point"
          },
          "source": {
            "channel_id": "conf",
            "participant_id": "dial-in-1"
          }
        },
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "Second point"
          },
          "source": {
            "channel_id": "conf",
            "participant_id": "dial-in-1"
          }
        },
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "Guest point"
          },
          "source": {
            "channel_id": "conf",
            "participant_id": "guest"
          }
        }
      ]
    }
  }
}
