{
  "$schema": "../../scenario.schema.json",
  "id": "conference/semantic-interruption-is-refused-in-a-conference",
  "title": "A conference configured with the SEMANTIC interruption strategy is refused when the channel is built",
  "rules": [
    "§12.10.5"
  ],
  "requirements": [
    "RK-12.10.5-006"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tts": {},
      "interruption": {
        "strategy": "semantic"
      },
      "expect": {
        "error": {
          "name": "invalid_argument"
        }
      }
    }
  ]
}
