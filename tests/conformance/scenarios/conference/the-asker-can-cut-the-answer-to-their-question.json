{
  "$schema": "../../scenario.schema.json",
  "id": "conference/the-asker-can-cut-the-answer-to-their-question",
  "title": "A participant whose question is still being routed, its answer being spoken, cuts the bot off by speaking again on the same track",
  "rules": [
    "§12.10.5"
  ],
  "requirements": [
    "RK-12.10.5-003"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The question's routing lasts until the turn it starts is over, the answer's delivery to the conference included; the track that asked is heard meanwhile. The bot is cut while its utterance's first chunk is still being synthesized: its turn has begun, nothing of it is published yet.",
  "setup": {
    "channels": [
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "It is noon"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tts": {
        "gates": [
          "held"
        ]
      },
      "interruption": {
        "scope": "any"
      },
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        },
        {
          "type": "speech_start"
        }
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "What time is it?"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "bob",
      "track_id": "mic-b",
      "kind": "audio"
    },
    {
      "idle": true
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-b",
      "frames": [
        "",
        ""
      ]
    },
    {
      "wait_for": "held"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-b",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "cut"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot",
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "session": {
                "$as": "bot"
              }
            },
            {
              "call": "stop_playback",
              "session": {
                "$as": "bot"
              }
            }
          ],
          "synthesized": [
            "It is noon"
          ]
        }
      }
    },
    {
      "open": "cut"
    },
    {
      "open": "held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "conference": {
            "room_id": "r1",
            "track_id": "mic-b",
            "participant_id": "bob"
          }
        }
      ]
    },
    "timeline": {
      "r1": [
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "What time is it?"
          },
          "source": {
            "channel_id": "conf",
            "participant_id": "bob"
          }
        },
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "It is noon"
          },
          "source": {
            "channel_id": "ai"
          }
        }
      ]
    }
  }
}
