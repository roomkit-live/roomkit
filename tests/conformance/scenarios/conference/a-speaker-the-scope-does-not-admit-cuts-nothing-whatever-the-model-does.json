{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-speaker-the-scope-does-not-admit-cuts-nothing-whatever-the-model-does",
  "title": "A speaker the interruption scope does not admit fires no barge-in and stops no playback, whatever the model does on hearing them; an admitted speaker does",
  "rules": [
    "§12.10.12",
    "§12.10.5"
  ],
  "requirements": [
    "RK-12.10.12-042"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "Bob speaks over the first response: the model hears him and ends its response itself, and the framework neither stops the playback nor fires a barge-in. Alice, whom the scope admits, then cuts the second one off.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "barge",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {},
      "vad": [
        {
          "type": "speech_start"
        }
      ],
      "interruption": {
        "scope": "allowlist",
        "allowlist": [
          "alice"
        ]
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic-a",
      "kind": "audio"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "bob",
      "track_id": "mic-b",
      "kind": "audio"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "start"
    },
    {
      "call": "realtime.audio",
      "channel_id": "conf",
      "source": "provider",
      "frames": [
        ""
      ]
    },
    {
      "idle": true
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-b",
      "frames": [
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "realtime.speech",
      "channel_id": "conf",
      "edge": "start"
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "end"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "publish_audio",
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "publish_audio",
              "is_final": false
            },
            {
              "call": "publish_audio",
              "is_final": true
            }
          ]
        }
      }
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "start"
    },
    {
      "call": "realtime.audio",
      "channel_id": "conf",
      "source": "provider",
      "frames": [
        ""
      ]
    },
    {
      "idle": true
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "end"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "stop_playback"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "barge": [
        {
          "conference": {
            "track_id": "mic-a",
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
