{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-delivery-is-published-on-the-bot-s-one-track",
  "title": "A synthesized delivery is published once, on the bot's one session, whoever is in the conference",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-215"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tts": {}
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Hello there"
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "session": {
                "$as": "bot"
              }
            }
          ],
          "utterances": [
            {
              "session": {
                "$as": "bot"
              },
              "complete": true
            }
          ],
          "bots": [
            {
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    }
  ]
}
