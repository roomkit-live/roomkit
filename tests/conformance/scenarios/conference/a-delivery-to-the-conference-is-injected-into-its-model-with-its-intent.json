{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-delivery-to-the-conference-is-injected-into-its-model-with-its-intent",
  "title": "A delivery naming the conference is injected into its connected model: content with the user intent, an instruction with the system intent",
  "rules": [
    "§12.10.12",
    "§12.4",
    "§22.1"
  ],
  "requirements": [
    "RK-12.10.12-026"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {}
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "channel_id": "conf",
      "content": "The agenda changed.",
      "expect": {
        "result": {
          "status": "sent"
        }
      }
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "channel_id": "conf",
      "content": "Greet everyone.",
      "instruction": true,
      "expect": {
        "result": {
          "status": "sent"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "model": {
            "injections": [
              {
                "text": {
                  "$contains": "Connect the model."
                },
                "role": "user"
              },
              {
                "text": "The agenda changed.",
                "role": "user",
                "silent": false
              },
              {
                "text": "Greet everyone.",
                "role": "system",
                "silent": false
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {}
}
