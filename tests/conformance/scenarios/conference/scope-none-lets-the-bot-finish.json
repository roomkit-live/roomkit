{
  "$schema": "../../scenario.schema.json",
  "id": "conference/scope-none-lets-the-bot-finish",
  "title": "With scope none, speech during the bot's utterance stops nothing and the utterance is published in full",
  "rules": [
    "§12.10.5"
  ],
  "requirements": [
    "RK-12.10.5-004"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "A recognition held at its gate shows the lane processed the utterance's every frame, each weighed for an interruption, before the read. The bot is cut while its utterance's first chunk is still being synthesized: its turn has begun, nothing of it is published yet. Holding the bot after a published chunk needs conference.fault (P6-CF4).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tts": {
        "gates": [
          "held"
        ]
      },
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "interruption": {
        "scope": "none"
      },
      "stt": {
        "streams": [
          {
            "gate": "heard-b",
            "results": [
              {
                "text": "Words 1"
              }
            ]
          },
          {
            "gate": "heard-a",
            "results": [
              {
                "text": "Words 2"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic-a",
      "kind": "audio"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "bob",
      "track_id": "mic-b",
      "kind": "audio"
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Hello there"
      },
      "background": true,
      "as": "said"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-b",
      "frames": [
        "",
        ""
      ]
    },
    {
      "wait_for": "heard-b"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        "",
        ""
      ]
    },
    {
      "wait_for": "heard-a"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": []
        }
      }
    },
    {
      "open": "heard-b"
    },
    {
      "open": "heard-a"
    },
    {
      "open": "held"
    },
    {
      "await": "said"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": [],
          "utterances": [
            {
              "complete": true
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "cut": []
    }
  }
}
