{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-delivery-into-the-conference-model-fires-the-injection-hook",
  "title": "A delivery injected into the conference's connected model fires the injection hook",
  "rules": [
    "§12.10.12"
  ],
  "requirements": [
    "RK-12.10.12-029"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "injected",
        "trigger": "on_realtime_text_injected",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {
        "lookup": "found"
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Prepare the lookup."
      }
    },
    {
      "idle": true
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "channel_id": "conf",
      "content": "The agenda changed.",
      "expect": {
        "result": {
          "status": "sent"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "injected": [
        {
          "room_id": "r1",
          "event": {
            "content": {
              "body": {
                "$contains": "Prepare the lookup."
              }
            }
          }
        },
        {
          "room_id": "r1",
          "event": {
            "content": {
              "body": "The agenda changed."
            }
          }
        }
      ]
    }
  }
}
