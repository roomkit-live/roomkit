{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-plug-the-backend-cannot-apply-in-place-re-joins-announced",
  "title": "A plug whose grants the backend cannot update in place replaces the session: a leave and a join, each announced, and the replacement's grants announced",
  "rules": [
    "§12.10.4",
    "§12.10.7"
  ],
  "requirements": [
    "RK-12.10.4-196",
    "RK-12.10.7-009",
    "RK-12.10.7-012"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "Plugging a voice widens the grants the bot needs (publish_audio). The backend declares no BOT_GRANT_UPDATE, so the session is replaced; its grants changed, carried by the replacement, and conference_bot_grants_changed names the new session (maintainer's answer to HITL 01527428: Python emitted it for set_bot_grants only).",
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "idle": true
    },
    {
      "call": "conference.plug",
      "channel_id": "conf",
      "kind": "tts"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot",
        "leave"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "session": {
                "$as": "first"
              }
            },
            {
              "call": "leave",
              "session": {
                "$as": "first"
              }
            },
            {
              "call": "join_as_bot",
              "session": {
                "$as": "second"
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "media_events": {
      "r1": [
        {
          "$unordered": [
            {
              "event": "conference_participant_joined",
              "participant_id": "alice"
            },
            {
              "event": "conference_started",
              "bot_session_id": {
                "$as": "first"
              }
            }
          ]
        },
        {
          "event": "conference_ended",
          "bot_session_id": {
            "$as": "first"
          }
        },
        {
          "$unordered": [
            {
              "event": "conference_started",
              "bot_session_id": {
                "$as": "second"
              }
            },
            {
              "event": "conference_bot_grants_changed",
              "room_id": "r1",
              "channel_id": "conf",
              "bot_session_id": {
                "$as": "second"
              },
              "hidden": false
            }
          ]
        }
      ]
    }
  }
}
