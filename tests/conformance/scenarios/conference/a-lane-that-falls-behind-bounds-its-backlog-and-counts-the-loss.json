{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-lane-that-falls-behind-bounds-its-backlog-and-counts-the-loss",
  "title": "A lane whose recognition holds bounds the frames it keeps and exposes how many it discarded",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-158",
    "RK-12.10.4-160"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "Which frames a full lane discards is the implementation's (RK-12.10.4-159): with two frames held beside the one in recognition, six frames arriving while recognition holds leave four discarded, whichever four, for a lane that discards at most one frame per frame past its bound.",
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "stt": {
        "streams": [
          {
            "gate": "recognizing",
            "results": [
              {
                "text": "held"
              }
            ]
          }
        ]
      },
      "max_queued_frames": 2
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        "",
        ""
      ]
    },
    {
      "wait_for": "recognizing"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        ""
      ],
      "repeat": 6
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "lane_dropped": {
            "mic": 4
          }
        }
      }
    },
    {
      "open": "recognizing"
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    }
  ]
}
