{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-conference-is-refused-while-the-last-one-s-deferred-teardown-holds-the-room",
  "title": "A conference channel attached from the announcement a detach's teardown is deferred behind is refused at once, though the binding is gone; once the teardown has ended it is accepted",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-127",
    "RK-12.10.4-128"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The attach is made from the handler of the bot's conference_started, which the first channel's teardown is deferred behind: a wait there would never end.",
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "event_handlers": [
      {
        "event": "conference_started",
        "reactions": [
          {
            "do": [
              {
                "call": "detach_channel",
                "room_id": "r1",
                "channel_id": "conf"
              },
              {
                "call": "get_binding",
                "room_id": "r1",
                "channel_id": "conf",
                "expect": {
                  "error": "channel_not_bound"
                }
              },
              {
                "call": "conference.open",
                "channel_id": "conf2",
                "room_id": "r1",
                "expect": {
                  "error": "conference_already_attached"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "idle": true
    },
    {
      "call": "conference.open",
      "channel_id": "conf3",
      "room_id": "r1"
    },
    {
      "call": "get_binding",
      "room_id": "r1",
      "channel_id": "conf3",
      "expect": {
        "result": {
          "channel_id": "conf3"
        }
      }
    }
  ]
}
