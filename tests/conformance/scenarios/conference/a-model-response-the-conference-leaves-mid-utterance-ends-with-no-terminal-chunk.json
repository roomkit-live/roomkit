{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-model-response-the-conference-leaves-mid-utterance-ends-with-no-terminal-chunk",
  "title": "An utterance the channel abandons because it left the conference is not closed with a terminal chunk, and what the model still sends is not published",
  "rules": [
    "§12.10.12",
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.12-033",
    "RK-12.10.4-222"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "RK-12.10.12-033 in part, the leave: the utterance's opening and its end are read by conference/a-model-response-is-one-utterance-its-end-closes, its barge-in by conference/a-barge-in-on-the-model-s-voice-names-the-speaker-and-closes-the-utterance.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {}
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "start"
    },
    {
      "call": "realtime.audio",
      "channel_id": "conf",
      "source": "provider",
      "frames": [
        ""
      ]
    },
    {
      "idle": true
    },
    {
      "call": "detach_channel",
      "room_id": "r1",
      "channel_id": "conf"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.audio",
      "channel_id": "conf",
      "source": "provider",
      "frames": [
        ""
      ]
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "end"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "publish_audio"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "publish_audio",
              "is_final": false
            }
          ],
          "utterances": [
            {
              "complete": false
            }
          ]
        }
      }
    }
  ],
  "expect": {}
}
