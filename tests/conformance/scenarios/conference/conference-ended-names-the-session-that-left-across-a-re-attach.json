{
  "$schema": "../../scenario.schema.json",
  "id": "conference/conference-ended-names-the-session-that-left-across-a-re-attach",
  "title": "Across a detach and a re-attach, each conference_ended carries the session of its conference_started",
  "rules": [
    "§12.10.7"
  ],
  "requirements": [
    "RK-12.10.7-013",
    "RK-12.10.7-014"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "idle": true
    },
    {
      "call": "detach_channel",
      "room_id": "r1",
      "channel_id": "conf"
    },
    {
      "call": "attach_channel",
      "room_id": "r1",
      "channel_id": "conf"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "idle": true
    },
    {
      "call": "detach_channel",
      "room_id": "r1",
      "channel_id": "conf"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "media_events": {
      "r1": [
        {
          "$unordered": [
            {
              "event": "conference_participant_joined",
              "participant_id": "alice"
            },
            {
              "event": "conference_started",
              "bot_session_id": {
                "$as": "first"
              }
            }
          ]
        },
        {
          "event": "conference_ended",
          "bot_session_id": {
            "$as": "first"
          }
        },
        {
          "$unordered": [
            {
              "event": "conference_started",
              "bot_session_id": {
                "$as": "second"
              }
            },
            {
              "event": "conference_participant_joined",
              "participant_id": "bob"
            }
          ]
        },
        {
          "event": "conference_ended",
          "bot_session_id": {
            "$as": "second"
          }
        }
      ]
    }
  }
}
