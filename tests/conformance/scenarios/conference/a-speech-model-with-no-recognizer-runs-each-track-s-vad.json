{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-speech-model-with-no-recognizer-runs-each-track-s-vad",
  "title": "A conference composing a speech-to-speech model with no recognizer still runs a VAD on each track, and reports each track's speech",
  "rules": [
    "§12.10.12"
  ],
  "requirements": [
    "RK-12.10.12-052"
  ],
  "notes": "The stages' reset calls are not read: whether a lane resets its stages before a track's first frame (RK-12.3.1-024) is not what this scenario is about.",
  "requires_features": [
    "conference",
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "start",
        "trigger": "on_speech_start",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {},
      "vad": [
        {
          "type": "speech_start"
        }
      ]
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic-a",
      "kind": "audio"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "bob",
      "track_id": "mic-b",
      "kind": "audio"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "info": {
            "rooms": {
              "r1": {
                "realtime_active": true
              }
            }
          }
        }
      }
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-b",
      "frames": [
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "stage_calls": [
        "process"
      ],
      "expect": {
        "result": {
          "info": {
            "stt_configured": false,
            "realtime_configured": true
          },
          "stages": [
            {
              "stage": "vad",
              "stream": "mic-a"
            },
            {
              "stage": "vad",
              "stream": "mic-b"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "start": [
        {
          "conference": {
            "track_id": "mic-a",
            "participant_id": "alice"
          }
        },
        {
          "conference": {
            "track_id": "mic-b",
            "participant_id": "bob"
          }
        }
      ]
    }
  }
}
