{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-detach-with-no-bot-announces-no-end",
  "title": "A detach from a conference the bot never joined announces no end",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-114"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "idle": true
    },
    {
      "call": "detach_channel",
      "room_id": "r1",
      "channel_id": "conf"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "media_events": {
      "r1": []
    }
  }
}
