{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-conference-tool-call-passes-the-pre-execution-gate",
  "title": "A conference model's call to an undeclared tool is refused before any hook, and BEFORE_TOOL_USE blocks or edits a declared one before its handler",
  "rules": [
    "§12.10.12",
    "§12.4",
    "§9.2"
  ],
  "requirements": [
    "RK-12.10.12-053"
  ],
  "notes": "The declared-tool check and BEFORE_TOOL_USE only: the ToolPolicy check needs a tool_policy option on conference.open, and argument validation (edited arguments included) a declared schema, the runner declaring every tool with an empty object schema.",
  "requires_features": [
    "conference",
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_tool_use",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "block",
              "reason": "not now"
            }
          },
          {
            "result": {
              "action": "allow",
              "metadata": {
                "arguments": {
                  "q": "edited"
                }
              }
            }
          }
        ]
      },
      {
        "name": "reported",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {
        "lookup": "found"
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Prepare the lookup."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "c1",
      "name": "erase",
      "arguments": {
        "q": "all"
      },
      "expect": {
        "result": {
          "error": {
            "$present": true
          }
        }
      }
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "c2",
      "name": "lookup",
      "arguments": {
        "q": "first"
      },
      "expect": {
        "result": {
          "error": "not now"
        }
      }
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "c3",
      "name": "lookup",
      "arguments": {
        "q": "second"
      },
      "expect": {
        "result": "found"
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "gate": [
        {
          "tool_call": {
            "tool_call_id": "c2",
            "name": "lookup",
            "arguments": {
              "q": "first"
            }
          }
        },
        {
          "tool_call": {
            "tool_call_id": "c3",
            "name": "lookup",
            "arguments": {
              "q": "second"
            }
          }
        }
      ],
      "reported": {
        "$unordered": [
          {
            "tool_call": {
              "tool_call_id": "c1",
              "name": "erase",
              "refused": true
            }
          },
          {
            "tool_call": {
              "tool_call_id": "c2",
              "name": "lookup",
              "refused": true
            }
          },
          {
            "tool_call": {
              "tool_call_id": "c3",
              "name": "lookup",
              "arguments": {
                "q": "edited"
              },
              "result": "found",
              "is_error": false,
              "refused": false
            }
          }
        ]
      }
    }
  }
}
