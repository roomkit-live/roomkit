{
  "$schema": "../../scenario.schema.json",
  "id": "conference/an-address-the-participant-s-own-client-supplied-is-never-resolved",
  "title": "An unconfigured conference resolves nothing on a caller number the participant's own client supplied, the participant left unknown",
  "rules": [
    "§12.10.2"
  ],
  "requirements": [
    "RK-12.10.2-038",
    "RK-12.10.2-042"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15550101"
            },
            "result": {
              "status": "identified",
              "identity": {
                "id": "user-42",
                "display_name": "Alice"
              }
            },
            "repeat": true
          }
        ]
      }
    },
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "address_keys": [
        "caller_number"
      ]
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "guest",
      "metadata": {},
      "client_metadata": {
        "caller_number": "+15550101"
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "resolver": [],
    "participants": {
      "r1": [
        {
          "id": "guest",
          "identification": "unknown",
          "identity_id": null,
          "external_id": "guest"
        }
      ]
    }
  }
}
