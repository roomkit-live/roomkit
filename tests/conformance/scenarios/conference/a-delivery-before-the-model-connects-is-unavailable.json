{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-delivery-before-the-model-connects-is-unavailable",
  "title": "A delivery naming a speech-to-speech conference whose model has not connected is unavailable",
  "rules": [
    "§12.10.12"
  ],
  "requirements": [
    "RK-12.10.12-027"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {
        "lookup": "found"
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "channel_id": "conf",
      "content": "The agenda changed.",
      "expect": {
        "result": {
          "status": "unavailable"
        }
      }
    }
  ],
  "expect": {}
}
