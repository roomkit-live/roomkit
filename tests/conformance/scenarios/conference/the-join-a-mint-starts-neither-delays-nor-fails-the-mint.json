{
  "$schema": "../../scenario.schema.json",
  "id": "conference/the-join-a-mint-starts-neither-delays-nor-fails-the-mint",
  "title": "A mint returns its credential when the join it starts fails, and while the join it starts is held",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-086",
    "RK-12.10.4-087"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The second mint returns while its join holds at its gate.",
  "setup": {
    "rooms": [
      {
        "id": "r1",
        "participants": [
          {
            "id": "alice",
            "channel_id": "conf",
            "display_name": "Alice"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.fault",
      "channel_id": "conf",
      "method": "join_as_bot",
      "fail": "the SFU refuses the bot"
    },
    {
      "call": "conference.mint",
      "channel_id": "conf",
      "room_id": "r1",
      "participant_id": "alice",
      "expect": {
        "result": {
          "token": {
            "$present": true
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "room_id": "r1"
            }
          ],
          "bots": []
        }
      }
    },
    {
      "call": "conference.fault",
      "channel_id": "conf",
      "method": "join_as_bot",
      "gate": "joining"
    },
    {
      "call": "conference.mint",
      "channel_id": "conf",
      "room_id": "r1",
      "participant_id": "alice",
      "expect": {
        "result": {
          "token": {
            "$present": true
          }
        }
      }
    },
    {
      "wait_for": "joining"
    },
    {
      "open": "joining"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "bots": [
            {
              "session": {
                "$as": "bot"
              },
              "room_id": "r1"
            }
          ]
        }
      }
    }
  ]
}
