{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-voice-only-bot-joins-without-subscribing",
  "title": "A bot that only speaks joins with derived grants that publish audio and do not subscribe",
  "rules": [
    "§12.10.3"
  ],
  "requirements": [
    "RK-12.10.3-044"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "stt": null,
      "tts": {}
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "bots": [
            {
              "grants": {
                "publish_audio": true,
                "subscribe": false
              }
            }
          ]
        }
      }
    }
  ]
}
