{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-call-reports-presence-without-changing-room-membership",
  "title": "A conference reports an arrival and a departure while the primary channel keeps its members’ statuses",
  "rules": [
    "§5.5",
    "§9.2",
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.1-004",
    "RK-17.7-009",
    "RK-5.5-041",
    "RK-9.2-090",
    "RK-9.2-091",
    "RK-A.15-015",
    "RK-A.15-019"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "conference_participant_joined",
        "trigger": "on_conference_participant_joined",
        "execution": "async"
      },
      {
        "name": "conference_participant_left",
        "trigger": "on_conference_participant_left",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "add_member",
      "room_id": "r1",
      "channel_id": "ws",
      "participant_id": "alice"
    },
    {
      "call": "add_member",
      "room_id": "r1",
      "channel_id": "ws",
      "participant_id": "bob"
    },
    {
      "call": "remove_member",
      "room_id": "r1",
      "participant_id": "bob"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.leave",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "participants": {
      "r1": {
        "$unordered": [
          {
            "id": "alice",
            "channel_id": "ws",
            "status": "active",
            "connected_via": [
              "ws",
              "conf"
            ]
          },
          {
            "id": "bob",
            "channel_id": "ws",
            "status": "left",
            "connected_via": [
              "ws",
              "conf"
            ]
          }
        ]
      }
    },
    "hooks": {
      "conference_participant_joined": {
        "$unordered": [
          {
            "room_id": "r1",
            "event": {
              "content": {
                "data": {
                  "channel_id": "conf",
                  "participant_id": "alice"
                }
              }
            }
          },
          {
            "room_id": "r1",
            "event": {
              "content": {
                "data": {
                  "channel_id": "conf",
                  "participant_id": "bob"
                }
              }
            }
          }
        ]
      },
      "conference_participant_left": [
        {
          "room_id": "r1",
          "event": {
            "content": {
              "data": {
                "channel_id": "conf",
                "participant_id": "alice"
              }
            }
          }
        }
      ]
    }
  }
}
