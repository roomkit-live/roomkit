{
  "$schema": "../../scenario.schema.json",
  "id": "conference/an-encrypted-conference-refuses-recognition-and-recording",
  "title": "An end-to-end encrypted conference is refused with a recognizer or a recording configured",
  "rules": [
    "§12.10.2"
  ],
  "requirements": [
    "RK-12.10.2-057"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The RFC lets an implementation offering E2EE either admit the bot as a key holder or refuse framework media intelligence; this observes the refusal, the option an implementation without a key-holder contract takes.",
  "setup": {
    "rooms": [
      {
        "id": "r1"
      },
      {
        "id": "r2"
      },
      {
        "id": "r3"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "heard",
      "room_id": "r1",
      "e2ee": true,
      "capabilities": [
        "e2ee"
      ],
      "expect": {
        "error": {
          "name": "invalid_argument"
        }
      }
    },
    {
      "call": "conference.open",
      "channel_id": "kept",
      "room_id": "r2",
      "stt": null,
      "recording": {},
      "e2ee": true,
      "capabilities": [
        "e2ee"
      ],
      "expect": {
        "error": {
          "name": "invalid_argument"
        }
      }
    },
    {
      "call": "conference.open",
      "channel_id": "sealed",
      "room_id": "r3",
      "stt": null,
      "e2ee": true,
      "capabilities": [
        "e2ee"
      ]
    }
  ]
}
