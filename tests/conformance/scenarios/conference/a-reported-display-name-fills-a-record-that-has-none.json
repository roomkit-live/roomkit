{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-reported-display-name-fills-a-record-that-has-none",
  "title": "A display name the SFU reports fills a roster record that has none and never overwrites the one the integrator set",
  "rules": [
    "§12.10.3"
  ],
  "requirements": [
    "RK-12.10.3-053"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1",
        "participants": [
          {
            "id": "alice",
            "channel_id": "conf",
            "display_name": "Alice Martin"
          },
          {
            "id": "carol",
            "channel_id": "conf"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice",
      "display_name": "alice-laptop"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "carol",
      "display_name": "Carol"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob",
      "display_name": "Bob"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "participants": {
      "r1": [
        {
          "id": "alice",
          "display_name": "Alice Martin"
        },
        {
          "id": "carol",
          "display_name": "Carol"
        },
        {
          "id": "bob",
          "display_name": "Bob"
        }
      ]
    }
  }
}
