{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-detach-waits-for-a-held-mint-which-returns-no-credential",
  "title": "A detach during a mint held in the backend waits for it before the bot leaves, and the mint that returns then hands out no credential",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-116",
    "RK-12.10.4-139",
    "RK-12.10.4-140"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The mint returns uncancelled, so the detach waited for it rather than taking it back. The publication half of the detach's wait (RK-12.10.4-116) is not observed here.",
  "setup": {
    "rooms": [
      {
        "id": "r1",
        "participants": [
          {
            "id": "alice",
            "channel_id": "conf",
            "display_name": "Alice"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "room_id": "r1",
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    },
    {
      "call": "conference.fault",
      "channel_id": "conf",
      "method": "mint_access",
      "gate": "minting"
    },
    {
      "call": "conference.mint",
      "channel_id": "conf",
      "room_id": "r1",
      "participant_id": "alice",
      "background": true,
      "as": "mint"
    },
    {
      "wait_for": "minting"
    },
    {
      "call": "detach_channel",
      "room_id": "r1",
      "channel_id": "conf",
      "background": true,
      "as": "detach"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "mint_access",
        "leave"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "mint_access",
              "participant_id": "alice"
            }
          ]
        }
      }
    },
    {
      "wait_for": "minting",
      "pending": "detach"
    },
    {
      "open": "minting"
    },
    {
      "await": "mint",
      "expect": {
        "error": "room_not_attached"
      }
    },
    {
      "await": "detach"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "mint_access",
        "leave"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "mint_access",
              "participant_id": "alice",
              "cancelled": {
                "$absent": true
              }
            },
            {
              "call": "leave",
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    }
  ]
}
