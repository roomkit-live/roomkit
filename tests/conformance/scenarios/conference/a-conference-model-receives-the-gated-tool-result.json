{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-conference-model-receives-the-gated-tool-result",
  "title": "The conference sends its model the result the tool gate permits, including an emptied result",
  "rules": [
    "§9.3",
    "§12.10.12"
  ],
  "requirements": [
    "RK-12.10.12-054",
    "RK-12.4-020",
    "RK-12.5-023",
    "RK-9.3-093"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "on_tool_call",
        "execution": "sync",
        "reactions": [
          {
            "result": {
              "action": "block",
              "reason": "withheld"
            }
          },
          {
            "result": {
              "action": "modify",
              "event": {
                "result": "revised"
              }
            }
          },
          {
            "result": {
              "action": "allow",
              "metadata": {
                "result": "from the hook"
              }
            }
          },
          {
            "result": {
              "action": "allow",
              "metadata": {
                "result": null
              }
            }
          }
        ]
      },
      {
        "name": "tool_call",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {
        "lookup": "unfiltered"
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Prepare the lookup."
      }
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "call-1",
      "name": "lookup",
      "expect": {
        "result": {
          "error": "withheld"
        }
      }
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "call-2",
      "name": "lookup",
      "expect": {
        "result": "revised"
      }
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "call-3",
      "name": "lookup",
      "expect": {
        "result": "from the hook"
      }
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "call-4",
      "name": "lookup",
      "expect": {
        "result": null
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "tool_call": [
        {
          "tool_call": {
            "tool_call_id": "call-1",
            "is_error": true
          }
        },
        {
          "tool_call": {
            "tool_call_id": "call-2",
            "is_error": false
          }
        },
        {
          "tool_call": {
            "tool_call_id": "call-3",
            "is_error": false
          }
        },
        {
          "tool_call": {
            "tool_call_id": "call-4",
            "is_error": false
          }
        }
      ]
    }
  }
}
