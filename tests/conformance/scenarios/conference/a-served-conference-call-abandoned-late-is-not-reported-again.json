{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-served-conference-call-abandoned-late-is-not-reported-again",
  "title": "A conference tool call whose outcome ON_TOOL_CALL already received is not reported again when the model abandons it afterwards",
  "rules": [
    "§12.10.12"
  ],
  "requirements": [
    "RK-12.10.12-058"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "The abandon arrives once the result was submitted; the window between the report and the result's submission is not reached.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {
        "lookup": "found"
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "c1",
      "name": "lookup",
      "expect": {
        "result": "found"
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.cancel",
      "channel_id": "conf",
      "call_ids": [
        "c1"
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "result": "found",
            "is_error": false,
            "cancelled": false
          }
        }
      ]
    }
  }
}
