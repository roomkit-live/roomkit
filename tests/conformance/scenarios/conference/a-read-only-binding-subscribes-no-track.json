{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-read-only-binding-subscribes-no-track",
  "title": "A binding the room only reads from subscribes no track; given write access, it subscribes them",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-168"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "set_access",
      "room_id": "r1",
      "channel_id": "conf",
      "access": "read_only"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "t1",
      "kind": "audio"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "subscribe_track"
      ],
      "expect": {
        "result": {
          "calls": []
        }
      }
    },
    {
      "call": "set_access",
      "room_id": "r1",
      "channel_id": "conf",
      "access": "write_only"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "subscribe_track"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "subscribe_track",
              "track_id": "t1",
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    }
  ]
}
