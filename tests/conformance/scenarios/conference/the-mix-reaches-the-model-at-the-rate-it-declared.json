{
  "$schema": "../../scenario.schema.json",
  "id": "conference/the-mix-reaches-the-model-at-the-rate-it-declared",
  "title": "The mixed stream is resampled to the model's declared input rate before it is sent",
  "rules": [
    "§12.10.12"
  ],
  "requirements": [
    "RK-12.10.12-016"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "A 20 ms frame at 16 kHz holds 320 samples; what the model receives of it holds the 480 of 20 ms at the 24 kHz it declared.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {},
      "vad": [],
      "realtime": {
        "input_sample_rate": 24000
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic-a",
      "kind": "audio"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf",
      "mix": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "model": {
            "connects": [
              {
                "input_sample_rate": 24000
              }
            ],
            "heard": {
              "samples": 480
            }
          }
        }
      }
    }
  ],
  "expect": {}
}
