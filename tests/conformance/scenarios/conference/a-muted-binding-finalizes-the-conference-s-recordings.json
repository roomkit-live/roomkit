{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-muted-binding-finalizes-the-conference-s-recordings",
  "title": "Muting the conference's binding stops and finalizes its recordings, and frames fed after it are written to none",
  "rules": [
    "§12.10.4",
    "§12.10.8"
  ],
  "requirements": [
    "RK-12.10.4-175",
    "RK-12.10.8-018"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "stt": null,
      "recording": {}
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        "AQA="
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "mute",
      "room_id": "r1",
      "channel_id": "conf",
      "expect": {
        "result": {
          "muted": true
        }
      }
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        "AgA="
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "recording.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "recordings": [
            {
              "tracks": [
                {
                  "track_id": "mic"
                }
              ],
              "chunks": [
                "AQA="
              ],
              "stopped": true
            }
          ]
        }
      }
    }
  ],
  "expect": {}
}
