{
  "$schema": "../../scenario.schema.json",
  "id": "conference/grants-are-derived-at-the-join-from-the-plugs-made-before-it",
  "title": "A voice plugged before the bot joins is covered by the grants of that join",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-194"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.plug",
      "channel_id": "conf",
      "kind": "tts"
    },
    {
      "call": "conference.ensure_bot",
      "channel_id": "conf",
      "room_id": "r1",
      "expect": {
        "result": {
          "id": {
            "$as": "bot"
          },
          "room_id": "r1"
        }
      }
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "room_id": "r1",
              "session": {
                "$as": "bot"
              },
              "grants": {
                "subscribe": true,
                "publish_audio": true
              }
            }
          ]
        }
      }
    }
  ]
}
