{
  "$schema": "../../scenario.schema.json",
  "id": "conference/ensure-bot-racing-an-arrival-s-join-joins-the-room-once",
  "title": "ensure_bot() issued while an arrival's join is held waits for that join, and the room is joined once",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-095"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.fault",
      "channel_id": "conf",
      "method": "join_as_bot",
      "gate": "joining"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice",
      "background": true,
      "as": "arrival"
    },
    {
      "wait_for": "joining"
    },
    {
      "call": "conference.ensure_bot",
      "channel_id": "conf",
      "room_id": "r1",
      "background": true,
      "as": "ensure"
    },
    {
      "open": "joining"
    },
    {
      "await": "ensure",
      "expect": {
        "result": {
          "id": {
            "$as": "bot"
          },
          "room_id": "r1"
        }
      }
    },
    {
      "await": "arrival"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "room_id": "r1",
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    }
  ]
}
