{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-closed-collection-gate-closes-the-lanes",
  "title": "When the binding's collection gate closes, the channel closes the lanes it runs",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-174"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "info": {
            "rooms": {
              "r1": {
                "active_lanes": 1
              }
            }
          }
        }
      }
    },
    {
      "call": "mute",
      "room_id": "r1",
      "channel_id": "conf"
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "info": {
            "rooms": {
              "r1": {
                "active_lanes": 0
              }
            }
          }
        }
      }
    }
  ]
}
