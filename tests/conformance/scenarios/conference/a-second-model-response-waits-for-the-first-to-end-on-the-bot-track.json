{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-second-model-response-waits-for-the-first-to-end-on-the-bot-track",
  "title": "A second model response waits for its turn: its chunks follow the first utterance's final chunk, never interleaved with it",
  "rules": [
    "§12.10.12",
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.12-034",
    "RK-12.10.4-216"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "The first response's first chunk holds in the backend while the rest of it, then the whole second response, arrive: the first utterance goes out whole, and the second only after its end.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {}
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.fault",
      "channel_id": "conf",
      "method": "publish_audio",
      "gate": "published"
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "start"
    },
    {
      "call": "realtime.audio",
      "channel_id": "conf",
      "source": "provider",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "published"
    },
    {
      "call": "realtime.audio",
      "channel_id": "conf",
      "source": "provider",
      "frames": [
        ""
      ]
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "end"
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "start"
    },
    {
      "call": "realtime.audio",
      "channel_id": "conf",
      "source": "provider",
      "frames": [
        ""
      ]
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "end"
    },
    {
      "open": "published"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "publish_audio"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "publish_audio",
              "is_final": false
            },
            {
              "call": "publish_audio",
              "is_final": false
            },
            {
              "call": "publish_audio",
              "is_final": true
            },
            {
              "call": "publish_audio",
              "is_final": false
            },
            {
              "call": "publish_audio",
              "is_final": true
            }
          ],
          "utterances": [
            {
              "complete": true
            },
            {
              "complete": true
            }
          ]
        }
      }
    }
  ],
  "expect": {}
}
