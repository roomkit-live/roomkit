{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-mint-applies-the-channel-s-default-grants-unless-the-caller-overrides-them",
  "title": "mint_access asks the backend for the channel's default grants when the caller names none, and for the caller's when it does",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-132"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The defaults are a grant set whose unnamed members keep ConferenceGrants' defaults, as is the caller's.",
  "setup": {
    "rooms": [
      {
        "id": "r1",
        "participants": [
          {
            "id": "alice",
            "channel_id": "conf"
          },
          {
            "id": "bob",
            "channel_id": "conf"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "default_grants": {
        "publish_audio": true,
        "subscribe": true,
        "publish_screen_share": false,
        "moderate": true
      }
    },
    {
      "call": "conference.mint",
      "channel_id": "conf",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "conference.mint",
      "channel_id": "conf",
      "room_id": "r1",
      "participant_id": "bob",
      "grants": {
        "publish_audio": false
      }
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "mint_access"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "mint_access",
              "participant_id": "alice",
              "grants": {
                "publish_audio": true,
                "publish_video": true,
                "publish_screen_share": false,
                "publish_screen_share_audio": false,
                "subscribe": true,
                "moderate": true,
                "hidden": false
              }
            },
            {
              "call": "mint_access",
              "participant_id": "bob",
              "grants": {
                "publish_audio": false,
                "publish_video": true,
                "publish_screen_share": true,
                "publish_screen_share_audio": false,
                "subscribe": true,
                "moderate": false,
                "hidden": false
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {}
}
