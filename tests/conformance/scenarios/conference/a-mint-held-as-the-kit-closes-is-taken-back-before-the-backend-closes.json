{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-mint-held-as-the-kit-closes-is-taken-back-before-the-backend-closes",
  "title": "A mint held in the backend as the kit closes is cancelled before the backend is closed, and hands out no credential",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-144"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The kit's close succeeds: the backend it closes is no longer used by the mint it took back.",
  "setup": {
    "rooms": [
      {
        "id": "r1",
        "participants": [
          {
            "id": "alice",
            "channel_id": "conf",
            "display_name": "Alice"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.fault",
      "channel_id": "conf",
      "method": "mint_access",
      "gate": "minting"
    },
    {
      "call": "conference.mint",
      "channel_id": "conf",
      "room_id": "r1",
      "participant_id": "alice",
      "background": true,
      "as": "mint"
    },
    {
      "wait_for": "minting"
    },
    {
      "call": "close"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "mint_access",
        "close"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "mint_access",
              "participant_id": "alice",
              "cancelled": true
            },
            {
              "call": "close"
            }
          ]
        }
      }
    },
    {
      "await": "mint",
      "expect": {
        "error": "room_not_attached"
      }
    }
  ]
}
