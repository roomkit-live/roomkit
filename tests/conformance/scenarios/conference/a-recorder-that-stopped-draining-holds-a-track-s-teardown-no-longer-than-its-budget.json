{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-recorder-that-stopped-draining-holds-a-track-s-teardown-no-longer-than-its-budget",
  "title": "A track whose recorder stopped draining is torn down once the flush budget passed, and the frames it could not write are counted as lost",
  "rules": [
    "§12.10.8"
  ],
  "requirements": [
    "RK-12.10.8-028",
    "RK-12.10.8-029"
  ],
  "notes": "The recorder holds its first write at a gate, so it stops draining: two frames are still queued when the track is unpublished. The advance passes every wait the teardown makes on the clock (the queued frames', the write in flight's, and the finalization's, which the scenario does not read), assuming they add up to a minute at most; the unpublish returns with the write still held, and the recording is finalized without the two frames, counted in dropped. What the held write leaves in the recording once released is not read.",
  "requires_features": [
    "conference"
  ],
  "setup": {
    "virtual_clock": true,
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "stt": null,
      "recording": {
        "write_gates": {
          "mic": "writing"
        }
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        "AQA="
      ]
    },
    {
      "wait_for": "writing"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        "AgA=",
        "AwA="
      ]
    },
    {
      "call": "conference.unpublish",
      "channel_id": "conf",
      "track_id": "mic",
      "background": true,
      "as": "ending"
    },
    {
      "call": "clock.advance",
      "ms": 60000,
      "waiters": 1
    },
    {
      "await": "ending"
    },
    {
      "open": "writing"
    },
    {
      "idle": true
    },
    {
      "call": "recording.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "recordings": [
            {
              "tracks": [
                {
                  "track_id": "mic"
                }
              ],
              "stopped": true
            }
          ],
          "dropped": 2
        }
      }
    }
  ],
  "expect": {}
}
