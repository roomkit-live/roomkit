{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-close-reports-the-backend-a-mint-still-holds-and-closes-it-once-the-mint-ends",
  "title": "A close past whose budget a mint still runs in the backend, its cancellation ignored, fails and leaves the backend open; the backend is closed once the mint ends",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-021",
    "RK-12.10.4-025",
    "RK-12.10.4-026"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "No bot ever joins, so no session keeps the close from succeeding: it fails because the backend, still in use by the mint, is retained. What the failure says of it is the implementation's text.",
  "setup": {
    "rooms": [
      {
        "id": "r1",
        "participants": [
          {
            "id": "alice",
            "channel_id": "conf",
            "display_name": "Alice"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.fault",
      "channel_id": "conf",
      "method": "mint_access",
      "gate": "minting",
      "ignores_cancel": true
    },
    {
      "call": "conference.mint",
      "channel_id": "conf",
      "room_id": "r1",
      "participant_id": "alice",
      "background": true,
      "as": "mint"
    },
    {
      "wait_for": "minting"
    },
    {
      "call": "conference.close",
      "channel_id": "conf",
      "expect": {
        "error": "conference_close_failed"
      }
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "mint_access",
        "close"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "mint_access",
              "participant_id": "alice",
              "cancelled": true
            }
          ],
          "bots": []
        }
      }
    },
    {
      "open": "minting"
    },
    {
      "await": "mint",
      "expect": {
        "error": "room_not_attached"
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "mint_access",
        "close"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "mint_access",
              "participant_id": "alice"
            },
            {
              "call": "close"
            }
          ]
        }
      }
    },
    {
      "call": "close",
      "expect": {
        "error": "channel_close_failed"
      }
    }
  ]
}
