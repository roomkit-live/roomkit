{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-recognizer-plugged-mid-meeting-subscribes-what-is-already-published",
  "title": "A recognizer plugged mid-meeting subscribes the audio tracks already published, and their lanes open",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-186"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "Partial: the transcription of the frames that follow is not observed.",
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "stt": null,
      "tts": {}
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "subscribe_track"
      ],
      "expect": {
        "result": {
          "calls": []
        }
      }
    },
    {
      "call": "conference.plug",
      "channel_id": "conf",
      "kind": "stt"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "subscribe_track"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "subscribe_track",
              "track_id": "mic"
            }
          ],
          "info": {
            "rooms": {
              "r1": {
                "active_lanes": 1
              }
            }
          }
        }
      }
    }
  ]
}
