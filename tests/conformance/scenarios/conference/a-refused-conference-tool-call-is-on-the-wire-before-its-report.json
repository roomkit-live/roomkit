{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-refused-conference-tool-call-is-on-the-wire-before-its-report",
  "title": "A tool call the conference refuses is sent back to the model before ON_TOOL_CALL reports the refusal",
  "rules": [
    "§12.10.12",
    "§12.4"
  ],
  "requirements": [
    "RK-12.10.12-055"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async",
        "reactions": [
          {
            "gate": "reported"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {
        "lookup": "found"
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "c1",
      "name": "unknown_tool",
      "background": true,
      "as": "call"
    },
    {
      "wait_for": "reported"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "model": {
            "results": [
              {
                "call_id": "c1",
                "result": {
                  "$present": true
                }
              }
            ]
          }
        }
      }
    },
    {
      "open": "reported"
    },
    {
      "await": "call"
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "name": "unknown_tool"
          }
        }
      ]
    }
  }
}
