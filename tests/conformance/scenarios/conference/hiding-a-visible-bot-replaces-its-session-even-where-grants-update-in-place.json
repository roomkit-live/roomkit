{
  "$schema": "../../scenario.schema.json",
  "id": "conference/hiding-a-visible-bot-replaces-its-session-even-where-grants-update-in-place",
  "title": "Concealing a visible bot replaces its session, a leave and a new join, even on a backend that updates grants in place",
  "rules": [
    "§12.10.3",
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.3-049",
    "RK-12.10.4-210"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "capabilities": [
        "bot_grant_update"
      ]
    },
    {
      "call": "conference.ensure_bot",
      "channel_id": "conf",
      "room_id": "r1",
      "expect": {
        "result": {
          "id": {
            "$as": "first"
          }
        }
      }
    },
    {
      "call": "conference.set_bot_grants",
      "channel_id": "conf",
      "grants": {
        "hidden": true
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot",
        "leave",
        "update_bot_grants"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "session": {
                "$as": "first"
              },
              "grants": {
                "hidden": false
              }
            },
            {
              "call": "leave",
              "session": {
                "$as": "first"
              }
            },
            {
              "call": "join_as_bot",
              "grants": {
                "hidden": true
              }
            }
          ]
        }
      }
    }
  ]
}
