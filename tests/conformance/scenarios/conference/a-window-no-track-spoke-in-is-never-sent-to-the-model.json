{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-window-no-track-spoke-in-is-never-sent-to-the-model",
  "title": "A mixing window to which no track contributed is not sent to the model",
  "rules": [
    "§12.10.12",
    "§12.7.5"
  ],
  "requirements": [
    "RK-12.10.12-015"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "Alice's track is silent for 200 ms between her two frames: the mix's own clock passes ten windows that no track spoke in, and none of them reaches the model.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {},
      "vad": [],
      "realtime": {
        "input_sample_rate": 16000
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic-a",
      "kind": "audio"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf",
      "mix": true
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        ""
      ],
      "pause_ms": 200
    },
    {
      "call": "conference.settle",
      "channel_id": "conf",
      "mix": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "model": {
            "heard": {
              "data": "",
              "samples": 640
            }
          }
        }
      }
    }
  ],
  "expect": {}
}
