{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-backend-that-cannot-tell-provenance-yields-no-address",
  "title": "A backend that cannot tell asserted attributes from client-supplied ones asserts nothing, so its participant stays unknown",
  "rules": [
    "§12.10.2"
  ],
  "requirements": [
    "RK-12.10.2-039"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "sender_id": "+15550101"
            },
            "result": {
              "status": "identified",
              "identity": {
                "id": "user-42",
                "display_name": "Alice"
              }
            },
            "repeat": true
          }
        ]
      }
    },
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "address_keys": [
        "caller_number"
      ]
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "dial-in-1",
      "metadata": {
        "caller_number": "+15550101"
      },
      "asserts_provenance": false
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "resolver": [],
    "participants": {
      "r1": [
        {
          "id": "dial-in-1",
          "identification": "unknown",
          "identity_id": null,
          "external_id": "dial-in-1"
        }
      ]
    }
  }
}
