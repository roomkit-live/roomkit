{
  "$schema": "../../scenario.schema.json",
  "id": "conference/grants-cover-the-needs-as-a-voice-is-plugged",
  "title": "The bot's session holds the grants its configured needs call for, at the join and once a voice is plugged beside the recognizer",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-193"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The session holding the wider grants may be the same one or a new one: the backend cannot update grants in place, and the RFC leaves to §12.10.3's SHOULD whether the first join already held publish_audio.",
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.ensure_bot",
      "channel_id": "conf",
      "room_id": "r1",
      "expect": {
        "result": {
          "id": {
            "$as": "first"
          },
          "room_id": "r1"
        }
      }
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "bots": [
            {
              "grants": {
                "subscribe": true
              }
            }
          ]
        }
      }
    },
    {
      "call": "conference.plug",
      "channel_id": "conf",
      "kind": "tts"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "bots": [
            {
              "grants": {
                "subscribe": true,
                "publish_audio": true
              }
            }
          ]
        }
      }
    }
  ]
}
