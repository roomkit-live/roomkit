{
  "$schema": "../../scenario.schema.json",
  "id": "conference/any-participant-s-speech-cuts-the-bot-off",
  "title": "With scope any, a participant's speech during the bot's utterance stops its playback on the bot's session and fires ON_BARGE_IN naming that participant",
  "rules": [
    "§12.10.4",
    "§12.10.5"
  ],
  "requirements": [
    "RK-12.10.4-221",
    "RK-12.10.5-010"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The bot is cut while its utterance's first chunk is still being synthesized: its turn has begun, nothing of it is published yet. Holding the bot after a published chunk needs conference.fault (P6-CF4). RK-12.10.4-221 partial: the closing chunk the channel also owes the backend is not observed, nothing having been published.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tts": {
        "gates": [
          "held"
        ]
      },
      "vad": [
        {
          "type": "speech_start"
        }
      ],
      "interruption": {
        "scope": "any"
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic-a",
      "kind": "audio"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "bob",
      "track_id": "mic-b",
      "kind": "audio"
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Hello there"
      },
      "background": true,
      "as": "said"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-b",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "cut"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot",
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "session": {
                "$as": "bot"
              }
            },
            {
              "call": "stop_playback",
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    },
    {
      "open": "cut"
    },
    {
      "open": "held"
    },
    {
      "await": "said"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "conference": {
            "room_id": "r1",
            "track_id": "mic-b",
            "participant_id": "bob"
          }
        }
      ]
    }
  }
}
