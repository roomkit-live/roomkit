{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-muted-binding-still-relays-the-sfu-s-signals",
  "title": "With the conference's binding muted, the SFU's speaker, quality, track mute and unmute signals still reach their hooks",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-123"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "speaker",
        "trigger": "on_active_speaker_changed",
        "execution": "async"
      },
      {
        "name": "quality",
        "trigger": "on_connection_quality_changed",
        "execution": "async"
      },
      {
        "name": "track_muted",
        "trigger": "on_conference_track_muted",
        "execution": "async"
      },
      {
        "name": "track_unmuted",
        "trigger": "on_conference_track_unmuted",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "call": "mute",
      "room_id": "r1",
      "channel_id": "conf",
      "expect": {
        "result": {
          "muted": true
        }
      }
    },
    {
      "call": "conference.active_speaker",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.connection_quality",
      "channel_id": "conf",
      "participant_id": "alice",
      "quality": "poor"
    },
    {
      "call": "conference.mute",
      "channel_id": "conf",
      "track_id": "mic"
    },
    {
      "call": "conference.unmute",
      "channel_id": "conf",
      "track_id": "mic"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "speaker": [
        {
          "room_id": "r1",
          "event": {
            "content": {
              "data": {
                "channel_id": "conf",
                "participant_id": "alice"
              }
            }
          }
        }
      ],
      "quality": [
        {
          "room_id": "r1",
          "event": {
            "content": {
              "data": {
                "channel_id": "conf",
                "participant_id": "alice",
                "quality": "poor"
              }
            }
          }
        }
      ],
      "track_muted": [
        {
          "room_id": "r1",
          "event": {
            "content": {
              "data": {
                "channel_id": "conf",
                "participant_id": "alice",
                "track_id": "mic",
                "kind": "audio"
              }
            }
          }
        }
      ],
      "track_unmuted": [
        {
          "room_id": "r1",
          "event": {
            "content": {
              "data": {
                "channel_id": "conf",
                "participant_id": "alice",
                "track_id": "mic",
                "kind": "audio"
              }
            }
          }
        }
      ]
    }
  }
}
