{
  "$schema": "../../scenario.schema.json",
  "id": "conference/unplugging-recording-finalizes-and-announces-each-recording",
  "title": "Unplugging the recording finalizes each track's recording and announces its end, as a detach does",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-188"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "stopped",
        "trigger": "on_recording_stopped",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "stt": null,
      "recording": {}
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "conference.unplug",
      "channel_id": "conf",
      "kind": "recording"
    },
    {
      "idle": true
    },
    {
      "call": "recording.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "recordings": [
            {
              "tracks": [
                {
                  "track_id": "mic"
                }
              ],
              "stopped": true
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "stopped": [
        {
          "conference": {
            "track_id": "mic",
            "participant_id": "alice",
            "recording_id": "rec1",
            "url": "mock://rec1"
          }
        }
      ]
    }
  }
}
