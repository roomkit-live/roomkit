{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-delegation-issued-while-the-model-connects-is-answered-once-connected",
  "title": "A delegation the model issues while its session is still connecting is answered once the session is the room's",
  "rules": [
    "§12.10.12",
    "§12.4.1"
  ],
  "requirements": [
    "RK-12.10.12-032"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "Alice's first frame makes the mix connect the model, whose connect holds; the delegation it issues then is answered only after the connect returns.",
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "delegated",
        "trigger": "on_realtime_delegation",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {},
      "vad": [],
      "realtime": {
        "full_duplex": true,
        "connects": [
          {
            "gate": "connecting"
          }
        ]
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic-a",
      "kind": "audio"
    },
    {
      "idle": true
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "connecting"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "conf",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "model": {
            "delegation_outputs": []
          }
        }
      }
    },
    {
      "open": "connecting"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "model": {
            "delegation_outputs": [
              {
                "delegation_id": "d1",
                "text": {
                  "$present": true
                },
                "spoken": true
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "delegated": [
        {
          "room_id": "r1",
          "delegation": {
            "delegation_id": "d1",
            "target": "integrator"
          }
        }
      ]
    }
  }
}
