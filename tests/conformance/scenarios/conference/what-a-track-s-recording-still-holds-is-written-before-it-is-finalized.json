{
  "$schema": "../../scenario.schema.json",
  "id": "conference/what-a-track-s-recording-still-holds-is-written-before-it-is-finalized",
  "title": "Frames still queued when a track is unpublished are written to its recording before the recording is finalized",
  "rules": [
    "§12.10.8"
  ],
  "requirements": [
    "RK-12.10.8-027"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "stt": null,
      "recording": {
        "write_gates": {
          "mic": "writing"
        }
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        "AQA="
      ]
    },
    {
      "wait_for": "writing"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        "AgA=",
        "AwA="
      ]
    },
    {
      "call": "conference.unpublish",
      "channel_id": "conf",
      "track_id": "mic",
      "background": true,
      "as": "ending"
    },
    {
      "open": "writing"
    },
    {
      "await": "ending"
    },
    {
      "idle": true
    },
    {
      "call": "recording.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "recordings": [
            {
              "tracks": [
                {
                  "track_id": "mic"
                }
              ],
              "chunks": [
                "AQA=",
                "AgA=",
                "AwA="
              ],
              "stopped": true
            }
          ],
          "dropped": 0
        }
      }
    }
  ],
  "expect": {}
}
