{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-barge-in-drops-the-model-response-waiting-for-its-turn",
  "title": "A barge-in that lands drops, unpublished, the utterance still waiting for its turn",
  "rules": [
    "§12.10.5",
    "§12.10.12"
  ],
  "requirements": [
    "RK-12.10.5-009"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "The first response's first chunk holds in the backend; the second response waits for its turn behind it when Bob cuts the bot off: the first utterance closes, and the second never reaches the track.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "barge",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {},
      "vad": [
        {
          "type": "speech_start"
        }
      ]
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "bob",
      "track_id": "mic-b",
      "kind": "audio"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.fault",
      "channel_id": "conf",
      "method": "publish_audio",
      "gate": "published"
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "start"
    },
    {
      "call": "realtime.audio",
      "channel_id": "conf",
      "source": "provider",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "published"
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "end"
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "start"
    },
    {
      "call": "realtime.audio",
      "channel_id": "conf",
      "source": "provider",
      "frames": [
        ""
      ]
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "end"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-b",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "cut"
    },
    {
      "open": "cut"
    },
    {
      "open": "published"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "publish_audio"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "publish_audio",
              "is_final": false
            },
            {
              "call": "publish_audio",
              "is_final": true
            }
          ],
          "utterances": [
            {
              "complete": true
            }
          ]
        }
      }
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "stop_playback"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "barge": [
        {
          "conference": {
            "track_id": "mic-b",
            "participant_id": "bob"
          }
        }
      ]
    }
  }
}
