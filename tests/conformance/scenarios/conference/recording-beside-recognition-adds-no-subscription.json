{
  "$schema": "../../scenario.schema.json",
  "id": "conference/recording-beside-recognition-adds-no-subscription",
  "title": "A track transcribed and recorded is subscribed once",
  "rules": [
    "§12.10.8"
  ],
  "requirements": [
    "RK-12.10.8-008"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "recording": {}
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "subscribe_track"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "subscribe_track",
              "track_id": "mic"
            }
          ],
          "info": {
            "stt_configured": true,
            "recording_configured": true
          }
        }
      }
    },
    {
      "call": "recording.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "recordings": [
            {
              "tracks": [
                {
                  "track_id": "mic"
                }
              ],
              "chunks": [
                ""
              ]
            }
          ]
        }
      }
    }
  ]
}
