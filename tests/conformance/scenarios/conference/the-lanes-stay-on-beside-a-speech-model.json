{
  "$schema": "../../scenario.schema.json",
  "id": "conference/the-lanes-stay-on-beside-a-speech-model",
  "title": "A conference composing a speech-to-speech model still runs each track's VAD, speech edges, recognition and recording",
  "rules": [
    "§12.10.12"
  ],
  "requirements": [
    "RK-12.10.12-051"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "start",
        "trigger": "on_speech_start",
        "execution": "async"
      },
      {
        "name": "end",
        "trigger": "on_speech_end",
        "execution": "async"
      },
      {
        "name": "heard",
        "trigger": "on_transcription",
        "execution": "async"
      },
      {
        "name": "recorded",
        "trigger": "on_recording_started",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {},
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "Still transcribed"
              }
            ]
          }
        ]
      },
      "recording": {}
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "info": {
            "rooms": {
              "r1": {
                "realtime_active": true
              }
            }
          }
        }
      }
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        "",
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "recording.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "recordings": [
            {
              "tracks": [
                {
                  "track_id": "mic",
                  "participant_id": "alice"
                }
              ],
              "chunks": [
                "",
                ""
              ]
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "start": [
        {
          "conference": {
            "track_id": "mic",
            "participant_id": "alice"
          }
        }
      ],
      "end": [
        {
          "conference": {
            "track_id": "mic",
            "participant_id": "alice"
          }
        }
      ],
      "heard": [
        {
          "conference": {
            "track_id": "mic",
            "participant_id": "alice",
            "text": "Still transcribed"
          }
        }
      ],
      "recorded": [
        {
          "conference": {
            "track_id": "mic",
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
