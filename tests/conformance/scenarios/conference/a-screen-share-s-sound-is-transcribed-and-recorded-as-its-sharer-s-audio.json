{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-screen-share-s-sound-is-transcribed-and-recorded-as-its-sharer-s-audio",
  "title": "The sound of a screen share, published as a track of kind audio, is transcribed and recorded like any audio track and attributed to the participant sharing",
  "rules": [
    "§12.10.2"
  ],
  "requirements": [
    "RK-12.10.2-024"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "This is the demo video"
              }
            ]
          }
        ]
      },
      "recording": {}
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "screen",
      "kind": "screen_share"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "screen-sound",
      "kind": "audio"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "screen-sound",
      "frames": [
        "AQA=",
        "AgA="
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "recording.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "recordings": [
            {
              "tracks": [
                {
                  "track_id": "screen-sound",
                  "kind": "audio",
                  "participant_id": "alice"
                }
              ],
              "chunks": [
                "AQA=",
                "AgA="
              ]
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "This is the demo video"
          },
          "source": {
            "channel_id": "conf",
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
