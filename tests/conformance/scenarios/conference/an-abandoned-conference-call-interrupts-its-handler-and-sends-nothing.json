{
  "$schema": "../../scenario.schema.json",
  "id": "conference/an-abandoned-conference-call-interrupts-its-handler-and-sends-nothing",
  "title": "A conference tool call the model abandons interrupts its running handler, sends the model no result, and is reported once, as cancelled",
  "rules": [
    "§12.10.12"
  ],
  "requirements": [
    "RK-12.10.12-057"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "The call c1 is still waiting for its result when its step is cancelled, after a later call c2 was served: the model never received a result for c1.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {
        "lookup": {
          "gate": "held",
          "result": "late"
        },
        "probe": "ok"
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "c1",
      "name": "lookup",
      "background": true,
      "as": "call"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "conference.cancel",
      "channel_id": "conf",
      "call_ids": [
        "c1"
      ]
    },
    {
      "open": "held"
    },
    {
      "call": "conference.tool_call",
      "channel_id": "conf",
      "call_id": "c2",
      "name": "probe",
      "expect": {
        "result": "ok"
      }
    },
    {
      "cancel": "call"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "handlers": [
            {
              "name": "lookup",
              "outcome": "interrupted"
            },
            {
              "name": "probe",
              "outcome": "returned"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "c1",
            "name": "lookup",
            "cancelled": true
          }
        },
        {
          "tool_call": {
            "tool_call_id": "c2",
            "name": "probe",
            "result": "ok",
            "cancelled": false
          }
        }
      ]
    }
  }
}
