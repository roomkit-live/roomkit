{
  "$schema": "../../scenario.schema.json",
  "id": "conference/the-meeting-is-transcribed-beside-the-speech-model",
  "title": "With a recognizer beside the speech-to-speech model, each participant's utterance is transcribed on their own track and attributed to them",
  "rules": [
    "§12.10.12",
    "§12.10.6"
  ],
  "requirements": [
    "RK-12.10.12-023",
    "RK-12.10.6-005"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "RK-12.10.12-023 partial: what the speech-to-speech model was fed from the same lanes is not read here.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {},
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "stt": {
        "streams": [
          {
            "results": [
              {
                "text": "Hello from Alice"
              }
            ]
          },
          {
            "results": [
              {
                "text": "Hello from Bob"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic-a",
      "kind": "audio"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "bob",
      "track_id": "mic-b",
      "kind": "audio"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "info": {
            "rooms": {
              "r1": {
                "realtime_active": true
              }
            }
          }
        }
      }
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        "",
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-b",
      "frames": [
        "",
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "info": {
            "realtime_configured": true,
            "stt_configured": true,
            "rooms": {
              "r1": {
                "realtime_active": true
              }
            }
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "Connect the model."
          },
          "source": {
            "channel_id": "ws"
          }
        },
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "Hello from Alice"
          },
          "source": {
            "channel_id": "conf",
            "participant_id": "alice"
          }
        },
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "Hello from Bob"
          },
          "source": {
            "channel_id": "conf",
            "participant_id": "bob"
          }
        }
      ]
    }
  }
}
