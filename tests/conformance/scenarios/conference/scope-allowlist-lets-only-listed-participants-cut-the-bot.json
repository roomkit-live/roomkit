{
  "$schema": "../../scenario.schema.json",
  "id": "conference/scope-allowlist-lets-only-listed-participants-cut-the-bot",
  "title": "With scope allowlist, a listed participant's speech cuts the bot off and another's does not",
  "rules": [
    "§12.10.5"
  ],
  "requirements": [
    "RK-12.10.5-005"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The bot is cut while its utterance's first chunk is still being synthesized: its turn has begun, nothing of it is published yet. Holding the bot after a published chunk needs conference.fault (P6-CF4).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tts": {
        "gates": [
          "held"
        ]
      },
      "vad": [
        {
          "type": "speech_start"
        },
        {
          "type": "speech_end"
        }
      ],
      "interruption": {
        "scope": "allowlist",
        "allowlist": [
          "alice"
        ]
      },
      "stt": {
        "streams": [
          {
            "gate": "heard-b",
            "results": [
              {
                "text": "Words 1"
              }
            ]
          }
        ]
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic-a",
      "kind": "audio"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "bob",
      "track_id": "mic-b",
      "kind": "audio"
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Hello there"
      },
      "background": true,
      "as": "said"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-b",
      "frames": [
        "",
        ""
      ]
    },
    {
      "wait_for": "heard-b"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": []
        }
      }
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        ""
      ]
    },
    {
      "wait_for": "cut"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "stop_playback"
            }
          ]
        }
      }
    },
    {
      "open": "cut"
    },
    {
      "open": "heard-b"
    },
    {
      "open": "held"
    },
    {
      "await": "said"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "conference": {
            "participant_id": "alice",
            "track_id": "mic-a"
          }
        }
      ]
    }
  }
}
