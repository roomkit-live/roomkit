{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-mint-on-a-backend-that-reports-no-arrival-brings-the-bot-in",
  "title": "An attach over an empty conference joins nothing; a mint, with no arrival reported, then brings the bot in and its arrival is announced",
  "rules": [
    "§12.10.3",
    "§12.10.4",
    "§12.10.7"
  ],
  "requirements": [
    "RK-12.10.3-020",
    "RK-12.10.4-082",
    "RK-12.10.4-084",
    "RK-12.10.4-085",
    "RK-12.10.7-008"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1",
        "participants": [
          {
            "id": "alice",
            "channel_id": "conf",
            "display_name": "Alice"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": []
        }
      }
    },
    {
      "call": "conference.mint",
      "channel_id": "conf",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "list_participants",
        "mint_access",
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "list_participants",
              "room_id": "r1"
            },
            {
              "call": "mint_access",
              "participant_id": "alice"
            },
            {
              "call": "join_as_bot",
              "room_id": "r1",
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "media_events": {
      "r1": [
        {
          "event": "conference_started",
          "room_id": "r1",
          "channel_id": "conf",
          "bot_session_id": {
            "$as": "bot"
          }
        }
      ]
    }
  }
}
