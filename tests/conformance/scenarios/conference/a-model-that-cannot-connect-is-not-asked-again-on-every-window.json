{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-model-that-cannot-connect-is-not-asked-again-on-every-window",
  "title": "A failed connect is not retried on each following mixing window",
  "rules": [
    "§12.10.12"
  ],
  "requirements": [
    "RK-12.10.12-048"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "notes": "Partial: the retry once the cooldown is over is not read; its length is the implementation's, and no setting shortens it.",
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {},
      "vad": [],
      "realtime": {
        "input_sample_rate": 16000,
        "connects": [
          {
            "fail": "the model is unreachable",
            "error_type": "ModelUnreachable"
          }
        ]
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic-a",
      "kind": "audio"
    },
    {
      "idle": true
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        "",
        "",
        "",
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf",
      "mix": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "model": {
            "connects": [
              {
                "room_id": "r1"
              }
            ],
            "audio": []
          }
        }
      }
    }
  ],
  "expect": {}
}
