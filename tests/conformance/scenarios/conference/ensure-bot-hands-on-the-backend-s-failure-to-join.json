{
  "$schema": "../../scenario.schema.json",
  "id": "conference/ensure-bot-hands-on-the-backend-s-failure-to-join",
  "title": "ensure_bot() fails with the backend's own error when join_as_bot() fails",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-098"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.fault",
      "channel_id": "conf",
      "method": "join_as_bot",
      "fail": "the SFU refuses the bot"
    },
    {
      "call": "conference.ensure_bot",
      "channel_id": "conf",
      "room_id": "r1",
      "expect": {
        "error": "backend_failed"
      }
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "bots": []
        }
      }
    }
  ]
}
