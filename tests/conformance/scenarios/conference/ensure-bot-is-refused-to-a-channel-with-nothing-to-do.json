{
  "$schema": "../../scenario.schema.json",
  "id": "conference/ensure-bot-is-refused-to-a-channel-with-nothing-to-do",
  "title": "ensure_bot on a channel configured with nothing to consume or say is refused rather than joined",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-099"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "stt": null
    },
    {
      "call": "conference.ensure_bot",
      "channel_id": "conf",
      "room_id": "r1",
      "expect": {
        "error": {
          "name": "capability_missing"
        }
      }
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": []
        }
      }
    }
  ]
}
