{
  "$schema": "../../scenario.schema.json",
  "id": "conference/confirmed-waits-for-one-track-s-sustained-speech",
  "title": "With CONFIRMED, speech split across two tracks does not reach min_speech_ms, and one track's 300 ms of sustained speech does",
  "rules": [
    "§12.10.5"
  ],
  "requirements": [
    "RK-12.10.5-007"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "Each frame carries 20 ms of 16 kHz mono PCM16: each track's first utterance is 220 ms, 440 ms in all; alice's second reaches 300 ms on its fifteenth frame. The first utterances are recognized as no words, so that no transcription is routed while the bot's answer is held. Partial: CONFIRMED is observed with scope any; DISABLED, and a scope composed with a strategy, are not. The bot is cut while its utterance's first chunk is still being synthesized: its turn has begun, nothing of it is published yet. Holding the bot after a published chunk needs conference.fault (P6-CF4).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cut"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tts": {
        "gates": [
          "held"
        ]
      },
      "vad": [
        {
          "type": "speech_start"
        },
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        null,
        {
          "type": "speech_end"
        },
        {
          "type": "speech_start"
        }
      ],
      "interruption": {
        "strategy": "confirmed"
      },
      "stt": {
        "streams": [
          {
            "gate": "heard-a",
            "results": [
              {
                "text": ""
              }
            ]
          },
          {
            "gate": "heard-b",
            "results": [
              {
                "text": ""
              }
            ]
          }
        ]
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic-a",
      "kind": "audio"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "bob",
      "track_id": "mic-b",
      "kind": "audio"
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Hello there"
      },
      "background": true,
      "as": "said"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        ""
      ],
      "repeat": 11
    },
    {
      "wait_for": "heard-a"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-b",
      "frames": [
        ""
      ],
      "repeat": 11
    },
    {
      "wait_for": "heard-b"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": []
        }
      }
    },
    {
      "open": "heard-a"
    },
    {
      "open": "heard-b"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-a",
      "frames": [
        ""
      ],
      "repeat": 15
    },
    {
      "wait_for": "cut"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "stop_playback"
            }
          ]
        }
      }
    },
    {
      "open": "cut"
    },
    {
      "open": "held"
    },
    {
      "await": "said"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "conference": {
            "participant_id": "alice",
            "track_id": "mic-a"
          }
        }
      ]
    }
  }
}
