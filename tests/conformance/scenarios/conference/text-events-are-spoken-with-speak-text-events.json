{
  "$schema": "../../scenario.schema.json",
  "id": "conference/text-events-are-spoken-with-speak-text-events",
  "title": "With speak_text_events set, a text another transport sourced is spoken into the conference",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-224"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tts": {},
      "speak_text_events": true
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Read me aloud"
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "synthesized": [
            "Read me aloud"
          ]
        }
      }
    }
  ]
}
