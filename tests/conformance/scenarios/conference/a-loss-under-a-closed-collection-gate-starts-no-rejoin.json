{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-loss-under-a-closed-collection-gate-starts-no-rejoin",
  "title": "A bot lost while the binding is muted is not joined again",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-171"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "idle": true
    },
    {
      "call": "mute",
      "room_id": "r1",
      "channel_id": "conf"
    },
    {
      "call": "conference.bot_lost",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "room_id": "r1",
              "session": {
                "$as": "first"
              }
            }
          ]
        }
      }
    }
  ]
}
