{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-channel-with-nothing-to-do-probes-no-occupancy",
  "title": "A channel with nothing to consume or say does not probe an occupied conference's occupancy at the attach",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-101"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "stt": null,
      "occupants": [
        "alice"
      ]
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "list_participants",
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": []
        }
      }
    }
  ]
}
