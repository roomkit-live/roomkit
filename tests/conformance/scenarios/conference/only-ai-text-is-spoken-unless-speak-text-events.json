{
  "$schema": "../../scenario.schema.json",
  "id": "conference/only-ai-text-is-spoken-unless-speak-text-events",
  "title": "With speak_text_events left at its default, a text another transport sourced is not spoken, and an AI channel's answer is",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-224",
    "RK-12.10.4-225"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Hi from the agent"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tts": {},
      "speak_text_events": null
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Read me aloud"
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "synthesized": [
            "Hi from the agent"
          ]
        }
      }
    }
  ]
}
