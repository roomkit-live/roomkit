{
  "$schema": "../../scenario.schema.json",
  "id": "conference/the-bot-s-own-track-is-recorded-apart",
  "title": "The bot's published audio is recorded as its own attributed track, apart from the participants'",
  "rules": [
    "§12.10.8"
  ],
  "requirements": [
    "RK-12.10.8-016"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "stt": null,
      "tts": {},
      "recording": {},
      "bot_identity": "assistant"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Hello"
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "recording.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "recordings": [
            {
              "tracks": [
                {
                  "track_id": "mic",
                  "participant_id": "alice"
                }
              ],
              "chunks": [
                ""
              ]
            },
            {
              "tracks": [
                {
                  "participant_id": "assistant"
                }
              ],
              "chunks": {
                "$present": true
              }
            }
          ]
        }
      }
    }
  ]
}
