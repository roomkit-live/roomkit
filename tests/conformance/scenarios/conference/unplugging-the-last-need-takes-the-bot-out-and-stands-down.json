{
  "$schema": "../../scenario.schema.json",
  "id": "conference/unplugging-the-last-need-takes-the-bot-out-and-stands-down",
  "title": "Unplugging the last need makes the bot leave with conference_ended announced, and the channel then joins for no arrival or mint while it keeps the roster",
  "rules": [
    "§12.10.4",
    "§12.10.7"
  ],
  "requirements": [
    "RK-12.10.4-191",
    "RK-12.10.4-192",
    "RK-12.10.7-009"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "idle": true
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "room_id": "r1",
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    },
    {
      "call": "conference.unplug",
      "channel_id": "conf",
      "kind": "stt"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot",
        "leave"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "session": {
                "$as": "bot"
              }
            },
            {
              "call": "leave",
              "session": {
                "$as": "bot"
              }
            }
          ],
          "bots": []
        }
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "conference.mint",
      "channel_id": "conf",
      "room_id": "r1",
      "participant_id": "bob"
    },
    {
      "call": "detach_channel",
      "room_id": "r1",
      "channel_id": "conf"
    },
    {
      "call": "attach_channel",
      "room_id": "r1",
      "channel_id": "conf"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "list_participants",
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "list_participants"
            },
            {
              "call": "join_as_bot",
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    },
    {
      "call": "list_members",
      "room_id": "r1",
      "expect": {
        "result": {
          "$unordered": [
            {
              "id": "alice"
            },
            {
              "id": "bob"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "media_events": {
      "r1": [
        {
          "$unordered": [
            {
              "event": "conference_participant_joined",
              "participant_id": "alice"
            },
            {
              "event": "conference_started",
              "bot_session_id": {
                "$as": "bot"
              }
            }
          ]
        },
        {
          "event": "conference_ended",
          "bot_session_id": {
            "$as": "bot"
          }
        },
        {
          "event": "conference_participant_joined",
          "participant_id": "bob"
        }
      ]
    }
  }
}
