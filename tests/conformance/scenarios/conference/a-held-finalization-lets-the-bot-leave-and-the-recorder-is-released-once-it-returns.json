{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-held-finalization-lets-the-bot-leave-and-the-recorder-is-released-once-it-returns",
  "title": "A track's finalization held in the recorder is given up on past its budget: the detach ends and the bot leaves while the call still runs, and the recorder is released once the call returns",
  "rules": [
    "§12.11",
    "§12.10.4",
    "§12.10.8"
  ],
  "requirements": [
    "RK-12.11-054"
  ],
  "notes": "The recorder's on_recording_stop holds at its gate on the recorder's thread; its on_track_removed is not held. The detach waits for the finalization within the implementation's budget, then goes on: the bot leaves while the call still runs. The channel's close, once the call returned, releases the recorder. A room recording's finalization (kit.stop_room_recording) is not shown here. That close() waits for the held call is shown by conference/a-recorder-a-call-still-runs-in-past-the-release-wait-is-left-unreleased; how the detach reports the recording it gave up on is not observed (RK-12.11-055 is shown by a close).",
  "requires_features": [
    "conference",
    "recording"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "stt": null,
      "recording": {
        "call_gates": {
          "on_recording_stop": "stopping"
        }
      }
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic",
      "frames": [
        "AQA="
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "room_id": "r1",
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    },
    {
      "call": "detach_channel",
      "room_id": "r1",
      "channel_id": "conf"
    },
    {
      "wait_for": "stopping"
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "leave"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "leave",
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    },
    {
      "call": "recording.calls",
      "channel_id": "conf",
      "calls": [
        "on_recording_stop",
        "close"
      ],
      "expect": {
        "result": [
          {
            "call": "on_recording_stop",
            "recording_id": "rec1"
          }
        ]
      }
    },
    {
      "open": "stopping"
    },
    {
      "idle": true
    },
    {
      "call": "conference.close",
      "channel_id": "conf",
      "expect": {
        "result": null
      }
    },
    {
      "call": "recording.calls",
      "channel_id": "conf",
      "calls": [
        "on_recording_stop",
        "close"
      ],
      "expect": {
        "result": [
          {
            "call": "on_recording_stop",
            "recording_id": "rec1"
          },
          {
            "call": "close"
          }
        ]
      }
    }
  ],
  "expect": {}
}
