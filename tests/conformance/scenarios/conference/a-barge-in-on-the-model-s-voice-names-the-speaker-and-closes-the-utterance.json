{
  "$schema": "../../scenario.schema.json",
  "id": "conference/a-barge-in-on-the-model-s-voice-names-the-speaker-and-closes-the-utterance",
  "title": "A lane's barge-in on the model's voice names its participant, closes the utterance with is_final after its last chunk, stops the playback, drops what the model still sends and asks the model to cancel",
  "rules": [
    "§12.10.12",
    "§12.10.5",
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.12-033",
    "RK-12.10.12-037",
    "RK-12.10.12-039",
    "RK-12.10.12-040",
    "RK-12.10.4-217"
  ],
  "requires_features": [
    "conference",
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "barge",
        "trigger": "on_barge_in",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "tools": {},
      "vad": [
        {
          "type": "speech_start"
        }
      ]
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "bob"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "bob",
      "track_id": "mic-b",
      "kind": "audio"
    },
    {
      "call": "send_event",
      "room_id": "r1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "Connect the model."
      }
    },
    {
      "idle": true
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "start"
    },
    {
      "call": "realtime.audio",
      "channel_id": "conf",
      "source": "provider",
      "frames": [
        ""
      ]
    },
    {
      "idle": true
    },
    {
      "call": "conference.feed",
      "channel_id": "conf",
      "track_id": "mic-b",
      "frames": [
        ""
      ]
    },
    {
      "call": "conference.settle",
      "channel_id": "conf"
    },
    {
      "call": "realtime.audio",
      "channel_id": "conf",
      "source": "provider",
      "frames": [
        ""
      ]
    },
    {
      "call": "realtime.response",
      "channel_id": "conf",
      "edge": "end"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "publish_audio"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "publish_audio",
              "is_final": false
            },
            {
              "call": "publish_audio",
              "is_final": true
            }
          ],
          "utterances": [
            {
              "complete": true
            }
          ]
        }
      }
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "stop_playback"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "stop_playback"
            }
          ],
          "model": {
            "calls": [
              {
                "call": "interrupt"
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "barge": [
        {
          "room_id": "r1",
          "conference": {
            "room_id": "r1",
            "track_id": "mic-b",
            "participant_id": "bob"
          }
        }
      ]
    }
  }
}
