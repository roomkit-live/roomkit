{
  "$schema": "../../scenario.schema.json",
  "id": "conference/ensure-bot-joins-an-empty-conference-and-returns-its-session",
  "title": "ensure_bot joins an empty conference and returns the session it joined, the same one while it lives",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-092",
    "RK-12.10.4-093"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.ensure_bot",
      "channel_id": "conf",
      "room_id": "r1",
      "expect": {
        "result": {
          "id": {
            "$as": "bot"
          },
          "room_id": "r1"
        }
      }
    },
    {
      "call": "conference.ensure_bot",
      "channel_id": "conf",
      "room_id": "r1",
      "expect": {
        "result": {
          "id": {
            "$as": "bot"
          },
          "room_id": "r1"
        }
      }
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "room_id": "r1",
              "session": {
                "$as": "bot"
              }
            }
          ]
        }
      }
    }
  ]
}
