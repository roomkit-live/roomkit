{
  "$schema": "../../scenario.schema.json",
  "id": "broadcast/an-agent-is-asked-and-never-delivered-to",
  "title": "An agent is asked through on_event() and never handed a deliver(); the call's delivery results name the transports alone",
  "rules": [
    "§10.2 step 3c",
    "§10.2 step 3d"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Hi"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "delivery_results": {
            "ws": {
              "status": "sent"
            },
            "ai": {
              "$absent": true
            },
            "sms": {
              "$absent": true
            }
          }
        }
      }
    }
  ],
  "expect": {
    "turns": {
      "room-1": {
        "ai": [
          {
            "id": "room-1#0"
          }
        ]
      }
    },
    "deliveries": {
      "room-1": {
        "sms": [
          {
            "id": "room-1#1"
          }
        ],
        "ws": [
          {
            "id": "room-1#0"
          },
          {
            "id": "room-1#1"
          }
        ],
        "ai": []
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "Hello"
          }
        },
        {
          "source": {
            "channel_id": "ai"
          },
          "content": {
            "body": "Hi"
          },
          "status": "delivered"
        }
      ]
    }
  },
  "notes": "Python: tests/test_router.py::TestOnEventVsDeliver::test_intelligence_gets_only_on_event and TestDeliveryResultTracking::test_intelligence_no_delivery_output."
}
