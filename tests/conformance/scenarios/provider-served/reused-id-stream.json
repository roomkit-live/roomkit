{
  "$schema": "../../scenario.schema.json",
  "rules": [
    "§9.3",
    "§6.4",
    "§12.4"
  ],
  "requirements": [
    "RK-9.3-043"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Local handler witness",
            "parameters": {
              "type": "object"
            },
            "returns": "local result",
            "writes_record": {
              "local_called": true
            }
          }
        ],
        "model": {
          "streaming": true,
          "rounds": [
            {
              "text": "Provider done.",
              "calls": [
                {
                  "id": "p1",
                  "name": "lookup",
                  "arguments": {
                    "q": "one"
                  },
                  "served": {
                    "result": "first",
                    "is_error": false
                  }
                },
                {
                  "id": "p1",
                  "name": "lookup",
                  "arguments": {
                    "q": "two"
                  },
                  "served": {
                    "result": "second",
                    "is_error": true
                  }
                }
              ]
            },
            {
              "text": "Local done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tool_results": []
        }
      ]
    },
    "hooks": {
      "before": [],
      "audit": {
        "$unordered": [
          {
            "tool_call": {
              "name": "lookup",
              "tool_call_id": "p1",
              "arguments": {
                "q": "one"
              },
              "result": "first",
              "is_error": false,
              "cancelled": false,
              "refused": false
            }
          },
          {
            "tool_call": {
              "name": "lookup",
              "tool_call_id": "p1",
              "arguments": {
                "q": "two"
              },
              "result": "second",
              "is_error": true,
              "cancelled": false,
              "refused": false
            }
          }
        ]
      }
    },
    "timeline": {
      "r": [
        {
          "type": "message"
        },
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "Provider done."
          },
          "metadata": {
            "local_called": {
              "$absent": true
            }
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_name": "lookup",
            "tool_id": "p1",
            "arguments": {
              "q": "one"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_name": "lookup",
            "tool_id": "p1",
            "arguments": {
              "q": "one"
            },
            "result": "first",
            "status": "completed",
            "outcome": "served"
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_name": "lookup",
            "tool_id": "p1",
            "arguments": {
              "q": "two"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_name": "lookup",
            "tool_id": "p1",
            "arguments": {
              "q": "two"
            },
            "result": "second",
            "status": "failed",
            "outcome": "failed"
          }
        }
      ]
    }
  },
  "id": "provider-served/reused-id-stream",
  "title": "Two already executed calls sharing one id each retain their own report and end (streaming provider)",
  "notes": "Source checklist: tests/test_served_call_marker.py, test_external_call_routing.py, test_provider_result_bound.py, test_turn_calls_per_call.py, test_external_call_cut.py. The marker is provider data; writes_record witnesses real local execution."
}
