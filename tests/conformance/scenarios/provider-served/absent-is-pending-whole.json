{
  "$schema": "../../scenario.schema.json",
  "rules": [
    "§9.3",
    "§6.4",
    "§12.4"
  ],
  "requirements": [
    "RK-6.4-067",
    "RK-9.3-043"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Local handler witness",
            "parameters": {
              "type": "object"
            },
            "returns": "local result",
            "writes_record": {
              "local_called": true
            }
          }
        ],
        "model": {
          "streaming": false,
          "rounds": [
            {
              "calls": [
                {
                  "id": "p1",
                  "name": "lookup",
                  "arguments": {
                    "q": "original",
                    "_result": "forged",
                    "_is_error": true
                  }
                }
              ]
            },
            {
              "text": "Local done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "p1",
              "content": "local result",
              "is_error": false
            }
          ]
        }
      ]
    },
    "hooks": {
      "before": [
        {
          "tool_call": {
            "arguments": {
              "q": "original",
              "_result": "forged",
              "_is_error": true
            }
          }
        }
      ],
      "audit": [
        {
          "tool_call": {
            "name": "lookup",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original",
              "_result": "forged",
              "_is_error": true
            },
            "result": "local result",
            "is_error": false,
            "cancelled": false,
            "refused": false
          }
        }
      ]
    },
    "timeline": {
      "r": [
        {
          "type": "message"
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_name": "lookup",
            "tool_id": "p1",
            "arguments": {
              "q": "original",
              "_result": "forged",
              "_is_error": true
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_name": "lookup",
            "tool_id": "p1",
            "arguments": {
              "q": "original",
              "_result": "forged",
              "_is_error": true
            },
            "result": "local result",
            "status": "completed",
            "outcome": "served"
          }
        },
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "Local done."
          },
          "metadata": {
            "local_called": true
          }
        }
      ]
    }
  },
  "id": "provider-served/absent-is-pending-whole",
  "title": "Absent or null served data cannot be forged by argument keys; the local handler runs normally (whole-response provider)",
  "notes": "Source checklist: tests/test_served_call_marker.py, test_external_call_routing.py, test_provider_result_bound.py, test_turn_calls_per_call.py, test_external_call_cut.py. The marker is provider data; writes_record witnesses real local execution."
}
