{
  "$schema": "../../scenario.schema.json",
  "id": "provider-served/a-call-its-provider-served-carries-no-intent",
  "title": "With call intents on, a call the provider served itself carries no intent: its arguments, _roomkit_intent among them, stay as the provider gave them",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "requirements": [
    "RK-6.4-120"
  ],
  "notes": "Python: channels/_ai_streaming.py takes the property only from a call the loop serves; a round whose calls the provider served all ends the turn. RK-6.4-120 is cited in part: an external agent's calls are acp/an-external-agent-s-call-carries-no-intent, and a realtime session's own calls need the realtime feature.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "publish_tool_call_text": true,
        "tools": [
          {
            "name": "shell",
            "description": "Run a command.",
            "parameters": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string"
                }
              },
              "required": [
                "command"
              ]
            },
            "returns": "a.txt"
          }
        ],
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "web_search",
                  "arguments": {
                    "q": "x",
                    "_roomkit_intent": "Je cherche."
                  },
                  "served": {
                    "result": "found",
                    "is_error": false
                  }
                }
              ]
            }
          ]
        },
        "tool_call_intents": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "tool_events": {
      "room-1": [
        {
          "type": "tool_call_start",
          "round": 0,
          "channel_id": "agent",
          "tool_calls": [
            {
              "id": "$e1",
              "name": "web_search",
              "intent": {
                "$absent": true
              },
              "arguments": {
                "q": "x",
                "_roomkit_intent": "Je cherche."
              }
            }
          ]
        },
        {
          "type": "tool_call_end",
          "round": 0,
          "channel_id": "agent",
          "tool_calls": [
            {
              "id": "$e1",
              "status": "completed",
              "result": "found",
              "intent": {
                "$absent": true
              }
            }
          ]
        }
      ]
    },
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message"
        },
        {
          "index": 1,
          "type": "tool_call_start",
          "content": {
            "tool_id": "c1",
            "intent": {
              "$absent": true
            },
            "arguments": {
              "q": "x",
              "_roomkit_intent": "Je cherche."
            }
          }
        },
        {
          "index": 2,
          "type": "tool_call_end",
          "content": {
            "tool_id": "c1",
            "intent": {
              "$absent": true
            },
            "outcome": "served"
          }
        }
      ]
    }
  }
}
