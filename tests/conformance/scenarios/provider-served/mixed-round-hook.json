{
  "$schema": "../../scenario.schema.json",
  "rules": [
    "§9.3",
    "§6.4",
    "§12.4"
  ],
  "requirements": [
    "RK-6.4-067",
    "RK-9.2-072",
    "RK-9.3-047"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Local handler witness",
            "parameters": {
              "type": "object"
            },
            "returns": "local result",
            "writes_record": {
              "local_called": true
            }
          }
        ],
        "model": {
          "streaming": true,
          "rounds": [
            {
              "calls": [
                {
                  "id": "p1",
                  "name": "lookup",
                  "arguments": {
                    "q": "original"
                  },
                  "served": {
                    "result": "provider result",
                    "is_error": true
                  }
                },
                {
                  "id": "c2",
                  "name": "lookup",
                  "arguments": {
                    "q": "local"
                  }
                }
              ]
            },
            {
              "text": "Local done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      },
      {
        "name": "after-round",
        "trigger": "after_tool_round",
        "execution": "sync"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "p1",
              "content": "provider result",
              "is_error": true
            },
            {
              "tool_call_id": "c2",
              "content": "local result",
              "is_error": false
            }
          ]
        }
      ]
    },
    "hooks": {
      "before": [
        {
          "tool_call": {
            "tool_call_id": "c2"
          }
        }
      ],
      "audit": {
        "$unordered": [
          {
            "tool_call": {
              "name": "lookup",
              "tool_call_id": "p1",
              "arguments": {
                "q": "original"
              },
              "result": "provider result",
              "is_error": true,
              "cancelled": false,
              "refused": false
            }
          },
          {
            "tool_call": {
              "name": "lookup",
              "tool_call_id": "c2",
              "arguments": {
                "q": "local"
              },
              "result": "local result",
              "is_error": false,
              "cancelled": false,
              "refused": false
            }
          }
        ]
      },
      "after-round": [
        {
          "tool_round": {
            "calls": [
              {
                "tool_call_id": "c2"
              }
            ],
            "results": [
              {
                "tool_call_id": "c2",
                "content": "local result",
                "is_error": false
              }
            ],
            "answered": [
              {
                "tool_call_id": "p1",
                "content": "provider result",
                "is_error": true
              }
            ]
          }
        }
      ]
    },
    "timeline": {
      "r": [
        {
          "type": "message"
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_name": "lookup",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_name": "lookup",
            "tool_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "provider result",
            "status": "failed",
            "outcome": "failed"
          }
        },
        {
          "type": "tool_call_start",
          "content": {
            "tool_name": "lookup",
            "tool_id": "c2",
            "arguments": {
              "q": "local"
            }
          }
        },
        {
          "type": "tool_call_end",
          "content": {
            "tool_name": "lookup",
            "tool_id": "c2",
            "arguments": {
              "q": "local"
            },
            "result": "local result",
            "status": "completed",
            "outcome": "served"
          }
        },
        {
          "type": "message",
          "content": {
            "type": "text",
            "body": "Local done."
          },
          "metadata": {
            "local_called": true
          }
        }
      ]
    }
  },
  "id": "provider-served/mixed-round-hook",
  "title": "A mixed round reports local results and provider-answered results in separate fields",
  "notes": "Python: channels/_ai_streaming.py::_after_tool_round and _run_announced_calls; original mixed-round replay witnesses extended to observe AFTER_TOOL_ROUND through the public hook."
}
