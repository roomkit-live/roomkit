{
  "$schema": "../../scenario.schema.json",
  "rules": [
    "§9.3",
    "§6.4",
    "§12.4"
  ],
  "requirements": [
    "RK-6.4-397",
    "RK-6.7-111",
    "RK-9.3-051",
    "RK-9.3-052"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Local handler witness",
            "parameters": {
              "type": "object"
            },
            "returns": "local result",
            "writes_record": {
              "local_called": true
            }
          }
        ],
        "model": {
          "streaming": false,
          "rounds": [
            {
              "calls": [
                {
                  "id": "p1",
                  "name": "lookup",
                  "arguments": {
                    "q": "original"
                  },
                  "served": {
                    "result": "provider result",
                    "is_error": true
                  }
                }
              ]
            },
            {
              "text": "Local done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "hold-report",
        "trigger": "on_tool_call",
        "execution": "sync",
        "timeout_ms": 10000,
        "reactions": [
          {
            "gate": "reported"
          }
        ]
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "defer_delivery": true,
      "as": "delivery"
    },
    {
      "wait_for": "reported"
    },
    {
      "call": "delivery.cancel",
      "of": "delivery",
      "reason": "cut"
    },
    {
      "open": "reported"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tool_results": []
        }
      ]
    },
    "hooks": {
      "before": [],
      "audit": [
        {
          "tool_call": {
            "name": "lookup",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "provider result",
            "is_error": true,
            "cancelled": false,
            "refused": false
          }
        }
      ],
      "hold-report": [
        {
          "tool_call": {
            "name": "lookup",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "provider result",
            "is_error": true,
            "cancelled": false,
            "refused": false
          }
        }
      ]
    }
  },
  "id": "provider-served/cut-known-failure-whole",
  "title": "Cancellation during reporting preserves the known provider outcome exactly once (whole-response provider)",
  "notes": "Source checklist: tests/test_served_call_marker.py, test_external_call_routing.py, test_provider_result_bound.py, test_turn_calls_per_call.py, test_external_call_cut.py. The marker is provider data; writes_record witnesses real local execution."
}
