{
  "$schema": "../../scenario.schema.json",
  "rules": [
    "§9.3",
    "§6.4",
    "§12.4"
  ],
  "requirements": [
    "RK-6.4-397",
    "RK-9.3-051"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true,
        "deliver_stream": [
          {
            "stop_after_rows": 1
          }
        ]
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Local handler witness",
            "parameters": {
              "type": "object"
            },
            "returns": "local result",
            "writes_record": {
              "local_called": true
            }
          }
        ],
        "model": {
          "streaming": false,
          "rounds": [
            {
              "calls": [
                {
                  "id": "p1",
                  "name": "lookup",
                  "arguments": {
                    "q": "original"
                  },
                  "served": {
                    "result": "provider result",
                    "is_error": true
                  }
                }
              ]
            },
            {
              "text": "Local done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tool_results": []
        }
      ]
    },
    "hooks": {
      "before": [],
      "audit": [
        {
          "tool_call": {
            "name": "lookup",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "provider result",
            "is_error": true,
            "cancelled": false,
            "refused": false
          }
        }
      ]
    }
  },
  "id": "provider-served/stop-at-start-failure-whole",
  "title": "A reader stopping at a provider call start keeps its known failure (whole)",
  "notes": "Python: tests/test_external_call_cut.py::test_a_call_the_provider_ran_keeps_its_outcome_when_cut[no-handler]. No external-handler integration is claimed."
}
