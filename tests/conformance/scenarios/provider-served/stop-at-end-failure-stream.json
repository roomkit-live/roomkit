{
  "$schema": "../../scenario.schema.json",
  "rules": [
    "§9.3",
    "§6.4",
    "§12.4"
  ],
  "requirements": [
    "RK-9.3-051",
    "RK-9.3-052"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true,
        "deliver_stream": [
          {
            "stop_after_rows": 2
          }
        ]
      },
      {
        "id": "agent",
        "type": "ai",
        "publish_tool_call_text": true,
        "tools": [
          {
            "name": "lookup",
            "description": "Local handler witness",
            "parameters": {
              "type": "object"
            },
            "returns": "local result",
            "writes_record": {
              "local_called": true
            }
          }
        ],
        "model": {
          "streaming": true,
          "rounds": [
            {
              "calls": [
                {
                  "id": "p1",
                  "name": "lookup",
                  "arguments": {
                    "q": "original"
                  },
                  "served": {
                    "result": "provider result",
                    "is_error": true
                  }
                }
              ]
            },
            {
              "text": "Local done."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "before",
        "trigger": "before_tool_use",
        "execution": "sync"
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "r",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tool_results": []
        }
      ]
    },
    "hooks": {
      "before": [],
      "audit": [
        {
          "tool_call": {
            "name": "lookup",
            "tool_call_id": "p1",
            "arguments": {
              "q": "original"
            },
            "result": "provider result",
            "is_error": true,
            "cancelled": false,
            "refused": false
          }
        }
      ]
    },
    "tool_events": {
      "r": [
        {
          "type": "tool_call_start",
          "round": 0,
          "tool_calls": [
            {
              "id": "$e1",
              "name": "lookup",
              "arguments": {
                "q": "original"
              }
            }
          ]
        },
        {
          "type": "tool_call_end",
          "round": 0,
          "duration_ms": {
            "$present": true
          },
          "tool_calls": [
            {
              "id": "$e1",
              "name": "lookup",
              "result": "provider result",
              "status": "failed"
            }
          ]
        }
      ]
    }
  },
  "id": "provider-served/stop-at-end-failure-stream",
  "title": "A reader stopping at a provider call end publishes the original failure once (stream)",
  "notes": "Python: tests/test_ai_streaming_tool_events.py::test_a_stream_closed_on_a_call_s_end_still_publishes_it[provider-s-call-stopped]. This shared scenario observes the public streaming reader and room subscriber; the cut iterator boundary is separate."
}
