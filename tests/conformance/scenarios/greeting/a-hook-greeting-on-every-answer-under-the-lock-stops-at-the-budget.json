{
  "$schema": "../../scenario.schema.json",
  "id": "greeting/a-hook-greeting-on-every-answer-under-the-lock-stops-at-the-budget",
  "title": "A hook under the room's lock that greets on every answer stops at the cascade's reentry budget: each greeting draws a pass, as each answer does",
  "rules": [
    "§8.3",
    "§13.5",
    "§19.1"
  ],
  "notes": "At max_chain_depth 2 the budget is 20 passes. Under the lock a greeting commits ahead of the answer its hook decides on, at depth 0, so the depth limit never stops it. Each greeting and each answer draws one: the answer past the budget is stored BLOCKED reentry_loop_cap, its hooks not run, so nothing greets again.",
  "setup": {
    "kit": {
      "max_chain_depth": 2
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": []
        },
        "agent": {
          "greeting": "Welcome!",
          "auto_greet": false
        }
      },
      {
        "id": "other",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "repeat": true,
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Noted"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "access": "write_only"
          },
          {
            "channel_id": "other",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "greeter",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "source_channel_id": "other"
            },
            "repeat": true,
            "do": [
              {
                "call": "send_greeting",
                "room_id": "$room"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_greeting",
      "room_id": "room-1"
    },
    {
      "idle": true
    }
  ],
