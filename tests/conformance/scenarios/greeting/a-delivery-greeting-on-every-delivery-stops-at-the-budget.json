{
  "$schema": "../../scenario.schema.json",
  "id": "greeting/a-delivery-greeting-on-every-delivery-stops-at-the-budget",
  "title": "A transport's delivery that greets on every delivery stops at the cascade's reentry budget: each greeting draws a pass",
  "rules": [
    "§8.3",
    "§10.1 step 18",
    "§19.1"
  ],
  "notes": "At max_chain_depth 1 the budget is 10 passes. Each greeting's delivery to sms makes the next one; past the budget it is stored BLOCKED reentry_loop_cap, with no delivery to go on from.",
  "setup": {
    "kit": {
      "max_chain_depth": 1
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "deliver": [
          {
            "repeat": true,
            "do": [
              {
                "call": "send_greeting",
                "room_id": "$room"
              }
            ]
          }
        ]
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": []
        },
        "agent": {
          "greeting": "Welcome!",
          "auto_greet": false
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "agent",
            "category": "intelligence",
            "access": "write_only"
          },
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_greeting",
      "room_id": "room-1"
    },
    {
      "idle": true
    }
  ],
