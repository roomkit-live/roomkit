{
  "$schema": "../../scenario.schema.json",
  "id": "greeting/a-greeting-takes-no-source-check",
  "title": "A muted or read-only agent's greeting is stored as any greeting, not blocked, and delivered to no one",
  "rules": [
    "§7.5 rule 2",
    "§19.1"
  ],
  "notes": "§7.5 rule 2 leaves a greeting to a path of its own: nothing blocks it. Its delivery set is a source's that cannot write: empty. It runs all the same, so AFTER_BROADCAST fires.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": []
        },
        "agent": {
          "greeting": "Welcome!",
          "auto_greet": false
        }
      }
    ],
    "rooms": [
      {
        "id": "muted",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "muted": true
          }
        ]
      },
      {
        "id": "read-only",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "access": "read_only"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "after",
        "trigger": "after_broadcast",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "send_greeting",
      "room_id": "muted"
    },
    {
      "call": "send_greeting",
      "room_id": "read-only"
    }
  ],
  "expect": {
    "timeline": {
      "muted": [
        {
          "type": "message",
          "source": {
            "channel_id": "agent",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Welcome!"
          },
          "metadata": {
            "auto_greeting": true
          },
          "status": "delivered",
          "index": 0
        }
      ],
      "read-only": [
        {
          "type": "message",
          "source": {
            "channel_id": "agent",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Welcome!"
          },
          "metadata": {
            "auto_greeting": true
          },
          "status": "delivered",
          "index": 0
        }
      ]
    },
    "deliveries": {
      "muted": {
        "sms": []
      },
      "read-only": {
        "sms": []
      }
    },
    "hooks": {
      "after": [
        {
          "trigger": "after_broadcast",
          "room_id": "muted",
          "event": {
            "content": {
              "body": "Welcome!"
            }
          }
        },
        {
          "trigger": "after_broadcast",
          "room_id": "read-only",
          "event": {
            "content": {
              "body": "Welcome!"
            }
          }
        }
      ]
    }
  }
}
