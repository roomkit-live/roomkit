          },
          "status": "delivered"
        },
        {
          "type": "message",
          "source": {
            "channel_id": "first",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "From first"
          },
          "metadata": {
            "auto_greeting": true
          },
          "status": "delivered"
        },
        {
          "type": "message",
          "source": {
            "channel_id": "first",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "From first"
          },
          "metadata": {
            "auto_greeting": true
          },
          "status": "delivered"
        },
        {
          "type": "message",
          "source": {
            "channel_id": "first",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "From first"
          },
          "metadata": {
            "auto_greeting": true
          },
          "status": "delivered"
        }
      ],
      "room-2": [
        {
          "type": "message",
          "source": {
            "channel_id": "silent",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Spoken"
          },
          "metadata": {
            "auto_greeting": true
          },
          "status": "delivered"
        }
      ]
    }
  }
}
