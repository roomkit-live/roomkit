            "channel_id": "first",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "From first"
          },
          "metadata": {
            "auto_greeting": true
          },
          "status": "delivered"
        },
        {
