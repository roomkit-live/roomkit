{
  "$schema": "../../scenario.schema.json",
  "id": "greeting/a-greeting-stays-within-its-agent-s-visibility",
  "title": "A greeting's visibility is narrowed by its agent's binding: stored so, and delivered to the channels it names only",
  "rules": [
    "§7.3",
    "§19.1"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "email",
        "type": "email",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": []
        },
        "agent": {
          "greeting": "Welcome!",
          "auto_greet": false
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "email"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "visibility": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_greeting",
      "room_id": "room-1"
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "type": "message",
          "source": {
            "channel_id": "agent",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Welcome!"
          },
          "metadata": {
            "auto_greeting": true
          },
          "status": "delivered",
          "index": 0,
          "visibility": "sms"
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "sms": [
          {
            "content": {
              "body": "Welcome!"
            }
          }
        ],
        "email": []
      }
    }
  }
}
