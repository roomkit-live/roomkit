{
  "$schema": "../../scenario.schema.json",
  "id": "greeting/a-session-started-hook-holds-no-message",
  "title": "An ON_SESSION_STARTED hook of the integrator runs in the background: the message goes on while it runs, the greeting stored first",
  "rules": [
    "§9.3",
    "§10.1 step 2"
  ],
  "notes": "The hook waits at a gate no step opens before the call returned. The greeting's own hook is awaited, and session_started is emitted once it is over.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "deltas": [
                "How can I help?"
              ]
            }
          ]
        },
        "agent": {
          "greeting": "Welcome!"
        }
      }
    ],
    "hooks": [
      {
        "name": "attach_agent",
        "trigger": "on_room_created",
        "execution": "async",
        "reactions": [
          {
            "do": [
              {
                "call": "attach_channel",
                "room_id": "$room",
                "channel_id": "agent"
              }
            ]
          }
        ]
      },
      {
        "name": "slow_user_hook",
        "trigger": "on_session_started",
        "execution": "async",
        "reactions": [
          {
            "gate": "slow"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    },
    {
      "wait_for": "slow"
    },
    {
      "open": "slow"
    }
  ],
  "expect": {
    "timeline": {
      "$r1": [
        {
          "type": "message",
          "source": {
            "channel_id": "agent",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Welcome!"
          },
          "metadata": {
            "auto_greeting": true
          },
          "status": "delivered",
          "index": 0
        },
        {
          "index": 1,
          "source": {
            "channel_id": "sms"
          },
          "content": {
            "body": "Hi"
          }
        },
        {
          "index": 2,
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "body": "How can I help?"
          }
        }
      ]
    },
    "hooks": {
      "slow_user_hook": [
        {
          "trigger": "on_session_started",
          "room_id": "$r1"
        }
      ]
    },
    "framework_events": {
      "$r1": [
        "room_channel_attached",
        "room_created",
        "room_channel_attached",
        "session_started",
        "event_processed"
      ]
    }
  }
}
