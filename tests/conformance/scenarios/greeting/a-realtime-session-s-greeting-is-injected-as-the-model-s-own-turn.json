{
  "$schema": "../../scenario.schema.json",
  "id": "greeting/a-realtime-session-s-greeting-is-injected-as-the-model-s-own-turn",
  "title": "An agent with a greeting and auto_greet, bound to the room a realtime session starts in, greets it as the model's own turn: injected with the assistant role, and stored as its greeting",
  "rules": [
    "§19.1",
    "§12.4"
  ],
  "requirements": [
    "RK-19.1-042"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {}
      },
      {
        "id": "src",
        "type": "websocket"
      },
      {
        "id": "greeter",
        "type": "ai",
        "model": {
          "rounds": []
        },
        "agent": {
          "greeting": "Hello, how can I help?",
          "auto_greet": true
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          },
          {
            "channel_id": "greeter"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "injections": [
            {
              "text": "Hello, how can I help?",
              "role": "assistant"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "type": "message",
          "source": {
            "channel_id": "greeter",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Hello, how can I help?"
          },
          "metadata": {
            "auto_greeting": true
          }
        }
      ]
    }
  }
}
