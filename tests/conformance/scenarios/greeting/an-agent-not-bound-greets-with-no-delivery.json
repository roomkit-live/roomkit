{
  "$schema": "../../scenario.schema.json",
  "id": "greeting/an-agent-not-bound-greets-with-no-delivery",
  "title": "An agent named by send_greeting that the room does not bind has its greeting stored and delivered to no one, no hook firing",
  "rules": [
    "§19.1"
  ],
  "notes": "The room binds no such source, so there is nothing to broadcast from: the greeting is a record of the timeline, AFTER_BROADCAST sees none.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": []
        },
        "agent": {
          "greeting": "Welcome!",
          "auto_greet": false
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "after",
        "trigger": "after_broadcast",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "send_greeting",
      "room_id": "room-1",
      "agent_id": "agent"
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "type": "message",
          "source": {
            "channel_id": "agent",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Welcome!"
          },
          "metadata": {
            "auto_greeting": true
          },
          "status": "delivered",
          "index": 0
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "sms": []
      }
    },
    "hooks": {
      "after": []
    }
  }
}
