{
  "$schema": "../../scenario.schema.json",
  "id": "greeting/a-channel-unregistered-greets-no-more",
  "title": "An agent unregistered no longer greets, and one registered again under its id greets by its own identity",
  "rules": [
    "§19.1"
  ],
  "notes": "Its auto-greet goes with it: registered again with auto_greet off, it says nothing; the second message's room gets the greeting of the agent registered after it.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": []
        },
        "agent": {
          "greeting": "Old"
        }
      }
    ],
    "hooks": [
      {
        "name": "attach_agent",
        "trigger": "on_room_created",
        "execution": "async",
        "reactions": [
          {
            "do": [
              {
                "call": "attach_channel",
                "room_id": "$room",
                "channel_id": "agent"
              }
            ],
            "repeat": true
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "unregister_channel",
      "channel_id": "agent"
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "deltas": [
                "Answer one"
              ]
            }
          ]
        },
        "agent": {
          "greeting": "New",
          "auto_greet": false
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    },
    {
      "call": "unregister_channel",
      "channel_id": "agent"
    },
    {
      "call": "register_channel",
      "channel": {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "deltas": [
                "Answer two"
              ]
            }
          ]
        },
        "agent": {
          "greeting": "Newer"
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15557654321",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r2"
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "$r1": [
        {
          "source": {
            "channel_id": "sms"
          },
          "content": {
            "body": "Hi"
          }
        },
        {
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "body": "Answer one"
          }
        }
      ],
      "$r2": [
        {
          "type": "message",
          "source": {
            "channel_id": "agent",
            "channel_type": "ai",
            "direction": "outbound"
          },
          "content": {
            "type": "text",
            "body": "Newer"
          },
          "metadata": {
            "auto_greeting": true
          },
          "status": "delivered"
        },
        {
          "source": {
            "channel_id": "sms"
          },
          "content": {
            "body": "Hello"
          }
        },
        {
          "source": {
            "channel_id": "agent"
          },
          "content": {
            "body": "Answer two"
          }
        }
      ]
    }
  }
}
