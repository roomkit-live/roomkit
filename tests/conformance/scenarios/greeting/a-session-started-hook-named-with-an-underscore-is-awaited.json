{
  "$schema": "../../scenario.schema.json",
  "id": "greeting/a-session-started-hook-named-with-an-underscore-is-awaited",
  "title": "An ON_SESSION_STARTED hook whose name starts with an underscore is awaited before the message goes on, as an agent's greeting is; one that fails stops nothing",
  "rules": [
    "§10.1 step 2"
  ],
  "notes": "The hook injects an event in the room: stored ahead of the message. A hook of any other name injecting the same would race the message, so it is not asserted here.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      }
    ],
    "hooks": [
      {
        "name": "_first",
        "trigger": "on_session_started",
        "execution": "async",
        "reactions": [
          {
            "do": [
              {
                "call": "send_event",
                "room_id": "$room",
                "channel_id": "sms",
                "content": {
                  "type": "text",
                  "body": "Ahead"
                }
              }
            ]
          }
        ]
      },
      {
        "name": "_failing",
        "trigger": "on_session_started",
        "execution": "async",
        "reactions": [
          {
            "fail": "boom"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "$r1"
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "$r1": [
        {
          "index": 0,
          "source": {
            "channel_id": "sms"
          },
          "content": {
            "body": "Ahead"
          }
        },
        {
          "index": 1,
          "source": {
            "channel_id": "sms"
          },
          "content": {
            "body": "Hi"
          }
        }
      ]
    }
  }
}
