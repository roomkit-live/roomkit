{
  "$schema": "../../scenario.schema.json",
  "id": "greeting/a-hook-greeting-on-its-own-greeting-stops-at-its-hook-calls",
  "title": "An ASYNC hook's body that greets on every event, its own greeting included, stops at the cascade's hook calls: no agent need answer for it to stop",
  "rules": [
    "§8.3",
    "§9.5.1",
    "§19.1"
  ],
  "notes": "At max_chain_depth 1 the budget holds 10 hook calls. The hook fires on the greeting's own AFTER_BROADCAST, and each call it makes draws one; past them its greeting is stored BLOCKED reentry_loop_cap, with no AFTER_BROADCAST to go on from. No agent reads the room.",
  "setup": {
    "kit": {
      "max_chain_depth": 1
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": []
        },
        "agent": {
          "greeting": "Welcome!",
          "auto_greet": false
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "agent",
            "category": "intelligence",
            "access": "write_only"
          },
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "greeter",
        "trigger": "after_broadcast",
        "execution": "async",
        "reactions": [
          {
            "repeat": true,
            "do": [
              {
                "call": "send_greeting",
                "room_id": "$room"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_greeting",
      "room_id": "room-1"
    },
    {
      "idle": true
    }
  ],
