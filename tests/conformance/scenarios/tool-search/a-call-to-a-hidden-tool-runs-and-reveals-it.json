{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-call-to-a-hidden-tool-runs-and-reveals-it",
  "title": "A call naming a hidden tool exactly runs, checked against its schema, and the tool stays declared for the next rounds and turns",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "notes": "Python: tests/test_tool_search_text.py::TestDeferredCallRecovery::test_undeclared_catalogue_call_executes.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "send_sms",
                  "arguments": {
                    "to": "+15551234567",
                    "body": "hi"
                  }
                }
              ]
            },
            {
              "text": "Done."
            },
            {
              "text": "Again."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_3",
            "description": "Operate widget number 3.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_4",
            "description": "Operate widget number 4.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 2."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "find_tools": 0,
            "list_tools": 1,
            "send_sms": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "send_sms": 0,
            "find_tools": 1,
            "list_tools": 2,
            "widget_0": {
              "$absent": true
            },
            "widget_1": {
              "$absent": true
            },
            "widget_2": {
              "$absent": true
            },
            "widget_3": {
              "$absent": true
            },
            "widget_4": {
              "$absent": true
            }
          },
          "tool_results": [
            {
              "tool_call_id": "t1",
              "content": "{\"ok\": true}",
              "is_error": false
            }
          ]
        },
        {
          "tools": {
            "send_sms": 0,
            "find_tools": 1,
            "list_tools": 2,
            "widget_0": {
              "$absent": true
            },
            "widget_1": {
              "$absent": true
            },
            "widget_2": {
              "$absent": true
            },
            "widget_3": {
              "$absent": true
            },
            "widget_4": {
              "$absent": true
            }
          }
        }
      ]
    },
    "hooks": {
      "report": [
        {
          "trigger": "on_ai_response",
          "response": {
            "declared_tools": {
              "send_sms": {
                "origin": "sticky"
              }
            }
          }
        },
        {
          "trigger": "on_ai_response",
          "response": {
            "declared_tools": {
              "send_sms": {
                "origin": "sticky"
              }
            }
          }
        }
      ]
    }
  }
}
