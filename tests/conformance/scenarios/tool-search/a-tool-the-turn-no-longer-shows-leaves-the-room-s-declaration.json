{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-tool-the-turn-no-longer-shows-leaves-the-room-s-declaration",
  "title": "A tool a turn no longer shows leaves the room's declaration, and a later turn that shows it again reopens it",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "requirements": [
    "RK-6.4-396"
  ],
  "notes": "The observer's role denies the pinned tool lookup. The member's first turn fixes the room's declaration, lookup shown. The observer's turn no longer shows lookup: it leaves the declaration, neither shown, held nor reopened. The member's next turn shows it again, beyond the room's declaration now, and reopens it. The pinned tool is held like any other tool the room's declaration does not show (RK-6.4-392: every other tool the turn declares is held), as both implementations hold it. Not observed: a skill that closes. Python: channels/_tool_reopen.py room_declaration.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look up.",
            "returns": "ok"
          },
          {
            "name": "track_shipment",
            "description": "Track a shipment.",
            "returns": "ok"
          },
          {
            "name": "refund",
            "description": "Refund an order.",
            "returns": "ok"
          }
        ],
        "model": {
          "deferred_tools": true,
          "rounds": [
            {
              "text": "Seen 0."
            },
            {
              "text": "Seen 1."
            },
            {
              "text": "Seen 2."
            }
          ]
        },
        "tool_search": true,
        "tool_search_pinned": [
          "lookup"
        ],
        "tool_policy": {
          "role_overrides": {
            "observer": {
              "deny": [
                "lookup"
              ]
            }
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "participants": [
          {
            "id": "dev",
            "channel_id": "ws",
            "role": "member"
          },
          {
            "id": "obs",
            "channel_id": "ws",
            "role": "observer"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "obs",
        "content": {
          "type": "text",
          "body": "status?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "again"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "lookup": {
              "$present": true
            }
          },
          "deferred_tools": [
            "track_shipment",
            "refund"
          ],
          "reopened_tools": []
        },
        {
          "tools": {
            "lookup": {
              "$absent": true
            }
          },
          "deferred_tools": [
            "track_shipment",
            "refund"
          ],
          "reopened_tools": []
        },
        {
          "tools": {
            "lookup": {
              "$present": true
            }
          },
          "reopened_tools": [
            "lookup"
          ]
        }
      ]
    }
  }
}
