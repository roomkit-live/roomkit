{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-call-to-find-tools-where-nothing-is-hidden-is-refused",
  "title": "Where Tool Search hides nothing, find_tools is refused as any undeclared tool",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "notes": "Python: tests/test_tool_list_parity.py::TestAnUndeclaredInfrastructureTool::test_a_text_turn_refuses_it.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "widget"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "widget_0": 0,
            "widget_1": 1,
            "find_tools": {
              "$absent": true
            },
            "list_tools": {
              "$absent": true
            }
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"error\": \"Tool 'find_tools' is not declared.\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
