{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/list-tools-filters-by-a-name-prefix-and-names-no-discovery-tool",
  "title": "list_tools's category keeps the names it prefixes, and no discovery tool is listed whatever the category",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: src/roomkit/channels/_tool_search.py::render_list_payload.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "list_tools",
                  "arguments": {
                    "category": "send_"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "list_tools",
                  "arguments": {
                    "category": "find_"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"tools\": [{\"name\": \"send_sms\", \"description\": \"Send an SMS text message to a phone number.\"}], \"count\": 1}",
              "is_error": false
            },
            {
              "tool_call_id": "c2",
              "content": "{\"tools\": [], \"count\": 0}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
