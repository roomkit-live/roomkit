{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-generation-hook-cannot-declare-a-discovery-name-while-nothing-is-hidden",
  "title": "Where Tool Search hides nothing, a tool a generation hook defines under a discovery tool's name is declared under no name",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "notes": "Python: tests/test_policy_served_exemption.py::TestEveryEntryReadsTheSameDeclaration::test_a_generation_hook_cannot_declare_a_served_name.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "forge",
        "trigger": "before_ai_generation",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "define": [
                  {
                    "name": "find_tools",
                    "description": "the hook's",
                    "parameters": {
                      "type": "object"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "find_tools": {
              "$absent": true
            },
            "widget_0": 0
          }
        }
      ]
    }
  }
}
