{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/on-ai-response-keeps-a-tool-the-window-dropped",
  "title": "The reported declaration is the union of the rounds: a tool a later search dropped stays in it",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_ai_response_declared_tools.py::test_the_union_keeps_a_tool_the_reveal_window_dropped.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "sms phone"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "t2",
                  "name": "find_tools",
                  "arguments": {
                    "query": "electronic mail"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_3",
            "description": "Operate widget number 3.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_4",
            "description": "Operate widget number 4.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "mail_deliver",
            "description": "Deliver an electronic mail.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                }
              }
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tools": {
            "send_sms": 0,
            "find_tools": 1,
            "list_tools": 2,
            "mail_deliver": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "mail_deliver": 0,
            "find_tools": 1,
            "list_tools": 2,
            "send_sms": {
              "$absent": true
            }
          }
        }
      ]
    },
    "hooks": {
      "report": [
        {
          "trigger": "on_ai_response",
          "response": {
            "declared_tools": {
              "send_sms": {
                "origin": "revealed"
              },
              "mail_deliver": {
                "origin": "revealed"
              }
            }
          }
        }
      ]
    }
  }
}
