{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-room-whose-declaration-is-not-known-takes-the-one-its-turn-shows",
  "title": "A room whose declaration is not known takes the one its first turn shows, not another room's",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "requirements": [
    "RK-6.4-396"
  ],
  "notes": "The observer's role denies the pinned tool lookup. Room 1's first turn is the observer's: its declaration holds no lookup. Room 2, a new room whose declaration is not known, then takes the one its own first turn, the member's, shows: lookup shown, the rest held, nothing reopened. The pinned tool is held like any other tool the room's declaration does not show (RK-6.4-392: every other tool the turn declares is held), as both implementations hold it. Not observed: a restarted process. Python: channels/_tool_reopen.py room_declaration.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look up.",
            "returns": "ok"
          },
          {
            "name": "track_shipment",
            "description": "Track a shipment.",
            "returns": "ok"
          },
          {
            "name": "refund",
            "description": "Refund an order.",
            "returns": "ok"
          }
        ],
        "model": {
          "deferred_tools": true,
          "rounds": [
            {
              "text": "Seen 0."
            },
            {
              "text": "Seen 1."
            }
          ]
        },
        "tool_search": true,
        "tool_search_pinned": [
          "lookup"
        ],
        "tool_policy": {
          "role_overrides": {
            "observer": {
              "deny": [
                "lookup"
              ]
            }
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "participants": [
          {
            "id": "dev",
            "channel_id": "ws",
            "role": "member"
          },
          {
            "id": "obs",
            "channel_id": "ws",
            "role": "observer"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "participants": [
          {
            "id": "dev",
            "channel_id": "ws",
            "role": "member"
          },
          {
            "id": "obs",
            "channel_id": "ws",
            "role": "observer"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "obs",
        "content": {
          "type": "text",
          "body": "status?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "lookup": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "lookup": {
              "$present": true
            }
          },
          "deferred_tools": [
            "track_shipment",
            "refund"
          ],
          "reopened_tools": []
        }
      ]
    }
  }
}
