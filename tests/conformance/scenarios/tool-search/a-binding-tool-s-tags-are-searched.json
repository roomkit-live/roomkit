{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-binding-tool-s-tags-are-searched",
  "title": "The tags of a tool a binding declares are searched as a host tool's are",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: src/roomkit/channels/_ai_context.py::_turn_base_tools.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "send a message"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence",
            "metadata": {
              "tools": [
                {
                  "name": "envoyer_texto",
                  "description": "Envoie un texto.",
                  "parameters": {},
                  "tags": [
                    "send",
                    "message"
                  ]
                },
                {
                  "name": "widget_0",
                  "description": "Operate widget number 0.",
                  "parameters": {}
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tools": {
            "envoyer_texto": {
              "$present": true
            }
          }
        }
      ]
    }
  }
}
