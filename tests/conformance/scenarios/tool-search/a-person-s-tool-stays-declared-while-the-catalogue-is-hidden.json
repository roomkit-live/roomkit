{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-person-s-tool-stays-declared-while-the-catalogue-is-hidden",
  "title": "While the catalogue is hidden the person's tool stays declared, reported as always, and find_tools never names it",
  "rules": [
    "§6.4",
    "§9.3",
    "§21.1"
  ],
  "notes": "Python: tests/test_toolset_names_across_doors.py::test_the_person_s_tools_are_never_hidden_by_tool_search_on_a_text_turn.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "ask the person"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true,
        "human_input": {
          "tool_names": [
            "ask_person"
          ],
          "tools": [
            {
              "name": "ask_person",
              "description": "Ask the person.",
              "parameters": {
                "type": "object"
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "ask_person": {
              "$present": true
            },
            "find_tools": {
              "$present": true
            },
            "list_tools": {
              "$present": true
            },
            "widget_0": {
              "$absent": true
            },
            "widget_1": {
              "$absent": true
            },
            "widget_2": {
              "$absent": true
            }
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$lacks": "ask_person"
              },
              "is_error": false
            }
          ]
        }
      ]
    },
    "hooks": {
      "report": [
        {
          "trigger": "on_ai_response",
          "response": {
            "declared_tools": {
              "ask_person": {
                "origin": "always"
              }
            }
          }
        }
      ]
    }
  }
}
