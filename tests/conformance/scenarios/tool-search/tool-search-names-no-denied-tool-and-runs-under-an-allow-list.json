{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/tool-search-names-no-denied-tool-and-runs-under-an-allow-list",
  "title": "An allow list that omits the discovery tools leaves them running, and neither names a tool the policy denies",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "notes": "Python: tests/test_tool_search_text.py::TestPolicyExemption::test_find_tools_runs_under_whitelist_policy, tests/test_tool_policy_exemptions.py::test_tool_search_names_no_denied_or_gated_tool.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "send sms"
                  }
                },
                {
                  "id": "c2",
                  "name": "list_tools"
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true,
        "tool_policy": {
          "allow": [
            "send_sms"
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "find_tools": 0,
            "list_tools": 1
          }
        },
        {
          "tools": {
            "send_sms": 0,
            "find_tools": 1,
            "list_tools": 2
          },
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"matches\": [{\"name\": \"send_sms\", \"description\": \"Send an SMS text message to a phone number.\"}], \"_note\": \"These tools are now invocable \\u2014 their full schemas are in your tool list. Call the right one directly. Do not call find_tools again unless none of these fit.\"}",
              "is_error": false
            },
            {
              "tool_call_id": "c2",
              "is_error": false,
              "content": {
                "$lacks": "widget_0"
              }
            }
          ]
        }
      ]
    }
  }
}
