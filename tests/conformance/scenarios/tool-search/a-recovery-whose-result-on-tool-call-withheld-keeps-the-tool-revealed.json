{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-recovery-whose-result-on-tool-call-withheld-keeps-the-tool-revealed",
  "title": "A hidden tool whose result ON_TOOL_CALL withheld answered: it stays declared, this turn and the next",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: tests/test_tool_search_recovered_reveal.py::test_a_call_the_tool_answered_keeps_it_revealed[on-tool-call-block].",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "send_sms",
                  "arguments": {
                    "to": "+15551234567",
                    "body": "hi"
                  }
                }
              ]
            },
            {
              "text": "Done."
            },
            {
              "text": "Again."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_3",
            "description": "Operate widget number 3.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_4",
            "description": "Operate widget number 4.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "withhold",
        "trigger": "on_tool_call",
        "reactions": [
          {
            "result": {
              "action": "block",
              "reason": "withheld"
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 2."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "send_sms": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "send_sms": {
              "$present": true
            }
          }
        },
        {
          "tools": {
            "send_sms": {
              "$present": true
            }
          }
        }
      ]
    }
  }
}
