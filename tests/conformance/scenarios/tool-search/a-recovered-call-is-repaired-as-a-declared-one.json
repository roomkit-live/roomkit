{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-recovered-call-is-repaired-as-a-declared-one",
  "title": "A call to a hidden tool has its arguments repaired against the tool's schema as a declared tool's are",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "notes": "Python: tests/test_quoted_primitive_arguments.py::test_a_tool_recovered_at_call_time_reads_a_quoted_integer.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "count_items",
                  "arguments": {
                    "n": "3"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "count_items",
            "description": "Count items.",
            "parameters": {
              "type": "object",
              "properties": {
                "n": {
                  "type": "integer"
                }
              },
              "required": [
                "n"
              ]
            },
            "returns": "counted"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "see",
        "trigger": "on_tool_call"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "see": [
        {
          "trigger": "on_tool_call",
          "tool_call": {
            "name": "count_items",
            "arguments": {
              "n": 3
            }
          }
        }
      ]
    }
  }
}
