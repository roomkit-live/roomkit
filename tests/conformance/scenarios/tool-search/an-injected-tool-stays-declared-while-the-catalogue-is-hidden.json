{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/an-injected-tool-stays-declared-while-the-catalogue-is-hidden",
  "title": "A tool orchestration injects stays declared while the catalogue is hidden, reported as always: find_tools does not name it, list_tools does",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "notes": "Python: tests/test_tool_search_orchestration.py::test_the_tools_orchestration_injects_stay_declared, test_find_tools_does_not_name_an_orchestration_tool, tests/test_tool_list_parity.py::TestListTools::test_a_text_turn_lists_the_tools_always_declared.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {
          "role": "Coordinator"
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "delegate to the researcher"
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "list_tools"
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      },
      {
        "id": "researcher",
        "type": "ai",
        "agent": {
          "role": "Researcher"
        },
        "model": {
          "rounds": []
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "researcher"
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "room-1",
      "strategy": "team"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "sup": [
        {
          "tools": {
            "delegate_to_researcher": {
              "$present": true
            },
            "find_tools": {
              "$present": true
            },
            "list_tools": {
              "$present": true
            },
            "widget_0": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "delegate_to_researcher": {
              "$present": true
            },
            "find_tools": {
              "$present": true
            },
            "list_tools": {
              "$present": true
            },
            "widget_0": {
              "$absent": true
            }
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$lacks": "delegate_to_researcher"
              }
            },
            {
              "tool_call_id": "c2",
              "content": {
                "$contains": "delegate_to_researcher"
              }
            }
          ]
        }
      ]
    },
    "hooks": {
      "report": [
        {
          "trigger": "on_ai_response",
          "response": {
            "declared_tools": {
              "delegate_to_researcher": {
                "origin": "always"
              }
            }
          }
        }
      ]
    }
  }
}
