{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/another-agent-s-stored-calls-keep-no-tool-declared",
  "title": "An agent attached to a room reads its own stored calls alone: a tool another agent used there stays hidden from it",
  "rules": [
    "§6.4",
    "§7.5 rule 8"
  ],
  "notes": "Python: tests/test_tool_memory_rebuild.py::test_a_joining_agent_does_not_rebuild_another_agents_calls.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "one",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "send_sms",
                  "arguments": {
                    "to": "+15551234567",
                    "body": "hi"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_3",
            "description": "Operate widget number 3.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_4",
            "description": "Operate widget number 4.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      },
      {
        "id": "two",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_3",
            "description": "Operate widget number 3.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_4",
            "description": "Operate widget number 4.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "one",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "detach_channel",
      "room_id": "room-1",
      "channel_id": "one"
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "two",
      "category": "intelligence"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Again."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "one": [
        {},
        {
          "tools": {
            "send_sms": {
              "$present": true
            }
          }
        }
      ],
      "two": [
        {
          "tools": {
            "send_sms": {
              "$absent": true
            }
          }
        }
      ]
    }
  }
}
