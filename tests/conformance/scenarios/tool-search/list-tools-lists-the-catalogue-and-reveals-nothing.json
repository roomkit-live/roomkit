{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/list-tools-lists-the-catalogue-and-reveals-nothing",
  "title": "list_tools lists what the turn can call, its discovery tools aside, in a gist per tool, and reveals nothing",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_tool_search_text.py::TestFindToolsReveal::test_list_tools_reveals_nothing.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "list_tools"
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tools": {
            "find_tools": 0,
            "list_tools": 1,
            "send_sms": {
              "$absent": true
            },
            "widget_0": {
              "$absent": true
            }
          },
          "tool_results": [
            {
              "tool_call_id": "c1",
              "is_error": false,
              "content": {
                "$contains": "{\"name\": \"send_sms\", \"description\": \"Send an SMS text message to a phone number.\"}"
              }
            }
          ]
        }
      ]
    }
  }
}
