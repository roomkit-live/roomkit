{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-pinned-discovery-tool-is-reported-pinned",
  "title": "A discovery tool the host pins is reported as pinned: pinned is the earliest reason",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: src/roomkit/channels/_ai_policy.py::_declaration_origin.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true,
        "tool_search_pinned": [
          "find_tools"
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "report": [
        {
          "trigger": "on_ai_response",
          "response": {
            "declared_tools": {
              "find_tools": {
                "origin": "pinned"
              },
              "list_tools": {
                "origin": "always"
              }
            }
          }
        }
      ]
    }
  }
}
