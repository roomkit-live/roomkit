{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/an-injected-tool-is-reported-always-even-once-used",
  "title": "A tool orchestration injects stays reported as always on the turns after it was used, never as sticky",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "notes": "Python: tests/test_tool_search_orchestration.py::test_an_orchestration_tool_is_declared_always_even_once_used.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "sup",
        "type": "ai",
        "agent": {
          "role": "Coordinator"
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_to_researcher",
                  "arguments": {
                    "task": "Find the facts."
                  }
                }
              ]
            },
            {
              "text": "Done."
            },
            {
              "text": "Again."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      },
      {
        "id": "researcher",
        "type": "ai",
        "agent": {
          "role": "Researcher"
        },
        "model": {
          "rounds": [
            {
              "text": "The facts."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "team",
        "supervisor": {
          "supervisor": "sup",
          "workers": [
            "researcher"
          ]
        }
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "room-1",
      "strategy": "team"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Again."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "sup": [
        {
          "tools": {
            "delegate_to_researcher": {
              "$present": true
            },
            "widget_0": {
              "$absent": true
            }
          }
        },
        {},
        {
          "tools": {
            "delegate_to_researcher": {
              "$present": true
            },
            "widget_0": {
              "$absent": true
            }
          }
        }
      ]
    },
    "hooks": {
      "report": {
        "$unordered": [
          {
            "response": {
              "channel_id": "sup",
              "declared_tools": {
                "delegate_to_researcher": {
                  "origin": "always"
                }
              }
            }
          },
          {
            "response": {
              "channel_id": "researcher"
            }
          },
          {
            "response": {
              "channel_id": "sup",
              "declared_tools": {
                "delegate_to_researcher": {
                  "origin": "always"
                }
              }
            }
          }
        ]
      }
    }
  }
}
