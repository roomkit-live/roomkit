{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-pinned-tool-does-not-count-toward-the-schemas",
  "title": "A pinned tool's schema is no part of what its share of the window is measured against: the rest fits, and nothing is hidden",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: src/roomkit/channels/_tool_search.py::should_activate_tool_search.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Done."
            }
          ],
          "context_window": 8192
        },
        "tools": [
          {
            "name": "big_pin",
            "description": "",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search_pinned": [
          "big_pin"
        ],
        "tool_search_threshold_pct": 0.37841796875
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "big_pin": 0,
            "widget_0": 1,
            "widget_1": 2,
            "find_tools": {
              "$absent": true
            },
            "list_tools": {
              "$absent": true
            }
          }
        }
      ]
    }
  }
}
