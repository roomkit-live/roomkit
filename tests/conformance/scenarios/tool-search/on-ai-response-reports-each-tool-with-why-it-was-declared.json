{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/on-ai-response-reports-each-tool-with-why-it-was-declared",
  "title": "ON_AI_RESPONSE reports a revealed tool with its schema as revealed, a pinned one as pinned, a discovery tool as always, and no tool that stayed hidden",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_ai_response_declared_tools.py::test_a_revealed_tool_is_reported_with_its_schema.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "send sms"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_3",
            "description": "Operate widget number 3.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_4",
            "description": "Operate widget number 4.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true,
        "tool_search_pinned": [
          "widget_1"
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "report": [
        {
          "trigger": "on_ai_response",
          "response": {
            "declared_tools": {
              "widget_1": {
                "origin": "pinned",
                "position": 0
              },
              "find_tools": {
                "origin": "always",
                "position": 1
              },
              "list_tools": {
                "origin": "always",
                "position": 2
              },
              "send_sms": {
                "origin": "revealed",
                "description": "Send an SMS text message to a phone number.",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "to": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "to",
                    "body"
                  ]
                }
              },
              "widget_0": {
                "$absent": true
              }
            }
          }
        }
      ]
    }
  }
}
