{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-denied-tool-is-not-recovered",
  "title": "A call naming a tool the policy denies is refused for that, with no hint, and leaves it undeclared",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "notes": "Python: tests/test_tool_search_text.py::TestDeferredCallRecovery::test_policy_denied_catalogue_tool_is_not_recovered.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "send_sms",
                  "arguments": {
                    "to": "+15551234567",
                    "body": "hi"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_3",
            "description": "Operate widget number 3.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_4",
            "description": "Operate widget number 4.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true,
        "tool_policy": {
          "allow": [
            "widget_0"
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tools": {
            "send_sms": {
              "$absent": true
            }
          },
          "tool_results": [
            {
              "tool_call_id": "t1",
              "content": "{\"error\": \"Tool 'send_sms' is not permitted by the agent's tool policy.\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
