{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/find-tools-reveals-its-matches-for-the-next-round",
  "title": "find_tools answers its matches' names and short descriptions, and declares them at the next round, in the toolset's order",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_tool_search_text.py::TestFindToolsReveal::test_find_tools_reveals_next_round.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "send sms"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_3",
            "description": "Operate widget number 3.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_4",
            "description": "Operate widget number 4.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "send_sms",
            "description": "Send an SMS text message to a phone number.",
            "parameters": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "body"
              ]
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "find_tools": 0,
            "list_tools": 1,
            "send_sms": {
              "$absent": true
            },
            "widget_0": {
              "$absent": true
            },
            "widget_1": {
              "$absent": true
            },
            "widget_2": {
              "$absent": true
            },
            "widget_3": {
              "$absent": true
            },
            "widget_4": {
              "$absent": true
            }
          }
        },
        {
          "tools": {
            "send_sms": 0,
            "find_tools": 1,
            "list_tools": 2,
            "widget_0": {
              "$absent": true
            },
            "widget_1": {
              "$absent": true
            },
            "widget_2": {
              "$absent": true
            },
            "widget_3": {
              "$absent": true
            },
            "widget_4": {
              "$absent": true
            }
          },
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"matches\": [{\"name\": \"send_sms\", \"description\": \"Send an SMS text message to a phone number.\"}], \"_note\": \"These tools are now invocable \\u2014 their full schemas are in your tool list. Call the right one directly. Do not call find_tools again unless none of these fit.\"}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
