{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-replaced-search-still-reveals-its-matches",
  "title": "A search whose result ON_TOOL_CALL replaced was served: the model reads the replacement, and its matches are revealed",
  "rules": [
    "§6.4",
    "§9.3"
  ],
  "notes": "Python: tests/test_find_tools_judged.py::TestText::test_a_replaced_search_still_reveals_its_matches.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "spotify"
                  }
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "spotify_play",
            "description": "Play a song on spotify.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "spotify_search",
            "description": "Search spotify.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "x5",
            "description": "A fifth thing.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "judge",
        "trigger": "on_tool_call",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "result": "{\"matches\": []}"
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tools": {
            "spotify_play": 0,
            "spotify_search": 1,
            "find_tools": 2,
            "list_tools": 3
          },
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"matches\": []}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
