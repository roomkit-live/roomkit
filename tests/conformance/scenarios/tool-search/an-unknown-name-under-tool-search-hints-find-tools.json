{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/an-unknown-name-under-tool-search-hints-find-tools",
  "title": "A name no tool carries is refused with a hint at find_tools while it hides the catalogue",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "notes": "Python: tests/test_tool_search_text.py::TestDeferredCallRecovery::test_unknown_name_fails_with_find_tools_hint.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "t1",
                  "name": "does_not_exist"
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "t1",
              "content": "{\"error\": \"No tool named 'does_not_exist' exists.\", \"hint\": \"Check the spelling, or call find_tools(query=<the task>) to discover the right tool.\"}",
              "is_error": true
            }
          ]
        }
      ]
    }
  }
}
