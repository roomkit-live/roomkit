{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-round-that-declares-nothing-still-recovers-a-kept-tool",
  "title": "With the discovery tools taken out the first round declares nothing, and a call naming a hidden tool the hook kept still runs",
  "rules": [
    "§6.4",
    "§9.2"
  ],
  "notes": "Python: tests/test_hook_tool_restrictions.py::test_under_tool_search_a_kept_deferred_tool_is_recovered_at_call_time.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c0",
                  "name": "wire_money"
                }
              ]
            },
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "safe_read",
            "description": "Read a record.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "wire_money",
            "description": "Wire money to an account.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "take",
        "trigger": "before_ai_generation",
        "reactions": [
          {
            "result": {
              "action": "modify",
              "event": {
                "tools": [
                  "safe_read",
                  "wire_money"
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "find_tools": {
              "$absent": true
            },
            "wire_money": {
              "$absent": true
            },
            "safe_read": {
              "$absent": true
            }
          }
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c0",
              "content": "{\"ok\": true}",
              "is_error": false
            }
          ]
        }
      ]
    }
  }
}
