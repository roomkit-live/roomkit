{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-served-search-reveals-for-the-next-round-and-the-next-turn",
  "title": "A served search's matches stay declared at the next turn's first round, reported sticky there",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_find_tools_judged.py::TestText::test_a_served_search_reveals_for_the_next_round_and_turn, tests/test_channels/test_ai_response_declared_tools.py::test_a_tool_found_in_an_earlier_turn_is_sticky.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "find_tools",
                  "arguments": {
                    "query": "spotify"
                  }
                }
              ]
            },
            {
              "text": "Done."
            },
            {
              "text": "Again."
            }
          ]
        },
        "tools": [
          {
            "name": "spotify_play",
            "description": "Play a song on spotify.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "spotify_search",
            "description": "Search spotify.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "x5",
            "description": "A fifth thing.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_0",
            "description": "Operate widget number 0.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_1",
            "description": "Operate widget number 1.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "widget_2",
            "description": "Operate widget number 2.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "report",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 2."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "tools": {
            "spotify_play": 0,
            "spotify_search": 1,
            "find_tools": 2,
            "list_tools": 3
          }
        },
        {
          "tools": {
            "spotify_play": 0,
            "spotify_search": 1,
            "find_tools": 2,
            "list_tools": 3
          }
        }
      ]
    },
    "hooks": {
      "report": [
        {
          "trigger": "on_ai_response",
          "response": {
            "declared_tools": {
              "spotify_play": {
                "origin": "revealed"
              }
            }
          }
        },
        {
          "trigger": "on_ai_response",
          "response": {
            "declared_tools": {
              "spotify_play": {
                "origin": "sticky"
              }
            }
          }
        }
      ]
    }
  }
}
