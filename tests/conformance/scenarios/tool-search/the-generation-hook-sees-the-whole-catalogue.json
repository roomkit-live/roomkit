{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/the-generation-hook-sees-the-whole-catalogue",
  "title": "BEFORE_AI_GENERATION sees the whole catalogue the turn may reach, its discovery tools among it, while the first round declares the collapse",
  "rules": [
    "§6.4",
    "§9.2"
  ],
  "notes": "Python: tests/test_hook_tool_restrictions.py::test_under_tool_search_the_hook_sees_the_catalogue.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Done."
            }
          ]
        },
        "tools": [
          {
            "name": "safe_read",
            "description": "Read a record.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          },
          {
            "name": "wire_money",
            "description": "Wire money to an account.",
            "parameters": {
              "type": "object"
            },
            "returns": "{\"ok\": true}"
          }
        ],
        "tool_search": true
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "see",
        "trigger": "before_ai_generation"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Go 1."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {
          "tools": {
            "find_tools": 0,
            "list_tools": 1,
            "safe_read": {
              "$absent": true
            },
            "wire_money": {
              "$absent": true
            }
          }
        }
      ]
    },
    "hooks": {
      "see": [
        {
          "trigger": "before_ai_generation",
          "generation": {
            "tools": [
              "safe_read",
              "wire_money",
              "find_tools",
              "list_tools"
            ]
          }
        }
      ]
    }
  }
}
