{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-status-recipient-is-read-as-step-one-reads-a-sender",
  "title": "A delivery status's recipient is written in its channel's form before its room is looked for, as step 1 reads a sender",
  "rules": [
    "§10.4 A delivery status follows its message",
    "§5.7"
  ],
  "notes": "The channel writes its numbers in E.164 by its own normalize_address: the recipients as the provider wrote them name the rooms their bindings name in that form.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {
          "normalizes": {
            "+1 (555) 000-0001": "+15550000001",
            "+1 555 000 0003": "+15550000003"
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-carol",
        "bindings": [
          {
            "channel_id": "sms",
            "metadata": {
              "phone_number": "+15550000003"
            }
          }
        ]
      },
      {
        "id": "stored",
        "bindings": [
          {
            "channel_id": "sms",
            "metadata": {
              "phone_number": "+15550000001"
            }
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "status",
        "trigger": "on_delivery_status",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_delivery_status",
      "status": {
        "provider": "mock",
        "message_id": "m-1",
        "status": "delivered",
        "channel_id": "sms",
        "recipient": "+1 (555) 000-0001"
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_delivery_status",
      "status": {
        "provider": "mock",
        "message_id": "m-2",
        "status": "delivered",
        "channel_id": "sms",
        "recipient": "+1 555 000 0003"
      }
    }
  ],
  "expect": {
    "hooks": {
      "status": [
        {
          "trigger": "on_delivery_status",
          "room_id": "stored",
          "delivery_status": {
            "message_id": "m-1",
            "recipient": "+1 (555) 000-0001"
          }
        },
        {
          "trigger": "on_delivery_status",
          "room_id": "room-carol",
          "delivery_status": {
            "message_id": "m-2",
            "recipient": "+1 555 000 0003"
          }
        }
      ]
    }
  }
}
