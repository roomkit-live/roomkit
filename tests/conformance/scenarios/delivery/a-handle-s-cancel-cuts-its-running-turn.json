{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-handle-s-cancel-cuts-its-running-turn",
  "title": "Cancelling a running delivery releases every waiter with its first reason and preserves a turn already queued in its room",
  "rules": [
    "§10.1 Explicit delivery cancellation",
    "§10.1 step 18"
  ],
  "notes": "Python: tests/test_delivery_cancellation.py::test_queued_turn_in_same_room_survives_cancelled_cascade and ::test_deferred_cancel_is_terminal_and_releases_all_waiters. B commits while A is held; two waits start before the cut. This checks outcomes after cleanup, not Python finalizer scheduling.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "task A"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to task A"
                }
              }
            ],
            "gate": "a-runs"
          },
          {
            "when": {
              "text": "task B"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to task B"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "task A"
        }
      },
      "defer_delivery": true,
      "as": "a",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "content": {
              "body": "task A"
            }
          },
          "cancellation_reason": null
        }
      }
    },
    {
      "wait_for": "a-runs"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "task B"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "cancellation_reason": null,
          "response_events": []
        }
      },
      "defer_delivery": true,
      "as": "b"
    },
    {
      "call": "delivery.wait",
      "of": "a",
      "background": true,
      "as": "wait_1"
    },
    {
      "call": "delivery.wait",
      "of": "a",
      "background": true,
      "as": "wait_2"
    },
    {
      "call": "delivery.cancel",
      "of": "a",
      "reason": "stopped",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "content": {
              "body": "task A"
            }
          },
          "cancellation_reason": "stopped"
        }
      }
    },
    {
      "call": "delivery.cancel",
      "of": "a",
      "reason": "again",
      "expect": {
        "result": {
          "cancellation_reason": "stopped"
        }
      }
    },
    {
      "call": "delivery.wait",
      "of": "a",
      "expect": {
        "result": {
          "cancellation_reason": "stopped"
        }
      }
    },
    {
      "await": "wait_1",
      "expect": {
        "result": {
          "cancellation_reason": "stopped",
          "blocked": false,
          "response_events": [],
          "error": null
        }
      }
    },
    {
      "await": "wait_2",
      "expect": {
        "result": {
          "cancellation_reason": "stopped",
          "blocked": false,
          "response_events": [],
          "error": null
        }
      }
    },
    {
      "call": "delivery.wait",
      "of": "b",
      "expect": {
        "result": {
          "cancellation_reason": null,
          "response_events": [
            {
              "content": {
                "body": "answer to task B"
              }
            }
          ],
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "task A"
          },
          "index": 0
        },
        {
          "content": {
            "body": "task B"
          },
          "index": 1
        },
        {
          "content": {
            "body": "answer to task B"
          },
          "index": 2
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "task A"
            }
          },
          {
            "content": {
              "body": "task B"
            }
          },
          {
            "content": {
              "body": "answer to task B"
            }
          }
        ]
      }
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "task A"
            }
          },
          {
            "content": {
              "body": "task B"
            }
          }
        ]
      }
    }
  }
}
