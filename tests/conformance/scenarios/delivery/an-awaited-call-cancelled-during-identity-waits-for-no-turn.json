{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/an-awaited-call-cancelled-during-identity-waits-for-no-turn",
  "title": "A call cancelled during identity returns before the preceding turn ends and still delivers in order",
  "rules": [
    "§10.1 Explicit delivery cancellation",
    "§10.2"
  ],
  "notes": "Python: tests/test_delivery_cancel_turns.py::test_an_awaited_call_cancelled_before_its_commit_waits_for_no_turn[identity]. B returns while A remains held, then only A finishes its turn. A scripted router holds routing; it does not model Python binding_exists specifically.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "task A"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to task A"
                }
              }
            ],
            "gate": "a-runs"
          },
          {
            "when": {
              "text": "task B"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to task B"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "when": {
              "text": "task B"
            },
            "gate": "b-identity",
            "result": {
              "status": "unknown"
            }
          }
        ]
      }
    },
    "hooks": [
      {
        "name": "broadcast",
        "trigger": "after_broadcast",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "task A"
        },
        "delivery_key": "a"
      },
      "background": true,
      "as": "a"
    },
    {
      "wait_for": "a-runs"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "task B"
        },
        "delivery_key": "b"
      },
      "background": true,
      "as": "b"
    },
    {
      "wait_for": "b-identity"
    },
    {
      "call": "cancel_delivery",
      "key": "b",
      "reason": "stopped",
      "expect": {
        "result": 1
      }
    },
    {
      "open": "b-identity"
    },
    {
      "await": "b",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "content": {
              "body": "task B"
            }
          },
          "cancellation_reason": "stopped"
        }
      }
    },
    {
      "open": "a-runs"
    },
    {
      "await": "a",
      "expect": {
        "result": {
          "cancellation_reason": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "task A"
          },
          "index": 0
        },
        {
          "content": {
            "body": "task B"
          },
          "index": 1
        },
        {
          "content": {
            "body": "answer to task A"
          },
          "index": 2
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "task A"
            }
          }
        ]
      }
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "task A"
            }
          },
          {
            "content": {
              "body": "task B"
            }
          },
          {
            "content": {
              "body": "answer to task A"
            }
          }
        ]
      }
    },
    "hooks": {
      "broadcast": {
        "$unordered": [
          {
            "trigger": "after_broadcast",
            "room_id": "room-1",
            "event": {
              "content": {
                "body": "task A"
              }
            }
          },
          {
            "trigger": "after_broadcast",
            "room_id": "room-1",
            "event": {
              "content": {
                "body": "task B"
              }
            }
          },
          {
            "trigger": "after_broadcast",
            "room_id": "room-1",
            "event": {
              "content": {
                "body": "answer to task A"
              }
            }
          }
        ]
      }
    }
  }
}
