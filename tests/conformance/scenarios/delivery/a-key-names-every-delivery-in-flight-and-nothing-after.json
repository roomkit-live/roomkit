{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-key-names-every-delivery-in-flight-and-nothing-after",
  "title": "A key names every delivery in flight that carries it, each counted once, and nothing once its delivery is over, a call refused before its commit included",
  "rules": [
    "§10.1 Explicit delivery cancellation",
    "§17.2"
  ],
  "notes": "Python: src/roomkit/core/_delivery_keys.py, src/roomkit/core/mixins/inbound.py (cancel_delivery); tests/test_delivery_cancel_turns.py::test_a_key_names_every_delivery_in_flight_and_nothing_after, ::test_a_call_refused_before_its_commit_names_nothing_after (RMK-1152).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "parse": [
          {
            "when": {
              "text": "task B"
            },
            "gate": "b-parsing"
          }
        ]
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "task A"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to task A"
                }
              }
            ],
            "gate": "a-runs"
          },
          {
            "when": {
              "text": "task B"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to task B"
                }
              }
            ]
          },
          {
            "when": {
              "text": "task C"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to task C"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ],
        "organization_id": "org-1"
      }
    ]
  },
  "steps": [
    {
      "call": "cancel_delivery",
      "key": "never sent",
      "expect": {
        "result": 0
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "task A"
        },
        "delivery_key": "task"
      },
      "background": true,
      "as": "a"
    },
    {
      "wait_for": "a-runs"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "task B"
        },
        "delivery_key": "task"
      },
      "background": true,
      "as": "b"
    },
    {
      "wait_for": "b-parsing"
    },
    {
      "call": "cancel_delivery",
      "key": "task",
      "expect": {
        "result": 2
      }
    },
    {
      "call": "cancel_delivery",
      "key": "task",
      "expect": {
        "result": 0
      }
    },
    {
      "open": "b-parsing"
    },
    {
      "await": "a",
      "expect": {
        "result": {
          "cancellation_reason": "caller_cancelled"
        }
      }
    },
    {
      "await": "b",
      "expect": {
        "result": {
          "cancellation_reason": "caller_cancelled"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "task C"
        },
        "delivery_key": "c"
      },
      "expect": {
        "result": {
          "cancellation_reason": null
        }
      }
    },
    {
      "call": "cancel_delivery",
      "key": "c",
      "expect": {
        "result": 0
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "task D"
        },
        "delivery_key": "d"
      },
      "organization_id": "org-2",
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "call": "cancel_delivery",
      "key": "d",
      "expect": {
        "result": 0
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "task A"
          }
        },
        {
          "content": {
            "body": "task B"
          }
        },
        {
          "content": {
            "body": "task C"
          }
        },
        {
          "content": {
            "body": "answer to task C"
          }
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "task A"
            }
          },
          {
            "content": {
              "body": "task C"
            }
          }
        ]
      }
    }
  }
}
