{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-status-naming-no-recipient-reaches-the-one-room",
  "title": "A delivery status naming no recipient reaches the one active room bound to its channel",
  "rules": [
    "§10.4 A delivery status follows its message"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {
          "normalizes": {}
        }
      }
    ],
    "rooms": [
      {
        "id": "room-alice",
        "bindings": [
          {
            "channel_id": "sms",
            "participant_id": "+15550000001"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "status",
        "trigger": "on_delivery_status",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_delivery_status",
      "status": {
        "provider": "mock",
        "message_id": "m",
        "status": "delivered",
        "channel_id": "sms"
      }
    }
  ],
  "expect": {
    "hooks": {
      "status": [
        {
          "trigger": "on_delivery_status",
          "room_id": "room-alice",
          "delivery_status": {
            "recipient": ""
          }
        }
      ]
    }
  }
}
