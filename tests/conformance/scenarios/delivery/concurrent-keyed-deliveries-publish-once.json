{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/concurrent-keyed-deliveries-publish-once",
  "title": "Deliveries keyed alike made together publish once: every caller is told of the one event, and one turn is asked",
  "rules": [
    "§22.1",
    "§13.4",
    "§13.5"
  ],
  "notes": "The key is looked up under the room lock within the room, so a concurrent replay waits for the first publication and finds its key.",
  "setup": {
    "channels": [
      {
        "id": "human",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "category": "intelligence"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "human"
          },
          {
            "channel_id": "a",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "concurrent": [
        {
          "call": "deliver",
          "room_id": "room-1",
          "content": "done",
          "addressed_to": [
            "a"
          ],
          "idempotency_key": "k",
          "expect": {
            "result": {
              "status": "sent",
              "event_id": "room-1#0"
            }
          }
        },
        {
          "call": "deliver",
          "room_id": "room-1",
          "content": "done",
          "addressed_to": [
            "a"
          ],
          "idempotency_key": "k",
          "expect": {
            "result": {
              "status": "sent",
              "event_id": "room-1#0"
            }
          }
        },
        {
          "call": "deliver",
          "room_id": "room-1",
          "content": "done",
          "addressed_to": [
            "a"
          ],
          "idempotency_key": "k",
          "expect": {
            "result": {
              "status": "sent",
              "event_id": "room-1#0"
            }
          }
        }
      ]
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "idempotency_key": "roomkit:publication:k"
        }
      ]
    },
    "turns": {
      "room-1": {
        "a": [
          {
            "content": {
              "type": "text",
              "body": "done"
            }
          }
        ]
      }
    }
  }
}
