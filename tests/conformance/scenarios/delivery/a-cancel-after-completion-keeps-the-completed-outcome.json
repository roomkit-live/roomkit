{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-cancel-after-completion-keeps-the-completed-outcome",
  "title": "A cancel after completion preserves the successful outcome and every answer",
  "rules": [
    "§10.1 Explicit delivery cancellation",
    "§10.1 step 18"
  ],
  "notes": "Python: src/roomkit/models/delivery.py::DeliveryHandle.cancel, which returns its completed result without cancelling; tests/test_delivery_cancellation.py::test_deferred_cancel_is_terminal_and_releases_all_waiters covers repeat cancellation. This case checks the successful terminal branch.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "task A"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to task A"
                }
              }
            ]
          },
          {
            "when": {
              "text": "task B"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to task B"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "user",
        "content": {
          "type": "text",
          "body": "task A"
        }
      },
      "defer_delivery": true,
      "as": "a"
    },
    {
      "call": "delivery.wait",
      "of": "a",
      "expect": {
        "result": {
          "cancellation_reason": null,
          "response_events": [
            {
              "content": {
                "body": "answer to task A"
              }
            }
          ]
        }
      }
    },
    {
      "call": "delivery.cancel",
      "of": "a",
      "reason": "too late",
      "expect": {
        "result": {
          "cancellation_reason": null,
          "blocked": false,
          "error": null,
          "response_events": [
            {
              "content": {
                "body": "answer to task A"
              }
            }
          ]
        }
      }
    },
    {
      "call": "delivery.wait",
      "of": "a",
      "expect": {
        "result": {
          "cancellation_reason": null,
          "response_events": [
            {
              "content": {
                "body": "answer to task A"
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "task A"
          },
          "index": 0,
          "status": "delivered"
        },
        {
          "content": {
            "body": "answer to task A"
          },
          "index": 1,
          "status": "delivered"
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "task A"
            }
          },
          {
            "content": {
              "body": "answer to task A"
            }
          }
        ]
      }
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "task A"
            }
          }
        ]
      }
    }
  }
}
