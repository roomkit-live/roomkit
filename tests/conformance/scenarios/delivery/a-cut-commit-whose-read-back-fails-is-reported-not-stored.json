{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-cut-commit-whose-read-back-fails-is-reported-not-stored",
  "title": "A call the kit's close cuts once its commit landed, whose read-back fails, is reported as not stored, whatever the store holds",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-066",
    "RK-12.10.4-068"
  ],
  "notes": "Python: tests/test_kit_close.py::test_a_cut_commit_whose_read_back_fails_reports_nothing_stored_and_says_so. Each call holds once its commit's write answered, at a gate no step opens, past the close's grace (100 ms, which no successful work races); the close cuts it, and it reads its event back by its id: the get_event faults, each taken by one call's read-back, fail it. Each call reports nothing stored, as a call cut before its commit does (a refusal, or kit_closed raised), though the store holds its event. The warning the framework logs is not observed, nor a read-back that runs out, nor a write that completes after the call's writes unwound.",
  "setup": {
    "kit": {
      "store_faults": true,
      "close_grace_ms": 100
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      },
      {
        "id": "room-3",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "store_fault": "commit_event",
      "room_id": "room-1",
      "gate": "landed-1"
    },
    {
      "store_fault": "commit_event",
      "room_id": "room-2",
      "gate": "landed-2"
    },
    {
      "store_fault": "commit_event",
      "room_id": "room-3",
      "gate": "landed-3"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "slow"
        }
      },
      "background": true,
      "as": "inbound"
    },
    {
      "wait_for": "landed-1"
    },
    {
      "call": "send_event",
      "room_id": "room-2",
      "channel_id": "sms",
      "content": {
        "type": "text",
        "body": "slow"
      },
      "background": true,
      "as": "injection"
    },
    {
      "wait_for": "landed-2"
    },
    {
      "call": "commit_event",
      "room_id": "room-3",
      "event": {
        "content": {
          "type": "text",
          "body": "slow"
        }
      },
      "background": true,
      "as": "record"
    },
    {
      "wait_for": "landed-3"
    },
    {
      "store_fault": "get_event",
      "fail": "the store is gone"
    },
    {
      "store_fault": "get_event",
      "fail": "the store is gone"
    },
    {
      "store_fault": "get_event",
      "fail": "the store is gone"
    },
    {
      "call": "close",
      "expect": {
        "result": null
      }
    },
    {
      "await": "inbound",
      "expect": {
        "result": {
          "event": null,
          "blocked": true,
          "reason": "kit_closed",
          "cancellation_reason": "kit_closed"
        }
      }
    },
    {
      "await": "injection",
      "expect": {
        "error": "kit_closed"
      }
    },
    {
      "await": "record",
      "expect": {
        "error": "kit_closed"
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "slow"
          }
        }
      ],
      "room-2": [
        {
          "content": {
            "body": "slow"
          }
        }
      ],
      "room-3": [
        {
          "content": {
            "body": "slow"
          }
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": []
      },
      "room-2": {
        "ws": []
      },
      "room-3": {
        "ws": []
      }
    }
  }
}
