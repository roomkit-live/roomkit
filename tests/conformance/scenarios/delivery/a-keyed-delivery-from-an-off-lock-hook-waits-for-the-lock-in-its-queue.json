{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-keyed-delivery-from-an-off-lock-hook-waits-for-the-lock-in-its-queue",
  "title": "A keyed delivery an off-lock hook's body makes waits for the room lock in its queue: a detach ahead of it there makes it unavailable, nothing written; its retry once the transport is back publishes",
  "rules": [
    "§22.1",
    "§9.5.1",
    "§13.5"
  ],
  "notes": "A call in the room's admission order takes the publication's section as any caller does: it waits for the room lock behind the calls queued for it before, here the detach of its transport, which its check then sees. No record is stored under the key, so the retry is a first publication. This fixture explicitly uses the in-memory lock manager so wait_for_lock establishes a FIFO queue before the held section opens. The store remains the runner's store. A distributed manager may still be connecting when the framework counts a waiter; this scenario makes no promise about that manager's queue order.",
  "setup": {
    "channels": [
      {
        "id": "human",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "category": "intelligence"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "human"
          },
          {
            "channel_id": "a",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "check",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "reactions": [
          {
            "when": {
              "text": "go"
            },
            "gate": "admitted",
            "do": [
              {
                "call": "deliver",
                "room_id": "$room",
                "content": "done",
                "idempotency_key": "k",
                "addressed_to": [
                  "a"
                ],
                "as": "early"
              }
            ]
          }
        ]
      },
      {
        "name": "hold",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "hold"
            },
            "gate": "locked"
          }
        ]
      }
    ],
    "kit": {
      "lock_manager": {
        "kind": "memory"
      }
    }
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "human",
        "sender_id": "u",
        "content": {
          "type": "text",
          "body": "hold"
        },
        "addressed_to": []
      },
      "background": true,
      "as": "hold"
    },
    {
      "wait_for": "locked"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "human",
        "sender_id": "u",
        "content": {
          "type": "text",
          "body": "go"
        },
        "addressed_to": []
      },
      "background": true,
      "as": "go"
    },
    {
      "wait_for": "admitted"
    },
    {
      "call": "detach_channel",
      "room_id": "room-1",
      "channel_id": "human",
      "background": true,
      "as": "detach"
    },
    {
      "wait_for_lock": "room-1"
    },
    {
      "open": "admitted"
    },
    {
      "wait_for_lock": "room-1",
      "waiters": 2
    },
    {
      "open": "locked"
    },
    {
      "await": "hold",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "id": "room-1#0"
          }
        }
      }
    },
    {
      "await": "detach"
    },
    {
      "await": "go",
      "expect": {
        "result": {
          "blocked": true,
          "reason": "source_unbound",
          "event": {
            "id": "room-1#1"
          }
        }
      }
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "human"
    },
    {
      "call": "deliver",
      "room_id": "room-1",
      "content": "done",
      "addressed_to": [
        "a"
      ],
      "idempotency_key": "k",
      "expect": {
        "result": {
          "status": "sent",
          "event_id": "room-1#2",
          "duplicate": false
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "hold"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "go"
          },
          "status": "blocked",
          "blocked_by": "source_unbound"
        },
        {
          "idempotency_key": "roomkit:publication:k"
        }
      ]
    },
    "turns": {
      "room-1": {
        "a": [
          {
            "content": {
              "type": "text",
              "body": "done"
            }
          }
        ]
      }
    },
    "actions": {
      "early": [
        {
          "result": {
            "status": "unavailable",
            "reason": "channel_unavailable",
            "unavailable_targets": [
              "human"
            ],
            "event_id": null
          }
        }
      ]
    }
  }
}
