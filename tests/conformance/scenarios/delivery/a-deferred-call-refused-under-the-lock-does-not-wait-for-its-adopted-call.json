{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-deferred-call-refused-under-the-lock-does-not-wait-for-its-adopted-call",
  "title": "The handle of a deferred call refused process_timeout under the lock does not wait for the call it adopted",
  "rules": [
    "§9.5.1 Reentrance",
    "§13.6"
  ],
  "notes": "Python: src/roomkit/core/mixins/inbound.py, an adopted call's cascade of its own (_commit_and_await_delivery, self._cascades.new), its completion detached; src/roomkit/core/lanes.py, a call's name released once it returned (call_returned, over). Found by the review of RMK-1432.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "A1",
              "gate": "answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "adopts",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "do": [
              {
                "call": "process_inbound",
                "room_id": "room-1",
                "message": {
                  "channel_id": "ws",
                  "sender_id": "alice",
                  "content": {
                    "type": "text",
                    "body": "side"
                  }
                },
                "defer_delivery": true,
                "as": "side"
              }
            ]
          }
        ],
        "timeout_ms": 5000
      },
      {
        "name": "slow",
        "trigger": "before_broadcast",
        "timeout_ms": 5000,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "gate": "never"
          }
        ]
      }
    ],
    "kit": {
      "process_timeout_ms": 200
    }
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "defer_delivery": true,
      "as": "h",
      "expect": {
        "result": {
          "blocked": true,
          "reason": "process_timeout",
          "event": null
        }
      }
    },
    {
      "call": "delivery.wait",
      "of": "h",
      "expect": {
        "result": {
          "blocked": true,
          "reason": "process_timeout",
          "event": null
        }
      }
    },
    {
      "open": "answer"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "side"
          }
        },
        {
          "content": {
            "body": "A1"
          }
        }
      ]
    }
  }
}
