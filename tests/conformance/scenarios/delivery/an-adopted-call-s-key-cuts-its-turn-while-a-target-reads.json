{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/an-adopted-call-s-key-cuts-its-turn-while-a-target-reads",
  "title": "Cancelling the key of a deferred call an off-lock hook made cuts the call's turn while a streaming target reads its answer",
  "rules": [
    "§10.1 Explicit delivery cancellation",
    "§9.5.1 Reentrance",
    "§10.1 step 14",
    "§6.4 The turn's record",
    "§12.2 step 13s"
  ],
  "requirements": [
    "RK-10.1-099",
    "RK-10.1-102",
    "RK-10.1-111",
    "RK-10.1-112",
    "RK-10.1-115"
  ],
  "notes": "Python: src/roomkit/models/delivery.py DeliveryHandle.wait and report_cascade, src/roomkit/core/mixins/inbound.py (a call a hook makes, adopted by the cascade whose hook made it, its handle told once that cascade read its streams) (RMK-1322, RMK-1329). The outer hook waits until the target reads A1 from the adopted call before allowing hello to commit. Each stream belongs to its own cascade and can finish before the other. Each answer retains its link to its input.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true,
        "deliver_stream": [
          {
            "hold_after": "A1",
            "hold_gate": "reading"
          }
        ]
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "A1"
            },
            {
              "text": "A2"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "adopts",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "do": [
              {
                "call": "process_inbound",
                "room_id": "room-1",
                "message": {
                  "channel_id": "ws",
                  "sender_id": "alice",
                  "content": {
                    "type": "text",
                    "body": "side"
                  },
                  "delivery_key": "k"
                },
                "defer_delivery": true,
                "as": "side"
              }
            ],
            "after_do_gate": "outer-input"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "background": true,
      "as": "h"
    },
    {
      "wait_for": "reading"
    },
    {
      "open": "outer-input"
    },
    {
      "call": "cancel_delivery",
      "key": "k",
      "reason": "stopped",
      "expect": {
        "result": 1
      }
    },
    {
      "open": "reading"
    },
    {
      "await": "h"
    },
    {
      "idle": true
    },
    {
      "call": "delivery.wait",
      "of": "side",
      "expect": {
        "result": {
          "cancellation_reason": "stopped",
          "response_metadata": {
            "turns": {
              "agent": {
                "loop_end_reason": "cancelled"
              }
            }
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": {
        "$unordered": [
          {
            "id": "room-1#0",
            "content": {
              "body": "side"
            }
          },
          {
            "id": {
              "$as": "parent-event"
            },
            "content": {
              "body": "hello"
            }
          },
          {
            "source": {
              "channel_id": "agent"
            },
            "responds_to": "room-1#0",
            "content": {
              "body": "A1"
            }
          },
          {
            "source": {
              "channel_id": "agent"
            },
            "responds_to": {
              "$as": "parent-event"
            },
            "content": {
              "body": "A2"
            }
          }
        ]
      }
    }
  }
}
