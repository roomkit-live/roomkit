{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-status-for-the-key-s-value-is-not-the-room-the-channel-reads-another-in",
  "title": "A status for the value under the declared key does not reach the room whose channel answers another recipient",
  "rules": [
    "§10.4 A delivery status follows its message",
    "§5.7"
  ],
  "notes": "reached_at holds Carol, the declared key Bob: the channel delivers to Carol. A status for Bob must not be dispatched with that room's context. Found by the review of RMK-1129.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {
          "recipient_at": "reached_at"
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1"
      }
    ],
    "hooks": [
      {
        "name": "status",
        "trigger": "on_delivery_status",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "store.add_binding",
      "binding": {
        "room_id": "room-1",
        "channel_id": "sms",
        "channel_type": "sms",
        "metadata": {
          "phone_number": "+15550000002",
          "reached_at": "+15550000003"
        }
      }
    },
    {
      "call": "process_delivery_status",
      "status": {
        "provider": "mock",
        "message_id": "m",
        "status": "sent",
        "channel_id": "sms",
        "recipient": "+15550000002"
      }
    }
  ],
  "expect": {
    "hooks": {
      "status": []
    }
  }
}
