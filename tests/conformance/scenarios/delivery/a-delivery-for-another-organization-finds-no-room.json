{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-delivery-for-another-organization-finds-no-room",
  "title": "deliver() acting for an organization reads the room with it first: another organization's room is not found, nothing delivered or fired",
  "rules": [
    "§22.1",
    "§17.2"
  ],
  "setup": {
    "channels": [
      {
        "id": "human",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "human"
          }
        ],
        "organization_id": "globex"
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_deliver"
      },
      {
        "name": "observe",
        "trigger": "after_deliver",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "deliver",
      "room_id": "room-1",
      "content": "done",
      "organization_id": "acme",
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "call": "deliver",
      "room_id": "room-1",
      "content": "done",
      "organization_id": "globex",
      "expect": {
        "result": {
          "status": "sent"
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "done"
          }
        }
      ]
    },
    "hooks": {
      "gate": [
        {
          "trigger": "before_deliver"
        }
      ],
      "observe": [
        {
          "trigger": "after_deliver"
        }
      ]
    }
  }
}
