{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-cancelled-call-returns-while-a-transport-still-delivers",
  "title": "A cancelled call returns once its turns are over, while a transport still delivers its message: the delivery goes on and ends on its own",
  "rules": [
    "§10.1 Explicit delivery cancellation",
    "§10.2"
  ],
  "notes": "Python: src/roomkit/core/_delivery_keys.py, src/roomkit/core/mixins/inbound.py (cancel_delivery); tests/test_delivery_cancel_turns.py::test_a_cancel_returns_at_once_while_a_transport_still_delivers (RMK-1152), its awaited call cancelled by its key.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket",
        "deliver": [
          {
            "when": {
              "text": "task A"
            },
            "gate": "ws-holds"
          }
        ]
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "task A"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to task A"
                }
              }
            ],
            "gate": "a-runs"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "broadcast",
        "trigger": "after_broadcast",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "task A"
        },
        "delivery_key": "a"
      },
      "background": true,
      "as": "a"
    },
    {
      "wait_for": "a-runs"
    },
    {
      "wait_for": "ws-holds"
    },
    {
      "call": "cancel_delivery",
      "key": "a",
      "expect": {
        "result": 1
      }
    },
    {
      "await": "a",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "content": {
              "body": "task A"
            }
          },
          "cancellation_reason": "caller_cancelled"
        }
      }
    },
    {
      "open": "ws-holds"
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "task A"
          }
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "task A"
            }
          }
        ]
      }
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "task A"
            }
          }
        ]
      }
    },
    "hooks": {
      "broadcast": {
        "$unordered": [
          {
            "trigger": "after_broadcast",
            "room_id": "room-1",
            "event": {
              "content": {
                "body": "task A"
              }
            }
          }
        ]
      }
    }
  }
}
