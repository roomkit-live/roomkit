{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/an-adopted-call-waited-in-its-hook-reads-its-stream-s-failure",
  "title": "A deferred call an off-lock hook makes and waits for reads its stream's failure in the hook and later",
  "rules": [
    "§9.5.1 Reentrance",
    "§6.4 The turn's record"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "partial",
              "fails": "boom"
            },
            {
              "text": "A2"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "adopts",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "do": [
              {
                "call": "process_inbound",
                "room_id": "room-1",
                "message": {
                  "channel_id": "ws",
                  "sender_id": "alice",
                  "content": {
                    "type": "text",
                    "body": "side"
                  }
                },
                "defer_delivery": true,
                "as": "side"
              },
              {
                "call": "delivery.wait",
                "of": "side",
                "expect": {
                  "result": {
                    "error": "boom"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "delivery.wait",
      "of": "side",
      "expect": {
        "result": {
          "error": "boom"
        }
      }
    }
  ],
  "notes": "Python: src/roomkit/models/delivery.py DeliveryHandle.wait, cancel and report_cascade, src/roomkit/core/mixins/inbound.py (a call the admission work makes, adopted with a cascade of its own) (RMK-1322, RMK-1329; found by the lot's review)."
}
