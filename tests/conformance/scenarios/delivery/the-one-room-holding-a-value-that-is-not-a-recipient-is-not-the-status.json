{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/the-one-room-holding-a-value-that-is-not-a-recipient-is-not-the-status",
  "title": "The one active room bound to the channel, its binding holding under the recipient key a value that is not a recipient, is not given the status",
  "rules": [
    "§10.4 A delivery status follows its message",
    "§5.7"
  ],
  "notes": "A value that is not a recipient (a boolean, a float, a list, an object) is read as someone else's address (§5.7): no one's status is that room's but the participant's it names, and it names none.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {
          "normalizes": {}
        }
      }
    ],
    "rooms": [
      {
        "id": "free"
      }
    ],
    "hooks": [
      {
        "name": "status",
        "trigger": "on_delivery_status",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "store.add_binding",
      "binding": {
        "room_id": "free",
        "channel_id": "sms",
        "channel_type": "sms",
        "metadata": {
          "phone_number": true
        }
      }
    },
    {
      "call": "process_delivery_status",
      "status": {
        "provider": "mock",
        "message_id": "m",
        "status": "sent",
        "channel_id": "sms",
        "recipient": "+15550000002"
      }
    }
  ],
  "expect": {
    "hooks": {
      "status": []
    }
  }
}
