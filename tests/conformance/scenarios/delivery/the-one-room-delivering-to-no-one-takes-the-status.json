{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/the-one-room-delivering-to-no-one-takes-the-status",
  "title": "The one active room bound to the channel, its binding holding a blank recipient and naming no correspondent, takes the status",
  "rules": [
    "§10.4 A delivery status follows its message",
    "§5.7"
  ],
  "notes": "A blank string is no value: the binding delivers to no one and names no one, so the one room is the status's.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "recipient_key": "phone_number",
        "addresses": {
          "normalizes": {}
        }
      }
    ],
    "rooms": [
      {
        "id": "free"
      }
    ],
    "hooks": [
      {
        "name": "status",
        "trigger": "on_delivery_status",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "store.add_binding",
      "binding": {
        "room_id": "free",
        "channel_id": "sms",
        "channel_type": "sms",
        "metadata": {
          "phone_number": "  "
        }
      }
    },
    {
      "call": "process_delivery_status",
      "status": {
        "provider": "mock",
        "message_id": "m",
        "status": "sent",
        "channel_id": "sms",
        "recipient": "+15550000002"
      }
    }
  ],
  "expect": {
    "hooks": {
      "status": [
        {
          "trigger": "on_delivery_status",
          "room_id": "free",
          "delivery_status": {
            "recipient": "+15550000002"
          }
        }
      ]
    }
  }
}
