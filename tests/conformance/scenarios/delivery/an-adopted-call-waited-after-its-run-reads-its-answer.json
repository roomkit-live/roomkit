{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/an-adopted-call-waited-after-its-run-reads-its-answer",
  "title": "A deferred call an off-lock hook makes, waited once the run is over, reads its turn's end and its answer",
  "rules": [
    "§10.1 Explicit delivery cancellation",
    "§9.5.1 Reentrance",
    "§6.4 The turn's record",
    "§10.1 step 14"
  ],
  "requirements": [
    "RK-10.1-097",
    "RK-10.1-131",
    "RK-8.5-007"
  ],
  "notes": "Python: src/roomkit/models/delivery.py DeliveryHandle.wait and report_cascade, src/roomkit/core/mixins/inbound.py (a call a hook makes, adopted by the cascade whose hook made it, its handle told once that cascade read its streams) (RMK-1322, RMK-1329). The two turns run at once, so which one the model answers first, and which answer is stored first, is the scheduler's (RFC §10.1 step 14): the scenario names each answer by the message it answers, never by its text or its place (RMK-1762).",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "A1"
            },
            {
              "text": "A2"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "adopts",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "do": [
              {
                "call": "process_inbound",
                "room_id": "room-1",
                "message": {
                  "channel_id": "ws",
                  "sender_id": "alice",
                  "content": {
                    "type": "text",
                    "body": "side"
                  }
                },
                "defer_delivery": true,
                "as": "side"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "delivery.wait",
      "of": "side",
      "expect": {
        "result": {
          "response_metadata": {
            "turns": {
              "agent": {
                "loop_end_reason": "completed"
              }
            }
          },
          "response_events": [
            {
              "type": "message",
              "source": {
                "channel_id": "agent"
              },
              "responds_to": "room-1#0"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": {
        "$unordered": [
          {
            "id": "room-1#0",
            "content": {
              "body": "side"
            }
          },
          {
            "id": "room-1#1",
            "content": {
              "body": "hello"
            }
          },
          {
            "type": "message",
            "source": {
              "channel_id": "agent"
            },
            "responds_to": "room-1#0"
          },
          {
            "type": "message",
            "source": {
              "channel_id": "agent"
            },
            "responds_to": "room-1#1"
          }
        ]
      }
    }
  }
}
