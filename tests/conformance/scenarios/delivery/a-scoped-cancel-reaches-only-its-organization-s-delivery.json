            "when": {
              "text": "one"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to one"
                }
              }
            ]
          },
          {
            "when": {
              "text": "two"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
