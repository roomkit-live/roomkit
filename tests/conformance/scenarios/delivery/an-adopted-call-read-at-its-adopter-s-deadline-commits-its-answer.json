{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/an-adopted-call-read-at-its-adopter-s-deadline-commits-its-answer",
  "title": "An adopted call whose stream is read when its adopter's process_timeout passes still commits its answer",
  "rules": [
    "§9.5.1 Reentrance",
    "§13.6"
  ],
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true,
        "deliver_stream": [
          {
            "hold_after": "A1",
            "hold_gate": "reading"
          }
        ]
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "A1"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "adopts",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "do": [
              {
                "call": "process_inbound",
                "room_id": "room-1",
                "message": {
                  "channel_id": "ws",
                  "sender_id": "alice",
                  "content": {
                    "type": "text",
                    "body": "side"
                  }
                },
                "defer_delivery": true,
                "as": "side"
              },
              {
                "call": "delivery.wait",
                "of": "side"
              }
            ]
          }
        ],
        "timeout_ms": 5000
      }
    ],
    "kit": {
      "process_timeout_ms": 200
    }
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "background": true,
      "as": "h"
    },
    {
      "wait_for": "reading"
    },
    {
      "await": "h",
      "expect": {
        "result": {
          "blocked": true,
          "reason": "process_timeout",
          "event": null
        }
      }
    },
    {
      "open": "reading"
    },
    {
      "idle": true
    },
    {
      "call": "delivery.wait",
      "of": "side",
      "expect": {
        "result": {
          "response_metadata": {
            "turns": {
              "agent": {
                "loop_end_reason": "completed"
              }
            }
          },
          "response_events": [
            {
              "content": {
                "body": "A1"
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "side"
          }
        },
        {
          "content": {
            "body": "A1"
          }
        }
      ]
    }
  }
}
