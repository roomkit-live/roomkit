{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-named-organization-is-isolated-during-routing",
  "title": "A call names its organization before routing ends; another organization cannot cancel it",
  "rules": [
    "§10.1 Explicit delivery cancellation",
    "§17.2",
    "§10.1 step 2"
  ],
  "notes": "Python: tests/test_delivery_cancel_turns.py::test_a_scoped_cancel_before_the_commit_reaches_only_its_organization[named-other-organization or named-its-organization]. The call names org-1 before its router has returned; only org-1 can cancel it.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "room-1",
        "gate": "routing"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      },
      {
        "id": "ai",
        "type": "ai",
        "on_event": [
          {
            "when": {
              "text": "task A"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "answer to task A"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ],
        "organization_id": "org-1"
      }
    ],
    "hooks": [
      {
        "name": "broadcast",
        "trigger": "after_broadcast",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "task A"
        },
        "delivery_key": "t"
      },
      "background": true,
      "as": "a",
      "organization_id": "org-1"
    },
    {
      "wait_for": "routing"
    },
    {
      "call": "cancel_delivery",
      "key": "t",
      "reason": "stopped",
      "organization_id": "org-2",
      "expect": {
        "result": 0
      }
    },
    {
      "open": "routing"
    },
    {
      "await": "a",
      "expect": {
        "result": {
          "blocked": false,
          "cancellation_reason": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "task A"
          }
        },
        {
          "content": {
            "body": "answer to task A"
          }
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "body": "task A"
            }
          }
        ]
      }
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "task A"
            }
          },
          {
            "content": {
              "body": "answer to task A"
            }
          }
        ]
      }
    },
    "hooks": {
      "broadcast": {
        "$unordered": [
          {
            "trigger": "after_broadcast",
            "room_id": "room-1",
            "event": {
              "content": {
                "body": "task A"
              }
            }
          },
          {
            "trigger": "after_broadcast",
            "room_id": "room-1",
            "event": {
              "content": {
                "body": "answer to task A"
              }
            }
          }
        ]
      }
    }
  }
}
