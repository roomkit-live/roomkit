        "result": {
          "event": {
            "id": "room-2#1"
          }
        }
      }
    },
    {
      "call": "delivery.wait",
      "of": "whole_second",
      "expect": {
        "result": {
          "event": {
            "id": "room-2#1"
          },
          "response_events": [
            {
