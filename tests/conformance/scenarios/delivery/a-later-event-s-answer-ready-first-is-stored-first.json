{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-later-event-s-answer-ready-first-is-stored-first",
  "title": "A later event's answer ready while an earlier event's turn is held is stored first, at the next index",
  "rules": [
    "§10.1 step 14",
    "§10.1 step 18",
    "§10.2",
    "§6.4",
    "§12.10.4"
  ],
  "requirements": [
    "RK-10.1-085",
    "RK-10.1-086",
    "RK-10.2-011",
    "RK-8.5-007"
  ],
  "setup": {
    "channels": [
      {
        "id": "user",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "streamed",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "first answer",
              "gate": "first-1"
            },
            {
              "text": "second answer"
            }
          ]
        }
      },
      {
        "id": "whole",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "first answer",
              "whole_response": {},
              "gate": "first-2"
            },
            {
              "text": "second answer",
              "whole_response": {}
            }
          ]
        }
      },
      {
        "id": "generated",
        "type": "ai",
        "model": {
          "streaming": false,
          "rounds": [
            {
              "text": "first answer",
              "gate": "first-3"
            },
            {
              "text": "second answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "user"
          },
          {
            "channel_id": "streamed",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "user"
          },
          {
            "channel_id": "whole",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "room-3",
        "bindings": [
          {
            "channel_id": "user"
          },
          {
            "channel_id": "generated",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "user",
        "sender_id": "person",
        "content": {
          "type": "text",
          "body": "first task"
        }
      },
      "background": true,
      "as": "streamed_first"
    },
    {
      "wait_for": "first-1"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "user",
        "sender_id": "person",
        "content": {
          "type": "text",
          "body": "second task"
        }
      },
      "as": "streamed_second",
      "defer_delivery": true,
      "expect": {
        "result": {
          "event": {
            "id": "room-1#1"
          }
        }
      }
    },
    {
      "call": "delivery.wait",
      "of": "streamed_second",
      "expect": {
        "result": {
          "event": {
            "id": "room-1#1"
          },
          "response_events": [
            {
              "id": "room-1#2",
              "type": "message",
              "status": "delivered",
              "source": {
                "channel_id": "streamed"
              },
              "responds_to": "room-1#1",
              "content": {
                "type": "text",
                "body": "second answer"
              }
            }
          ]
        }
      }
    },
    {
      "open": "first-1"
    },
    {
      "await": "streamed_first",
      "expect": {
        "result": {
          "event": {
            "id": "room-1#0"
          },
          "response_events": [
            {
              "id": "room-1#3",
              "type": "message",
              "status": "delivered",
              "source": {
                "channel_id": "streamed"
              },
              "responds_to": "room-1#0",
              "content": {
                "type": "text",
                "body": "first answer"
              }
            }
          ]
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "user",
        "sender_id": "person",
        "content": {
          "type": "text",
          "body": "first task"
        }
      },
      "background": true,
      "as": "whole_first"
    },
    {
      "wait_for": "first-2"
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "user",
        "sender_id": "person",
        "content": {
          "type": "text",
          "body": "second task"
        }
