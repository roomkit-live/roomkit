              },
              "responds_to": "room-2#1",
              "content": {
                "type": "text",
                "body": "second answer"
              }
            }
          ]
        }
      }
    },
    {
      "open": "first-2"
    },
    {
      "await": "whole_first",
      "expect": {
        "result": {
          "event": {
            "id": "room-2#0"
          },
          "response_events": [
            {
              "id": "room-2#3",
              "type": "message",
              "status": "delivered",
              "source": {
                "channel_id": "whole"
              },
              "responds_to": "room-2#0",
              "content": {
                "type": "text",
                "body": "first answer"
              }
            }
          ]
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-3",
      "message": {
        "channel_id": "user",
        "sender_id": "person",
        "content": {
          "type": "text",
          "body": "first task"
        }
      },
      "background": true,
      "as": "generated_first"
    },
    {
      "wait_for": "first-3"
    },
    {
      "call": "process_inbound",
      "room_id": "room-3",
      "message": {
        "channel_id": "user",
        "sender_id": "person",
        "content": {
          "type": "text",
          "body": "second task"
        }
      },
      "as": "generated_second",
      "defer_delivery": true,
      "expect": {
        "result": {
          "event": {
            "id": "room-3#1"
          }
        }
      }
    },
    {
      "call": "delivery.wait",
      "of": "generated_second",
      "expect": {
        "result": {
          "event": {
            "id": "room-3#1"
          },
          "response_events": [
            {
              "id": "room-3#2",
              "type": "message",
              "status": "delivered",
              "source": {
                "channel_id": "generated"
              },
              "responds_to": "room-3#1",
              "content": {
                "type": "text",
                "body": "second answer"
              }
            }
          ]
        }
      }
    },
    {
      "open": "first-3"
    },
    {
      "await": "generated_first",
      "expect": {
        "result": {
          "event": {
            "id": "room-3#0"
          },
          "response_events": [
            {
              "id": "room-3#3",
              "type": "message",
              "status": "delivered",
              "source": {
                "channel_id": "generated"
              },
              "responds_to": "room-3#0",
              "content": {
                "type": "text",
                "body": "first answer"
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "id": "room-1#0",
          "content": {
