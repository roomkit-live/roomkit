{
  "$schema": "../../scenario.schema.json",
  "id": "channel-call/a-closed-kit-takes-no-calls",
  "title": "A closed kit refuses even a local channel call",
  "rules": [
    "§10.6.2",
    "§10.6.3"
  ],
  "notes": "Python: ChannelStateMixin.channel_call.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "verbs": {
          "keep": {
            "keeps": true
          },
          "read": {
            "reads": true
          },
          "forget": {
            "forgets": true,
            "reads": true
          },
          "answer": {
            "result": {
              "ok": true
            }
          },
          "nothing": {}
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "close"
    },
    {
      "call": "channel_call",
      "channel_id": "agent",
      "room_id": "r1",
      "verb": "read",
      "expect": {
        "error": "kit_closed"
      }
    }
  ],
  "expect": {}
}
