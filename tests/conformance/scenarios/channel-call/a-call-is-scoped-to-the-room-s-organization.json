{
  "$schema": "../../scenario.schema.json",
  "id": "channel-call/a-call-is-scoped-to-the-room-s-organization",
  "title": "A channel call checks the requested organization before running",
  "rules": [
    "§10.6.2",
    "§10.6.3"
  ],
  "notes": "Python: ChannelStateMixin.channel_call.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "verbs": {
          "keep": {
            "keeps": true
          },
          "read": {
            "reads": true
          },
          "forget": {
            "forgets": true,
            "reads": true
          },
          "answer": {
            "result": {
              "ok": true
            }
          },
          "nothing": {}
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "organization_id": "acme"
      }
    ]
  },
  "steps": [
    {
      "call": "channel_call",
      "channel_id": "agent",
      "room_id": "r1",
      "verb": "keep",
      "organization_id": "other",
      "arguments": {
        "mode": "leaked"
      },
      "expect": {
        "error": "room_not_found"
      }
    },
    {
      "call": "channel_call",
      "channel_id": "agent",
      "room_id": "r1",
      "verb": "read",
      "organization_id": "acme",
      "expect": {
        "result": {
          "mode": {
            "$absent": true
          }
        }
      }
    }
  ],
  "expect": {
    "rooms": {
      "r1": {
        "metadata": {
          "roomkit:channel_state:agent": {
            "$absent": true
          }
        }
      }
    }
  }
}
