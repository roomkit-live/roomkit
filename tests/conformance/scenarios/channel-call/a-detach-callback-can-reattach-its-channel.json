{
  "$schema": "../../scenario.schema.json",
  "id": "channel-call/a-detach-callback-can-reattach-its-channel",
  "title": "A detach callback can reattach its channel through the inherited room lock",
  "rules": [
    "§10.6.2",
    "§10.6.3"
  ],
  "notes": "Python: tests/test_channel_call_contract.py::test_detach_callback_can_reattach_its_channel.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "verbs": {
          "keep": {
            "keeps": true
          },
          "read": {
            "reads": true
          },
          "forget": {
            "forgets": true,
            "reads": true
          },
          "answer": {
            "result": {
              "ok": true
            }
          },
          "nothing": {}
        },
        "on_room_detached": [
          {
            "do": [
              {
                "call": "attach_channel",
                "room_id": "$room",
                "channel_id": "agent",
                "category": "intelligence"
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "channel_call",
      "channel_id": "agent",
      "room_id": "r1",
      "verb": "keep",
      "arguments": {
        "mode": "fast"
      }
    },
    {
      "call": "detach_channel",
      "room_id": "r1",
      "channel_id": "agent"
    }
  ],
  "expect": {
    "bindings": {
      "r1": {
        "agent": {
          "category": "intelligence"
        }
      }
    },
    "rooms": {
      "r1": {
        "metadata": {
          "roomkit:channel_state:agent": {
            "$absent": true
          }
        }
      }
    }
  }
}
