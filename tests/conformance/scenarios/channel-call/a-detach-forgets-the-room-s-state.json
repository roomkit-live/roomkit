{
  "$schema": "../../scenario.schema.json",
  "id": "channel-call/a-detach-forgets-the-room-s-state",
  "title": "A detach removes stored state before a reattachment",
  "rules": [
    "§10.6.2",
    "§10.6.3"
  ],
  "notes": "Python: tests/test_turns_channel_control.py::test_detaching_a_channel_forgets_what_the_room_kept_for_it.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "verbs": {
          "keep": {
            "keeps": true
          },
          "read": {
            "reads": true
          },
          "forget": {
            "forgets": true,
            "reads": true
          },
          "answer": {
            "result": {
              "ok": true
            }
          },
          "nothing": {}
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "channel_call",
      "channel_id": "agent",
      "room_id": "r1",
      "verb": "keep",
      "arguments": {
        "mode": "fast"
      }
    },
    {
      "call": "detach_channel",
      "channel_id": "agent",
      "room_id": "r1"
    },
    {
      "call": "attach_channel",
      "channel_id": "agent",
      "room_id": "r1",
      "category": "intelligence"
    },
    {
      "call": "channel_call",
      "channel_id": "agent",
      "room_id": "r1",
      "verb": "read",
      "expect": {
        "result": {
          "mode": {
            "$absent": true
          }
        }
      }
    }
  ],
  "expect": {
    "rooms": {
      "r1": {
        "metadata": {
          "roomkit:channel_state:agent": {
            "$absent": true
          }
        }
      }
    }
  }
}
