{
  "$schema": "../../scenario.schema.json",
  "id": "channel-call/a-late-call-does-not-restore-a-detached-binding",
  "title": "A call finishing after detach returns but stores no state",
  "rules": [
    "§10.6.2",
    "§10.6.3"
  ],
  "notes": "Python: tests/test_turns_channel_control.py::test_a_channel_call_across_a_detach_stores_nothing_with_the_room.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "verbs": {
          "keep": {
            "keeps": true,
            "gate": "entered"
          },
          "read": {
            "reads": true
          },
          "forget": {
            "forgets": true,
            "reads": true
          },
          "answer": {
            "result": {
              "ok": true
            }
          },
          "nothing": {}
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "channel_call",
      "channel_id": "agent",
      "room_id": "r1",
      "verb": "keep",
      "arguments": {
        "mode": "fast"
      },
      "background": true,
      "as": "pending"
    },
    {
      "wait_for": "entered"
    },
    {
      "call": "detach_channel",
      "room_id": "r1",
      "channel_id": "agent"
    },
    {
      "open": "entered"
    },
    {
      "await": "pending",
      "expect": {
        "result": {
          "mode": "fast"
        }
      }
    }
  ],
  "expect": {
    "rooms": {
      "r1": {
        "metadata": {
          "roomkit:channel_state:agent": {
            "$absent": true
          }
        }
      }
    }
  }
}
