{
  "$schema": "../../scenario.schema.json",
  "id": "channel-call/a-concurrent-call-restores-initial-state-on-failure",
  "title": "A concurrent call reports restoring its initial state on failure",
  "rules": [
    "§10.6.2",
    "§10.6.3"
  ],
  "notes": "Python: tests/test_turns_channel_call_state.py::test_a_call_reports_restoring_the_state_a_concurrent_call_changed. The restore gate is inside the actual channel verb, after the executor has read its initial state. The intervening setter is awaited through the owner so its state is stored before the restore is released. This checks overlapping state comparisons, not reordered or lost backend replies.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "category": "intelligence",
        "verbs": {
          "keep": {
            "keeps": true
          },
          "read": {
            "reads": true
          },
          "forget": {
            "forgets": true,
            "reads": true
          },
          "answer": {
            "result": {
              "ok": true
            }
          },
          "nothing": {},
          "restore": {
            "gate": "restoring",
            "keeps": true,
            "fail": "failed after restoring"
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "channel_call",
      "channel_id": "agent",
      "room_id": "r1",
      "verb": "keep",
      "arguments": {
        "model": "opus"
      }
    },
    {
      "call": "channel_call",
      "channel_id": "agent",
      "room_id": "r1",
      "verb": "restore",
      "arguments": {
        "model": "opus"
      },
      "background": true,
      "as": "restoring"
    },
    {
      "wait_for": "restoring"
    },
    {
      "call": "channel_call",
      "channel_id": "agent",
      "room_id": "r1",
      "verb": "keep",
      "arguments": {
        "model": "sonnet"
      }
    },
    {
      "call": "get_room",
      "room_id": "r1",
      "expect": {
        "result": {
          "metadata": {
            "roomkit:channel_state:agent": {
              "model": "sonnet"
            }
          }
        }
      }
    },
    {
      "open": "restoring"
    },
    {
      "await": "restoring",
      "expect": {
        "error": "channel_failed"
      }
    },
    {
      "call": "channel_call",
      "channel_id": "agent",
      "room_id": "r1",
      "verb": "read",
      "arguments": {},
      "expect": {
        "result": {
          "model": "opus"
        }
      }
    }
  ],
  "expect": {
    "rooms": {
      "r1": {
        "metadata": {
          "roomkit:channel_state:agent": {
            "model": "opus"
          }
        }
      }
    }
  }
}
