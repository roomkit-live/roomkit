{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-delegated-turn-s-shared-answer-follows-its-metadata-updates",
  "title": "A delegated turn whose child room a transport is shared into commits its answer as a room's once its metadata updates are written: while another call holds the room's lock, the answer waits behind the write, and a hook on the answer reads the updates the agent returned",
  "rules": [
    "§23.3 step 5",
    "§10.1 step 15",
    "§13.5"
  ],
  "notes": "Python: core/mixins/_child_execution.py _broadcast_and_collect stores the broadcast's side effects (_persist_side_effects: tasks, observations, then _write_metadata_updates under the room's lock) before _answer_of_broadcast commits the answer, by the room's path when a transport is shared (_deliver_answer). A call into the child room holds the lock while the worker answers: the metadata write waits for it, and the answer's pass, whose before_broadcast hook reads the room, comes after the write. RMK-1521.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "Look it up."
            },
            "gate": "worker",
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Found it."
                }
              }
            ],
            "output": {
              "tasks": [
                {
                  "title": "Call the customer back"
                }
              ],
              "metadata_updates": {
                "stage": "qualified"
              }
            }
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "parent",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "hold",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "Call me"
            },
            "gate": "held",
            "do": [
              {
                "call": "update_room_metadata",
                "room_id": "$room",
                "metadata": {
                  "stage": "callback"
                },
                "as": "meta"
              }
            ]
          }
        ]
      },
      {
        "name": "read",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "Found it."
            },
            "do": [
              {
                "call": "store.get_room",
                "room_id": "$room",
                "as": "room"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Look it up.",
      "as": "t",
      "share_channels": [
        "sms"
      ]
    },
    {
      "wait_for": "worker"
    },
    {
      "call": "send_event",
      "room_id": "$r1",
      "channel_id": "worker",
      "content": {
        "type": "text",
        "body": "Call me"
      },
      "background": true,
      "as": "call"
    },
    {
      "wait_for": "held"
    },
    {
      "open": "worker"
    },
    {
      "wait_for_lock": "$r1",
      "waiters": 1
    },
    {
      "open": "held"
    },
    {
      "await": "call",
      "expect": {
        "result": {
          "content": {
            "type": "text",
            "body": "Call me"
          }
        }
      }
    },
    {
      "call": "task.wait",
      "task_id": "$t",
      "expect": {
        "result": {
          "status": "completed",
          "output": "Found it."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "rooms": {
      "$r1": {
        "metadata": {
          "stage": "qualified"
        }
      }
    },
    "actions": {
      "meta": [
        {
          "result": {
            "metadata": {
              "stage": "callback"
            }
          }
        }
      ],
      "room": [
        {
          "result": {
            "metadata": {
              "stage": "qualified"
            }
          }
        }
      ]
    }
  }
}
