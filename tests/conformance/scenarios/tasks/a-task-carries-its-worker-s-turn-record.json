{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-task-carries-its-worker-s-turn-record",
  "title": "A task carries its worker's turn record under turns, keyed by the agent: how its turn ended and what it used, inline or in the background, whether a transport is shared into the child room or not",
  "rules": [
    "§23.3 step 6",
    "§6.4"
  ],
  "notes": "Python: tests/tasks/test_task_turn_record.py::test_a_task_carries_its_workers_turn; core/mixins/_child_execution.py (the turn's record under turns), tasks/models.py finished_task_fields. Inline then in the background, each on the trace then with email shared. A scripted model has one provider path: Python's buffered/stream parameter is not varied. DelegatedTaskResult.exception is never serialized: Python's exception None is not read here.",
  "setup": {
    "channels": [
      {
        "id": "email",
        "type": "email",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Done.",
              "usage": {
                "input_tokens": 4,
                "output_tokens": 2
              }
            },
            {
              "text": "Done.",
              "usage": {
                "input_tokens": 4,
                "output_tokens": 2
              }
            },
            {
              "text": "Done.",
              "usage": {
                "input_tokens": 4,
                "output_tokens": 2
              }
            },
            {
              "text": "Done.",
              "usage": {
                "input_tokens": 4,
                "output_tokens": 2
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "parent",
        "bindings": [
          {
            "channel_id": "email"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Find it.",
      "wait": true,
      "expect": {
        "result": {
          "status": "completed",
          "result": {
            "status": "completed",
            "output": "Done.",
            "error": null,
            "metadata": {
              "turns": {
                "worker": {
                  "loop_end_reason": "completed",
                  "ai_usage": {
                    "output_tokens": 2
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Find it.",
      "share_channels": [
        "email"
      ],
      "wait": true,
      "expect": {
        "result": {
          "status": "completed",
          "result": {
            "status": "completed",
            "output": "Done.",
            "error": null,
            "metadata": {
              "turns": {
                "worker": {
                  "loop_end_reason": "completed",
                  "ai_usage": {
                    "output_tokens": 2
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Find it.",
      "as": "b"
    },
    {
      "call": "task.wait",
      "task_id": "$b",
      "expect": {
        "result": {
          "status": "completed",
          "output": "Done.",
          "error": null,
          "metadata": {
            "turns": {
              "worker": {
                "loop_end_reason": "completed",
                "ai_usage": {
                  "output_tokens": 2
                }
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Find it.",
      "as": "s",
      "share_channels": [
        "email"
      ]
    },
    {
      "call": "task.wait",
      "task_id": "$s",
      "expect": {
        "result": {
          "status": "completed",
          "output": "Done.",
          "error": null,
          "metadata": {
            "turns": {
              "worker": {
                "loop_end_reason": "completed",
                "ai_usage": {
                  "output_tokens": 2
                }
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ]
}
