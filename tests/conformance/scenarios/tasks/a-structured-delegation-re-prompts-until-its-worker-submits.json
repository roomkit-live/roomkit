{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-structured-delegation-re-prompts-until-its-worker-submits",
  "title": "A delegation that requires a structured result re-prompts its worker with the result tool's reminder when a turn ends without submit_result, and its output is the submitted payload, normalized",
  "rules": [
    "§23.3"
  ],
  "notes": "Python: tests/tasks/test_structured_result.py::TestStructuredResultGuard::test_reprompts_until_worker_submits, test_returns_structured_payload_when_worker_submits; core/mixins/_child_execution.py _run_with_structured_result, _scan_for_submitted_result; orchestration/result.py SUBMIT_RESULT, normalize_result. The tool answers the call {\"status\": \"received\"}; the payload is read from the worker's served call in the child room's trace. A turn that ends without the call is answered with the result tool's reminder, a message of the child room the worker reads as the user's (orchestration/result.py SUBMIT_RESULT.reminder).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Here is what I found."
            },
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "submit_result",
                  "arguments": {
                    "status": "completed",
                    "summary": "Found it.",
                    "data": {
                      "x": 1
                    }
                  }
                }
              ]
            },
            {
              "text": "Submitted."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "room-1",
      "agent_id": "worker",
      "task": "Look it up.",
      "wait": true,
      "require_structured_result": true,
      "max_result_retries": 3,
      "expect": {
        "result": {
          "status": "completed",
          "result": {
            "status": "completed",
            "output": "{\"status\": \"completed\", \"summary\": \"Found it.\", \"data\": {\"x\": 1}, \"deliverables\": [], \"reason\": \"\"}",
            "error": null
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "worker": [
        {
          "tool_results": []
        },
        {
          "tool_results": [],
          "messages": [
            {
              "role": "user",
              "text": "Look it up.",
              "parts": null
            },
            {
              "role": "assistant",
              "text": "Here is what I found.",
              "parts": null
            },
            {
              "role": "user",
              "text": "You did not submit a result. You MUST now call the `submit_result` tool with your final structured result. Do NOT reply with plain text or a question — call submit_result.",
              "parts": null
            }
          ]
        },
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": "{\"status\": \"received\"}"
            }
          ]
        }
      ]
    }
  }
}
