{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-shared-transport-is-told-the-answer-the-room-s-hooks-left",
  "title": "With a transport shared into a delegated room, a BEFORE_BROADCAST hook's rewrite of the agent's answer is what the transport is delivered, what the room stores, and the task's output",
  "rules": [
    "§23.3 step 5",
    "§23.3 step 6",
    "§9.4"
  ],
  "notes": "Python: tests/tasks/test_shared_transport_delegation.py::TestASharedTransportIsToldTheAnswer::test_the_answer_crosses_the_rooms_hooks; core/mixins/_child_execution.py _deliver_answer, _answer_of: the answer is the last one the room kept of the delegated agent.",
  "setup": {
    "channels": [
      {
        "id": "email",
        "type": "email",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "Summarise the ticket and email the customer."
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Call me at 555-0100."
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "parent",
        "bindings": [
          {
            "channel_id": "email"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "redact",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "Call me at 555-0100."
            },
            "result": {
              "action": "modify",
              "event": {
                "content": {
                  "type": "text",
                  "body": "Call me at [phone]."
                }
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Summarise the ticket and email the customer.",
      "share_channels": [
        "email"
      ],
      "wait": true,
      "expect": {
        "result": {
          "status": "completed",
          "result": {
            "status": "completed",
            "output": "Call me at [phone].",
            "error": null
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "$r1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "system",
            "channel_type": "system"
          },
          "visibility": "intelligence",
          "status": "delivered",
          "chain_depth": 0,
          "content": {
            "type": "text",
            "body": "Summarise the ticket and email the customer."
          }
        },
        {
          "index": 1,
          "type": "message",
          "source": {
            "channel_id": "worker"
          },
          "status": "delivered",
          "chain_depth": 1,
          "responds_to": "$r1#0",
          "content": {
            "type": "text",
            "body": "Call me at [phone]."
          }
        }
      ]
    },
    "deliveries": {
      "$r1": {
        "email": [
          {
            "type": "message",
            "source": {
              "channel_id": "worker"
            },
            "content": {
              "type": "text",
              "body": "Call me at [phone]."
            }
          }
        ]
      }
    },
    "rooms": {
      "$r1": {
        "metadata": {
          "task_status": "completed",
          "task_result": "Call me at [phone]."
        }
      }
    }
  }
}
