{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-task-s-context-never-says-how-its-turn-ended",
  "title": "A task's context never stands for how its worker's turn ended: a context that sets loop_end_reason, error_reported or turns, from a model's delegate_task call or a host's delegate, leaves a completed task naming no end, no report and only its worker's own turn record",
  "rules": [
    "§23.3 step 6",
    "§23.4"
  ],
  "requirements": [
    "RK-23.3-001"
  ],
  "notes": "Security finding RK-23.3-001 (card RMK-1418, item 2; audit RMK-1894): the result's metadata was built from the context first, so a model could write a task's end. Step 6 says the task's metadata carries how the turn ended (loop_end_reason), whether its failure was reported (error_reported) and the turn's record (turns): those are the framework's, and win over the context. Whether the rest of the context reaches the result's metadata is not asserted: the RFC does not say.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Done."
            },
            {
              "text": "Done."
            }
          ]
        }
      },
      {
        "id": "assistant",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_task",
                  "arguments": {
                    "agent": "worker",
                    "task": "Check it.",
                    "context": {
                      "ticket": "T-1",
                      "loop_end_reason": "max_rounds",
                      "error_reported": true,
                      "turns": {
                        "worker": {
                          "loop_end_reason": "max_rounds"
                        },
                        "ghost": {
                          "loop_end_reason": "completed"
                        }
                      }
                    }
                  }
                }
              ]
            },
            {
              "text": "On it."
            },
            {
              "text": "Checked."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "assistant"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "done",
        "trigger": "on_task_completed",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "delegate_handler",
      "handler": "tool"
    },
    {
      "call": "setup_delegation",
      "agent_id": "assistant",
      "handler": "tool"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Check it, please."
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "delegate",
      "room_id": "room-1",
      "agent_id": "worker",
      "task": "Check it again.",
      "context": {
        "ticket": "T-1",
        "loop_end_reason": "max_rounds",
        "error_reported": true,
        "turns": {
          "worker": {
            "loop_end_reason": "max_rounds"
          },
          "ghost": {
            "loop_end_reason": "completed"
          }
        }
      },
      "wait": true,
      "expect": {
        "result": {
          "status": "completed",
          "result": {
            "status": "completed",
            "output": "Done.",
            "error": null,
            "metadata": {
              "loop_end_reason": {
                "$absent": true
              },
              "error_reported": {
                "$absent": true
              },
              "turns": {
                "worker": {
                  "loop_end_reason": "completed"
                },
                "ghost": {
                  "$absent": true
                }
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "done": [
        {
          "trigger": "on_task_completed",
          "room_id": "room-1",
          "event": {
            "type": "task_completed",
            "metadata": {
              "agent_id": "worker",
              "task_status": "completed",
              "loop_end_reason": {
                "$absent": true
              }
            }
          }
        },
        {
          "trigger": "on_task_completed",
          "room_id": "room-1",
          "event": {
            "type": "task_completed",
            "metadata": {
              "agent_id": "worker",
              "task_status": "completed",
              "loop_end_reason": {
                "$absent": true
              }
            }
          }
        }
      ]
    }
  }
}
