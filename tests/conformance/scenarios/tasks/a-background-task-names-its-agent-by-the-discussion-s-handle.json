{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-background-task-names-its-agent-by-the-discussion-s-handle",
  "title": "In a room held by a discussion, an agent's background task names the agent by its handle, not its channel id: in the work_in_background tool's answer and in the brief start_task gives its worker",
  "rules": [
    "§23.4",
    "§19.7.5 rule 4"
  ],
  "notes": "Python: tasks/background.py start_background_task (worker_brief with agent_handle(room.metadata, agent_id)) and background_tool_server (identifier(agent_handle(...), 'agent')). The channel dev has the handle ops. Both tasks post their results as the agent's message, so that no hand-back turn of the agent is waited for.",
  "setup": {
    "channels": [
      {
        "id": "phone",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "dev",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "work_in_background",
                  "arguments": {
                    "task": "Count the tickets."
                  }
                }
              ]
            },
            {
              "text": "On it."
            }
          ]
        }
      },
      {
        "id": "helper",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Findings."
            },
            {
              "text": "More."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "call",
        "bindings": [
          {
            "channel_id": "phone"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "dev"
          ],
          "handles": {
            "dev": "ops"
          }
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "call",
      "strategy": "d"
    },
    {
      "call": "setup_background",
      "agent_id": "dev",
      "worker": "helper",
      "hand_back": "post"
    },
    {
      "call": "process_inbound",
      "room_id": "call",
      "message": {
        "channel_id": "phone",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "@ops count the tickets"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "start_task",
      "room_id": "call",
      "agent_id": "dev",
      "task": "Count again.",
      "hand_back": "post",
      "expect": {
        "result": {
          "agent_id": "helper",
          "description": {
            "$contains": "You are doing this task in the background for @ops, away from the conversation"
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "dev": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "content": {
                "$contains": "its result is posted as ops's message"
              }
            }
          ]
        }
      ]
    }
  }
}
