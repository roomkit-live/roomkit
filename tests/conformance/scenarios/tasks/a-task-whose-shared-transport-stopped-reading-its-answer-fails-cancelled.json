{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-task-whose-shared-transport-stopped-reading-its-answer-fails-cancelled",
  "title": "A delegated turn whose answer a streaming transport shared into the child room stopped reading ends cancelled: its task fails, its metadata naming the end cancelled",
  "rules": [
    "§23.3 step 6",
    "§12.2 step 13s",
    "§6.4"
  ],
  "notes": "Python: tests/tasks/test_stopped_stream_turn_end.py::test_a_delegated_turn_its_transport_stopped_fails_cancelled[after-text] (while-thinking: tasks/a-task-whose-shared-transport-stopped-reading-while-its-model-reasoned-fails-cancelled; acp-finished needs an ACP agent). ws stops reading after the answer's second delta, as a barge-in does.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true,
        "deliver_stream": [
          {
            "stop_after": "answer "
          }
        ]
      },
      {
        "id": "worker",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "deltas": [
                "The ",
                "answer ",
                "is 42."
              ]
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "parent",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Answer.",
      "share_channels": [
        "ws"
      ],
      "wait": true,
      "expect": {
        "result": {
          "status": "failed",
          "result": {
            "status": "failed",
            "metadata": {
              "loop_end_reason": "cancelled"
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ]
}
