{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/delegate-task-offers-the-conversation-on-the-host-s-option-alone",
  "title": "With no max_conversation, delegate_task has no conversation argument and a model that sends one hands nothing over; with one, the tool declares it, bounded, and the handler holds any call to that bound: a value above it reads as the bound; a negative one or a non-integer as none",
  "rules": [
    "§23.4",
    "§23.3 step 4",
    "§7.5"
  ],
  "notes": "Python: tests/tasks/test_delegate.py; tasks/delegate.py DelegateHandler, setup_delegation. An integer is JSON Schema's: 1.0 is one, 1.5 and \"1\" are not, nor is a boolean.",
  "setup": {
    "channels": [
      {
        "id": "phone",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "source_channel_id": "system",
              "type": "message"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Done."
                }
              }
            ],
            "repeat": true
          }
        ]
      },
      {
        "id": "closed",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_task",
                  "arguments": {
                    "agent": "worker",
                    "task": "Summarise.",
                    "conversation": 8
                  }
                }
              ]
            },
            {
              "text": "On it."
            },
            {
              "text": "Done."
            }
          ]
        }
      },
      {
        "id": "open",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_task",
                  "arguments": {
                    "agent": "worker",
                    "task": "Summarise.",
                    "conversation": 8
                  }
                }
              ]
            },
            {
              "text": "On it."
            },
            {
              "text": "Done."
            }
          ]
        }
      },
      {
        "id": "direct",
        "type": "ai",
        "category": "intelligence"
      }
    ],
    "rooms": [
      {
        "id": "room-closed",
        "bindings": [
          {
            "channel_id": "phone"
          },
          {
            "channel_id": "closed"
          }
        ]
      },
      {
        "id": "room-open",
        "bindings": [
          {
            "channel_id": "phone"
          },
          {
            "channel_id": "open"
          }
        ]
      },
      {
        "id": "room-direct",
        "bindings": [
          {
            "channel_id": "phone"
          },
          {
            "channel_id": "direct"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "answers",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "delegate_handler",
      "handler": "off"
    },
    {
      "call": "setup_delegation",
      "agent_id": "closed",
      "handler": "off"
    },
    {
      "call": "delegate_handler",
      "handler": "bounded",
      "max_conversation": 2
    },
    {
      "call": "setup_delegation",
      "agent_id": "open",
      "handler": "bounded"
    },
    {
      "call": "send_event",
      "room_id": "room-closed",
      "channel_id": "phone",
      "content": {
        "type": "text",
        "body": "first"
      },
      "addressed_to": []
    },
    {
      "call": "send_event",
      "room_id": "room-closed",
      "channel_id": "phone",
      "content": {
        "type": "text",
        "body": "second"
      },
      "addressed_to": []
    },
    {
      "call": "send_event",
      "room_id": "room-open",
      "channel_id": "phone",
      "content": {
        "type": "text",
        "body": "first"
      },
      "addressed_to": []
    },
    {
      "call": "send_event",
      "room_id": "room-open",
      "channel_id": "phone",
      "content": {
        "type": "text",
        "body": "second"
      },
      "addressed_to": []
    },
    {
      "call": "process_inbound",
      "room_id": "room-closed",
      "message": {
        "channel_id": "phone",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "third"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-open",
      "message": {
        "channel_id": "phone",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "third"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "send_event",
      "room_id": "room-direct",
      "channel_id": "phone",
      "content": {
        "type": "text",
        "body": "first"
      },
      "addressed_to": []
    },
    {
      "call": "send_event",
      "room_id": "room-direct",
      "channel_id": "phone",
      "content": {
        "type": "text",
        "body": "second"
      },
      "addressed_to": []
    },
    {
      "call": "send_event",
      "room_id": "room-direct",
      "channel_id": "phone",
      "content": {
        "type": "text",
        "body": "third"
      },
      "addressed_to": []
    },
    {
      "call": "delegate.handle",
      "handler": "bounded",
      "room_id": "room-direct",
      "calling_agent_id": "direct",
      "arguments": {
        "agent": "worker",
        "task": "Above.",
        "conversation": 1000000000000000000000
      },
      "expect": {
        "result": {
          "status": "delegated",
          "agent_id": "worker",
          "from_cache": {
            "$absent": true
          }
        }
      }
    },
    {
      "call": "delegate.handle",
      "handler": "bounded",
      "room_id": "room-direct",
      "calling_agent_id": "direct",
      "arguments": {
        "agent": "worker",
        "task": "One.",
        "conversation": 1
      },
      "expect": {
        "result": {
          "status": "delegated",
          "agent_id": "worker",
          "from_cache": {
            "$absent": true
          }
        }
      }
    },
    {
      "call": "delegate.handle",
      "handler": "bounded",
      "room_id": "room-direct",
      "calling_agent_id": "direct",
      "arguments": {
        "agent": "worker",
        "task": "One as a float.",
        "conversation": 1.0
      },
      "expect": {
        "result": {
          "status": "delegated",
          "agent_id": "worker",
