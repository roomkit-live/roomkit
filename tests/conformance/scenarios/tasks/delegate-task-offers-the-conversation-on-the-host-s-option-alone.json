      "room_id": "room-direct",
      "calling_agent_id": "direct",
      "arguments": {
        "agent": "worker",
        "task": "Negative.",
        "conversation": -1
      },
      "expect": {
        "result": {
          "status": "delegated",
          "agent_id": "worker",
          "from_cache": {
            "$absent": true
