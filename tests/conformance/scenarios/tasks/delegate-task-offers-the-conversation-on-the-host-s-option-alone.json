    },
    {
      "call": "delegate.handle",
      "handler": "bounded",
      "room_id": "room-direct",
      "calling_agent_id": "direct",
      "arguments": {
        "agent": "worker",
        "task": "Zero.",
        "conversation": 0
      },
      "expect": {
        "result": {
          "status": "delegated",
          "agent_id": "worker",
          "from_cache": {
            "$absent": true
          }
        }
      }
    },
    {
      "call": "delegate.handle",
      "handler": "bounded",
      "room_id": "room-direct",
      "calling_agent_id": "direct",
      "arguments": {
        "agent": "worker",
        "task": "Fraction.",
        "conversation": 1.5
      },
      "expect": {
        "result": {
          "status": "delegated",
          "agent_id": "worker",
          "from_cache": {
            "$absent": true
          }
        }
      }
    },
    {
      "call": "delegate.handle",
      "handler": "bounded",
      "room_id": "room-direct",
      "calling_agent_id": "direct",
      "arguments": {
        "agent": "worker",
        "task": "String.",
        "conversation": "2"
      },
      "expect": {
        "result": {
          "status": "delegated",
          "agent_id": "worker",
          "from_cache": {
            "$absent": true
          }
        }
      }
    },
    {
      "call": "delegate.handle",
      "handler": "bounded",
      "room_id": "room-direct",
      "calling_agent_id": "direct",
      "arguments": {
        "agent": "worker",
        "task": "Boolean.",
        "conversation": true
      },
      "expect": {
        "result": {
          "status": "delegated",
          "agent_id": "worker",
          "from_cache": {
            "$absent": true
          }
        }
      }
    },
    {
      "call": "delegate.handle",
      "handler": "bounded",
      "room_id": "room-direct",
      "calling_agent_id": "direct",
      "arguments": {
        "agent": "worker",
        "task": "Null.",
        "conversation": null
      },
      "expect": {
        "result": {
          "status": "delegated",
          "agent_id": "worker",
          "from_cache": {
            "$absent": true
          }
        }
      }
    },
    {
      "call": "delegate.handle",
      "handler": "bounded",
      "room_id": "room-direct",
      "calling_agent_id": "direct",
