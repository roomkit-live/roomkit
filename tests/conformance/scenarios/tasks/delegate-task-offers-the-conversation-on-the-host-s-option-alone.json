    {
      "call": "delegate.handle",
      "handler": "off",
      "room_id": "room-direct",
      "calling_agent_id": "direct",
      "arguments": {
        "agent": "worker",
        "task": "Off.",
        "conversation": 2
      },
      "expect": {
        "result": {
          "status": "delegated",
          "agent_id": "worker",
          "from_cache": {
            "$absent": true
