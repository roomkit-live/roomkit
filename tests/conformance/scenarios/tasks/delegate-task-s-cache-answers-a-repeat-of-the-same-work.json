        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "source_channel_id": "system",
              "text": "Breaks."
            },
            "fail": "worker failed"
          },
          {
            "when": {
              "source_channel_id": "system",
              "text": "Held."
            },
            "gate": "held"
          },
