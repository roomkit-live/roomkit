{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-handler-serialized-per-room-delegates-a-room-s-calls-one-at-a-time",
  "title": "With serialize_per_room, a handler delegates a room's calls one at a time: a second call of the room starts its delegation only once the first's is made, while a call of another room is delegated meanwhile",
  "rules": [
    "§23.4"
  ],
  "requirements": [
    "RK-23.4-035"
  ],
  "notes": "The first call's delegation holds at the attach of the transport it shares into its child room, the child room made. The room's second call waits for it; the call of another room is delegated at once, its child room the second the run makes. The room's second call makes its child room last, once the first's delegation is done. Rooms the run makes are named in the order of their creation. Python: tasks/delegate.py DelegateHandler (_room_turn); roomkit-rs: tasks/delegate.rs (room_turns).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport",
        "on_room_attached": [
          {
            "when": {
              "room_id": "room-1"
            }
          },
          {
            "when": {
              "room_id": "room-2"
            }
          },
          {
            "gate": "held"
          }
        ]
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "source_channel_id": "system",
              "type": "message"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Done."
                }
              }
            ],
            "repeat": true
          }
        ]
      },
      {
        "id": "lead",
        "type": "ai",
        "category": "intelligence"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate_handler",
      "handler": "tool",
      "serialize_per_room": true,
      "default_share_channels": [
        "sms"
      ]
    },
    {
      "call": "delegate.handle",
      "handler": "tool",
      "room_id": "room-1",
      "calling_agent_id": "lead",
      "arguments": {
        "agent": "worker",
        "task": "First."
      },
      "background": true,
      "as": "first"
    },
    {
      "wait_for": "held"
    },
    {
      "call": "delegate.handle",
      "handler": "tool",
      "room_id": "room-1",
      "calling_agent_id": "lead",
      "arguments": {
        "agent": "worker",
        "task": "Second."
      },
      "background": true,
      "as": "second"
    },
    {
      "call": "delegate.handle",
      "handler": "tool",
      "room_id": "room-2",
      "calling_agent_id": "lead",
      "arguments": {
        "agent": "worker",
        "task": "Elsewhere."
      },
      "expect": {
        "result": {
          "status": "delegated",
          "child_room_id": "$r2"
        }
      }
    },
    {
      "open": "held"
    },
    {
      "await": "first",
      "expect": {
        "result": {
          "status": "delegated",
          "child_room_id": "$r1"
        }
      }
    },
    {
      "await": "second",
      "expect": {
        "result": {
          "status": "delegated",
          "child_room_id": "$r3"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "rooms": {
      "$r1": {
        "metadata": {
          "task_input": "First.",
          "parent_room_id": "room-1"
        }
      },
      "$r2": {
        "metadata": {
          "task_input": "Elsewhere.",
          "parent_room_id": "room-2"
        }
      },
      "$r3": {
        "metadata": {
          "task_input": "Second.",
          "parent_room_id": "room-1"
        }
      }
    }
  }
}
