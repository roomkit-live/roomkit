{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-delegation-outside-a-turn-opens-a-chain-at-depth-0",
  "title": "A delegation the host makes outside any turn hands its result back at depth 0, as a person's message is: the cycle the notified agent starts from there still ends at max_chain_depth, its answers at depths 1 and 2",
  "rules": [
    "§23.3 step 8",
    "§8.3"
  ],
  "notes": "Python: tests/tasks/test_delegation_chain_depth.py::test_a_delegation_outside_a_tool_call_opens_a_chain; core/mixins/delegation.py delegate (no turn above it: depth 0); core/_turn_host.py _delegate (setup_delegation's delegate_task tool in Python's test, the turn's host here: both delegate from the turn), tasks/handback.py hand_back: the result handed back is an instruction at the depth of the answer whose turn delegated (never stored, RMK-310), and front's turn on the one at depth 2 is not asked, its answer at the limit stored BLOCKED (§8.3). A result can come back before the turn that delegated it committed its answer, so front's rows are matched in any order.",
  "setup": {
    "kit": {
      "max_chain_depth": 3
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "repeat": true,
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "found"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "front",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "repeat": true,
            "do": [
              {
                "call": "host.delegate",
                "room_id": "room-1",
                "agent_id": "worker",
                "task": "X",
                "notify": "front"
              }
            ],
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "delegated"
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "front"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "room-1",
      "agent_id": "worker",
      "task": "Look it up.",
      "notify": "front",
      "as": "t"
    },
    {
      "call": "task.wait",
      "task_id": "$t",
      "expect": {
        "result": {
          "status": "completed"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": {
        "$unordered": [
          {
            "type": "message",
            "status": "delivered",
            "source": {
              "channel_id": "front"
            },
            "chain_depth": 1,
            "content": {
              "type": "text",
              "body": "delegated"
            }
          },
          {
            "type": "message",
            "status": "delivered",
            "source": {
              "channel_id": "front"
            },
            "chain_depth": 2,
            "content": {
              "type": "text",
              "body": "delegated"
            }
          },
          {
            "status": "blocked",
            "blocked_by": "event_chain_depth_limit",
            "source": {
              "channel_id": "front"
            },
            "chain_depth": 3
          }
        ]
      }
    },
    "turns": {
      "room-1": {
        "front": [
          {
            "type": "instruction",
            "chain_depth": 0,
            "metadata": {
              "agent_id": "worker",
              "task": "Look it up."
            }
          },
          {
            "type": "instruction",
            "chain_depth": 1,
            "metadata": {
              "task": "X"
            }
          }
        ]
      }
    },
    "rooms": {
      "$r1": {
        "metadata": {
          "parent_room_id": "room-1"
        }
      },
      "$r2": {
        "metadata": {
          "parent_room_id": "room-1"
        }
      },
      "$r3": {
        "metadata": {
          "parent_room_id": "room-1"
        }
      },
      "$r4": null
    }
  }
}
