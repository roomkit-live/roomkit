{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-result-submitted-before-the-worker-s-failure-still-counts",
  "title": "A structured delegation whose worker submits its result, then fails on the next generation, completes with the submitted payload, normalized",
  "rules": [
    "§23.3"
  ],
  "notes": "Python: tests/tasks/test_failed_worker_turn.py::test_a_result_submitted_before_the_failure_still_counts; core/mixins/_child_execution.py _run_with_structured_result, _scan_for_submitted_result (the served call in the child room's trace counts whatever the turn's end).",
  "setup": {
    "channels": [
      {
        "id": "worker",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Submitting.",
              "calls": [
                {
                  "id": "s1",
                  "name": "submit_result",
                  "arguments": {
                    "status": "completed",
                    "summary": "found it",
                    "data": {}
                  }
                }
              ]
            },
            {
              "refuses": {
                "status": 529,
                "message": "overloaded 529"
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "parent"
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Find it.",
      "wait": true,
      "require_structured_result": true,
      "expect": {
        "result": {
          "status": "completed",
          "result": {
            "status": "completed",
            "output": "{\"status\": \"completed\", \"summary\": \"found it\", \"data\": {}, \"deliverables\": [], \"reason\": \"\"}",
            "error": null
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {}
}
