            "when": {
              "source_channel_id": "system",
              "type": "message"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Done."
                }
              }
            ],
            "repeat": true
          }
        ]
      },
      {
        "id": "assistant",
        "type": "ai",
        "category": "intelligence"
      },
