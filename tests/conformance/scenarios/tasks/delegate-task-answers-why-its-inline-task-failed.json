{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/delegate-task-answers-why-its-inline-task-failed",
  "title": "A delegate_task call that runs its task inline answers its model with why a task that failed did not complete, by the code and the words task_status gives, beside its status and before an empty result",
  "rules": [
    "§23.4",
    "§23.3 step 6"
  ],
  "requirements": [
    "RK-23.3-028",
    "RK-23.3-116",
    "RK-23.4-025",
    "RK-23.4-069"
  ],
  "notes": "Python: tasks/delegate.py _call_answer and _why_not_completed (tasks/models.py task_end_reason, models/task.py TASK_END_WORDS). With the handler's wait_in_task_rooms, the researcher's call from its task's room runs the digger's task inline: capped at one round, the digger's turn ends max_rounds, and the researcher's model reads it in the call's answer.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "front",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "delegate_task",
                  "arguments": {
                    "agent": "researcher",
                    "task": "Look it up."
                  }
                }
              ]
            },
            {
              "text": "On it."
            },
            {
              "text": "The dig stopped at its limit of tool rounds."
            }
          ]
        }
      },
      {
        "id": "researcher",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "delegate_task",
                  "arguments": {
                    "agent": "digger",
                    "task": "Dig."
                  }
                }
              ]
            },
            {
              "text": "The dig stopped at its limit of tool rounds."
            }
          ]
        }
      },
      {
        "id": "digger",
        "type": "ai",
        "category": "intelligence",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "d1",
                  "name": "lookup"
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "d2",
                  "name": "lookup"
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "d3",
                  "name": "lookup"
                }
              ]
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "look up",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "max_tool_rounds": 1
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "front"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate_handler",
      "handler": "tool",
      "wait_in_task_rooms": true
    },
    {
      "call": "setup_delegation",
      "agent_id": "front",
      "handler": "tool"
    },
    {
      "call": "setup_delegation",
      "agent_id": "researcher",
      "handler": "tool"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Look it up."
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "rooms": {
      "$r1": {
        "metadata": {
          "parent_room_id": "room-1",
          "task_agent_id": "researcher",
          "task_status": "completed"
        }
      },
      "$r2": {
        "metadata": {
          "parent_room_id": "$r1",
          "task_agent_id": "digger",
          "task_status": "failed"
        }
      }
    },
    "models": {
      "researcher": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c2",
              "is_error": false,
              "content": {
                "$contains": [
                  "{\"status\": \"failed\", \"task_id\": \"",
                  "\", \"agent_id\": \"digger\", \"end_reason\": \"max_rounds\", \"end_reason_text\": \"it reached its limit of tool rounds before giving an answer\", \"result\": \"\"}"
                ]
              }
            }
          ]
        }
      ],
      "front": [
        {},
        {
          "tool_results": [
            {
              "tool_call_id": "c1",
              "is_error": false,
              "content": {
                "$starts_with": "{\"status\": \"delegated\""
              }
            }
          ]
        },
        {
          "messages": [
            {},
            {},
            {},
            {
              "role": "assistant",
              "text": "On it."
            },
            {
              "role": "user",
              "text": {
                "$contains": "The dig stopped at its limit of tool rounds."
              }
            }
          ]
        }
      ]
    }
  }
}
