{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-buffered-worker-whose-record-names-a-cut-fails-its-task",
  "title": "A delegated agent that answers at once, its turn's record naming an end before its answer, fails the task with that end, its output what it said, none when it said nothing; a transport shared into the child room changes nothing",
  "rules": [
    "§23.3 step 6",
    "§6.4"
  ],
  "notes": "Python: tests/tasks/test_worker_cut_short.py::test_a_buffered_worker_whose_record_names_a_cut_fails (its _BufferedWorker answers responded, its rows the narration or none, its response_metadata loop_end_reason timeout); core/mixins/_child_execution.py _buffered_outcome reads the end off the output's record. tasks/a-buffered-turn-cut-short-fails-its-task-with-its-narration reads it off the last message's metadata instead (RMK-1214).",
  "setup": {
    "channels": [
      {
        "id": "email",
        "type": "email",
        "category": "transport"
      },
      {
        "id": "quiet",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "source_channel_id": "system",
              "type": "message"
            },
            "respond": [],
            "output": {
              "response_metadata": {
                "loop_end_reason": "timeout"
              }
            },
            "repeat": true
          }
        ]
      },
      {
        "id": "narrator",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "source_channel_id": "system",
              "type": "message"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Halfway."
                }
              }
            ],
            "output": {
              "response_metadata": {
                "loop_end_reason": "timeout"
              }
            },
            "repeat": true
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "parent",
        "bindings": [
          {
            "channel_id": "email"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "quiet",
      "task": "Find it.",
      "wait": true,
      "expect": {
        "result": {
          "status": "failed",
          "result": {
            "status": "failed",
            "output": null,
            "error": "The worker's turn ended timeout before its answer",
            "metadata": {
              "loop_end_reason": "timeout"
            }
          }
        }
      }
    },
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "quiet",
      "task": "Find it.",
      "wait": true,
      "expect": {
        "result": {
          "status": "failed",
          "result": {
            "status": "failed",
            "output": null,
            "error": "The worker's turn ended timeout before its answer",
            "metadata": {
              "loop_end_reason": "timeout"
            }
          }
        }
      },
      "share_channels": [
        "email"
      ]
    },
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "narrator",
      "task": "Find it.",
      "wait": true,
      "expect": {
        "result": {
          "status": "failed",
          "result": {
            "status": "failed",
            "output": "Halfway.",
            "error": "The worker's turn ended timeout before its answer",
            "metadata": {
              "loop_end_reason": "timeout"
            }
          }
        }
      }
    },
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "narrator",
      "task": "Find it.",
      "wait": true,
      "expect": {
        "result": {
          "status": "failed",
          "result": {
            "status": "failed",
            "output": "Halfway.",
            "error": "The worker's turn ended timeout before its answer",
            "metadata": {
              "loop_end_reason": "timeout"
            }
          }
        }
      },
      "share_channels": [
        "email"
      ]
    },
    {
      "idle": true
    }
  ]
}
