{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-delegation-s-span-ends-with-its-task-s-status",
  "title": "A delegation's span ends ok for a task its worker completed, error for one its worker failed, and cancelled for one cancelled while its worker ran",
  "rules": [
    "§23.3",
    "§15.7"
  ],
  "requirements": [
    "RK-23.3-094"
  ],
  "notes": "Python: core/mixins/delegation.py, the delegation span ended with its task's status. roomkit-rs: kit/telemetry.rs delegation_span.",
  "setup": {
    "kit": {
      "telemetry": true
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "done",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "Look it up."
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Found it."
                }
              }
            ]
          }
        ]
      },
      {
        "id": "broke",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "Look it up."
            },
            "fail": "The worker broke."
          }
        ]
      },
      {
        "id": "slow",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "Count to a thousand."
            },
            "gate": "counting",
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "A thousand."
                }
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "room-1",
      "agent_id": "done",
      "task": "Look it up.",
      "wait": true,
      "expect": {
        "result": {
          "status": "completed"
        }
      }
    },
    {
      "call": "delegate",
      "room_id": "room-1",
      "agent_id": "broke",
      "task": "Look it up.",
      "wait": true,
      "expect": {
        "result": {
          "status": "failed"
        }
      }
    },
    {
      "call": "delegate",
      "room_id": "room-1",
      "agent_id": "slow",
      "task": "Count to a thousand.",
      "as": "t"
    },
    {
      "wait_for": "counting"
    },
    {
      "call": "cancel_task",
      "task_id": "$t",
      "expect": {
        "result": true
      }
    },
    {
      "call": "task.wait",
      "task_id": "$t",
      "expect": {
        "result": {
          "status": "cancelled"
        }
      }
    },
    {
      "open": "counting"
    },
    {
      "idle": true
    },
    {
      "call": "telemetry.spans",
      "site": "owner",
      "kind": "delegation",
      "attributes": {
        "delegation.worker_id": "done"
      },
      "expect": {
        "result": [
          {
            "status": "ok",
            "attributes": {
              "delegation.parent_room_id": "room-1"
            }
          }
        ]
      }
    },
    {
      "call": "telemetry.spans",
      "site": "owner",
      "kind": "delegation",
      "attributes": {
        "delegation.worker_id": "broke"
      },
      "expect": {
        "result": [
          {
            "status": "error",
            "attributes": {
              "delegation.parent_room_id": "room-1"
            }
          }
        ]
      }
    },
    {
      "call": "telemetry.spans",
      "site": "owner",
      "kind": "delegation",
      "attributes": {
        "delegation.worker_id": "slow"
      },
      "expect": {
        "result": [
          {
            "status": "cancelled",
            "attributes": {
              "delegation.parent_room_id": "room-1"
            }
          }
        ]
      }
    }
  ],
  "expect": {}
}
