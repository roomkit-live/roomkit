{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-shared-channel-is-attached-with-its-parent-binding-s-metadata",
  "title": "A channel shared into a child room is attached with its parent binding's metadata: the channel is handed the binding with it, and the child room records one attach, no update after it",
  "rules": [
    "§23.3 step 3",
    "§7.5",
    "§5.1"
  ],
  "notes": "Python: core/mixins/delegation.py _open_child_room, attach_channel(..., metadata=parent_binding.metadata) (RMK-1341). The child room's lifecycle records: the agent's attach, then the shared channel's.",
  "setup": {
    "channels": [
      {
        "id": "phone",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "source_channel_id": "system",
              "type": "message"
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Done."
                }
              }
            ],
            "repeat": true
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "parent",
        "bindings": [
          {
            "channel_id": "phone",
            "metadata": {
              "persona": "desk",
              "tier": 2
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Find it.",
      "share_channels": [
        "phone"
      ],
      "wait": true,
      "expect": {
        "result": {
          "status": "completed",
          "result": {
            "status": "completed",
            "output": "Done."
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "bindings": {
      "$r1": {
        "phone": {
          "metadata": {
            "persona": "desk",
            "tier": 2
          }
        }
      }
    },
    "room_callbacks": {
      "$r1": {
        "phone": [
          {
            "call": "on_room_attached",
            "binding": {
              "channel_id": "phone",
              "metadata": {
                "persona": "desk",
                "tier": 2
              }
            }
          }
        ]
      }
    },
    "lifecycle": {
      "$r1": [
        {
          "type": "channel_attached"
        },
        {
          "type": "channel_attached"
        }
      ]
    }
  }
}
