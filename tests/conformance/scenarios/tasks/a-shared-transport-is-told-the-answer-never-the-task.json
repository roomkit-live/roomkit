{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-shared-transport-is-told-the-answer-never-the-task",
  "title": "A transport shared into a delegated room is delivered the agent's answer, buffered or streamed, through the room's BEFORE_BROADCAST, never the task's description; the task's output is that answer",
  "rules": [
    "§23.3 step 4",
    "§23.3 step 5",
    "§23.3 step 6",
    "§7.5 rule 2",
    "§12.2 step 14s"
  ],
  "notes": "Python: tests/tasks/test_shared_transport_delegation.py::TestASharedTransportIsToldTheAnswer::test_it_receives_the_answer_and_never_the_task[False], [True]; core/mixins/_child_execution.py _answer_of_broadcast, _shares_a_transport, _deliver_answer. The description is committed outside the pipeline, as without a shared transport, and crosses no hook; the answer re-enters as a room's response: it answers the description, crosses BEFORE_BROADCAST, and rides the child room's lane to the shared transport. worker answers buffered, writer (a scripted agent) streams.",
  "setup": {
    "channels": [
      {
        "id": "email",
        "type": "email",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "Summarise the ticket and email the customer."
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Your ticket is solved."
                }
              }
            ]
          }
        ]
      },
      {
        "id": "writer",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "deltas": [
                "Your ticket ",
                "is solved."
              ]
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "parent",
        "bindings": [
          {
            "channel_id": "email"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_broadcast"
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Summarise the ticket and email the customer.",
      "share_channels": [
        "email"
      ],
      "wait": true,
      "expect": {
        "result": {
          "status": "completed",
          "result": {
            "status": "completed",
            "output": "Your ticket is solved.",
            "error": null
          }
        }
      }
    },
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "writer",
      "task": "Summarise the ticket and email the customer.",
      "share_channels": [
        "email"
      ],
      "wait": true,
      "expect": {
        "result": {
          "status": "completed",
          "result": {
            "status": "completed",
            "output": "Your ticket is solved.",
            "error": null
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "parent": [],
      "$r1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "system",
            "channel_type": "system"
          },
          "visibility": "intelligence",
          "status": "delivered",
          "chain_depth": 0,
          "content": {
            "type": "text",
            "body": "Summarise the ticket and email the customer."
          }
        },
        {
          "index": 1,
          "type": "message",
          "source": {
            "channel_id": "worker"
          },
          "status": "delivered",
          "chain_depth": 1,
          "responds_to": "$r1#0",
          "content": {
            "type": "text",
            "body": "Your ticket is solved."
          }
        }
      ],
      "$r2": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "system",
            "channel_type": "system"
          },
          "visibility": "intelligence",
          "status": "delivered",
          "chain_depth": 0,
          "content": {
            "type": "text",
            "body": "Summarise the ticket and email the customer."
          }
        },
        {
          "index": 1,
          "type": "message",
          "source": {
            "channel_id": "writer"
          },
          "status": "delivered",
          "chain_depth": 1,
          "responds_to": "$r2#0",
          "content": {
            "type": "text",
            "body": "Your ticket is solved."
          }
        }
      ]
    },
    "deliveries": {
      "parent": {
        "email": []
      },
      "$r1": {
        "email": [
          {
            "type": "message",
            "source": {
              "channel_id": "worker"
            },
            "content": {
              "type": "text",
              "body": "Your ticket is solved."
            }
          }
        ]
      },
      "$r2": {
        "email": [
          {
            "type": "message",
            "source": {
              "channel_id": "writer"
            },
            "content": {
              "type": "text",
              "body": "Your ticket is solved."
            }
          }
        ]
      }
    },
    "hooks": {
      "gate": [
        {
          "trigger": "before_broadcast",
          "room_id": "$r1",
          "event": {
            "source": {
              "channel_id": "worker"
            },
            "content": {
              "type": "text",
              "body": "Your ticket is solved."
            }
          }
        },
        {
          "trigger": "before_broadcast",
          "room_id": "$r2",
          "event": {
            "source": {
              "channel_id": "writer"
            },
            "content": {
              "type": "text",
              "body": "Your ticket is solved."
            }
          }
        }
      ]
    }
  }
}
