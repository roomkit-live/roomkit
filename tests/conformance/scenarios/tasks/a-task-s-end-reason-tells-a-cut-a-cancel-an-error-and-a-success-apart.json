    {
      "call": "task.wait",
      "task_id": "$count",
      "expect": {
        "result": {
          "status": "failed",
          "error": "The worker's turn ended max_rounds before its answer",
          "metadata": {
            "loop_end_reason": "max_rounds"
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "delegate",
      "room_id": "room-1",
      "agent_id": "broken",
      "task": "Read the ledger.",
      "notify": "parent",
      "as": "read"
