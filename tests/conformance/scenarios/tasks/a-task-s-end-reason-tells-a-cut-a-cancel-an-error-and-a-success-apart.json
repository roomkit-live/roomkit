{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-task-s-end-reason-tells-a-cut-a-cancel-an-error-and-a-success-apart",
  "title": "Why a task did not complete is one code of a closed list, the same in its hand-back, the hand-back's metadata, ON_TASK_COMPLETED, its entry on the status bus and task_status: its worker's round cap max_rounds, a task cancelled from outside cancelled, a worker whose model raised error, with nothing of what the model said, a worker that answered nothing empty_response; a task that completed names no reason",
  "rules": [
    "§23.3 step 6",
    "§23.3 step 8",
    "§23.4",
    "§23.5",
    "§9.3"
  ],
  "requirements": [
    "RK-23.3-028",
    "RK-23.3-030",
    "RK-23.3-050",
    "RK-23.3-116",
    "RK-23.3-117",
    "RK-23.3-118",
    "RK-23.3-119",
    "RK-23.3-120",
    "RK-23.3-121",
    "RK-23.3-123",
    "RK-23.4-070"
  ],
  "notes": "Python: tasks/models.py task_end_reason (a cut by a reason of models/task.py TASK_END_WORDS, cancelled for a cancelled task, error for any other failure), failed_task_words; tests/tasks/test_worker_cut_short.py::test_a_tasks_end_reason_comes_from_the_closed_list. The broken worker's model raises a message that reads as a provider's, with a key in it: the task's error and ON_TASK_COMPLETED keep it for the host, and no text a model reads holds it, the hand-back's body and task_status's answer being compared whole around their ids and instants. The silent worker's model answers an empty text: its turn ends with no answer, and its task reads as one that gave none. The stalled worker's round is held at a gate while the host cancels its task.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "capped",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c2",
                  "name": "lookup"
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c3",
                  "name": "lookup"
                }
              ]
            }
          ]
        },
        "tools": [
          {
            "name": "lookup",
            "description": "look up",
            "parameters": {
              "type": "object"
            },
            "returns": "found"
          }
        ],
        "max_tool_rounds": 1
      },
      {
        "id": "broken",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "fails": "upstream 401: the key sk-live-1234 is invalid"
            }
          ]
        }
      },
      {
        "id": "stalled",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Never said.",
              "gate": "stalled-working"
            }
          ]
        }
      },
      {
        "id": "silent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": ""
            }
          ]
        }
      },
      {
        "id": "steady",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "All good."
            }
          ]
        }
      },
      {
        "id": "parent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "The count stopped at its limit of tool rounds."
            },
            {
              "text": "The ledger could not be read."
            },
            {
              "text": "The wait was cancelled."
            },
            {
              "text": "The echo gave no answer."
            },
            {
              "text": "All good."
            },
            {
              "calls": [
                {
                  "id": "p1",
                  "name": "task_status",
                  "arguments": {}
                }
              ]
            },
            {
              "text": "One was cut, one failed, one was cancelled, one gave no answer, one completed."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "parent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "done",
        "trigger": "on_task_completed",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "setup_task_tools",
      "agent_id": "parent"
    },
    {
      "call": "add_room_hook",
      "room_id": "room-1",
      "hook": {
        "name": "told",
        "trigger": "after_deliver",
