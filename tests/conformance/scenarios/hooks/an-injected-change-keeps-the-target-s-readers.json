{
  "$schema": "../../scenario.schema.json",
  "id": "hooks/an-injected-change-keeps-the-target-s-readers",
  "title": "An injected system delete reaches only its targets that could read the original message",
  "rules": [
    "§9.4 Injected events"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "capabilities": {
          "supports_edit": true,
          "supports_delete": true
        }
      },
      {
        "id": "customer",
        "type": "websocket",
        "category": "transport",
        "capabilities": {
          "supports_delete": true
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms",
            "visibility": "ws"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "customer"
          }
        ],
        "participants": [
          {
            "id": "alice",
            "channel_id": "sms",
            "role": "owner"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "notify",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "result": {
              "action": "allow",
              "injected_events": [
                {
                  "event": {
                    "content": {
                      "type": "delete",
                      "target_event_id": "room-1#0",
                      "delete_type": "system"
                    },
                    "type": "delete",
                    "source": {
                      "channel_id": "sms",
                      "channel_type": "sms",
                      "participant_id": "alice"
                    }
                  },
                  "target_channel_ids": [
                    "ws",
                    "customer"
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "name": "mutated",
        "trigger": "on_event_deleted",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "original"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "original"
          },
          "index": 0,
          "metadata": {
            "deleted": true
          },
          "visibility": "ws"
        },
        {
          "content": {
            "type": "text",
            "body": "hello"
          },
          "index": 1,
          "visibility": "ws"
        },
        {
          "type": "delete",
          "content": {
            "type": "delete",
            "target_event_id": "room-1#0",
            "delete_type": "system"
          },
          "visibility": "ws",
          "status": "delivered",
          "index": 2
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "type": "text",
              "body": "original"
            }
          },
          {
            "content": {
              "type": "text",
              "body": "hello"
            }
          },
          {
            "type": "delete",
            "content": {
              "type": "delete",
              "target_event_id": "room-1#0",
              "delete_type": "system"
            }
          }
        ],
        "customer": []
      }
    },
    "hooks": {
      "mutated": [
        {
          "event": {
            "content": {
              "type": "text",
              "body": "original"
            },
            "index": 0,
            "metadata": {
              "deleted": true
            }
          }
        }
      ]
    }
  },
  "notes": "Python: tests/test_edit_delete_authorization.py::TestWhomAChangeReaches::test_an_injected_change_reaches_its_targets_that_saw_the_target. The customer is a named injection target but could not read the original."
}
