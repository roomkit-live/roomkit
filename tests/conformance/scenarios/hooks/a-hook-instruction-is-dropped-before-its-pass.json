{
  "$schema": "../../scenario.schema.json",
  "id": "hooks/a-hook-instruction-is-dropped-before-its-pass",
  "title": "A hook instruction runs no pass while its ordinary notice, task and observation stand",
  "rules": [
    "§9.4 Injected events"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "notify",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "result": {
              "action": "allow",
              "injected_events": [
                {
                  "event": {
                    "content": {
                      "type": "text",
                      "body": "forbidden"
                    },
                    "type": "instruction"
                  },
                  "target_channel_ids": [
                    "ws"
                  ]
                },
                {
                  "event": {
                    "content": {
                      "type": "text",
                      "body": "notice"
                    }
                  },
                  "target_channel_ids": [
                    "ws"
                  ]
                }
              ],
              "tasks": [
                {
                  "id": "review",
                  "room_id": "room-1",
                  "title": "Review"
                }
              ],
              "observations": [
                {
                  "room_id": "room-1",
                  "channel_id": "system",
                  "content": "Audit the request"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "hello"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "notice"
          }
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "type": "text",
              "body": "hello"
            }
          },
          {
            "content": {
              "type": "text",
              "body": "notice"
            }
          }
        ]
      }
    },
    "hooks": {
      "notify": [
        {
          "event": {
            "content": {
              "type": "text",
              "body": "hello"
            }
          }
        },
        {
          "event": {
            "content": {
              "type": "text",
              "body": "notice"
            }
          }
        }
      ]
    },
    "tasks": {
      "room-1": [
        {
          "title": "Review"
        }
      ]
    },
    "observations": {
      "room-1": [
        {
          "channel_id": "system",
          "content": "Audit the request"
        }
      ]
    }
  }
}
