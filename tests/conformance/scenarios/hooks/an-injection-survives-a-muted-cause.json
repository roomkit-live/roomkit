{
  "$schema": "../../scenario.schema.json",
  "id": "hooks/an-injection-survives-a-muted-cause",
  "title": "A muted source cannot publish the cause, but its hook injection is still committed and delivered",
  "rules": [
    "§9.4 Injected events"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms",
            "muted": true
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "notify",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "result": {
              "action": "allow",
              "injected_events": [
                {
                  "event": {
                    "content": {
                      "type": "text",
                      "body": "notice"
                    }
                  },
                  "target_channel_ids": [
                    "ws"
                  ]
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u",
        "content": {
          "type": "text",
          "body": "hello"
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "hello"
          },
          "index": 0,
          "status": "blocked",
          "blocked_by": "source_muted"
        },
        {
          "content": {
            "type": "text",
            "body": "notice"
          },
          "index": 1,
          "status": "delivered",
          "visibility": "ws",
          "chain_depth": 0
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "sms": [],
        "ws": [
          {
            "content": {
              "type": "text",
              "body": "notice"
            }
          }
        ]
      }
    }
  }
}
