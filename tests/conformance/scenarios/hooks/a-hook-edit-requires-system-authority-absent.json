{
  "$schema": "../../scenario.schema.json",
  "id": "hooks/a-hook-edit-requires-system-authority-absent",
  "title": "A hook edit with absent authority cannot change its target",
  "rules": [
    "§9.4 Injected events"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "capabilities": {
          "supports_edit": true,
          "supports_delete": true
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ],
        "participants": [
          {
            "id": "alice",
            "channel_id": "sms",
            "role": "owner"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "notify",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "result": {
              "action": "allow",
              "injected_events": [
                {
                  "event": {
                    "content": {
                      "type": "edit",
                      "target_event_id": "room-1#0",
                      "new_content": {
                        "type": "text",
                        "body": "changed"
                      }
                    },
                    "type": "edit",
                    "source": {
                      "channel_id": "sms",
                      "channel_type": "sms",
                      "participant_id": "alice"
                    }
                  },
                  "target_channel_ids": [
                    "ws"
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "name": "mutated",
        "trigger": "on_event_updated",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "original"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "original"
          },
          "index": 0,
          "metadata": {
            "deleted": {
              "$absent": true
            },
            "edited": {
              "$absent": true
            }
          }
        },
        {
          "content": {
            "type": "text",
            "body": "hello"
          },
          "index": 1
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "type": "text",
              "body": "original"
            }
          },
          {
            "content": {
              "type": "text",
              "body": "hello"
            }
          }
        ]
      }
    },
    "hooks": {
      "mutated": []
    }
  },
  "notes": "Python: tests/test_edit_delete_authorization.py::TestEveryPassValidates. Even the original sender source cannot lend its authority to a hook injection."
}
