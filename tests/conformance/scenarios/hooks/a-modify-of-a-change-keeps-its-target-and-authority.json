{
  "$schema": "../../scenario.schema.json",
  "id": "hooks/a-modify-of-a-change-keeps-its-target-and-authority",
  "title": "A BEFORE_BROADCAST modify of a change keeps the target, the edit_source and the delete_type validated, while the edit's new content and the delete's reason it gives stand",
  "rules": [
    "§10.3",
    "§9.4 A `BEFORE_BROADCAST` replacement",
    "§10.1 step 9"
  ],
  "requirements": [
    "RK-10.3-024",
    "RK-10.3-025"
  ],
  "notes": "The hook points the edit at the second message as a system edit, and the delete at the second message as an ADMIN delete: both still change the first message with the sender's authority.",
  "setup": {
    "channels": [
      {
        "id": "wa",
        "type": "whatsapp",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "wa"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "rewrite",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "type": "edit"
            },
            "result": {
              "action": "modify",
              "event": {
                "content": {
                  "type": "edit",
                  "target_event_id": "room-1#1",
                  "new_content": {
                    "type": "text",
                    "body": "Hooked"
                  },
                  "edit_source": "system"
                }
              }
            }
          },
          {
            "when": {
              "type": "delete"
            },
            "result": {
              "action": "modify",
              "event": {
                "content": {
                  "type": "delete",
                  "target_event_id": "room-1#1",
                  "delete_type": "admin",
                  "reason": "hooked"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "First"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Second"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "edit",
          "target_event_id": "room-1#0",
          "new_content": {
            "type": "text",
            "body": "First, corrected"
          },
          "edit_source": "sender"
        },
        "event_type": "edit"
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "content": {
              "type": "edit",
              "target_event_id": "room-1#0",
              "new_content": {
                "type": "text",
                "body": "Hooked"
              },
              "edit_source": "sender"
            }
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "delete",
          "target_event_id": "room-1#0",
          "delete_type": "sender"
        },
        "event_type": "delete"
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "content": {
              "type": "delete",
              "target_event_id": "room-1#0",
              "delete_type": "sender",
              "reason": "hooked"
            }
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "Hooked"
          },
          "metadata": {
            "edited": true,
            "deleted": true
          }
        },
        {
          "content": {
            "type": "text",
            "body": "Second"
          },
          "metadata": {
            "edited": {
              "$absent": true
            },
            "deleted": {
              "$absent": true
            }
          }
        },
        {
          "type": "edit",
          "content": {
            "type": "edit",
            "target_event_id": "room-1#0",
            "new_content": {
              "type": "text",
              "body": "Hooked"
            },
            "edit_source": "sender"
          }
        },
        {
          "type": "delete",
          "content": {
            "type": "delete",
            "target_event_id": "room-1#0",
            "delete_type": "sender",
            "reason": "hooked"
          }
        }
      ]
    }
  }
}
