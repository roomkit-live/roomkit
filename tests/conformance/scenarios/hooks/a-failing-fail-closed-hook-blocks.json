{
  "$schema": "../../scenario.schema.json",
  "id": "hooks/a-failing-fail-closed-hook-blocks",
  "title": "A fail-closed hook that raises blocks its event, named in blocked_by and in the reason",
  "rules": [
    "§9.3",
    "§9.1",
    "§8.2",
    "§26.1"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "pii",
        "trigger": "before_broadcast",
        "fail_closed": true,
        "reactions": [
          {
            "fail": "the scanner is down"
          }
        ],
        "priority": 0
      },
      {
        "name": "later",
        "trigger": "before_broadcast",
        "priority": 1
      },
      {
        "name": "after",
        "trigger": "after_broadcast",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "hook_error:pii",
          "event": {
            "status": "blocked",
            "blocked_by": "pii"
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "status": "blocked",
          "blocked_by": "pii"
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "sms": [],
        "ws": []
      }
    },
    "framework_events": {
      "room-1": [
        {
          "event": "hook_error",
          "hook": "pii",
          "event_id": "room-1#0"
        },
        {
          "event": "event_blocked",
          "blocked_by": "pii",
          "event_id": "room-1#0"
        }
      ]
    },
    "hooks": {
      "pii": [
        {
          "room_id": "room-1",
          "event": {
            "content": {
              "body": "Hello"
            }
          }
        }
      ],
      "later": [],
      "after": []
    },
    "tasks": {
      "room-1": []
    },
    "observations": {
      "room-1": []
    }
  },
  "notes": "Python: tests/test_hook_fail_closed.py::TestEngine. Also checks chain continuation, AFTER_BROADCAST and deliveries, rather than only the return value."
}
