{
  "$schema": "../../scenario.schema.json",
  "id": "hooks/a-duplicate-drops-off-lock-injections",
  "title": "A duplicate detected after an off-lock hook stores no new cause or injection",
  "rules": [
    "§9.4 Injected events"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "notify",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "result": {
              "action": "allow",
              "injected_events": [
                {
                  "event": {
                    "content": {
                      "type": "text",
                      "body": "notice"
                    }
                  },
                  "target_channel_ids": [
                    "ws"
                  ]
                }
              ]
            }
          }
        ],
        "needs_lock": false
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "original"
        },
        "idempotency_key": "same"
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        },
        "idempotency_key": "same"
      },
      "expect": {
        "result": {
          "event": {
            "content": {
              "body": "original"
            },
            "index": 0
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "original"
          },
          "index": 0
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "original"
            }
          }
        ]
      }
    },
    "hooks": {
      "notify": [
        {
          "event": {
            "content": {
              "body": "original"
            }
          }
        },
        {
          "event": {
            "content": {
              "body": "hello"
            }
          }
        }
      ]
    }
  }
}
