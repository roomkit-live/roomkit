{
  "$schema": "../../scenario.schema.json",
  "id": "hooks/an-injection-is-in-its-agent-target-s-next-context",
  "title": "An agent is not called for an injection but reads it on its next turn",
  "rules": [
    "§9.4 Injected events"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "ai",
        "type": "ai",
        "category": "intelligence"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "ai"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "notify",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "result": {
              "action": "allow",
              "injected_events": [
                {
                  "event": {
                    "content": {
                      "type": "text",
                      "body": "notice"
                    }
                  },
                  "target_channel_ids": [
                    "ai",
                    "ws"
                  ]
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        },
        "addressed_to": []
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "next"
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "hello"
          },
          "index": 0
        },
        {
          "content": {
            "type": "text",
            "body": "notice"
          },
          "index": 1,
          "visibility": "ai,ws"
        },
        {
          "content": {
            "type": "text",
            "body": "next"
          },
          "index": 2
        }
      ]
    },
    "turns": {
      "room-1": {
        "ai": [
          {
            "content": {
              "type": "text",
              "body": "next"
            }
          }
        ]
      }
    },
    "contexts": {
      "room-1": {
        "ai": [
          {
            "call": "on_event",
            "recent_events": [
              "room-1#0",
              "room-1#1",
              "room-1#2"
            ]
          }
        ]
      }
    }
  }
}
